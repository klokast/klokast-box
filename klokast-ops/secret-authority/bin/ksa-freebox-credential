#!/usr/bin/env python3
"""Register the one controller Freebox application and store its token."""

import argparse
import importlib.util
import json
import os
import socket
import sys
import time
from importlib.machinery import SourceFileLoader
from pathlib import Path


INSTALLED_BROKER = Path("/usr/local/sbin/freebox-ipv6-broker")
SOURCE_BROKER = Path(__file__).with_name("freebox-ipv6-broker")
APP_ID = "org.klokast.ops-ipv6-delegation"
APP_NAME = "Klokast ops IPv6 delegation"
APP_VERSION = "1.0"


def load_broker():
    path = INSTALLED_BROKER if INSTALLED_BROKER.is_file() else SOURCE_BROKER
    loader = SourceFileLoader("klokast_freebox_ipv6_broker", str(path))
    spec = importlib.util.spec_from_loader(loader.name, loader)
    module = importlib.util.module_from_spec(spec)
    loader.exec_module(module)
    return module


def main(argv=None):
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("install", nargs="?")
    args = parser.parse_args(argv)
    if args.install != "install":
        parser.error("the only accepted action is install")
    broker = load_broker()
    try:
        broker.require_root_active()
        if broker.CREDENTIAL.exists():
            raise broker.BrokerError("Freebox credential already exists; revoke it before replacement")
        transport = broker.Transport()
        discovery = broker.discover(transport)
        major = int(discovery["api_version"].split(".", 1)[0])
        response = broker.validate_api_response(
            transport.request("POST", f"/api/v{major}/login/authorize/", {
                "app_id": APP_ID,
                "app_name": APP_NAME,
                "app_version": APP_VERSION,
                "device_name": socket.gethostname(),
            }),
            {"app_token", "track_id"}, "Freebox authorization request",
        )
        token = response.get("app_token")
        track_id = response.get("track_id")
        if not isinstance(token, str) or not token or len(token) > 4096 or not isinstance(track_id, int) or track_id < 0:
            raise broker.BrokerError("Freebox authorization response is invalid")
        print("Approve the Klokast ops IPv6 delegation application on the Freebox display.", file=sys.stderr)
        status = "pending"
        for _attempt in range(60):
            tracked = broker.validate_api_response(
                transport.request("GET", f"/api/v{major}/login/authorize/{track_id}"),
                {"status", "challenge"}, "Freebox authorization status", {"password_salt"},
            )
            status = tracked.get("status")
            if status != "pending":
                break
            time.sleep(2)
        if status != "granted":
            raise broker.BrokerError(f"Freebox physical authorization ended with status {status!r}")
        credential = {
            "schema_version": 1,
            "kind": "klokast.freebox-credential.v1",
            "app_id": APP_ID,
            "app_token": token,
            "gateway_uid": discovery["uid"],
            "api_version": discovery["api_version"],
            "api_major": major,
            "local_endpoint": f"http://{broker.GATEWAY_HOST}",
        }
        # Prove that the granted token has the required narrow permission
        # before it becomes persistent controller state.
        session = broker.Session(transport, credential)
        session.close()
        broker.replace_root_file(
            broker.CREDENTIAL,
            (broker.canonical(credential) + "\n").encode("utf-8"),
        )
        print(json.dumps({
            "schema_version": 1,
            "installed": True,
            "gateway_id_sha256": broker.sha256_bytes(discovery["uid"].encode("utf-8")),
            "api_version": discovery["api_version"],
            "credential_path": str(broker.CREDENTIAL),
        }, sort_keys=True))
    except broker.BrokerError as error:
        print(f"ksa-freebox-credential: {error}", file=sys.stderr)
        return 1
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
