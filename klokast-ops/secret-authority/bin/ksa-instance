EXPECTED_REPO_NAME = "klokast-instance"
DEFAULT_TTL_SECONDS = 600
CANONICAL_ENGINE_REPOSITORY = "https://github.com/klokast/klokast-box"
CANONICAL_ENGINE_REF = "main"
