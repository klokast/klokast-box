import urllib.request
from pathlib import Path


INTENT_SCHEMA_VERSION = 2
AUTHORITY = "klokast-secret-authority"
APP = "instance"
SIGNATURE_NAMESPACE = "klokast-secret-authority"
SOURCE_KIND = "klokast.instance-source.v1"
PROMOTION_KIND = "klokast.engine-promotion.v1"
ACTIVATION_KIND = "klokast.engine-activation.v1"
DEFAULT_REPO_ROOT = "/home/smith/src/klokast/klokast-box"
DEFAULT_INFRA_USER = "smith"
