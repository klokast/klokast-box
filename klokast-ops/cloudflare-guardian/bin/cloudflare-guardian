#!/usr/bin/env python3
#
# Ephemeral dom0 Cloudflare guardian.
#
# The guardian is intentionally not a daemon. It verifies a human-signed
# canonical intent, unseals the Cloudflare authority token through a configured
# external command, performs the allowlisted Cloudflare operation, and exits.
#
import argparse
import base64
import datetime as dt
import hashlib
import json
import os
import re
import secrets
import subprocess
import sys
import tempfile
import urllib.error
import urllib.parse
import urllib.request
from pathlib import Path


SCHEMA_VERSION = 1
AUTHORITY = "klokast-secret-authority"
PROVIDER = "cloudflare"
SIGNATURE_NAMESPACE = "klokast-secret-authority"
DEFAULT_CONFIG_ROOT = "/etc/klokast/cloudflare-guardian"
DEFAULT_STATE_ROOT = "/var/lib/klokast/cloudflare-guardian"
DEFAULT_AUDIT_LOG = "/var/log/klokast/cloudflare-guardian.jsonl"
DEFAULT_API_BASE = "https://api.cloudflare.com/client/v4"
STATIC_SITE_ACTION = "static-site-tunnel"

HOST_RE = re.compile(r"^[a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?$")
DOMAIN_RE = re.compile(r"^[A-Za-z0-9.-]+$")
TOKEN_RE = re.compile(r"^[A-Za-z0-9._=-]{20,4096}$")
NONCE_RE = re.compile(r"^[A-Za-z0-9_-]{12,128}$")
HEX_ID_RE = re.compile(r"^[A-Za-z0-9_-]{1,128}$")
GIT_HEAD_RE = re.compile(r"^[0-9a-f]{40}([0-9a-f]{24})?$")


class GuardianError(Exception):
    pass


def die(message, code=1):
    print(f"cloudflare-guardian: {message}", file=sys.stderr)
    raise SystemExit(code)


def canonical_json(data):
    return json.dumps(data, sort_keys=True, separators=(",", ":"), ensure_ascii=True) + "\n"


def now_utc():
    return dt.datetime.now(dt.timezone.utc)


def format_utc(value):
    return value.astimezone(dt.timezone.utc).replace(microsecond=0).isoformat().replace("+00:00", "Z")


def parse_utc(value, name):
    if not isinstance(value, str) or not value:
        raise GuardianError(f"{name} must be a non-empty timestamp")
    normalized = value[:-1] + "+00:00" if value.endswith("Z") else value
    try:
        parsed = dt.datetime.fromisoformat(normalized)
    except ValueError as error:
        raise GuardianError(f"{name} must be ISO-8601 UTC") from error
    if parsed.tzinfo is None:
        raise GuardianError(f"{name} must include timezone")
    return parsed.astimezone(dt.timezone.utc)


def ensure_private_dir(path, mode=0o700):
    path = Path(path)
    path.mkdir(parents=True, exist_ok=True)
    os.chmod(path, mode)


def append_jsonl(path, item, mode=0o600):
    path = Path(path)
    ensure_private_dir(path.parent, 0o700)
    line = canonical_json(item).encode("utf-8")
    fd = os.open(path, os.O_WRONLY | os.O_CREAT | os.O_APPEND, mode)
    try:
        os.write(fd, line)
    finally:
        os.close(fd)
    os.chmod(path, mode)


def audit(args, event, **fields):
    append_jsonl(
        args.audit_log,
        {
            "ts": format_utc(now_utc()),
            "event": event,
            **fields,
        },
    )


def read_json(path, name):
    try:
        return json.loads(Path(path).read_text(encoding="utf-8"))
    except OSError as error:
        raise GuardianError(f"cannot read {name}: {error}") from error
    except json.JSONDecodeError as error:
        raise GuardianError(f"{name} is not valid JSON: {error}") from error


def safe_host(value, name):
    if not HOST_RE.match(value or ""):
        raise GuardianError(f"{name} must be a simple host label")
    return value


def safe_domain(value, name):
    if not DOMAIN_RE.match(value or "") or value.startswith(".") or value.endswith("."):
        raise GuardianError(f"{name} must be a hostname")
    return value


def safe_id(value, name):
    if not HEX_ID_RE.match(value or ""):
        raise GuardianError(f"{name} contains unsafe characters")
    return value


def safe_service_url(value):
    if not isinstance(value, str) or not value:
        raise GuardianError("service_url must be non-empty")
    parsed = urllib.parse.urlparse(value)
    if parsed.scheme not in {"http", "https"}:
        raise GuardianError("service_url must use http or https")
    if parsed.hostname not in {"127.0.0.1", "localhost"}:
        raise GuardianError("service_url must target loopback for static-site")
    if parsed.username or parsed.password:
        raise GuardianError("service_url must not contain credentials")
    return value


def validate_intent(intent):
    expected = {
        "schema_version",
        "authority",
        "provider",
        "action",
        "guardian",
        "box",
        "domain",
        "cloudflare_account_id",
        "cloudflare_zone_id",
        "tunnel_name",
        "service_url",
        "repo_head",
        "expires_at",
        "nonce",
    }
    if not isinstance(intent, dict):
        raise GuardianError("intent must be a JSON object")
    if set(intent) != expected:
        extra = sorted(set(intent) - expected)
        missing = sorted(expected - set(intent))
        raise GuardianError(f"intent fields mismatch; missing={missing} extra={extra}")
    if intent["schema_version"] != SCHEMA_VERSION:
        raise GuardianError("unsupported intent schema_version")
    if intent["authority"] != AUTHORITY:
        raise GuardianError("wrong intent authority")
    if intent["provider"] != PROVIDER:
        raise GuardianError("wrong intent provider")
    if intent["action"] != STATIC_SITE_ACTION:
        raise GuardianError("unsupported intent action")
    safe_host(intent["guardian"], "guardian")
    safe_host(intent["box"], "box")
    safe_domain(intent["domain"], "domain")
    safe_id(intent["cloudflare_account_id"], "cloudflare_account_id")
    safe_id(intent["cloudflare_zone_id"], "cloudflare_zone_id")
    safe_host(intent["tunnel_name"], "tunnel_name")
    safe_service_url(intent["service_url"])
    if not GIT_HEAD_RE.match(intent["repo_head"]):
        raise GuardianError("repo_head is invalid")
    parse_utc(intent["expires_at"], "expires_at")
    if not NONCE_RE.match(intent["nonce"]):
        raise GuardianError("nonce is invalid")


def verify_policy(policy, intent):
    if not isinstance(policy, dict):
        raise GuardianError("guardian policy must be a JSON object")
    static_site = policy.get("static_site") or {}
    checks = {
        "guardian": intent["guardian"],
        "box": intent["box"],
        "domain": intent["domain"],
        "cloudflare_account_id": intent["cloudflare_account_id"],
        "cloudflare_zone_id": intent["cloudflare_zone_id"],
        "tunnel_name": intent["tunnel_name"],
        "service_url": intent["service_url"],
    }
    for key, value in checks.items():
        if static_site.get(key) != value:
            raise GuardianError(f"intent {key} is not allowed by guardian policy")


def verify_signature(args, intent, signature_text):
    allowed_signers = Path(args.allowed_signers)
    if not allowed_signers.is_file():
        raise GuardianError(f"allowed signers file is missing: {allowed_signers}")
    if not signature_text.strip():
        raise GuardianError("approval signature is empty")
    with tempfile.TemporaryDirectory(prefix="cloudflare-guardian.") as tmpdir:
        sig_path = Path(tmpdir) / "intent.sig"
        sig_path.write_text(signature_text, encoding="utf-8")
        result = subprocess.run(
            [
                "ssh-keygen",
                "-Y",
                "verify",
                "-f",
                str(allowed_signers),
                "-I",
                args.signer_id,
                "-n",
                SIGNATURE_NAMESPACE,
                "-s",
                str(sig_path),
            ],
            input=canonical_json(intent),
            text=True,
            stdout=subprocess.PIPE,
            stderr=subprocess.PIPE,
            check=False,
        )
    if result.returncode != 0:
        detail = (result.stderr or result.stdout).strip()
        raise GuardianError(f"approval signature verification failed: {detail}")


def nonce_seen(path, nonce):
    path = Path(path)
    if not path.exists():
        return False
    for line in path.read_text(encoding="utf-8").splitlines():
        if not line.strip():
            continue
        try:
            item = json.loads(line)
        except json.JSONDecodeError:
            continue
        if item.get("nonce") == nonce:
            return True
    return False


def consume_nonce(args, intent):
    nonce_file = Path(args.state_root) / "used-approvals.jsonl"
    if nonce_seen(nonce_file, intent["nonce"]):
        raise GuardianError("approval intent nonce was already used by guardian")
    append_jsonl(
        nonce_file,
        {
            "ts": format_utc(now_utc()),
            "nonce": intent["nonce"],
            "action": intent["action"],
            "repo_head": intent["repo_head"],
            "signer_id": args.signer_id,
        },
    )


def require_root():
    if os.geteuid() != 0:
        raise GuardianError("guardian must run as root")


def read_request_stdin():
    try:
        request = json.loads(sys.stdin.read())
    except json.JSONDecodeError as error:
        raise GuardianError(f"guardian request is not JSON: {error}") from error
    if not isinstance(request, dict):
        raise GuardianError("guardian request must be a JSON object")
    intent = request.get("intent")
    signature = request.get("approval_signature")
    if not isinstance(intent, dict) or not isinstance(signature, str):
        raise GuardianError("guardian request needs intent and approval_signature")
    return intent, signature


def unseal_cloudflare_token(args, intent):
    unseal_command = Path(args.unseal_command)
    ciphertext_file = Path(args.ciphertext_file)
    if not unseal_command.is_file() or not os.access(unseal_command, os.X_OK):
        raise GuardianError(f"unseal command is not executable: {unseal_command}")
    if not ciphertext_file.is_file():
        raise GuardianError(f"encrypted Cloudflare authority file is missing: {ciphertext_file}")
    with tempfile.TemporaryDirectory(prefix="cloudflare-guardian.") as tmpdir:
        intent_file = Path(tmpdir) / "intent.json"
        intent_file.write_text(canonical_json(intent), encoding="utf-8")
        env = {
            "PATH": "/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin",
            "KLOKAST_CLOUDFLARE_GUARDIAN": "1",
            "KCG_INTENT_FILE": str(intent_file),
            "KCG_POLICY_FILE": str(args.policy),
            "KCG_CIPHERTEXT_FILE": str(ciphertext_file),
        }
        result = subprocess.run(
            [str(unseal_command)],
            env=env,
            text=True,
            stdout=subprocess.PIPE,
            stderr=subprocess.PIPE,
            check=False,
        )
    if result.returncode != 0:
        detail = result.stderr.strip() or "unseal command failed"
        raise GuardianError(f"Cloudflare authority unseal failed: {detail}")
    token = result.stdout.strip()
    if not TOKEN_RE.match(token):
        raise GuardianError("unseal command did not return a plausible Cloudflare bearer token")
    return token


class CloudflareClient:
    def __init__(self, token, api_base=DEFAULT_API_BASE):
        self.token = token
        self.api_base = api_base.rstrip("/")

    def request(self, method, path, body=None, status=(200,)):
        data = None
        if body is not None:
            data = canonical_json(body).encode("utf-8")
        request = urllib.request.Request(
            self.api_base + path,
            data=data,
            method=method,
            headers={
                "Authorization": f"Bearer {self.token}",
                "Accept": "application/json",
                "Content-Type": "application/json",
            },
        )
        try:
            with urllib.request.urlopen(request, timeout=30) as response:
                payload = response.read()
                if response.status not in status:
                    raise GuardianError(f"Cloudflare API returned HTTP {response.status} for {method} {path}")
        except urllib.error.HTTPError as error:
            payload = error.read().decode("utf-8", errors="replace")
            try:
                message = json.loads(payload).get("errors") or json.loads(payload).get("message") or payload
            except json.JSONDecodeError:
                message = payload
            raise GuardianError(f"Cloudflare API returned HTTP {error.code} for {method} {path}: {message}") from error
        except urllib.error.URLError as error:
            raise GuardianError(f"Cloudflare API request failed for {method} {path}: {error}") from error
        if not payload:
            return None
        decoded = json.loads(payload.decode("utf-8"))
        if isinstance(decoded, dict) and decoded.get("success") is False:
            raise GuardianError(f"Cloudflare API reported failure for {method} {path}: {decoded.get('errors')}")
        return decoded

    def result(self, method, path, body=None, status=(200,)):
        decoded = self.request(method, path, body=body, status=status)
        if not isinstance(decoded, dict):
            return decoded
        return decoded.get("result")


def find_or_create_tunnel(client, account_id, tunnel_name):
    query = urllib.parse.urlencode({"name": tunnel_name, "is_deleted": "false"})
    result = client.result("GET", f"/accounts/{account_id}/cfd_tunnel?{query}") or []
    if result:
        tunnel = result[0]
    else:
        tunnel = client.result(
            "POST",
            f"/accounts/{account_id}/cfd_tunnel",
            {"name": tunnel_name, "config_src": "cloudflare"},
            status=(200, 201),
        )
    tunnel_id = (tunnel or {}).get("id")
    if not tunnel_id:
        raise GuardianError("Cloudflare tunnel response did not include id")
    return tunnel_id


def configure_tunnel(client, account_id, tunnel_id, hostname, service_url):
    body = {
        "config": {
            "ingress": [
                {"hostname": hostname, "service": service_url},
                {"service": "http_status:404"},
            ],
            "originRequest": {},
        }
    }
    client.request(
        "PUT",
        f"/accounts/{account_id}/cfd_tunnel/{tunnel_id}/configurations",
        body,
        status=(200,),
    )


def ensure_dns_record(client, zone_id, hostname, tunnel_id):
    target = f"{tunnel_id}.cfargotunnel.com"
    query = urllib.parse.urlencode({"type": "CNAME", "name": hostname, "per_page": "100"})
    existing = client.result("GET", f"/zones/{zone_id}/dns_records?{query}") or []
    body = {
        "type": "CNAME",
        "name": hostname,
        "content": target,
        "proxied": True,
        "ttl": 1,
        "comment": "Managed by Klokast Cloudflare guardian",
    }
    if existing:
        record_id = existing[0].get("id")
        if not record_id:
            raise GuardianError("Cloudflare DNS record response did not include id")
        client.request("PUT", f"/zones/{zone_id}/dns_records/{record_id}", body, status=(200,))
    else:
        client.request("POST", f"/zones/{zone_id}/dns_records", body, status=(200, 201))
    return target


def get_tunnel_token(client, account_id, tunnel_id):
    result = client.result("GET", f"/accounts/{account_id}/cfd_tunnel/{tunnel_id}/token")
    if isinstance(result, dict):
        token = result.get("token") or result.get("value")
    else:
        token = result
    if not isinstance(token, str) or not token.strip():
        raise GuardianError("Cloudflare tunnel token response was empty")
    return token.strip()


def status(args):
    require_root()
    if not args.redacted:
        raise GuardianError("status requires --redacted")
    policy = read_json(args.policy, "guardian policy") if Path(args.policy).is_file() else {}
    output = {
        "schema_version": SCHEMA_VERSION,
        "authority": AUTHORITY,
        "provider": PROVIDER,
        "guardian": policy.get("static_site", {}).get("guardian", ""),
        "allowed_signers_configured": Path(args.allowed_signers).is_file(),
        "policy_configured": Path(args.policy).is_file(),
        "authority_ciphertext_configured": Path(args.ciphertext_file).is_file(),
        "unseal_command_configured": Path(args.unseal_command).is_file()
        and os.access(args.unseal_command, os.X_OK),
        "audit_log": str(args.audit_log),
        "state_root": str(args.state_root),
    }
    print(canonical_json(output), end="")


def static_site_tunnel(args):
    require_root()
    intent, signature = read_request_stdin()
    validate_intent(intent)
    if intent["guardian"] != args.guardian:
        raise GuardianError("intent guardian does not match this guardian")
    if parse_utc(intent["expires_at"], "expires_at") <= now_utc():
        raise GuardianError("intent is expired")
    policy = read_json(args.policy, "guardian policy")
    verify_policy(policy, intent)
    verify_signature(args, intent, signature)
    consume_nonce(args, intent)
    token = "dry-run-token"
    if not args.dry_run:
        token = unseal_cloudflare_token(args, intent)
    client = CloudflareClient(token, api_base=args.api_base)
    tunnel_id = "dry-run-tunnel-id"
    dns_target = "dry-run-tunnel-id.cfargotunnel.com"
    tunnel_token = base64.urlsafe_b64encode(canonical_json({"dry_run": True}).encode()).decode().rstrip("=")
    if not args.dry_run:
        tunnel_id = find_or_create_tunnel(client, intent["cloudflare_account_id"], intent["tunnel_name"])
        configure_tunnel(client, intent["cloudflare_account_id"], tunnel_id, intent["domain"], intent["service_url"])
        dns_target = ensure_dns_record(client, intent["cloudflare_zone_id"], intent["domain"], tunnel_id)
        tunnel_token = get_tunnel_token(client, intent["cloudflare_account_id"], tunnel_id)
    audit(
        args,
        "cloudflare.static-site-tunnel.finished",
        action=intent["action"],
        box=intent["box"],
        domain=intent["domain"],
        tunnel_name=intent["tunnel_name"],
        signer_id=args.signer_id,
        dry_run=args.dry_run,
    )
    print(
        canonical_json(
            {
                "status": "ok",
                "action": intent["action"],
                "box": intent["box"],
                "domain": intent["domain"],
                "tunnel_id": tunnel_id,
                "dns_target": dns_target,
                "cloudflared_token": tunnel_token,
            }
        ),
        end="",
    )


def build_parser():
    parser = argparse.ArgumentParser(description="Klokast Cloudflare guardian")
    parser.add_argument("--config-root", default=os.environ.get("KCG_CONFIG_ROOT", DEFAULT_CONFIG_ROOT))
    parser.add_argument("--state-root", default=os.environ.get("KCG_STATE_ROOT", DEFAULT_STATE_ROOT))
    parser.add_argument("--audit-log", default=os.environ.get("KCG_AUDIT_LOG", DEFAULT_AUDIT_LOG))
    parser.add_argument("--guardian", default=os.environ.get("KCG_GUARDIAN", "k001-dom0"))
    parser.add_argument("--api-base", default=os.environ.get("KCG_API_BASE", DEFAULT_API_BASE))
    parser.add_argument("--dry-run", action="store_true", help=argparse.SUPPRESS)
    parser.add_argument("--signer-id")
    sub = parser.add_subparsers(dest="command", required=True)
    static_site = sub.add_parser("static-site-tunnel")
    static_site.add_argument("--redacted", action="store_true", help=argparse.SUPPRESS)
    status_parser = sub.add_parser("status")
    status_parser.add_argument("--redacted", action="store_true")
    return parser


def main(argv=None):
    args = build_parser().parse_args(argv)
    root = Path(args.config_root)
    args.allowed_signers = str(root / "allowed-signers")
    args.policy = str(root / "policy.json")
    args.ciphertext_file = str(root / "cloudflare-authority.enc")
    args.unseal_command = str(root / "unseal-cloudflare-authority")
    try:
        if args.command == "status":
            status(args)
            return
        if args.command == "static-site-tunnel":
            if not args.signer_id:
                raise GuardianError("static-site-tunnel requires --signer-id")
            static_site_tunnel(args)
            return
    except GuardianError as error:
        die(str(error))
    die("unsupported command")


if __name__ == "__main__":
    main()
