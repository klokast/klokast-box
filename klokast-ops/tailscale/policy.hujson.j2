{
	"groups": {
		// The live Tailscale API is observed runtime state. This public template
		// and the private instance are the sources for intended policy inputs.
		//
		// `group:operator` is the developer of the Platform, connecting from his laptop.
		"group:operators": {{ operators_json }},

		// Trusted family users allowed to access private application frontends.
		"group:family": {{ family_json }},
	},

	"tagOwners": {
		// The Ansible controller: where ansible-playbook runs.
		"tag:ops": ["group:operators", "tag:ops"],

		// The infra service host: where Codex/LLM automation runs. This tag
		// does not carry controller authority by itself; it can only reach
		// tag:ops through the explicit grants and SSH rules below.
		"tag:infra": ["group:operators", "tag:ops"],

		// Legacy name for tag:infra, kept until enrolled machines converge.
		"tag:infra-agent": ["group:operators", "tag:ops"],

		// Containerized AI runner inside an ops VM. It is a remote terminal,
		// not a trusted controller.
		"tag:airunner": ["group:operators", "tag:ops"],

		// The "Out Of Band" access to the nodes, via Remote KVM devices.
		"tag:oob": ["group:operators"],

		// The Virtual Machines that run on top of `dom0`: the router VM and the 4 container engines VMs: `dmz`, `bak`, `iot`, `usr`.
		"tag:vm": ["tag:ops"],

		// The `dom0` domain of each node, maintained by the Xen hypervisor.
		"tag:dom0": ["tag:ops"],

		// The containers started by the `DMZ` container engine VM: internet-facing services.
		"tag:dmz": ["tag:ops"],

		// The stable private Tailscale ingress for the active Nextcloud service.
		"tag:nextcloud": ["tag:ops"],

		// The stable private Tailscale ingress for the active Immich service.
		"tag:immich": ["tag:ops"],

		// The stable private Tailscale ingress for local music playback.
		"tag:music": ["tag:ops"],

		// The stable private Tailscale upload ingress for local music libraries.
		"tag:music-upload": ["tag:ops"],

		// The stable private Tailscale ingress for local printing.
		"tag:print": ["tag:ops"],

		// The Raspberry Pi streamer endpoint attached to the local USB DAC.
		"tag:streamer": ["tag:ops"],

		// Dedicated torrent app VM and private qBittorrent ingress.
		"tag:torrent": ["tag:ops"],

		// Dedicated household/admin Wi-Fi VPN egress gateway.
		"tag:household-vpn": ["tag:ops"],
		// The containers started by the `backend` container engine VM: services that are not internet-facing, for example database, `etcd`, `vault`.
		"tag:back": ["tag:ops"],

		// The containers started by the `IOT` container engine VM: services that are untrusted because they interact with internet-connected devices in the LAN of the node, for example: air purifier, weather sensors, smart TV, video surveillance camera, IOT-hub, smart assistant.
		"tag:iot": ["tag:ops"],

		// TAG TO BE REMOVED
		"tag:eph": ["tag:ops"],

		// The containers started by the `usr` container engine VM: per-user app endpoints and user-facing workloads.
		"tag:usr": ["tag:ops"],

		// `dom0` after booting from the bootstrap .iso, but before rebooting into its final Alpine Linux form.
		// OAuth access: `pre-approved, ephemeral, reusable.
		"tag:bootstrap": ["tag:ops"],
	},

