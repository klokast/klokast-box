	"ssh": [
		// Failsafe access by the admin to the out of band device.
		{
			"src":         ["group:operators"],
			"dst":         ["tag:oob"],
			"users":       ["root"],
			"action":      "check",
			"checkPeriod": "12h0m0s",
		},
		// Connection of the admin to ops controllers.
		// Hetzner `codex` and `vultr-ops` `agent` remain AI runners;
		// in-Platform, `<box>-ops` uses `smith` and `minion`.
		{
			"src": ["group:operators"],
			"dst": ["tag:ops"],

			"users": [
				"neo",
				"codex",
				"smith",
				"minion",
				"klokast-infra",
				"klokast-app",
				"agent",
			],

			"action":      "check",
			"checkPeriod": "12h0m0s",
		},
		// Connection from the admin to the host that runs the infra agent.
		{
			"src":         ["group:operators"],
			"dst":         ["tag:infra", "tag:infra-agent"],
			"users":       ["neo", "codex", "agent", "ml-agent"],
			"action":      "check",
			"checkPeriod": "12h0m0s",
		},
		// Connection from the admin to an in-Platform AI runner container.
		{
			"src":         ["group:operators"],
			"dst":         ["tag:airunner"],
			"users":       ["neo", "agent"],
			"action":      "check",
			"checkPeriod": "12h0m0s",
		},
		// Controller-to-infra-agent path for the bootstrap controller to
		// verify and repair the standalone infra-agent host.
		{
			"src":    ["tag:ops"],
			"dst":    ["tag:infra", "tag:infra-agent"],
			"users":  ["agent"],
			"action": "accept",
		},
		// Controller-to-airunner path for checking and repairing the local
		// remote-terminal container.
		{
			"src":    ["tag:ops"],
			"dst":    ["tag:airunner"],
			"users":  ["agent"],
			"action": "accept",
		},
		// Remote-terminal path from the infra agent host to the Ansible
		// controller. The controller's Unix and sudo boundaries still decide
		// which operations can mutate infrastructure.
		{
			"src":    ["tag:infra", "tag:infra-agent"],
			"dst":    ["tag:ops"],
			"users":  ["smith", "klokast-infra"],
			"action": "accept",
		},
		// Remote-terminal path from an in-Platform AI runner container to the
		// Ansible controller.
		{
			"src":    ["tag:airunner"],
			"dst":    ["tag:ops"],
			"users":  ["smith", "klokast-infra"],
			"action": "accept",
		},
		// Migration and break-glass controller-to-controller access. This lets
		// the current Hetzner ops host converge the first in-Platform ops VM.
		{
			"src":    ["tag:ops"],
			"dst":    ["tag:ops"],
			"users":  ["smith", "klokast-infra"],
			"action": "accept",
		},
		// Connection from the admin to the mini PC host during bootstrap phase, usually for tests only,
		{
			"src":         ["group:operators"],
			"dst":         ["tag:bootstrap"],
			"users":       ["root"],
			"action":      "check",
			"checkPeriod": "12h0m0s",
		},
		// Access by the coding agent to the out of band device, usually not necessary.
		{
			"src":    ["tag:ops"],
			"dst":    ["tag:oob"],
			"users":  ["root"],
			"action": "accept",
		},
		// From deployment server to out of band, during bootstrap phase, to install the persistent Alpine Linux host.
		{
			"src":    ["tag:ops"],
			"dst":    ["tag:bootstrap"],
			"users":  ["root"],
			"action": "accept",
		},
		// Connection from the deployment server (coding agent and Ansible playbooks) to the production machines: VMs and containers.
		{
			"src": ["tag:ops"],

			"dst": [
				"tag:dom0",
				"tag:dmz",
				"tag:back",
				"tag:iot",
				"tag:streamer",
				"tag:vm",
			],

			"users":  ["neo"],
			"action": "accept",
		},
		// To transfer the boostrap iso file to the out of band device, for the mini pc to boot from and start the bootstrap phase.
		{
			"src":    ["tag:back"],
			"dst":    ["tag:oob"],
			"users":  ["root"],
			"action": "accept",
		},
		// Family music upload path; the target container exposes only the
		// local `music` account through Tailscale SSH.
		{
			"src":    ["group:family"],
			"dst":    ["tag:music-upload"],
			"users":  ["music"],
			"action": "accept",
		},
		// Operator shutdown path for the local Raspberry Pi streamer.
		{
			"src":    ["group:operators"],
			"dst":    ["tag:streamer"],
			"users":  ["streamer-power"],
			"action": "accept",
		},
		// Pull-only import path from media upload containers to completed torrents.
		{
			"src":    ["tag:music-upload"],
			"dst":    ["tag:torrent"],
			"users":  ["torrent-export"],
			"action": "accept",
		},
	],

