{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.klokast.org/platform-resources-v1.json",
  "$defs": {
    "id": {"type": "string", "pattern": "^[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?$"},
    "capability_list": {
      "type": "array",
      "items": {"$ref": "#/$defs/id"},
      "uniqueItems": true
    },
    "access": {
      "type": "object",
      "additionalProperties": false,
      "required": ["declared_capabilities", "enabled_capabilities", "prohibited_capabilities", "policy"],
      "properties": {
        "declared_capabilities": {"$ref": "#/$defs/capability_list"},
        "enabled_capabilities": {"$ref": "#/$defs/capability_list"},
        "prohibited_capabilities": {"$ref": "#/$defs/capability_list"},
        "policy": {
          "type": "object",
          "propertyNames": {"$ref": "#/$defs/id"},
          "additionalProperties": {
            "type": "string",
            "pattern": "^(?:none|[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?)$"
          }
        }
      }
    },
    "single_box_placement": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "box"],
      "properties": {
        "mode": {"const": "single_box"},
        "box": {"$ref": "#/$defs/id"}
      }
    },
    "active_passive_placement": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "active_master", "passive_backup"],
      "properties": {
        "mode": {"const": "active_passive"},
        "active_master": {"$ref": "#/$defs/id"},
        "passive_backup": {"$ref": "#/$defs/id"}
      }
    },
    "multi_box_placement": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "boxes"],
      "properties": {
        "mode": {"const": "multi_box"},
        "boxes": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/id"},
          "uniqueItems": true
        }
      }
    },
    "app": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled", "placement", "resources"],
      "properties": {
        "enabled": {"type": "boolean"},
        "placement": {
          "oneOf": [
            {"$ref": "#/$defs/single_box_placement"},
            {"$ref": "#/$defs/active_passive_placement"},
            {"$ref": "#/$defs/multi_box_placement"}
          ]
        },
        "resources": {
          "type": "object",
          "propertyNames": {"$ref": "#/$defs/id"},
          "additionalProperties": {"type": ["boolean", "integer", "string"]}
        }
      }
    }
  },
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "boxes", "apps"],
  "properties": {
    "schema_version": {"const": 1},
    "boxes": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": {"$ref": "#/$defs/id"},
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["access"],
        "properties": {"access": {"$ref": "#/$defs/access"}}
      }
    },
    "apps": {
      "type": "object",
      "propertyNames": {"$ref": "#/$defs/id"},
      "additionalProperties": {"$ref": "#/$defs/app"}
    }
  }
}
