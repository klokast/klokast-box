{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.klokast.org/deployment-v1.json",
  "$defs": {
    "id": {"type": "string", "pattern": "^[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?$"},
    "magicdns_suffix": {"type": "string", "pattern": "^[a-z0-9](?:[a-z0-9-]*\\.)+ts\\.net$"},
    "login": {"type": "string", "pattern": "^[^@\\s]+@[^@\\s]+\\.[^@\\s]+$", "maxLength": 320},
    "members": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/login"},
      "uniqueItems": true
    },
    "site": {
      "type": "object",
      "additionalProperties": false,
      "required": ["country", "timezone"],
      "properties": {
        "country": {"type": "string", "pattern": "^[A-Z]{2}$"},
        "timezone": {"const": "Etc/UTC"},
        "physical_location": {"type": "string", "minLength": 1, "maxLength": 500}
      }
    },
    "box": {
      "type": "object",
      "additionalProperties": false,
      "required": ["hostname_prefix", "site"],
      "properties": {
        "hostname_prefix": {"$ref": "#/$defs/id"},
        "site": {"$ref": "#/$defs/id"}
      }
    },
    "box_runner": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "box"],
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "kind": {"const": "box"},
        "box": {"$ref": "#/$defs/id"}
      }
    },
    "controller_container_runner": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "box"],
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "kind": {"const": "controller_container"},
        "box": {"$ref": "#/$defs/id"}
      }
    },
    "external_runner": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "hostname"],
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "kind": {"const": "external"},
        "hostname": {"$ref": "#/$defs/id"}
      }
    }
  },
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "instance", "tailnet", "sites", "boxes", "control_plane"],
  "properties": {
    "schema_version": {"const": 1},
    "instance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name"],
      "properties": {"name": {"$ref": "#/$defs/id"}}
    },
    "tailnet": {
      "type": "object",
      "additionalProperties": false,
      "required": ["magicdns_suffix", "groups"],
      "properties": {
        "magicdns_suffix": {"$ref": "#/$defs/magicdns_suffix"},
        "groups": {
          "type": "object",
          "additionalProperties": false,
          "required": ["operators", "family"],
          "properties": {
            "operators": {"$ref": "#/$defs/members"},
            "family": {"$ref": "#/$defs/members"}
          }
        }
      }
    },
    "sites": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": {"$ref": "#/$defs/id"},
      "additionalProperties": {"$ref": "#/$defs/site"}
    },
    "boxes": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": {"$ref": "#/$defs/id"},
      "additionalProperties": {"$ref": "#/$defs/box"}
    },
    "control_plane": {
      "type": "object",
      "additionalProperties": false,
      "required": ["controller", "airunners"],
      "properties": {
        "controller": {
          "type": "object",
          "additionalProperties": false,
          "required": ["active_box"],
          "properties": {
            "active_box": {"$ref": "#/$defs/id"},
            "standby_box": {"$ref": "#/$defs/id"}
          }
        },
        "airunners": {
          "type": "array",
          "minItems": 1,
          "items": {
            "oneOf": [
              {"$ref": "#/$defs/controller_container_runner"},
              {"$ref": "#/$defs/box_runner"},
              {"$ref": "#/$defs/external_runner"}
            ]
          }
        }
      }
    }
  }
}
