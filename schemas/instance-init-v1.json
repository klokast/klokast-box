{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.klokast.org/instance-init-v1.json",
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?$"
    },
    "hostname": {
      "type": "string",
      "pattern": "^[a-z0-9](?:[a-z0-9.-]{0,251}[a-z0-9])?$"
    },
    "members": {
      "type": "array",
      "items": {"type": "string", "minLength": 1, "maxLength": 320},
      "uniqueItems": true
    }
  },
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "instance", "tailnet", "site", "box"],
  "properties": {
    "schema_version": {"const": 1},
    "instance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name"],
      "properties": {
        "name": {"$ref": "#/$defs/id"}
      }
    },
    "tailnet": {
      "type": "object",
      "additionalProperties": false,
      "required": ["magicdns_suffix", "groups"],
      "properties": {
        "magicdns_suffix": {"$ref": "#/$defs/hostname"},
        "groups": {
          "type": "object",
          "additionalProperties": false,
          "required": ["operators", "family"],
          "properties": {
            "operators": {
              "allOf": [
                {"$ref": "#/$defs/members"},
                {"minItems": 1}
              ]
            },
            "family": {"$ref": "#/$defs/members"}
          }
        }
      }
    },
    "site": {
      "type": "object",
      "additionalProperties": false,
      "required": ["country"],
      "properties": {
        "country": {"type": "string", "pattern": "^[A-Z]{2}$"},
        "physical_location": {"type": "string", "minLength": 1, "maxLength": 500}
      }
    },
    "box": {
      "type": "object",
      "additionalProperties": false,
      "required": ["hostname_prefix"],
      "properties": {
        "hostname_prefix": {"$ref": "#/$defs/id"}
      }
    }
  }
}
