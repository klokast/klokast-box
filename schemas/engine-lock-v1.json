{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.klokast.org/engine-lock-v1.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "engine"],
  "properties": {
    "schema_version": {"const": 1},
    "engine": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "ref", "commit"],
      "properties": {
        "repository": {"type": "string", "format": "uri", "minLength": 1},
        "ref": {"type": "string", "minLength": 1, "maxLength": 255},
        "commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"}
      }
    }
  }
}
