#!/usr/bin/env python3
import argparse
import json
import os
import re
import subprocess
import sys
import tempfile
from pathlib import Path

import yaml


APP_DIR = Path(__file__).resolve().parents[1]
REPO_ROOT = APP_DIR.parents[1]
PLAYBOOK_DIR = APP_DIR / "ansible" / "playbooks"
ROLE_PATH = f"{APP_DIR / 'ansible' / 'roles'}:{REPO_ROOT / 'ansible' / 'roles'}"
BASE_INVENTORY = REPO_ROOT / "ansible" / "inventory" / "hosts.yml"
ANSIBLE_CONFIG = REPO_ROOT / "ansible" / "ansible.cfg"
MAGICDNS_SUFFIX = os.environ.get("KLOKAST_MAGICDNS_SUFFIX", "example.ts.net")
RESOURCES_REGISTRY_DEFAULT = os.environ.get(
    "KLOKAST_PLATFORM_RESOURCES_REGISTRY",
    os.environ.get("KLOKAST_APP_RESOURCES_REGISTRY", ""),
)
VPN_CONFIG_DEFAULT = os.environ.get(
    "KLOKAST_HOUSEHOLD_VPN_CONFIG",
    str(Path.home() / "private/klokast/household-vpn.yml"),
)
LOCAL_DOMAIN_DEFAULT = os.environ.get("KLOKAST_HOUSEHOLD_LOCAL_DOMAIN", "")

BOX_RE = re.compile(r"[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?")
DOMAIN_RE = re.compile(r"[A-Za-z0-9](?:[A-Za-z0-9-]{0,61}[A-Za-z0-9])?(?:\.[A-Za-z0-9](?:[A-Za-z0-9-]{0,61}[A-Za-z0-9])?)+")
ROLE_SUFFIXES = {"bootstrap", "dom0", "router", "bak", "dmz", "iot", "usr", "ops", "agent", "agt"}


def die(message):
    print(f"household-vpnctl: {message}", file=sys.stderr)
    raise SystemExit(2)


def valid_box(value):
    if not isinstance(value, str) or not BOX_RE.fullmatch(value):
        return False
    return not any(value == suffix or value.endswith(f"-{suffix}") for suffix in ROLE_SUFFIXES)


def require_box(value, field):
    if not valid_box(value):
        die(f"{field} must be a box name like k001, not a VM hostname")


def require_domain(value, field):
    if not isinstance(value, str) or not DOMAIN_RE.fullmatch(value.strip(".")):
        die(f"{field} must be an owned DNS name like home.example.com")
    return value.strip(".").lower()


def run(argv, *, env=None):
    subprocess.run(argv, cwd=REPO_ROOT, env=env, check=True)


def output(argv):
    return subprocess.check_output(argv, cwd=REPO_ROOT, text=True)


def git_head():
    return output(["git", "rev-parse", "HEAD"]).strip()


def load_yaml(path):
    try:
        with Path(path).expanduser().open(encoding="utf-8") as handle:
            data = yaml.safe_load(handle) or {}
    except FileNotFoundError:
        die(f"missing YAML file: {path}")
    if not isinstance(data, dict):
        die(f"YAML root must be a mapping: {path}")
    return data


def load_resources(registry, box):
    if not registry:
        die("--resources-registry is required, or export KLOKAST_PLATFORM_RESOURCES_REGISTRY")
    registry_path = Path(registry).expanduser()
    if not registry_path.is_file():
        die(f"platform resources registry does not exist: {registry_path}")
    data = json.loads(
        output(
            [
                str(REPO_ROOT / "ansible" / "bin" / "platform-resources"),
                "--registry",
                str(registry_path),
                "--app",
                "household-vpn",
                "show",
            ]
        )
    )
    app = (data.get("apps") or {}).get("household-vpn") or {}
    if not app.get("enabled"):
        die("household-vpn must be enabled in the platform resources registry")
    if box not in (app.get("boxes") or []):
        die("household-vpn registry placement.active_master must match --box")
    if "vpn-egress" not in set(app.get("resources") or []):
        die("household-vpn registry is missing the vpn-egress resource")
    specs = [
        spec
        for spec in data.get("app_vm_specs", [])
        if spec.get("app") == "household-vpn" and spec.get("node") == box
    ]
    if len(specs) != 1:
        die("household-vpn registry must compile exactly one app VM for --box")
    spec = specs[0]
    if spec.get("node_domain_role") != "dmz":
        die("household-vpn app VM must be in the DMZ role")
    if spec.get("guest_spec", {}).get("guest_os") != "alpine":
        die("household-vpn app VM must be Alpine")
    if spec.get("vm_ipv4_address") != "192.168.200.40":
        die("household-vpn app VM must use 192.168.200.40 for router policy routing")
    if "tag:household-vpn" not in (spec.get("advertised_tags") or []):
        die("household-vpn app VM must advertise tag:household-vpn")
    return data, spec


def render_box_inventory(box, output_path):
    run(
        [
            str(REPO_ROOT / "ansible" / "bin" / "render-node-inventory"),
            "--node",
            box,
            "--magicdns-suffix",
            MAGICDNS_SUFFIX,
            "--output",
            str(output_path),
        ]
    )


def render_app_inventory(registry, output_path):
    run(
        [
            str(REPO_ROOT / "ansible" / "bin" / "platform-resources"),
            "--registry",
            str(Path(registry).expanduser()),
            "--app",
            "household-vpn",
            "--magicdns-suffix",
            MAGICDNS_SUFFIX,
            "--inventory-output",
            str(output_path),
            "inventory",
        ]
    )


def write_vars(tmp, vpn_config, local_domain):
    data = load_yaml(vpn_config)
    path = tmp / "household-vpn-vars.yml"
    path.write_text(
        yaml.safe_dump(
            {
                "household_vpn_config": data,
                "household_vpn_local_domain": local_domain,
            },
            sort_keys=True,
        ),
        encoding="utf-8",
    )
    return path


def ansible_env():
    env = os.environ.copy()
    env["ANSIBLE_CONFIG"] = str(ANSIBLE_CONFIG)
    env["ANSIBLE_ROLES_PATH"] = ROLE_PATH
    env["ANSIBLE_SSH_ARGS"] = "-o ControlMaster=no -o ControlPersist=no"
    env["ANSIBLE_SSH_TRANSFER_METHOD"] = "piped"
    env["ANSIBLE_SSH_USETTY"] = "false"
    return env


def write_tailscale_ssh_wrapper(tmp):
    path = tmp / "tailscale-ssh"
    path.write_text(
        """#!/bin/sh
set -eu

user=""
host=""
while [ "$#" -gt 0 ]; do
  case "$1" in
    -l)
      user="$2"
      shift 2
      ;;
    -o)
      option="$2"
      case "$option" in
        User=*)
          user="${option#User=}"
          user="${user#\\"}"
          user="${user%\\"}"
          ;;
      esac
      shift 2
      ;;
    -i|-F|-S|-b|-c|-m|-p)
      shift 2
      ;;
    -tt|-t|-T|-C)
      shift
      ;;
    --)
      shift
      break
      ;;
    -*)
      shift
      ;;
    *)
      host="$1"
      shift
      break
      ;;
  esac
done

if [ -z "$host" ]; then
  printf '%s\\n' "tailscale-ssh: missing host" >&2
  exit 255
fi
if [ -n "$user" ]; then
  host="$user@$host"
fi
exec tailscale ssh "$host" "$@"
""",
        encoding="utf-8",
    )
    path.chmod(0o700)
    return path


def run_playbook(tmp, playbook, limit, vars_path, inventories):
    argv = ["ansible-playbook", "-vv"]
    for inventory in inventories:
        argv.extend(["-i", str(inventory)])
    argv.extend([str(playbook), "--limit", limit, "-e", f"@{vars_path}"])
    env = ansible_env()
    env["ANSIBLE_SSH_EXECUTABLE"] = str(write_tailscale_ssh_wrapper(tmp))
    env["ANSIBLE_SSH_COMMON_ARGS"] = (
        "-o StrictHostKeyChecking=accept-new "
        f"-o UserKnownHostsFile={tmp / 'known_hosts'}"
    )
    run(argv, env=env)


def prepare_inventory(tmp, registry, box):
    box_inventory = tmp / f"{box}.yml"
    app_inventory = tmp / "household-vpn-app-vms.yml"
    render_box_inventory(box, box_inventory)
    render_app_inventory(registry, app_inventory)
    return [BASE_INVENTORY, box_inventory, app_inventory]


def apply_platform_resources(registry, approved_commit):
    run(
        [
            str(REPO_ROOT / "ansible" / "bin" / "platform-resources"),
            "--registry",
            str(Path(registry).expanduser()),
            "--app",
            "household-vpn",
            "--approved-commit",
            approved_commit or git_head(),
            "apply",
        ]
    )


def cmd_install(args):
    require_box(args.box, "--box")
    local_domain = require_domain(args.local_domain, "--local-domain")
    _, spec = load_resources(args.resources_registry, args.box)
    with tempfile.TemporaryDirectory(prefix="household-vpnctl-") as tmp_name:
        tmp = Path(tmp_name)
        inventories = prepare_inventory(tmp, args.resources_registry, args.box)
        vars_path = write_vars(tmp, args.vpn_config, local_domain)
        run_playbook(
            tmp,
            PLAYBOOK_DIR / "20-install.yml",
            spec["inventory_hostname"],
            vars_path,
            inventories,
        )


def cmd_verify(args):
    require_box(args.box, "--box")
    _, spec = load_resources(args.resources_registry, args.box)
    with tempfile.TemporaryDirectory(prefix="household-vpnctl-") as tmp_name:
        tmp = Path(tmp_name)
        inventories = prepare_inventory(tmp, args.resources_registry, args.box)
        vars_path = tmp / "empty-vars.yml"
        vars_path.write_text("{}\n", encoding="utf-8")
        run_playbook(
            tmp,
            PLAYBOOK_DIR / "40-verify.yml",
            spec["inventory_hostname"],
            vars_path,
            inventories,
        )


def cmd_deploy(args):
    require_box(args.box, "--box")
    require_domain(args.local_domain, "--local-domain")
    load_resources(args.resources_registry, args.box)
    apply_platform_resources(args.resources_registry, args.approved_commit)
    cmd_install(args)
    cmd_verify(args)


def cmd_status(args):
    require_box(args.box, "--box")
    _, spec = load_resources(args.resources_registry, args.box)
    print(f"hostname={spec['inventory_hostname']}")
    print(f"tailnet={spec['tailnet_hostname']}.{MAGICDNS_SUFFIX}")
    print(f"ipv4={spec['vm_ipv4_address']}")


def build_parser():
    parser = argparse.ArgumentParser(description="Deploy and verify the Klokast household VPN gateway.")
    subparsers = parser.add_subparsers(dest="command", required=True)
    for name in ("deploy", "install", "verify", "status"):
        command = subparsers.add_parser(name)
        command.add_argument("--box", required=True)
        command.add_argument(
            "--resources-registry",
            default=RESOURCES_REGISTRY_DEFAULT,
            help="private platform resources registry",
        )
        if name in ("deploy", "install"):
            command.add_argument(
                "--vpn-config",
                default=VPN_CONFIG_DEFAULT,
                help="private Mihomo subscription config",
            )
            command.add_argument(
                "--local-domain",
                default=LOCAL_DOMAIN_DEFAULT,
                help="owned split-DNS domain for local apps",
            )
        if name == "deploy":
            command.add_argument(
                "--approved-commit",
                default="",
                help="approved pushed repo commit; defaults to HEAD",
            )
    return parser


def main():
    args = build_parser().parse_args()
    if args.command == "deploy":
        cmd_deploy(args)
    elif args.command == "install":
        cmd_install(args)
    elif args.command == "verify":
        cmd_verify(args)
    else:
        cmd_status(args)


if __name__ == "__main__":
    main()
