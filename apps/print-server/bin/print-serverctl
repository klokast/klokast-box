#!/usr/bin/env python3
"""Manage the disposable print appliance from the active controller."""
import argparse
import http.client
import json
from pathlib import Path
import runpy
import socket
import struct
import subprocess
import sys
import time

REPO=Path(__file__).resolve().parents[3]


def execute(argv):
    subprocess.run([str(v) for v in argv],check=True)


def main():
    parser=argparse.ArgumentParser(description=__doc__)
    parser.add_argument('command',choices=('preflight','install','rebuild','verify','test-page'))
    parser.add_argument('--box',required=True)
    args=parser.parse_args()
    tool=REPO/'ansible/bin/platform-print-appliance'
    if args.command in ('install','rebuild','preflight'):
        execute([tool,'preflight' if args.command=='preflight' else 'build','--box',args.box])
        return
    sys.path.insert(0,str(REPO/'ansible/lib'))
    import print_appliance
    data,spec,config=print_appliance.context(args.box)
    probe=runpy.run_path(str(Path(__file__).with_name('print-lan-check')))
    suffix=subprocess.check_output([str(REPO/'ansible/bin/magicdns-suffix')],text=True).strip()
    hostname=spec['node_hostname']+'.'+suffix
    if config['lan_subnet']:
        execute([Path(__file__).with_name('print-lan-check'),'--box',args.box,'--subnet',config['lan_subnet']])
    connection=http.client.HTTPConnection(hostname,631,timeout=10)
    connection.request('GET','/admin/')
    response=connection.getresponse();response.read()
    if response.status not in (401,403):raise RuntimeError('remote CUPS administration must be denied')
    for port in (22,):
        try:
            with socket.create_connection((hostname,port),timeout=3):
                raise RuntimeError('unexpected management listener on print appliance')
        except (TimeoutError,ConnectionRefusedError,OSError):pass
    def attribute(tag,name,value):
        name,value=name.encode(),value.encode()
        return bytes([tag])+struct.pack('!H',len(name))+name+struct.pack('!H',len(value))+value
    def inspect_ipp(job=None):
        body=struct.pack('!BBHI',2,0,9 if job else 11,1)+b'\x01'
        for tag,name,value in [(0x47,'attributes-charset','utf-8'),(0x48,'attributes-natural-language','en'),
                               (0x45,'printer-uri','ipp://'+hostname+':631/printers/epson'),(0x42,'requesting-user-name','smith')]:
            body+=attribute(tag,name,value)
        if job:body+=b'\x21\x00\x06job-id\x00\x04'+struct.pack('!I',job)
        channel=http.client.HTTPConnection(hostname,631,timeout=10)
        try:
            channel.request('POST','/printers/epson',body+b'\x03',{'Content-Type':'application/ipp'})
            response=channel.getresponse();reply=response.read()
            if response.status!=200 or len(reply)<8 or struct.unpack_from('!H',reply,2)[0]>255:
                raise RuntimeError('print IPP query failed')
            return probe['attributes'](reply)
        finally:channel.close()
    formats={value.decode() for _,value in inspect_ipp().get('document-format-supported',[])}
    if not {'application/pdf','image/urf'}<=formats:raise RuntimeError('print queue does not advertise PDF and AirPrint raster support')
    if args.command=='verify':
        print(json.dumps(dict(hostname=hostname,administration_denied=True,ssh_unreachable=True)))
        return
    # Submit exactly one PDF page through IPP, using the advertised format.
    body=struct.pack('!BBHI',2,0,2,1)+b'\x01'
    for tag,name,value in [(0x47,'attributes-charset','utf-8'),(0x48,'attributes-natural-language','en'),
                           (0x45,'printer-uri','ipp://'+hostname+':631/printers/epson'),
                           (0x42,'requesting-user-name','smith'),(0x42,'job-name','Klokast print appliance test'),
                           (0x49,'document-format','application/pdf')]:
        body+=attribute(tag,name,value)
    content=b'BT /F1 18 Tf 72 750 Td (Klokast print appliance test) Tj ET\n'
    objects=[b'<< /Type /Catalog /Pages 2 0 R >>',b'<< /Type /Pages /Kids [3 0 R] /Count 1 >>',
             b'<< /Type /Page /Parent 2 0 R /MediaBox [0 0 595 842] /Resources << /Font << /F1 4 0 R >> >> /Contents 5 0 R >>',
             b'<< /Type /Font /Subtype /Type1 /BaseFont /Helvetica >>',
             b'<< /Length '+str(len(content)).encode()+b' >>\nstream\n'+content+b'endstream']
    document=b'%PDF-1.4\n';offsets=[]
    for number,value in enumerate(objects,1):
        offsets.append(len(document));document+=str(number).encode()+b' 0 obj\n'+value+b'\nendobj\n'
    xref=len(document)
    document+=b'xref\n0 6\n0000000000 65535 f \n'+b''.join(f'{offset:010d} 00000 n \n'.encode() for offset in offsets)
    document+=b'trailer\n<< /Size 6 /Root 1 0 R >>\nstartxref\n'+str(xref).encode()+b'\n%%EOF\n'
    body+=b'\x03'+document
    connection.request('POST','/printers/epson',body,{'Content-Type':'application/ipp'})
    response=connection.getresponse();reply=response.read();connection.close()
    if response.status!=200 or len(reply)<8 or struct.unpack_from('!H',reply,2)[0]>255:
        raise RuntimeError('test submission failed or is uncertain; inspect jobs before submitting again')
    attributes=probe['attributes'](reply)
    job=struct.unpack('!I',attributes['job-id'][0][1])[0]
    print('Submitted exactly one test job: epson-'+str(job),flush=True)
    for _ in range(40):
        values=inspect_ipp(job)
        result={'job-id':job}
        for key in ('job-state','job-impressions-completed'):
            entries=values.get(key,[])
            if entries and len(entries[0][1])==4:result[key]=struct.unpack('!I',entries[0][1])[0]
        if result.get('job-state')==9:
            print(json.dumps(result));return
        if result.get('job-state') in (7,8):raise RuntimeError('test job failed; do not resubmit automatically')
        time.sleep(3)
    raise RuntimeError('test job still pending; inspect it before submitting again')



if __name__=='__main__':
    try:main()
    except (RuntimeError,OSError,ValueError) as error:
        print('print-serverctl: '+str(error),file=sys.stderr);raise SystemExit(1)
