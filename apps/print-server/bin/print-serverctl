#!/usr/bin/env python3
"""Manage the disposable print appliance from the active controller."""
import argparse
import http.client
import json
from pathlib import Path
import runpy
import socket
import struct
import subprocess
import sys
import time

REPO=Path(__file__).resolve().parents[3]


def execute(argv):
    subprocess.run([str(v) for v in argv],check=True)


def attribute(tag,name,value):
    name,value=name.encode(),value.encode()
    return bytes([tag])+struct.pack('!H',len(name))+name+struct.pack('!H',len(value))+value


def query(hostname,parse,job=None):
    """Send one read-only IPP Get-Printer-Attributes, or Get-Job-Attributes for job, to queue epson.

    Return the IPP status code and the attributes.
    """
    body=struct.pack('!BBHI',2,0,9 if job else 11,1)+b'\x01'
    for tag,name,value in [(0x47,'attributes-charset','utf-8'),(0x48,'attributes-natural-language','en'),
                           (0x45,'printer-uri','ipp://'+hostname+':631/printers/epson'),(0x42,'requesting-user-name','smith')]:
        body+=attribute(tag,name,value)
    if job:body+=b'\x21\x00\x06job-id\x00\x04'+struct.pack('!I',job)
    channel=http.client.HTTPConnection(hostname,631,timeout=10)
    try:
        channel.request('POST','/printers/epson',body+b'\x03',{'Content-Type':'application/ipp'})
        response=channel.getresponse();reply=response.read()
        if response.status!=200 or len(reply)<8:raise RuntimeError('print IPP query failed: HTTP %d'%response.status)
        return struct.unpack_from('!H',reply,2)[0],parse(reply)
    finally:channel.close()


STATES={3:'idle',4:'processing',5:'stopped'}
LOW_INK=10  # percent, when the printer states no low level


def check(name,state,detail):
    return {'name':name,'state':state,'detail':detail}


def integers(values,key):
    return [struct.unpack('!i',value)[0] for _,value in values.get(key,[]) if len(value)==4]


def texts(values,key):
    return [value.decode('utf-8','replace') for _,value in values.get(key,[])]


def queue_checks(box,hostname,parse):
    """Read-only checks of the CUPS queue. They submit no job and change no setting."""
    found=[]
    try:
        connection=http.client.HTTPConnection(hostname,631,timeout=10)
        try:
            connection.request('GET','/admin/');response=connection.getresponse();response.read()
        finally:connection.close()
        found.append(check('Remote administration','ok' if response.status in (401,403) else 'failed',
                           'denied (HTTP %d)'%response.status if response.status in (401,403) else 'not denied (HTTP %d)'%response.status))
        status,values=query(hostname,parse)
    except (RuntimeError,OSError,ValueError) as error:
        return found+[check('CUPS queue','failed','no answer from '+hostname+':631: '+str(error)[-200:])]
    if status==0x0406:
        # Queue setup at boot needs the printer, so the VM cannot work until a person powers it on.
        # restart_requires lets the Platform stop the VM; kk restart starts it again.
        return found+[dict(check('CUPS queue','warning','queue epson is absent: the printer was off or unreachable when '+box+
                                 '-print booted, so print jobs fail'),restart_requires='power on the printer')]
    if status>255:return found+[check('CUPS queue','failed','IPP status 0x%04x'%status)]
    found.append(check('CUPS queue','ok','epson: '+(' '.join(texts(values,'printer-make-and-model')) or 'unknown model')))
    state=STATES.get((integers(values,'printer-state') or [0])[0],'unknown')
    reasons=[r for r in texts(values,'printer-state-reasons') if r!='none']
    accepting=values.get('printer-is-accepting-jobs',[(0,b'')])[0][1]==b'\x01'
    level='failed' if state in ('stopped','unknown') or not accepting or any(r.endswith('-error') for r in reasons) else \
          'warning' if any(r.endswith('-warning') for r in reasons) else 'ok'
    message=' '.join(texts(values,'printer-state-message'))
    found.append(check('Printer state',level,state+('; accepting jobs' if accepting else '; not accepting jobs')+
                       ('; reasons: '+', '.join(reasons) if reasons else '')+('; '+message if message else '')))
    jobs=integers(values,'queued-job-count')
    found.append(check('Queued jobs','ok','%d'%jobs[0] if jobs else 'unknown'))
    names,levels,lows=texts(values,'marker-names'),integers(values,'marker-levels'),integers(values,'marker-low-levels')
    if not names or len(names)!=len(levels):
        found.append(check('Ink levels','skipped','the printer reports no ink levels'))
    else:
        low=[n for n,v,l in zip(names,levels,lows or [LOW_INK]*len(names)) if 0<=v<=max(l,0)]
        found.append(check('Ink levels','warning' if low else 'ok',', '.join(
            n+' '+('%d%%'%v if v>=0 else 'unknown') for n,v in zip(names,levels))))
    return found


def health(box,tool):
    """The Platform appliance checks, then the CUPS queue checks over IPP."""
    found=json.loads(subprocess.check_output([str(tool),'health','--box',box],text=True))['checks']
    if any(c['name']=='Xen guest' and c['state']=='failed' for c in found):
        return {'checks':found+[check('CUPS queue','skipped','the appliance does not run')]}
    config=json.loads(subprocess.check_output([str(tool),'preflight','--box',box],text=True))
    suffix=subprocess.check_output([str(REPO/'ansible/bin/magicdns-suffix')],text=True).strip()
    parse=runpy.run_path(str(Path(__file__).with_name('print-lan-check')))['attributes']
    return {'checks':found+queue_checks(box,config['hostname']+'.'+suffix,parse)}


def main():
    parser=argparse.ArgumentParser(description=__doc__)
    parser.add_argument('command',choices=('preflight','install','rebuild','verify','health','test-page'))
    parser.add_argument('--box',required=True)
    args=parser.parse_args()
    tool=REPO/'ansible/bin/platform-print-appliance'
    if args.command in ('install','rebuild','preflight'):
        execute([tool,'preflight' if args.command=='preflight' else 'build','--box',args.box])
        return
    if args.command=='health':
        # One JSON line for machine-status show.
        print(json.dumps(health(args.box,tool)));return
    config=json.loads(subprocess.check_output([str(tool),'preflight','--box',args.box],text=True))
    probe=runpy.run_path(str(Path(__file__).with_name('print-lan-check')))
    suffix=subprocess.check_output([str(REPO/'ansible/bin/magicdns-suffix')],text=True).strip()
    hostname=config['hostname']+'.'+suffix
    if config['lan_subnet']:
        execute([Path(__file__).with_name('print-lan-check'),'--box',args.box,'--subnet',config['lan_subnet']])
    connection=http.client.HTTPConnection(hostname,631,timeout=10)
    connection.request('GET','/admin/')
    response=connection.getresponse();response.read()
    if response.status not in (401,403):raise RuntimeError('remote CUPS administration must be denied')
    for port in (22,):
        try:
            with socket.create_connection((hostname,port),timeout=3):
                raise RuntimeError('unexpected management listener on print appliance')
        except (TimeoutError,ConnectionRefusedError,OSError):pass
    def inspect_ipp(job=None):
        status,values=query(hostname,probe['attributes'],job)
        if status>255:raise RuntimeError('print IPP query failed')
        return values
    formats={value.decode() for _,value in inspect_ipp().get('document-format-supported',[])}
    if not {'application/pdf','image/urf'}<=formats:raise RuntimeError('print queue does not advertise PDF and AirPrint raster support')
    if args.command=='verify':
        print(json.dumps(dict(hostname=hostname,administration_denied=True,ssh_unreachable=True)))
        return
    # Submit exactly one PDF page through IPP, using the advertised format.
    body=struct.pack('!BBHI',2,0,2,1)+b'\x01'
    for tag,name,value in [(0x47,'attributes-charset','utf-8'),(0x48,'attributes-natural-language','en'),
                           (0x45,'printer-uri','ipp://'+hostname+':631/printers/epson'),
                           (0x42,'requesting-user-name','smith'),(0x42,'job-name','Klokast print appliance test'),
                           (0x49,'document-format','application/pdf')]:
        body+=attribute(tag,name,value)
    content=b'BT /F1 18 Tf 72 750 Td (Klokast print appliance test) Tj ET\n'
    objects=[b'<< /Type /Catalog /Pages 2 0 R >>',b'<< /Type /Pages /Kids [3 0 R] /Count 1 >>',
             b'<< /Type /Page /Parent 2 0 R /MediaBox [0 0 595 842] /Resources << /Font << /F1 4 0 R >> >> /Contents 5 0 R >>',
             b'<< /Type /Font /Subtype /Type1 /BaseFont /Helvetica >>',
             b'<< /Length '+str(len(content)).encode()+b' >>\nstream\n'+content+b'endstream']
    document=b'%PDF-1.4\n';offsets=[]
    for number,value in enumerate(objects,1):
        offsets.append(len(document));document+=str(number).encode()+b' 0 obj\n'+value+b'\nendobj\n'
    xref=len(document)
    document+=b'xref\n0 6\n0000000000 65535 f \n'+b''.join(f'{offset:010d} 00000 n \n'.encode() for offset in offsets)
    document+=b'trailer\n<< /Size 6 /Root 1 0 R >>\nstartxref\n'+str(xref).encode()+b'\n%%EOF\n'
    body+=b'\x03'+document
    connection.request('POST','/printers/epson',body,{'Content-Type':'application/ipp'})
    response=connection.getresponse();reply=response.read();connection.close()
    if response.status!=200 or len(reply)<8 or struct.unpack_from('!H',reply,2)[0]>255:
        raise RuntimeError('test submission failed or is uncertain; inspect jobs before submitting again')
    attributes=probe['attributes'](reply)
    job=struct.unpack('!I',attributes['job-id'][0][1])[0]
    print('Submitted exactly one test job: epson-'+str(job),flush=True)
    for _ in range(40):
        values=inspect_ipp(job)
        result={'job-id':job}
        for key in ('job-state','job-impressions-completed'):
            entries=values.get(key,[])
            if entries and len(entries[0][1])==4:result[key]=struct.unpack('!I',entries[0][1])[0]
        if result.get('job-state')==9:
            print(json.dumps(result));return
        if result.get('job-state') in (7,8):raise RuntimeError('test job failed; do not resubmit automatically')
        time.sleep(3)
    raise RuntimeError('test job still pending; inspect it before submitting again')



def refusal(error):
    """Give the reason of a failed run as one line."""
    if isinstance(error,subprocess.CalledProcessError):
        # The failed command has written its own reason.
        return Path(str(error.cmd[0])).name+' failed'
    return str(error)


if __name__=='__main__':
    try:main()
    except (RuntimeError,OSError,ValueError,subprocess.CalledProcessError) as error:
        print('print-serverctl: '+refusal(error),file=sys.stderr);raise SystemExit(1)
