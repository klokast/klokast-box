#!/usr/bin/env python3
"""Read-only Bonjour and IPP check from a controller on the declared RG LAN."""
import argparse
import http.client
import ipaddress
import json
import shutil
import socket
import struct
import subprocess
import time
from urllib.parse import urlsplit


def name(data, offset, seen=None):
    seen = set() if seen is None else seen
    if offset in seen or len(seen) > 128:
        raise ValueError('invalid DNS compression')
    seen.add(offset)
    parts = []
    while True:
        size = data[offset]
        offset += 1
        if size == 0:
            return '.'.join(parts), offset
        if size & 192 == 192:
            target = ((size & 63) << 8) | data[offset]
            suffix, _ = name(data, target, seen)
            return '.'.join(parts + [suffix]), offset + 1
        if size > 63 or offset + size > len(data):
            raise ValueError('invalid DNS label')
        parts.append(data[offset:offset+size].decode('utf-8'))
        offset += size


def records(data):
    _, flags, questions, answers, authority, additional = struct.unpack_from('!6H', data)
    if not flags & 0x8000:
        return []
    offset = 12
    for _ in range(questions):
        _, offset = name(data, offset)
        offset += 4
    result = []
    for _ in range(answers + authority + additional):
        owner, offset = name(data, offset)
        kind, _, ttl, size = struct.unpack_from('!HHIH', data, offset)
        offset += 10
        start = offset
        offset += size
        if offset > len(data):
            raise ValueError('truncated DNS record')
        value = data[start:offset]
        if kind == 1 and size == 4:
            value = socket.inet_ntoa(value)
        elif kind == 12:
            value, _ = name(data, start)
        elif kind == 33:
            _, _, port = struct.unpack_from('!HHH', data, start)
            target, _ = name(data, start + 6)
            value = (target, port)
        elif kind == 16:
            value = []
            while start < offset:
                length = data[start]
                start += 1
                if start + length > offset:
                    raise ValueError('invalid DNS TXT')
                value.append(data[start:start+length].decode('utf-8'))
                start += length
        if ttl:
            result.append((owner, kind, value))
    return result


def attributes(body):
    """Read bounded IPP attributes; continuation values retain their last name."""
    offset, last = 8, None
    values = {}
    while offset < len(body):
        tag = body[offset]
        offset += 1
        if tag == 3:
            break
        if tag < 16:
            last = None
            continue
        if offset + 2 > len(body):
            raise ValueError('truncated IPP attribute name')
        size = struct.unpack_from('!H', body, offset)[0]
        offset += 2
        if offset + size + 2 > len(body):
            raise ValueError('truncated IPP attribute')
        if size:
            last = body[offset:offset+size].decode('ascii')
        offset += size
        size = struct.unpack_from('!H', body, offset)[0]
        offset += 2
        if offset + size > len(body) or last is None:
            raise ValueError('invalid IPP attribute value')
        value = body[offset:offset+size]
        offset += size
        values.setdefault(last, []).append((tag, value))
    return values


def check(box, subnet, job_id=None):
    network = ipaddress.ip_network(subnet)
    ip_command = shutil.which('ip') or '/sbin/ip'
    addresses = json.loads(subprocess.check_output([ip_command, '-j', '-4', 'addr', 'show']))
    local = [a['local'] for link in addresses for a in link['addr_info']
             if ipaddress.ip_address(a['local']) in network]
    if len(local) != 1:
        raise RuntimeError('verification requires one controller address on the declared RG LAN')
    host = box + '-bak-printer.local'
    instance = 'Epson XP-55 (' + box + ')._ipp._tcp.local'
    found = {}
    with socket.socket(socket.AF_INET, socket.SOCK_DGRAM) as sock:
        sock.bind((local[0], 0))
        sock.setsockopt(socket.IPPROTO_IP, socket.IP_MULTICAST_IF, socket.inet_aton(local[0]))
        sock.setsockopt(socket.IPPROTO_IP, socket.IP_MULTICAST_TTL, 255)
        sock.settimeout(1)
        deadline = time.monotonic() + 15
        while time.monotonic() < deadline:
            for target, kind in [('_ipp._tcp.local', 12), (instance, 33), (instance, 16), (host, 1)]:
                query = struct.pack('!6H', 1, 0, 1, 0, 0, 0)
                query += b''.join(bytes([len(x.encode())]) + x.encode() for x in target.split('.')) + b'\0'
                sock.sendto(query + struct.pack('!HH', kind, 1), ('224.0.0.251', 5353))
            try:
                data, source = sock.recvfrom(65535)
                if ipaddress.ip_address(source[0]) not in network:
                    continue
                for owner, kind, value in records(data):
                    if kind == 12 and value != instance:
                        continue
                    found[(owner, kind)] = value
            except (socket.timeout, ValueError, IndexError, UnicodeError, struct.error):
                continue
            if (found.get(('_ipp._tcp.local', 12)) == instance and
                    found.get((instance, 33)) == (host, 631) and
                    'rp=printers/epson' in found.get((instance, 16), []) and (host, 1) in found):
                break
        else:
            raise RuntimeError('Bonjour did not return the expected PTR, SRV, TXT and A records')
    address = found[(host, 1)]
    if ipaddress.ip_address(address) not in network:
        raise RuntimeError('Bonjour returned an address outside the RG LAN')
    uri = 'ipp://' + host + ':631/printers/epson'
    def attribute(tag, key, value):
        key, value = key.encode(), value.encode()
        return bytes([tag]) + struct.pack('!H', len(key)) + key + struct.pack('!H', len(value)) + value
    request = struct.pack('!BBHI', 2, 0, 0x0009 if job_id else 0x000b, 1) + b'\x01'
    request += attribute(0x47, 'attributes-charset', 'utf-8')
    request += attribute(0x48, 'attributes-natural-language', 'en')
    request += attribute(0x45, 'printer-uri', uri)
    if job_id:
        request += b'\x21\x00\x06job-id\x00\x04' + struct.pack('!I', job_id)
    request += b'\x03'
    connection = http.client.HTTPConnection(address, 631, timeout=10)
    connection.request('POST', '/printers/epson', request,
                       {'Host': host + ':631', 'Content-Type': 'application/ipp'})
    response = connection.getresponse()
    body = response.read()
    if response.status != 200 or len(body) < 8 or struct.unpack_from('!H', body, 2)[0] > 0xff:
        raise RuntimeError('LAN IPP Get-Printer-Attributes failed')
    values = attributes(body)
    if not job_id:
        txt = dict(entry.split('=', 1) for entry in found.get((instance, 16), []) if '=' in entry)
        formats = {value.decode() for _, value in values.get('document-format-supported', [])}
        advertised = set(txt.get('pdl', '').split(','))
        if not {'application/pdf', 'image/urf'} <= advertised <= formats:
            raise RuntimeError('CUPS does not confirm the advertised PDF and AirPrint raster formats')
        raster = {value.decode() for _, value in values.get('urf-supported', [])}
        advertised_raster = set(txt.get('URF', '').split(','))
        if not advertised_raster or '' in advertised_raster or not advertised_raster <= raster:
            raise RuntimeError('CUPS does not confirm the advertised AirPrint raster capabilities')
        uris = [urlsplit(value.decode()) for _, value in values.get('printer-uri-supported', [])]
        if not any(u.scheme == 'ipp' and u.hostname == host and u.port in (None, 631)
                   and u.path == '/printers/epson' for u in uris):
            raise RuntimeError('CUPS does not return a LAN printer URI usable without Tailscale')
    connection.request('GET', '/admin/', headers={'Host': host + ':631'})
    response = connection.getresponse()
    response.read()
    if response.status not in (401, 403):
        raise RuntimeError('LAN CUPS administration is not denied')
    connection.close()
    result = {'ok': True, 'hostname': host, 'ipv4': address, 'uri': uri,
              'bonjour': True, 'ipp': True, 'administration_denied': True}
    if job_id:
        for key in ('job-state', 'job-impressions-completed'):
            entries = values.get(key, [])
            if entries and len(entries[0][1]) == 4:
                result[key] = struct.unpack('!I', entries[0][1])[0]
        result['job-id'] = job_id
    print(json.dumps(result))


if __name__ == '__main__':
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument('--box', required=True)
    parser.add_argument('--subnet', required=True)
    parser.add_argument('--job-id', type=int, help='Read the status of an already submitted test job')
    args = parser.parse_args()
    if args.job_id is not None and args.job_id <= 0:
        parser.error('--job-id must be positive')
    check(args.box, args.subnet, args.job_id)
