ARG ALPINE_IMAGE=docker.io/library/alpine:3.23
FROM ${ALPINE_IMAGE}
ARG ALPINE_MIRROR
RUN test -n "$ALPINE_MIRROR" && \
    sed -i "s#https\?://[^/]*/alpine/#${ALPINE_MIRROR%/}/#g" /etc/apk/repositories

RUN env -u http_proxy -u https_proxy -u HTTP_PROXY -u HTTPS_PROXY -u ALL_PROXY -u all_proxy apk add --no-cache \
    busybox-extras \
    ca-certificates \
    cups \
    cups-client \
    cups-filters \
    jq \
    shadow \
    tailscale \
    tzdata

COPY print-server-entrypoint /usr/local/bin/print-server-entrypoint
RUN chmod 0755 /usr/local/bin/print-server-entrypoint

ENTRYPOINT ["/usr/local/bin/print-server-entrypoint"]
