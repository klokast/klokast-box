#!/bin/sh
set -eu

token_file={{ (static_site_secret_root ~ '/cloudflared-token') | quote }}

if [ ! -x /usr/bin/cloudflared ]; then
    echo "cloudflared package is not installed" >&2
    exit 1
fi

if [ ! -s "$token_file" ]; then
    echo "Cloudflare tunnel token file is missing or empty: $token_file" >&2
    exit 1
fi

/usr/bin/python3 - "$token_file" <<'PY'
import base64
import json
import sys

token = open(sys.argv[1], encoding="utf-8").read().strip()
try:
    payload = base64.b64decode(token + "=" * (-len(token) % 4))
    value = json.loads(payload.decode("utf-8"))
except Exception as error:
    raise SystemExit(f"Cloudflare tunnel token is not a raw base64 JSON token: {error}")

if not isinstance(value, dict):
    raise SystemExit("Cloudflare tunnel token payload is not a JSON object")
PY

/usr/bin/cloudflared --version >/dev/null
