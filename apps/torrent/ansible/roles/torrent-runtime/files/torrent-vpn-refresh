#!/usr/bin/env python3
import argparse
import hashlib
import os
import pathlib
import pwd
import shlex
import subprocess
import sys
import tempfile
import urllib.error
import urllib.request

import yaml


PRIVATE_PATH = pathlib.Path("/etc/klokast/torrent-vpn/private.yml")
SUBSCRIPTION_PATH = pathlib.Path("/etc/mihomo/subscription.yml")
CONFIG_PATH = pathlib.Path("/etc/mihomo/config.yaml")
RENDERER = pathlib.Path("/usr/local/libexec/torrent-vpn-render")
SERVICE = "mihomo"
QBITTORRENT_USER = "qbittorrent"
USER_AGENT = "clash.meta"


def die(message):
    print(f"torrent-vpn-refresh: {message}", file=sys.stderr)
    raise SystemExit(1)


def load_private(path):
    try:
        with path.open(encoding="utf-8") as handle:
            data = yaml.safe_load(handle) or {}
    except FileNotFoundError:
        die(f"missing private config: {path}")
    if not isinstance(data, dict):
        die(f"{path} must be a YAML mapping")
    if not bool(data.get("enabled")):
        die("private config has enabled=false")
    url = data.get("subscription_url")
    if not isinstance(url, str) or not url.startswith(("http://", "https://")):
        die("private config subscription_url must be http(s)")
    return data


def sha256_path(path):
    if not path.exists():
        return ""
    digest = hashlib.sha256()
    with path.open("rb") as handle:
        for chunk in iter(lambda: handle.read(1024 * 1024), b""):
            digest.update(chunk)
    return digest.hexdigest()


def install_bytes(path, data, mode):
    path.parent.mkdir(parents=True, exist_ok=True)
    fd, tmp_name = tempfile.mkstemp(prefix=f".{path.name}.", dir=str(path.parent))
    tmp = pathlib.Path(tmp_name)
    try:
        with os.fdopen(fd, "wb") as handle:
            handle.write(data)
        os.chown(tmp, 0, 0)
        os.chmod(tmp, mode)
        os.replace(tmp, path)
    finally:
        try:
            tmp.unlink()
        except FileNotFoundError:
            pass


def fetch_subscription(url):
    request = urllib.request.Request(url, headers={"User-Agent": USER_AGENT})
    with urllib.request.urlopen(request, timeout=120) as response:
        return response.read()


def main():
    parser = argparse.ArgumentParser(description="Refresh torrent VPN subscription/config.")
    parser.add_argument("--private", default=str(PRIVATE_PATH))
    parser.add_argument("--subscription", default=str(SUBSCRIPTION_PATH))
    parser.add_argument("--config", default=str(CONFIG_PATH))
    parser.add_argument("--renderer", default=str(RENDERER))
    parser.add_argument("--tun-device", default="klokastvpn")
    parser.add_argument("--use-existing-subscription", action="store_true")
    parser.add_argument("--no-restart", action="store_true")
    args = parser.parse_args()
    if os.geteuid() != 0:
        die("must run as root")
    private_path = pathlib.Path(args.private)
    subscription_path = pathlib.Path(args.subscription)
    config_path = pathlib.Path(args.config)
    private = load_private(private_path)
    before = {
        "subscription": sha256_path(subscription_path),
        "config": sha256_path(config_path),
    }
    if args.use_existing_subscription:
        if not subscription_path.exists():
            die(f"missing existing subscription: {subscription_path}")
    else:
        install_bytes(subscription_path, fetch_subscription(private["subscription_url"]), 0o640)
    qbit_uid = pwd.getpwnam(QBITTORRENT_USER).pw_uid
    subprocess.run(
        [
            args.renderer,
            "--private",
            str(private_path),
            "--subscription",
            str(subscription_path),
            "--output",
            str(config_path),
            "--qbittorrent-uid",
            str(qbit_uid),
            "--tun-device",
            args.tun_device,
        ],
        check=True,
    )
    os.chown(config_path, 0, 0)
    os.chmod(config_path, 0o640)
    after = {
        "subscription": sha256_path(subscription_path),
        "config": sha256_path(config_path),
    }
    changed = before != after
    if changed and not args.no_restart:
        subprocess.run(["rc-service", SERVICE, "restart"], check=True)
    print(f"changed={'yes' if changed else 'no'}")


if __name__ == "__main__":
    try:
        main()
    except urllib.error.URLError as exc:
        die(f"subscription fetch failed: {exc.reason}")
    except subprocess.CalledProcessError as exc:
        die(f"command failed: {shlex.join([str(part) for part in exc.cmd])}")
