worker_processes 1;
error_log {{ (nextcloud_private_ingress_log_root ~ '/proxy-error.log') | quote }} warn;
pid {{ nextcloud_private_ingress_proxy_pidfile | quote }};

events {
    worker_connections 128;
}

http {
    access_log {{ (nextcloud_private_ingress_log_root ~ '/proxy-access.log') | quote }};
    client_body_temp_path {{ (nextcloud_private_ingress_proxy_root ~ '/client_body_temp') | quote }};
    proxy_temp_path {{ (nextcloud_private_ingress_proxy_root ~ '/proxy_temp') | quote }};
    fastcgi_temp_path {{ (nextcloud_private_ingress_proxy_root ~ '/fastcgi_temp') | quote }};
    uwsgi_temp_path {{ (nextcloud_private_ingress_proxy_root ~ '/uwsgi_temp') | quote }};
    scgi_temp_path {{ (nextcloud_private_ingress_proxy_root ~ '/scgi_temp') | quote }};

    server {
        listen 127.0.0.1:{{ nextcloud_private_ingress_proxy_port }};
        server_name _;

        client_max_body_size 0;

        location / {
            proxy_pass {{ nextcloud_private_backend_upstream }};
            proxy_http_version 1.1;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Host $host;
            proxy_set_header X-Forwarded-Proto https;
            proxy_set_header Connection "";
            proxy_buffering off;
            proxy_request_buffering off;
            proxy_read_timeout 3600s;
            proxy_send_timeout 3600s;
        }
    }
}
