#!/sbin/openrc-run
description="Klokast Nextcloud private Tailscale ingress"

command="/usr/sbin/tailscaled"
command_args="--state={{ nextcloud_private_ingress_state_file }} --statedir={{ nextcloud_private_ingress_state_root }} --socket={{ nextcloud_private_ingress_socket }} --tun=userspace-networking --port=0"
command_user="{{ vm_admin_user_name }}:wheel"
command_background=yes
pidfile={{ nextcloud_private_ingress_pidfile | quote }}
supervisor="supervise-daemon"

depend() {
    need net {{ nextcloud_private_ingress_proxy_service_name }}
    after firewall
    use logger
}

start_pre() {
    checkpath -d -m 0755 -o {{ vm_admin_user_name }}:wheel {{ nextcloud_private_ingress_run_root | quote }} || return 1
    checkpath -d -m 0700 -o {{ vm_admin_user_name }}:wheel {{ nextcloud_private_ingress_state_root | quote }} || return 1
}

start_post() {
    for _ in $(seq 1 12); do
        if /usr/local/sbin/nextcloud-private-ingress-converge; then
            return 0
        fi
        sleep 5
    done
    return 1
}

stop_post() {
    rm -f {{ nextcloud_private_ingress_socket | quote }}
}
