#!/bin/sh
set -eu

pod_name={{ nextcloud_pod_name | quote }}
source_map={{ (nextcloud_service_root ~ '/image-sources.json') | quote }}
app_image={{ nextcloud_app_image | quote }}
backup_image={{ nextcloud_backup_image | quote }}
image_root={{ nextcloud_image_root | quote }}
env_root={{ nextcloud_env_root | quote }}
secret_root={{ nextcloud_secret_root | quote }}
nginx_conf={{ (nextcloud_nginx_root ~ '/nginx.conf') | quote }}
html_root={{ nextcloud_html_root | quote }}
data_root={{ nextcloud_data_root | quote }}
postgres_root={{ nextcloud_postgres_root | quote }}
redis_root={{ nextcloud_redis_root | quote }}
backup_root={{ nextcloud_backup_root | quote }}
restore_root={{ nextcloud_restore_root | quote }}
http_bind_host={{ nextcloud_http_bind_host | quote }}
http_host_port={{ (nextcloud_http_host_port | string) | quote }}
http_container_port={{ (nextcloud_http_container_port | string) | quote }}
site_mode={{ nextcloud_site_mode | quote }}

podman_cmd() {
    if [ "$(id -un)" = "{{ vm_admin_user_name }}" ]; then
        /usr/bin/podman "$@"
    else
        /usr/bin/doas -u {{ vm_admin_user_name }} /usr/bin/podman "$@"
    fi
}

image_ref() {
    /usr/bin/jq -r --arg key "$1" '.images[$key].pull_ref' "$source_map"
}

ensure_image() {
    image=$1
    if podman_cmd image exists "$image"; then
        return
    fi
    podman_cmd pull --policy=missing --retry=0 "$image"
}

image_user_id() {
    image=$1
    user=$2
    flag=$3
    podman_cmd run --rm --pull=never --entrypoint /bin/sh "$image" -c "id -${flag} ${user}"
}

nextcloud_exec_as_runtime() {
    podman_cmd exec --user "${app_runtime_uid}:${app_runtime_gid}" {{ nextcloud_fpm_container_name | quote }} "$@"
}

wait_for_nextcloud_code() {
    attempts=60
    while [ "$attempts" -gt 0 ]; do
        if nextcloud_exec_as_runtime /bin/sh -c 'test -f /var/www/html/occ && test -f /var/www/html/lib/versioncheck.php' >/dev/null 2>&1; then
            return
        fi
        attempts=$((attempts - 1))
        sleep 2
    done

    podman_cmd logs --tail 80 {{ nextcloud_fpm_container_name | quote }} >&2 || true
    echo "Nextcloud code tree did not finish initializing in /var/www/html" >&2
    exit 1
}

nextcloud_is_installed() {
    nextcloud_exec_as_runtime php occ status 2>/dev/null | /bin/grep -q 'installed: true'
}

ensure_nextcloud_installed() {
    if nextcloud_is_installed; then
        return
    fi

    nextcloud_exec_as_runtime /bin/sh -eu -c '
        php occ maintenance:install \
            --database pgsql \
            --database-host "${POSTGRES_HOST}" \
            --database-name "$(cat "${POSTGRES_DB_FILE}")" \
            --database-user "$(cat "${POSTGRES_USER_FILE}")" \
            --database-pass "$(cat "${POSTGRES_PASSWORD_FILE}")" \
            --admin-user "$(cat "${NEXTCLOUD_ADMIN_USER_FILE}")" \
            --admin-pass "$(cat "${NEXTCLOUD_ADMIN_PASSWORD_FILE}")" \
            --data-dir "${NEXTCLOUD_DATA_DIR}"
    '
}

ensure_nextcloud_system_config() {
    nextcloud_exec_as_runtime /bin/sh -eu -c '
        php occ status 2>/dev/null | grep -q "installed: true"

        if [ -n "${NEXTCLOUD_TRUSTED_DOMAINS:-}" ]; then
            set -f
            php occ config:system:delete trusted_domains >/dev/null 2>&1 || true
            idx=0
            for domain in ${NEXTCLOUD_TRUSTED_DOMAINS}; do
                php occ config:system:set trusted_domains "$idx" --value="$domain" >/dev/null
                idx=$((idx + 1))
            done
            set +f
        fi

        if [ -n "${TRUSTED_PROXIES:-}" ]; then
            set -f
            php occ config:system:delete trusted_proxies >/dev/null 2>&1 || true
            idx=0
            for proxy in ${TRUSTED_PROXIES}; do
                php occ config:system:set trusted_proxies "$idx" --value="$proxy" >/dev/null
                idx=$((idx + 1))
            done
            set +f
        fi

        if [ -n "${OVERWRITECLIURL:-}" ]; then
            php occ config:system:set overwrite.cli.url --value="${OVERWRITECLIURL}" >/dev/null
        fi
        if [ -n "${OVERWRITEHOST:-}" ]; then
            php occ config:system:set overwritehost --value="${OVERWRITEHOST}" >/dev/null
        else
            php occ config:system:delete overwritehost >/dev/null 2>&1 || true
        fi
        if [ -n "${OVERWRITEPROTOCOL:-}" ]; then
            php occ config:system:set overwriteprotocol --value="${OVERWRITEPROTOCOL}" >/dev/null
        fi
    '
}

sync_secret() {
    secret_name=$1
    secret_file=$2
    if podman_cmd secret exists "$secret_name"; then
        podman_cmd secret rm "$secret_name" >/dev/null
    fi
    podman_cmd secret create "$secret_name" "$secret_file" >/dev/null
}

ensure_rootless_owner() {
    target_path=$1
    target_uid=$2
    target_gid=$3

    if [ "$(id -u)" != "0" ]; then
        podman_cmd unshare chown "$target_uid:$target_gid" "$target_path"
        return
    fi

    host_uid=$(map_rootless_id "$target_uid" "$uid_map_file")
    host_gid=$(map_rootless_id "$target_gid" "$gid_map_file")
    current_owner=$(/bin/stat -c '%u:%g' "$target_path")
    if [ "$current_owner" != "$host_uid:$host_gid" ]; then
        /bin/chown "$host_uid:$host_gid" "$target_path"
    fi
}

map_rootless_id() {
    target_id=$1
    map_file=$2
    /usr/bin/awk -v target_id="$target_id" '
        target_id >= $1 && target_id < $1 + $3 {
            print $2 + target_id - $1
            found = 1
            exit
        }
        END {
            if (!found) {
                exit 1
            }
        }
    ' "$map_file"
}

uid_map_file=$(mktemp)
gid_map_file=$(mktemp)
trap 'rm -f "$uid_map_file" "$gid_map_file"' EXIT
podman_cmd unshare cat /proc/self/uid_map >"$uid_map_file"
podman_cmd unshare cat /proc/self/gid_map >"$gid_map_file"

nextcloud_fpm_ref=$(image_ref nextcloud_fpm)
nginx_ref=$(image_ref nginx)
postgres_ref=$(image_ref postgres)
redis_ref=$(image_ref redis)
alpine_ref=$(image_ref alpine)

ensure_image "$nextcloud_fpm_ref"
ensure_image "$nginx_ref"
ensure_image "$postgres_ref"
ensure_image "$redis_ref"
ensure_image "$alpine_ref"

podman_cmd build \
    --build-arg NEXTCLOUD_FPM_IMAGE="$nextcloud_fpm_ref" \
    -t "$app_image" \
    "$image_root/nextcloud-app"

podman_cmd build \
    --build-arg ALPINE_IMAGE="$alpine_ref" \
    -t "$backup_image" \
    "$image_root/nextcloud-backup"

app_runtime_uid=$(image_user_id "$app_image" www-data u)
app_runtime_gid=$(image_user_id "$app_image" www-data g)

if podman_cmd pod exists "$pod_name"; then
    podman_cmd pod rm -f "$pod_name"
fi

sync_secret nextcloud-admin-user "$secret_root/nextcloud-admin-user"
sync_secret nextcloud-admin-password "$secret_root/nextcloud-admin-password"
sync_secret postgres-db "$secret_root/postgres-db"
sync_secret postgres-user "$secret_root/postgres-user"
sync_secret postgres-password "$secret_root/postgres-password"
sync_secret restic-password "$secret_root/restic-password"

ensure_rootless_owner "$html_root" "$app_runtime_uid" "$app_runtime_gid"
ensure_rootless_owner "$data_root" "$app_runtime_uid" "$app_runtime_gid"
ensure_rootless_owner "$postgres_root" 70 70
ensure_rootless_owner "$redis_root" 999 999

podman_cmd pod create --name "$pod_name" -p "${http_bind_host}:${http_host_port}:${http_container_port}"

podman_cmd run -d \
    --name {{ nextcloud_postgres_container_name | quote }} \
    --pod "$pod_name" \
    --restart=unless-stopped \
    --env-file "$env_root/postgres.env" \
    -v "$postgres_root:/var/lib/postgresql/data" \
    --secret postgres-db,target=postgres-db,uid=0,gid=0,mode=0400 \
    --secret postgres-user,target=postgres-user,uid=0,gid=0,mode=0400 \
    --secret postgres-password,target=postgres-password,uid=0,gid=0,mode=0400 \
    --pull=never \
    "$postgres_ref"

podman_cmd run -d \
    --name {{ nextcloud_redis_container_name | quote }} \
    --pod "$pod_name" \
    --restart=unless-stopped \
    -v "$redis_root:/data" \
    --pull=never \
    "$redis_ref" \
    redis-server --save '' --appendonly yes

sleep 5

podman_cmd run -d \
    --name {{ nextcloud_fpm_container_name | quote }} \
    --pod "$pod_name" \
    --restart=unless-stopped \
    --env-file "$env_root/app.env" \
    -v "$html_root:/var/www/html" \
    -v "$data_root:/var/www/html-data" \
    --secret "nextcloud-admin-user,target=nextcloud-admin-user,uid=${app_runtime_uid},gid=${app_runtime_gid},mode=0400" \
    --secret "nextcloud-admin-password,target=nextcloud-admin-password,uid=${app_runtime_uid},gid=${app_runtime_gid},mode=0400" \
    --secret "postgres-db,target=postgres-db,uid=${app_runtime_uid},gid=${app_runtime_gid},mode=0400" \
    --secret "postgres-user,target=postgres-user,uid=${app_runtime_uid},gid=${app_runtime_gid},mode=0400" \
    --secret "postgres-password,target=postgres-password,uid=${app_runtime_uid},gid=${app_runtime_gid},mode=0400" \
    --pull=never \
    "$app_image"

podman_cmd run -d \
    --name {{ nextcloud_web_container_name | quote }} \
    --pod "$pod_name" \
    --restart=unless-stopped \
    --read-only \
    --tmpfs /var/cache/nginx:rw,size=64m \
    --tmpfs /var/run:rw,size=16m \
    --tmpfs /tmp:rw,size=64m \
    -v "$nginx_conf:/etc/nginx/nginx.conf:ro" \
    -v "$html_root:/var/www/html:ro" \
    --cap-drop=all \
    --cap-add=CHOWN \
    --cap-add=SETGID \
    --cap-add=SETUID \
    --security-opt no-new-privileges \
    --pull=never \
    "$nginx_ref"

wait_for_nextcloud_code
ensure_nextcloud_installed
ensure_nextcloud_system_config

if [ "$site_mode" = "active" ]; then
    podman_cmd run -d \
        --name {{ nextcloud_cron_container_name | quote }} \
        --pod "$pod_name" \
        --restart=unless-stopped \
        --env-file "$env_root/app.env" \
        -v "$html_root:/var/www/html" \
        -v "$data_root:/var/www/html-data" \
        --secret "nextcloud-admin-user,target=nextcloud-admin-user,uid=${app_runtime_uid},gid=${app_runtime_gid},mode=0400" \
        --secret "nextcloud-admin-password,target=nextcloud-admin-password,uid=${app_runtime_uid},gid=${app_runtime_gid},mode=0400" \
        --secret "postgres-db,target=postgres-db,uid=${app_runtime_uid},gid=${app_runtime_gid},mode=0400" \
        --secret "postgres-user,target=postgres-user,uid=${app_runtime_uid},gid=${app_runtime_gid},mode=0400" \
        --secret "postgres-password,target=postgres-password,uid=${app_runtime_uid},gid=${app_runtime_gid},mode=0400" \
        --pull=never \
        "$app_image" \
        /cron.sh
fi

if [ "$site_mode" != "active" ]; then
    podman_cmd pod stop -t 60 "$pod_name" >/dev/null
fi
