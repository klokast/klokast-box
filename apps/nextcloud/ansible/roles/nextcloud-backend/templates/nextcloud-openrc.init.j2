#!/sbin/openrc-run
description="Klokast Nextcloud backend stack"

depend() {
    need net
}

podman_cmd() {
    /usr/bin/doas -u {{ vm_admin_user_name }} /usr/bin/podman "$@"
}

start() {
    ebegin "Starting {{ nextcloud_service_name }}"
    if podman_cmd pod exists {{ nextcloud_pod_name | quote }}; then
        pod_state=$(podman_cmd pod inspect --format '{% raw %}{{.State}}{% endraw %}' {{ nextcloud_pod_name | quote }})
        if [ "$pod_state" != "Running" ]; then
            podman_cmd pod start {{ nextcloud_pod_name | quote }} >/dev/null
        fi
    else
        /usr/local/sbin/nextcloud-backend-deploy >/dev/null
    fi
    eend $?
}

stop() {
    ebegin "Stopping {{ nextcloud_service_name }}"
    if podman_cmd pod exists {{ nextcloud_pod_name | quote }}; then
        pod_state=$(podman_cmd pod inspect --format '{% raw %}{{.State}}{% endraw %}' {{ nextcloud_pod_name | quote }})
        if [ "$pod_state" = "Running" ]; then
            podman_cmd pod stop -t 60 {{ nextcloud_pod_name | quote }} >/dev/null
        fi
    fi
    eend $?
}

status() {
    podman_cmd pod ps --filter name={{ nextcloud_pod_name | quote }}
}
