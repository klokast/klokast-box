#!/sbin/openrc-run
description="Klokast Immich backend stack"

depend() {
    need net
}

podman_cmd() {
    /usr/bin/doas -u {{ vm_admin_user_name }} /usr/bin/podman "$@"
}

start() {
    ebegin "Starting {{ immich_service_name }}"
    if podman_cmd pod exists {{ immich_pod_name | quote }}; then
        pod_state=$(podman_cmd pod inspect --format '{% raw %}{{.State}}{% endraw %}' {{ immich_pod_name | quote }})
        if [ "$pod_state" != "Running" ]; then
            podman_cmd pod start {{ immich_pod_name | quote }} >/dev/null
        fi
    else
        /usr/local/sbin/immich-backend-deploy >/dev/null
    fi
    eend $?
}

stop() {
    ebegin "Stopping {{ immich_service_name }}"
    if podman_cmd pod exists {{ immich_pod_name | quote }}; then
        pod_state=$(podman_cmd pod inspect --format '{% raw %}{{.State}}{% endraw %}' {{ immich_pod_name | quote }})
        if [ "$pod_state" = "Running" ]; then
            podman_cmd pod stop -t 60 {{ immich_pod_name | quote }} >/dev/null
        fi
    fi
    eend $?
}

status() {
    podman_cmd pod ps --filter name={{ immich_pod_name | quote }}
}
