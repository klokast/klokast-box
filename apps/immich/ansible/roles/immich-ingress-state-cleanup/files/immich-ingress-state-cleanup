#!/usr/bin/env python3
"""Remove only inactive legacy ingress credentials and logs on one DMZ guest."""

import argparse
import datetime
import json
import os
from pathlib import Path
import re
import shutil
import signal
import socket
import stat


ROOTS = ('/var/lib/klokast/immich-private-ingress',
         '/var/log/klokast/immich-private-ingress')
SERVICES = ('immich-private-ingress', 'immich-private-ingress-proxy')


def require_protected(path):
    info = path.lstat()
    if not stat.S_ISDIR(info.st_mode) or info.st_uid != 0 or info.st_mode & 0o022:
        raise ValueError('Ingress state has an unsafe parent or root directory')
    return info


def require_inactive(root=Path('/')):
    # No stop hook is executed: unknown or installed runtime needs its own removal.
    for name in SERVICES:
        for path in (root / 'etc/init.d' / name,
                     root / 'run/openrc/started' / name,
                     root / 'run/openrc/starting' / name,
                     root / 'run/openrc/stopping' / name,
                     root / 'run/openrc/scheduled' / name):
            if os.path.lexists(path):
                raise ValueError('Immich ingress service state remains; remove its runtime first')
        if any(os.path.lexists(level / name) for level in (root / 'etc/runlevels').glob('*')):
            raise ValueError('Immich ingress is enabled in an OpenRC runlevel')
    for path in ('etc/klokast/immich-private-ingress',
                 'usr/local/sbin/immich-private-ingress-converge'):
        if os.path.lexists(root / path):
            raise ValueError('Immich ingress runtime configuration remains')


def require_unused(proc=Path('/proc')):
    pids = [p for p in proc.iterdir() if p.name.isdigit()]
    if len(pids) > 4096:
        raise ValueError('Process inspection exceeds its limit')
    descriptors = 0
    for pid in pids:
        try:
            with (pid / 'cmdline').open('rb') as stream:
                args = stream.read(1048577)
            if len(args) > 1048576:
                raise ValueError('Process arguments exceed their inspection limit')
            if b'immich-private-ingress' in args:
                raise ValueError('An Immich ingress process is still present')
            links = [pid / 'cwd', pid / 'exe', *list((pid / 'fd').iterdir())]
            descriptors += len(links)
            if descriptors > 65536:
                raise ValueError('Process descriptor inspection exceeds its limit')
            for link in links:
                try:
                    target = os.readlink(link).removesuffix(' (deleted)')
                except FileNotFoundError:
                    continue  # A process or descriptor exited during inspection.
                if any(target == p or target.startswith(p + '/') for p in ROOTS):
                    raise ValueError('A process still uses the Immich ingress state')
        except FileNotFoundError:
            continue


def inspect(root=Path('/')):
    with (root / 'proc/self/mountinfo').open('r') as stream:
        content = stream.read(1048577)
    if len(content) > 1048576:
        raise ValueError('Mount inspection exceeds its limit')
    mounts = []
    for row in content.splitlines():
        fields = row.split()
        if len(fields) < 10 or ' - ' not in row:
            raise ValueError('Mount inspection is incomplete')
        mounts.append(re.sub(r'\\([0-7]{3})', lambda m: chr(int(m[1], 8)), fields[4]))
    result = []
    for name in ROOTS:
        path = root / name.lstrip('/')
        for parent in reversed(path.parents):
            require_protected(parent)
        if any(m == name or m.startswith(name + '/') for m in mounts):
            raise ValueError('Ingress state contains a mount; no state was removed')
        if not os.path.lexists(path):
            result.append({'path': name, 'present': False, 'entries': 0})
            continue
        info = require_protected(path)
        count = 1
        for current, dirs, files in os.walk(path, followlinks=False):
            count += len(dirs) + len(files)
            if count > 8192:
                raise ValueError('Ingress state exceeds its entry limit')
            for entry in (*dirs, *files):
                item = (Path(current) / entry).lstat()
                if item.st_dev != info.st_dev or not (
                        stat.S_ISDIR(item.st_mode) or stat.S_ISREG(item.st_mode) or stat.S_ISLNK(item.st_mode)):
                    raise ValueError('Ingress state contains an unsupported filesystem entry')
        result.append({'path': name, 'present': True, 'entries': count})
    return result


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument('--host', required=True)
    parser.add_argument('--operation', required=True)
    parser.add_argument('--apply', action='store_true')
    args = parser.parse_args()
    def deadline(_signal, _frame):
        raise ValueError('Ingress cleanup exceeded its 60-second limit; inspect the receipt and retry')
    signal.signal(signal.SIGALRM, deadline)
    signal.alarm(60)
    try:
        if (os.geteuid() != 0 or not re.fullmatch(r'[a-z0-9][a-z0-9-]{0,30}-dmz', args.host) or
                socket.gethostname() != args.host or not re.fullmatch(r'[0-9a-f]{24}', args.operation)):
            raise ValueError('Cleanup requires root, the exact DMZ hostname, and an operation ID')
        if not shutil.rmtree.avoids_symlink_attacks:
            raise ValueError('This Python runtime cannot safely remove a directory tree')
        require_inactive()
        require_unused()
        before = inspect()
        if args.apply:
            require_inactive()
            require_unused()
            if inspect() != before:
                raise ValueError('Ingress state changed during inspection')
            for row in before:
                if row['present']:
                    shutil.rmtree(row['path'])
            if any(v['present'] for v in inspect()):
                raise ValueError('Ingress state is still present after removal')
        print(json.dumps({'kind': 'klokast.immich-ingress-state-cleanup.v1',
                          'operation_id': args.operation, 'host': args.host,
                          'generated_at': datetime.datetime.now(datetime.timezone.utc).isoformat(),
                          'applied': args.apply, 'changed': args.apply and any(v['present'] for v in before),
                          'paths': before, 'backend_hosts_selected': False}))
    except (ValueError, OSError) as exc:
        # Do not expose credential filenames, arguments, or application contents.
        message = str(exc) if isinstance(exc, ValueError) else 'Filesystem inspection or removal failed'
        parser.exit(1, message + '\n')


if __name__ == '__main__':
    main()
