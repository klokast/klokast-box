#!/usr/bin/env bash
set -euo pipefail

MAGICDNS_SUFFIX="${IMMICH_MAGICDNS_SUFFIX:-${KLOKAST_MAGICDNS_SUFFIX:-example.ts.net}}"
DEFAULT_REGISTRY="/home/smith/private/klokast/platform-resources.yml"

usage() {
    cat <<'USAGE'
Usage:
  apps/immich/bin/immich-install-from-mac \
    --controller k002-ops \
    --active-master k001 \
    --passive-backup k002

Options:
  --registry PATH             Controller-local private platform resources registry.
  --secrets PATH              Local MacBook secrets file. Default:
                              ~/.klokast/secrets/immich-ACTIVE-PASSIVE.env
  --restic-repository VALUE   Override generated restic repository URL.
  --rotate-secrets            Replace an existing local Immich secrets file.
  --dry-run                   Generate/reuse local secrets and print remote steps.
USAGE
}

die() {
    printf 'immich-install-from-mac: %s\n' "$*" >&2
    exit 1
}

need_value() {
    [[ $# -ge 2 && -n "${2:-}" ]] || die "$1 requires a value"
}

valid_box() {
    [[ "$1" =~ ^[a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?$ ]] || return 1
    case "$1" in
    *-bootstrap|*-dom0|*-router|*-bak|*-dmz|*-iot|*-usr|*-ops|*-agent|*-agt|bootstrap|dom0|router|bak|dmz|iot|usr|ops|agent|agt)
        return 1
        ;;
    esac
}

require_box() {
    local value=$1 name=$2
    valid_box "$value" || die "$name must be a box name like k001, not a VM hostname"
}

expand_local_path() {
    case "$1" in
    \~) printf '%s\n' "$HOME" ;;
    \~/*) printf '%s/%s\n' "$HOME" "${1#~/}" ;;
    *) printf '%s\n' "$1" ;;
    esac
}

normalize_infra_path() {
    case "$1" in
    \~/*) printf '/home/smith/%s\n' "${1#~/}" ;;
    /*) printf '%s\n' "$1" ;;
    *) die "controller paths must be absolute or start with ~/; got $1" ;;
    esac
}

file_mode() {
    if stat -f '%Lp' "$1" >/dev/null 2>&1; then
        stat -f '%Lp' "$1"
    else
        stat -c '%a' "$1"
    fi
}

random_alnum() {
    python3 - <<'PY'
import secrets
import string

alphabet = string.ascii_letters + string.digits
print("".join(secrets.choice(alphabet) for _ in range(48)))
PY
}

shell_quote() {
    python3 - "$1" <<'PY'
import shlex
import sys

print(shlex.quote(sys.argv[1]))
PY
}

run_remote_script() {
    local user=$1 label=$2 script=$3 display_script=$4
    if [[ "$dry_run" == true ]]; then
        printf '\n# DRY RUN: %s on %s@%s\n' "$label" "$user" "$controller"
        printf '%s\n' "$display_script"
        return
    fi
    printf '%s\n' "$script" | tailscale ssh "${user}@${controller}" 'bash -se'
}

controller=
active_master=
passive_backup=
registry="$DEFAULT_REGISTRY"
secrets_path=
restic_repository=
rotate_secrets=false
dry_run=false

while [[ $# -gt 0 ]]; do
    case "$1" in
    --controller)
        need_value "$@"; controller=$2; shift 2 ;;
    --active-master)
        need_value "$@"; active_master=$2; shift 2 ;;
    --passive-backup)
        need_value "$@"; passive_backup=$2; shift 2 ;;
    --registry)
        need_value "$@"; registry=$2; shift 2 ;;
    --secrets)
        need_value "$@"; secrets_path=$2; shift 2 ;;
    --restic-repository)
        need_value "$@"; restic_repository=$2; shift 2 ;;
    --rotate-secrets)
        rotate_secrets=true; shift ;;
    --dry-run)
        dry_run=true; shift ;;
    -h|--help|help)
        usage; exit 0 ;;
    *)
        die "unknown argument: $1" ;;
    esac
done

[[ -n "$controller" ]] || die "--controller is required"
[[ "$controller" =~ ^[A-Za-z0-9_.-]+$ ]] || die "unsafe controller name: $controller"
[[ -n "$active_master" ]] || die "--active-master is required"
[[ -n "$passive_backup" ]] || die "--passive-backup is required"
require_box "$active_master" "--active-master"
require_box "$passive_backup" "--passive-backup"
[[ "$active_master" != "$passive_backup" ]] || die "active master and passive backup must differ"
command -v python3 >/dev/null 2>&1 || die "python3 is required on the MacBook"
if [[ "$dry_run" != true ]]; then
    command -v tailscale >/dev/null 2>&1 || die "tailscale CLI is required on the MacBook"
fi

registry="$(normalize_infra_path "$registry")"
if [[ -z "$secrets_path" ]]; then
    secrets_path="${HOME}/.klokast/secrets/immich-${active_master}-${passive_backup}.env"
else
    secrets_path="$(expand_local_path "$secrets_path")"
fi
if [[ -z "$restic_repository" ]]; then
    restic_repository="sftp:neo@${passive_backup}-bak.${MAGICDNS_SUFFIX}:/srv/immich-restic/${active_master}"
fi

mkdir -p "$(dirname "$secrets_path")"
if [[ -f "$secrets_path" && "$rotate_secrets" != true ]]; then
    [[ "$(file_mode "$secrets_path")" == "600" ]] || die "local secrets file must be mode 0600: $secrets_path"
else
    tmp_secret="$(mktemp "${secrets_path}.XXXXXX")"
    chmod 0600 "$tmp_secret"
    {
        printf 'IMMICH_POSTGRES_PASSWORD=%q\n' "$(random_alnum)"
        printf 'IMMICH_RESTIC_PASSWORD=%q\n' "$(random_alnum)"
        printf 'IMMICH_RESTIC_REPOSITORY=%q\n' "$restic_repository"
    } >"$tmp_secret"
    mv "$tmp_secret" "$secrets_path"
fi

# shellcheck source=/dev/null
source "$secrets_path"
[[ -n "${IMMICH_POSTGRES_PASSWORD:-}" ]] || die "IMMICH_POSTGRES_PASSWORD is missing from $secrets_path"
[[ -n "${IMMICH_RESTIC_PASSWORD:-}" ]] || die "IMMICH_RESTIC_PASSWORD is missing from $secrets_path"
[[ -n "${IMMICH_RESTIC_REPOSITORY:-}" ]] || die "IMMICH_RESTIC_REPOSITORY is missing from $secrets_path"
if [[ -n "${restic_repository:-}" && "$IMMICH_RESTIC_REPOSITORY" != "$restic_repository" && "$rotate_secrets" == true ]]; then
    die "generated restic repository did not match local secrets file"
fi

active_q="$(shell_quote "$active_master")"
passive_q="$(shell_quote "$passive_backup")"
registry_q="$(shell_quote "$registry")"
postgres_q="$(shell_quote "$IMMICH_POSTGRES_PASSWORD")"
restic_password_q="$(shell_quote "$IMMICH_RESTIC_PASSWORD")"
restic_repo_q="$(shell_quote "$IMMICH_RESTIC_REPOSITORY")"

infra_script="$(cat <<REMOTE
set -euo pipefail
active_master=${active_q}
passive_backup=${passive_q}
registry_path=${registry_q}
repo_dir="\$HOME/src/klokast/klokast-box"
app_workspace="/home/minion/src/klokast-box"
grant_dir="/var/lib/klokast/approved-state/apps/immich"
grant_path="\${grant_dir}/grant.json"

cd "\$repo_dir"
git pull --ff-only
git status --short --branch

python3 - "\$registry_path" "\$active_master" "\$passive_backup" <<'PY'
import sys
from pathlib import Path

import yaml

path = Path(sys.argv[1])
active = sys.argv[2]
passive = sys.argv[3]
if path.exists():
    data = yaml.safe_load(path.read_text(encoding="utf-8")) or {}
else:
    data = {"schema_version": 1, "apps": {}}
if data.get("schema_version") != 1:
    raise SystemExit(f"{path} must use schema_version: 1")
apps = data.setdefault("apps", {})
if not isinstance(apps, dict):
    raise SystemExit(f"{path}.apps must be a mapping")
entry = dict(apps.get("immich") or {})
entry["enabled"] = True
entry["placement"] = {"active_master": active, "passive_backup": passive}
entry["ingress_mode"] = "tailscale"
resources = entry.get("resources")
if resources is None:
    entry["resources"] = {}
elif not isinstance(resources, dict):
    raise SystemExit(f"{path}.apps.immich.resources must be a mapping")
apps["immich"] = entry
path.parent.mkdir(parents=True, exist_ok=True)
tmp = path.with_name(path.name + ".tmp")
tmp.write_text(yaml.safe_dump(data, sort_keys=False), encoding="utf-8")
tmp.chmod(0o600)
tmp.replace(path)
PY

approved_commit="\$(git rev-parse HEAD)"
ansible/bin/platform-resources --registry "\$registry_path" lint
ansible/bin/platform-resources --registry "\$registry_path" diff
ansible/bin/platform-resources --registry "\$registry_path" --approved-commit "\$approved_commit" apply
ansible/bin/platform-resources --registry "\$registry_path" verify
sudo -n /usr/local/sbin/ts-authkey-immich --check-config --hostname photos --tags tag:immich >/dev/null
apps/immich/bin/immichctl private-ingress-identity --active-master "\$active_master" --passive-backup "\$passive_backup" --resources-registry "\$registry_path"

work_tmp="\$(mktemp -d)"
cleanup() { rm -rf "\$work_tmp"; }
trap cleanup EXIT

git archive "\$approved_commit" | tar -C "\$work_tmp" -xf -
printf '%s\n' "\$approved_commit" >"\$work_tmp/.klokast-approved-commit"
doas rm -rf "\${app_workspace}.new" "\${app_workspace}.old"
doas install -d -o minion -g minion -m 0750 "\${app_workspace}.new"
(cd "\$work_tmp" && tar -cf - .) | doas tar -C "\${app_workspace}.new" -xf -
doas chown -R minion:minion "\${app_workspace}.new"
if doas test -d "\$app_workspace"; then
    doas mv "\$app_workspace" "\${app_workspace}.old"
fi
doas mv "\${app_workspace}.new" "\$app_workspace"
doas rm -rf "\${app_workspace}.old"
doas install -o minion -g minion -m 0644 "\$work_tmp/.klokast-approved-commit" "\${app_workspace}/.klokast-approved-commit"

cat >"\$work_tmp/20-minion-immich" <<'SUDOERS'
Defaults:minion !requiretty
minion ALL=(root) NOPASSWD: /usr/local/sbin/ts-authkey-immich --hostname photos --tags tag\:immich
SUDOERS
doas install -o root -g root -m 0440 "\$work_tmp/20-minion-immich" /etc/sudoers.d/20-minion-immich
doas /usr/sbin/visudo -cf /etc/sudoers.d/20-minion-immich >/dev/null

ansible/bin/platform-resources --registry "\$registry_path" --app immich --approved-commit "\$approved_commit" grant >"\$work_tmp/grant.json"
doas install -d -o root -g minion -m 0750 "\$grant_dir"
doas install -o root -g minion -m 0640 "\$work_tmp/grant.json" "\$grant_path"
doas install -d -o minion -g minion -m 0700 \
    /home/minion/.ansible \
    /home/minion/.ansible/tmp \
    /home/minion/.ansible/cp \
    /home/minion/.ansible/facts
REMOTE
)"

app_script="$(cat <<REMOTE
set -euo pipefail
unset KLOKAST_PLATFORM_RESOURCES_REGISTRY KLOKAST_APP_RESOURCES_REGISTRY
export ANSIBLE_LOCAL_TEMP=/home/minion/.ansible/tmp
export ANSIBLE_SSH_CONTROL_PATH_DIR=/home/minion/.ansible/cp
export ANSIBLE_CACHE_PLUGIN_CONNECTION=/home/minion/.ansible/facts
export IMMICH_POSTGRES_PASSWORD=${postgres_q}
export IMMICH_RESTIC_PASSWORD=${restic_password_q}
export IMMICH_RESTIC_REPOSITORY=${restic_repo_q}
cd /home/minion/src/klokast-box
apps/immich/bin/immichctl resource-grant-check --active-master ${active_q} --passive-backup ${passive_q} --resource-grant /var/lib/klokast/approved-state/apps/immich/grant.json
apps/immich/bin/immichctl install --active-master ${active_q} --passive-backup ${passive_q} --resource-grant /var/lib/klokast/approved-state/apps/immich/grant.json
apps/immich/bin/immichctl verify --active-master ${active_q} --passive-backup ${passive_q} --resource-grant /var/lib/klokast/approved-state/apps/immich/grant.json
REMOTE
)"

app_display_script="$(cat <<REMOTE
set -euo pipefail
unset KLOKAST_PLATFORM_RESOURCES_REGISTRY KLOKAST_APP_RESOURCES_REGISTRY
export ANSIBLE_LOCAL_TEMP=/home/minion/.ansible/tmp
export ANSIBLE_SSH_CONTROL_PATH_DIR=/home/minion/.ansible/cp
export ANSIBLE_CACHE_PLUGIN_CONNECTION=/home/minion/.ansible/facts
export IMMICH_POSTGRES_PASSWORD='<redacted>'
export IMMICH_RESTIC_PASSWORD='<redacted>'
export IMMICH_RESTIC_REPOSITORY='<redacted>'
cd /home/minion/src/klokast-box
apps/immich/bin/immichctl resource-grant-check --active-master ${active_q} --passive-backup ${passive_q} --resource-grant /var/lib/klokast/approved-state/apps/immich/grant.json
apps/immich/bin/immichctl install --active-master ${active_q} --passive-backup ${passive_q} --resource-grant /var/lib/klokast/approved-state/apps/immich/grant.json
apps/immich/bin/immichctl verify --active-master ${active_q} --passive-backup ${passive_q} --resource-grant /var/lib/klokast/approved-state/apps/immich/grant.json
REMOTE
)"

printf 'Immich local secrets: %s\n' "$secrets_path"
run_remote_script smith "grant Immich platform resources" "$infra_script" "$infra_script"
run_remote_script minion "install Immich app" "$app_script" "$app_display_script"
