ARG ALPINE_IMAGE
FROM ${ALPINE_IMAGE}
ARG ALPINE_MIRROR
RUN test -n "$ALPINE_MIRROR" && \
    sed -i "s#https\?://[^/]*/alpine/#${ALPINE_MIRROR%/}/#g" /etc/apk/repositories

RUN set -eu; \
    env -u http_proxy -u https_proxy -u HTTP_PROXY -u HTTPS_PROXY -u ALL_PROXY -u all_proxy apk add --no-cache \
      ca-certificates \
      jq \
      nginx \
      openssl \
      tailscale \
      tzdata

COPY nginx.conf /etc/nginx/nginx.conf
EXPOSE 8443
CMD ["nginx", "-g", "daemon off;"]
