#!/bin/sh
set -eu

app=${KLOKAST_APP:-nextcloud-v2}
desired=${KLOKAST_DESIRED_PATH:-/var/lib/klokast/desired/${app}.json}
rendered=${KLOKAST_RENDERED_KUBE_PATH:-/var/lib/klokast/rendered/${app}/pod.yml}
pod_spec_changed=${KLOKAST_POD_SPEC_CHANGED:-true}
podman_user=${KLOKAST_PODMAN_USER:-neo}

role="$(jq -r '.target_role' "$desired")"
site_role="$(jq -r '.site_role' "$desired")"
runtime_state="$(jq -r '.runtime_state // "running"' "$desired")"
pod_name="$(jq -r '.runtime.pod_name' "$desired")"

run_podman() {
    if [ "$(id -un)" = "$podman_user" ]; then
        /usr/bin/podman "$@"
    else
        /usr/bin/doas -u "$podman_user" /usr/bin/podman "$@"
    fi
}

ensure_volume() {
    volume="$1"
    if ! run_podman volume exists "$volume"; then
        run_podman volume create "$volume" >/dev/null
    fi
}

migration_image() {
    jq -r '
      .images.upstream_images.alpine
      | select(.canonical and .digest)
      | "\(.canonical)@\(.digest)"
    ' "$desired"
}

migrate_volume_once() {
    source_path="$1"
    volume="$2"
    marker_name="$3"
    image="$4"
    [ -d "$source_path" ] || return 0
    if ! find "$source_path" -mindepth 1 -maxdepth 1 -print -quit | grep -q .; then
        return 0
    fi
    [ -n "$image" ] || return 0
    # shellcheck disable=SC2016
    run_podman run --rm --pull=missing \
        --security-opt no-new-privileges \
        --cap-drop=NET_RAW \
        --entrypoint /bin/sh \
        -v "$source_path:/source:ro" \
        -v "$volume:/dest" \
        "$image" \
        -c '
            set -eu
            marker="/dest/'"$marker_name"'"
            if [ -e "$marker" ]; then
                exit 0
            fi
            if find /dest -mindepth 1 ! -name "'"$marker_name"'" -print -quit | grep -q .; then
                echo "volume $1 already has data; not importing $2" >&2
                exit 0
            fi
            tar -C /source -cf - . | tar -C /dest -xf -
            date -u +%Y-%m-%dT%H:%M:%SZ >"$marker"
        ' sh "$volume" "$source_path"
}

jq -r '.runtime.volumes // {} | to_entries[].value' "$desired" |
while IFS= read -r volume; do
    [ -n "$volume" ] && ensure_volume "$volume"
done

if [ "$role" = "backend" ]; then
    alpine_image="$(migration_image || true)"
    migrate_volume_once /srv/nextcloud-v2/postgres "$(jq -r '.runtime.volumes.postgres' "$desired")" .klokast-migrated-from-srv-nextcloud-v2-postgres "$alpine_image"
    migrate_volume_once /srv/nextcloud-v2/redis "$(jq -r '.runtime.volumes.redis' "$desired")" .klokast-migrated-from-srv-nextcloud-v2-redis "$alpine_image"
    migrate_volume_once /srv/nextcloud-v2/html "$(jq -r '.runtime.volumes.html' "$desired")" .klokast-migrated-from-srv-nextcloud-v2-html "$alpine_image"
    migrate_volume_once /srv/nextcloud-v2/config "$(jq -r '.runtime.volumes.config' "$desired")" .klokast-migrated-from-srv-nextcloud-v2-config "$alpine_image"
    migrate_volume_once /srv/nextcloud-v2/custom_apps "$(jq -r '.runtime.volumes.custom_apps' "$desired")" .klokast-migrated-from-srv-nextcloud-v2-custom-apps "$alpine_image"
    migrate_volume_once /srv/nextcloud-v2/data "$(jq -r '.runtime.volumes.data' "$desired")" .klokast-migrated-from-srv-nextcloud-v2-data "$alpine_image"
    migrate_volume_once /srv/nextcloud-v2/backups "$(jq -r '.runtime.volumes.backups' "$desired")" .klokast-migrated-from-srv-nextcloud-v2-backups "$alpine_image"
fi

if [ "$pod_spec_changed" = "true" ]; then
    run_podman kube play --replace "$rendered"
fi

if [ "$site_role" = "active" ] && [ "$runtime_state" = "running" ]; then
    run_podman pod start "$pod_name" >/dev/null 2>&1 || true
else
    run_podman pod stop -t 60 "$pod_name" >/dev/null 2>&1 || true
fi

if [ "$role" = "backend" ] && [ "$site_role" = "active" ] && [ "$runtime_state" = "running" ]; then
    run_podman pod inspect "$pod_name" >/dev/null
fi
