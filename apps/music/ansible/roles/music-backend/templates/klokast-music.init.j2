#!/sbin/openrc-run
description="Klokast music backend Podman pod"

depend() {
    need net
    after firewall
    use logger
}

podman_cmd() {
    /usr/bin/doas -u {{ vm_admin_user_name | quote }} /usr/bin/podman "$@"
}

start() {
    ebegin "Starting {{ music_service_name }}"
    if podman_cmd pod exists {{ music_pod_name | quote }}; then
        pod_state="$(podman_cmd pod inspect --format '{% raw %}{{.State}}{% endraw %}' {{ music_pod_name | quote }})"
        if [ "$pod_state" != "Running" ]; then
            podman_cmd pod start {{ music_pod_name | quote }} >/dev/null
        fi
    else
        /usr/local/sbin/music-backend-deploy >/dev/null
    fi
    eend $?
}

stop() {
    ebegin "Stopping {{ music_service_name }}"
    if podman_cmd pod exists {{ music_pod_name | quote }}; then
        pod_state="$(podman_cmd pod inspect --format '{% raw %}{{.State}}{% endraw %}' {{ music_pod_name | quote }})"
        if [ "$pod_state" = "Running" ]; then
            podman_cmd pod stop -t 60 {{ music_pod_name | quote }} >/dev/null
        fi
    fi
    eend $?
}

status() {
    podman_cmd pod ps --filter name={{ music_pod_name | quote }}
}
