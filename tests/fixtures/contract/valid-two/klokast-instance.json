{
  "$schema": "https://raw.githubusercontent.com/klokast/klokast-box/aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa/schemas/klokast-instance-v1.schema.json",
  "airunners": [
    "k002-ops-airunner",
    "k001-ops-airunner",
    "vultr-ops",
    "hetzner-ops"
  ],
  "apps": {
    "music": {
      "data": {
        "library": {
          "box": "k002",
          "retention": "preserve"
        }
      },
      "desired-state": "absent"
    }
  },
  "boxes": {
    "k001": {
      "connectivity-profiles": [
        "local-ap-direct-egress",
        "tailscale"
      ],
      "country": "CN",
      "description": "",
      "site": "mingdu"
    },
    "k002": {
      "connectivity-profiles": [
        "tailscale"
      ],
      "country": "FR",
      "description": "",
      "site": "milla"
    }
  },
  "controllers": {
    "active": "k001",
    "standby": "k002"
  },
  "instance": {
    "id": "two-box-klokast"
  },
  "schema-version": 1,
  "tailnet": {
    "members": {
      "admin@example.com": {
        "roles": [
          "family",
          "operator"
        ]
      },
      "family@example.com": {
        "roles": [
          "family"
        ]
      }
    },
    "tailnet-dns-name": "example.ts.net"
  }
}
