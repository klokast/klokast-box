{
  "$schema": "https://raw.githubusercontent.com/klokast/klokast-box/aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa/schemas/klokast-instance-v1.schema.json",
  "airunners": [
    "boxb-ops-airunner",
    "boxa-ops-airunner",
    "vultr-ops",
    "hetzner-ops"
  ],
  "apps": {
    "music": {
      "data": {
        "library": {
          "box": "boxb",
          "retention": "preserve"
        }
      },
      "desired-state": "absent"
    }
  },
  "boxes": {
    "boxa": {
      "connectivity": [
        "local-ap-direct-egress",
        "tailscale"
      ],
      "country": "XA",
      "description": "",
      "site": "site-a"
    },
    "boxb": {
      "connectivity": [
        "tailscale"
      ],
      "country": "XB",
      "description": "",
      "site": "site-b"
    }
  },
  "controllers": {
    "active": "boxa",
    "standby": "boxb"
  },
  "schema-version": 1,
  "tailscale": {
    "members": {
      "admin@example.com": {
        "roles": [
          "family",
          "operator"
        ]
      },
      "family@example.com": {
        "roles": [
          "family"
        ]
      }
    },
    "tailnet-dns-name": "example.ts.net"
  }
}
