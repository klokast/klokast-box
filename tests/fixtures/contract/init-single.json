      "country": "FR",
      "description": "Example home"
    }
  },
  "tailnet": {
    "members": {
      "admin@example.com": {
        "roles": [
          "family",
          "operator"
        ]
      }
    },
    "tailnet-dns-name": "example.ts.net"
  }
