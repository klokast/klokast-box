#!/usr/bin/env python3
"""Install the runner GitHub App credential through the controller's broker."""
import argparse
import json
from pathlib import Path
import re
import subprocess


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument('--controller', required=True, help='active <box>-ops hostname')
    parser.add_argument('--app-id', required=True, type=int)
    parser.add_argument('--installation-id', required=True, type=int)
    parser.add_argument('--pem', required=True, type=Path)
    args = parser.parse_args()
    if not re.fullmatch('[a-z0-9][a-z0-9-]{0,30}-ops', args.controller):
        parser.error('--controller must be a box controller hostname')
    if args.app_id <= 0 or args.installation_id <= 0:
        parser.error('App and installation IDs must be positive integers')
    try:
        pem = args.pem.expanduser().read_text()
        if not 0 < len(pem) <= 32768:
            parser.error('PEM is empty or too large')
        payload = json.dumps({'app_id': args.app_id, 'installation_id': args.installation_id,
                              'private_key': pem})
        return subprocess.run(['tailscale', 'ssh', 'smith@' + args.controller,
                               'doas', '/usr/local/sbin/ksa-air-git', 'configure'],
                              input=payload, text=True, timeout=180, check=False).returncode
    except (OSError, subprocess.TimeoutExpired):
        print('install-air-github-app: cannot read the PEM or reach the controller; no credential was printed')
        return 1


if __name__ == '__main__':
    raise SystemExit(main())
