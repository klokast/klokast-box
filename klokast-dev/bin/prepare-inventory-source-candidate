#!/usr/bin/env python3
"""Check sealed inventory rendering against private inputs without publication."""

import argparse
import datetime as dt
import hashlib
import importlib.util
from importlib.machinery import SourceFileLoader
import json
import os
import re
from pathlib import Path
import subprocess
import sys
import tempfile

REPO = Path(__file__).resolve().parents[2]
PRIVATE = Path("/home/smith/private/klokast")
INSTANCE = PRIVATE / "instance"


def canonical(value):
    return json.dumps(value, sort_keys=True, ensure_ascii=False, separators=(",", ":"))


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--instance-only", action="store_true", help="check Plan v8 against the complete adopted source without new adoption")
    parser.add_argument("--build-dir", required=True)
    parser.add_argument("--observation", required=True, help="fresh controller-local Observation v1 for offline Plan contract checks")
    args = parser.parse_args()
    os.umask(0o077)
    loader = SourceFileLoader("inventory_candidate_plan", str(REPO / "ansible/bin/platform-plan"))
    spec = importlib.util.spec_from_loader(loader.name, loader)
    checker = importlib.util.module_from_spec(spec)
    loader.exec_module(checker)
    output = None
    try:
        checker.require_active_controller()
        build, engine = checker.resolve_build_directory(args.build_dir)
        receipt, binary = checker.verify_build_directory(build, engine)
        checker.verify_binary_version(binary, receipt)

        def git(root, *arguments):
            return subprocess.check_output(["git", "-C", str(root), *arguments], text=True).strip()

        def clean(root, commit):
            if git(root, "rev-parse", "HEAD") != commit or git(root, "status", "--porcelain") or git(root, "branch", "--show-current") != "main":
                raise ValueError("inventory preparation requires clean committed main checkouts")

        private_commit = git(INSTANCE, "rev-parse", "HEAD")
        clean(REPO, engine)
        clean(INSTANCE, private_commit)
        inputs = {name: (INSTANCE / name).read_bytes() for name in ("klokast-instance.json", "klokast.lock.json")}
        pointer = Path("/var/lib/klokast/active-authority-state").read_bytes()
        observation_path = Path(args.observation).resolve(strict=True)
        observation_bytes = observation_path.read_bytes()
        stamp = dt.datetime.now(dt.timezone.utc).strftime("%Y%m%dT%H%M%S.%fZ")
        output = PRIVATE / "inventory-source-candidates" / engine / stamp
        output.mkdir(mode=0o700, parents=True)

        def checked(command, label):
            result = subprocess.run([str(v) for v in command], cwd=REPO, capture_output=True, text=True)
            (output / (label + ".stdout")).write_text(result.stdout)
            (output / (label + ".stderr")).write_text(result.stderr)
            if result.returncode:
                raise ValueError(label + " failed; inspect private preparation logs")
            return json.loads(result.stdout)

        with tempfile.TemporaryDirectory(prefix="inventory-fixture-", dir=output) as temporary:
            if args.instance_only:
                fixture = Path(temporary) / "instance"
                helper = (REPO / "klokast-dev/bin/promote-private-instance-engine").read_text()
                blocks = re.findall(r"""python3 - "\$PRIVATE_WORKTREE" "\$CANDIDATE".*?<<'PY'\n(.*?)\nPY\n""", helper, re.S)
                if len(blocks) != 1:
                    raise ValueError("cannot identify the exact Mac promotion candidate constructor")
                constructor = blocks[0]
                envelope_path = output / "mac-promotion-candidate.json"
                transition_path = output / "mac-schema-transition"
                old_engine = json.loads(inputs["klokast.lock.json"])["engine"]["commit"]
                result = subprocess.run(["python3", "-", str(INSTANCE), str(fixture), str(envelope_path), old_engine, engine,
                                         private_commit, git(INSTANCE, "rev-parse", "HEAD^{tree}"), "false", "", str(transition_path)],
                                        input=constructor, text=True, capture_output=True)
                (output / "mac-candidate.stderr").write_text(result.stderr)
                if result.returncode:
                    raise ValueError("exact Mac promotion candidate construction failed; inspect private logs")
                envelope = json.loads(envelope_path.read_text())
                if envelope["schema_transition"] != "metadata-only":
                    raise ValueError("instance-only milestone permits metadata-only engine promotion")
                mac_candidate = {"tree": envelope["candidate_tree"], "schema_transition": envelope["schema_transition"],
                                 "constructor_sha256": hashlib.sha256(constructor.encode()).hexdigest()}
                git(fixture, "-c", "user.name=Klokast inventory check", "-c", "user.email=validation@example.invalid", "commit", "-qm", "Temporary exact Mac promotion candidate")
                if git(fixture, "rev-parse", "HEAD^{tree}") != envelope["candidate_tree"]:
                    raise ValueError("review fixture differs from the exact Mac promotion candidate tree")
            else:
                fixture = Path(temporary)
                for name, content in inputs.items():
                    value = json.loads(content)
                    schema = "klokast-instance-v1" if name == "klokast-instance.json" else "klokast-lock-v1"
                    value["$schema"] = f"https://raw.githubusercontent.com/klokast/klokast-box/{engine}/schemas/{schema}.schema.json"
                    if name == "klokast.lock.json":
                        value["engine"]["commit"] = engine
                    (fixture / name).write_text(canonical(value) + "\n")
                git(fixture, "init", "-q", "-b", "main")
                git(fixture, "add", "-A")
                git(fixture, "-c", "user.name=Klokast inventory check", "-c", "user.email=validation@example.invalid", "commit", "-qm", "Temporary inventory comparison")
            rendered = checked([binary, "inventory", "--instance", fixture, "--json"], "sealed-inventory")
            if rendered.get("kind") != "klokast.inventory.v1" or rendered.get("valid") is not True or rendered["repository"].get("clean") is not True:
                raise ValueError("sealed inventory did not bind a valid clean instance")
            projection = output / "projection.json"
            projection.write_text(canonical(rendered["projection"]) + "\n")
            comparison = checked([REPO / "ansible/bin/compare-instance-inventory", "--projection", projection,
                                  "--output-directory", output / "comparison"], "inventory-comparison")
            if comparison.get("equal") is not True or not comparison.get("temporary_files_removed"):
                raise ValueError("inventory equality or cleanup did not pass")
            # Review-only receipts bind the temporary fixture, never the live
            # deployment. They stay outside all protected execution roots.
            def hashed(value, field="receipt_sha256"):
                value.pop(field, None)
                value[field] = hashlib.sha256(canonical(value).encode()).hexdigest()
                return value

            fixture_commit = git(fixture, "rev-parse", "HEAD")
            sources = [json.loads(path.read_text()) for path in Path("/var/lib/klokast/instance-sources").glob("*/*.json")]
            source = max((v for v in sources if v.get("commit") == private_commit), key=lambda v: v["fetched_at"])
            source = hashed(dict(source, commit=fixture_commit, fetched_at=dt.datetime.now(dt.timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ")))
            synthetic_source = output / "review-only-source.json"
            synthetic_source.write_text(canonical(source) + "\n")
            def module(name, path):
                loader = SourceFileLoader(name, str(path))
                spec = importlib.util.spec_from_loader(name, loader)
                result = importlib.util.module_from_spec(spec)
                loader.exec_module(result)
                return result
            toolchain = module("inventory_review_toolchain", REPO / "ansible/bin/controller-toolchain-receipt")
            components = []
            for name, path, _installed in toolchain.COMPONENTS:
                digest = hashlib.sha256(path.read_bytes()).hexdigest()
                components.append({"name": name, "source_sha256": digest, "installed_sha256": digest})
            digest = hashlib.sha256(binary.read_bytes()).hexdigest()
            components.append({"name": "sealed_engine", "source_sha256": digest, "installed_sha256": digest})
            receipt_fixture = hashed({"schema_version": 7 if args.instance_only else 6, "kind": "klokast.controller-toolchain.v7" if args.instance_only else "klokast.controller-toolchain.v6", "engine_commit": engine, "public_checkout_clean": True, "public_checkout_commit": engine, "components": components})
            synthetic_toolchain = output / "review-only-toolchain.json"
            synthetic_toolchain.write_text(canonical(receipt_fixture) + "\n")
            state_path = Path("/var/lib/klokast/authority-states") / (pointer.decode().strip() + ".json")
            apply = module("inventory_review_apply", REPO / "klokast-ops/secret-authority/bin/ksa-apply")
            apply.PLAN_ROOT = output / "review-only-plans"
            plans = []
            command = [binary, "plan", "--instance", fixture, "--compatibility-deployment", PRIVATE / "deployment.yml",
                       "--compatibility-registry", PRIVATE / "platform-resources.yml", "--compatibility-controller-ha", PRIVATE / "controller-ha.yml",
                       "--observation", observation_path, "--instance-source-receipt", synthetic_source,
                       "--controller-toolchain-receipt", synthetic_toolchain, "--json"]
            def check_plan(state, target, connectivity):
                plan = checked([*command, "--authority-state", state, "--migration-target", target, "--connectivity-target", connectivity], "review-plan-" + Path(state).stem[:8] + "-" + target + "-" + connectivity)
                if plan.get("valid") is not True or plan.get("deployable") is not True or plan.get("authority_ready") is not True:
                    raise ValueError("sealed private Plan contract check refused; inspect private review evidence")
                path = apply.PLAN_ROOT / fixture_commit / (plan["plan_sha256"] + ".json")
                path.parent.mkdir(mode=0o700, parents=True, exist_ok=True)
                path.write_text(canonical(plan) + "\n")
                try:
                    apply.verify_plan_v3(path)
                except apply.ApplyError as error:
                    raise ValueError("root Plan contract refused: " + str(error)) from error
                plans.append(plan["plan_sha256"])
                return plan
            if args.instance_only:
                # Explicit retained comparison remains a separate Plan v7 check.
                check_plan(state_path, "inventory", "non-controller")
                command = [binary, "plan", "--instance-only", "--instance", fixture,
                           "--observation", observation_path, "--instance-source-receipt", synthetic_source,
                           "--controller-toolchain-receipt", synthetic_toolchain, "--authority-state", state_path, "--json"]
                plan = checked(command, "review-plan-instance-only")
                path = apply.PLAN_ROOT / fixture_commit / (plan["plan_sha256"] + ".json")
                path.parent.mkdir(mode=0o700, parents=True, exist_ok=True)
                path.write_text(canonical(plan) + "\n")
                apply.verify_plan_v8(path)
                plans.append(plan["plan_sha256"])
                registry = checked([binary, "registry", "--instance", fixture, "--json"], "sealed-registry")
                registry_projection = output / "registry-projection.json"
                registry_projection.write_text(canonical(registry) + "\n")
                effective_registry = output / "effective-registry.yml"
                effective_registry.write_text(canonical(registry["projection"]["registry"]) + "\n")
                compiler_comparisons = {}
                consumer_commands = {"show": ["show"], "box-configs": ["show-box-configs"]}
                consumer_commands.update({"router-" + box: ["--box", box, "show-box-access-vars"] for box in rendered["projection"]["boxes"]})
                for label, arguments in consumer_commands.items():
                    values = []
                    for name, input_path in (("legacy", PRIVATE / "platform-resources.yml"), ("instance", effective_registry)):
                        value = checked([REPO / "ansible/bin/platform-resources", "--registry", input_path,
                                         "--compatibility-registry", *arguments], name + "-compiler-" + label)
                        value.pop("registry_path", None)
                        value.pop("registry_sha256", None)
                        values.append(value)
                    if values[0] != values[1]:
                        raise ValueError("private compiler settings differ for " + label)
                    compiler_comparisons[label] = hashlib.sha256(canonical(values[0]).encode()).hexdigest()
                absence = checked([REPO / "ansible/bin/compare-instance-input-absence", "--inventory-projection", projection,
                                   "--registry-projection", registry_projection, "--plan", path, "--output-directory", output / "absence"], "legacy-input-absence")
                if absence.get("equal") is not True:
                    raise ValueError("isolated legacy absence comparison failed")
            else:
                adoption = check_plan(state_path, "inventory", "non-controller")
                # Check post-adoption reporting without publishing or approving a
                # source change. The synthetic state has no signed archive.
                state = json.loads(state_path.read_text())
                state.update(schema_version=5, kind=apply.KIND_AUTHORITY_V5, prior_state_kind=apply.KIND_AUTHORITY_V4,
                             prior_state_sha256=state["authority_state_sha256"], transition_id="review-only-inventory", signed_intent_sha256="a" * 64)
                state["inventory_adoption"] = {"nonce": state["transition_id"], "intent_sha256": state["signed_intent_sha256"], "plan_sha256": adoption["plan_sha256"]}
                state["setting_groups"] = sorted([*state["setting_groups"], {"id": apply.INVENTORY_GROUP, "source": "instance_specification_v1", "scopes": rendered["projection"]["scopes"]}], key=lambda g: g["id"])
                state["authority_state_sha256"] = apply.authority_v2_hash(state)
                apply.validate_authority_current_document(state)
                synthetic_state = output / "review-only-authority.json"
                synthetic_state.write_text(canonical(state) + "\n")
                for target in ("inventory", "registry", "controller-identity", "connectivity"):
                    for connectivity in ("non-controller", "active-controller"):
                        plan = check_plan(synthetic_state, target, connectivity)
                        if any(g["operation"] != "verify_instance_authority" for g in plan["action_groups"]) or any(a.get("executor") == "unimplemented_action" for a in plan["actions"]) or any(a["id"] == "legacy_engine_inventory" for a in plan["authorities"]):
                            raise ValueError("final private Plan retains inventory or pending runner authority")
        clean(REPO, engine)
        clean(INSTANCE, private_commit)
        if observation_path.read_bytes() != observation_bytes or Path("/var/lib/klokast/active-authority-state").read_bytes() != pointer or any((INSTANCE / name).read_bytes() != value for name, value in inputs.items()):
            raise ValueError("private inputs or active source changed during inventory preparation")
        result = {"schema_version": 1, "result": "verified-inventory-candidate", "engine_commit": engine,
                  "private_commit": private_commit, "build_dir": str(build), "directory": str(output),
                  "hosts": len(comparison["hosts"]), "excluded_legacy_hosts": len(comparison["excluded_legacy_hosts"]),
                  "runners": len(rendered["projection"]["airunners"]), "scopes": len(rendered["projection"]["scopes"]),
                  "inventory_sha256": comparison["effective_inventory_sha256"], "policy_sha256": comparison["policy_sha256"],
                  "private_input_sha256": {name: hashlib.sha256(value).hexdigest() for name, value in inputs.items()},
                  "source_unchanged": True, "temporary_fixture_removed": True, "published": False,
                  "review_only_plan_contracts": len(plans), "plan_sha256": plans, "installed_toolchain_verified": False}
        if args.instance_only:
            result["mac_promotion_candidate"] = mac_candidate
            result["private_compiler_comparisons"] = compiler_comparisons
        (output / "result.json").write_text(canonical(result) + "\n")
        print(canonical(result))
    except (OSError, ValueError, KeyError, TypeError, subprocess.CalledProcessError, checker.PlanError) as error:
        print("prepare-inventory-source-candidate: " + str(error) + ("; private evidence: " + str(output) if output else ""), file=sys.stderr)
        return 1
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
