#!/usr/bin/env python3
"""Clone a private Instance with ordinary Git and the operator's credentials."""
import argparse
from pathlib import Path
import re
import subprocess

parser = argparse.ArgumentParser(description=__doc__)
parser.add_argument('--repository', required=True, help='OWNER/klokast-instance')
parser.add_argument('--worktree', type=Path, required=True)
args = parser.parse_args()
if not re.fullmatch(r'[A-Za-z0-9][A-Za-z0-9-]{0,38}/klokast-instance', args.repository):
    parser.error('repository must be OWNER/klokast-instance')
if args.worktree.exists(): parser.error('worktree destination already exists')
raise SystemExit(subprocess.run(['git', 'clone', '--', 'git@github.com:' + args.repository + '.git',
                                str(args.worktree)], check=False).returncode)
