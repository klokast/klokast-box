#!/usr/bin/env bash
set -euo pipefail

KSA_TOOL_NAME="install-secret-authority-approval-signer"
SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd -P)"
. "$SCRIPT_DIR/../lib/approval-common.sh"

DEFAULT_CONTROLLER="${KLOKAST_OPS_CONTROLLER:-k002-ops}"
SIGNATURE_NAMESPACE="klokast-secret-authority"

usage() {
  cat <<EOF
Usage:
  $0 --purpose private-instance|static-site [--controller HOST]
  $0 --finalize-migration [--controller HOST]

Creates or reuses one Apple-native, non-exportable Secure Enclave identity
protected by Touch ID. It installs that purpose's public key into a dedicated
root-only allowed-signers file on the active controller. The private key never
leaves the Mac Secure Enclave.

Options:
  --purpose PURPOSE    Approval scope: private-instance or static-site.
  --controller HOST    Active controller. Default: ${DEFAULT_CONTROLLER}
  --finalize-migration Verify both scoped signers, then remove the inactive
                       legacy generic allowed-signers file.

The two purposes use different Secure Enclave identities. This tool uses only
Apple's /usr/sbin/sc_auth, /usr/bin/ssh-keygen, and
/usr/lib/ssh-keychain.dylib. It does not use a passkey or an SSH agent.
EOF
}

controller="$DEFAULT_CONTROLLER"
purpose=""
finalize_migration=false

while [ "$#" -gt 0 ]; do
  case "$1" in
    --controller)
      [ "$#" -ge 2 ] || ksa_die "--controller needs a host"
      controller="$2"
      shift 2
      ;;
    --purpose)
      [ "$#" -ge 2 ] || ksa_die "--purpose needs private-instance or static-site"
      purpose="$2"
      shift 2
      ;;
    --finalize-migration)
      finalize_migration=true
      shift
      ;;
    -h|--help)
      usage
      exit 0
      ;;
    *)
      ksa_die "unknown argument: $1"
      ;;
  esac
done

ksa_valid_controller "$controller" || ksa_die "--controller contains unsafe characters"
controller="$(ksa_resolve_controller "$controller")"
ksa_valid_controller "$controller" || ksa_die "resolved controller contains unsafe characters"
if [ "$finalize_migration" = true ]; then
  [ -z "$purpose" ] || ksa_die "--finalize-migration cannot be used with --purpose"
else
  case "$purpose" in
    private-instance|static-site) ;;
    *) ksa_die "--purpose private-instance or --purpose static-site is required" ;;
  esac
fi
if [ ! -t 0 ] || [ ! -t 1 ]; then
  ksa_die "run this command in an interactive terminal on the trusted MacBook"
fi

ksa_need_command tailscale
ksa_need_command mktemp
ksa_need_command install
ksa_need_command grep
ksa_require_native_touchid

ssh_target="smith@${controller}"
tmpdir="$(mktemp -d "${TMPDIR:-/tmp}/ksa-touchid-signer.XXXXXX")"
remote_dirs=""

cleanup() {
  old_ifs="$IFS"
  IFS=' '
  for cleanup_dir in $remote_dirs; do
    case "$cleanup_dir" in
      /tmp/ksa-touchid-signer.*)
        tailscale ssh "$ssh_target" "rm -rf '$cleanup_dir'" >/dev/null 2>&1 || true
        ;;
    esac
  done
  IFS="$old_ifs"
  rm -rf "$tmpdir"
}
trap cleanup EXIT HUP INT TERM

new_remote_dir() {
  created_dir="$(tailscale ssh "$ssh_target" 'mktemp -d /tmp/ksa-touchid-signer.XXXXXX')"
  case "$created_dir" in
    /tmp/ksa-touchid-signer.*) ;;
    *) ksa_die "controller returned an unsafe temporary directory: $created_dir" ;;
  esac
  remote_dirs="${remote_dirs}${remote_dirs:+ }${created_dir}"
}

install_purpose_signer() {
  selected_purpose="$1"
  ksa_ensure_touchid_profile "$selected_purpose" "$tmpdir"

  normalized_pub="$tmpdir/${selected_purpose}.normalized.pub"
  ksa_normalize_public_key "$pub_path" > "$normalized_pub"
  allowed_line="$tmpdir/${selected_purpose}.allowed-signers"
  {
    printf '%s namespaces="%s" ' "$signer_id" "$SIGNATURE_NAMESPACE"
    cat "$normalized_pub"
  } > "$allowed_line"
  chmod 0600 "$allowed_line"

  message="$tmpdir/${selected_purpose}.signer-check"
  printf 'klokast Secret Authority %s signer check: %s\n' \
    "$selected_purpose" "$signer_id" > "$message"
  if ! ksa_sign_touchid_message "$message"; then
    ksa_die "Touch ID did not approve the ${selected_purpose} signer check"
  fi

  new_remote_dir
  remote_dir="$created_dir"
  remote_line="$remote_dir/allowed-signers"
  remote_message="$remote_dir/message"
  remote_signature="$remote_dir/message.sig"
  tailscale ssh "$ssh_target" "cat > '$remote_line'" < "$allowed_line"
  tailscale ssh "$ssh_target" "cat > '$remote_message'" < "$message"
  tailscale ssh "$ssh_target" "cat > '$remote_signature'" < "${message}.sig"

  ksa_log "Verifying and installing the ${selected_purpose} signer on ${controller}..."
  tailscale ssh "$ssh_target" sh -s -- \
    "$selected_purpose" "$signer_id" "$allowed_signers_path" \
    "$remote_line" "$remote_message" "$remote_signature" "$remote_dir" <<'SH'
set -eu
purpose=$1
signer_id=$2
target=$3
candidate=$4
message=$5
signature=$6
remote_dir=$7
staged=""

cleanup() {
  rm -rf "$remote_dir"
  if [ -n "$staged" ]; then
    doas rm -f "$staged" >/dev/null 2>&1 || true
  fi
}
trap cleanup EXIT HUP INT TERM

case "$purpose:$signer_id:$target" in
  private-instance:human-private-instance:/etc/klokast/secret-authority/allowed-signers-private-instance) ;;
  static-site:human-static-site:/etc/klokast/secret-authority/allowed-signers-static-site) ;;
  *) echo "approval signer scope is not allowed" >&2; exit 2 ;;
esac
staged="${target}.new.$$"

awk -v signer="$signer_id" '
  NF == 4 &&
  $1 == signer &&
  $2 == "namespaces=\"klokast-secret-authority\"" &&
  $3 == "sk-ecdsa-sha2-nistp256@openssh.com" { valid += 1; next }
  { invalid = 1 }
  END { exit(valid == 1 && !invalid ? 0 : 1) }
' "$candidate" || {
  echo "allowed signer candidate has an invalid principal, namespace, or key type" >&2
  exit 2
}

doas ssh-keygen -Y verify \
  -f "$candidate" \
  -I "$signer_id" \
  -n klokast-secret-authority \
  -s "$signature" \
  < "$message" >/dev/null

doas install -d -m 0700 -o root -g root /etc/klokast/secret-authority
doas install -m 0600 -o root -g root "$candidate" "$staged"
doas mv -f "$staged" "$target"

doas ssh-keygen -Y verify \
  -f "$target" \
  -I "$signer_id" \
  -n klokast-secret-authority \
  -s "$signature" \
  < "$message" >/dev/null
SH

  remote_dirs="$(printf '%s\n' "$remote_dirs" | sed "s#${remote_dir}##; s/^ //; s/  */ /g")"
  ksa_log "Installed ${signer_id} (${key_fingerprint}) for ${selected_purpose}."
}

verify_installed_purpose() {
  selected_purpose="$1"
  ksa_load_touchid_profile "$selected_purpose"
  message="$tmpdir/${selected_purpose}.migration-check"
  printf 'klokast Secret Authority %s migration check: %s\n' \
    "$selected_purpose" "$signer_id" > "$message"
  if ! ksa_sign_touchid_message "$message"; then
    ksa_die "Touch ID did not approve the ${selected_purpose} migration check"
  fi

  new_remote_dir
  remote_dir="$created_dir"
  remote_message="$remote_dir/message"
  remote_signature="$remote_dir/message.sig"
  tailscale ssh "$ssh_target" "cat > '$remote_message'" < "$message"
  tailscale ssh "$ssh_target" "cat > '$remote_signature'" < "${message}.sig"
  tailscale ssh "$ssh_target" sh -s -- \
    "$signer_id" "$allowed_signers_path" "$remote_message" "$remote_signature" "$remote_dir" <<'SH'
set -eu
signer_id=$1
allowed_signers=$2
message=$3
signature=$4
remote_dir=$5
trap 'rm -rf "$remote_dir"' EXIT HUP INT TERM

case "$signer_id:$allowed_signers" in
  human-private-instance:/etc/klokast/secret-authority/allowed-signers-private-instance) ;;
  human-static-site:/etc/klokast/secret-authority/allowed-signers-static-site) ;;
  *) echo "installed approval signer scope is not allowed" >&2; exit 2 ;;
esac

doas ssh-keygen -Y verify \
  -f "$allowed_signers" \
  -I "$signer_id" \
  -n klokast-secret-authority \
  -s "$signature" \
  < "$message" >/dev/null
SH
  remote_dirs="$(printf '%s\n' "$remote_dirs" | sed "s#${remote_dir}##; s/^ //; s/  */ /g")"
}

finalize_touchid_migration() {
  verify_installed_purpose private-instance
  verify_installed_purpose static-site

  static_status="$(tailscale ssh "$ssh_target" \
    'cd ~/src/klokast/klokast-box && ansible/bin/secret-authority static-site status --redacted')"
  instance_status="$(tailscale ssh "$ssh_target" \
    'cd ~/src/klokast/klokast-box && ansible/bin/secret-authority instance status --redacted')"
  printf '%s\n' "$static_status" | grep -q '"approval_signer":"human-static-site"' || \
    ksa_die "the deployed static-site authority does not enforce the scoped Touch ID signer"
  printf '%s\n' "$instance_status" | grep -q '"approval_signer":"human-private-instance"' || \
    ksa_die "the deployed private-instance authority does not enforce the scoped Touch ID signer"

  printf 'Both scoped Touch ID signers passed. Remove the inactive legacy signer file? [y/N] ' >&2
  IFS= read -r answer || ksa_die "input ended before migration confirmation"
  case "$answer" in
    y|Y|yes|YES|Yes) ;;
    *) ksa_die "legacy signer retirement was not approved" ;;
  esac
  tailscale ssh "$ssh_target" sh -s <<'SH'
set -eu
doas rm -f /etc/klokast/secret-authority/allowed-signers
SH
  ksa_log "Touch ID migration is complete. The legacy generic signer file was removed."
}

if [ "$finalize_migration" = true ]; then
  finalize_touchid_migration
else
  install_purpose_signer "$purpose"
fi
