#!/usr/bin/env bash
set -euo pipefail

KSA_TOOL_NAME="install-secret-authority-approval-signer"
SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd -P)"
. "$SCRIPT_DIR/../lib/approval-common.sh"

DEFAULT_CONTROLLER="${KLOKAST_OPS_CONTROLLER:-k002-ops}"
DEFAULT_SIGNER_ID="${KLOKAST_APPROVAL_SIGNER_ID:-xiaoju-og}"
DEFAULT_KEY="$HOME/.ssh/minionroval-sk"
DEFAULT_KEY_TYPE="${KLOKAST_APPROVAL_KEY_TYPE:-ed25519-sk}"
DEFAULT_SSH_KEYGEN="${KLOKAST_SSH_KEYGEN:-}"
DEFAULT_SK_PROVIDER="${KLOKAST_SK_PROVIDER:-}"
DEFAULT_YUBIKEY_WAIT_SECONDS="${KLOKAST_YUBIKEY_WAIT_SECONDS:-60}"
DEFAULT_SIGNATURE_ATTEMPTS="${KLOKAST_APPROVAL_SIGNATURE_ATTEMPTS:-3}"
SIGNATURE_NAMESPACE="klokast-secret-authority"

usage() {
  cat <<EOF
Usage:
  $0 [--controller HOST] [--signer-id ID] [--key PATH] [--key-type TYPE]
     [--ssh-keygen PATH] [--sk-provider PATH]

Creates or reuses a YubiKey/FIDO-backed SSH signing key on the MacBook, installs
its public key into the root-only Secret Authority allowed-signers file on the
ops controller, then verifies a test signature through the controller.

Options:
  --controller HOST   Controller host. Default: ${DEFAULT_CONTROLLER}
  --signer-id ID      Allowed-signers identity. Default: ${DEFAULT_SIGNER_ID}
  --key PATH          Local signing key path. Default: ${DEFAULT_KEY}
  --key-type TYPE     ed25519-sk or ecdsa-sk. Default: ${DEFAULT_KEY_TYPE}
  --ssh-keygen PATH   ssh-keygen binary. Default: Homebrew OpenSSH on macOS if
                      present, otherwise ssh-keygen from PATH.
  --sk-provider PATH  Optional external OpenSSH FIDO provider library. Also
                      exported as SSH_SK_PROVIDER for signing.
  --yubikey-wait-seconds N
                      Seconds to wait for USB YubiKey detection. Default:
                      ${DEFAULT_YUBIKEY_WAIT_SECONDS}
  --signature-attempts N
                      Local approval signature attempts. Default:
                      ${DEFAULT_SIGNATURE_ATTEMPTS}
  --skip-yubikey-gate Do not prompt/wait before local YubiKey operations.
  --skip-verify       Install the signer but skip the signature round-trip.

YubiKey timing:
  Insert the YubiKey when prompted. Key generation and signature verification may
  both prompt for PIN/touch.
EOF
}

controller="$DEFAULT_CONTROLLER"
signer_id="$DEFAULT_SIGNER_ID"
key_path="$DEFAULT_KEY"
key_type="$DEFAULT_KEY_TYPE"
ssh_keygen="$DEFAULT_SSH_KEYGEN"
sk_provider="$DEFAULT_SK_PROVIDER"
yubikey_wait_seconds="$DEFAULT_YUBIKEY_WAIT_SECONDS"
signature_attempts="$DEFAULT_SIGNATURE_ATTEMPTS"
skip_yubikey_gate=false
yubikey_gate_done=false
verify_signature=true

while [ "$#" -gt 0 ]; do
  case "$1" in
    --controller)
      [ "$#" -ge 2 ] || ksa_die "--controller needs a host"
      controller="$2"
      shift 2
      ;;
    --signer-id)
      [ "$#" -ge 2 ] || ksa_die "--signer-id needs an identity"
      signer_id="$2"
      shift 2
      ;;
    --key)
      [ "$#" -ge 2 ] || ksa_die "--key needs a path"
      key_path="$2"
      shift 2
      ;;
    --key-type)
      [ "$#" -ge 2 ] || ksa_die "--key-type needs ed25519-sk or ecdsa-sk"
      key_type="$2"
      shift 2
      ;;
    --ssh-keygen)
      [ "$#" -ge 2 ] || ksa_die "--ssh-keygen needs a path"
      ssh_keygen="$2"
      shift 2
      ;;
    --sk-provider)
      [ "$#" -ge 2 ] || ksa_die "--sk-provider needs a path"
      sk_provider="$2"
      shift 2
      ;;
    --yubikey-wait-seconds)
      [ "$#" -ge 2 ] || ksa_die "--yubikey-wait-seconds needs a number"
      yubikey_wait_seconds="$2"
      shift 2
      ;;
    --signature-attempts)
      [ "$#" -ge 2 ] || ksa_die "--signature-attempts needs a positive integer"
      signature_attempts="$2"
      shift 2
      ;;
    --skip-yubikey-gate)
      skip_yubikey_gate=true
      shift
      ;;
    --skip-verify)
      verify_signature=false
      shift
      ;;
    -h|--help)
      usage
      exit 0
      ;;
    *)
      ksa_die "unknown argument: $1"
      ;;
  esac
done

ksa_valid_controller "$controller" || ksa_die "--controller contains unsafe characters"
controller="$(ksa_resolve_controller "$controller")"
ksa_valid_controller "$controller" || ksa_die "resolved controller contains unsafe characters"
ksa_valid_signer_id "$signer_id" || ksa_die "--signer-id may contain only letters, digits, dot, underscore, at, plus, and hyphen"
ksa_valid_key_type "$key_type" || ksa_die "--key-type must be ed25519-sk or ecdsa-sk"
ksa_valid_wait_seconds "$yubikey_wait_seconds" || ksa_die "--yubikey-wait-seconds must be a non-negative integer"
ksa_valid_positive_integer "$signature_attempts" || ksa_die "--signature-attempts must be a positive integer"

ksa_need_command tailscale
ksa_need_command mktemp
ksa_need_command grep
ksa_need_command cmp
ksa_need_command chmod
ksa_need_command install

key_path="$(ksa_expand_path "$key_path")"
pub_path="${key_path}.pub"
ssh_keygen="$(ksa_choose_ssh_keygen "$ssh_keygen")"
ssh_target="smith@${controller}"

ksa_log "Using ssh-keygen: $ssh_keygen"
if [ "$(uname -s)" = "Darwin" ]; then
  case "$ssh_keygen" in
    /usr/bin/ssh-keygen|/bin/ssh-keygen)
      ksa_log "Warning: macOS system ssh-keygen may lack OpenSSH FIDO provider support; Homebrew OpenSSH is recommended for YubiKey approval keys."
      ;;
  esac
fi

if [ -n "$sk_provider" ]; then
  sk_provider="$(ksa_expand_path "$sk_provider")"
  [ -f "$sk_provider" ] || ksa_die "--sk-provider does not exist: $sk_provider"
  export SSH_SK_PROVIDER="$sk_provider"
  ksa_log "Using OpenSSH FIDO provider: $sk_provider"
fi

if [ ! -f "$key_path" ]; then
  [ ! -e "$pub_path" ] || ksa_die "public key exists but private key is missing: $pub_path"
  install -d -m 0700 "$(dirname "$key_path")"
  ksa_wait_for_yubikey "approval key generation"
  ksa_log "Generating ${key_type} approval key at ${key_path}..."
  if [ -n "$sk_provider" ]; then
    if ! "$ssh_keygen" -w "$sk_provider" -t "$key_type" \
      -O verify-required \
      -N '' \
      -C "${signer_id} klokast Secret Authority approval" \
      -f "$key_path"; then
      ksa_die "ssh-keygen failed to enroll the FIDO approval key; if the error above says no FIDO SecurityKeyProvider was specified, install Homebrew OpenSSH or rerun with --sk-provider"
    fi
  else
    if ! "$ssh_keygen" -t "$key_type" \
      -O verify-required \
      -N '' \
      -C "${signer_id} klokast Secret Authority approval" \
      -f "$key_path"; then
      ksa_die "ssh-keygen failed to enroll the FIDO approval key; if the error above says no FIDO SecurityKeyProvider was specified, install Homebrew OpenSSH or rerun with --sk-provider"
    fi
  fi
  ksa_log "Approval key generated: $key_path"
else
  ksa_log "Reusing existing approval key: $key_path"
fi

chmod 0600 "$key_path"
derived_pub="$(mktemp "${TMPDIR:-/tmp}/ksa-approval-pub.XXXXXX")"
if ! "$ssh_keygen" -y -f "$key_path" > "$derived_pub"; then
  rm -f "$derived_pub"
  ksa_die "approval key could not be read; if an earlier enrollment failed, move $key_path and ${key_path}.pub aside and rerun"
fi
if [ -f "$pub_path" ]; then
  if ! cmp -s "$derived_pub" "$pub_path"; then
    rm -f "$derived_pub"
    ksa_die "public key does not match private key handle; move $pub_path aside and rerun"
  fi
else
  install -m 0644 "$derived_pub" "$pub_path"
fi
rm -f "$derived_pub"
chmod 0644 "$pub_path"

if ! grep -Eq '^(sk-ssh-ed25519|sk-ecdsa-sha2-nistp256)@openssh.com ' "$pub_path"; then
  ksa_die "public key is not a FIDO/U2F security-key SSH key: $pub_path"
fi

tmpdir="$(mktemp -d "${TMPDIR:-/tmp}/ksa-approval-signer.XXXXXX")"
cleanup() {
  rm -rf "$tmpdir"
}
trap cleanup EXIT HUP INT TERM

allowed_line="$tmpdir/allowed-signer"
{
  printf '%s namespaces="%s" ' "$signer_id" "$SIGNATURE_NAMESPACE"
  cat "$pub_path"
} > "$allowed_line"

ksa_log "Installing signer ${signer_id} into ${controller}..."
remote_line="$(
  tailscale ssh "$ssh_target" 'mktemp /tmp/ksa-allowed-signer.XXXXXX'
)"
cat "$allowed_line" | tailscale ssh "$ssh_target" "cat > '$remote_line'"
tailscale ssh "$ssh_target" sh -s -- "$signer_id" "$SIGNATURE_NAMESPACE" "$remote_line" <<'SH'
set -eu
signer_id=$1
namespace=$2
line_path=$3

case "$signer_id" in
  ''|*[!A-Za-z0-9._@+-]*) echo "unsafe signer id" >&2; exit 2 ;;
esac
case "$namespace" in
  klokast-secret-authority) ;;
  *) echo "unexpected namespace" >&2; exit 2 ;;
esac

line=$(cat "$line_path")
rm -f "$line_path"
case "$line" in
  "$signer_id namespaces=\"$namespace\" "*) ;;
  *) echo "allowed signer line does not start with signer id and namespace restriction" >&2; exit 2 ;;
esac

doas install -d -m 0700 -o root -g root /etc/klokast/secret-authority
existing=$(mktemp)
tmp=$(mktemp)
trap 'rm -f "$existing" "$tmp"' EXIT HUP INT TERM

if doas test -f /etc/klokast/secret-authority/allowed-signers; then
  doas cat /etc/klokast/secret-authority/allowed-signers > "$existing"
else
  : > "$existing"
fi

awk -v sid="$signer_id" 'index($0, sid " ") != 1 { print }' "$existing" > "$tmp"
printf '%s\n' "$line" >> "$tmp"
doas install -m 0600 -o root -g root "$tmp" /etc/klokast/secret-authority/allowed-signers
SH

status="$(
  tailscale ssh "$ssh_target" \
    'cd ~/src/klokast/klokast-box && ansible/bin/secret-authority static-site status --redacted'
)"
printf '%s\n' "$status"
printf '%s\n' "$status" | grep -q '"allowed_signers_configured":true' || \
  ksa_die "Secret Authority status did not report allowed_signers_configured=true"

if [ "$verify_signature" = true ]; then
  ksa_wait_for_yubikey "approval signer self-test"
  message="$tmpdir/signature-check.txt"
  printf 'klokast Secret Authority signer check: %s\n' "$signer_id" > "$message"
  ksa_log "Signing a test approval message with the YubiKey-backed approval key..."
  if ! ksa_sign_message_with_retries "$message"; then
    ksa_die "ssh-keygen failed to sign with the approval key after ${signature_attempts} attempts; verify the YubiKey is inserted, the YubiKey FIDO2 PIN is correct, and the same ssh-keygen/provider is being used"
  fi

  remote_dir="$(
    tailscale ssh "$ssh_target" 'mktemp -d /tmp/ksa-approval-signer.XXXXXX'
  )"
  remote_message="${remote_dir}/message"
  remote_signature="${remote_dir}/message.sig"
  cat "$message" | tailscale ssh "$ssh_target" "cat > '$remote_message'"
  cat "${message}.sig" | tailscale ssh "$ssh_target" "cat > '$remote_signature'"
  tailscale ssh "$ssh_target" sh -s -- "$signer_id" "$remote_message" "$remote_signature" "$remote_dir" <<'SH'
set -eu
signer_id=$1
message=$2
signature=$3
remote_dir=$4

cleanup() {
  rm -rf "$remote_dir"
}
trap cleanup EXIT HUP INT TERM

doas ssh-keygen -Y verify \
  -f /etc/klokast/secret-authority/allowed-signers \
  -I "$signer_id" \
  -n klokast-secret-authority \
  -s "$signature" \
  < "$message" >/dev/null
SH
  ksa_log "Approval signer signature check ok"
fi

ksa_log "Secret Authority approval signer ${signer_id} is installed on ${controller}."
