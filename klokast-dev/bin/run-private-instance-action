#!/usr/bin/env bash
set -euo pipefail

# Used by ksa_die from the sourced helper.
# shellcheck disable=SC2034
KSA_TOOL_NAME="run-private-instance-action"
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd -P)"
REPO_ROOT="$(cd "$SCRIPT_DIR/../.." && pwd -P)"
# shellcheck source=klokast-dev/lib/approval-common.sh
. "$SCRIPT_DIR/../lib/approval-common.sh"

SESSION_FILE="$HOME/.local/share/klokast/private-instance-bootstrap/session.sh"
EXPECTED_REPO_NAME="klokast-instance"
EXPECTED_SIGNER_ID="human-private-instance"
EXPECTED_PURPOSE="private-instance"

usage() {
  cat <<EOF
Usage: $0 register-repository|register-read-key|retire-bootstrap

Runs one human-approved private-instance bootstrap action from the trusted
MacBook. The wrapper gets a short-lived intent from the active controller,
shows the exact intent, asks for approval, signs it with Touch ID, uploads it,
and runs only the named action.

Run prepare-private-instance-bootstrap before use. This wrapper loads its
owner-only session file directly. It writes a redacted action journal to
action-audit.jsonl in the bootstrap work directory.
EOF
}

action="${1:-}"
case "$action" in
  -h|--help)
    [ "$#" -eq 1 ] || ksa_die "--help does not accept other arguments"
    usage
    exit 0
    ;;
  register-repository|register-read-key|retire-bootstrap)
    [ "$#" -eq 1 ] || ksa_die "one action is required"
    ;;
  "")
    usage >&2
    ksa_die "one action is required"
    ;;
  *)
    usage >&2
    ksa_die "unsupported action: $action"
    ;;
esac

if [ ! -t 0 ] || [ ! -t 1 ]; then
  ksa_die "run this command in an interactive terminal on the trusted MacBook"
fi
[ "$(uname -s)" = Darwin ] || ksa_die "run this command on the trusted MacBook"
ksa_need_command git
ksa_need_command mktemp
ksa_need_command python3
ksa_need_command tailscale

if [ ! -f "$SESSION_FILE" ] || [ -L "$SESSION_FILE" ]; then
  ksa_die "bootstrap session is missing; rerun prepare-private-instance-bootstrap"
fi
[ "$(stat -f '%Lp' "$SESSION_FILE")" = 600 ] || \
  ksa_die "bootstrap session must have mode 0600: $SESSION_FILE"
# The session is generated by prepare-private-instance-bootstrap and contains
# only quoted identifiers and local paths.
# shellcheck disable=SC1090
. "$SESSION_FILE"

ksa_valid_controller "${CONTROLLER:-}" || ksa_die "session controller is invalid"
[ "${SSH_TARGET:-}" = "smith@$CONTROLLER" ] || ksa_die "session SSH target is invalid"
ksa_valid_github_owner "${INSTANCE_OWNER:-}" || ksa_die "session GitHub owner is invalid"
[ "${#INSTANCE_OWNER}" -le 39 ] || ksa_die "session GitHub owner is too long"
[ "${INSTANCE_REPO:-}" = "$EXPECTED_REPO_NAME" ] || \
  ksa_die "session repository must be $EXPECTED_REPO_NAME"
[ "${SIGNER_ID:-}" = "$EXPECTED_SIGNER_ID" ] || ksa_die "session signer is invalid"
[ "${APPROVAL_PURPOSE:-}" = "$EXPECTED_PURPOSE" ] || ksa_die "session approval purpose is invalid"
case "${ENGINE_COMMIT:-}" in
  ""|*[!0-9a-f]*) ksa_die "session engine commit is invalid" ;;
esac
[ "${#ENGINE_COMMIT}" -eq 40 ] || ksa_die "session engine commit must be full length"
[ "${BOOTSTRAP_WORK:-}" = "$HOME/.local/share/klokast/private-instance-bootstrap" ] || \
  ksa_die "session work directory is invalid"
if [ ! -d "$BOOTSTRAP_WORK" ] || [ -L "$BOOTSTRAP_WORK" ]; then
  ksa_die "session work directory is not a safe directory"
fi

[ -z "$(git -C "$REPO_ROOT" status --porcelain)" ] || \
  ksa_die "the public checkout has changes; preserve them before this approval"
pinned_engine="$(sed -n 's/^ENGINE_COMMIT="\([0-9a-f][0-9a-f]*\)"$/\1/p' \
  "$SCRIPT_DIR/prepare-private-instance-bootstrap")"
[ "$pinned_engine" = "$ENGINE_COMMIT" ] || \
  ksa_die "the session does not match the current reviewed bootstrap helper; rerun it"

umask 077
action_work="$(mktemp -d "$BOOTSTRAP_WORK/action.XXXXXX")" || \
  ksa_die "cannot create the temporary approval directory"
status_file="$action_work/status.json"
intent_file="$action_work/intent.json"
action_log="$BOOTSTRAP_WORK/action-audit.jsonl"
remote_intent=""
remote_signature=""
action_phase="read-controller-status"
action_outcome="failure"
intent_sha256=""
action_fingerprint="none"

append_action_log() {
  python3 - "$action_log" "$action_outcome" "$1" "$action" "$action_phase" \
    "$CONTROLLER" "$INSTANCE_OWNER" "$INSTANCE_REPO" "$ENGINE_COMMIT" \
    "$intent_sha256" "$action_fingerprint" <<'PY'
import datetime as dt
import hashlib
import json
import os
import re
import stat
import sys

(path, outcome, exit_code, action, phase, controller, owner, repo,
 engine_commit, intent_sha256, key_fingerprint) = sys.argv[1:]
if outcome not in {"success", "failure", "cancelled"}:
    raise SystemExit("invalid action log outcome")
if not exit_code.isdigit() or not 0 <= int(exit_code) <= 255:
    raise SystemExit("invalid action log exit code")
if not re.fullmatch(r"[a-z0-9-]{1,80}", phase):
    raise SystemExit("invalid action log phase")
if not re.fullmatch(r"[0-9a-f]{40}", engine_commit):
    raise SystemExit("invalid action log engine commit")
if intent_sha256 and not re.fullmatch(r"[0-9a-f]{64}", intent_sha256):
    raise SystemExit("invalid action log intent hash")
repository = f"{owner}/{repo}"
record = {
    "ts": dt.datetime.now(dt.timezone.utc).isoformat(timespec="seconds").replace("+00:00", "Z"),
    "event": "private-instance.wrapper.finished",
    "action": action,
    "outcome": outcome,
    "exit_code": int(exit_code),
    "phase": phase,
    "controller": controller,
    "repository_sha256": hashlib.sha256(repository.encode("utf-8")).hexdigest(),
    "repo_head": engine_commit,
}
if intent_sha256:
    record["intent_sha256"] = intent_sha256
if key_fingerprint != "none":
    record["key_fingerprint"] = key_fingerprint
encoded = (json.dumps(record, ensure_ascii=True, sort_keys=True, separators=(",", ":")) + "\n").encode("utf-8")
flags = os.O_WRONLY | os.O_CREAT | os.O_APPEND
if hasattr(os, "O_NOFOLLOW"):
    flags |= os.O_NOFOLLOW
descriptor = os.open(path, flags, 0o600)
try:
    metadata = os.fstat(descriptor)
    if (not stat.S_ISREG(metadata.st_mode) or metadata.st_nlink != 1
            or metadata.st_uid != os.getuid()):
        raise SystemExit("action log is not a private regular file")
    if os.write(descriptor, encoded) != len(encoded):
        raise SystemExit("cannot append the complete action log record")
    os.fsync(descriptor)
    os.fchmod(descriptor, 0o600)
finally:
    os.close(descriptor)
PY
}

cleanup() {
  exit_status=$?
  trap - EXIT
  if [ -n "$remote_intent" ]; then
    tailscale ssh "$SSH_TARGET" \
      "rm -f '$remote_intent' '$remote_signature'" >/dev/null 2>&1 || true
  fi
  rm -f "$status_file" "$intent_file" "$intent_file.sig" || true
  rmdir "$action_work" 2>/dev/null || true
  if ! append_action_log "$exit_status"; then
    printf 'Warning: could not append the redacted action journal: %s\n' "$action_log" >&2
  fi
  if [ "$action_outcome" = failure ]; then
    printf '\nPrivate-instance action failed.\n' >&2
    printf '  Action: %s\n' "$action" >&2
    printf '  Failed phase: %s\n' "$action_phase" >&2
    printf '  Wrapper exit code: %s\n' "$exit_status" >&2
    printf '  Redacted action journal: %s\n' "$action_log" >&2
    printf '  Controller audit: /var/log/klokast/secret-authority.jsonl on %s\n' "$CONTROLLER" >&2
    printf 'Earlier phases can have completed. Read the controller error above before you retry.\n' >&2
  fi
  exit "$exit_status"
}
trap cleanup EXIT
trap 'exit 130' HUP INT TERM

tailscale ssh "$SSH_TARGET" sh -s -- "$ENGINE_COMMIT" >"$status_file" <<'SH'
set -eu
expected=$1
cd "$HOME/src/klokast/klokast-box"
/usr/local/sbin/klokast-controller-guard --status --json --require-active >/dev/null
test "$(git rev-parse HEAD)" = "$expected"
test -z "$(git status --porcelain)"
ansible/bin/secret-authority instance status --redacted
SH

action_fingerprint="$(python3 - "$status_file" "$action" <<'PY'
import json
import re
import sys

path, action = sys.argv[1:]
with open(path, encoding="utf-8") as handle:
    value = json.load(handle)
for field in ("allowed_signers_configured", "github_app_configured", "source_prepared"):
    if value.get(field) is not True:
        raise SystemExit(f"controller prerequisite is false: {field}")
registered = value.get("repository_registered") is True
if action == "register-repository":
    if registered:
        raise SystemExit("repository is already registered; run register-read-key next")
    print("none")
else:
    if not registered:
        raise SystemExit("repository is not registered; run register-repository first")
    fingerprint = value.get("key_fingerprint", "")
    if not re.fullmatch(r"SHA256:[A-Za-z0-9+/]{20,80}", fingerprint):
        raise SystemExit("controller did not return a valid read-key fingerprint")
    print(fingerprint)
PY
)" || ksa_die "controller status does not permit $action"

case "$action" in
  register-repository)
    action_summary="Verify and record the exact empty private repository. Do not change its contents."
    ;;
  register-read-key)
    action_summary="Register the controller key as read-only, then prove that the repository has no Git refs."
    ;;
  retire-bootstrap)
    action_summary="Verify that App access was removed, then delete the temporary App credential from the controller."
    ;;
esac

action_phase="request-intent"
tailscale ssh "$SSH_TARGET" sh -s -- \
  "$ENGINE_COMMIT" "$INSTANCE_OWNER" "$INSTANCE_REPO" "$action" \
  "$action_fingerprint" >"$intent_file" <<'SH'
set -eu
expected=$1
owner=$2
repo=$3
action=$4
fingerprint=$5
cd "$HOME/src/klokast/klokast-box"
/usr/local/sbin/klokast-controller-guard --status --json --require-active >/dev/null
test "$(git rev-parse HEAD)" = "$expected"
test -z "$(git status --porcelain)"
case "$action" in
  register-repository)
    ansible/bin/secret-authority intent instance register-repository \
      --repo-owner "$owner" --repo-name "$repo" --ttl-seconds 600
    ;;
  register-read-key|retire-bootstrap)
    ansible/bin/secret-authority intent instance "$action" \
      --repo-owner "$owner" --repo-name "$repo" \
      --key-fingerprint "$fingerprint" --ttl-seconds 600
    ;;
  *) exit 2 ;;
esac
SH

action_phase="validate-intent"
intent_metadata="$(python3 - "$intent_file" "$action" "$INSTANCE_OWNER" \
  "$INSTANCE_REPO" "$ENGINE_COMMIT" "$action_fingerprint" <<'PY'
import datetime as dt
import hashlib
import json
import re
import sys

path, action, owner, repo, engine_commit, fingerprint = sys.argv[1:]
with open(path, encoding="utf-8") as handle:
    raw = handle.read()
value = json.loads(raw)
expected = {
    "schema_version": 1,
    "authority": "klokast-secret-authority",
    "app": "instance",
    "action": action,
    "repo_owner": owner,
    "repo_name": repo,
    "repo_head": engine_commit,
}
fields = set(expected) | {"expires_at", "nonce"}
if action != "register-repository":
    expected["key_fingerprint"] = fingerprint
    fields.add("key_fingerprint")
if set(value) != fields:
    raise SystemExit("intent fields do not match the closed schema")
for key, wanted in expected.items():
    if value.get(key) != wanted:
        raise SystemExit(f"intent mismatch for {key}")
canonical = json.dumps(value, ensure_ascii=True, sort_keys=True, separators=(",", ":")) + "\n"
if raw != canonical:
    raise SystemExit("intent is not canonical JSON")
nonce = value.get("nonce", "")
if not re.fullmatch(r"[A-Za-z0-9_-]{12,128}", nonce):
    raise SystemExit("intent nonce is invalid")
expires_text = value.get("expires_at", "")
if not expires_text.endswith("Z"):
    raise SystemExit("intent expiry is not UTC")
expires = dt.datetime.fromisoformat(expires_text[:-1] + "+00:00")
now = dt.datetime.now(dt.timezone.utc)
if not now < expires <= now + dt.timedelta(minutes=11):
    raise SystemExit("intent expiry is outside the expected short window")
print(f"{nonce}:{hashlib.sha256(raw.encode('utf-8')).hexdigest()}")
PY
)" || ksa_die "the controller returned an invalid intent"
intent_nonce="${intent_metadata%%:*}"
intent_sha256="${intent_metadata#*:}"

printf '\nPurpose\n  %s\n' "$action_summary"
printf '\nExact short-lived intent to approve\n'
python3 -m json.tool "$intent_file"
printf '\nCheck the action, repository, engine commit, key fingerprint when present, and expiry.\n'
printf 'Sign and run this exact action? [y/N] '
action_phase="wait-for-approval"
IFS= read -r answer || ksa_die "input ended before approval"
case "$answer" in
  y|Y|yes|YES|Yes) ;;
  *)
    printf 'No signature was made. No action was run.\n'
    action_phase="approval-declined"
    action_outcome="cancelled"
    exit 0
    ;;
esac

action_phase="sign-intent"
"$SCRIPT_DIR/sign-secret-authority-intent" \
  --purpose private-instance \
  --intent "$intent_file"
if [ ! -f "$intent_file.sig" ] || [ -L "$intent_file.sig" ]; then
  ksa_die "Touch ID signature file is missing"
fi

remote_directory="/home/smith/private/klokast/bootstrap-approvals"
remote_intent="$remote_directory/$action.$intent_nonce.intent.json"
remote_signature="$remote_intent.sig"

action_phase="upload-approval"
tailscale ssh "$SSH_TARGET" sh -s -- "$remote_directory" <<'SH'
set -eu
directory=$1
[ "$directory" = /home/smith/private/klokast/bootstrap-approvals ] || exit 2
install -d -m 0700 "$directory"
SH

# These paths contain only fixed text, a closed action name, and a validated
# nonce. The files contain no secret material.
tailscale ssh "$SSH_TARGET" \
  "umask 077; cat > '$remote_intent'" <"$intent_file"
tailscale ssh "$SSH_TARGET" \
  "umask 077; cat > '$remote_signature'" <"$intent_file.sig"

printf '\nController action result\n'
action_phase="run-controller-action"
tailscale ssh "$SSH_TARGET" sh -s -- \
  "$ENGINE_COMMIT" "$INSTANCE_OWNER" "$INSTANCE_REPO" "$action" \
  "$action_fingerprint" "$SIGNER_ID" "$remote_intent" \
  "$remote_signature" <<'SH'
set -eu
expected=$1
owner=$2
repo=$3
action=$4
fingerprint=$5
signer=$6
intent=$7
signature=$8
cleanup() {
  rm -f "$intent" "$signature"
}
trap cleanup EXIT HUP INT TERM
cd "$HOME/src/klokast/klokast-box"
/usr/local/sbin/klokast-controller-guard --status --json --require-active >/dev/null
test "$(git rev-parse HEAD)" = "$expected"
test -z "$(git status --porcelain)"
case "$action" in
  register-repository)
    ansible/bin/secret-authority instance register-repository \
      --repo-owner "$owner" --repo-name "$repo" \
      --approval-intent "$intent" --approval-signature "$signature" \
      --signer-id "$signer"
    ;;
  register-read-key|retire-bootstrap)
    ansible/bin/secret-authority instance "$action" \
      --repo-owner "$owner" --repo-name "$repo" \
      --key-fingerprint "$fingerprint" \
      --approval-intent "$intent" --approval-signature "$signature" \
      --signer-id "$signer"
    ;;
  *) exit 2 ;;
esac
SH

remote_intent=""
remote_signature=""
printf '\nRedacted controller status\n'
action_phase="read-final-status"
tailscale ssh "$SSH_TARGET" sh -s <<'SH'
set -eu
cd "$HOME/src/klokast/klokast-box"
ansible/bin/secret-authority instance status --redacted
SH

case "$action" in
  register-repository)
    printf '\nRepository registration is complete. Next run:\n'
    printf '  klokast-dev/bin/run-private-instance-action register-read-key\n'
    ;;
  register-read-key)
    printf '\nRead-only controller access is complete. Continue with Step 9 of the runbook.\n'
    ;;
  retire-bootstrap)
    printf '\nTemporary bootstrap authority is retired. Continue with Step 13 of the runbook.\n'
    ;;
esac
action_phase="complete"
action_outcome="success"
