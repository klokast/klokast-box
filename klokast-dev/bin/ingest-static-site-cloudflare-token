#!/usr/bin/env python3
"""Send a Cloudflare Tunnel token on stdin to the active controller broker."""
import argparse
import getpass
import re
import subprocess
from pathlib import Path

parser = argparse.ArgumentParser(description=__doc__)
parser.add_argument('--controller', required=True)
parser.add_argument('--box', required=True)
parser.add_argument('--domain', default='www.klokast.ai')
args = parser.parse_args()
if not re.fullmatch(r'[a-z0-9][a-z0-9-]{0,62}-ops', args.controller): parser.error('controller must be a box ops hostname')
if not re.fullmatch(r'[a-z0-9][a-z0-9-]{0,30}', args.box): parser.error('box must be a box ID')
if args.domain != 'www.klokast.ai': parser.error('adapter supports www.klokast.ai only')
token = getpass.getpass('Cloudflare Tunnel token: ')
command = ['tailscale', 'ssh', 'smith@' + args.controller, '/usr/bin/doas',
           '/usr/local/sbin/ksa-static-site', 'static-site', 'ingest-cloudflare-token',
           '--box', args.box, '--domain', args.domain]
raise SystemExit(subprocess.run(command, input=token + '\n', text=True, check=False).returncode)
