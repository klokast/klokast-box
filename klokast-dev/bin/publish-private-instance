#!/usr/bin/env python3
"""Validate and publish Instance edits with ordinary Git."""
import argparse
from pathlib import Path
import subprocess

parser = argparse.ArgumentParser(description=__doc__)
parser.add_argument('--worktree', type=Path, required=True)
parser.add_argument('--publish', action='store_true', help='commit and push the validated Instance edit')
parser.add_argument('--message', default='Update Instance desired state')
args = parser.parse_args()
root = args.worktree.resolve()
if not (root / '.git').is_dir(): parser.error('worktree must be a standalone Git repository')
subprocess.run(['klokast', 'check', '--instance', str(root)], check=True)
subprocess.run(['git', '-C', str(root), 'diff', '--', 'klokast-instance.json'], check=True)
if args.publish:
    subprocess.run(['git', '-C', str(root), 'add', '--', 'klokast-instance.json'], check=True)
    subprocess.run(['git', '-C', str(root), 'commit', '-m', args.message], check=True)
    subprocess.run(['git', '-C', str(root), 'push'], check=True)
