#!/usr/bin/env bash
set -euo pipefail

PYYAML_VERSION="6.0.3"

usage() {
  cat <<'EOF'
Usage:
  kk [--instance PATH] APPLICATION COMMAND [ARGUMENTS...]
  kk platform [--help]
  kk doctor [--install]
  kk --help

PATH is a private Instance worktree. Set KLOKAST_INSTANCE to use it by default.
Application names come from Instance. Each application owns its client commands.
Use platform --help for the future human Platform interface.
Use doctor to check MacBook prerequisites.
Use doctor --install to install supported missing MacBook prerequisites.
EOF
}

die() {
  printf 'kk: %s\n' "$*" >&2
  exit 2
}

need_command() {
  command -v "$1" >/dev/null 2>&1 || die "$1 not found"
}

platform_interface() {
  if [ "$#" -eq 0 ] || { [ "$#" -eq 1 ] && { [ "$1" = -h ] || [ "$1" = --help ]; }; }; then
    cat <<'EOF'
Usage: kk platform [--help]

Human command interface for the production Platform.

Future use cases:
  - Install or remove an application.
  - Authorize a production Platform update.
  - Add or retire a box.
  - Add or remove hardware, such as an audio interface,
    voice controller, Wi-Fi access point, NAS, or AI inference box.

These operations and human authentication are not implemented yet.
EOF
    return
  fi
  die "platform commands are not implemented yet; use 'kk platform --help'"
}

supported_bash_version() {
  [[ "$1" =~ ^[0-9]+\.[0-9]+$ ]] || return 1
  local major="${1%%.*}"
  local minor="${1#*.}"
  [ "$major" -gt 5 ] || { [ "$major" -eq 5 ] && [ "$minor" -ge 2 ]; }
}

check_macbook_bash() {
  local install_missing="$1"
  local bash_prefix=""
  local selected_bash=""
  local bash_version=""

  if ! command -v brew >/dev/null 2>&1; then
    printf 'missing: Homebrew. Install it from https://brew.sh/, then run kk doctor --install.\n' >&2
    return 1
  fi
  bash_prefix="$(brew --prefix bash)" || {
    printf 'missing: cannot resolve the Homebrew Bash prefix.\n' >&2
    return 1
  }
  if [ "$install_missing" = true ]; then
    if [ ! -x "$bash_prefix/bin/bash" ]; then
      printf 'Installing Homebrew Bash...\n'
      brew install bash || {
        printf 'missing: Homebrew Bash installation failed.\n' >&2
        return 1
      }
    else
      bash_version="$("$bash_prefix/bin/bash" -c 'printf "%s.%s\n" "${BASH_VERSINFO[0]}" "${BASH_VERSINFO[1]}"')" || bash_version=""
      if ! supported_bash_version "$bash_version"; then
        printf 'Upgrading Homebrew Bash to meet the required version...\n'
        brew upgrade bash || {
          printf 'missing: Homebrew Bash upgrade failed.\n' >&2
          return 1
        }
      fi
    fi
    hash -r
  fi
  if [ ! -x "$bash_prefix/bin/bash" ]; then
    printf 'missing: Homebrew Bash. Run kk doctor --install.\n' >&2
    return 1
  fi
  selected_bash="$(command -v bash)" || {
    printf 'missing: bash is not in PATH. Put Homebrew bin before /usr/bin and /bin.\n' >&2
    return 1
  }
  if [ ! "$selected_bash" -ef "$bash_prefix/bin/bash" ]; then
    printf 'missing: PATH selects %s instead of Homebrew Bash at %s/bin/bash. Put Homebrew bin before /usr/bin and /bin, then rerun kk doctor.\n' "$selected_bash" "$bash_prefix" >&2
    return 1
  fi
  bash_version="$("$selected_bash" -c 'printf "%s.%s\n" "${BASH_VERSINFO[0]}" "${BASH_VERSINFO[1]}"')" || {
    printf 'missing: cannot run the selected Homebrew Bash.\n' >&2
    return 1
  }
  if ! supported_bash_version "$bash_version"; then
    printf 'missing: Homebrew Bash 5.2 or newer is required; selected version is %s. Run brew upgrade bash, then rerun kk doctor.\n' "$bash_version" >&2
    return 1
  fi
  printf 'ok: Homebrew Bash %s selected at %s\n' "$bash_version" "$selected_bash"
}

print_macbook_dependency_inventory() {
  cat <<'EOF'

Direct MacBook software dependencies (declared acquisition classes):
- macOS base utilities | Apple-provided | Run file operations, archives, and proxy checks.
- Bash | Homebrew package | Run MacBook Bash scripts with version 5.2 or newer.
- Git | Apple Command Line Tools | Synchronize checkouts and publish private-instance repositories.
- Apple OpenSSH and CryptoTokenKit | Apple-provided | Provide SSH transport and Touch ID approval signatures.
- rsync | Apple-provided | Upload music libraries.
- Tailscale | Standalone vendor .pkg | Provide Tailnet access and dispatch commands to the controller.
- Homebrew | Official Homebrew installer | Install Bash and Python during MacBook setup.
- Python 3 | Homebrew package | Process JSON and configuration data in MacBook helpers.
- PyYAML | PyPI binary wheel | Parse controller HA and private-instance YAML.
EOF
}

doctor() {
  local install_missing=false
  local missing=false
  local sc_auth_help=""
  local ssh_keygen_help=""
  local ssh_add_help=""
  local pip_args=()

  while [ "$#" -gt 0 ]; do
    case "$1" in
      --install)
        install_missing=true
        shift
        ;;
      -h|--help)
        usage
        exit 0
        ;;
      *)
        die "unknown doctor argument: $1"
        ;;
    esac
  done

  printf 'Checking MacBook/client prerequisites...\n'

  if [ "$(uname -s)" = "Darwin" ]; then
    check_macbook_bash "$install_missing" || missing=true
  fi

  if command -v tailscale >/dev/null 2>&1; then
    printf 'ok: tailscale CLI found\n'
  else
    printf 'missing: tailscale CLI. Install Tailscale using the official macOS .pkg, not Homebrew or App Store.\n' >&2
    missing=true
  fi

  if command -v ssh >/dev/null 2>&1; then
    printf 'ok: ssh found\n'
  else
    printf 'missing: ssh\n' >&2
    missing=true
  fi

  if command -v rsync >/dev/null 2>&1; then
    printf 'ok: rsync found\n'
  else
    printf 'missing: rsync\n' >&2
    missing=true
  fi

  if command -v python3 >/dev/null 2>&1; then
    printf 'ok: python3 found\n'
  elif [ "$(uname -s)" = "Darwin" ] && [ "$install_missing" = true ]; then
    need_command brew
    printf 'Installing Python for JSON-handling operator wrappers...\n'
    brew install python
    command -v python3 >/dev/null 2>&1 || die "brew install python completed, but python3 was not found"
    printf 'ok: python3 found\n'
  else
    printf 'missing: python3\n' >&2
    missing=true
  fi

  if command -v python3 >/dev/null 2>&1 && \
      python3 -c 'import yaml' >/dev/null 2>&1; then
    printf 'ok: Python PyYAML module found\n'
  elif [ "$(uname -s)" = "Darwin" ] && [ "$install_missing" = true ]; then
    need_command brew
    if ! python3 -m pip --version >/dev/null 2>&1; then
      printf 'Installing Homebrew Python for the PyYAML module...\n'
      brew install python
      hash -r
    fi
    pip_args=(
      install
      --user
      --disable-pip-version-check
      --only-binary=:all:
    )
    if python3 - <<'PY'
import pathlib
import sysconfig
raise SystemExit(0 if (pathlib.Path(sysconfig.get_path("stdlib")) / "EXTERNALLY-MANAGED").exists() else 1)
PY
    then
      pip_args+=(--break-system-packages)
    fi
    printf 'Installing PyYAML %s for controller HA helpers...\n' "$PYYAML_VERSION"
    python3 -m pip "${pip_args[@]}" "PyYAML==$PYYAML_VERSION"
    python3 -c 'import yaml' >/dev/null 2>&1 || \
      die "PyYAML installation completed, but the yaml module is not importable"
    printf 'ok: Python PyYAML module found\n'
  else
    printf 'missing: Python PyYAML module. Run klokast-dev/bin/kk doctor --install.\n' >&2
    missing=true
  fi

  if [ "$(uname -s)" = "Darwin" ]; then
    if [ -x /usr/sbin/sc_auth ]; then
      sc_auth_help="$(/usr/sbin/sc_auth 2>&1 || true)"
      if printf '%s\n' "$sc_auth_help" | grep -q 'create-ctk-identity' && \
          printf '%s\n' "$sc_auth_help" | grep -q 'list-ctk-identities'; then
        printf 'ok: Apple CryptoTokenKit identity commands found\n'
      else
        printf 'missing: this macOS release does not provide the required sc_auth CTK identity commands.\n' >&2
        missing=true
      fi
    else
      printf 'missing: /usr/sbin/sc_auth\n' >&2
      missing=true
    fi

    if [ -x /usr/bin/ssh-keygen ]; then
      ssh_keygen_help="$(/usr/bin/ssh-keygen -? 2>&1 || true)"
      if printf '%s\n' "$ssh_keygen_help" | grep -q -- '-Y' && \
          printf '%s\n' "$ssh_keygen_help" | grep -q -- '-w'; then
        printf 'ok: Apple OpenSSH supports file signing and providers\n'
      else
        printf 'missing: Apple ssh-keygen does not provide -Y and -w support.\n' >&2
        missing=true
      fi
    else
      printf 'missing: /usr/bin/ssh-keygen\n' >&2
      missing=true
    fi

    if [ -x /usr/bin/ssh-agent ] && [ -x /usr/bin/ssh-add ]; then
      ssh_add_help="$(/usr/bin/ssh-add -? 2>&1 || true)"
      if printf '%s\n' "$ssh_add_help" | grep -Eq -- '(-K|\[[^]]*K[^]]*\])' && \
          printf '%s\n' "$ssh_add_help" | grep -q -- '-S'; then
        printf 'ok: Apple OpenSSH supports a short-lived resident-key agent\n'
      else
        printf 'missing: Apple ssh-add does not provide -K and -S support.\n' >&2
        missing=true
      fi
    else
      printf 'missing: Apple /usr/bin/ssh-agent or /usr/bin/ssh-add\n' >&2
      missing=true
    fi

    if [ -f /usr/lib/ssh-keychain.dylib ]; then
      printf 'ok: Apple CryptoTokenKit OpenSSH provider found\n'
    else
      printf 'missing: /usr/lib/ssh-keychain.dylib\n' >&2
      missing=true
    fi
  elif command -v ssh-keygen >/dev/null 2>&1; then
    printf 'ok: ssh-keygen found\n'
  else
    printf 'missing: ssh-keygen\n' >&2
    missing=true
  fi

  if [ "$missing" = true ]; then
    exit 2
  fi
  print_macbook_dependency_inventory
  printf 'kk doctor ok\n'
}

dispatch_client() {
  local instance="$1"
  shift
  local repo_root=""
  repo_root="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/../.." && pwd -P)"
  need_command python3
  # -c keeps standard input available to the application client.
  exec python3 -c '
import json
import os
from pathlib import Path
import re
import sys

def fail(message):
    print("kk: " + message, file=sys.stderr)
    raise SystemExit(2)

def unique_fields(pairs):
    result = {}
    for key, value in pairs:
        if key in result:
            raise ValueError("duplicate JSON field: " + repr(key))
        result[key] = value
    return result

def invalid_constant(value):
    raise ValueError("invalid JSON constant: " + value)

repo, worktree, app, *arguments = sys.argv[1:]
id_pattern = r"[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?"
if not re.fullmatch(id_pattern, app):
    fail("invalid application name; use an exact Instance application ID")
if not worktree:
    fail("select a private Instance worktree with --instance PATH or KLOKAST_INSTANCE")
try:
    root = Path(worktree).expanduser().resolve()
    instance = json.loads((root / "klokast-instance.json").read_text(encoding="utf-8"),
                          object_pairs_hook=unique_fields, parse_constant=invalid_constant)
except (OSError, ValueError, RuntimeError) as error:
    fail("cannot read Instance: " + str(error))
if not isinstance(instance, dict):
    fail("Instance must be a JSON object")
version = instance.get("schema-version")
if type(version) is not int or version != 1:
    fail("Instance schema-version must be 1")
apps = instance.get("apps")
if not isinstance(apps, dict):
    fail("Instance apps must be an object")
for name, binding in apps.items():
    if name in ("platform", "doctor"):
        fail(f"application name {name} is reserved for kk {name}")
    if not re.fullmatch(id_pattern, name) or not isinstance(binding, dict):
        fail("Instance contains an invalid application binding")
    if binding.get("desired-state") not in ("present", "absent"):
        fail("Instance application desired-state must be present or absent")
inactive_apps = instance.get("inactive-apps")
if isinstance(inactive_apps, dict):
    for name in ("platform", "doctor"):
        if name in inactive_apps:
            fail(f"application name {name} is reserved for kk {name}")
if app not in apps:
    fail("application is not declared in Instance: " + app)
if apps[app]["desired-state"] != "present":
    fail("application is declared absent in Instance: " + app)
tailnet = instance.get("tailscale")
suffix = tailnet.get("tailnet-dns-name") if isinstance(tailnet, dict) else None
if not isinstance(suffix, str) or not re.fullmatch(r"[a-z0-9](?:[a-z0-9-]*\.)+ts\.net", suffix):
    fail("Instance tailscale.tailnet-dns-name must be a Tailnet DNS name")
app_root = Path(repo) / "apps" / app
client = app_root / "bin" / (app + "-client")
if not client.is_file():
    fail("client interface unavailable for application: " + app)
if not client.resolve().is_relative_to(app_root.resolve()):
    fail("application client must be inside its application directory: " + app)
if not os.access(client, os.X_OK):
    fail("application client is not executable: " + app)
os.environ["KLOKAST_INSTANCE"] = str(root)
os.environ["KLOKAST_TAILNET_SUFFIX"] = suffix
try:
    os.execv(str(client), [str(client), *arguments])
except OSError as error:
    fail("cannot execute application client: " + str(error))
' "$repo_root" "$instance" "$@"
}

main() {
  local instance="${KLOKAST_INSTANCE:-}"
  while [ "$#" -gt 0 ]; do
    case "$1" in
      --instance)
        [ "$#" -ge 2 ] || die "--instance needs a worktree path"
        [ -n "$2" ] || die "--instance needs a worktree path"
        instance="$2"
        shift 2
        ;;
      -h|--help) usage; return ;;
      --*) die "unknown wrapper option: $1" ;;
      *) break ;;
    esac
  done
  case "${1:-}" in
    platform) shift; platform_interface "$@" ;;
    doctor) shift; doctor "$@" ;;
    "") usage; exit 2 ;;
    *) dispatch_client "$instance" "$@" ;;
  esac
}

main "$@"
