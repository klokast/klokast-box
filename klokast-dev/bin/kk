#!/usr/bin/env bash
set -euo pipefail

PYYAML_VERSION="6.0.3"

usage() {
  cat <<'EOF'
Usage:
  kk doctor [--install]

Check MacBook prerequisites. Use --install to install supported missing tools.
EOF
}

die() {
  printf 'kk: %s\n' "$*" >&2
  exit 2
}

need_command() {
  command -v "$1" >/dev/null 2>&1 || die "$1 not found"
}

print_macbook_dependency_inventory() {
  cat <<'EOF'

Direct MacBook software dependencies (declared acquisition classes):
- macOS shell and base utilities | Apple-provided | Run local wrappers, file operations, archives, and proxy checks.
- Git | Apple Command Line Tools | Synchronize checkouts and publish private-instance repositories.
- Apple OpenSSH and CryptoTokenKit | Apple-provided | Provide SSH transport and Touch ID approval signatures.
- rsync | Apple-provided | Upload music libraries.
- Tailscale | Standalone vendor .pkg | Provide Tailnet access and dispatch commands to the controller.
- Homebrew | Official Homebrew installer | Install Python during MacBook setup.
- Python 3 | Homebrew package | Process JSON and configuration data in MacBook helpers.
- PyYAML | PyPI binary wheel | Parse controller HA and private-instance YAML.
EOF
}

doctor() {
  local install_missing=false
  local missing=false
  local sc_auth_help=""
  local ssh_keygen_help=""
  local ssh_add_help=""
  local pip_args=()

  while [ "$#" -gt 0 ]; do
    case "$1" in
      --install)
        install_missing=true
        shift
        ;;
      -h|--help)
        usage
        exit 0
        ;;
      *)
        die "unknown doctor argument: $1"
        ;;
    esac
  done

  printf 'Checking MacBook/client prerequisites...\n'

  if command -v tailscale >/dev/null 2>&1; then
    printf 'ok: tailscale CLI found\n'
  else
    printf 'missing: tailscale CLI. Install Tailscale using the official macOS .pkg, not Homebrew or App Store.\n' >&2
    missing=true
  fi

  if command -v ssh >/dev/null 2>&1; then
    printf 'ok: ssh found\n'
  else
    printf 'missing: ssh\n' >&2
    missing=true
  fi

  if command -v rsync >/dev/null 2>&1; then
    printf 'ok: rsync found\n'
  else
    printf 'missing: rsync\n' >&2
    missing=true
  fi

  if command -v python3 >/dev/null 2>&1; then
    printf 'ok: python3 found\n'
  elif [ "$(uname -s)" = "Darwin" ] && [ "$install_missing" = true ]; then
    need_command brew
    printf 'Installing Python for JSON-handling operator wrappers...\n'
    brew install python
    command -v python3 >/dev/null 2>&1 || die "brew install python completed, but python3 was not found"
    printf 'ok: python3 found\n'
  else
    printf 'missing: python3\n' >&2
    missing=true
  fi

  if command -v python3 >/dev/null 2>&1 && \
      python3 -c 'import yaml' >/dev/null 2>&1; then
    printf 'ok: Python PyYAML module found\n'
  elif [ "$(uname -s)" = "Darwin" ] && [ "$install_missing" = true ]; then
    need_command brew
    if ! python3 -m pip --version >/dev/null 2>&1; then
      printf 'Installing Homebrew Python for the PyYAML module...\n'
      brew install python
      hash -r
    fi
    pip_args=(
      install
      --user
      --disable-pip-version-check
      --only-binary=:all:
    )
    if python3 - <<'PY'
import pathlib
import sysconfig
raise SystemExit(0 if (pathlib.Path(sysconfig.get_path("stdlib")) / "EXTERNALLY-MANAGED").exists() else 1)
PY
    then
      pip_args+=(--break-system-packages)
    fi
    printf 'Installing PyYAML %s for controller HA helpers...\n' "$PYYAML_VERSION"
    python3 -m pip "${pip_args[@]}" "PyYAML==$PYYAML_VERSION"
    python3 -c 'import yaml' >/dev/null 2>&1 || \
      die "PyYAML installation completed, but the yaml module is not importable"
    printf 'ok: Python PyYAML module found\n'
  else
    printf 'missing: Python PyYAML module. Run klokast-dev/bin/kk doctor --install.\n' >&2
    missing=true
  fi

  if [ "$(uname -s)" = "Darwin" ]; then
    if [ -x /usr/sbin/sc_auth ]; then
      sc_auth_help="$(/usr/sbin/sc_auth 2>&1 || true)"
      if printf '%s\n' "$sc_auth_help" | grep -q 'create-ctk-identity' && \
          printf '%s\n' "$sc_auth_help" | grep -q 'list-ctk-identities'; then
        printf 'ok: Apple CryptoTokenKit identity commands found\n'
      else
        printf 'missing: this macOS release does not provide the required sc_auth CTK identity commands.\n' >&2
        missing=true
      fi
    else
      printf 'missing: /usr/sbin/sc_auth\n' >&2
      missing=true
    fi

    if [ -x /usr/bin/ssh-keygen ]; then
      ssh_keygen_help="$(/usr/bin/ssh-keygen -? 2>&1 || true)"
      if printf '%s\n' "$ssh_keygen_help" | grep -q -- '-Y' && \
          printf '%s\n' "$ssh_keygen_help" | grep -q -- '-w'; then
        printf 'ok: Apple OpenSSH supports file signing and providers\n'
      else
        printf 'missing: Apple ssh-keygen does not provide -Y and -w support.\n' >&2
        missing=true
      fi
    else
      printf 'missing: /usr/bin/ssh-keygen\n' >&2
      missing=true
    fi

    if [ -x /usr/bin/ssh-agent ] && [ -x /usr/bin/ssh-add ]; then
      ssh_add_help="$(/usr/bin/ssh-add -? 2>&1 || true)"
      if printf '%s\n' "$ssh_add_help" | grep -Eq -- '(-K|\[[^]]*K[^]]*\])' && \
          printf '%s\n' "$ssh_add_help" | grep -q -- '-S'; then
        printf 'ok: Apple OpenSSH supports a short-lived resident-key agent\n'
      else
        printf 'missing: Apple ssh-add does not provide -K and -S support.\n' >&2
        missing=true
      fi
    else
      printf 'missing: Apple /usr/bin/ssh-agent or /usr/bin/ssh-add\n' >&2
      missing=true
    fi

    if [ -f /usr/lib/ssh-keychain.dylib ]; then
      printf 'ok: Apple CryptoTokenKit OpenSSH provider found\n'
    else
      printf 'missing: /usr/lib/ssh-keychain.dylib\n' >&2
      missing=true
    fi
  elif command -v ssh-keygen >/dev/null 2>&1; then
    printf 'ok: ssh-keygen found\n'
  else
    printf 'missing: ssh-keygen\n' >&2
    missing=true
  fi

  if [ "$missing" = true ]; then
    exit 2
  fi
  print_macbook_dependency_inventory
  printf 'kk doctor ok\n'
}

main() {
  case "${1:-}" in
    doctor) shift; doctor "$@" ;;
    -h|--help) usage ;;
    "") usage; exit 2 ;;
    *) die "kk supports doctor only; see application instructions for client commands" ;;
  esac
}

main "$@"
