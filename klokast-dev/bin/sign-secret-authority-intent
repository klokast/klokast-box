#!/usr/bin/env bash
set -euo pipefail

KSA_TOOL_NAME="sign-secret-authority-intent"
SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd -P)"
. "$SCRIPT_DIR/../lib/approval-common.sh"

SIGNATURE_NAMESPACE="klokast-secret-authority"

usage() {
  cat <<EOF
Usage: $0 --purpose private-instance|static-site|platform-apply --intent FILE [--controller HOST]

Signs one existing Secret Authority intent with the exact purpose-specific
Apple CryptoTokenKit identity. A private, short-lived Apple ssh-agent selects
the identity by fingerprint and stops when signing finishes.
When --controller selects development approval mode, the active controller
signs with its temporary scoped development key instead.
EOF
}

purpose=""
intent=""
controller=""
while [ "$#" -gt 0 ]; do
  case "$1" in
    --purpose)
      [ "$#" -ge 2 ] || ksa_die "--purpose needs private-instance, static-site, or platform-apply"
      purpose="$2"
      shift 2
      ;;
    --intent)
      [ "$#" -ge 2 ] || ksa_die "--intent needs a file"
      intent="$2"
      shift 2
      ;;
    --controller)
      [ "$#" -ge 2 ] || ksa_die "--controller needs a host"
      controller="$2"
      shift 2
      ;;
    -h|--help)
      usage
      exit 0
      ;;
    *)
      ksa_die "unknown argument: $1"
      ;;
  esac
done

case "$purpose" in
  private-instance|static-site) SIGNATURE_NAMESPACE="klokast-secret-authority" ;;
  platform-apply) SIGNATURE_NAMESPACE="klokast-platform-apply" ;;
  *) ksa_die "--purpose private-instance, static-site, or platform-apply is required" ;;
esac
[ -n "$intent" ] || ksa_die "--intent FILE is required"
if [ ! -f "$intent" ] || [ -L "$intent" ]; then
  ksa_die "intent must be a regular, non-symlink file: $intent"
fi
if [ ! -t 0 ] || [ ! -t 1 ]; then
  ksa_die "run this command in an interactive terminal on the trusted MacBook"
fi

ksa_need_command mktemp
if [ -n "$controller" ]; then
  ksa_valid_controller "$controller" || ksa_die "controller hostname is invalid"
  ksa_need_command tailscale
  umask 077
  transport_dir="$(mktemp -d "${TMPDIR:-/tmp}/klokast-sign.XXXXXXXX")"
  trap 'rm -f "$transport_dir/mode" "$transport_dir/remote-dir"; rmdir "$transport_dir"' EXIT
  trap 'exit 130' HUP INT TERM
  tailscale ssh "smith@$controller" sh -s >"$transport_dir/mode" <<'SH' || \
    ksa_die "cannot read the controller approval mode"
set -eu
if [ -r /etc/klokast/human-approval-mode ]; then
  cat /etc/klokast/human-approval-mode
else
  printf 'signed\n'
fi
SH
  mode="$(cat "$transport_dir/mode")"
  case "$mode" in
    development)
      [ ! -e "$intent.sig" ] && [ ! -L "$intent.sig" ] || ksa_die "signature output already exists"
      tailscale ssh "smith@$controller" sh -s >"$transport_dir/remote-dir" <<'SH' || \
        ksa_die "cannot create a private development signing directory"
set -eu
umask 077
mktemp -d "$HOME/private/klokast/development-approvals/request.XXXXXXXX"
SH
      remote_dir="$(cat "$transport_dir/remote-dir")"
      case "$remote_dir" in
        /home/smith/private/klokast/development-approvals/request.*)
          suffix="${remote_dir##*/request.}"
          case "$suffix" in ''|*[!A-Za-z0-9]*) ksa_die "controller returned an unsafe development signing path" ;; esac
          ;;
        *) ksa_die "controller returned an unsafe development signing path" ;;
      esac
      temporary_signature=""
      cleanup_development_signing() {
        rm -f "$transport_dir/mode" "$transport_dir/remote-dir"
        rmdir "$transport_dir"
        if [ -n "$temporary_signature" ]; then
          rm -f -- "$temporary_signature"
        fi
        tailscale ssh "smith@$controller" sh -s -- "$remote_dir" <<'SH' >/dev/null 2>&1 || true
set -eu
rm -f "$1/intent.json" "$1/intent.json.sig"
rmdir "$1"
SH
      }
      trap cleanup_development_signing EXIT
      trap 'exit 130' HUP INT TERM
      tailscale ssh "smith@$controller" "umask 077; cat > '$remote_dir/intent.json'" < "$intent" || \
        ksa_die "cannot send the prepared intent to the development signer"
      tailscale ssh "smith@$controller" sh -s -- "$purpose" "$remote_dir" <<'SH' || \
        ksa_die "development signing failed on the active controller"
set -eu
cd "$HOME/src/klokast/klokast-box"
ansible/bin/development-sign-intent --purpose "$1" --intent "$2/intent.json" --signature "$2/intent.json.sig" >/dev/null
SH
      umask 077
      temporary_signature="$(mktemp "${intent}.sig.XXXXXXXX")"
      tailscale ssh "smith@$controller" "cat '$remote_dir/intent.json.sig'" > "$temporary_signature" || \
        ksa_die "cannot read the development signature"
      [ -s "$temporary_signature" ] || ksa_die "development signature is empty"
      mv "$temporary_signature" "$intent.sig"
      temporary_signature=""
      printf 'Development signature written: %s.sig\n' "$intent"
      exit 0
      ;;
    signed)
      rm -f "$transport_dir/mode" "$transport_dir/remote-dir"
      rmdir "$transport_dir"
      trap - EXIT HUP INT TERM
      ;;
    *) ksa_die "controller approval mode is invalid" ;;
  esac
fi
ksa_require_native_touchid
ksa_load_touchid_profile "$purpose"
ksa_sign_touchid_message "$intent" || \
  ksa_die "Touch ID did not approve the ${purpose} intent signature"
printf 'Signature written: %s.sig\n' "$intent"
