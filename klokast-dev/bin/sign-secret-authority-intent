#!/usr/bin/env bash
set -euo pipefail

KSA_TOOL_NAME="sign-secret-authority-intent"
SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd -P)"
. "$SCRIPT_DIR/../lib/approval-common.sh"

SIGNATURE_NAMESPACE="klokast-secret-authority"

usage() {
  cat <<EOF
Usage: $0 --purpose private-instance|static-site --intent FILE

Signs one existing Secret Authority intent with the exact purpose-specific
Apple CryptoTokenKit identity. A private, short-lived Apple ssh-agent selects
the identity by fingerprint and stops when signing finishes.
EOF
}

purpose=""
intent=""
while [ "$#" -gt 0 ]; do
  case "$1" in
    --purpose)
      [ "$#" -ge 2 ] || ksa_die "--purpose needs private-instance or static-site"
      purpose="$2"
      shift 2
      ;;
    --intent)
      [ "$#" -ge 2 ] || ksa_die "--intent needs a file"
      intent="$2"
      shift 2
      ;;
    -h|--help)
      usage
      exit 0
      ;;
    *)
      ksa_die "unknown argument: $1"
      ;;
  esac
done

case "$purpose" in
  private-instance|static-site) ;;
  *) ksa_die "--purpose private-instance or --purpose static-site is required" ;;
esac
[ -n "$intent" ] || ksa_die "--intent FILE is required"
[ -f "$intent" ] && [ ! -L "$intent" ] || \
  ksa_die "intent must be a regular, non-symlink file: $intent"
if [ ! -t 0 ] || [ ! -t 1 ]; then
  ksa_die "run this command in an interactive terminal on the trusted MacBook"
fi

ksa_need_command mktemp
ksa_require_native_touchid
ksa_load_touchid_profile "$purpose"
ksa_sign_touchid_message "$intent" || \
  ksa_die "Touch ID did not approve the ${purpose} intent signature"
printf 'Signature written: %s.sig\n' "$intent"
