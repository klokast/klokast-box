#!/usr/bin/env python3
import argparse
import base64
import getpass
import json
import os
import re
import socket
import subprocess
import sys
from datetime import datetime, timezone
from pathlib import Path

import yaml


REPO_ROOT = Path(__file__).resolve().parents[2]
CONFIG_ENV = "KLOKAST_CONTROLLER_HA_CONFIG"
CONTROLLER_CONFIG = Path("/home/smith/private/klokast/controller-ha.yml")
MAC_CONFIG = Path.home() / ".config" / "klokast" / "controller-ha.yml"
FIXED_REMOTE_USER = "smith"
FIXED_REPO_DIR = "~/src/klokast/klokast-box"
GUARD = "/usr/local/sbin/klokast-controller-guard"
MARKER = "/etc/klokast/controller-ha.json"
PROVIDER_SECRET_PATHS = [
    "/etc/klokast/tailscale-policy.env",
    "/etc/klokast/tailscale-devices.env",
    "/etc/klokast/secret-authority/github-app.env",
    "/etc/klokast/secret-authority/github-app.pem",
    "/etc/klokast/secret-authority/apps/static-site/cloudflared-token",
    "/etc/klokast/secret-authority/instance-bootstrap/github-app.env",
    "/etc/klokast/secret-authority/instance-bootstrap/github-app.pem",
    "/etc/klokast/secret-authority/allowed-signers-private-instance",
    "/etc/klokast/secret-authority/allowed-signers-static-site",
    "/etc/klokast/private-instance/github-readonly",
]


def die(message):
    print(f"ops-controller-ha: {message}", file=sys.stderr)
    raise SystemExit(2)


def valid_box(value):
    return re.fullmatch(r"[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?", value or "") is not None


def load_config(path):
    try:
        with path.open(encoding="utf-8") as handle:
            data = yaml.safe_load(handle) or {}
    except (OSError, yaml.YAMLError) as error:
        die(f"cannot read controller HA config {path}: {error}")
    if not isinstance(data, dict):
        die("controller HA config root must be an object")
    allowed_root = {"schema_version", "remote_user", "repo_dir", "controllers"}
    unknown_root = sorted(set(data) - allowed_root)
    if unknown_root:
        die(f"controller HA config has unknown field: {unknown_root[0]}")
    if data.get("schema_version") != 1:
        die("controller HA config schema_version must be 1")
    if data.get("remote_user") != FIXED_REMOTE_USER:
        die(f"controller HA remote_user must be {FIXED_REMOTE_USER}")
    if data.get("repo_dir") != FIXED_REPO_DIR:
        die(f"controller HA repo_dir must be {FIXED_REPO_DIR}")
    controllers = data.get("controllers")
    if not isinstance(controllers, list) or not 1 <= len(controllers) <= 2:
        die("controller HA config must list one or two controllers")
    by_box = {}
    for item in controllers:
        if not isinstance(item, dict):
            die("each controller HA entry must be an object")
        unknown_entry = sorted(set(item) - {"box", "hostname"})
        if unknown_entry:
            die(f"controller HA entry has unknown field: {unknown_entry[0]}")
        box = str(item.get("box", ""))
        hostname = str(item.get("hostname", ""))
        if not valid_box(box):
            die(f"invalid controller box: {box}")
        if hostname != f"{box}-ops":
            die(f"controller hostname for {box} must be {box}-ops")
        if box in by_box:
            die(f"duplicate controller box: {box}")
        by_box[box] = {"box": box, "hostname": hostname}
    return {
        "remote_user": FIXED_REMOTE_USER,
        "remote_users": [FIXED_REMOTE_USER],
        "repo_dir": FIXED_REPO_DIR,
        "controllers": by_box,
    }


def resolve_config_path(explicit=None):
    if explicit is not None:
        return explicit.expanduser().resolve()
    configured = os.environ.get(CONFIG_ENV, "")
    if configured:
        return Path(configured).expanduser().resolve()
    if getpass.getuser() == "smith":
        return CONTROLLER_CONFIG
    if sys.platform == "darwin":
        return MAC_CONFIG
    die(
        "no controller HA config is available at this execution locus; "
        "use --config, set KLOKAST_CONTROLLER_HA_CONFIG, or name the controller explicitly"
    )


def target(config, box):
    controller = config["controllers"].get(box)
    if not controller:
        die(f"unknown controller box: {box}")
    return f"{config['remote_user']}@{controller['hostname']}"


def targets(config, box):
    controller = config["controllers"].get(box)
    if not controller:
        die(f"unknown controller box: {box}")
    return [f"{user}@{controller['hostname']}" for user in config.get("remote_users", [config["remote_user"]])]


def run(argv, *, stdin=None, capture=False, check=True):
    if capture:
        completed = subprocess.run(argv, input=stdin, text=True, stdout=subprocess.PIPE, stderr=subprocess.PIPE, check=False)
    else:
        completed = subprocess.run(argv, input=stdin, text=True, check=False)
    if check and completed.returncode != 0:
        if capture and completed.stderr:
            print(completed.stderr, file=sys.stderr, end="")
        raise SystemExit(completed.returncode)
    return completed


def remote_sh(ssh_target, script, args=None, *, capture=False, check=True):
    command = ["tailscale", "ssh", ssh_target, "sh", "-s", "--", *(args or [])]
    return run(command, stdin=script, capture=capture, check=check)


def local_sh(script, args=None, *, capture=False, check=True):
    return run(["sh", "-s", "--", *(args or [])], stdin=script, capture=capture, check=check)


def is_local_controller(config, box):
    hostname = config["controllers"][box]["hostname"]
    local = socket.gethostname()
    return hostname in {local, local.split(".", 1)[0]}


def controller_sh(config, box, script, args=None, *, capture=False, check=True):
    if is_local_controller(config, box):
        return local_sh(script, args, capture=capture, check=check)
    last = None
    for ssh_target in targets(config, box):
        completed = remote_sh(ssh_target, script, args, capture=capture, check=False)
        if completed.returncode == 0:
            return completed
        last = completed
    if check and last is not None:
        if capture and last.stderr:
            print(last.stderr, file=sys.stderr, end="")
        raise SystemExit(last.returncode)
    return last


def marker_json(box, role, active_box):
    now = datetime.now(timezone.utc).replace(microsecond=0).isoformat().replace("+00:00", "Z")
    return json.dumps(
        {
            "schema_version": 1,
            "box": box,
            "hostname": f"{box}-ops",
            "role": role,
            "active_box": active_box,
            "updated_at": now,
        },
        sort_keys=True,
        separators=(",", ":"),
    )


def set_marker(config, box, role, active_box):
    payload = marker_json(box, role, active_box)
    payload_b64 = base64.b64encode(payload.encode("utf-8")).decode("ascii")
    script = r'''
set -eu
payload_b64=$1
tmp=$(mktemp)
trap 'rm -f "$tmp"' EXIT HUP INT TERM
umask 077
printf '%s' "$payload_b64" | base64 -d > "$tmp"
printf '\n' >> "$tmp"
doas install -d -m 0755 -o root -g root /etc/klokast
doas install -m 0644 -o root -g root "$tmp" /etc/klokast/controller-ha.json
'''
    controller_sh(config, box, script, [payload_b64])


def controller_status(config, box):
    script = f'''
set -eu
if command -v {GUARD} >/dev/null 2>&1; then
  {GUARD} --status --json
else
  printf '{{"schema_version":1,"box":"%s","hostname":"%s","role":"missing-guard","active":false}}\\n' "$1" "$2"
fi
'''
    controller = config["controllers"][box]
    completed = controller_sh(
        config,
        box,
        script,
        [box, controller["hostname"]],
        capture=True,
        check=False,
    )
    if completed.returncode != 0:
        return {"box": box, "hostname": controller["hostname"], "reachable": False, "error": completed.stderr.strip()}
    try:
        data = json.loads(completed.stdout)
    except json.JSONDecodeError:
        data = {"box": box, "hostname": controller["hostname"], "reachable": True, "role": "invalid-status", "raw": completed.stdout}
    data.setdefault("box", box)
    data.setdefault("hostname", controller["hostname"])
    data["reachable"] = True
    data["provider_api_seeded"] = provider_seed_status(config, box)
    data["repository"] = repository_status(config, box)
    return data


def repository_status(config, box):
    script = r'''
set -u
repo_dir=$1
case "$repo_dir" in
  "~") repo_dir="$HOME" ;;
  "~/"*) repo_dir="$HOME/${repo_dir#~/}" ;;
esac
if [ ! -d "$repo_dir/.git" ]; then
  printf '{"available":false,"reason":"missing"}\n'
  exit 0
fi
cd "$repo_dir" || exit 1
origin=$(git remote get-url origin 2>/dev/null || :)
head=$(git rev-parse HEAD 2>/dev/null || :)
branch=$(git symbolic-ref --quiet --short HEAD 2>/dev/null || :)
if [ -z "$(git status --porcelain 2>/dev/null)" ]; then clean=true; else clean=false; fi
remote_head=
attempt=1
while [ "$attempt" -le 3 ]; do
  remote_head=$(timeout 12 git ls-remote origin refs/heads/main 2>/dev/null | cut -f1 || :)
  [ -z "$remote_head" ] || break
  attempt=$((attempt + 1))
done
if [ -n "$remote_head" ]; then reachable=true; else reachable=false; fi
python3 - "$origin" "$head" "$branch" "$clean" "$reachable" "$remote_head" <<'PY'
import json
import sys
origin, head, branch, clean, reachable, remote_head = sys.argv[1:]
print(json.dumps({
    "available": True,
    "origin": origin,
    "head": head,
    "branch": branch,
    "clean": clean == "true",
    "remote_reachable": reachable == "true",
    "remote_head": remote_head,
    "up_to_date": bool(remote_head) and head == remote_head,
}, sort_keys=True, separators=(",", ":")))
PY
'''
    completed = controller_sh(
        config,
        box,
        script,
        [config["repo_dir"]],
        capture=True,
        check=False,
    )
    if completed.returncode != 0:
        return {"available": False, "reason": "inspection-failed"}
    try:
        return json.loads(completed.stdout)
    except json.JSONDecodeError:
        return {"available": False, "reason": "invalid-status"}


def provider_seed_status(config, box):
    script = r'''
set -eu
for path in "$@"; do
  if [ -e "$path" ]; then
    printf '%s=present\n' "$path"
  else
    printf '%s=missing\n' "$path"
  fi
done
'''
    completed = controller_sh(config, box, script, PROVIDER_SECRET_PATHS, capture=True, check=False)
    if completed.returncode != 0:
        return {"available": False}
    result = {}
    for line in completed.stdout.splitlines():
        path, _, state = line.partition("=")
        result[path] = state
    return result


def print_status(config, json_output=False):
    statuses = [controller_status(config, box) for box in sorted(config["controllers"])]
    if json_output:
        print(json.dumps({"schema_version": 1, "controllers": statuses}, indent=2, sort_keys=True))
        return
    for item in statuses:
        reachable = "reachable" if item.get("reachable") else "unreachable"
        print(f"{item['hostname']}: {reachable} role={item.get('role', 'unknown')} active={item.get('active', False)}")


def resolve_active(config):
    active = []
    for box in sorted(config["controllers"]):
        status = controller_status(config, box)
        if status.get("reachable") and status.get("active"):
            active.append(box)
    if len(active) != 1:
        die(f"expected exactly one active controller, found {len(active)}")
    print(config["controllers"][active[0]]["hostname"])


def maybe_dry_run(command, dry_run):
    print(" ".join(subprocess.list2cmdline([arg]) for arg in command))
    if not dry_run:
        run(command)


def bootstrap_standby(config, args):
    if args.box == args.active:
        die("--box and --active must differ")
    command = [
        str(REPO_ROOT / "ansible" / "bin" / "provision-ops-vm"),
        "--box",
        args.box,
        "--standby",
    ]
    maybe_dry_run(command, args.dry_run_plan)
    if not args.dry_run_plan:
        set_marker(config, args.active, "active", args.active)
        set_marker(config, args.box, "standby", args.active)


def sync_state(config, args):
    source = target(config, args.from_box)
    destination = target(config, args.to_box)
    script = r'''
set -eu
src=$1
dst=$2
if [ "$src" = "$dst" ]; then
  echo "source and destination must differ" >&2
  exit 2
fi
echo "sync private platform state: $src -> $dst"
tar_script=$(mktemp)
trap 'rm -f "$tar_script"' EXIT HUP INT TERM
cat > "$tar_script" <<'SRC'
set -eu
doas /bin/sh -s <<'ROOT'
set --
for path in /home/smith/private/klokast/*; do
  [ -f "$path" ] || continue
  set -- "$@" "${path#/}"
done
for path in \
  home/smith/private/klokast/apps \
  home/smith/private/klokast/terraform \
  var/lib/klokast/approved-state \
  var/lib/klokast/secret-authority \
  var/log/klokast/secret-authority.jsonl \
  etc/klokast/secret-authority/allowed-signers \
  etc/klokast/secret-authority/allowed-signers-private-instance \
  etc/klokast/secret-authority/allowed-signers-static-site
do
  [ ! -e "/$path" ] || set -- "$@" "$path"
done
[ "$#" -gt 0 ] || exit 0
cd / && tar -cpf - "$@"
ROOT
SRC
src_host=${src#*@}
if [ "$(hostname)" = "$src_host" ]; then
  sh "$tar_script"
else
  tailscale ssh "$src" sh -s < "$tar_script"
fi | tailscale ssh "$dst" doas /bin/tar -C / -xpf -
tailscale ssh "$dst" doas /bin/rm -rf /home/smith/private/klokast/codex-archives /home/smith/private/klokast/artifacts
'''
    if args.dry_run_plan:
        print(f"tailscale ssh {source} tar ... | tailscale ssh {destination} tar ...")
        return
    run(["sh", "-s", "--", source, destination], stdin=script)


def promote(config, args):
    if args.new_active == args.old_active:
        die("--new-active and --old-active must differ")
    if not args.old_active_fenced:
        die("--old-active-fenced is required for manual controller promotion")
    if args.dry_run_plan:
        print(f"mark {args.new_active}-ops active and {args.old_active}-ops standby")
        return
    set_marker(config, args.new_active, "active", args.new_active)
    old_status = controller_status(config, args.old_active)
    if old_status.get("reachable"):
        set_marker(config, args.old_active, "standby", args.new_active)
    print("promotion marker update completed")
    print("reseed provider/API authority on the new active controller before provider mutations")


def switchover(config, args):
    if args.new_active == args.old_active:
        die("--new-active and --old-active must differ")
    old_status = controller_status(config, args.old_active)
    new_status = controller_status(config, args.new_active)
    if not old_status.get("reachable") or not new_status.get("reachable"):
        die("both controllers must be reachable for a planned switchover")
    if not old_status.get("active"):
        die(f"{args.old_active}-ops is not the active controller")
    if new_status.get("active") or new_status.get("role") != "standby":
        die(f"{args.new_active}-ops is not a standby controller")
    repository = new_status.get("repository") or {}
    if not repository.get("available") or not repository.get("clean"):
        die(f"{args.new_active}-ops repository must exist and be clean")
    if not repository.get("remote_reachable") or not repository.get("up_to_date"):
        die(f"{args.new_active}-ops repository must match its live upstream")
    if args.dry_run_plan:
        print(f"sync private platform state: {args.old_active}-ops -> {args.new_active}-ops")
        print(f"mark {args.old_active}-ops standby with active_box={args.new_active}")
        print(f"mark {args.new_active}-ops active")
        return
    sync_args = argparse.Namespace(
        from_box=args.old_active,
        to_box=args.new_active,
        dry_run_plan=False,
    )
    sync_state(config, sync_args)
    set_marker(config, args.old_active, "standby", args.new_active)
    old_after = controller_status(config, args.old_active)
    if old_after.get("active"):
        die("old controller still reports active after demotion")
    set_marker(config, args.new_active, "active", args.new_active)
    active = []
    for box in sorted(config["controllers"]):
        status = controller_status(config, box)
        if status.get("reachable") and status.get("active"):
            active.append(box)
    if active != [args.new_active]:
        die(f"switchover did not establish one active controller: {active}")
    print(f"switchover completed: {args.new_active}-ops is active")


def sanitize_standby(config, args):
    if not args.confirm:
        die("--confirm is required to remove standby credentials")
    standby = controller_status(config, args.box)
    active = controller_status(config, args.active)
    if not standby.get("reachable") or standby.get("active") or standby.get("role") != "standby":
        die(f"{args.box}-ops must be a reachable standby")
    if not active.get("reachable") or not active.get("active"):
        die(f"{args.active}-ops must be the reachable active controller")
    if standby.get("active_box") != args.active:
        die(f"{args.box}-ops does not name {args.active} as active")
    script = r'''
set -eu
doas rm -f \
  /home/smith/.ssh/github-klokast-box \
  /home/smith/.ssh/github-klokast-box.pub \
  /home/smith/.ssh/config \
  /etc/klokast/tailscale-policy.env \
  /etc/klokast/tailscale-devices.env \
  /etc/klokast/secret-authority/github-app.env \
  /etc/klokast/secret-authority/github-app.pem \
  /etc/klokast/secret-authority/apps/static-site/cloudflared-token \
  /etc/klokast/secret-authority/instance-bootstrap/github-app.env \
  /etc/klokast/secret-authority/instance-bootstrap/github-app.pem \
  /etc/klokast/secret-authority/allowed-signers \
  /etc/klokast/secret-authority/allowed-signers-private-instance \
  /etc/klokast/secret-authority/allowed-signers-static-site \
  /etc/klokast/private-instance/github-readonly
'''
    controller_sh(config, args.box, script)
    print(f"sanitized standby credentials on {args.box}-ops")


def demote(config, args):
    active = args.active
    if args.dry_run_plan:
        print(f"mark {args.box}-ops standby with active_box={active}")
        return
    set_marker(config, args.box, "standby", active)


def run_on_controller(config, args):
    controller_host = args.controller
    if controller_host == "auto":
        completed = subprocess.run(
            [sys.executable, __file__, "--config", str(args.config), "resolve-active"],
            text=True,
            stdout=subprocess.PIPE,
            check=True,
        )
        controller_host = completed.stdout.strip()
    ssh_target = f"{config['remote_user']}@{controller_host}"
    command = " ".join(subprocess.list2cmdline([arg]) for arg in args.remote_command)
    script = r'''
set -eu
repo_dir=$1
shift
case "$repo_dir" in
  "~") repo_dir="$HOME" ;;
  "~/"*) repo_dir="$HOME/${repo_dir#~/}" ;;
esac
cd "$repo_dir"
exec "$@"
'''
    if args.dry_run_plan:
        print(f"tailscale ssh {ssh_target} cd {config['repo_dir']} && {command}")
        return
    remote_sh(ssh_target, script, [config["repo_dir"], *args.remote_command])


def reseed(args):
    print(f"Reseed provider/API authority on {args.controller} from the MacBook:")
    print(f"  klokast-dev/bin/install-tailscale-oauth --controller {args.controller} --policy-env PATH --devices-env PATH")
    print(f"  klokast-dev/bin/install-secret-authority-approval-signer --controller {args.controller} --purpose private-instance")
    print(f"  klokast-dev/bin/install-secret-authority-approval-signer --controller {args.controller} --purpose static-site")
    print(f"  klokast-dev/bin/install-static-site-github-app --controller {args.controller} --pem PATH --app-id ID --installation-id ID")
    print(f"  klokast-dev/bin/ingest-static-site-cloudflare-token --controller {args.controller} --box BOX --domain DOMAIN")


def main(argv=None):
    parser = argparse.ArgumentParser(description="Manage active/passive Klokast ops controllers")
    parser.add_argument("--config", type=Path)
    subparsers = parser.add_subparsers(dest="command", required=True)

    status = subparsers.add_parser("status")
    status.add_argument("--json", action="store_true")

    subparsers.add_parser("resolve-active")

    subparsers.add_parser("validate-config")

    bootstrap = subparsers.add_parser("bootstrap-standby")
    bootstrap.add_argument("--box", required=True)
    bootstrap.add_argument("--active", default=None)
    bootstrap.add_argument("--dry-run-plan", action="store_true")

    sync = subparsers.add_parser("sync")
    sync.add_argument("--from", dest="from_box", required=True)
    sync.add_argument("--to", dest="to_box", required=True)
    sync.add_argument("--dry-run-plan", action="store_true")

    promote_parser = subparsers.add_parser("promote")
    promote_parser.add_argument("--new-active", required=True)
    promote_parser.add_argument("--old-active", required=True)
    promote_parser.add_argument("--old-active-fenced", action="store_true")
    promote_parser.add_argument("--dry-run-plan", action="store_true")

    switchover_parser = subparsers.add_parser("switchover")
    switchover_parser.add_argument("--new-active", required=True)
    switchover_parser.add_argument("--old-active", required=True)
    switchover_parser.add_argument("--dry-run-plan", action="store_true")

    sanitize_parser = subparsers.add_parser("sanitize-standby")
    sanitize_parser.add_argument("--box", required=True)
    sanitize_parser.add_argument("--active", required=True)
    sanitize_parser.add_argument("--confirm", action="store_true")

    demote_parser = subparsers.add_parser("demote")
    demote_parser.add_argument("--box", required=True)
    demote_parser.add_argument("--active", required=True)
    demote_parser.add_argument("--dry-run-plan", action="store_true")

    run_parser = subparsers.add_parser("run")
    run_parser.add_argument("--controller", default="auto")
    run_parser.add_argument("--dry-run-plan", action="store_true")
    run_parser.add_argument("remote_command", nargs=argparse.REMAINDER)

    reseed_parser = subparsers.add_parser("reseed")
    reseed_parser.add_argument("--controller", required=True)

    args = parser.parse_args(argv)
    args.config = resolve_config_path(args.config)
    config = load_config(args.config)
    if args.command == "status":
        print_status(config, args.json)
    elif args.command == "resolve-active":
        resolve_active(config)
    elif args.command == "validate-config":
        print(json.dumps({
            "schema_version": 1,
            "valid": True,
            "path": str(args.config),
            "controllers": [
                config["controllers"][box]["hostname"]
                for box in sorted(config["controllers"])
            ],
        }, sort_keys=True))
    elif args.command == "bootstrap-standby":
        bootstrap_standby(config, args)
    elif args.command == "sync":
        sync_state(config, args)
    elif args.command == "promote":
        promote(config, args)
    elif args.command == "switchover":
        switchover(config, args)
    elif args.command == "sanitize-standby":
        sanitize_standby(config, args)
    elif args.command == "demote":
        demote(config, args)
    elif args.command == "run":
        if args.remote_command and args.remote_command[0] == "--":
            args.remote_command = args.remote_command[1:]
        if not args.remote_command:
            die("run requires a command")
        run_on_controller(config, args)
    elif args.command == "reseed":
        reseed(args)
    else:
        die("unsupported command")


if __name__ == "__main__":
    main()
