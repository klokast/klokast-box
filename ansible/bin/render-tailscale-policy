#!/usr/bin/env python3
import argparse
import json
import os
import re
import tempfile
from pathlib import Path

import yaml


REPO_ROOT = Path(__file__).resolve().parents[2]
DEFAULT_TEMPLATE = REPO_ROOT / "klokast-ops" / "tailscale" / "policy.hujson.j2"
LOGIN_RE = re.compile(r"^[^@\s]+@[^@\s]+\.[^@\s]+$")
SUFFIX_RE = re.compile(r"^[a-z0-9](?:[a-z0-9-]*\.)+ts\.net$")


def die(message):
    raise SystemExit(f"render-tailscale-policy: {message}")


def load_deployment(path):
    try:
        data = yaml.safe_load(path.read_text(encoding="utf-8")) or {}
    except (OSError, yaml.YAMLError) as error:
        die(f"cannot read deployment config: {error}")
    if data.get("schema_version") != 1:
        die("deployment config must use schema_version: 1")
    unknown = sorted(set(data) - {"schema_version", "tailnet", "boxes"})
    if unknown:
        die(f"unsupported top-level field(s): {', '.join(unknown)}")
    tailnet = data.get("tailnet")
    if not isinstance(tailnet, dict):
        die("tailnet must be a mapping")
    suffix = tailnet.get("magicdns_suffix")
    if not isinstance(suffix, str) or not SUFFIX_RE.fullmatch(suffix):
        die("tailnet.magicdns_suffix must be a MagicDNS *.ts.net suffix")
    groups = tailnet.get("groups")
    if not isinstance(groups, dict):
        die("tailnet.groups must be a mapping")
    unknown_groups = sorted(set(groups) - {"operators", "family"})
    if unknown_groups:
        die(f"unsupported tailnet group(s): {', '.join(unknown_groups)}")
    normalized = {}
    for name in ("operators", "family"):
        members = groups.get(name)
        if not isinstance(members, list) or not members:
            die(f"tailnet.groups.{name} must be a non-empty list")
        if any(not isinstance(item, str) or not LOGIN_RE.fullmatch(item) for item in members):
            die(f"tailnet.groups.{name} contains an invalid login")
        normalized[name] = sorted(set(members))
    operator_test_login = next(
        (login for login in normalized["operators"] if login in normalized["family"]),
        None,
    )
    if operator_test_login is None:
        die("one operator must also be a family member for combined policy tests")
    boxes = data.get("boxes", {})
    if not isinstance(boxes, dict):
        die("boxes must be a mapping")
    return {
        "magicdns_suffix": suffix,
        "groups": normalized,
        "operator_test_login": operator_test_login,
        "boxes": boxes,
    }


def load_instance(path):
    try:
        data = json.loads(path.read_text(encoding="utf-8"))
    except (OSError, json.JSONDecodeError) as error:
        die(f"cannot read Instance Specification v1: {error}")
    if not isinstance(data, dict) or data.get("schema-version") != 1:
        die("instance must use schema-version 1")
    tailscale = data.get("tailscale")
    if not isinstance(tailscale, dict):
        die("instance tailscale must be an object")
    if set(tailscale) != {"tailnet-dns-name", "members"}:
        die("instance tailscale fields do not match the closed v1 policy input")
    suffix = tailscale.get("tailnet-dns-name")
    if not isinstance(suffix, str) or not SUFFIX_RE.fullmatch(suffix):
        die("tailscale.tailnet-dns-name must be a MagicDNS *.ts.net suffix")
    members = tailscale.get("members")
    if not isinstance(members, dict) or not members:
        die("tailscale.members must be a non-empty object")
    groups = {"operators": [], "family": []}
    for login, membership in members.items():
        if not isinstance(login, str) or not LOGIN_RE.fullmatch(login):
            die("tailscale.members contains an invalid login")
        if not isinstance(membership, dict) or set(membership) != {"roles"}:
            die("tailscale member fields do not match the closed v1 input")
        roles = membership.get("roles")
        if (
            not isinstance(roles, list)
            or not roles
            or any(role not in {"operator", "family"} for role in roles)
            or len(set(roles)) != len(roles)
        ):
            die("tailscale member roles must be unique operator or family values")
        if "operator" in roles:
            groups["operators"].append(login)
        if "family" in roles:
            groups["family"].append(login)
    if not groups["operators"] or not groups["family"]:
        die("instance must define non-empty operator and family groups")
    for name in groups:
        groups[name].sort()
    operator_test_login = next(
        (login for login in groups["operators"] if login in groups["family"]),
        None,
    )
    if operator_test_login is None:
        die("one operator must also be a family member for combined policy tests")
    return {
        "magicdns_suffix": suffix,
        "groups": groups,
        "operator_test_login": operator_test_login,
        "boxes": {},
    }


def render(template_path, deployment):
    try:
        content = template_path.read_text(encoding="utf-8")
    except OSError as error:
        die(f"cannot read policy template: {error}")
    replacements = {
        "{{ operators_json }}": (
            json.dumps(deployment["groups"]["operators"]),
            1,
        ),
        "{{ family_json }}": (json.dumps(deployment["groups"]["family"]), 1),
        "{{ operator_test_login_json }}": (
            json.dumps(deployment["operator_test_login"]),
            9,
        ),
    }
    for marker, (value, expected_count) in replacements.items():
        if content.count(marker) != expected_count:
            die(
                f"policy template must contain exactly {expected_count} "
                f"{marker} marker(s)"
            )
        content = content.replace(marker, value)
    if "{{" in content or "}}" in content:
        die("policy template contains an unresolved marker")
    return content


def atomic_write(path, content):
    path.parent.mkdir(mode=0o700, parents=True, exist_ok=True)
    descriptor, temporary = tempfile.mkstemp(prefix=f".{path.name}.", dir=path.parent)
    try:
        with os.fdopen(descriptor, "w", encoding="utf-8") as handle:
            handle.write(content)
            handle.flush()
            os.fsync(handle.fileno())
        os.chmod(temporary, 0o600)
        os.replace(temporary, path)
    finally:
        try:
            os.unlink(temporary)
        except FileNotFoundError:
            pass


def main():
    parser = argparse.ArgumentParser(description="Render a family-specific Tailscale policy")
    inputs = parser.add_mutually_exclusive_group(required=True)
    inputs.add_argument("--deployment-config", type=Path)
    inputs.add_argument("--instance", type=Path)
    parser.add_argument("--template", type=Path, default=DEFAULT_TEMPLATE)
    parser.add_argument("--output", type=Path, required=True)
    args = parser.parse_args()
    deployment = (
        load_deployment(args.deployment_config)
        if args.deployment_config is not None
        else load_instance(args.instance)
    )
    atomic_write(args.output, render(args.template, deployment))
    print(args.output)


if __name__ == "__main__":
    main()
