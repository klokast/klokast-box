#!/usr/bin/env python3
"""Read validated Instance projections on the active development controller."""
import argparse
import json
from pathlib import Path
import sys

sys.path.insert(0, str(Path('/usr/local/lib/klokast') if Path('/usr/local/lib/klokast/platform_source.py').is_file()
                       else Path(__file__).resolve().parents[1] / 'lib'))
import platform_source as source


def main(argv=None):
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument('view', choices=('controllers', 'registry', 'retention', 'instance', 'implementation'))
    args = parser.parse_args(argv)
    try:
        view = source.snapshot()
        if args.view == 'controllers': value = source.controllers(view)
        elif args.view == 'registry': value = source.registry_status(view)
        elif args.view == 'retention': value = source.retention(view)
        else: value = view[args.view]
        print(json.dumps(value, sort_keys=True, ensure_ascii=False))
        return 0
    except (source.SourceError, OSError, ValueError, KeyError) as error:
        print('platform-source: ' + str(error), file=sys.stderr)
        return 1


if __name__ == '__main__':
    raise SystemExit(main())
