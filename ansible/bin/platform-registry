#!/usr/bin/env python3
"""Read the Instance-derived resource registry; runtime cannot write desired state."""
import argparse
import json
from pathlib import Path
import sys
sys.path.insert(0, str(Path('/usr/local/lib/klokast') if Path('/usr/local/lib/klokast/platform_source.py').is_file()
                       else Path(__file__).resolve().parents[1] / 'lib'))
import platform_source as source
REGISTRY = Path('/home/smith/private/klokast/platform-resources.yml')
INSTANCE = source.INSTANCE / 'klokast-instance.json'


def main(argv=None):
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument('operation', choices=('read',))
    parser.add_argument('--registry', default=str(REGISTRY))
    parser.add_argument('--json', action='store_true')
    args = parser.parse_args(argv)
    try:
        if Path(args.registry).expanduser().absolute() not in {REGISTRY, INSTANCE}:
            raise source.SourceError('registry path overrides cannot replace Instance desired state')
        view = source.snapshot()
        projection = view['rendered']['projection']
        print(json.dumps({'schema_version': 1, 'kind': 'klokast.registry-read.v1', 'source': 'instance',
                          'registry_path': str(INSTANCE), 'registry_sha256': projection['registry_sha256'],
                          'registry': projection['registry']}, sort_keys=True, ensure_ascii=False))
        return 0
    except (source.SourceError, OSError, ValueError, KeyError) as error:
        print('platform-registry: ' + str(error), file=sys.stderr)
        return 1


if __name__ == '__main__':
    raise SystemExit(main())
