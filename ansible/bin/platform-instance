#!/usr/bin/env python3
"""Validate and synchronize the development Instance with ordinary Git."""
import argparse
import json
import os
from pathlib import Path
import subprocess
import sys
sys.path.insert(0, str(Path('/usr/local/lib/klokast') if Path('/usr/local/lib/klokast/platform_source.py').is_file()
                       else Path(__file__).resolve().parents[1] / 'lib'))
import platform_source as source


def main(argv=None):
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument('action', choices=('check', 'status', 'sync', 'init'))
    parser.add_argument('--values', help='private init values JSON, for init only')
    args = parser.parse_args(argv)
    try:
        source.require_controller()
        if os.geteuid() == 0: raise source.SourceError('run platform-instance as smith')
        if args.action != 'init' and args.values: raise source.SourceError('--values is only valid for init')
        if args.action == 'init':
            if not args.values: raise source.SourceError('init requires private --values')
            result = subprocess.run([str(source.BINARY), 'init', '--instance', str(source.INSTANCE),
                                     '--values', args.values], check=False)
            return result.returncode
        if args.action == 'sync':
            # Keep edits safe. Pull only by fast-forward; Git reports conflicts.
            if source.command(['git', '-C', source.INSTANCE, 'status', '--porcelain']).strip():
                raise source.SourceError('Instance has local edits; commit them before sync')
            source.command(['git', '-C', source.INSTANCE, 'pull', '--ff-only'])
        view = source.snapshot()
        print(json.dumps({'valid': True, 'instance_sha256': view['instance_sha256'],
                          'implementation': view['implementation']}, sort_keys=True))
        return 0
    except (source.SourceError, OSError, ValueError, KeyError) as error:
        print('platform-instance: ' + str(error), file=sys.stderr)
        return 1


if __name__ == '__main__': raise SystemExit(main())
