#!/usr/bin/env python3
"""Verify, configure, validate, seed, synchronize, and report the private instance source."""

import argparse
import copy
import getpass
import importlib.util
import json
import os
import re
import shutil
import stat
import subprocess
import sys
import tempfile
from importlib.machinery import SourceFileLoader
from pathlib import Path


SCRIPT = Path(__file__).resolve()
REPO_ROOT = SCRIPT.parents[2]
PLATFORM_PLAN = SCRIPT.with_name("platform-plan")
INSTALLED_AUTHORITY = Path("/usr/local/sbin/ksa-instance")
PRIVATE_ROOT = Path("/home/smith/private/klokast")
DEPLOYMENT_CHECKOUT = PRIVATE_ROOT / "instance"
VALUES_PATH = PRIVATE_ROOT / "init-values.json"
SEED_PATH = PRIVATE_ROOT / "instance-seed"
COMPATIBILITY_DEPLOYMENT = PRIVATE_ROOT / "deployment.yml"
COMPATIBILITY_REGISTRY = PRIVATE_ROOT / "platform-resources.yml"
COMPATIBILITY_CONTROLLER_HA = PRIVATE_ROOT / "controller-ha.yml"
MAXIMUM_VALUES_SIZE = 64 * 1024
ENGINE_COMMIT_RE = re.compile(r"^[0-9a-f]{40}$")
SCHEMA_TRANSITION_METADATA_ONLY = "metadata-only"
SCHEMA_TRANSITION_LEGACY_TO_CURRENT = "instance-v1-legacy-to-current"
SCHEMA_TRANSITION_CURRENT_TO_LEGACY = "instance-v1-current-to-legacy"
SCHEMA_TRANSITION_PROFILES_TO_CAPABILITIES = "instance-v1-connectivity-profiles-to-capabilities"
SCHEMA_TRANSITION_CAPABILITIES_TO_PROFILES = "instance-v1-connectivity-capabilities-to-profiles"
SCHEMA_TRANSITIONS = {
    SCHEMA_TRANSITION_METADATA_ONLY,
    SCHEMA_TRANSITION_LEGACY_TO_CURRENT,
    SCHEMA_TRANSITION_CURRENT_TO_LEGACY,
    SCHEMA_TRANSITION_PROFILES_TO_CAPABILITIES,
    SCHEMA_TRANSITION_CAPABILITIES_TO_PROFILES,
}
TAILNET_DNS_RE = re.compile(r"^[a-z0-9](?:[a-z0-9-]*\.)+ts\.net$")
MEMBER_LOGIN_RE = re.compile(r"^[^@\s]+@[^@\s]+\.[^@\s]+$")
PLACEHOLDER_DNS = "REPLACE_WITH_TAILNET_DNS_NAME"
PLACEHOLDER_LOGIN = "REPLACE_WITH_PRIVATE_LOGIN"


class InstanceError(Exception):
    """Expected fail-closed private-instance error."""


def die(message):
    print(f"platform-instance: {message}", file=sys.stderr)
    raise SystemExit(1)


def run(argv, *, capture=False, check=True):
    completed = subprocess.run(
        [str(item) for item in argv],
        text=True,
        stdout=subprocess.PIPE if capture else None,
        stderr=subprocess.PIPE if capture else None,
        check=False,
    )
    if check and completed.returncode != 0:
        detail = (completed.stderr or completed.stdout or "").strip()
        raise InstanceError(
            f"command failed ({completed.returncode}): {argv[0]}"
            + (f": {detail}" if detail else "")
        )
    return completed


def load_plan_wrapper():
    loader = SourceFileLoader("klokast_platform_plan", str(PLATFORM_PLAN))
    spec = importlib.util.spec_from_loader("klokast_platform_plan", loader)
    module = importlib.util.module_from_spec(spec)
    loader.exec_module(module)
    return module


def require_controller_user():
    if getpass.getuser() != "smith":
        raise InstanceError("run as smith on the active controller")


def require_reviewed_engine(engine_commit):
    if not ENGINE_COMMIT_RE.fullmatch(engine_commit or ""):
        raise InstanceError("--engine-commit must be one full lowercase Git commit")
    current = run(
        ["git", "-C", REPO_ROOT, "rev-parse", "HEAD"], capture=True, check=False
    )
    controller_commit = current.stdout.strip()
    if current.returncode != 0 or not ENGINE_COMMIT_RE.fullmatch(controller_commit):
        raise InstanceError("cannot read the current controller checkout commit")
    changes = run(
        ["git", "-C", REPO_ROOT, "status", "--porcelain"], capture=True, check=False
    )
    if changes.returncode != 0:
        raise InstanceError("cannot inspect the current controller checkout")
    if changes.stdout:
        raise InstanceError(
            f"controller checkout {controller_commit} has changes; commit or preserve them first"
        )
    available = run(
        ["git", "-C", REPO_ROOT, "cat-file", "-e", f"{engine_commit}^{{commit}}"],
        capture=True,
        check=False,
    )
    if available.returncode != 0:
        raise InstanceError(
            f"approved engine {engine_commit} is not available in the controller checkout"
        )
    ancestor = run(
        ["git", "-C", REPO_ROOT, "merge-base", "--is-ancestor", engine_commit, controller_commit],
        capture=True,
        check=False,
    )
    if ancestor.returncode != 0:
        raise InstanceError(
            f"approved engine {engine_commit} is not in the history of controller checkout "
            f"{controller_commit}"
        )
    return controller_commit


def verify_engine(args):
    require_controller_user()
    plan = load_plan_wrapper()
    try:
        plan.require_active_controller()
        controller_commit = require_reviewed_engine(args.engine_commit)
        directory, build_commit = plan.resolve_build_directory(args.build_dir)
        if build_commit != args.engine_commit:
            raise InstanceError(
                f"sealed build is for engine {build_commit}; expected {args.engine_commit}"
            )
        receipt, binary = plan.verify_build_directory(directory, build_commit)
        plan.verify_binary_version(binary, receipt)
    except plan.PlanError as error:
        raise InstanceError(f"sealed engine verification failed: {error}") from error
    print(json.dumps({
        "schema_version": 1,
        "verified": True,
        "controller_commit": controller_commit,
        "engine_commit": args.engine_commit,
        "build_directory": str(directory),
    }, sort_keys=True))


def verify_configure_engine(args):
    """Return the sealed initializer after all controller checks pass."""
    require_controller_user()
    plan = load_plan_wrapper()
    try:
        plan.require_active_controller()
        require_reviewed_engine(args.engine_commit)
        directory, build_commit = plan.resolve_build_directory(args.build_dir)
        if build_commit != args.engine_commit:
            raise InstanceError(
                f"sealed build is for engine {build_commit}; expected {args.engine_commit}"
            )
        receipt, binary = plan.verify_build_directory(directory, build_commit)
        plan.verify_binary_version(binary, receipt)
    except plan.PlanError as error:
        raise InstanceError(f"sealed engine verification failed: {error}") from error
    return binary


def detect_tailnet_dns_name():
    completed = run(["tailscale", "status", "--json"], capture=True, check=False)
    if completed.returncode != 0:
        raise InstanceError(
            "cannot read Tailscale status; confirm that Tailscale is running on the controller"
        )
    try:
        status_value = json.loads(completed.stdout)
    except (json.JSONDecodeError, TypeError) as error:
        raise InstanceError("Tailscale status did not return valid JSON") from error
    current_tailnet = status_value.get("CurrentTailnet")
    current_tailnet = current_tailnet if isinstance(current_tailnet, dict) else {}
    candidates = {
        value.rstrip(".")
        for value in (
            status_value.get("MagicDNSSuffix"),
            current_tailnet.get("MagicDNSSuffix"),
        )
        if isinstance(value, str) and value
    }
    if len(candidates) > 1:
        raise InstanceError("Tailscale status reports conflicting Tailnet DNS names")
    dns_name = next(iter(candidates), "")
    if not TAILNET_DNS_RE.fullmatch(dns_name):
        raise InstanceError(
            "Tailscale status has no valid Tailnet DNS name ending in .ts.net"
        )
    return dns_name


def require_real_directory(path, *, private):
    try:
        metadata = os.lstat(path)
    except FileNotFoundError as error:
        raise InstanceError(f"required directory is missing: {path}") from error
    if not stat.S_ISDIR(metadata.st_mode) or metadata.st_uid != os.getuid():
        raise InstanceError(f"directory is not owned by the controller user: {path}")
    if os.path.realpath(path) != str(path):
        raise InstanceError(f"directory contains a symbolic link or path alias: {path}")
    if private and stat.S_IMODE(metadata.st_mode) & 0o077:
        raise InstanceError(f"private directory permits group or other access: {path}")


def prepare_values_directory():
    if not PRIVATE_ROOT.is_absolute() or VALUES_PATH != PRIVATE_ROOT / "init-values.json":
        raise InstanceError("the instance values path is not the fixed controller private path")
    home_directory = PRIVATE_ROOT.parent.parent
    require_real_directory(home_directory, private=False)
    for directory in (PRIVATE_ROOT.parent, PRIVATE_ROOT):
        try:
            os.mkdir(directory, 0o700)
        except FileExistsError:
            pass
        except OSError as error:
            raise InstanceError(f"cannot create the controller private directory: {directory}") from error
        require_real_directory(directory, private=True)


def validate_values_metadata(metadata):
    if (
        not stat.S_ISREG(metadata.st_mode)
        or metadata.st_uid != os.getuid()
        or metadata.st_nlink != 1
        or stat.S_IMODE(metadata.st_mode) != 0o600
    ):
        raise InstanceError(
            "init-values.json must be one owner-only regular file with mode 0600"
        )
    if metadata.st_size <= 0 or metadata.st_size > MAXIMUM_VALUES_SIZE:
        raise InstanceError("init-values.json must be non-empty and no larger than 64 KiB")


def decode_unique_json(content):
    def reject_duplicates(pairs):
        value = {}
        for key, item in pairs:
            if key in value:
                raise ValueError(f"duplicate JSON key: {key}")
            value[key] = item
        return value

    try:
        return json.loads(content.decode("utf-8"), object_pairs_hook=reject_duplicates)
    except (UnicodeDecodeError, json.JSONDecodeError, ValueError) as error:
        raise InstanceError(
            "existing init-values.json is malformed or has duplicate keys; it was not changed"
        ) from error


def read_existing_values():
    try:
        path_metadata = os.lstat(VALUES_PATH)
    except FileNotFoundError:
        return None
    validate_values_metadata(path_metadata)
    flags = os.O_RDONLY
    if hasattr(os, "O_NOFOLLOW"):
        flags |= os.O_NOFOLLOW
    try:
        descriptor = os.open(VALUES_PATH, flags)
    except OSError as error:
        raise InstanceError("cannot safely open init-values.json") from error
    try:
        open_metadata = os.fstat(descriptor)
        validate_values_metadata(open_metadata)
        if (
            path_metadata.st_dev != open_metadata.st_dev
            or path_metadata.st_ino != open_metadata.st_ino
        ):
            raise InstanceError("init-values.json changed during inspection")
        chunks = []
        remaining = MAXIMUM_VALUES_SIZE + 1
        while remaining:
            chunk = os.read(descriptor, min(remaining, 8192))
            if not chunk:
                break
            chunks.append(chunk)
            remaining -= len(chunk)
        content = b"".join(chunks)
        if len(content) > MAXIMUM_VALUES_SIZE:
            raise InstanceError("init-values.json is larger than 64 KiB")
    finally:
        os.close(descriptor)
    return {
        "metadata": path_metadata,
        "content": content,
        "value": decode_unique_json(content),
    }


def build_instance_values(engine_commit, dns_name, member_login):
    return {
        "$schema": (
            "https://raw.githubusercontent.com/klokast/klokast-box/"
            f"{engine_commit}/schemas/klokast-instance-v1.schema.json"
        ),
        "schema-version": 1,
        "tailscale": {
            "tailnet-dns-name": dns_name,
            "members": {member_login: {"roles": ["operator", "family"]}},
        },
        "boxes": {
            "boxa": {
                "site": "site-a",
                "country": "XA",
                "description": "",
                "connectivity": ["local-ap-uplink", "direct-wan-egress", "overlay"],
            },
            "boxb": {
                "site": "site-b",
                "country": "XB",
                "description": "",
                "connectivity": ["overlay"],
            },
        },
        "controllers": {"active": "boxb", "standby": "boxa"},
        "airunners": ["boxb-ops-airunner"],
        "apps": {
            "music": {
                "desired-state": "absent",
                "data": {"library": {"box": "boxb", "retention": "preserve"}},
            },
        },
    }


def member_login_error(value):
    if not value:
        return "enter the Tailscale member login"
    if value != value.strip() or any(character.isspace() for character in value):
        return "the Tailscale member login must not contain spaces"
    if len(value) > 320:
        return "the Tailscale member login must not exceed 320 characters"
    if value in {PLACEHOLDER_LOGIN, PLACEHOLDER_DNS}:
        return "replace the placeholder with the Tailscale member login"
    if not MEMBER_LOGIN_RE.fullmatch(value):
        return (
            "enter one email-style Tailscale login, such as name@example.com; "
            "it must contain one @ sign and a dot after it"
        )
    return None


def classify_existing_values(existing, engine_commit, detected_dns):
    value = existing["value"]
    if not isinstance(value, dict):
        raise InstanceError(
            "existing init-values.json has an unexpected structure; it was not changed"
        )
    try:
        dns_name = value["tailscale"]["tailnet-dns-name"]
        members = value["tailscale"]["members"]
    except (KeyError, TypeError) as error:
        raise InstanceError(
            "existing init-values.json has an unexpected structure; it was not changed"
        ) from error
    if not isinstance(members, dict) or len(members) != 1:
        raise InstanceError(
            "existing init-values.json does not have the reviewed single-member topology; "
            "it was not changed"
        )
    member_login = next(iter(members))
    if dns_name not in {PLACEHOLDER_DNS, detected_dns}:
        raise InstanceError(
            "existing init-values.json has a Tailnet DNS name that differs from current "
            "Tailscale status; it was not changed"
        )
    if member_login != PLACEHOLDER_LOGIN and member_login_error(member_login):
        raise InstanceError(
            "existing init-values.json has an invalid Tailscale member login; it was not changed"
        )
    normalized = copy.deepcopy(value)
    normalized["tailscale"]["tailnet-dns-name"] = PLACEHOLDER_DNS
    normalized["tailscale"]["members"] = {
        PLACEHOLDER_LOGIN: {"roles": ["operator", "family"]}
    }
    expected = build_instance_values(
        engine_commit, PLACEHOLDER_DNS, PLACEHOLDER_LOGIN
    )
    if normalized != expected:
        raise InstanceError(
            "existing init-values.json differs from the reviewed topology; it was not changed"
        )
    if dns_name == detected_dns and member_login != PLACEHOLDER_LOGIN:
        return "reused", member_login
    default_login = member_login if member_login != PLACEHOLDER_LOGIN else None
    return "repaired", default_login


def read_terminal_line(prompt):
    print(prompt, end="", file=sys.stderr, flush=True)
    value = sys.stdin.readline()
    if value == "":
        raise InstanceError("input ended before configuration completed; no values were changed")
    return value.rstrip("\r\n")


def prompt_member_login(default_login=None):
    while True:
        if default_login:
            answer = read_terminal_line(
                f"Tailscale member login [{default_login}]: "
            )
            candidate = default_login if answer == "" else answer
        else:
            candidate = read_terminal_line("Tailscale member login: ")
        correction = member_login_error(candidate)
        if correction is None:
            return candidate
        print(f"Correction: {correction}.", file=sys.stderr)


def confirm_configuration(prompt):
    answer = read_terminal_line(f"{prompt} [y/N] ")
    return answer in {"y", "Y", "yes", "YES", "Yes"}


def safe_initializer_text(value, fallback):
    if not isinstance(value, str):
        return fallback
    cleaned = " ".join(value.split())
    cleaned = "".join(character for character in cleaned if character.isprintable())
    return cleaned[:500] or fallback


def parse_initializer_result(completed, destination):
    try:
        result = json.loads(completed.stdout)
    except (json.JSONDecodeError, TypeError) as error:
        if completed.returncode == 0:
            raise InstanceError("sealed initializer returned invalid result JSON") from error
        raise InstanceError(
            f"sealed initializer failed with exit code {completed.returncode} and no readable result"
        ) from error
    if not isinstance(result, dict):
        raise InstanceError("sealed initializer returned an unexpected result")
    if completed.returncode != 0:
        diagnostics = result.get("diagnostics")
        if isinstance(diagnostics, list) and diagnostics:
            messages = ["sealed initializer rejected the values:"]
            for diagnostic in diagnostics:
                if not isinstance(diagnostic, dict):
                    continue
                path = safe_initializer_text(diagnostic.get("path"), "values")
                code = safe_initializer_text(diagnostic.get("code"), "validation.error")
                message = safe_initializer_text(
                    diagnostic.get("message"), "the field is invalid"
                )
                messages.append(f"  - {path} [{code}]: {message}")
            if len(messages) > 1:
                raise InstanceError("\n".join(messages))
        operational = safe_initializer_text(
            result.get("operational_error"), "the initializer reported an operational error"
        )
        raise InstanceError(f"sealed initializer failed: {operational}")
    if result.get("created") is not True or Path(result.get("instance_path", "")) != destination:
        raise InstanceError("sealed initializer did not create the requested validation repository")
    return result


def run_initializer(binary, values_path, destination):
    completed = run(
        [
            binary,
            "init",
            "--instance",
            destination,
            "--values",
            values_path,
            "--json",
        ],
        capture=True,
        check=False,
    )
    return parse_initializer_result(completed, destination)


def validate_values_with_initializer(binary, values_path):
    validation_root = Path(
        tempfile.mkdtemp(prefix=".init-values-check.", dir=PRIVATE_ROOT)
    )
    os.chmod(validation_root, 0o700)
    try:
        run_initializer(binary, values_path, validation_root / "instance")
    finally:
        shutil.rmtree(validation_root)


def validate_candidate_with_initializer(binary, value):
    content = (json.dumps(value, indent=2, sort_keys=True) + "\n").encode("utf-8")
    descriptor, temporary_name = tempfile.mkstemp(
        prefix=".init-values-candidate.", dir=PRIVATE_ROOT
    )
    temporary_path = Path(temporary_name)
    try:
        os.fchmod(descriptor, 0o600)
        view = memoryview(content)
        while view:
            written = os.write(descriptor, view)
            if written <= 0:
                raise InstanceError("cannot write the complete candidate values file")
            view = view[written:]
        os.fsync(descriptor)
        os.close(descriptor)
        descriptor = -1
        validate_values_with_initializer(binary, temporary_path)
    finally:
        if descriptor >= 0:
            os.close(descriptor)
        try:
            temporary_path.unlink()
        except FileNotFoundError:
            pass


def write_values_atomically(value, existing):
    content = (json.dumps(value, indent=2, sort_keys=True) + "\n").encode("utf-8")
    descriptor, temporary_name = tempfile.mkstemp(
        prefix=".init-values-write.", dir=PRIVATE_ROOT
    )
    temporary_path = Path(temporary_name)
    try:
        os.fchmod(descriptor, 0o600)
        view = memoryview(content)
        while view:
            written = os.write(descriptor, view)
            if written <= 0:
                raise InstanceError("cannot write the complete init-values.json file")
            view = view[written:]
        os.fsync(descriptor)
        validate_values_metadata(os.fstat(descriptor))
        os.close(descriptor)
        descriptor = -1

        if existing is None:
            try:
                os.link(temporary_path, VALUES_PATH, follow_symlinks=False)
            except FileExistsError as error:
                raise InstanceError(
                    "init-values.json appeared during configuration; it was not overwritten"
                ) from error
            temporary_path.unlink()
        else:
            current = read_existing_values()
            if (
                current is None
                or current["content"] != existing["content"]
                or current["metadata"].st_dev != existing["metadata"].st_dev
                or current["metadata"].st_ino != existing["metadata"].st_ino
            ):
                raise InstanceError(
                    "init-values.json changed during configuration; it was not overwritten"
                )
            os.replace(temporary_path, VALUES_PATH)
        directory_descriptor = os.open(PRIVATE_ROOT, os.O_RDONLY)
        try:
            os.fsync(directory_descriptor)
        finally:
            os.close(directory_descriptor)
        final_values = read_existing_values()
        if final_values is None or final_values["content"] != content:
            raise InstanceError("the complete init-values.json file was not published")
    finally:
        if descriptor >= 0:
            os.close(descriptor)
        try:
            temporary_path.unlink()
        except FileNotFoundError:
            pass


def show_configuration(dns_name, member_login, existing_state):
    print("\nReview the neutral Instance Specification template:", file=sys.stderr)
    print(f"  Tailnet DNS name: {dns_name}", file=sys.stderr)
    print(f"  Tailscale member login: {member_login}", file=sys.stderr)
    print("  Member roles: operator, family", file=sys.stderr)
    print(
        "  Example boxes: boxa at site-a (XA); boxb at site-b (XB)",
        file=sys.stderr,
    )
    print("  Example controllers: boxb active; boxa standby", file=sys.stderr)
    print("  Example airrunner: boxb-ops-airunner", file=sys.stderr)
    print("  Example app intent: Music absent; library data preserved on boxb", file=sys.stderr)
    print("  Platform time: Etc/UTC (derived; no timezone field)", file=sys.stderr)
    print("  Required: replace all example topology and app values on the trusted MacBook", file=sys.stderr)
    if existing_state == "reused":
        print("  Existing values file: valid and unchanged", file=sys.stderr)
    elif existing_state == "repaired":
        print("  Existing values file: recognized placeholder template", file=sys.stderr)


def configure_values(args):
    binary = verify_configure_engine(args)
    dns_name = detect_tailnet_dns_name()
    prepare_values_directory()
    existing = read_existing_values()
    if existing is None:
        result_state = "created"
        member_login = prompt_member_login()
    else:
        result_state, default_login = classify_existing_values(
            existing, args.engine_commit, dns_name
        )
        if result_state == "reused":
            member_login = default_login
        else:
            member_login = prompt_member_login(default_login)
    value = build_instance_values(args.engine_commit, dns_name, member_login)
    if result_state == "reused":
        validate_values_with_initializer(binary, VALUES_PATH)
    else:
        validate_candidate_with_initializer(binary, value)
    show_configuration(dns_name, member_login, result_state)
    prompt = (
        "Reuse this owner-only values file?"
        if result_state == "reused"
        else "Write this owner-only values file?"
    )
    if not confirm_configuration(prompt):
        print("Configuration cancelled. No values were changed.", file=sys.stderr)
        print("cancelled")
        return
    if result_state == "reused":
        current = read_existing_values()
        if (
            current is None
            or current["content"] != existing["content"]
            or current["metadata"].st_dev != existing["metadata"].st_dev
            or current["metadata"].st_ino != existing["metadata"].st_ino
        ):
            raise InstanceError(
                "init-values.json changed during review; it was not reused"
            )
    else:
        write_values_atomically(value, existing)
    print(f"Instance Specification template is complete ({result_state}).", file=sys.stderr)
    print(result_state)


def resolve_private_destination(value):
    supplied = Path(value)
    if not supplied.is_absolute():
        raise InstanceError("--destination must be an absolute controller path")
    try:
        private_root = PRIVATE_ROOT.resolve(strict=True)
        parent = supplied.parent.resolve(strict=True)
        parent.relative_to(private_root)
    except (OSError, ValueError) as error:
        raise InstanceError("--destination must have an existing parent below the private root") from error
    if supplied == DEPLOYMENT_CHECKOUT or supplied.exists() or supplied.is_symlink():
        raise InstanceError("--destination must be a new path separate from the deployment checkout")
    if supplied.parent != parent:
        raise InstanceError("--destination must not contain symbolic links or path aliases")
    return supplied


def seed(args):
    require_controller_user()
    plan = load_plan_wrapper()
    try:
        plan.require_active_controller()
        directory, commit = plan.resolve_build_directory(args.build_dir)
        receipt, binary = plan.verify_build_directory(directory, commit)
        plan.verify_binary_version(binary, receipt)
    except plan.PlanError as error:
        raise InstanceError(str(error)) from error
    supplied_values = Path(args.values)
    if supplied_values != VALUES_PATH:
        raise InstanceError(
            "--values must be the fixed controller path /home/smith/private/klokast/init-values.json"
        )
    try:
        values_metadata = os.lstat(supplied_values)
    except FileNotFoundError as error:
        raise InstanceError("--values file is missing on the controller") from error
    try:
        validate_values_metadata(values_metadata)
    except InstanceError as error:
        raise InstanceError(f"unsafe --values file: {error}") from error
    try:
        private_root = PRIVATE_ROOT.resolve(strict=True)
        values = supplied_values.resolve(strict=True)
        values.relative_to(private_root)
    except (OSError, ValueError) as error:
        raise InstanceError("--values must be below the controller private root") from error
    if values != supplied_values:
        raise InstanceError("--values must not contain symbolic links or path aliases")
    destination = resolve_private_destination(args.destination)
    run_initializer(binary, values, destination)
    print(json.dumps({
        "schema_version": 1,
        "seeded": True,
        "engine_commit": commit,
        "destination": str(destination),
    }, sort_keys=True))


def validate_private_repository_tree(root, label):
    require_real_directory(root, private=True)
    # The owner-only repository root is the access boundary. Normal nested Git
    # modes are safe below it, but every object must still belong to smith.
    require_real_directory(root / ".git", private=False)
    for current, directories, files in os.walk(root, topdown=True, followlinks=False):
        for name in [*directories, *files]:
            path = Path(current) / name
            metadata = os.lstat(path)
            if stat.S_ISLNK(metadata.st_mode):
                raise InstanceError(f"the {label} contains a symbolic link")
            if metadata.st_uid != os.getuid():
                raise InstanceError(f"the {label} is not controller-owned")
            if not (stat.S_ISDIR(metadata.st_mode) or stat.S_ISREG(metadata.st_mode)):
                raise InstanceError(f"the {label} contains an unsafe filesystem object")


def validate_unborn_seed():
    if SEED_PATH != PRIVATE_ROOT / "instance-seed":
        raise InstanceError("the controller seed path is not fixed")
    require_real_directory(PRIVATE_ROOT, private=True)
    validate_private_repository_tree(SEED_PATH, "controller seed")
    head = run(
        ["git", "-C", SEED_PATH, "rev-parse", "--verify", "HEAD"],
        capture=True,
        check=False,
    )
    if head.returncode == 0:
        raise InstanceError("the controller seed already has a commit")
    remotes = run(["git", "-C", SEED_PATH, "remote"], capture=True)
    if remotes.stdout.strip():
        raise InstanceError("the controller seed has a Git remote")
    run(["git", "-C", SEED_PATH, "diff", "--cached", "--check"])


def active_engine_status():
    if not INSTALLED_AUTHORITY.is_file() or not os.access(INSTALLED_AUTHORITY, os.X_OK):
        raise InstanceError("installed instance Secret Authority wrapper is missing")
    completed = run(
        ["sudo", "-n", INSTALLED_AUTHORITY, "--repo-root", REPO_ROOT, "engine", "status"],
        capture=True,
        check=False,
    )
    if completed.returncode != 0:
        raise InstanceError("cannot synchronize and verify the active engine")
    try:
        value = json.loads(completed.stdout)
    except json.JSONDecodeError as error:
        raise InstanceError("active engine status returned invalid JSON") from error
    if not isinstance(value, dict) or value.get("valid") is not True:
        raise InstanceError("active engine has no immutable activation receipt")
    return value


def validate_deployment_base(args):
    validate_private_repository_tree(DEPLOYMENT_CHECKOUT, "deployment checkout")
    if run(
        ["git", "-C", DEPLOYMENT_CHECKOUT, "status", "--porcelain=v1", "--untracked-files=all"],
        capture=True,
    ).stdout:
        raise InstanceError("the controller deployment checkout is dirty")
    branch = run(
        ["git", "-C", DEPLOYMENT_CHECKOUT, "branch", "--show-current"], capture=True
    ).stdout.strip()
    commit = run(["git", "-C", DEPLOYMENT_CHECKOUT, "rev-parse", "HEAD"], capture=True).stdout.strip()
    tree = run(["git", "-C", DEPLOYMENT_CHECKOUT, "rev-parse", "HEAD^{tree}"], capture=True).stdout.strip()
    if branch != "main" or not ENGINE_COMMIT_RE.fullmatch(commit) or not re.fullmatch(r"[0-9a-f]{40,64}", tree):
        raise InstanceError("the controller deployment checkout identity is invalid")
    if args.base_commit != commit or args.base_tree != tree:
        raise InstanceError("MacBook base commit and tree do not match the synchronized controller checkout")
    status = active_engine_status()
    expected_operation = Path(args.build_dir).name
    expected = {
        "engine_commit": args.engine_commit,
        "build_operation": expected_operation,
        "private_commit": commit,
        "private_tree": tree,
    }
    for field, wanted in expected.items():
        if status.get(field) != wanted:
            raise InstanceError(f"active engine evidence does not match candidate field: {field}")
    if not re.fullmatch(r"[0-9a-f]{64}", status.get("source_receipt_sha256", "")):
        raise InstanceError("active engine status has no fresh source receipt")
    if status.get("rollback_schema_transition") not in SCHEMA_TRANSITIONS:
        raise InstanceError("active engine status has no valid rollback schema transition")
    return DEPLOYMENT_CHECKOUT, status


def read_candidate_document():
    content = sys.stdin.buffer.read(MAXIMUM_VALUES_SIZE + 1)
    if not content:
        raise InstanceError("candidate klokast-instance.json is empty")
    if len(content) > MAXIMUM_VALUES_SIZE:
        raise InstanceError("candidate klokast-instance.json is larger than 64 KiB")
    try:
        decode_unique_json(content)
    except InstanceError as error:
        raise InstanceError(
            "candidate klokast-instance.json is malformed or has duplicate keys"
        ) from error
    return content


def parse_checker_result(completed):
    try:
        result = json.loads(completed.stdout)
    except (json.JSONDecodeError, TypeError) as error:
        raise InstanceError("sealed checker returned invalid result JSON") from error
    if not isinstance(result, dict):
        raise InstanceError("sealed checker returned an unexpected result")
    if completed.returncode == 0 and result.get("valid") is True:
        return
    messages = ["sealed checker rejected candidate klokast-instance.json:"]
    diagnostics = result.get("diagnostics")
    if isinstance(diagnostics, list):
        for diagnostic in diagnostics:
            if not isinstance(diagnostic, dict):
                continue
            path = safe_initializer_text(diagnostic.get("path"), "klokast-instance.json")
            code = safe_initializer_text(diagnostic.get("code"), "validation.error")
            message = safe_initializer_text(
                diagnostic.get("message"), "the field is invalid"
            )
            messages.append(f"  - {path} [{code}]: {message}")
    if len(messages) == 1:
        messages.append("  - candidate [validation.error]: validation failed")
    raise InstanceError("\n".join(messages))


def parse_compatibility_result(completed):
    try:
        result = json.loads(completed.stdout)
    except (json.JSONDecodeError, TypeError) as error:
        raise InstanceError("sealed compatibility planner returned invalid result JSON") from error
    if not isinstance(result, dict) or result.get("valid") is not True:
        raise InstanceError("sealed compatibility planner did not return valid evidence")
    compatibility = result.get("compatibility")
    summary = compatibility.get("summary") if isinstance(compatibility, dict) else None
    if not isinstance(summary, dict):
        raise InstanceError("sealed compatibility planner returned an invalid summary")
    conflict = summary.get("conflict")
    unsupported = summary.get("unsupported")
    if not isinstance(conflict, int) or isinstance(conflict, bool) or conflict < 0:
        raise InstanceError("sealed compatibility planner returned an invalid conflict count")
    if not isinstance(unsupported, int) or isinstance(unsupported, bool) or unsupported < 0:
        raise InstanceError("sealed compatibility planner returned an invalid unsupported count")
    if result.get("compatible") is not True or conflict != 0 or unsupported != 0:
        raise InstanceError(
            "candidate conflicts with current private compatibility authority "
            f"({conflict} conflict, {unsupported} unsupported); review the private findings on the controller"
        )
    if completed.returncode != 0:
        raise InstanceError("sealed compatibility planner refused a compatible candidate")
    return {"conflict": conflict, "unsupported": unsupported}


def schema_url(commit, name):
    return (
        "https://raw.githubusercontent.com/klokast/klokast-box/"
        f"{commit}/schemas/{name}"
    )


def transition_instance_v1(instance, transition, target_commit):
    if transition not in SCHEMA_TRANSITIONS:
        raise InstanceError("active engine evidence has an unsupported rollback schema transition")
    value = copy.deepcopy(instance)
    value["$schema"] = schema_url(target_commit, "klokast-instance-v1.schema.json")
    if transition == SCHEMA_TRANSITION_METADATA_ONLY:
        return value
    legacy_keys = {
        "$schema", "schema-version", "instance", "tailnet", "sites",
        "boxes", "controllers", "airunners", "apps",
    }
    current_keys = {
        "$schema", "schema-version", "tailscale", "boxes", "controllers",
        "airunners", "apps",
    }
    if transition in {
        SCHEMA_TRANSITION_PROFILES_TO_CAPABILITIES,
        SCHEMA_TRANSITION_CAPABILITIES_TO_PROFILES,
    }:
        if set(value) != current_keys:
            raise InstanceError("Instance v1 connectivity transition requires the exact current document shape")
        boxes = value.get("boxes")
        if not isinstance(boxes, dict) or not boxes:
            raise InstanceError("Instance v1 connectivity transition requires box data")
        for document in boxes.values():
            expected = {"site", "country", "description", "connectivity"}
            if not isinstance(document, dict) or set(document) != expected:
                raise InstanceError("Instance v1 connectivity transition requires the exact box shape")
            connectivity = document.get("connectivity")
            if not isinstance(connectivity, list) or not connectivity or len(set(connectivity)) != len(connectivity):
                raise InstanceError("Instance v1 connectivity values must be a non-empty unique list")
            converted = []
            if transition == SCHEMA_TRANSITION_PROFILES_TO_CAPABILITIES:
                for item in connectivity:
                    if item == "tailscale":
                        converted.append("overlay")
                    elif item == "local-ap-direct-egress":
                        converted.extend(["local-ap-uplink", "direct-wan-egress"])
                    else:
                        raise InstanceError("legacy Instance v1 connectivity contains an unknown profile")
            else:
                index = 0
                while index < len(connectivity):
                    item = connectivity[index]
                    if item == "overlay":
                        converted.append("tailscale")
                        index += 1
                    elif item == "local-ap-uplink" and index + 1 < len(connectivity) and connectivity[index + 1] == "direct-wan-egress":
                        converted.append("local-ap-direct-egress")
                        index += 2
                    else:
                        raise InstanceError("connectivity capabilities are not exactly invertible to legacy profiles")
            if len(set(converted)) != len(converted):
                raise InstanceError("Instance v1 connectivity transition would create duplicates")
            document["connectivity"] = converted
        return value
    if transition == SCHEMA_TRANSITION_LEGACY_TO_CURRENT:
        if set(value) != legacy_keys or value.get("instance") != {"id": "klokast-instance"}:
            raise InstanceError("legacy Instance v1 candidate cannot be converted without data loss")
        sites = value.get("sites")
        boxes = value.get("boxes")
        if not isinstance(sites, dict) or not isinstance(boxes, dict) or not boxes:
            raise InstanceError("legacy Instance v1 candidate has invalid site or box data")
        migrated = {}
        referenced = set()
        for box, document in boxes.items():
            if not isinstance(document, dict) or set(document) != {"site", "connectivity-profiles"}:
                raise InstanceError("legacy Instance v1 candidate has an unsupported box shape")
            site = document.get("site")
            metadata = sites.get(site) if isinstance(site, str) else None
            if not isinstance(metadata, dict) or set(metadata) != {"country", "description"}:
                raise InstanceError("legacy Instance v1 candidate has invalid site metadata")
            referenced.add(site)
            migrated[box] = {
                "site": site,
                "country": metadata["country"],
                "description": metadata["description"],
                "connectivity": document["connectivity-profiles"],
            }
        if referenced != set(sites):
            raise InstanceError("legacy Instance v1 candidate has unused site metadata")
        return {
            "$schema": value["$schema"],
            "schema-version": value["schema-version"],
            "tailscale": value["tailnet"],
            "boxes": migrated,
            "controllers": value["controllers"],
            "airunners": value["airunners"],
            "apps": value["apps"],
        }
    if set(value) != current_keys:
        raise InstanceError("current Instance v1 candidate cannot be converted to the legacy shape")
    boxes = value.get("boxes")
    if not isinstance(boxes, dict) or not boxes:
        raise InstanceError("current Instance v1 candidate has invalid box data")
    legacy_boxes = {}
    sites = {}
    for box, document in boxes.items():
        if not isinstance(document, dict) or set(document) != {"site", "country", "description", "connectivity"}:
            raise InstanceError("current Instance v1 candidate has an unsupported box shape")
        site = document.get("site")
        if not isinstance(site, str):
            raise InstanceError("current Instance v1 candidate has an invalid site")
        metadata = {"country": document["country"], "description": document["description"]}
        if site in sites and sites[site] != metadata:
            raise InstanceError("candidate boxes with one site have inconsistent metadata")
        sites[site] = metadata
        legacy_boxes[box] = {
            "site": site,
            "connectivity-profiles": document["connectivity"],
        }
    return {
        "$schema": value["$schema"],
        "schema-version": value["schema-version"],
        "instance": {"id": "klokast-instance"},
        "tailnet": value["tailscale"],
        "sites": sites,
        "boxes": legacy_boxes,
        "controllers": value["controllers"],
        "airunners": value["airunners"],
        "apps": value["apps"],
    }


def check_candidate(args):
    binary = verify_configure_engine(args)
    if (DEPLOYMENT_CHECKOUT / ".git").is_dir():
        base, engine_status = validate_deployment_base(args)
    else:
        if getattr(args, "base_commit", "") or getattr(args, "base_tree", ""):
            raise InstanceError("initial seed validation does not accept a committed base")
        validate_unborn_seed()
        base = SEED_PATH
        engine_status = None
    content = read_candidate_document()
    validation_root = Path(
        tempfile.mkdtemp(prefix=".instance-candidate-check.", dir=PRIVATE_ROOT)
    )
    os.chmod(validation_root, 0o700)
    candidate = validation_root / "instance"
    try:
        shutil.copytree(base, candidate, symlinks=True)
        validate_private_repository_tree(candidate, "candidate repository")
        instance_path = candidate / "klokast-instance.json"
        flags = os.O_WRONLY | os.O_TRUNC
        if hasattr(os, "O_NOFOLLOW"):
            flags |= os.O_NOFOLLOW
        descriptor = os.open(instance_path, flags)
        try:
            metadata = os.fstat(descriptor)
            if not stat.S_ISREG(metadata.st_mode) or metadata.st_uid != os.getuid():
                raise InstanceError("candidate destination is not one controller-owned file")
            os.fchmod(descriptor, 0o600)
            view = memoryview(content)
            while view:
                written = os.write(descriptor, view)
                if written <= 0:
                    raise InstanceError("cannot write the complete candidate instance document")
                view = view[written:]
            os.fsync(descriptor)
        finally:
            os.close(descriptor)
        run(["git", "-C", candidate, "add", "--", "klokast-instance.json"])
        completed = run(
            [binary, "check", "--instance", candidate, "--json"],
            capture=True,
            check=False,
        )
        parse_checker_result(completed)
        if engine_status is not None:
            plan = load_plan_wrapper()
            previous_commit = engine_status.get("previous_engine_commit", "")
            previous_operation = engine_status.get("previous_build_operation", "")
            if not ENGINE_COMMIT_RE.fullmatch(previous_commit) or not re.fullmatch(r"[0-9a-f]{12}", previous_operation):
                raise InstanceError("active engine activation has no valid rollback engine")
            rollback_directory = (
                Path("/var/lib/klokast/builds/klokast-cli")
                / previous_commit
                / previous_operation
            )
            try:
                directory, rollback_commit = plan.resolve_build_directory(rollback_directory)
                if rollback_commit != previous_commit:
                    raise InstanceError("rollback sealed build commit is invalid")
                rollback_receipt, rollback_binary = plan.verify_build_directory(directory, rollback_commit)
                plan.verify_binary_version(rollback_binary, rollback_receipt)
            except plan.PlanError as error:
                raise InstanceError(f"rollback sealed engine verification failed: {error}") from error
            rollback_instance = json.loads(instance_path.read_text(encoding="utf-8"))
            rollback_lock_path = candidate / "klokast.lock.json"
            active_lock_content = rollback_lock_path.read_bytes()
            rollback_lock = json.loads(active_lock_content)
            rollback_transition = engine_status.get("rollback_schema_transition", "")
            rollback_instance = transition_instance_v1(
                rollback_instance, rollback_transition, previous_commit
            )
            prefix = (
                "https://raw.githubusercontent.com/klokast/klokast-box/"
                f"{previous_commit}/schemas/"
            )
            rollback_lock["$schema"] = prefix + "klokast-lock-v1.schema.json"
            rollback_lock["engine"]["commit"] = previous_commit
            instance_path.write_text(json.dumps(rollback_instance, indent=2, sort_keys=True) + "\n", encoding="utf-8")
            rollback_lock_path.write_text(json.dumps(rollback_lock, indent=2, sort_keys=True) + "\n", encoding="utf-8")
            rollback_completed = run(
                [rollback_binary, "check", "--instance", candidate, "--json"],
                capture=True,
                check=False,
            )
            parse_checker_result(rollback_completed)
            instance_path.write_bytes(content)
            rollback_lock_path.write_bytes(active_lock_content)
            run(["git", "-C", candidate, "add", "--", "klokast-instance.json", "klokast.lock.json"])
        compatibility_summary = None
        if getattr(args, "require_compatible", False):
            completed = run(
                [
                    binary,
                    "plan",
                    "--instance", candidate,
                    "--compatibility-deployment", COMPATIBILITY_DEPLOYMENT,
                    "--compatibility-registry", COMPATIBILITY_REGISTRY,
                    "--compatibility-controller-ha", COMPATIBILITY_CONTROLLER_HA,
                    "--json",
                ],
                capture=True,
                check=False,
            )
            if completed.returncode not in (0, 2):
                raise InstanceError("sealed compatibility planner failed operationally")
            compatibility_summary = parse_compatibility_result(completed)
        tree = run(["git", "-C", candidate, "write-tree"], capture=True).stdout.strip()
        if not re.fullmatch(r"[0-9a-f]{40,64}", tree):
            raise InstanceError("validated candidate returned an invalid Git tree")
        result = {
            "schema_version": 1,
            "valid": True,
            "engine_commit": args.engine_commit,
            "tree": tree,
        }
        if compatibility_summary is not None:
            result["compatible"] = True
            result["compatibility_summary"] = compatibility_summary
        print(json.dumps(result, sort_keys=True))
    finally:
        shutil.rmtree(validation_root)


def authority(args):
    require_controller_user()
    if not INSTALLED_AUTHORITY.is_file() or not os.access(INSTALLED_AUTHORITY, os.X_OK):
        raise InstanceError("installed instance Secret Authority wrapper is missing")
    command = ["sudo", "-n", INSTALLED_AUTHORITY, "--repo-root", REPO_ROOT, "source", args.action]
    if args.action in {"prepare", "sync"}:
        command.extend(["--repo-owner", args.repo_owner, "--repo-name", args.repo_name])
    else:
        command.append("--redacted")
    completed = run(command, check=False)
    if completed.returncode != 0:
        raise InstanceError("instance Secret Authority action failed")


def engine_authority(args):
    require_controller_user()
    if not INSTALLED_AUTHORITY.is_file() or not os.access(INSTALLED_AUTHORITY, os.X_OK):
        raise InstanceError("installed instance Secret Authority wrapper is missing")
    command = [
        "sudo", "-n", INSTALLED_AUTHORITY, "--repo-root", REPO_ROOT,
        "engine", args.action,
    ]
    if args.action == "promotion-preflight":
        if args.rollback:
            if args.new_engine_commit or args.build_operation:
                raise InstanceError("--rollback does not accept an engine commit or build operation")
        else:
            if not args.new_engine_commit or not args.build_operation:
                raise InstanceError("promotion preflight requires --new-engine-commit and --build-operation")
            command.extend([
                "--new-engine-commit", args.new_engine_commit,
                "--build-operation", args.build_operation,
            ])
    elif args.action == "promotion-approve":
        command.extend([
            "--approval-intent", args.approval_intent,
            "--approval-signature", args.approval_signature,
            "--signer-id", args.signer_id,
        ])
    elif args.action == "promotion-activate":
        command.extend([
            "--engine-commit", args.engine_commit,
            "--private-commit", args.private_commit,
            "--promotion-receipt", args.promotion_receipt,
        ])
    elif args.action == "status":
        if bool(args.candidate_engine) != bool(args.candidate_tree):
            raise InstanceError("candidate engine status requires both engine commit and tree")
        if args.candidate_engine:
            command.extend([
                "--candidate-engine", args.candidate_engine,
                "--candidate-tree", args.candidate_tree,
            ])
    completed = run(command, check=False)
    if completed.returncode != 0:
        raise InstanceError(f"engine {args.action} failed")


def parse_args(argv):
    parser = argparse.ArgumentParser(description=__doc__)
    commands = parser.add_subparsers(dest="action", required=True)
    verify_parser = commands.add_parser("verify-engine")
    verify_parser.add_argument("--engine-commit", required=True)
    verify_parser.add_argument("--build-dir", required=True)
    configure_parser = commands.add_parser("configure-values")
    configure_parser.add_argument("--engine-commit", required=True)
    configure_parser.add_argument("--build-dir", required=True)
    candidate_parser = commands.add_parser("validate-candidate")
    candidate_parser.add_argument("--engine-commit", required=True)
    candidate_parser.add_argument("--build-dir", required=True)
    candidate_parser.add_argument("--require-compatible", action="store_true")
    candidate_parser.add_argument("--base-commit", default="")
    candidate_parser.add_argument("--base-tree", default="")
    seed_parser = commands.add_parser("seed")
    seed_parser.add_argument("--build-dir", required=True)
    seed_parser.add_argument("--values", required=True)
    seed_parser.add_argument("--destination", required=True)
    for action in ("prepare", "sync"):
        source = commands.add_parser(action)
        source.add_argument("--repo-owner", required=True)
        source.add_argument("--repo-name", required=True)
    commands.add_parser("status")
    promotion_preflight = commands.add_parser("promotion-preflight")
    promotion_preflight.add_argument("--new-engine-commit")
    promotion_preflight.add_argument("--build-operation")
    promotion_preflight.add_argument("--rollback", action="store_true")
    promotion_approve = commands.add_parser("promotion-approve")
    promotion_approve.add_argument("--approval-intent", required=True)
    promotion_approve.add_argument("--approval-signature", required=True)
    promotion_approve.add_argument("--signer-id", required=True)
    promotion_activate = commands.add_parser("promotion-activate")
    promotion_activate.add_argument("--engine-commit", required=True)
    promotion_activate.add_argument("--private-commit", required=True)
    promotion_activate.add_argument("--promotion-receipt", required=True)
    engine_status = commands.add_parser("engine-status")
    engine_status.add_argument("--candidate-engine")
    engine_status.add_argument("--candidate-tree")
    return parser.parse_args(argv)


def main(argv=None):
    args = parse_args(argv)
    try:
        if args.action == "verify-engine":
            verify_engine(args)
        elif args.action == "configure-values":
            configure_values(args)
        elif args.action == "validate-candidate":
            check_candidate(args)
        elif args.action == "seed":
            seed(args)
        elif args.action in {
            "promotion-preflight", "promotion-approve", "promotion-activate",
            "engine-status",
        }:
            if args.action == "engine-status":
                args.action = "status"
            engine_authority(args)
        else:
            authority(args)
    except InstanceError as error:
        die(str(error))
    except KeyboardInterrupt:
        print(file=sys.stderr)
        die("operation interrupted; the values file is either unchanged or complete")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
