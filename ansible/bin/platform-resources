#!/usr/bin/env python3
import argparse
import json
import os
import subprocess
from pathlib import Path
import sys

SCRIPT_PATH = Path(__file__).resolve()
REPO_ROOT = (
    Path("/home/smith/src/klokast/klokast-box")
    if SCRIPT_PATH == Path("/usr/local/sbin/platform-resources")
    else SCRIPT_PATH.parents[2]
)
sys.path.insert(0, str(REPO_ROOT / "ansible" / "lib"))

import platform_resource_model as model
import platform_resource_compiler as compiler
import platform_resource_runtime as runtime


def parse_args():
    parser = argparse.ArgumentParser(
        description="Compile, apply, and verify Klokast platform resources."
    )
    parser.add_argument(
        "--registry",
        default=os.environ.get(
            "KLOKAST_PLATFORM_RESOURCES_REGISTRY",
            "/home/smith/private/klokast/platform-resources.yml",
        ),
        help=(
            "Registry selector. The canonical legacy path selects the active "
            "private-instance source after adoption."
        ),
    )

    parser.add_argument(
        "--app",
        action="append",
        default=[],
        help="Limit to one app name. May be passed more than once.",
    )
    parser.add_argument(
        "--magicdns-suffix",
        default=os.environ.get("KLOKAST_MAGICDNS_SUFFIX", "example.ts.net"),
        help="Tailscale MagicDNS suffix for generated inventories.",
    )
    parser.add_argument(
        "--approved-commit",
        default="",
        help="Required for apply; must equal the checked-out HEAD commit.",
    )
    parser.add_argument(
        "--check",
        action="store_true",
        help="Run the closed one-box apply action in Ansible check mode.",
    )
    parser.add_argument(
        "--inventory-output",
        default="",
        help="Write the compiled app-VM Ansible inventory to this path.",
    )
    parser.add_argument(
        "--box",
        action="append",
        default=[],
        help="Limit shared-guest operations to one box. May be repeated.",
    )
    parser.add_argument(
        "--shared-guest-role",
        action="append",
        default=[],
        choices=model.SHARED_GUEST_ROLES,
        help="Limit shared-guest operations to bak, dmz, or iot. May be repeated.",
    )

    subparsers = parser.add_subparsers(dest="command", required=True)
    subparsers.add_parser("lint", help="Validate manifests and registry only.")
    subparsers.add_parser("show", help="Print the compiled resource plan as JSON.")
    subparsers.add_parser(
        "show-box-configs",
        help="Print compiled per-box infrastructure intent without app resources.",
    )
    subparsers.add_parser("diff", help="Print desired managed resource comments.")
    subparsers.add_parser("apply", help="Apply compiled platform resources.")
    subparsers.add_parser("verify", help="Verify compiled platform resources.")
    subparsers.add_parser("inventory", help="Render compiled app-VM inventory.")
    subparsers.add_parser("grant", help="Print an app-scoped approved grant JSON.")
    subparsers.add_parser(
        "apply-shared-guests",
        help="Apply compiled shared-guest runtime intent on dom0.",
    )
    subparsers.add_parser(
        "verify-shared-guests",
        help="Verify compiled shared-guest runtime intent on dom0.",
    )
    subparsers.add_parser(
        "show-box-access-vars",
        help="Print the closed router variable document for exactly one box.",
    )
    subparsers.add_parser(
        "apply-box-access",
        help="Apply access intent on exactly one selected router.",
    )
    subparsers.add_parser(
        "verify-box-access",
        help="Verify access intent on exactly one selected router.",
    )
    return parser.parse_args()


def show_diff(compiled):
    print("Shared Xen guests:")
    for box, config in sorted((compiled.get("box_configs") or {}).items()):
        for role, guest in sorted((config.get("shared_guests") or {}).items()):
            print(
                f"  {box}-{role} runtime_state="
                f"{guest.get('runtime_state', 'running')}"
            )
    print("Box access capabilities:")
    for box, config in (compiled.get("box_configs") or {}).items():
        access = config.get("access") or {}
        policy = access.get("policy") or {}
        print(
            f"  {box} available={','.join(access.get('available_capabilities') or [])} "
            f"enabled={','.join(access.get('enabled_capabilities') or [])} "
            f"prohibited={','.join(access.get('prohibited_capabilities') or [])} "
            f"policy={','.join(f'{key}:{policy[key]}' for key in sorted(policy))}"
        )
    print("Managed app VMs:")
    for spec in compiled["app_vm_specs"]:
        print(f"  {spec['inventory_hostname']} {spec['site_role']} {spec['node_hostname']} {spec['vm_ipv4_address']}")
    print("Managed app-resource effective files:")
    for item in compiled.get("app_resource_effective_files") or []:
        host = compiler.resource_host_for_effective_file(item)
        owners = ",".join(item.get("owners") or [])
        resources = ",".join(item.get("resources") or [])
        print(
            f"  {host} {item['kind']} {item['key']} "
            f"owners={owners} identity={item['rendered_rule_identity']} resources={resources}"
        )
    print("Managed app-resource claims:")
    for item in compiled.get("app_resource_claims") or []:
        host = compiler.resource_host_for_node_role(item["node"], item["host_role"])
        print(
            f"  {host} {item['app']}:{item['resource']} "
            f"key={item['key']} exclusive={'true' if item.get('exclusive') else 'false'}"
        )
    print("Managed Tailnet declarations:")
    for resource in compiled["tailnet_resources"]:
        print(f"  {resource['app']} {resource['id']} {resource['hostname']} {resource['tag']}")
    print("Managed IoT devices:")
    for device in compiled.get("managed_iot_devices") or []:
        print(
            f"  {device['node']} {device['app']}:{device['resource']} "
            f"{device['hostname']} {device['ipv4_address']} {device['mac']} "
            f"{device['tailnet_tag']}"
        )
    print("Managed Tailnet policy resources:")
    for resource in compiled["tailnet_policy_resources"]:
        print(f"  {resource['app']} {resource['id']} {resource['hostname']} {resource['tag']}")
        for ssh_rule in resource.get("ssh") or []:
            print(
                "    ssh "
                f"{ssh_rule['src']} -> {ssh_rule['dst']} users={','.join(ssh_rule['users'])}"
            )
    print("Managed app-resource cleanup scopes:")
    for item in compiled.get("app_resource_cleanup_scopes") or []:
        print(
            f"  {item['node']} {item['app']} "
            f"roles={','.join(item.get('host_roles') or [])} reason={item.get('reason', '')}"
        )


def assert_command_scope(args):
    if getattr(args, "check", False) and args.command != "apply-box-access":
        model.die("--check is accepted only with apply-box-access")
    if args.command == "grant" and len(args.app) != 1:
        model.die("grant requires exactly one --app")
    if args.command in {
        "show-box-access-vars", "apply-box-access", "verify-box-access"
    }:
        if len(args.box) != 1:
            model.die("box access operations require exactly one --box")
        if args.app or args.shared_guest_role:
            model.die("box access operations do not accept app or shared-guest scope")


def requested_apps_present(compiled, app_filter):
    requested = set(app_filter or [])
    if not requested:
        return
    missing = sorted(requested - set((compiled.get("apps") or {}).keys()))
    if missing:
        model.die(f"registry has no app entry for: {', '.join(missing)}")


def registry_source_input(args):
    try:
        result = subprocess.run(["/usr/local/sbin/platform-registry", "read", "--registry", str(Path(args.registry).expanduser()), "--json"], text=True, capture_output=True, check=False)
        value = json.loads(result.stdout) if result.returncode == 0 else None
    except (OSError, ValueError) as error:
        model.die("verified registry client is unavailable or returned invalid JSON: " + str(error))
    if not isinstance(value, dict) or set(value) != {"schema_version", "kind", "source", "registry_path", "registry_sha256", "registry"} or value.get("kind") != "klokast.registry-read.v1" or value.get("schema_version") != 1:
        model.die("registry source verification failed; use platform-registry on the active controller to inspect the selected source")
    return value


def main():
    args = parse_args()
    if args.approved_commit is None:
        args.approved_commit = subprocess.check_output(["git", "-C", str(REPO_ROOT), "rev-parse", "HEAD"], text=True).strip()
    assert_command_scope(args)
    registry_path = Path(args.registry)
    registry_input = registry_source_input(args)
    box_only_commands = {
        "show-box-configs",
        "apply-shared-guests",
        "verify-shared-guests",
        "show-box-access-vars",
        "apply-box-access",
        "verify-box-access",
    }
    compiled = (
        compiler.compile_box_registry_plan(registry_path, registry_input=registry_input, repo_root=REPO_ROOT)
        if args.command in box_only_commands
        else compiler.compile_registry(registry_path, args.app, registry_input=registry_input, repo_root=REPO_ROOT)
    )
    requested_apps_present(compiled, args.app)
    if args.command == "lint":
        print("platform-resources: lint ok")
        return
    if args.command == "show":
        print(json.dumps(compiled, indent=2, sort_keys=True))
        return
    if args.command == "show-box-configs":
        print(json.dumps(compiled, indent=2, sort_keys=True))
        return
    if args.command == "show-box-access-vars":
        box = compiler.selected_box_access_box(compiled, args.box)
        print(json.dumps(compiler.box_access_router_vars(compiled, box), indent=2, sort_keys=True))
        return
    if args.command == "diff":
        show_diff(compiled)
        return
    if args.command == "inventory":
        if not args.inventory_output:
            model.die("--inventory-output is required for the inventory command")
        runtime.render_app_vm_inventory(compiled, Path(args.inventory_output), args.magicdns_suffix)
        return
    if args.command == "grant":
        runtime.assert_approved_commit(args.approved_commit, repo_root=REPO_ROOT)
        grant = compiler.build_app_grant(compiled, args.app[0], args.approved_commit)
        print(json.dumps(grant, indent=2, sort_keys=True))
        return
    if args.command == "apply-shared-guests":
        runtime.assert_approved_commit(args.approved_commit, repo_root=REPO_ROOT)
        runtime.require_active_controller()
        with runtime.vm_update_installation_lock():
            runtime.run_shared_guests(
                "apply",
                compiled,
                args.magicdns_suffix,
                args.approved_commit,
                requested_boxes=args.box,
                requested_roles=args.shared_guest_role, repo_root=REPO_ROOT
            )
        return
    if args.command == "verify-shared-guests":
        runtime.run_shared_guests(
            "verify",
            compiled,
            args.magicdns_suffix,
            requested_boxes=args.box,
            requested_roles=args.shared_guest_role, repo_root=REPO_ROOT
        )
        return
    if args.command == "apply-box-access":
        runtime.assert_approved_commit(args.approved_commit, repo_root=REPO_ROOT)
        runtime.require_active_controller()
        box = compiler.selected_box_access_box(compiled, args.box)
        runtime.run_box_access(
            "apply", compiled, box, args.magicdns_suffix,
            args.approved_commit, check_mode=args.check, repo_root=REPO_ROOT
        )
        return
    if args.command == "verify-box-access":
        box = compiler.selected_box_access_box(compiled, args.box)
        runtime.run_box_access("verify", compiled, box, args.magicdns_suffix, repo_root=REPO_ROOT)
        return
    if args.command == "apply":
        runtime.assert_approved_commit(args.approved_commit, repo_root=REPO_ROOT)
        runtime.require_active_controller()
        with runtime.vm_update_installation_lock():
            if not args.app:
                runtime.run_shared_guests(
                    "apply",
                    compiled,
                    args.magicdns_suffix,
                    args.approved_commit, repo_root=REPO_ROOT
                )
            runtime.run_ansible(
                "apply",
                compiled,
                args.magicdns_suffix,
                args.approved_commit,
                scope_apps=args.app, repo_root=REPO_ROOT
            )
        return
    if not args.app:
        runtime.run_shared_guests("verify", compiled, args.magicdns_suffix, repo_root=REPO_ROOT)
    runtime.run_ansible("verify", compiled, args.magicdns_suffix, scope_apps=args.app, repo_root=REPO_ROOT)


if __name__ == "__main__":
    main()
