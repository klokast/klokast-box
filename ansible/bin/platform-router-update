#!/usr/bin/env python3
"""Inspect routers, freeze signed APK inputs, and qualify isolated templates."""
import argparse
import datetime as dt
import hashlib
import json
import os
import re
import runpy
from pathlib import Path
import secrets
import sys

REPO = Path(__file__).resolve().parents[2]
sys.path.insert(0, str(REPO / 'ansible/lib'))
import router_updates
import router_legacy_generation
import router_generations
import router_records
import router_personalize
import vm_template_inputs
import router_template_inputs
import platform_update_metadata as upstream
from platform_updates import UpdateError, canonical, timestamp

import router_update_controller as transport

PROFILE = REPO / 'ansible/update-profiles/router-alpine-v1.json'
STATE = Path('/var/lib/klokast/updates/discovery/router')
CACHE = Path('/var/cache/klokast/updates/router')


def accepted_source_at(box, directory, operation, engine, name):
    """Read one exact protected assignment through the checked dom0 reader."""
    args = directory / (name + '-arguments.json')
    transport.write(args, {'router_check_box':box, 'router_check_operation':operation,
                           'router_check_result_dir':str(directory), 'router_check_output':name + '.json'})
    with (directory / (name + '.log')).open('x') as log:
        transport.command(['ansible-playbook', '-vv', '-i', REPO / 'ansible/execution-inventory/hosts',
            REPO / 'ansible/playbooks/74-router-accepted-source.yml', '--limit', box + '-dom0',
            '-e', '@' + str(args)], timeout=180, log=log)
    value = transport.load(directory / (name + '.json'))
    if (value.get('kind') != 'klokast.router-command-result.v1' or
            value.get('box') != box or value.get('action') != 'accepted-source' or
            value.get('engine_commit') != engine or
            not isinstance(value.get('result'), dict) or
            value['result'].get('kind') != 'klokast.router-accepted-source.v1'):
        raise UpdateError('protected router source reader returned a different engine or target')
    return value['result']


def qualify_inspected_legacy(box, inspected, engine):
    """Accept a fresh unadopted inspection or prove an adopted legacy source."""
    directory = Path(inspected['evidence_directory'])
    guest = transport.load(directory / (box + '-router.json'))
    dom0 = transport.load(directory / (box + '-dom0.json'))
    if not dom0['accepted_record_present']:
        if inspected['adoption_findings']:
            raise UpdateError('legacy router source is not ready: ' + ', '.join(inspected['adoption_findings']))
        return guest, dom0, None
    source = accepted_source_at(box, directory, inspected['operation'], engine, 'accepted-source')
    assignment = router_records.assignment(source['assignment'], box)
    generation = router_generations.generation(source['generation'], box)
    router_updates.legacy_live(box=box, assignment=assignment, source=generation,
                               guest=guest, dom0=dom0, now=dt.datetime.now(dt.timezone.utc))
    return guest, dom0, source


def require_accepted_source_unchanged(box, inspected, engine, source):
    if source is not None and accepted_source_at(box, Path(inspected['evidence_directory']),
            inspected['operation'], engine, 'accepted-source-final') != source:
        raise UpdateError('accepted legacy router source changed during qualification')


def check_legacy(box):
    """Make a read-only first-template decision from one adopted legacy source."""
    if not router_updates.match(router_updates.BOX, box):
        raise UpdateError('router check requires an exact box ID')
    transport.require_controller()
    if transport.command(['git', '-C', REPO, 'status', '--porcelain', '--untracked-files=all']).strip():
        raise UpdateError('router check requires a clean public implementation checkout')
    engine = transport.command(['git', '-C', REPO, 'rev-parse', 'HEAD']).strip()
    if transport.approved_engine() != engine:
        raise UpdateError('router check requires the activated signed engine commit')
    os.environ['ANSIBLE_CONFIG'] = str(REPO / 'ansible/ansible.cfg')
    profile = transport.load(PROFILE)
    router_updates.validate_profile(profile)
    with transport.installation_lock():
        inspected = inspect(box)
        directory = Path(inspected['evidence_directory'])
        operation = inspected['operation']

        first = accepted_source_at(box, directory, operation, engine, 'accepted-source')
        assignment = router_records.assignment(first['assignment'], box)
        generation = router_generations.generation(first['generation'], box)
        if first['box'] != box or generation['origin'] != 'legacy':
            raise UpdateError('router check requires one adopted legacy generation')
        observed = dt.datetime.now(dt.timezone.utc)
        guest = transport.load(directory / (box + '-router.json'))
        dom0 = transport.load(directory / (box + '-dom0.json'))
        live = router_updates.legacy_live(box=box, assignment=assignment, source=generation,
                                          guest=guest, dom0=dom0, now=observed)
        def policy_at():
            schedule = json.loads(transport.command(['/usr/bin/doas', '/usr/local/sbin/ksa-apply',
                'vm-update-policy', 'schedule-source']), object_pairs_hook=transport.unique_object)
            if (not isinstance(schedule, dict) or schedule.get('kind') != 'klokast.vm-update-schedule.v1' or
                    type(schedule.get('activated')) is not bool):
                raise UpdateError('router check has no verified Instance update schedule')
            if not schedule['activated']:
                policy, checksum = router_updates.unactivated_diagnostic_policy(schedule, box)
                return schedule, None, policy, checksum
            source = json.loads(transport.command(['/usr/bin/doas', '/usr/local/sbin/ksa-apply',
                'vm-update-policy', 'source-status']), object_pairs_hook=transport.unique_object)
            if (not isinstance(source, dict) or source.get('kind') != 'klokast.vm-update-policy-source.v1' or
                    source.get('engine_commit') != engine or
                    not isinstance(source.get('policy'), dict) or
                    not router_updates.match(router_updates.HASH, source.get('policy_sha256')) or
                    type(source.get('paused')) is not bool):
                raise UpdateError('router check has no exact signed policy source')
            return schedule, source, {**source['policy'],
                'enabled':source['policy'].get('enabled') is True and not source['paused']}, source['policy_sha256']

        schedule, policy_source, effective_policy, policy_sha256 = policy_at()
        metadata = None
        candidates = {}
        try:
            releases, checksum = upstream.fetch_json(profile['release_metadata'])
        except (UpdateError, OSError, ValueError):
            releases = None
        if releases is not None:
            metadata = {'observed_at':router_updates.timestamp(observed), 'sha256':checksum, 'releases':releases}
            branch = None
            try:
                _, eligible = router_updates.available_branches(releases, generation['alpine_branch'], observed,
                                                                effective_policy['branch-delay-days'])
                branch = eligible or generation['alpine_branch']
            except (UpdateError, KeyError, TypeError, ValueError):
                pass  # The pure decision marks malformed metadata as failed.
            if branch is not None:
                try:
                    resolved = resolve(branch)
                    candidates[branch] = {'status':'verified', 'observed_at':router_updates.timestamp(observed),
                        'inputs':transport.load(Path(resolved['inputs_directory']) / 'inputs.json')}
                except (UpdateError, OSError, ValueError) as error:
                    candidates[branch] = {'status':'failed', 'reason':str(error)}
        report = router_updates.check(box=box, role='router',
            accepted={'box':box, 'role':'router', 'generation':generation['record_sha256'], 'legacy':generation},
            live=live, metadata=metadata, candidates=candidates, policy=effective_policy,
            policy_sha256=policy_sha256, profile=profile, engine=engine,
            now=dt.datetime.now(dt.timezone.utc), compare=upstream.compare_versions)
        final_schedule, final_policy_source, _, _ = policy_at()
        if final_schedule != schedule or final_policy_source != policy_source:
            raise UpdateError('router update schedule or signed policy changed during the read-only check')
        if accepted_source_at(box, directory, operation, engine, 'accepted-source-final') != first:
            raise UpdateError('router accepted source changed during the read-only update check')
        if policy_source is None:
            report = router_updates.seal({**{k:v for k,v in report.items() if k != 'report_sha256'},
                'authority':'unactivated-instance-diagnostic', 'replacement_authorized':False}, 'report_sha256')
            if report['status'] in ('update-required', 'unchanged'):
                raise UpdateError('unactivated router diagnostic returned an authority-bearing decision')
        transport.write(directory / 'check.json', report)
        return {'kind':'klokast.router-check-result.v1', 'box':box, 'status':report['status'],
                'reason':report['reason'], 'report_sha256':report['report_sha256'],
                'evidence_directory':str(directory), 'replacement_authorized':False,
                'diagnostic_only':policy_source is None}


def test_candidate_preparation(box, source, template_operation):
    """Prepare and retire one disposable candidate LV; no production authority."""
    if (not router_updates.match(router_updates.BOX, box) or
            not re.fullmatch('[0-9a-f]{24}', template_operation)):
        raise UpdateError('candidate preparation test requires an exact box and template operation')
    transport.require_controller()
    source = Path(source)
    if source.parent != CACHE or not re.fullmatch('[0-9a-f]{24}', source.name):
        raise UpdateError('candidate preparation test requires one frozen controller input directory')
    if transport.command(['git', '-C', REPO, 'status', '--porcelain', '--untracked-files=all']).strip():
        raise UpdateError('candidate preparation test requires a clean public checkout')
    engine = transport.command(['git', '-C', REPO, 'rev-parse', 'HEAD']).strip()
    profile, manifest = transport.load(PROFILE), transport.load(source / 'inputs.json')
    router_updates.validate_inputs(manifest, profile, engine)
    candidate_path = STATE / template_operation / 'candidate.json'
    candidate = transport.load(candidate_path)
    release = router_template_inputs.release(candidate, manifest, profile, engine,
        box, template_operation, approved_engine=engine)
    rendered = render_candidate(box, source)
    personalization = transport.load(Path(rendered['evidence_directory']) / 'personalization.json')
    operation = secrets.token_hex(12)
    work, result = CACHE / ('candidate-test-' + operation), STATE / operation
    work.mkdir(mode=0o700); result.mkdir(mode=0o700)
    job = {'kind':'klokast.router-candidate-job.v1', 'mode':'replacement', 'box':box,
        'role':'router', 'operation_id':operation, 'engine_commit':engine,
        'inputs_sha256':manifest['inputs_sha256'], 'kernel_release':release['kernel_release'],
        'personalization':personalization, 'runtime_packages':release['runtime_packages']}
    import router_candidate
    router_candidate.validate(job)
    transport.write(work / 'candidate-job.json', job)
    guest = REPO / 'ansible/roles/router-candidate-preparation/files/router-candidate-prepare-guest'
    modules = ('router_candidate','router_finalize','router_personalize')
    job_files = {'usr/local/lib/klokast/' + name + '.py':REPO / 'ansible/lib' / (name + '.py') for name in modules}
    job_files['router-candidate-job.json'] = work / 'candidate-job.json'
    boot = vm_template_inputs.bootstrap(source, work / 'boot', guest,
        expected_profile=router_updates.PROFILE, job_files=job_files)
    request = {'kind':'klokast.router-candidate-preparation-test.v1', 'box':box,
        'operation_id':operation, 'engine_commit':engine, 'inputs_sha256':manifest['inputs_sha256'],
        'template_operation':template_operation, 'template_sha256':vm_template_inputs.sha256(candidate_path),
        'job_sha256':router_personalize.digest(job), 'bootstrap':boot}
    transport.write(result / 'arguments.json', {'router_candidate_test_box':box,
        'router_candidate_test_operation':operation, 'router_candidate_test_result_dir':str(result),
        'router_candidate_test_boot_dir':str(work / 'boot'),
        'router_candidate_test_request':request, 'router_candidate_test_job':job})
    os.environ['ANSIBLE_CONFIG'] = str(REPO / 'ansible/ansible.cfg')
    with transport.installation_lock():
        compiled = json.loads(transport.command([REPO / 'ansible/bin/platform-resources', 'show']))
        if compiled['registry_sha256'] != rendered['registry_sha256']:
            raise UpdateError('candidate preparation compiler inputs changed after rendering')
        with (result / 'preparation.log').open('x') as log:
            transport.command(['ansible-playbook', '-vv', '-i', REPO / 'ansible/execution-inventory/hosts',
                REPO / 'ansible/playbooks/74-router-candidate-preparation-test.yml', '--limit', box + '-dom0',
                '-e', '@' + str(result / 'arguments.json')], timeout=1200, log=log)
        evidence = transport.load(result / 'result.json')
        disk = transport.load(result / 'candidate-disk.json')
        lifecycle = transport.load(result / 'lifecycle.json')
        if (evidence.get('kind') != 'klokast.router-candidate-preparation-test-result.v1' or
                evidence.get('box') != box or evidence.get('operation_id') != operation or
                evidence.get('engine_commit') != engine or evidence.get('inputs_sha256') != manifest['inputs_sha256'] or
                evidence.get('success') is not True or evidence.get('production_identity') is not False or
                evidence.get('replacement_authorized') is not False or
                evidence.get('prepared', {}).get('packages') != release['runtime_packages'] or
                evidence['prepared'].get('configuration_files') != {
                    name:hashlib.sha256(content.encode()).hexdigest()
                    for name,content in personalization['files'].items()} or
                disk.get('stage') != 'retired' or disk.get('operation_id') != operation or
                lifecycle.get('stage') != 'retired' or lifecycle.get('operation_id') != operation):
            raise UpdateError('candidate preparation test has incomplete result or exact cleanup evidence')
        if json.loads(transport.command([REPO / 'ansible/bin/platform-resources', 'show'])) != compiled:
            raise UpdateError('candidate preparation compiler inputs changed during native test')
        persist_diagnostic_lvm(box, result)
        return {'kind':'klokast.router-candidate-preparation-test.v1', 'box':box,
                'operation':operation, 'evidence_directory':str(result), 'status':'qualified',
                'production_identity':False, 'replacement_authorized':False}


def adopt_legacy(box):
    """Issue one supervised baseline from fresh evidence on the active controller."""
    if not router_updates.match(router_updates.BOX, box):
        raise UpdateError('router baseline adoption requires an exact box ID')
    transport.require_controller()
    if transport.command(['git', '-C', REPO, 'status', '--porcelain', '--untracked-files=all']).strip():
        raise UpdateError('router baseline adoption requires a clean public implementation checkout')
    engine = transport.command(['git', '-C', REPO, 'rev-parse', 'HEAD']).strip()
    if transport.approved_engine() != engine:
        raise UpdateError('router baseline adoption requires the activated signed engine commit')
    os.environ['ANSIBLE_CONFIG'] = str(REPO / 'ansible/ansible.cfg')
    with transport.installation_lock():
        setup = STATE / secrets.token_hex(12)
        setup.mkdir(mode=0o700)
        with (setup / 'recovery-install.log').open('x') as log:
            transport.command(['ansible-playbook', '-vv', '-i', REPO / 'ansible/execution-inventory/hosts',
                REPO / 'ansible/playbooks/74-router-recovery-setup.yml', '--limit', box + '-dom0'],
                timeout=600, log=log)
        inspected = inspect(box)
        if not inspected['adoption_ready']:
            raise UpdateError('legacy router baseline is blocked: ' + ', '.join(inspected['adoption_findings']))
        directory = Path(inspected['evidence_directory'])
        record = router_legacy_generation.assemble(box=box, operation=inspected['operation'],
            engine_commit=engine, guest=transport.load(directory / (box + '-router.json')),
            dom0=transport.load(directory / (box + '-dom0.json')))
        now = int(dt.datetime.now(dt.timezone.utc).timestamp())
        grant = {'kind':'klokast.router-baseline-grant.v1', 'box':box,
            'operation_id':record['generation_id'], 'engine_commit':engine,
            'generation_sha256':record['record_sha256'], 'inspection_sha256':record['evidence_sha256'],
            'granted_at':now, 'expires_at':now + 300}
        arguments = directory / 'adoption-arguments.json'
        transport.write(arguments, {'router_baseline_box':box, 'router_baseline_operation':inspected['operation'],
                                    'router_baseline_record':record, 'router_baseline_grant':grant})
        with (directory / 'adoption.log').open('x') as log:
            transport.command(['ansible-playbook', '-vv', '-i', REPO / 'ansible/execution-inventory/hosts',
                REPO / 'ansible/playbooks/74-router-baseline-adopt.yml', '--limit', box + '-dom0',
                '-e', '@' + str(arguments)], timeout=300, log=log)
        return {'kind':'klokast.router-baseline-adoption-result.v1', 'box':box,
                'generation_sha256':record['record_sha256'], 'operation':record['generation_id'],
                'evidence_directory':str(directory), 'status':'adopted'}


def inspect(box):
    if not router_updates.match(router_updates.BOX, box):
        raise UpdateError('router inspection requires a valid box ID')
    transport.require_controller()
    os.environ['ANSIBLE_CONFIG'] = str(REPO / 'ansible/ansible.cfg')
    if not STATE.is_dir() or STATE.is_symlink():
        raise UpdateError('install platform-update-discovery before router inspection')
    operation = secrets.token_hex(12)
    directory = STATE / operation
    directory.mkdir(mode=0o700)
    args = directory / 'arguments.json'
    compiled = json.loads(transport.command([REPO / 'ansible/bin/platform-resources', 'show']))
    expected = router_updates.expected_includes(compiled, box)
    compiler = runpy.run_path(str(REPO / 'ansible/bin/platform-resources'))
    box_variables = compiler['box_access_router_vars'](compiled, box)
    transport.write(args, {**box_variables, 'router_update_box': box, 'router_update_result_dir': str(directory),
                           'router_update_expected_includes': expected})
    with (directory / 'inspection.log').open('x') as log:
        transport.command(['ansible-playbook', '-vv', '-i', REPO / 'ansible/execution-inventory/hosts',
                           REPO / 'ansible/playbooks/74-router-update-inspect.yml', '-e', '@' + str(args)],
                          timeout=600, log=log)
    records = {}
    for target in ('dom0', 'router'):
        result = transport.load(directory / (box + '-' + target + '.json'))
        if result.get('box') != box or result.get('target') != target:
            raise UpdateError('router inspection did not return both exact target identities')
        records[target] = result
    findings = router_updates.legacy_baseline_findings(records['router'], records['dom0'], box)
    return {'kind': 'klokast.router-inspection-result.v1', 'box': box,
            'operation': operation, 'evidence_directory': str(directory),
            'status': 'inspected', 'adoption_ready': not findings,
            'adoption_findings': findings, 'adoption_authorized': False}


def resolve(branch):
    transport.require_controller()
    if not CACHE.is_dir() or CACHE.is_symlink():
        raise UpdateError('install platform-update-discovery before router resolution')
    if transport.command(['git', '-C', REPO, 'status', '--porcelain', '--untracked-files=no']).strip():
        raise UpdateError('router input resolution requires a clean public implementation checkout')
    engine = transport.command(['git', '-C', REPO, 'rev-parse', 'HEAD']).strip()
    profile = transport.load(PROFILE)
    router_updates.validate_profile(profile)
    directory = CACHE / secrets.token_hex(12)
    value = vm_template_inputs.freeze(directory, profile, branch, engine,
                                     expected_profile=router_updates.PROFILE,
                                     apk_network_timeout=3)
    router_updates.validate_inputs(value, profile, engine)
    return {'kind': 'klokast.router-resolved-inputs.v1', 'observed_at': timestamp(dt.datetime.now(dt.timezone.utc)),
            'inputs_directory': str(directory), 'inputs_sha256': value['inputs_sha256'],
            'effective_inputs_sha256': router_updates.effective_inputs(value),
            'branch': branch, 'packages': {p['name']: p['version'] for p in value['packages']},
            'replacement_authorized': False}


def build_template(box, source):
    if not router_updates.match(router_updates.BOX, box):
        raise UpdateError('router template requires an exact box ID')
    transport.require_controller()
    source = Path(source)
    if source.parent != CACHE or not router_updates.match(re.compile('[0-9a-f]{24}'), source.name):
        raise UpdateError('router template inputs must select one frozen controller cache directory')
    if transport.command(['git', '-C', REPO, 'status', '--porcelain', '--untracked-files=no']).strip():
        raise UpdateError('router template requires a clean public implementation checkout')
    engine = transport.command(['git', '-C', REPO, 'rev-parse', 'HEAD']).strip()
    os.environ['ANSIBLE_CONFIG'] = str(REPO / 'ansible/ansible.cfg')
    profile = transport.load(PROFILE)
    with transport.installation_lock():
        operation = secrets.token_hex(12)
        work = CACHE / ('build-' + operation)
        result = STATE / operation
        work.mkdir(mode=0o700)
        result.mkdir(mode=0o700)
        manifest, capsule, boot = router_template_inputs.stage(source, work, profile, engine,
            REPO / 'ansible/roles/router-alpine-rootfs/files/router-template-guest')
        transport.write(work / 'request.json', {'kind': 'klokast.router-template-request.v1',
            'box': box, 'role': 'router', 'operation_id': operation,
            'inputs_sha256': manifest['inputs_sha256'], 'capsule': capsule, 'bootstrap': boot})
        args = result / 'arguments.json'
        transport.write(args, {'router_template_box': box, 'router_template_operation': operation,
                              'router_template_input_dir': str(work), 'router_template_result_dir': str(result)})
        with (result / 'build.log').open('x') as log:
            transport.command(['ansible-playbook', '-vv', '-i', REPO / 'ansible/execution-inventory/hosts',
                               REPO / 'ansible/playbooks/74-router-template.yml', '--limit', box + '-dom0',
                               '-e', '@' + str(args)], timeout=5400, log=log)
        candidate = transport.load(result / 'candidate.json')
        approved = transport.approved_engine()
        receipt = None
        if approved == engine:
            receipt = router_template_inputs.release(candidate, manifest, profile, engine,
                                                     box, operation, approved_engine=approved)
            transport.write(result / 'release.json', receipt)
        return {'kind': 'klokast.router-template-result.v1', 'box': box, 'operation': operation,
                'release_sha256': receipt['receipt_sha256'] if receipt else None,
                'evidence_directory': str(result), 'engine_approved': approved == engine,
                'status': 'generic-template-qualified', 'replacement_authorized': False}


def test_state_copy(box, source):
    if not router_updates.match(router_updates.BOX, box):
        raise UpdateError('router copy qualification requires an exact box ID')
    transport.require_controller()
    source = Path(source)
    if source.parent != CACHE or not router_updates.match(re.compile('[0-9a-f]{24}'), source.name):
        raise UpdateError('router copy qualification requires one frozen controller cache directory')
    if transport.command(['git', '-C', REPO, 'status', '--porcelain', '--untracked-files=no']).strip():
        raise UpdateError('router copy qualification requires a clean public implementation checkout')
    engine = transport.command(['git', '-C', REPO, 'rev-parse', 'HEAD']).strip()
    profile = transport.load(PROFILE)
    manifest = transport.load(source / 'inputs.json')
    # A synthetic test can reuse earlier authenticated package inputs. Its
    # result separately records the exact engine that supplies the test code.
    router_updates.validate_inputs(manifest, profile, manifest['engine_commit'])
    os.environ['ANSIBLE_CONFIG'] = str(REPO / 'ansible/ansible.cfg')
    with transport.installation_lock():
        operation = secrets.token_hex(12)
        work, result = CACHE / ('copy-test-' + operation), STATE / operation
        work.mkdir(mode=0o700)
        result.mkdir(mode=0o700)
        files = REPO / 'ansible/roles/router-state-copy/files'
        boot = vm_template_inputs.bootstrap(source, work / 'boot', files / 'router-copy-test-guest',
            expected_profile=router_updates.PROFILE,
            job_files={'usr/local/lib/klokast/router_state.py': REPO / 'ansible/lib/router_state.py',
                       'usr/local/libexec/router-state-copy-guest': files / 'router-state-copy-guest'})
        transport.write(work / 'request.json', {'kind': 'klokast.router-copy-test-request.v1',
            'box': box, 'role': 'router', 'operation_id': operation, 'engine_commit': engine,
            'inputs_sha256': manifest['inputs_sha256'], 'bootstrap': boot})
        args = result / 'arguments.json'
        transport.write(args, {'router_copy_test_box': box, 'router_copy_test_operation': operation,
                              'router_copy_test_input_dir': str(work), 'router_copy_test_result_dir': str(result)})
        with (result / 'copy-test.log').open('x') as log:
            transport.command(['ansible-playbook', '-vv', '-i', REPO / 'ansible/execution-inventory/hosts',
                               REPO / 'ansible/playbooks/74-router-state-copy-test.yml', '--limit', box + '-dom0',
                               '-e', '@' + str(args)], timeout=2200, log=log)
        evidence = transport.load(result / 'result.json')
        if (evidence.get('kind') != 'klokast.router-copy-qualification.v1' or evidence.get('box') != box or
                evidence.get('role') != 'router' or evidence.get('operation_id') != operation or
                evidence.get('engine_commit') != engine or evidence.get('inputs_sha256') != manifest['inputs_sha256'] or
                evidence.get('success') is not True or evidence.get('synthetic_only') is not True or
                evidence.get('phases') != ['seed', 'forward', 'mutate', 'unclean', 'reverse', 'verify'] or
                evidence.get('service_compatibility_verified') is not False or evidence.get('replacement_authorized') is not False):
            raise UpdateError('router copy qualification returned incomplete or different evidence')
        return {**evidence, 'evidence_directory': str(result)}


def render_candidate(box, source):
    if not router_updates.match(router_updates.BOX, box):
        raise UpdateError('router candidate rendering requires an exact box')
    transport.require_controller()
    source = Path(source)
    if source.parent != CACHE or not re.fullmatch('[0-9a-f]{24}', source.name):
        raise UpdateError('router candidate rendering requires one frozen input directory')
    if transport.command(['git', '-C', REPO, 'status', '--porcelain', '--untracked-files=no']).strip():
        raise UpdateError('router candidate rendering requires a clean implementation checkout')
    engine = transport.command(['git', '-C', REPO, 'rev-parse', 'HEAD']).strip()
    profile, manifest = transport.load(PROFILE), transport.load(source / 'inputs.json')
    router_updates.validate_inputs(manifest, profile, manifest['engine_commit'])
    os.environ['ANSIBLE_CONFIG'] = str(REPO / 'ansible/ansible.cfg')
    with transport.installation_lock():
        compiled = json.loads(transport.command([REPO / 'ansible/bin/platform-resources', 'show']))
        includes = router_updates.rendered_includes(compiled, box)
        compiler = runpy.run_path(str(REPO / 'ansible/bin/platform-resources'))
        box_variables = compiler['box_access_router_vars'](compiled, box)
        operation = secrets.token_hex(12)
        result = STATE / operation
        result.mkdir(mode=0o700)
        args = result / 'arguments.json'
        transport.write(args, {**box_variables, 'router_candidate_box': box,
            'router_candidate_result_dir': str(result), 'router_candidate_manifest': manifest,
            'router_candidate_packages': {p['name']: p['version'] for p in manifest['packages']},
            'router_candidate_includes': {k.lstrip('/'): v for k, v in includes.items()}})
        with (result / 'render.log').open('x') as log:
            transport.command(['ansible-playbook', '-vv', '-i', REPO / 'ansible/execution-inventory/hosts',
                REPO / 'ansible/playbooks/74-router-candidate-render.yml', '--limit', box + '-router',
                '-e', '@' + str(args)], timeout=300, log=log)
        import router_personalize
        rendered = transport.load(result / 'personalization.json')
        router_personalize.validate(rendered)
        if (rendered['box'] != box or rendered['inputs_sha256'] != manifest['inputs_sha256'] or
                rendered['packages'] != {p['name']: p['version'] for p in manifest['packages']} or
                any(rendered['files'].get(k.lstrip('/')) != v for k, v in includes.items())):
            raise UpdateError('router personalization differs from the exact selected inputs')
        # The Instance/compiler inputs may not change while rendering is in flight.
        if json.loads(transport.command([REPO / 'ansible/bin/platform-resources', 'show'])) != compiled:
            raise UpdateError('router compiler inputs changed during candidate rendering')
        evidence = {'kind': 'klokast.router-render-result.v1', 'box': box, 'role': 'router',
            'operation_id': operation, 'engine_commit': engine, 'inputs_sha256': manifest['inputs_sha256'],
            'registry_sha256': compiled['registry_sha256'], 'configuration_sha256': router_personalize.digest(rendered),
            'files': {k: hashlib.sha256(v.encode()).hexdigest() for k, v in rendered['files'].items()},
            'replacement_authorized': False}
        transport.write(result / 'render.json', evidence)
        return {**evidence, 'evidence_directory': str(result)}


def test_compatibility(box, source, template_operation):
    if (not router_updates.match(router_updates.BOX, box) or
            not re.fullmatch('[0-9a-f]{24}', template_operation)):
        raise UpdateError('router compatibility requires an exact box and template operation')
    transport.require_controller()
    source = Path(source)
    if source.parent != CACHE or not re.fullmatch('[0-9a-f]{24}', source.name):
        raise UpdateError('router compatibility requires one frozen controller cache directory')
    if transport.command(['git', '-C', REPO, 'status', '--porcelain', '--untracked-files=no']).strip():
        raise UpdateError('router compatibility requires a clean implementation checkout')
    engine = transport.command(['git', '-C', REPO, 'rev-parse', 'HEAD']).strip()
    profile, manifest = transport.load(PROFILE), transport.load(source / 'inputs.json')
    router_updates.validate_inputs(manifest, profile, manifest['engine_commit'])
    candidate_path = STATE / template_operation / 'candidate.json'
    candidate = transport.load(candidate_path)
    # Verify the complete template result without treating this diagnostic
    # software pair as an approved release or a production assignment.
    release = router_template_inputs.release(candidate, manifest, profile, manifest['engine_commit'],
                                            box, template_operation, approved_engine=manifest['engine_commit'])
    with transport.installation_lock():
        inspected = inspect(box)
        router, dom0, accepted = qualify_inspected_legacy(box, inspected, engine)
        disks = [row for row in dom0['logical_volumes']['report'][0]['lv'] if row['lv_path'] == '/dev/vg0/lv_router']
        if len(disks) != 1 or int(disks[0]['lv_size']) != 2147483648 or disks[0]['origin']:
            raise UpdateError('legacy compatibility requires the recorded two GiB router LV')
        operation = secrets.token_hex(12)
        work, result = CACHE / ('compatibility-' + operation), STATE / operation
        work.mkdir(mode=0o700); result.mkdir(mode=0o700)
        guest = {'kind': 'klokast.router-compatibility-request.v1', 'operation_id': operation,
                 'inputs_sha256': manifest['inputs_sha256'], 'box': box,
                 'source_packages': router['packages'], 'source_kernel_release': router['kernel_release'],
                 'source_files': {k.lstrip('/'): v['sha256'] for k, v in {
                     **router['configuration_files'], **router['include_files']}.items()},
                 'fixture': router_template_inputs.personalization_fixture(REPO, manifest), 'manifest': manifest,
                 'runtime_packages': release['runtime_packages'], 'kernel_release': candidate['kernel_release']}
        transport.write(work / 'guest.json', guest)
        files = REPO / 'ansible/roles/router-state-copy/files'
        modules = ('router_service_probe', 'router_state', 'router_personalize', 'router_fixture',
                   'router_compatibility', 'router_finalize', 'router_candidate')
        job_files = {'usr/local/lib/klokast/' + name + '.py': REPO / 'ansible/lib' / (name + '.py') for name in modules}
        job_files.update({'router-compatibility-request.json': work / 'guest.json',
                          'usr/local/libexec/router-state-copy-guest': files / 'router-state-copy-guest'})
        boot = vm_template_inputs.bootstrap(source, work / 'boot', files / 'router-compatibility-guest',
            expected_profile=router_updates.PROFILE, job_files=job_files)
        transport.write(work / 'request.json', {'kind': 'klokast.router-compatibility-host.v1',
            'box': box, 'role': 'router', 'operation_id': operation, 'engine_commit': engine,
            'inputs_sha256': manifest['inputs_sha256'], 'bootstrap': boot,
            'template': {'operation': template_operation, 'sha256': vm_template_inputs.sha256(candidate_path)},
            'guest': guest, 'source': {**{k: dom0[k] for k in ('configuration_sha256', 'xen_runtime', 'boot_artifacts')},
                'disk': {'path': disks[0]['lv_path'], 'uuid': disks[0]['lv_uuid'], 'bytes': int(disks[0]['lv_size'])},
                'accepted': accepted}})
        args = result / 'arguments.json'
        transport.write(args, {'router_compatibility_box': box, 'router_compatibility_operation': operation,
            'router_compatibility_input_dir': str(work), 'router_compatibility_result_dir': str(result)})
        with (result / 'compatibility.log').open('x') as log:
            transport.command(['ansible-playbook', '-vv', '-i', REPO / 'ansible/execution-inventory/hosts',
                REPO / 'ansible/playbooks/74-router-compatibility.yml', '--limit', box + '-dom0',
                '-e', '@' + str(args)], timeout=3400, log=log)
        evidence = transport.load(result / 'result.json')
        if (evidence.get('kind') != 'klokast.router-compatibility-result.v1' or evidence.get('box') != box or
                evidence.get('role') != 'router' or evidence.get('operation_id') != operation or
                evidence.get('engine_commit') != engine or evidence.get('inputs_sha256') != manifest['inputs_sha256'] or
                evidence.get('success') is not True or evidence.get('production_identity') is not False or
                evidence.get('phases') != ['prepare', 'seed', 'forward', 'new', 'reverse', 'old'] or
                evidence.get('candidate_modes') != ['initial-install', 'replacement'] or
                evidence.get('source_packages') != router['packages'] or
                evidence.get('runtime_packages') != release['runtime_packages'] or
                evidence.get('control_plane_rotation_tested') is not False or evidence.get('replacement_authorized') is not False):
            raise UpdateError('router compatibility returned incomplete or different evidence')
        allocation = transport.load(result / 'candidate-disk.json')
        if (allocation.get('kind') != 'klokast.router-candidate-disk.v1' or
                allocation.get('operation_id') != operation or allocation.get('stage') != 'retired' or
                allocation.get('path') != '/dev/vg0/routergen_' + operation or
                allocation.get('tag') != 'routergen_' + operation or
                allocation.get('template_sha256') != candidate['artifacts']['os']['sha256'] or
                not isinstance(allocation.get('uuid'), str) or not re.fullmatch('[A-Za-z0-9-]{1,64}', allocation['uuid']) or
                evidence.get('candidate_disk') != {'path': allocation['path'], 'uuid': allocation['uuid'], 'bytes': 2147483648}):
            raise UpdateError('router candidate LV qualification lacks its exact completed retirement record')
        persist_diagnostic_lvm(box, result)
        require_accepted_source_unchanged(box, inspected, engine, accepted)
        return {**evidence, 'evidence_directory': str(result)}


def persist_diagnostic_lvm(box, result):
    """Persist only reviewed LVM metadata after an exact disposable LV retired."""
    with (Path(result) / 'lbu.log').open('x') as log:
        transport.command(['ansible-playbook', '-i', REPO / 'ansible/execution-inventory/hosts',
            REPO / 'ansible/playbooks/74-router-diagnostic-lbu-commit.yml', '--limit', box + '-dom0',
            '-e', 'router_diagnostic_lbu_box=' + box], timeout=180, log=log)


def test_dom0_guards(box):
    transport.require_controller()
    if transport.command(['git', '-C', REPO, 'status', '--porcelain', '--untracked-files=no']).strip():
        raise UpdateError('router native guard qualification requires a clean public checkout')
    engine = transport.command(['git', '-C', REPO, 'rev-parse', 'HEAD']).strip()
    with transport.installation_lock():
        inspection = inspect(box)
        _, source, accepted = qualify_inspected_legacy(box, inspection, engine)
        operation = secrets.token_hex(12)
        directory = STATE / operation
        directory.mkdir(mode=0o700)
        transport.write(directory / 'request.json', {'kind':'klokast.router-native-guards-request.v1',
            'box':box, 'operation_id':operation, 'engine_commit':engine, 'source':source})
        args = directory / 'arguments.json'
        transport.write(args, {'router_guard_box':box,'router_guard_operation':operation,'router_guard_directory':str(directory)})
        with (directory / 'qualification.log').open('x') as log:
            transport.command(['ansible-playbook','-vv','-i',REPO / 'ansible/execution-inventory/hosts',
                REPO / 'ansible/playbooks/74-router-native-guards-test.yml','--limit',box+'-dom0','-e','@'+str(args)],
                timeout=240,log=log)
        value = transport.load(directory / 'result.json')
        if (value.get('kind') != 'klokast.router-native-guards-result.v1' or value.get('box') != box or
                value.get('operation_id') != operation or value.get('engine_commit') != engine or
                any(value.get(k) is not True for k in ('success','disk_identity_verified','boot_artifacts_verified',
                    'xen_runtime_verified','block_backend_verified','attached_disk_refused')) or
                value.get('router_changed') is not False or value.get('replacement_authorized') is not False):
            raise UpdateError('native router guard qualification returned incomplete or different evidence')
        require_accepted_source_unchanged(box, inspection, engine, accepted)
        return {**value,'evidence_directory':str(directory)}


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    sub = parser.add_subparsers(dest='command', required=True)
    sub.add_parser('inspect', help='collect private baseline evidence without changing router state').add_argument('--box', required=True)
    sub.add_parser('check-legacy', help='check an adopted legacy router for its first approved template').add_argument('--box', required=True)
    sub.add_parser('adopt-legacy', help='inspect and adopt one legacy router under activated authority').add_argument('--box', required=True)
    sub.add_parser('resolve', help='freeze a signed complete package closure in the controller cache').add_argument('--branch', required=True)
    sub.add_parser('test-dom0-guards', help='verify native disk and Xen guards without stopping a router').add_argument('--box', required=True)
    builder = sub.add_parser('build-template', help='build and boot a networkless generic router template; never replace a router')
    builder.add_argument('--box', required=True)
    builder.add_argument('--inputs-directory', required=True)
    copier = sub.add_parser('test-state-copy', help='qualify state copying on new synthetic disks in networkless Xen guests')
    copier.add_argument('--box', required=True)
    copier.add_argument('--inputs-directory', required=True)
    compatibility = sub.add_parser('test-compatibility', help='test native old/new/old services on private networkless copies')
    compatibility.add_argument('--box', required=True)
    compatibility.add_argument('--inputs-directory', required=True)
    compatibility.add_argument('--template-operation', required=True)
    candidate_test = sub.add_parser('test-candidate-preparation', help='qualify and retire one new networkless candidate LV')
    candidate_test.add_argument('--box', required=True)
    candidate_test.add_argument('--inputs-directory', required=True)
    candidate_test.add_argument('--template-operation', required=True)
    renderer = sub.add_parser('render-candidate', help='render private candidate files from current inventory and compiler inputs')
    renderer.add_argument('--box', required=True)
    renderer.add_argument('--inputs-directory', required=True)
    args = parser.parse_args()
    os.umask(0o077)
    try:
        if args.command == 'inspect':
            value = inspect(args.box)
        elif args.command == 'check-legacy':
            value = check_legacy(args.box)
        elif args.command == 'adopt-legacy':
            value = adopt_legacy(args.box)
        elif args.command == 'resolve':
            value = resolve(args.branch)
        elif args.command == 'test-dom0-guards':
            value = test_dom0_guards(args.box)
        elif args.command == 'build-template':
            value = build_template(args.box, args.inputs_directory)
        elif args.command == 'render-candidate':
            value = render_candidate(args.box, args.inputs_directory)
        elif args.command == 'test-compatibility':
            value = test_compatibility(args.box, args.inputs_directory, args.template_operation)
        elif args.command == 'test-candidate-preparation':
            value = test_candidate_preparation(args.box, args.inputs_directory, args.template_operation)
        else:
            value = test_state_copy(args.box, args.inputs_directory)
        print(canonical(value))
        return 0
    except (UpdateError, OSError, ValueError, TypeError, KeyError) as error:
        print('platform-router-update: ' + str(error), file=sys.stderr)
        return 2


if __name__ == '__main__':
    raise SystemExit(main())
