import stat
import sys
import time
import uuid

REPO = Path(__file__).resolve().parents[2]
sys.path.insert(0, str(REPO / 'ansible/lib'))
import router_updates
import router_legacy_generation
import router_generations
import router_records
import router_personalize
import router_initial_contact
import vm_template_inputs
import router_template_inputs
import router_tailscale
import platform_update_metadata as upstream
from platform_updates import UpdateError, canonical, timestamp

import router_update_controller as transport

PROFILE = REPO / 'ansible/update-profiles/router-alpine-v2.json'
STATE = Path('/var/lib/klokast/updates/discovery/router')
CACHE = Path('/var/cache/klokast/updates/router')


def provisioning_status(box):
    """Read protected dom0 state before any first-router allocation."""
    if not router_updates.match(router_updates.BOX, box):
        raise UpdateError('router provisioning status requires an exact box ID')
    transport.require_controller()
    if transport.command(['git', '-C', REPO, 'status', '--porcelain', '--untracked-files=all']).strip():
        raise UpdateError('router provisioning status requires a clean activated engine checkout')
    engine = transport.command(['git', '-C', REPO, 'rev-parse', 'HEAD']).strip()
    if transport.approved_engine() != engine:
        raise UpdateError('router provisioning status requires the activated engine')
    os.environ['ANSIBLE_CONFIG'] = str(REPO / 'ansible/ansible.cfg')
    with transport.installation_lock():
        operation = secrets.token_hex(12)
        result = STATE / operation
        result.mkdir(mode=0o700)
        arguments = result / 'arguments.json'
        transport.write(arguments, {'router_provision_box':box,
                                    'router_provision_operation':operation,
                                    'router_provision_result_dir':str(result)})
        with (result / 'provisioning-status.log').open('x') as log:
            transport.command(['ansible-playbook','-vv','-i',
                REPO / 'ansible/execution-inventory/hosts',
                REPO / 'ansible/playbooks/74-router-provisioning-status.yml',
                '--limit',box + '-dom0','-e','@' + str(arguments)],timeout=300,log=log)
        value = transport.load(result / 'provisioning-status.json')
        status = value.get('result')
        if (value.get('kind') != 'klokast.router-command-result.v1' or
                value.get('box') != box or value.get('action') != 'provisioning-status' or
                value.get('engine_commit') != engine or not isinstance(status,dict) or
                set(status) != {'kind','box','assignment','pending','installation'} or
                status['kind'] != 'klokast.router-provisioning-status.v1' or
                status['box'] != box):
            raise UpdateError('router provisioning status differs from the activated engine or target')
        if status['assignment'] is not None:
            router_records.assignment(status['assignment'],box)
        if status['installation'] is not None:
            router_records.initial_installation.validate(status['installation'],box)
        if status['pending'] is not None:
            raise UpdateError('router provisioning is blocked by a pending replacement')
        return {**status,'evidence_directory':str(result)}


def initial_provision_pointer(box, engine):
    path = STATE / ('initial-provision-' + box + '.json')
    if not path.exists() and not path.is_symlink():
        return path, None
    info = path.lstat()
    if (not stat.S_ISREG(info.st_mode) or info.st_uid != os.geteuid() or
            stat.S_IMODE(info.st_mode) != 0o600 or info.st_nlink != 1):
        raise UpdateError('first router provisioning pointer has unsafe file metadata')
    value = transport.load(path)
    if (not isinstance(value,dict) or set(value) != {'kind','box','engine_commit',
            'operation_id','source_operation','template_operation','selection_sha256',
            'release_sha256','record_sha256'} or
            value['kind'] != 'klokast.router-initial-provision-pointer.v1' or
            value['box'] != box or value['engine_commit'] != engine or
            any(not router_updates.match(re.compile('[0-9a-f]{24}'),value.get(name)) for name in (
                'operation_id','source_operation','template_operation')) or
            any(not router_updates.match(router_updates.HASH,value.get(name)) for name in (
                'selection_sha256','release_sha256'))):
        raise UpdateError('first router provisioning pointer is invalid or selects another engine')
    router_updates.verify_seal(value,field='record_sha256')
    return path, value


def provision_initial_phase(box, phase):
    """Connect one retained first-install operation to provisioning phases 30/31."""
    if (not router_updates.match(router_updates.BOX,box) or phase not in ('prepare','accept')):
        raise UpdateError('initial router provisioning requires an exact box and phase')
    if os.environ.get('KLOKAST_INSTALLATION_LOCK_FD') != '9':
        raise UpdateError('initial router provisioning requires the parent installation lock')
    transport.require_controller()
    if transport.command(['git','-C',REPO,'status','--porcelain','--untracked-files=all']).strip():
        raise UpdateError('initial router provisioning requires a clean activated engine checkout')
    engine = transport.command(['git','-C',REPO,'rev-parse','HEAD']).strip()
    if transport.approved_engine() != engine:
        raise UpdateError('initial router provisioning requires the exact activated engine')
    os.environ['ANSIBLE_CONFIG'] = str(REPO / 'ansible/ansible.cfg')
    with transport.installation_lock():
        # A new dom0 has no transaction reader. Install its boot recovery
        # prerequisite before the first protected status read or router boot.
        setup = STATE / secrets.token_hex(12)
        setup.mkdir(mode=0o700)
        with (setup / 'recovery-install.log').open('x') as log:
            transport.command(['ansible-playbook','-vv','-i',
                REPO / 'ansible/execution-inventory/hosts',
                REPO / 'ansible/playbooks/74-router-recovery-setup.yml',
                '--limit',box + '-dom0'],timeout=600,log=log)
        status = provisioning_status(box)
        if status['assignment'] is not None:
            return {'kind':'klokast.router-initial-provision-phase.v1','box':box,
                    'phase':phase,'status':'accepted-router-preserved',
                    'evidence_directory':status['evidence_directory']}
        path, pointer = initial_provision_pointer(box,engine)
        initial = status['installation']
        if initial is not None and (pointer is None or
                initial['operation_id'] != pointer['operation_id'] or
                initial['engine_commit'] != engine or
                initial['selection_sha256'] != pointer['selection_sha256'] or
                initial['release_sha256'] != pointer['release_sha256']):
            raise UpdateError('recorded first router installation lacks its exact controller pointer')
        if phase == 'prepare':
            if initial is not None and initial['stage'] in ('enrolled','verified'):
                return {'kind':'klokast.router-initial-provision-phase.v1','box':box,
                        'phase':phase,'status':'initial-progress-preserved',
                        'operation_id':pointer['operation_id'],
                        'evidence_directory':status['evidence_directory']}
            if pointer is None:
                selected = resolve_initial()
                template = build_template(box,selected['inputs_directory'],initial_selection=True)
                if (template['engine_approved'] is not True or
                        template['release_sha256'] is None or
                        template['selection_sha256'] != selected['selection_sha256']):
                    raise UpdateError('first router template lacks the selected approved release')
                pointer = router_updates.seal({
                    'kind':'klokast.router-initial-provision-pointer.v1','box':box,
                    'engine_commit':engine,'operation_id':secrets.token_hex(12),
                    'source_operation':Path(selected['inputs_directory']).name,
                    'template_operation':template['operation'],
                    'selection_sha256':selected['selection_sha256'],
                    'release_sha256':template['release_sha256']},field='record_sha256')
                if path.exists() or path.is_symlink():
                    raise UpdateError('first router provisioning pointer appeared during build')
                transport.write(path,pointer)
            prepared = prepare_initial(box,CACHE / pointer['source_operation'],
                                       pointer['template_operation'],pointer['operation_id'])
            status = provisioning_status(box)
            initial = status['installation']
            if (initial is None or initial['operation_id'] != pointer['operation_id'] or
                    initial['stage'] != 'prepared' or status['assignment'] is not None):
                raise UpdateError('router phase 30 lacks its exact retained prepared installation')
            return {'kind':'klokast.router-initial-provision-phase.v1','box':box,
                    'phase':phase,'status':'initial-prepared',
                    'operation_id':pointer['operation_id'],
                    'evidence_directory':prepared['evidence_directory']}
        if pointer is None or initial is None:
            raise UpdateError('router phase 31 requires recorded phase 30 preparation')
        operation = pointer['operation_id']
        if initial['stage'] in ('planned','allocated'):
            raise UpdateError('router phase 31 requires completed phase 30 preparation')
        if initial['stage'] == 'prepared':
            start_initial(box,operation)
            enroll_initial(box,operation)
        if initial['stage'] != 'verified':
            finalize_initial(box,operation)
            boot_final_initial(box,operation)
            verify_initial(box,operation)
        accepted = accept_initial(box,operation)
        final = provisioning_status(box)
        if (final['assignment'] is None or final['installation'] is None or
                final['installation']['stage'] != 'verified' or
                final['installation']['operation_id'] != operation or
                final['assignment']['current_sha256'] != accepted['generation_sha256']):
            raise UpdateError('router phase 31 lacks its exact accepted generation')
        return {'kind':'klokast.router-initial-provision-phase.v1','box':box,
                'phase':phase,'status':'initial-accepted','operation_id':operation,
                'evidence_directory':accepted['evidence_directory']}


def accepted_source_at(box, directory, operation, engine, name):
    """Read one exact protected assignment through the checked dom0 reader."""
    args = directory / (name + '-arguments.json')
    transport.write(args, {'router_check_box':box, 'router_check_operation':operation,
                           'router_check_result_dir':str(directory), 'router_check_output':name + '.json'})
    with (directory / (name + '.log')).open('x') as log:
        transport.command(['ansible-playbook', '-vv', '-i', REPO / 'ansible/execution-inventory/hosts',
            REPO / 'ansible/playbooks/74-router-accepted-source.yml', '--limit', box + '-dom0',
            '-e', '@' + str(args)], timeout=180, log=log)
    value = transport.load(directory / (name + '.json'))
    if (value.get('kind') != 'klokast.router-command-result.v1' or
            value.get('box') != box or value.get('action') != 'accepted-source' or
            value.get('engine_commit') != engine or
            not isinstance(value.get('result'), dict) or
            value['result'].get('kind') != 'klokast.router-accepted-source.v1'):
        raise UpdateError('protected router source reader returned a different engine or target')
    return value['result']


def qualify_inspected_legacy(box, inspected, engine):
    """Accept a fresh unadopted inspection or prove an adopted legacy source."""
    directory = Path(inspected['evidence_directory'])
    guest = transport.load(directory / (box + '-router.json'))
    dom0 = transport.load(directory / (box + '-dom0.json'))
    if not dom0['accepted_record_present']:
        if inspected['adoption_findings']:
            raise UpdateError('legacy router source is not ready: ' + ', '.join(inspected['adoption_findings']))
        return guest, dom0, None
    source = accepted_source_at(box, directory, inspected['operation'], engine, 'accepted-source')
    assignment = router_records.assignment(source['assignment'], box)
    generation = router_generations.generation(source['generation'], box)
    router_updates.legacy_live(box=box, assignment=assignment, source=generation,
                               guest=guest, dom0=dom0, now=dt.datetime.now(dt.timezone.utc))
    return guest, dom0, source


def qualify_compatibility_source(box, inspected, engine):
    """Verify the live legacy or template source before an isolated DHCP test."""
    directory = Path(inspected['evidence_directory'])
    guest = transport.load(directory / (box + '-router.json'))
    dom0 = transport.load(directory / (box + '-dom0.json'))
    if not dom0['accepted_record_present']:
        return qualify_inspected_legacy(box, inspected, engine)
    source = accepted_source_at(box, directory, inspected['operation'], engine, 'accepted-source')
    assignment = router_records.assignment(source['assignment'], box)
    generation = router_generations.generation(source['generation'], box)
    if generation['origin'] == 'legacy':
        router_updates.legacy_live(box=box, assignment=assignment, source=generation,
                                   guest=guest, dom0=dom0, now=dt.datetime.now(dt.timezone.utc))
    else:
        template = STATE / generation['template_operation']
        historical_profile = transport.load(template / 'profile.json')
        release = transport.load(template / 'release.json')
        candidate = transport.load(template / 'candidate.json')
        router_updates.accepted_template_release(box=box, generation=generation,
            release=release, template_operation=generation['template_operation'],
            profile=historical_profile)
        if router_template_inputs.release(candidate, release['inputs'], historical_profile,
                generation['engine_commit'], box, generation['template_operation'],
                approved_engine=generation['engine_commit'], historical=True) != release:
            raise UpdateError('accepted template release differs from its native build evidence')
        arguments = directory / 'accepted-verification-arguments.json'
        transport.write(arguments, {'router_update_box':box})
        with (directory / 'accepted-verification.log').open('x') as log:
            transport.command(['ansible-playbook','-vv','-i',
                REPO / 'ansible/execution-inventory/hosts',
                REPO / 'ansible/playbooks/74-router-accepted-verification.yml',
                '--limit',box+'-router','-e','@'+str(arguments)], timeout=600, log=log)
        guest = transport.load(directory / (box + '-router.json'))
        dom0 = transport.load(directory / (box + '-dom0.json'))
        router_updates.template_live(box=box, assignment=assignment, source=generation,
            guest=guest, dom0=dom0, now=dt.datetime.now(dt.timezone.utc),
            accepted_manifest_verified=True)
    return guest, dom0, source


def require_accepted_source_unchanged(box, inspected, engine, source):
    if source is not None and accepted_source_at(box, Path(inspected['evidence_directory']),
            inspected['operation'], engine, 'accepted-source-final') != source:
        raise UpdateError('accepted router source changed during qualification')


def check_policy_at(box, engine):
    """Read one verified Instance schedule and effective router check policy."""
    schedule = json.loads(transport.command(['/usr/bin/doas', '/usr/local/sbin/ksa-apply',
        'vm-update-policy', 'schedule-source']), object_pairs_hook=transport.unique_object)
    if (not isinstance(schedule, dict) or schedule.get('kind') != 'klokast.vm-update-schedule.v1' or
            type(schedule.get('activated')) is not bool):
        raise UpdateError('router check has no verified Instance update schedule')
    if not schedule['activated']:
        policy, checksum = router_updates.unactivated_diagnostic_policy(schedule, box)
        return schedule, None, policy, checksum
    source = json.loads(transport.command(['/usr/bin/doas', '/usr/local/sbin/ksa-apply',
        'vm-update-policy', 'source-status']), object_pairs_hook=transport.unique_object)
    if (not isinstance(source, dict) or source.get('kind') != 'klokast.vm-update-policy-source.v1' or
            source.get('engine_commit') != engine or
            not isinstance(source.get('policy'), dict) or
            not router_updates.match(router_updates.HASH, source.get('policy_sha256')) or
            type(source.get('paused')) is not bool):
        raise UpdateError('router check has no exact signed policy source')
    return schedule, source, {**source['policy'],
        'enabled':source['policy'].get('enabled') is True and not source['paused']}, source['policy_sha256']


def check_upstream_candidates(profile, generation, policy, observed):
    metadata = None
    candidates = {}
    sources = {}
    try:
        releases, checksum = upstream.fetch_json(profile['release_metadata'])
    except (UpdateError, OSError, ValueError):
        releases = None
    if releases is not None:
        metadata = {'observed_at':router_updates.timestamp(observed),
                    'sha256':checksum, 'releases':releases}
        branch = None
        try:
            _, eligible = router_updates.available_branches(releases, generation['alpine_branch'], observed,
                                                            policy['branch-delay-days'])
            branch = eligible or generation['alpine_branch']
        except (UpdateError, KeyError, TypeError, ValueError):
            pass  # The pure decision marks malformed metadata as failed.
        if branch is not None:
            try:
                resolved = resolve(branch)
                candidates[branch] = {'status':'verified', 'observed_at':router_updates.timestamp(observed),
                    'inputs':transport.load(Path(resolved['inputs_directory']) / 'inputs.json')}
                sources[branch] = resolved['inputs_directory']
            except (UpdateError, OSError, ValueError) as error:
                candidates[branch] = {'status':'failed', 'reason':str(error)}
    return metadata, candidates, sources


def record_check_source(directory, report, candidates, sources, *, box, engine, policy):
    """Retain the exact frozen inputs selected by an authorized update decision."""
    if report['status'] != 'update-required':
        return
    branch = report['selected_branch']
    source = Path(sources.get(branch, ''))
    if (source.parent != CACHE or not re.fullmatch('[0-9a-f]{24}', source.name) or
            branch not in candidates or candidates[branch].get('status') != 'verified'):
        raise UpdateError('router update decision has no exact frozen input source')
    inputs = transport.load(source / 'inputs.json')
    if inputs != candidates[branch]['inputs']:
        raise UpdateError('router update source changed after the read-only decision')
    profile = transport.load(PROFILE)
    router_updates.validate_inputs(inputs, profile, engine)
    router_updates.require_preparation(report, box=box,
        policy_sha256=report['policy_sha256'], accepted_sha256=report['accepted_sha256'],
        inputs=inputs, now=dt.datetime.now(dt.timezone.utc),
        max_age_hours=policy['report-max-age-hours'])
    transport.write(directory / 'candidate-source.json', {
        'kind':'klokast.router-check-source.v1', 'box':box,
        'report_sha256':report['report_sha256'], 'source_operation':source.name,
        'inputs_sha256':inputs['inputs_sha256'], 'engine_commit':engine})


def preflight_replacement(box, check_operation):
    """Recheck saved replacement inputs without allocating or starting a guest."""
    if (not router_updates.match(router_updates.BOX, box) or
            not re.fullmatch('[0-9a-f]{24}', check_operation)):
        raise UpdateError('router replacement preflight requires an exact box and check operation')
    transport.require_controller()
    if transport.command(['git','-C',REPO,'status','--porcelain','--untracked-files=all']).strip():
        raise UpdateError('router replacement preflight requires a clean activated engine checkout')
    engine = transport.command(['git','-C',REPO,'rev-parse','HEAD']).strip()
    if transport.approved_engine() != engine:
        raise UpdateError('router replacement preflight requires the exact activated engine')
    os.environ['ANSIBLE_CONFIG'] = str(REPO / 'ansible/ansible.cfg')
    checked = STATE / check_operation
    profile = transport.load(PROFILE)
    router_updates.validate_profile(profile)
    with transport.installation_lock():
        info = checked.lstat()
        if (not stat.S_ISDIR(info.st_mode) or info.st_uid != os.geteuid() or
                stat.S_IMODE(info.st_mode) != 0o700):
            raise UpdateError('router replacement check directory is unsafe')
        report = transport.load(checked / 'check.json')
        binding = transport.load(checked / 'candidate-source.json')
        router_updates.closed(binding,
            'kind box report_sha256 source_operation inputs_sha256 engine_commit',
            'router checked source')
        source_operation = binding['source_operation']
        if not isinstance(source_operation,str) or not re.fullmatch('[0-9a-f]{24}', source_operation):
            raise UpdateError('router replacement check has no exact frozen input operation')
        frozen = CACHE / source_operation
        info = frozen.lstat()
        if (not stat.S_ISDIR(info.st_mode) or info.st_uid != os.geteuid() or
                stat.S_IMODE(info.st_mode) != 0o700):
            raise UpdateError('router replacement input directory is unsafe')
        inputs = transport.load(frozen / 'inputs.json')
        evidence = STATE / secrets.token_hex(12)
        evidence.mkdir(mode=0o700)
        current = accepted_source_at(box,evidence,evidence.name,engine,'replacement-source')
        assignment = router_records.assignment(current['assignment'],box)
        generation = router_generations.generation(current['generation'],box)
        if (current['box'] != box or assignment['current_sha256'] != generation['record_sha256']):
            raise UpdateError('router replacement source differs from its accepted assignment')
        historical = None
        historical_profile = None
        release = None
        if generation['origin'] == 'template':
            historical = STATE / generation['template_operation']
            historical_profile = transport.load(historical / 'profile.json')
            release = transport.load(historical / 'release.json')
            router_updates.accepted_template_release(box=box,generation=generation,
                release=release,template_operation=generation['template_operation'],
                profile=historical_profile)
            accepted = {'box':box,'role':'router','generation':generation['record_sha256'],
                        'release':release}
        else:
            accepted = {'box':box,'role':'router','generation':generation['record_sha256'],
                        'legacy':generation}
        schedule, policy_source, policy, policy_sha256 = check_policy_at(box,engine)
        if not schedule['activated'] or policy_source is None:
            raise UpdateError('router replacement requires an active signed standing policy')
        router_updates.require_checked_source(binding,report,inputs,profile,
            box=box,engine=engine,policy=policy,policy_sha256=policy_sha256,
            accepted=accepted,now=dt.datetime.now(dt.timezone.utc))
        if (accepted_source_at(box,evidence,evidence.name,engine,'replacement-source-final') != current or
                check_policy_at(box,engine) != (schedule,policy_source,policy,policy_sha256) or
                transport.approved_engine() != engine or transport.load(PROFILE) != profile or
                transport.load(checked / 'check.json') != report or
                transport.load(checked / 'candidate-source.json') != binding or
                transport.load(frozen / 'inputs.json') != inputs or
                historical is not None and (
                    transport.load(historical / 'profile.json') != historical_profile or
                    transport.load(historical / 'release.json') != release)):
            raise UpdateError('router replacement source, policy, or frozen inputs changed during preflight')
        return {'kind':'klokast.router-replacement-source-preflight.v1','box':box,
                'check_operation':check_operation,'source_operation':source_operation,
                'accepted_generation_sha256':generation['record_sha256'],
                'report_sha256':report['report_sha256'],
                'evidence_directory':str(evidence),'status':'validated-input-source',
                'replacement_authorized':False}


def replacement_context(box, check_operation, engine, profile, evidence, label):
    """Recheck signed source and fresh running-router evidence under the install lock."""
    checked = STATE / check_operation
    info = checked.lstat()
    if (not stat.S_ISDIR(info.st_mode) or info.st_uid != os.geteuid() or
            stat.S_IMODE(info.st_mode) != 0o700):
        raise UpdateError('replacement check directory is unsafe')
    report = transport.load(checked / 'check.json')
    binding = transport.load(checked / 'candidate-source.json')
    router_updates.closed(binding,
        'kind box report_sha256 source_operation inputs_sha256 engine_commit',
        'router checked source')
    source_operation = binding['source_operation']
    if not isinstance(source_operation,str) or not re.fullmatch('[0-9a-f]{24}',source_operation):
        raise UpdateError('replacement has no exact frozen input operation')
    frozen = CACHE / source_operation
    info = frozen.lstat()
    if (not stat.S_ISDIR(info.st_mode) or info.st_uid != os.geteuid() or
            stat.S_IMODE(info.st_mode) != 0o700):
        raise UpdateError('replacement frozen input directory is unsafe')
    inputs = transport.load(frozen / 'inputs.json')
    observed = accepted_source_at(box,evidence,evidence.name,engine,label + '-accepted')
    assignment = router_records.assignment(observed['assignment'],box)
    generation = router_generations.generation(observed['generation'],box)
    if (observed['box'] != box or assignment['current_sha256'] != generation['record_sha256'] or
            observed.get('pending') is not None):
        raise UpdateError('replacement source differs from the accepted router or has a pending cutover')
    historical_profile = {}
    if generation['origin'] == 'template':
        historical = STATE / generation['template_operation']
        historical_profile = transport.load(historical / 'profile.json')
        release = transport.load(historical / 'release.json')
        candidate = transport.load(historical / 'candidate.json')
        router_updates.accepted_template_release(box=box,generation=generation,
            release=release,template_operation=generation['template_operation'],
            profile=historical_profile)
        if router_template_inputs.release(candidate,release['inputs'],historical_profile,
                generation['engine_commit'],box,generation['template_operation'],
                approved_engine=generation['engine_commit'],historical=True) != release:
            raise UpdateError('replacement source has no exact native accepted template release')
        accepted = {'box':box,'role':'router','generation':generation['record_sha256'],
                    'release':release}
    else:
        accepted = {'box':box,'role':'router','generation':generation['record_sha256'],
                    'legacy':generation}
    schedule,policy_source,policy,policy_sha256 = check_policy_at(box,engine)
    if not schedule['activated'] or policy_source is None:
        raise UpdateError('replacement requires an active signed standing policy')
    router_updates.require_checked_source(binding,report,inputs,profile,
        box=box,engine=engine,policy=policy,policy_sha256=policy_sha256,
        accepted=accepted,now=dt.datetime.now(dt.timezone.utc))
    inspected = inspect(box)
    directory = Path(inspected['evidence_directory'])
    guest = transport.load(directory / (box + '-router.json'))
    dom0 = transport.load(directory / (box + '-dom0.json'))
    if generation['origin'] == 'template':
        args = directory / (label + '-verification-arguments.json')
        transport.write(args,{'router_update_box':box})
        with (directory / (label + '-verification.log')).open('x') as log:
            transport.command(['ansible-playbook','-vv','-i',
                REPO / 'ansible/execution-inventory/hosts',
                REPO / 'ansible/playbooks/74-router-accepted-verification.yml',
                '--limit',box+'-router','-e','@'+str(args)],timeout=600,log=log)
        live = router_updates.template_live(box=box,assignment=assignment,
            source=generation,guest=guest,dom0=dom0,
            now=dt.datetime.now(dt.timezone.utc),accepted_manifest_verified=True)
    else:
        live = router_updates.legacy_live(box=box,assignment=assignment,
            source=generation,guest=guest,dom0=dom0,now=dt.datetime.now(dt.timezone.utc))
    overlay_source = signed_overlay_source(box) if live['overlay_ipv6_enabled'] is True else None
    if (live['configuration_verified'] is not True or
            live['overlay_ipv6_enabled'] is True and (
                overlay_source is None or live['overlay_source_sha256'] != overlay_source['source_sha256']) or
            live['overlay_ipv6_enabled'] is False and live.get('overlay_source_sha256') is not None):
        raise UpdateError('replacement cannot reconstruct the inspected router configuration')
    if (accepted_source_at(box,directory,inspected['operation'],engine,
            label + '-accepted-final') != observed or
            check_policy_at(box,engine) != (schedule,policy_source,policy,policy_sha256) or
            transport.load(PROFILE) != profile or
            transport.load(checked / 'check.json') != report or
            transport.load(checked / 'candidate-source.json') != binding or
            transport.load(frozen / 'inputs.json') != inputs or
            generation['origin'] == 'template' and (
                transport.load(historical / 'profile.json') != historical_profile or
                transport.load(historical / 'release.json') != release or
                transport.load(historical / 'candidate.json') != candidate) or
            transport.approved_engine() != engine):
        raise UpdateError('replacement source, policy, or live router changed during inspection')
    return {'report':report,'binding':binding,'inputs':inputs,'frozen':frozen,
            'assignment':assignment,'generation':generation,'accepted':accepted,
            'accepted_profile':historical_profile,'policy':policy,
            'policy_sha256':policy_sha256,'live':live,
            'overlay_source':overlay_source,
            'old_machine_id':guest['machine_id']}


def check_legacy(box):
    """Make a read-only first-template decision from one adopted legacy source."""
    if not router_updates.match(router_updates.BOX, box):
        raise UpdateError('router check requires an exact box ID')
    transport.require_controller()
    if transport.command(['git', '-C', REPO, 'status', '--porcelain', '--untracked-files=all']).strip():
        raise UpdateError('router check requires a clean public implementation checkout')
    engine = transport.command(['git', '-C', REPO, 'rev-parse', 'HEAD']).strip()
    if transport.approved_engine() != engine:
        raise UpdateError('router check requires the activated signed engine commit')
    os.environ['ANSIBLE_CONFIG'] = str(REPO / 'ansible/ansible.cfg')
    profile = transport.load(PROFILE)
    router_updates.validate_profile(profile)
    with transport.installation_lock():
        inspected = inspect(box)
        directory = Path(inspected['evidence_directory'])
        operation = inspected['operation']

        first = accepted_source_at(box, directory, operation, engine, 'accepted-source')
        assignment = router_records.assignment(first['assignment'], box)
        generation = router_generations.generation(first['generation'], box)
        if first['box'] != box or generation['origin'] != 'legacy':
            raise UpdateError('router check requires one adopted legacy generation')
        observed = dt.datetime.now(dt.timezone.utc)
        guest = transport.load(directory / (box + '-router.json'))
        dom0 = transport.load(directory / (box + '-dom0.json'))
        live = router_updates.legacy_live(box=box, assignment=assignment, source=generation,
                                          guest=guest, dom0=dom0, now=observed)
        schedule, policy_source, effective_policy, policy_sha256 = check_policy_at(box, engine)
        metadata, candidates, sources = check_upstream_candidates(profile, generation, effective_policy, observed)
        report = router_updates.check(box=box, role='router',
            accepted={'box':box, 'role':'router', 'generation':generation['record_sha256'], 'legacy':generation},
            live=live, metadata=metadata, candidates=candidates, policy=effective_policy,
            policy_sha256=policy_sha256, profile=profile, engine=engine,
            now=dt.datetime.now(dt.timezone.utc), compare=upstream.compare_versions)
        final_schedule, final_policy_source, _, _ = check_policy_at(box, engine)
        if final_schedule != schedule or final_policy_source != policy_source:
            raise UpdateError('router update schedule or signed policy changed during the read-only check')
        if accepted_source_at(box, directory, operation, engine, 'accepted-source-final') != first:
            raise UpdateError('router accepted source changed during the read-only update check')
        if policy_source is None:
            report = router_updates.seal({**{k:v for k,v in report.items() if k != 'report_sha256'},
                'authority':'unactivated-instance-diagnostic', 'replacement_authorized':False}, 'report_sha256')
            if report['status'] in ('update-required', 'unchanged'):
                raise UpdateError('unactivated router diagnostic returned an authority-bearing decision')
        if policy_source is not None:
            record_check_source(directory, report, candidates, sources,
                                box=box, engine=engine, policy=effective_policy)
        transport.write(directory / 'check.json', report)
        return {'kind':'klokast.router-check-result.v1', 'box':box, 'status':report['status'],
                'reason':report['reason'], 'report_sha256':report['report_sha256'],
                'evidence_directory':str(directory), 'replacement_authorized':False,
                'diagnostic_only':policy_source is None}


def check_template(box):
    """Check one accepted template router against its recorded release and live state."""
    if not router_updates.match(router_updates.BOX, box):
        raise UpdateError('router check requires an exact box ID')
    transport.require_controller()
    if transport.command(['git', '-C', REPO, 'status', '--porcelain', '--untracked-files=all']).strip():
        raise UpdateError('router check requires a clean public implementation checkout')
    engine = transport.command(['git', '-C', REPO, 'rev-parse', 'HEAD']).strip()
    if transport.approved_engine() != engine:
        raise UpdateError('router check requires the activated signed engine commit')
    os.environ['ANSIBLE_CONFIG'] = str(REPO / 'ansible/ansible.cfg')
    profile = transport.load(PROFILE)
    router_updates.validate_profile(profile)
    with transport.installation_lock():
        inspected = inspect(box)
        directory = Path(inspected['evidence_directory'])
        operation = inspected['operation']
        first = accepted_source_at(box, directory, operation, engine, 'accepted-source')
        assignment = router_records.assignment(first['assignment'], box)
        generation = router_generations.generation(first['generation'], box)
        if first['box'] != box or generation['origin'] != 'template':
            raise UpdateError('router check requires one accepted template generation')
        template = STATE / generation['template_operation']
        historical_profile = transport.load(template / 'profile.json')
        release = transport.load(template / 'release.json')
        candidate = transport.load(template / 'candidate.json')
        router_updates.accepted_template_release(box=box, generation=generation,
            release=release, template_operation=generation['template_operation'],
            profile=historical_profile)
        if router_template_inputs.release(candidate, release['inputs'], historical_profile,
                generation['engine_commit'], box, generation['template_operation'],
                approved_engine=generation['engine_commit'], historical=True) != release:
            raise UpdateError('accepted template release differs from its native build evidence')
        arguments = directory / 'accepted-verification-arguments.json'
        transport.write(arguments, {'router_update_box':box})
        with (directory / 'accepted-verification.log').open('x') as log:
            transport.command(['ansible-playbook','-vv','-i',
                REPO / 'ansible/execution-inventory/hosts',
                REPO / 'ansible/playbooks/74-router-accepted-verification.yml',
                '--limit',box+'-router','-e','@'+str(arguments)], timeout=600, log=log)
        observed = dt.datetime.now(dt.timezone.utc)
        guest = transport.load(directory / (box + '-router.json'))
        dom0 = transport.load(directory / (box + '-dom0.json'))
        live = router_updates.template_live(box=box, assignment=assignment,
            source=generation, guest=guest, dom0=dom0, now=observed,
            accepted_manifest_verified=True)
        schedule, policy_source, effective_policy, policy_sha256 = check_policy_at(box, engine)
        metadata, candidates, sources = check_upstream_candidates(profile, generation, effective_policy, observed)
        report = router_updates.check(box=box, role='router',
            accepted={'box':box, 'role':'router', 'generation':generation['record_sha256'],
                      'release':release}, live=live, metadata=metadata, candidates=candidates,
            policy=effective_policy, policy_sha256=policy_sha256, profile=profile,
            accepted_profile=historical_profile, engine=engine,
            now=dt.datetime.now(dt.timezone.utc), compare=upstream.compare_versions)
        final_schedule, final_policy_source, _, _ = check_policy_at(box, engine)
        if final_schedule != schedule or final_policy_source != policy_source:
            raise UpdateError('router update schedule or signed policy changed during the read-only check')
        if accepted_source_at(box, directory, operation, engine, 'accepted-source-final') != first:
            raise UpdateError('router accepted source changed during the read-only update check')
        if (transport.approved_engine() != engine or transport.load(PROFILE) != profile or
                transport.load(template / 'profile.json') != historical_profile or
                transport.load(template / 'release.json') != release or
                transport.load(template / 'candidate.json') != candidate):
            raise UpdateError('router check engine, profile, or accepted release changed during inspection')
        if policy_source is None:
            report = router_updates.seal({**{k:v for k,v in report.items() if k != 'report_sha256'},
                'authority':'unactivated-instance-diagnostic', 'replacement_authorized':False}, 'report_sha256')
            if report['status'] in ('update-required', 'unchanged'):
                raise UpdateError('unactivated router diagnostic returned an authority-bearing decision')
        if policy_source is not None:
            record_check_source(directory, report, candidates, sources,
                                box=box, engine=engine, policy=effective_policy)
        transport.write(directory / 'check.json', report)
        return {'kind':'klokast.router-check-result.v1', 'box':box, 'status':report['status'],
                'reason':report['reason'], 'report_sha256':report['report_sha256'],
                'evidence_directory':str(directory), 'replacement_authorized':False,
                'diagnostic_only':policy_source is None}


def first_contact_details(personalization):
    key_path = Path.home() / '.ssh/github-klokast-codex.pub'
    try:
        key_info = key_path.lstat()
        if (not stat.S_ISREG(key_info.st_mode) or key_info.st_nlink != 1 or
                key_info.st_uid != os.getuid() or key_info.st_mode & 0o022 or
                not 0 < key_info.st_size <= 4096):
            raise UpdateError('controller first-contact public key is unsafe')
        key = key_path.read_text().strip()
    except OSError as error:
        raise UpdateError('controller first-contact public key is unavailable') from error
    interfaces = personalization['files'].get('etc/network/interfaces', '')
    backend_address, backend_prefix = router_initial_contact.backend_interface(interfaces)
    topology = runpy.run_path(str(REPO / 'ansible/bin/platform-resources'))['load_topology']()
    source_address = topology['zones'].get('bak', {}).get('dom0_ipv4_address')
    if not isinstance(source_address, str):
        raise UpdateError('approved router topology lacks the dom0 backend source address')
    return {'key':key, 'backend_address':backend_address,
                     'backend_prefix':backend_prefix,
                     'backend_source_address':source_address}


def candidate_boot(source, work):
    guest = REPO / 'ansible/roles/router-candidate-preparation/files/router-candidate-prepare-guest'
    modules = ('router_candidate','router_finalize','router_personalize','router_overlay_ipv6',
               'router_initial_contact','router_state')
    job_files = {'usr/local/lib/klokast/' + name + '.py':REPO / 'ansible/lib' / (name + '.py') for name in modules}
    job_files['router-candidate-job.json'] = work / 'candidate-job.json'
    return vm_template_inputs.bootstrap(source, work / 'boot', guest,
        expected_profile=router_updates.PROFILE, job_files=job_files)


def replacement_finalizer_boot(source, final):
    """Freeze B's networkless cleanup code before its enrollment can begin."""
    guest = REPO / 'ansible/roles/router-replacement-finalization/files/router-replacement-finalize-guest'
    modules = ('router_candidate','router_finalize','router_personalize','router_overlay_ipv6',
               'router_initial_contact','router_state')
    job_files = {'usr/local/lib/klokast/' + name + '.py':
                 REPO / 'ansible/lib' / (name + '.py') for name in modules}
    return vm_template_inputs.bootstrap(source, final / 'boot', guest,
        expected_profile=router_updates.PROFILE, job_files=job_files)


def test_candidate_preparation(box, source, template_operation, mode='replacement',
                               signed_overlay=False):
    """Prepare and retire one disposable candidate LV; no production authority."""
    if (not router_updates.match(router_updates.BOX, box) or
            not re.fullmatch('[0-9a-f]{24}', template_operation) or
            mode not in ('initial-install', 'replacement')):
        raise UpdateError('candidate preparation test requires an exact box, template operation, and mode')
    transport.require_controller()
    source = Path(source)
    if source.parent != CACHE or not re.fullmatch('[0-9a-f]{24}', source.name):
        raise UpdateError('candidate preparation test requires one frozen controller input directory')
    if transport.command(['git', '-C', REPO, 'status', '--porcelain', '--untracked-files=all']).strip():
        raise UpdateError('candidate preparation test requires a clean public checkout')
    engine = transport.command(['git', '-C', REPO, 'rev-parse', 'HEAD']).strip()
    profile, manifest = transport.load(PROFILE), transport.load(source / 'inputs.json')
    router_updates.validate_inputs(manifest, profile, engine)
    candidate_path = STATE / template_operation / 'candidate.json'
    candidate = transport.load(candidate_path)
    release = router_template_inputs.release(candidate, manifest, profile, engine,
        box, template_operation, approved_engine=engine)
    overlay_source = signed_overlay_source(box) if signed_overlay else None
    rendered = render_candidate(box, source, overlay_source)
    personalization = transport.load(Path(rendered['evidence_directory']) / 'personalization.json')
    first_contact = first_contact_details(personalization) if mode == 'initial-install' else None
    operation = secrets.token_hex(12)
    work, result = CACHE / ('candidate-test-' + operation), STATE / operation
    work.mkdir(mode=0o700); result.mkdir(mode=0o700)
    job = {'kind':'klokast.router-candidate-job.v1', 'mode':mode, 'box':box,
        'role':'router', 'operation_id':operation, 'engine_commit':engine,
        'inputs_sha256':manifest['inputs_sha256'], 'kernel_release':release['kernel_release'],
        'personalization':personalization, 'runtime_packages':release['runtime_packages']}
    if first_contact is not None:
        job['first_contact'] = first_contact
    import router_candidate
    router_candidate.validate(job)
    transport.write(work / 'candidate-job.json', job)
    boot = candidate_boot(source, work)
    request = {'kind':'klokast.router-candidate-preparation-test.v1', 'box':box,
        'operation_id':operation, 'engine_commit':engine, 'inputs_sha256':manifest['inputs_sha256'],
        'template_operation':template_operation, 'template_sha256':vm_template_inputs.sha256(candidate_path),
        'job_sha256':router_personalize.digest(job), 'mode':mode, 'bootstrap':boot}
    transport.write(result / 'arguments.json', {'router_candidate_test_box':box,
        'router_candidate_test_operation':operation, 'router_candidate_test_result_dir':str(result),
        'router_candidate_test_boot_dir':str(work / 'boot'),
        'router_candidate_test_request':request, 'router_candidate_test_job':job})
    os.environ['ANSIBLE_CONFIG'] = str(REPO / 'ansible/ansible.cfg')
    with transport.installation_lock():
        compiled = json.loads(transport.command([REPO / 'ansible/bin/platform-resources', 'show']))
        if compiled['registry_sha256'] != rendered['registry_sha256']:
            raise UpdateError('candidate preparation compiler inputs changed after rendering')
        with (result / 'preparation.log').open('x') as log:
            transport.command(['ansible-playbook', '-vv', '-i', REPO / 'ansible/execution-inventory/hosts',
                REPO / 'ansible/playbooks/74-router-candidate-preparation-test.yml', '--limit', box + '-dom0',
                '-e', '@' + str(result / 'arguments.json')], timeout=1200, log=log)
        evidence = transport.load(result / 'result.json')
        disk = transport.load(result / 'candidate-disk.json')
        lifecycle = transport.load(result / 'lifecycle.json')
        if not isinstance(evidence, dict):
            raise UpdateError('candidate preparation test returned an invalid result record')
        first_contact_evidence = evidence.get('first_contact')
        first_contact_valid = mode != 'initial-install'
        if mode == 'initial-install' and first_contact is not None:
            router_initial_contact.host_public_keys(first_contact_evidence)
            host_keys = first_contact_evidence.get('host_key_public_sha256') if isinstance(first_contact_evidence, dict) else None
            first_contact_valid = (
                isinstance(first_contact_evidence, dict)
                and set(first_contact_evidence) == {'kind','authorized_key_sha256','interfaces_sha256',
                    'firewall_sha256','sshd_config_sha256','host_key_public_sha256','host_key_public'}
                and first_contact_evidence.get('kind') == 'klokast.router-first-contact.v2'
                and first_contact_evidence.get('authorized_key_sha256') == hashlib.sha256((first_contact['key'] + '\n').encode()).hexdigest()
                and first_contact_evidence.get('interfaces_sha256') == hashlib.sha256(
                    router_initial_contact.first_contact_interfaces(first_contact['backend_address'],
                        first_contact['backend_prefix']).encode()).hexdigest()
                and first_contact_evidence.get('firewall_sha256') == hashlib.sha256(
                    router_initial_contact.first_contact_firewall(
                        personalization['files']['etc/nftables.nft'], first_contact['backend_source_address'],
                        first_contact['backend_address'], first_contact['backend_prefix']).encode()).hexdigest()
                and first_contact_evidence.get('sshd_config_sha256') == hashlib.sha256(
                    router_initial_contact.first_contact_sshd_config(first_contact['backend_address']).encode()).hexdigest()
                and isinstance(host_keys, dict) and bool(host_keys)
                and set(host_keys) <= {'rsa','ecdsa','ed25519'}
                and all(re.fullmatch('[0-9a-f]{64}', value) for value in host_keys.values())
            )
        if (evidence.get('kind') != 'klokast.router-candidate-preparation-test-result.v1' or
                evidence.get('box') != box or evidence.get('operation_id') != operation or
                evidence.get('engine_commit') != engine or evidence.get('inputs_sha256') != manifest['inputs_sha256'] or
                evidence.get('success') is not True or evidence.get('production_identity') is not False or
                evidence.get('replacement_authorized') is not False or
                evidence.get('mode') != mode or evidence.get('prepared', {}).get('mode') != mode or
                not first_contact_valid or
                evidence.get('prepared', {}).get('packages') != (
                    {item['name']:item['version'] for item in manifest['packages']}
                    if mode == 'initial-install' else release['runtime_packages']) or
                evidence['prepared'].get('tailscale') != {key:manifest['tailscale'][key] for key in (
                    'version', 'sha256', 'tailscale_sha256', 'tailscaled_sha256', 'openrc_sha256')} or
                evidence['prepared'].get('configuration_files') != {
                    name:hashlib.sha256(content.encode()).hexdigest()
                    for name,content in personalization['files'].items()} or
                disk.get('stage') != 'retired' or disk.get('operation_id') != operation or
                lifecycle.get('stage') != 'retired' or lifecycle.get('operation_id') != operation):
            raise UpdateError('candidate preparation test has incomplete result or exact cleanup evidence')
        if json.loads(transport.command([REPO / 'ansible/bin/platform-resources', 'show'])) != compiled:
            raise UpdateError('candidate preparation compiler inputs changed during native test')
        persist_diagnostic_lvm(box, result)
        return {'kind':'klokast.router-candidate-preparation-test.v1', 'box':box,
                'operation':operation, 'mode':mode, 'evidence_directory':str(result), 'status':'qualified',
                'production_identity':False, 'replacement_authorized':False}


def prepare_replacement(box, check_operation, template_operation, operation=None):
    """Retain one replacement clone after a fresh live and signed-source check."""
    if (not router_updates.match(router_updates.BOX,box) or
            not re.fullmatch('[0-9a-f]{24}',check_operation) or
            not re.fullmatch('[0-9a-f]{24}',template_operation) or
            operation is not None and not re.fullmatch('[0-9a-f]{24}',operation)):
        raise UpdateError('replacement preparation needs exact box, check, and template operations')
    transport.require_controller()
    if transport.command(['git','-C',REPO,'status','--porcelain','--untracked-files=all']).strip():
        raise UpdateError('replacement preparation requires a clean activated engine checkout')
    engine = transport.command(['git','-C',REPO,'rev-parse','HEAD']).strip()
    if transport.approved_engine() != engine:
        raise UpdateError('replacement preparation requires the exact activated engine')
    profile = transport.load(PROFILE)
    router_updates.validate_profile(profile)
    checked = STATE / check_operation
    binding = transport.load(checked / 'candidate-source.json')
    source_operation = binding.get('source_operation') if isinstance(binding,dict) else None
    if not isinstance(source_operation,str) or not re.fullmatch('[0-9a-f]{24}',source_operation):
        raise UpdateError('replacement check lacks an exact frozen source')
    source = CACHE / source_operation
    render_inspection = inspect(box)
    render_guest = transport.load(Path(render_inspection['evidence_directory']) / (box+'-router.json'))
    overlay_source = (signed_overlay_source(box)
                      if render_guest.get('overlay_ipv6_enabled') is True else None)
    rendered = render_candidate(box,source,overlay_source)
    personalization = transport.load(Path(rendered['evidence_directory']) / 'personalization.json')
    candidate_path = STATE / template_operation / 'candidate.json'
    candidate = transport.load(candidate_path)
    release = transport.load(STATE / template_operation / 'release.json')
    reserved = operation is not None
    operation = operation or secrets.token_hex(12)
    work,result = CACHE / ('replacement-' + operation),STATE / operation
    for directory in (work,result):
        if directory.is_symlink() or directory.exists() and not directory.is_dir():
            raise UpdateError('replacement operation directory is unsafe')
        if directory.exists():
            info = directory.lstat()
            if info.st_uid != os.geteuid() or stat.S_IMODE(info.st_mode) != 0o700:
                raise UpdateError('replacement operation directory has unsafe metadata')
    resume = reserved and (work / 'request.json').exists()
    if reserved and not resume and any(directory.exists() and any(directory.iterdir())
                                       for directory in (work,result)):
        raise UpdateError('reserved replacement has incomplete controller state')
    import router_candidate
    import router_replacement_preparation
    os.environ['ANSIBLE_CONFIG'] = str(REPO / 'ansible/ansible.cfg')
    with transport.installation_lock():
        inspection_evidence = STATE / secrets.token_hex(12)
        inspection_evidence.mkdir(mode=0o700)
        context = replacement_context(box,check_operation,engine,profile,
            inspection_evidence,'replacement-before')
        if (context['binding'] != binding or context['frozen'] != source or
                context['overlay_source'] != overlay_source or
                candidate.get('inputs_sha256') != context['inputs']['inputs_sha256'] or
                release != router_template_inputs.release(candidate,context['inputs'],profile,
                    engine,box,template_operation,approved_engine=engine)):
            raise UpdateError('replacement template differs from its checked frozen inputs')
        compiled = json.loads(transport.command([REPO / 'ansible/bin/platform-resources','show']))
        if compiled['registry_sha256'] != rendered['registry_sha256']:
            raise UpdateError('replacement compiler inputs changed after rendering')
        job = {'kind':'klokast.router-candidate-job.v1','mode':'replacement','box':box,
            'role':'router','operation_id':operation,'engine_commit':engine,
            'inputs_sha256':context['inputs']['inputs_sha256'],
            'kernel_release':release['kernel_release'],'personalization':personalization,
            'runtime_packages':release['runtime_packages'],
            'first_contact':first_contact_details(personalization)}
        router_candidate.validate(job)
        request = {'kind':'klokast.router-replacement-preparation.v1','box':box,
            'mode':'replacement','operation_id':operation,'engine_commit':engine,
            'inputs_sha256':context['inputs']['inputs_sha256'],
            'source_operation':source_operation,'check_operation':check_operation,
            'template_operation':template_operation,
            'template_sha256':vm_template_inputs.sha256(candidate_path),
            'job_sha256':router_generations.digest(job),
            'release_sha256':release['receipt_sha256'],
            'registry_sha256':rendered['registry_sha256'],
            'old_sha256':context['generation']['record_sha256'],
            'accepted_assignment_sha256':context['assignment']['record_sha256'],
            'policy_sha256':context['policy_sha256'],
            'report_sha256':context['report']['report_sha256'],
            'source_binding_sha256':router_generations.digest(context['binding'])}
        if resume:
            saved = transport.load(work / 'request.json')
            if ({key:value for key,value in saved.items() if key != 'bootstrap'} != request or
                    transport.load(work / 'candidate-job.json') != job or
                    transport.load(work / 'release.json') != release or
                    transport.load(work / 'accepted.json') != context['accepted'] or
                    transport.load(work / 'accepted-profile.json') != context['accepted_profile'] or
                    transport.load(work / 'candidate-source.json') != context['binding'] or
                    transport.load(work / 'check.json') != context['report'] or
                    transport.load(work / 'policy.json') != context['policy']):
                raise UpdateError('replacement retry differs from its exact recorded source')
            request = saved
            parts = transport.load(work / 'parts.json')
            final_request = transport.load(work / 'finalization/request.json')
            final_parts = transport.load(work / 'finalization/parts.json')
            if ({key:value for key,value in final_request.items() if key != 'bootstrap'} != {
                    'kind':'klokast.router-replacement-finalizer-assets.v1',
                    'box':box,'operation_id':operation,'engine_commit':engine,
                    'inputs_sha256':request['inputs_sha256'],
                    'preparation_sha256':router_generations.digest(request),
                    'release_sha256':release['receipt_sha256']}):
                raise UpdateError('replacement finalizer retry differs from its exact prepared source')
            result.mkdir(mode=0o700,exist_ok=True)
        else:
            result.mkdir(mode=0o700,exist_ok=reserved)
            staging = CACHE / ('replacement-stage-' + operation + '-' + secrets.token_hex(6))
            staging.mkdir(mode=0o700)
            transport.write(staging / 'candidate-job.json',job)
            boot = candidate_boot(source,staging)
            request['bootstrap'] = boot
            (staging / 'transfer').mkdir(mode=0o700)
            parts = []
            for name in ('kernel','initramfs'):
                parts.extend({'artifact':name,**part} for part in router_template_inputs.split_payload(
                    staging / 'boot' / name,staging / 'transfer' / name,boot[name]))
            final = staging / 'finalization'
            final.mkdir(mode=0o700)
            final_boot = replacement_finalizer_boot(source,final)
            final_request = {'kind':'klokast.router-replacement-finalizer-assets.v1',
                'box':box,'operation_id':operation,'engine_commit':engine,
                'inputs_sha256':request['inputs_sha256'],
                'preparation_sha256':router_generations.digest(request),
                'release_sha256':release['receipt_sha256'],'bootstrap':final_boot}
            (final / 'transfer').mkdir(mode=0o700)
            final_parts = []
            for name in ('kernel','initramfs'):
                final_parts.extend({'artifact':name,**part} for part in router_template_inputs.split_payload(
                    final / 'boot' / name,final / 'transfer' / name,final_boot[name]))
            transport.write(final / 'request.json',final_request)
            transport.write(final / 'parts.json',final_parts)
            for name,value in (('parts',parts),('request',request),('release',release),
                    ('candidate-source',context['binding']),('check',context['report']),
                    ('policy',context['policy']),('accepted',context['accepted']),
                    ('accepted-profile',context['accepted_profile'])):
                transport.write(staging / (name + '.json'),value)
            staging.rename(work)
        attempt = secrets.token_hex(6)
        stage_args = result / ('replacement-stage-' + attempt + '.json')
        transport.write(stage_args,{'router_replacement_box':box,
            'router_replacement_operation':operation,'router_replacement_input_dir':str(work),
            'router_replacement_request':request,'router_replacement_job':job,
            'router_replacement_release':release,
            'router_replacement_source':context['binding'],
            'router_replacement_check':context['report'],
            'router_replacement_policy':context['policy'],
            'router_replacement_accepted':context['accepted'],
            'router_replacement_accepted_profile':context['accepted_profile'],
            'router_replacement_transfer_parts':parts,
            'router_replacement_finalizer_request':final_request,
            'router_replacement_finalizer_parts':final_parts})
        with (result / ('replacement-stage-' + attempt + '.log')).open('x') as log:
            transport.command(['ansible-playbook','-vv','-i',
                REPO / 'ansible/execution-inventory/hosts',
                REPO / 'ansible/playbooks/74-router-replacement-preparation-stage.yml',
                '--limit',box+'-dom0','-e','@'+str(stage_args)],timeout=7200,log=log)
        current = replacement_context(box,check_operation,engine,profile,result,
                                      'replacement-after-stage-' + attempt)
        fixed = ('report','binding','inputs','frozen','assignment','generation',
                 'accepted','accepted_profile','policy','policy_sha256','overlay_source')
        if (any(current[name] != context[name] for name in fixed) or
                json.loads(transport.command([REPO / 'ansible/bin/platform-resources','show'])) != compiled or
                transport.load(STATE / template_operation / 'release.json') != release or
                transport.load(candidate_path) != candidate):
            raise UpdateError('replacement authority changed during staging; no disk was authorized')
        now = int(dt.datetime.now(dt.timezone.utc).timestamp())
        grant = {'kind':'klokast.router-replacement-preparation-grant.v1',
            'engine_commit':engine,'request_sha256':router_generations.digest(request),
            'accepted_assignment_sha256':request['accepted_assignment_sha256'],
            'policy_sha256':request['policy_sha256'],
            'granted_at':now,'expires_at':now+900}
        router_replacement_preparation.authority(request,job,release,profile,
            current['binding'],current['report'],current['policy'],current['accepted'],
            grant,box,operation,engine,now)
        args = result / ('replacement-prepare-' + attempt + '.json')
        transport.write(args,{'router_replacement_box':box,
            'router_replacement_operation':operation,'router_replacement_result_dir':str(result),
            'router_replacement_request':request,'router_replacement_grant':grant,
            'router_replacement_request_sha256':grant['request_sha256']})
        with (result / ('replacement-prepare-' + attempt + '.log')).open('x') as log:
            transport.command(['ansible-playbook','-vv','-i',
                REPO / 'ansible/execution-inventory/hosts',
                REPO / 'ansible/playbooks/74-router-replacement-prepare.yml',
                '--limit',box+'-dom0','-e','@'+str(args)],timeout=1200,log=log)
        prepared = transport.load(result / 'preparation-result.json')
        router_replacement_preparation.preparation.validate_result(prepared,request,job)
        disk = transport.load(result / 'candidate-disk.json')
        evidence = transport.load(result / 'replacement-preparation-result.json')
        if (not isinstance(disk,dict) or disk.get('kind') != 'klokast.router-candidate-disk.v1' or
                disk.get('operation_id') != operation or disk.get('stage') != 'cloned' or
                disk.get('path') != '/dev/vg0/routergen_' + operation or
                not router_generations.matches('[A-Za-z0-9-]{1,64}',disk.get('uuid')) or
                evidence.get('kind') != 'klokast.router-replacement-preparation-result.v1' or
                evidence.get('box') != box or evidence.get('operation_id') != operation or
                evidence.get('status') != 'replacement-prepared' or
                evidence.get('router_started') is not False or
                evidence.get('old_sha256') != request['old_sha256'] or
                evidence.get('candidate_disk') != {'path':disk['path'],'uuid':disk['uuid'],
                                                    'bytes':router_replacement_preparation.disks.BYTES} or
                evidence.get('preparation_sha256') != router_generations.digest(prepared) or
                evidence.get('release_sha256') != release['receipt_sha256']):
            raise UpdateError('replacement preparation lacks exact retained disk evidence')
        final = replacement_context(box,check_operation,engine,profile,result,
                                    'replacement-after-prepare-' + attempt)
        if (any(final[name] != context[name] for name in fixed) or
                json.loads(transport.command([REPO / 'ansible/bin/platform-resources','show'])) != compiled):
            raise UpdateError('replacement source or running router changed after preparation; retain the disk')
        return {'kind':'klokast.router-replacement-preparation-result.v1',
            'box':box,'operation':operation,'status':'replacement-prepared',
            'evidence_directory':str(result),'router_started':False}


def stage_replacement_generation(box, operation):
    """Stage exact boot artifacts and a proposed record; do not start a router."""
    if (not router_updates.match(router_updates.BOX,box) or
            not re.fullmatch('[0-9a-f]{24}',operation)):
        raise UpdateError('replacement generation needs an exact box and prepared operation')
    transport.require_controller()
    if transport.command(['git','-C',REPO,'status','--porcelain','--untracked-files=all']).strip():
        raise UpdateError('replacement generation requires a clean activated engine checkout')
    engine = transport.command(['git','-C',REPO,'rev-parse','HEAD']).strip()
    if transport.approved_engine() != engine:
        raise UpdateError('replacement generation requires the exact activated engine')
    import router_candidate_generation
    import router_candidate_preparation
    import router_replacement_generation
    work,result = CACHE / ('replacement-'+operation),STATE / operation
    for directory in (work,result):
        info = directory.lstat()
        if (not stat.S_ISDIR(info.st_mode) or info.st_uid != os.geteuid() or
                stat.S_IMODE(info.st_mode) != 0o700):
            raise UpdateError('replacement generation source directory is unsafe')
    source = transport.load(work/'request.json')
    job = transport.load(work/'candidate-job.json')
    release = transport.load(work/'release.json')
    prepared = transport.load(result/'preparation-result.json')
    disk = transport.load(result/'candidate-disk.json')
    completion = transport.load(result/'replacement-preparation-result.json')
    profile = transport.load(PROFILE)
    router_candidate_preparation.validate_result(prepared,source,job)
    if (source.get('kind') != 'klokast.router-replacement-preparation.v1' or
            source.get('box') != box or source.get('operation_id') != operation or
            source.get('engine_commit') != engine or
            completion.get('kind') != 'klokast.router-replacement-preparation-result.v1' or
            completion.get('box') != box or completion.get('operation_id') != operation or
            completion.get('status') != 'replacement-prepared' or
            completion.get('router_started') is not False or
            completion.get('preparation_sha256') != router_generations.digest(prepared) or
            completion.get('candidate_disk') != {'path':disk.get('path'),'uuid':disk.get('uuid'),
                                                   'bytes':2147483648} or
            completion.get('release_sha256') != release.get('receipt_sha256')):
        raise UpdateError('replacement generation lacks its exact retained preparation')
    os.environ['ANSIBLE_CONFIG'] = str(REPO/'ansible/ansible.cfg')
    with transport.installation_lock():
        context = replacement_context(box,source['check_operation'],engine,profile,result,
                                      'generation-before-'+secrets.token_hex(6))
        template_dir = STATE/source['template_operation']
        candidate_path = template_dir/'candidate.json'
        if (context['binding'] != transport.load(work/'candidate-source.json') or
                context['report'] != transport.load(work/'check.json') or
                context['policy'] != transport.load(work/'policy.json') or
                context['accepted'] != transport.load(work/'accepted.json') or
                context['accepted_profile'] != transport.load(work/'accepted-profile.json') or
                context['assignment']['record_sha256'] != source['accepted_assignment_sha256'] or
                context['generation']['record_sha256'] != source['old_sha256'] or
                context['inputs']['inputs_sha256'] != source['inputs_sha256'] or
                context['policy_sha256'] != source['policy_sha256'] or
                context['report']['report_sha256'] != source['report_sha256'] or
                context['frozen'].name != source['source_operation'] or
                vm_template_inputs.sha256(candidate_path) != source['template_sha256'] or
                transport.load(template_dir/'release.json') != release or
                release != router_template_inputs.release(
                    transport.load(candidate_path),
                    context['inputs'],profile,engine,box,source['template_operation'],
                    approved_engine=engine)):
            raise UpdateError('replacement generation differs from current source or accepted router')
        compiled = json.loads(transport.command([REPO/'ansible/bin/platform-resources','show']))
        if compiled['registry_sha256'] != source['registry_sha256']:
            raise UpdateError('replacement generation compiler inputs changed since preparation')
        identity = result/'generation-xen.json'
        if identity.exists() or identity.is_symlink():
            selected = transport.load(identity)
            if (not isinstance(selected,dict) or set(selected) != {'uuid'} or
                    not router_generations.matches(
                        '[0-9a-f]{8}(?:-[0-9a-f]{4}){3}-[0-9a-f]{12}',selected['uuid'])):
                raise UpdateError('replacement generation Xen identity record is unsafe')
        else:
            selected = {'uuid':str(uuid.uuid4())}
            transport.write(identity,selected)
        proposal = {'kind':'klokast.router-replacement-generation-selection.v1',
            'box':box,'operation_id':operation,'engine_commit':engine,
            'source_request_sha256':router_generations.digest(source),
            'preparation_sha256':router_generations.digest(prepared),
            'candidate_disk_sha256':router_generations.digest(disk),
            'accepted_assignment_sha256':source['accepted_assignment_sha256'],
            'old_sha256':source['old_sha256'],
            'release_sha256':release['receipt_sha256'],
            'xen_uuid':selected['uuid']}
        attempt = secrets.token_hex(6)
        stage_args = result/('generation-stage-'+attempt+'.json')
        transport.write(stage_args,{'router_replacement_box':box,
            'router_replacement_operation':operation,'router_replacement_result_dir':str(result),
            'router_replacement_generation':proposal})
        with (result/('generation-stage-'+attempt+'.log')).open('x') as log:
            transport.command(['ansible-playbook','-vv','-i',
                REPO/'ansible/execution-inventory/hosts',
                REPO/'ansible/playbooks/74-router-replacement-generation-stage.yml',
                '--limit',box+'-dom0','-e','@'+str(stage_args)],timeout=600,log=log)
        current = replacement_context(box,source['check_operation'],engine,profile,result,
                                      'generation-after-stage-'+attempt)
        fixed = ('report','binding','inputs','frozen','assignment','generation',
                 'accepted','accepted_profile','policy','policy_sha256','overlay_source')
        if (any(current[name] != context[name] for name in fixed) or
                json.loads(transport.command([REPO/'ansible/bin/platform-resources','show'])) != compiled or
                vm_template_inputs.sha256(candidate_path) != source['template_sha256'] or
                transport.load(template_dir/'release.json') != release or
                transport.load(work/'request.json') != source or
                transport.load(work/'release.json') != release or
                transport.load(result/'preparation-result.json') != prepared or
                transport.load(result/'candidate-disk.json') != disk):
            raise UpdateError('replacement source changed during generation staging; no grant was issued')
        now = int(dt.datetime.now(dt.timezone.utc).timestamp())
        grant = {'kind':'klokast.router-replacement-generation-grant.v1',
            'engine_commit':engine,'selection_sha256':router_generations.digest(proposal),
            'granted_at':now,'expires_at':now+300}
        router_replacement_generation.authority(proposal,grant,source,prepared,disk,release,
                                                box,operation,engine,now)
        run_args = result/('generation-run-'+attempt+'.json')
        transport.write(run_args,{'router_replacement_box':box,
            'router_replacement_operation':operation,'router_replacement_result_dir':str(result),
            'router_replacement_generation_grant':grant,
            'router_replacement_generation_sha256':grant['selection_sha256']})
        with (result/('generation-run-'+attempt+'.log')).open('x') as log:
            transport.command(['ansible-playbook','-vv','-i',
                REPO/'ansible/execution-inventory/hosts',
                REPO/'ansible/playbooks/74-router-replacement-generation-run.yml',
                '--limit',box+'-dom0','-e','@'+str(run_args)],timeout=600,log=log)
        proposed = transport.load(result/'proposed-generation.json')
        preflight = transport.load(result/'candidate-preflight.json')
        evidence = transport.load(result/'generation-stage-result.json')
        expected = router_candidate_generation.assemble(box=box,operation=operation,
            template_operation=source['template_operation'],old=context['generation'],
            release=release,profile=profile,prepared=prepared['prepared'],
            disk_record=disk,boot=proposed.get('boot'),xen_uuid=selected['uuid'],
            approved_engine=engine)
        expected_preflight = router_candidate_generation.offline_preflight(
            expected,prepared['prepared'],disk)
        if (proposed != expected or preflight != expected_preflight or evidence != {
                'kind':'klokast.router-replacement-generation-stage-result.v1',
                'box':box,'operation_id':operation,'status':'proposed-generation-staged',
                'old_sha256':source['old_sha256'],
                'candidate_sha256':proposed['record_sha256'],
                'preflight_sha256':router_generations.digest(preflight),
                'router_started':False,'cutover_authorized':False}):
            raise UpdateError('replacement generation staging returned different proposed evidence')
        final = replacement_context(box,source['check_operation'],engine,profile,result,
                                    'generation-after-run-'+attempt)
        if (any(final[name] != context[name] for name in fixed) or
                json.loads(transport.command([REPO/'ansible/bin/platform-resources','show'])) != compiled):
            raise UpdateError('replacement source changed after generation staging')
        return {'kind':'klokast.router-replacement-generation-stage-result.v1',
            'box':box,'operation':operation,'status':'proposed-generation-staged',
            'candidate_sha256':proposed['record_sha256'],
            'preflight_sha256':router_generations.digest(preflight),
            'evidence_directory':str(result),'router_started':False,
            'cutover_authorized':False}


def stage_replacement_cutover(box, operation, compatibility_operation):
    """Bind a retired native DHCP diagnostic to one retained A/B pair."""
    if (not router_updates.match(router_updates.BOX,box) or
            any(not re.fullmatch('[0-9a-f]{24}',item) for item in
                (operation,compatibility_operation))):
        raise UpdateError('replacement cutover staging needs exact operation selectors')
    transport.require_controller()
    if transport.command(['git','-C',REPO,'status','--porcelain','--untracked-files=all']).strip():
        raise UpdateError('replacement cutover staging requires a clean activated checkout')
    engine = transport.command(['git','-C',REPO,'rev-parse','HEAD']).strip()
    if transport.approved_engine() != engine:
        raise UpdateError('replacement cutover staging requires the exact activated engine')
    import router_replacement_qualification as qualification
    import router_replacement_enrollment as enrollment
    import router_transaction as transaction
    work,result = CACHE/('replacement-'+operation),STATE/operation
    diagnostic,proof = CACHE/('compatibility-'+compatibility_operation),STATE/compatibility_operation
    for directory in (work,result,diagnostic,proof):
        info = directory.lstat()
        if (not stat.S_ISDIR(info.st_mode) or info.st_uid != os.geteuid() or
                stat.S_IMODE(info.st_mode) != 0o700):
            raise UpdateError('replacement cutover source directory is unsafe')
    preparation = transport.load(work/'request.json')
    release = transport.load(work/'release.json')
    candidate = transport.load(result/'proposed-generation.json')
    preflight = transport.load(result/'candidate-preflight.json')
    prepared = transport.load(result/'preparation-result.json')
    host = transport.load(diagnostic/'request.json')
    native_result = transport.load(proof/'result.json')
    phases = {name:transport.load(proof/(name+'.json')) for name in qualification.PHASES}
    lifecycle = transport.load(proof/'lifecycle.json')
    retired = transport.load(proof/'candidate-disk.json')
    profile = transport.load(PROFILE)
    os.environ['ANSIBLE_CONFIG'] = str(REPO/'ansible/ansible.cfg')
    with transport.installation_lock():
        token = secrets.token_hex(6)
        context = replacement_context(box,preparation['check_operation'],engine,profile,
                                      result,'cutover-before-'+token)
        if (context['assignment']['record_sha256'] != preparation['accepted_assignment_sha256'] or
                context['generation']['record_sha256'] != preparation['old_sha256']):
            raise UpdateError('replacement cutover source differs from the running accepted router')
        inventory = json.loads(transport.command(['ansible-inventory','-i',
            REPO/'ansible/execution-inventory/hosts','--host',box+'-router'],timeout=120))
        gateway = inventory.get('router_backend_ipv4_address')
        if not isinstance(gateway,str):
            raise UpdateError('replacement cutover lacks the compiled backend gateway')
        request = {'kind':'klokast.router-transaction-request.v1','role':'router',
            'box':box,'operation_id':operation,'engine_commit':engine,
            'policy_sha256':context['policy_sha256'],
            'accepted_sha256':context['assignment']['record_sha256'],
            'old_sha256':context['generation']['record_sha256'],
            'candidate_sha256':candidate['record_sha256'],
            'cutover_seconds':1800,'recovery_seconds':900}
        transaction.validate(request)
        compatibility,copy_qualification,readiness = qualification.records(
            request,context['generation'],candidate,preparation,host['source']['accepted'],
            release,preflight,host,native_result,phases,lifecycle,retired,gateway)
        source = {'kind':'klokast.router-replacement-enrollment-source.v1',
            'request_sha256':router_generations.digest(request),
            'old_sha256':request['old_sha256'],
            'old_machine_id':context['old_machine_id'],
            'preparation_sha256':router_generations.digest(prepared)}
        enrollment.attempt(request,candidate,nonce='0'*24,
            old_machine_id=source['old_machine_id'],
            host_keys=prepared['first_contact']['host_key_public_sha256'])
        staged = {'transaction-request':request,'readiness':readiness,
            'compatibility':compatibility,'copy-qualification':copy_qualification,
            'enrollment-source':source}
        arguments = result/('cutover-stage-'+token+'.json')
        transport.write(arguments,{'router_replacement_box':box,
            'router_replacement_operation':operation,
            'router_replacement_result_dir':str(result),
            'router_replacement_records':staged})
        with (result/('cutover-stage-'+token+'.log')).open('x') as log:
            transport.command(['ansible-playbook','-vv','-i',
                REPO/'ansible/execution-inventory/hosts',
                REPO/'ansible/playbooks/74-router-replacement-cutover-stage.yml',
                '--limit',box+'-dom0','-e','@'+str(arguments)],timeout=420,log=log)
        native = transport.load(result/'cutover-stage-result.json')
        if (native.get('kind') != 'klokast.router-command-result.v1' or
                native.get('action') != 'stage-cutover' or
                native.get('box') != box or native.get('engine_commit') != engine or
                native.get('result') != {'kind':'klokast.router-cutover-staged.v1',
                    'box':box,'operation_id':operation,
                    'candidate_sha256':candidate['record_sha256'],
                    'readiness_sha256':router_generations.digest(readiness),
                    'status':'records-qualified-no-cutover'}):
            raise UpdateError('dom0 staged another router cutover source')
        final = replacement_context(box,preparation['check_operation'],engine,profile,
                                    result,'cutover-after-'+token)
        fixed = ('report','binding','inputs','frozen','assignment','generation',
                 'accepted','accepted_profile','policy','policy_sha256','old_machine_id',
                 'overlay_source')
        if any(final[name] != context[name] for name in fixed):
            raise UpdateError('accepted router or signed source changed during cutover staging')
        return {'kind':'klokast.router-replacement-cutover-stage-result.v1',
            'box':box,'operation_id':operation,'candidate_sha256':candidate['record_sha256'],
            'compatibility_operation':compatibility_operation,
            'readiness_sha256':router_generations.digest(readiness),
            'status':'staged-no-cutover','evidence_directory':str(result)}


def prepare_initial(box, source, template_operation, operation=None):
    """Retain a first-install clone from the approved common template; no boot."""
    if (not router_updates.match(router_updates.BOX, box) or
            not re.fullmatch('[0-9a-f]{24}', template_operation) or
            operation is not None and not re.fullmatch('[0-9a-f]{24}', operation)):
        raise UpdateError('initial preparation requires an exact box and operation selectors')
    transport.require_controller()
    source = Path(source)
    if source.parent != CACHE or not re.fullmatch('[0-9a-f]{24}', source.name):
        raise UpdateError('initial preparation requires one frozen controller input directory')
    if transport.command(['git', '-C', REPO, 'status', '--porcelain', '--untracked-files=all']).strip():
        raise UpdateError('initial preparation requires a clean activated engine checkout')
    engine = transport.command(['git', '-C', REPO, 'rev-parse', 'HEAD']).strip()
    if transport.approved_engine() != engine:
        raise UpdateError('initial preparation requires the exact activated engine')
    profile = transport.load(PROFILE)
    selection_hash = initial_template_selection(source, profile, engine)
    manifest, selection = transport.load(source / 'inputs.json'), transport.load(source / 'selection.json')
    candidate_path = STATE / template_operation / 'candidate.json'
    candidate = transport.load(candidate_path)
    release = transport.load(STATE / template_operation / 'release.json')
    if release != router_template_inputs.release(candidate, manifest, profile, engine,
            box, template_operation, approved_engine=engine):
        raise UpdateError('initial preparation release differs from the approved template')
    rendered = render_candidate(box, source)
    personalization = transport.load(Path(rendered['evidence_directory']) / 'personalization.json')
    reserved = operation is not None
    operation = operation or secrets.token_hex(12)
    work, result = CACHE / ('initial-' + operation), STATE / operation
    for directory in (work,result):
        if directory.is_symlink() or directory.exists() and not directory.is_dir():
            raise UpdateError('initial preparation operation directory is unsafe')
        if directory.exists():
            info = directory.lstat()
            if (info.st_uid != os.geteuid() or
                    stat.S_IMODE(info.st_mode) != 0o700):
                raise UpdateError('initial preparation operation directory has unsafe metadata')
    resume = reserved and (work / 'request.json').exists()
    if reserved and not resume and any(directory.exists() and any(directory.iterdir())
                                       for directory in (work,result)):
        raise UpdateError('reserved initial preparation has incomplete controller state')
    job = {'kind':'klokast.router-candidate-job.v1', 'mode':'initial-install', 'box':box,
        'role':'router', 'operation_id':operation, 'engine_commit':engine,
        'inputs_sha256':manifest['inputs_sha256'], 'kernel_release':release['kernel_release'],
        'personalization':personalization, 'runtime_packages':release['runtime_packages'],
        'first_contact':first_contact_details(personalization)}
    import router_candidate
    import router_initial_preparation
    router_candidate.validate(job)
    request = {'kind':'klokast.router-initial-preparation.v1', 'box':box,
        'mode':'initial-install', 'operation_id':operation, 'engine_commit':engine,
        'inputs_sha256':manifest['inputs_sha256'], 'source_operation':source.name,
        'template_operation':template_operation,
        'template_sha256':vm_template_inputs.sha256(candidate_path),
        'job_sha256':router_personalize.digest(job), 'selection_sha256':selection_hash,
        'release_sha256':release['receipt_sha256'], 'registry_sha256':rendered['registry_sha256']}
    os.environ['ANSIBLE_CONFIG'] = str(REPO / 'ansible/ansible.cfg')
    with transport.installation_lock():
        if resume:
            saved = transport.load(work / 'request.json')
            if ({key:value for key,value in saved.items() if key != 'bootstrap'} != request or
                    transport.load(work / 'candidate-job.json') != job):
                raise UpdateError('initial preparation retry differs from its recorded inputs')
            request = saved
            parts = transport.load(work / 'parts.json')
            result.mkdir(mode=0o700,exist_ok=True)
        else:
            # A crash while assembling local boot inputs leaves only an unused
            # staging directory. Publish the complete job atomically before
            # dom0 sees this operation ID.
            result.mkdir(mode=0o700,exist_ok=reserved)
            staging = CACHE / ('initial-stage-' + operation + '-' + secrets.token_hex(6))
            staging.mkdir(mode=0o700)
            transport.write(staging / 'candidate-job.json', job)
            boot = candidate_boot(source, staging)
            request['bootstrap'] = boot
            (staging / 'transfer').mkdir(mode=0o700)
            parts = []
            for name in ('kernel', 'initramfs'):
                parts.extend({'artifact':name, **part} for part in router_template_inputs.split_payload(
                    staging / 'boot' / name, staging / 'transfer' / name, boot[name]))
            transport.write(staging / 'parts.json', parts)
            transport.write(staging / 'request.json', request)
            staging.rename(work)
        compiled = json.loads(transport.command([REPO / 'ansible/bin/platform-resources', 'show']))
        if compiled['registry_sha256'] != request['registry_sha256']:
            raise UpdateError('initial preparation compiler inputs changed after rendering')
        attempt = secrets.token_hex(6)
        stage_arguments = result / ('initial-stage-' + attempt + '.json')
        transport.write(stage_arguments, {'router_initial_box':box, 'router_initial_operation':operation,
            'router_initial_input_dir':str(work), 'router_initial_request':request,
            'router_initial_job':job, 'router_initial_release':release,
            'router_initial_selection':selection, 'router_initial_transfer_parts':parts})
        with (result / ('initial-stage-' + attempt + '.log')).open('x') as log:
            transport.command(['ansible-playbook', '-vv', '-i', REPO / 'ansible/execution-inventory/hosts',
                REPO / 'ansible/playbooks/74-router-initial-preparation-stage.yml', '--limit', box + '-dom0',
                '-e', '@' + str(stage_arguments)], timeout=7200, log=log)
        # Issue the short grant after the slow transfer, with fresh authority.
        if (initial_template_selection(source, profile, engine) != selection_hash or
                json.loads(transport.command([REPO / 'ansible/bin/platform-resources', 'show'])) != compiled):
            raise UpdateError('initial preparation authority changed during staging; no allocation was authorized')
        now = int(dt.datetime.now(dt.timezone.utc).timestamp())
        grant = {'kind':'klokast.router-initial-preparation-grant.v1', 'engine_commit':engine,
            'request_sha256':router_personalize.digest(request), 'granted_at':now, 'expires_at':now + 900}
        router_initial_preparation.authority(request, job, release, profile, selection, grant,
                                            box, operation, engine, now)
        arguments = result / ('initial-prepare-' + attempt + '.json')
        transport.write(arguments, {'router_initial_box':box, 'router_initial_operation':operation,
            'router_initial_result_dir':str(result), 'router_initial_grant':grant,
            'router_initial_request_sha256':grant['request_sha256']})
        with (result / ('initial-prepare-' + attempt + '.log')).open('x') as log:
            transport.command(['ansible-playbook', '-vv', '-i', REPO / 'ansible/execution-inventory/hosts',
                REPO / 'ansible/playbooks/74-router-initial-prepare.yml', '--limit', box + '-dom0',
                '-e', '@' + str(arguments)], timeout=1200, log=log)
        evidence = transport.load(result / 'initial-preparation-result.json')
        prepared = transport.load(result / 'preparation-result.json')
        router_initial_preparation.preparation.validate_result(prepared, request, job)
        installation = router_initial_preparation.records.initial_installation.validate(
            evidence.get('installation'), box)
        if (evidence.get('kind') != 'klokast.router-initial-preparation-result.v1' or
                evidence.get('box') != box or evidence.get('operation_id') != operation or
                evidence.get('status') != 'initial-prepared' or evidence.get('router_started') is not False or
                installation['stage'] != 'prepared' or installation['operation_id'] != operation or
                installation['engine_commit'] != engine or
                installation['selection_sha256'] != selection_hash or
                installation['release_sha256'] != release['receipt_sha256'] or
                installation['preparation_sha256'] != router_personalize.digest(prepared)):
            raise UpdateError('initial preparation lacks its exact retained disk completion evidence')
        if json.loads(transport.command([REPO / 'ansible/bin/platform-resources', 'show'])) != compiled:
            raise UpdateError('initial preparation compiler inputs changed; retain the disk without booting it')
        host_keys = transport.pin_initial_host_keys(result, prepared['first_contact'], operation)
        return {'kind':'klokast.router-initial-preparation-result.v1', 'box':box, 'operation':operation,
                'status':'initial-prepared', 'evidence_directory':str(result), 'router_started':False,
                **host_keys}


def start_initial(box, operation):
    """Stage one inventory Xen definition and start its prepared router."""
    if not router_updates.match(router_updates.BOX, box) or not re.fullmatch('[0-9a-f]{24}', operation):
        raise UpdateError('initial boot requires an exact box and retained operation')
    transport.require_controller()
    if transport.command(['git','-C',REPO,'status','--porcelain','--untracked-files=all']).strip():
        raise UpdateError('initial boot requires a clean activated engine checkout')
    engine = transport.command(['git','-C',REPO,'rev-parse','HEAD']).strip()
    if transport.approved_engine() != engine:
        raise UpdateError('initial boot requires the exact activated engine')
    work, result = CACHE / ('initial-' + operation), STATE / operation
    source = transport.load(work / 'request.json')
    job = transport.load(work / 'candidate-job.json')
    prepared = transport.load(result / 'preparation-result.json')
    evidence = transport.load(result / 'initial-preparation-result.json')
    release = transport.load(STATE / source['template_operation'] / 'release.json')
    import router_candidate_preparation
    import router_initial_boot
    router_candidate_preparation.validate_result(prepared, source, job)
    initial = router_records.initial_installation.validate(evidence['installation'], box)
    if (source['box'] != box or source['operation_id'] != operation or
            source['engine_commit'] != engine or evidence.get('status') != 'initial-prepared' or
            initial['stage'] != 'prepared' or initial['operation_id'] != operation or
            initial['preparation_sha256'] != router_generations.digest(prepared)):
        raise UpdateError('initial boot lacks exact retained preparation evidence')
    pins = transport.pin_initial_host_keys(result, prepared['first_contact'], operation)
    base = {'kind':'klokast.router-initial-boot-request.v1', 'box':box,
            'operation_id':operation, 'engine_commit':engine,
            'registry_sha256':source['registry_sha256'],
            'source_request_sha256':router_generations.digest(source),
            'preparation_sha256':initial['preparation_sha256'],
            'selection_sha256':initial['selection_sha256'],
            'release_sha256':initial['release_sha256']}
    if release.get('receipt_sha256') != base['release_sha256']:
        raise UpdateError('initial boot release differs from its retained preparation')
    os.environ['ANSIBLE_CONFIG'] = str(REPO / 'ansible/ansible.cfg')
    with transport.installation_lock():
        compiled = json.loads(transport.command([REPO / 'ansible/bin/platform-resources','show']))
        if compiled.get('registry_sha256') != base['registry_sha256']:
            raise UpdateError('initial boot compiler inputs changed since preparation')
        identity_path = result / 'initial-xen.json'
        if identity_path.exists() or identity_path.is_symlink():
            identity = transport.load(identity_path)
            if (not isinstance(identity, dict) or set(identity) != {'uuid'} or
                    not router_generations.matches('[0-9a-f]{8}(?:-[0-9a-f]{4}){3}-[0-9a-f]{12}',
                                                   identity['uuid'])):
                raise UpdateError('initial boot Xen identity record is unsafe')
        else:
            identity = {'uuid':str(uuid.uuid4())}
            transport.write(identity_path, identity)
        attempt = secrets.token_hex(6)
        stage_args = result / ('initial-boot-stage-' + attempt + '.json')
        transport.write(stage_args, {'router_initial_box':box,'router_initial_operation':operation,
            'router_initial_result_dir':str(result),'router_initial_boot_base':base,
            'router_initial_xen_uuid':identity['uuid']})
        with (result / ('initial-boot-stage-' + attempt + '.log')).open('x') as log:
            transport.command(['ansible-playbook','-vv','-i',
                REPO / 'ansible/execution-inventory/hosts',
                REPO / 'ansible/playbooks/74-router-initial-boot-stage.yml',
                '--limit',box + '-dom0','-e','@' + str(stage_args)], timeout=600, log=log)
        value = transport.load(result / 'initial-boot-request.json')
        if ({key:item for key,item in value.items() if key != 'xen'} != base or
                not isinstance(value.get('xen'), dict) or value['xen'].get('uuid') != identity['uuid']):
            raise UpdateError('initial boot inventory returned a different request or Xen UUID')
        if json.loads(transport.command([REPO / 'ansible/bin/platform-resources','show'])) != compiled:
            raise UpdateError('initial boot compiler inputs changed during staging')
        now = int(dt.datetime.now(dt.timezone.utc).timestamp())
        grant = {'kind':'klokast.router-initial-boot-grant.v1','engine_commit':engine,
                 'request_sha256':router_generations.digest(value),
                 'granted_at':now,'expires_at':now + 300}
        router_initial_boot.authority(value, grant, source, prepared, release, initial,
                                      box, operation, engine, now)
        start_args = result / ('initial-boot-start-' + attempt + '.json')
        transport.write(start_args, {'router_initial_box':box,'router_initial_operation':operation,
            'router_initial_result_dir':str(result),'router_initial_boot_grant':grant,
            'router_initial_boot_request_sha256':grant['request_sha256']})
        with (result / ('initial-boot-start-' + attempt + '.log')).open('x') as log:
            transport.command(['ansible-playbook','-vv','-i',
                REPO / 'ansible/execution-inventory/hosts',
                REPO / 'ansible/playbooks/74-router-initial-boot-start.yml',
                '--limit',box + '-dom0','-e','@' + str(start_args)], timeout=420, log=log)
        booted = transport.load(result / 'initial-boot-result.json')
        if (booted.get('kind') != 'klokast.router-initial-boot-result.v1' or
                booted.get('box') != box or booted.get('operation_id') != operation or
                booted.get('status') != 'running-first-contact' or
                booted.get('request_sha256') != grant['request_sha256'] or
                booted.get('xen_uuid') != identity['uuid'] or booted.get('disk') != initial['disk']):
            raise UpdateError('initial boot lacks its exact native runtime result')
        return {'kind':'klokast.router-initial-boot-result.v1','box':box,
                'operation':operation,'status':'running-first-contact',
                'evidence_directory':str(result),'backend_address':job['first_contact']['backend_address'],
                **pins}


def signal_replacement_enrollment(box, operation, *, _already_locked=False):
    """Use one durable mint attempt to enroll B while dom0 owns the cutover."""
    if (not router_updates.match(router_updates.BOX,box) or
            not re.fullmatch('[0-9a-f]{24}',operation)):
        raise UpdateError('replacement enrollment requires an exact box and operation')
    transport.require_controller()
    if transport.command(['git','-C',REPO,'status','--porcelain','--untracked-files=all']).strip():
        raise UpdateError('replacement enrollment requires a clean activated engine checkout')
    engine = transport.command(['git','-C',REPO,'rev-parse','HEAD']).strip()
    if transport.approved_engine() != engine:
        raise UpdateError('replacement enrollment requires the exact activated engine')
    import router_replacement_controller as controller
    import router_replacement_enrollment as enrollment
    work,result = CACHE / ('replacement-' + operation),STATE / operation
    for directory in (work,result):
        info = directory.lstat()
        if (not stat.S_ISDIR(info.st_mode) or info.st_uid != os.geteuid() or
                stat.S_IMODE(info.st_mode) != 0o700):
            raise UpdateError('replacement enrollment source directory is unsafe')
    request = transport.load(result / 'transaction-request.json')
    source = transport.load(result / 'enrollment-source.json')
    preparation_request = transport.load(work / 'request.json')
    preparation_job = transport.load(work / 'candidate-job.json')
    prepared = transport.load(result / 'preparation-result.json')
    if (request.get('box') != box or request.get('operation_id') != operation or
            request.get('engine_commit') != engine):
        raise UpdateError('replacement enrollment selects another transaction')
    os.environ['ANSIBLE_CONFIG'] = str(REPO / 'ansible/ansible.cfg')
    with (contextlib.nullcontext() if _already_locked else transport.installation_lock()):
        token = secrets.token_hex(6)
        read_args = result / ('replacement-attempt-read-' + token + '.json')
        transport.write(read_args,{'router_replacement_box':box,
            'router_replacement_operation':operation,'router_replacement_result_dir':str(result)})
        with (result / ('replacement-attempt-read-' + token + '.log')).open('x') as log:
            transport.command(['ansible-playbook','-vv','-i',
                REPO / 'ansible/execution-inventory/hosts',
                REPO / 'ansible/playbooks/74-router-replacement-attempt-read.yml',
                '--limit',box+'-dom0','-e','@'+str(read_args)],timeout=180,log=log)
        pending = transport.load(result / 'dom0-enrollment-pending.json')
        attempt = transport.load(result / 'dom0-enrollment-attempt.json')
        controller.signal_source(request,pending,source,attempt,prepared,
                                 preparation_request,preparation_job)
        pins = transport.pin_replacement_host_keys(result,prepared['first_contact'],operation)
        key_path = Path.home() / '.ssh/github-klokast-codex'
        proxy_hosts = Path.home() / '.ssh/known_hosts'
        for path,maximum in ((key_path,16384),(proxy_hosts,1024*1024)):
            info = path.lstat()
            if (not stat.S_ISREG(info.st_mode) or info.st_uid != os.getuid() or
                    info.st_nlink != 1 or info.st_size < 1 or info.st_size > maximum or
                    info.st_mode & 0o022 or path == key_path and info.st_mode & 0o077):
                raise UpdateError('replacement controller SSH key or dom0 trust file is unsafe')
        marker = controller.mint_marker(request,attempt)
        marker_path = result / 'replacement-mint-attempt.json'
        if marker_path.exists() or marker_path.is_symlink():
            if transport.load(marker_path) != marker:
                raise UpdateError('replacement mint attempt changed; reconcile B before retry')
            mint_permitted = False
        else:
            # Persist before the broker call. A failed or uncertain call cannot
            # silently mint another key for this operation.
            transport.write(marker_path,marker)
            mint_permitted = True
        guest_args = {'router_replacement_box':box,
            'router_replacement_operation':operation,
            'router_replacement_attempt':attempt,
            'router_replacement_backend_address':preparation_job['first_contact']['backend_address'],
            'router_replacement_result_dir':str(result),
            'router_replacement_known_hosts':pins['known_hosts'],
            'router_replacement_host_key_alias':pins['host_key_alias'],
            'router_replacement_private_key':str(key_path),
            'router_replacement_proxy_known_hosts':str(proxy_hosts),
            'router_replacement_mint_permitted':mint_permitted}
        guest_args_path = result / ('replacement-enroll-' + token + '.json')
        transport.write(guest_args_path,guest_args)
        with (result / ('replacement-enroll-' + token + '.log')).open('x') as log:
            transport.command(['ansible-playbook','-vv','-i',
                REPO / 'ansible/execution-inventory/hosts',
                REPO / 'ansible/playbooks/74-router-replacement-enroll.yml',
                '--limit',box+'-router','-e','@'+str(guest_args_path)],timeout=300,log=log)
        value = enrollment.result(transport.load(result / 'replacement-enrollment-result.json'),
                                  request,attempt)
        signal_args = result / ('replacement-enrollment-signal-' + token + '.json')
        transport.write(signal_args,{'router_replacement_box':box,
            'router_replacement_operation':operation,
            'router_replacement_result_dir':str(result),
            'router_replacement_enrollment':value})
        with (result / ('replacement-enrollment-signal-' + token + '.log')).open('x') as log:
            transport.command(['ansible-playbook','-vv','-i',
                REPO / 'ansible/execution-inventory/hosts',
                REPO / 'ansible/playbooks/74-router-replacement-enrollment-signal.yml',
                '--limit',box+'-dom0','-e','@'+str(signal_args)],timeout=180,log=log)
        if transport.load(result / 'dom0-enrollment-result.json') != value:
            raise UpdateError('dom0 published a different replacement enrollment result')
        return {'kind':'klokast.router-replacement-enrollment-signal.v1',
            'box':box,'operation_id':operation,'machine_id':value['machine_id'],
            'attempt_sha256':attempt['record_sha256'],'status':'published'}


def signal_replacement_acceptance(box, operation, *, _already_locked=False):
    """Verify final B services and publish proof during the bounded transaction."""
    if (not router_updates.match(router_updates.BOX,box) or
            not re.fullmatch('[0-9a-f]{24}',operation)):
        raise UpdateError('replacement acceptance requires an exact box and operation')
    transport.require_controller()
    if transport.command(['git','-C',REPO,'status','--porcelain','--untracked-files=all']).strip():
        raise UpdateError('replacement acceptance requires a clean activated engine checkout')
    engine = transport.command(['git','-C',REPO,'rev-parse','HEAD']).strip()
    if transport.approved_engine() != engine:
        raise UpdateError('replacement acceptance requires the exact activated engine')
    import router_dom0
    import router_replacement_finalization as finalization
    import router_replacement_service as service
    import router_transaction as transaction
    work,result = CACHE / ('replacement-' + operation), STATE / operation
    for directory in (work,result):
        info = directory.lstat()
        if (not stat.S_ISDIR(info.st_mode) or info.st_uid != os.geteuid() or
                stat.S_IMODE(info.st_mode) != 0o700):
            raise UpdateError('replacement acceptance source directory is unsafe')
    request = transport.load(result/'transaction-request.json')
    transaction.validate(request)
    if (request['box'] != box or request['operation_id'] != operation or
            request['engine_commit'] != engine):
        raise UpdateError('replacement acceptance selects another transaction')
    candidate = transport.load(result/'proposed-generation.json')
    router_generations.generation(candidate,box)
    if candidate['record_sha256'] != request['candidate_sha256']:
        raise UpdateError('replacement acceptance selects another B generation')
    overlay_source = (signed_overlay_source(box)
                      if candidate.get('overlay_source_sha256') is not None else None)
    if (overlay_source is not None and
            overlay_source['source_sha256'] != candidate['overlay_source_sha256']):
        raise UpdateError('replacement B IPv6 repair source changed before acceptance')
    preparation_request = transport.load(work/'request.json')
    preparation_job = transport.load(work/'candidate-job.json')
    prepared = transport.load(result/'preparation-result.json')
    release = transport.load(work/'release.json')
    os.environ['ANSIBLE_CONFIG'] = str(REPO/'ansible/ansible.cfg')
    with (contextlib.nullcontext() if _already_locked else transport.installation_lock()):
        token = secrets.token_hex(6)
        read_args = result/('replacement-final-read-' + token + '.json')
        transport.write(read_args,{'router_replacement_box':box,
            'router_replacement_operation':operation,
            'router_replacement_result_dir':str(result)})
        with (result/('replacement-final-read-' + token + '.log')).open('x') as log:
            transport.command(['ansible-playbook','-vv','-i',
                REPO/'ansible/execution-inventory/hosts',
                REPO/'ansible/playbooks/74-router-replacement-final-source.yml',
                '--limit',box+'-dom0','-e','@'+str(read_args)],timeout=180,log=log)
        pending = transport.load(result/'dom0-final-pending.json')
        transaction.validate_pending(pending,request)
        if pending['phase'] != 'awaiting-acceptance':
            raise UpdateError('replacement B is not waiting for final service acceptance')
        attempt = transport.load(result/'dom0-final-attempt.json')
        enrolled = transport.load(result/'dom0-final-enrollment.json')
        finalized = transport.load(result/'dom0-finalization-result.json')
        job = finalization.job_for(request,candidate,preparation_request,
            preparation_job,prepared,release,attempt,enrolled)
        expected = service.expected(request,candidate,enrolled,finalized,release,job)
        verify_args = result/('replacement-final-verify-' + token + '.json')
        transport.write(verify_args,{'router_replacement_box':box,
            'router_replacement_operation':operation,
            'router_replacement_result_dir':str(result),
            'router_replacement_expected':expected,
            'router_replacement_overlay':overlay_source,
            'router_replacement_address':next((address for address in enrolled['addresses']
                if address.startswith('100.')),None)})
        if transport.load(verify_args)['router_replacement_address'] is None:
            raise UpdateError('replacement service target lacks a Tailscale IPv4 address')
        with (result/('replacement-final-verify-' + token + '.log')).open('x') as log:
            transport.command(['ansible-playbook','-vv','-i',
                REPO/'ansible/execution-inventory/hosts',
                REPO/'ansible/playbooks/74-router-replacement-final-verify.yml',
                '--limit',box+'-router','-e','@'+str(verify_args)],timeout=420,log=log)
        proof = service.proof(transport.load(result/'replacement-service-proof.json'),expected)
        identities = {'request_sha256':router_generations.digest(request),
            'candidate_sha256':request['candidate_sha256'],
            'enrollment_sha256':expected['enrollment_sha256'],
            'finalization_sha256':expected['finalization_sha256'],
            'service_sha256':router_generations.digest(proof)}
        acceptance = {'kind':'klokast.router-controller-acceptance.v2',**identities,
            'evidence_sha256':router_generations.digest(identities)}
        router_dom0.acceptance(acceptance,request,expected,proof)
        signal_args = result/('replacement-final-signal-' + token + '.json')
        transport.write(signal_args,{'router_replacement_box':box,
            'router_replacement_operation':operation,
            'router_replacement_result_dir':str(result),
            'router_replacement_engine':engine,
            'router_replacement_expected':expected,
            'router_replacement_proof':proof,
            'router_replacement_acceptance':acceptance})
        with (result/('replacement-final-signal-' + token + '.log')).open('x') as log:
            transport.command(['ansible-playbook','-vv','-i',
                REPO/'ansible/execution-inventory/hosts',
                REPO/'ansible/playbooks/74-router-replacement-acceptance-signal.yml',
                '--limit',box+'-dom0','-e','@'+str(signal_args)],timeout=180,log=log)
        if transport.load(result/'dom0-published-acceptance.json') != acceptance:
            raise UpdateError('dom0 published a different final B acceptance')
        return {'kind':'klokast.router-replacement-acceptance-signal.v1',
            'box':box,'operation_id':operation,'candidate_sha256':request['candidate_sha256'],
            'machine_id':expected['machine_id'],'status':'published'}


def run_replacement_cutover(box, operation):
    """Start one dom0 supervisor and drive its two narrow controller signals."""
    if (not router_updates.match(router_updates.BOX,box) or
            not re.fullmatch('[0-9a-f]{24}',operation)):
        raise UpdateError('replacement cutover requires an exact box and staged operation')
    transport.require_controller()
    if transport.command(['git','-C',REPO,'status','--porcelain','--untracked-files=all']).strip():
        raise UpdateError('replacement cutover requires a clean activated engine checkout')
    engine = transport.command(['git','-C',REPO,'rev-parse','HEAD']).strip()
    if transport.approved_engine() != engine:
        raise UpdateError('replacement cutover requires the exact activated engine')
    import router_dom0
    import router_transaction as transaction
    result,work = STATE/operation,CACHE/('replacement-'+operation)
    for directory in (result,work):
        info = directory.lstat()
        if (not stat.S_ISDIR(info.st_mode) or info.st_uid != os.geteuid() or
                stat.S_IMODE(info.st_mode) != 0o700):
            raise UpdateError('replacement cutover source directory is unsafe')
    request = transport.load(result/'transaction-request.json')
    transaction.validate(request)
    if (request['box'] != box or request['operation_id'] != operation or
            request['engine_commit'] != engine):
        raise UpdateError('replacement cutover selects another engine or operation')
    readiness = router_dom0.readiness(transport.load(result/'readiness.json'),request)
    staged = transport.load(result/'cutover-stage-result.json')
    if (staged.get('kind') != 'klokast.router-command-result.v1' or
            staged.get('action') != 'stage-cutover' or staged.get('box') != box or
            staged.get('engine_commit') != engine or
            staged.get('result',{}).get('readiness_sha256') != router_generations.digest(readiness) or
            staged['result'].get('candidate_sha256') != request['candidate_sha256'] or
            staged['result'].get('status') != 'records-qualified-no-cutover'):
        raise UpdateError('replacement cutover lacks its exact protected stage result')
    if (result/'worker.json').exists() or (result/'worker.json').is_symlink():
        raise UpdateError('replacement cutover supervisor was already started; reconcile its outcome')
    preparation = transport.load(work/'request.json')
    source = transport.load(result/'enrollment-source.json')
    profile = transport.load(PROFILE)
    os.environ['ANSIBLE_CONFIG'] = str(REPO/'ansible/ansible.cfg')
    with transport.installation_lock():
        token = secrets.token_hex(6)
        context = replacement_context(box,preparation['check_operation'],engine,profile,
                                      result,'cutover-run-'+token)
        if (context['assignment']['record_sha256'] != request['accepted_sha256'] or
                context['generation']['record_sha256'] != request['old_sha256'] or
                context['policy_sha256'] != request['policy_sha256'] or
                context['old_machine_id'] != source['old_machine_id'] or
                source['request_sha256'] != router_generations.digest(request)):
            raise UpdateError('running A or signed source changed before cutover')
        now = int(dt.datetime.now(dt.timezone.utc).timestamp())
        grant = {'kind':'klokast.router-operation-authorization.v1',
            'request_sha256':router_generations.digest(request),
            'readiness_sha256':router_generations.digest(readiness),
            'granted_at':now,'expires_at':now+900}
        if (result/'cutover-start-grant.json').exists() or (result/'cutover-start-grant.json').is_symlink():
            raise UpdateError('replacement cutover grant already exists; reconcile this operation')
        transport.write(result/'cutover-start-grant.json',grant)
        arguments = result/('cutover-start-'+token+'.json')
        transport.write(arguments,{'router_replacement_box':box,
            'router_replacement_operation':operation,
            'router_replacement_result_dir':str(result),
            'router_replacement_engine':engine,
            'router_replacement_request':request,
            'router_replacement_request_sha256':router_generations.digest(request),
            'router_replacement_grant':grant})
        with (result/('cutover-start-'+token+'.log')).open('x') as log:
            transport.command(['ansible-playbook','-vv','-i',
                REPO/'ansible/execution-inventory/hosts',
                REPO/'ansible/playbooks/74-router-replacement-cutover-start.yml',
                '--limit',box+'-dom0','-e','@'+str(arguments)],timeout=420,log=log)
        worker = transport.load(result/'worker.json')
        if (worker.get('kind') != 'klokast.router-replacement-worker.v1' or
                worker.get('box') != box or worker.get('operation_id') != operation or
                worker.get('engine_commit') != engine or
                worker.get('request_sha256') != router_generations.digest(request) or
                not isinstance(worker.get('ansible_job_id'),str) or
                not re.fullmatch('[A-Za-z0-9_.-]{1,128}',worker['ansible_job_id'])):
            raise UpdateError('replacement supervisor returned a different job')
        deadline = time.monotonic()+120+request['cutover_seconds']+request['recovery_seconds']+120
        enrollment_sent = acceptance_sent = False
        for _ in range(360):
            if time.monotonic() >= deadline:
                break
            read_token = secrets.token_hex(6)
            read_args = result/('progress-'+read_token+'-args.json')
            transport.write(read_args,{'router_replacement_box':box,
                'router_replacement_operation':operation,
                'router_replacement_result_dir':str(result),
                'router_replacement_progress_token':read_token,
                'router_replacement_worker_job_id':worker['ansible_job_id']})
            with (result/('progress-'+read_token+'.log')).open('x') as log:
                try:
                    transport.command(['ansible-playbook','-i',
                        REPO/'ansible/execution-inventory/hosts',
                        REPO/'ansible/playbooks/74-router-replacement-progress-read.yml',
                        '--limit',box+'-dom0','-e','@'+str(read_args)],timeout=120,log=log)
                except UpdateError:
                    # The controller may lose its route while A is stopped.
                    # Dom0 keeps its own fixed deadline and rollback path.
                    time.sleep(3)
                    continue
            progress = transport.load(result/('progress-'+read_token+'.json'))
            pointer = progress.get('pointer')
            state = pointer.get('result') if isinstance(pointer,dict) else None
            if (progress.get('kind') != 'klokast.router-replacement-progress.v1' or
                    progress.get('box') != box or progress.get('operation_id') != operation or
                    progress.get('worker_job_id') != worker['ansible_job_id'] or
                    not isinstance(pointer,dict) or
                    pointer.get('kind') != 'klokast.router-command-result.v1' or
                    pointer.get('action') != 'assignment-status' or
                    pointer.get('box') != box or pointer.get('engine_commit') != engine or
                    not isinstance(state,dict) or state.get('adopted') is not True):
                raise UpdateError('router cutover progress differs from the protected reader')
            pending = state.get('operation')
            if pending is None:
                assignment = state.get('assignment')
                if (not isinstance(assignment,dict) or
                        assignment.get('current_sha256') not in
                        (request['old_sha256'],request['candidate_sha256'])):
                    raise UpdateError('router cutover ended without an accepted A or B generation')
                if (assignment['current_sha256'] == request['old_sha256'] and
                        progress.get('worker_finished') is not True):
                    time.sleep(2)
                    continue
                status = ('accepted' if assignment['current_sha256'] == request['candidate_sha256'] else
                    'rolled-back' if progress.get('worker_rc') == 0 else 'refused-before-cutover')
                return {'kind':'klokast.router-replacement-cutover-result.v1',
                    'box':box,'operation_id':operation,'status':status,
                    'current_sha256':assignment['current_sha256'],
                    'worker_job_id':worker['ansible_job_id']}
            transaction.validate_pending(pending,request)
            if pending['phase'] == 'awaiting-enrollment' and not enrollment_sent:
                signal_replacement_enrollment(box,operation,_already_locked=True)
                enrollment_sent = True
            elif pending['phase'] == 'awaiting-acceptance' and not acceptance_sent:
                signal_replacement_acceptance(box,operation,_already_locked=True)
                acceptance_sent = True
            time.sleep(2)
    raise UpdateError('router cutover driver stopped before a final dom0 result; local rollback remains bounded')


def enroll_initial(box, operation):
    """Enroll a pinned first router once, or reconcile the same attempt."""
    if not router_updates.match(router_updates.BOX, box) or not re.fullmatch('[0-9a-f]{24}',operation):
        raise UpdateError('initial enrollment requires an exact box and retained operation')
    transport.require_controller()
    if transport.command(['git','-C',REPO,'status','--porcelain','--untracked-files=all']).strip():
        raise UpdateError('initial enrollment requires a clean activated engine checkout')
    engine = transport.command(['git','-C',REPO,'rev-parse','HEAD']).strip()
    if transport.approved_engine() != engine:
        raise UpdateError('initial enrollment requires the exact activated engine')
    work, result = CACHE / ('initial-' + operation), STATE / operation
    source = transport.load(work / 'request.json')
    job = transport.load(work / 'candidate-job.json')
    prepared = transport.load(result / 'preparation-result.json')
    booted = transport.load(result / 'initial-boot-result.json')
    release = transport.load(STATE / source['template_operation'] / 'release.json')
    import router_candidate_preparation
    router_candidate_preparation.validate_result(prepared,source,job)
    if (source.get('box') != box or source.get('operation_id') != operation or
            source.get('engine_commit') != engine or
            release.get('receipt_sha256') != source.get('release_sha256') or
            booted.get('kind') != 'klokast.router-initial-boot-result.v1' or
            booted.get('box') != box or booted.get('operation_id') != operation or
            booted.get('status') != 'running-first-contact' or
            booted.get('request_sha256') is None or
            not router_generations.matches('[0-9a-f]{64}',booted.get('intent_sha256'))):
        raise UpdateError('initial enrollment lacks its exact completed boot evidence')
    pins = transport.pin_initial_host_keys(result,prepared['first_contact'],operation)
    key_path = Path.home() / '.ssh/github-klokast-codex'
    proxy_hosts = Path.home() / '.ssh/known_hosts'
    for path, maximum in ((key_path,16384),(proxy_hosts,1024*1024)):
        info = path.lstat()
        if (not stat.S_ISREG(info.st_mode) or info.st_uid != os.getuid() or
                info.st_nlink != 1 or info.st_size < 1 or info.st_size > maximum or
                info.st_mode & 0o022 or path == key_path and info.st_mode & 0o077):
            raise UpdateError('initial enrollment controller SSH key or dom0 trust file is unsafe')
    guest_args = {'router_initial_box':box,'router_initial_operation':operation,
        'router_initial_backend_address':job['first_contact']['backend_address'],
        'router_initial_result_dir':str(result),
        'router_initial_known_hosts':pins['known_hosts'],
        'router_initial_host_key_alias':pins['host_key_alias'],
        'router_initial_private_key':str(key_path),
        'router_initial_proxy_known_hosts':str(proxy_hosts)}
    os.environ['ANSIBLE_CONFIG'] = str(REPO / 'ansible/ansible.cfg')
    with transport.installation_lock():
        compiled = json.loads(transport.command([REPO / 'ansible/bin/platform-resources','show']))
        if compiled.get('registry_sha256') != source['registry_sha256']:
            raise UpdateError('initial enrollment compiler inputs changed since preparation')
        attempt = secrets.token_hex(6)
        probe_args = result / ('initial-enrollment-probe-' + attempt + '.json')
        transport.write(probe_args, guest_args)
        with (result / ('initial-enrollment-probe-' + attempt + '.log')).open('x') as log:
            transport.command(['ansible-playbook','-vv','-i',
                REPO / 'ansible/execution-inventory/hosts',
                REPO / 'ansible/playbooks/74-router-initial-enrollment-probe.yml',
                '--limit',box + '-router','-e','@' + str(probe_args)],timeout=180,log=log)
        if json.loads(transport.command([REPO / 'ansible/bin/platform-resources','show'])) != compiled:
            raise UpdateError('initial enrollment compiler inputs changed during guest probe')
        now = int(dt.datetime.now(dt.timezone.utc).timestamp())
        grant = {'kind':'klokast.router-initial-enrollment-grant.v1','box':box,
                 'operation_id':operation,'engine_commit':engine,
                 'boot_request_sha256':booted['request_sha256'],
                 'boot_intent_sha256':booted['intent_sha256'],
                 'granted_at':now,'expires_at':now + 300}
        begin_args = result / ('initial-enrollment-begin-' + attempt + '.json')
        transport.write(begin_args, {'router_initial_box':box,'router_initial_operation':operation,
            'router_initial_result_dir':str(result),'router_initial_enrollment_grant':grant})
        with (result / ('initial-enrollment-begin-' + attempt + '.log')).open('x') as log:
            transport.command(['ansible-playbook','-vv','-i',
                REPO / 'ansible/execution-inventory/hosts',
                REPO / 'ansible/playbooks/74-router-initial-enrollment-begin.yml',
                '--limit',box + '-dom0','-e','@' + str(begin_args)],timeout=300,log=log)
        begun = transport.load(result / 'initial-enrollment-begin.json')
        if (begun.get('kind') != 'klokast.router-initial-enrollment-begin.v1' or
                begun.get('box') != box or begun.get('operation_id') != operation or
                begun.get('xen_uuid') != booted.get('xen_uuid') or
                begun.get('disk') != booted.get('disk') or
                not router_generations.matches('[0-9a-f]{24}',begun.get('attempt')) or
                type(begun.get('mint_permitted')) is not bool):
            raise UpdateError('first enrollment lacks its exact durable attempt record')
        guest_attempt = {**guest_args,'router_initial_attempt':begun['attempt'],
                         'router_initial_mint_permitted':begun['mint_permitted']}
        guest_path = result / ('initial-enrollment-guest-' + attempt + '.json')
        transport.write(guest_path,guest_attempt)
        with (result / ('initial-enrollment-guest-' + attempt + '.log')).open('x') as log:
            transport.command(['ansible-playbook','-vv','-i',
                REPO / 'ansible/execution-inventory/hosts',
                REPO / 'ansible/playbooks/74-router-initial-enroll.yml',
                '--limit',box + '-router','-e','@' + str(guest_path)],timeout=300,log=log)
        guest = transport.load(result / 'initial-enrollment-guest.json')
        if (guest.get('kind') != 'klokast.router-initial-enrollment-guest.v1' or
                guest.get('box') != box or guest.get('operation_id') != operation or
                guest.get('attempt') != begun['attempt'] or
                guest.get('hostname') != box + '-router' or guest.get('tags') != ['tag:vm'] or
                guest.get('ssh') is not True or
                not router_generations.matches('[A-Za-z0-9_-]{1,128}',guest.get('machine_id')) or
                not router_generations.matches('[0-9a-f]{64}',guest.get('state_sha256'))):
            raise UpdateError('first enrollment guest returned a different Tailnet identity')
        if json.loads(transport.command([REPO / 'ansible/bin/platform-resources','show'])) != compiled:
            raise UpdateError('initial enrollment compiler inputs changed before recording the identity')
        now = int(dt.datetime.now(dt.timezone.utc).timestamp())
        finish = {'kind':'klokast.router-initial-enrollment-finish-grant.v1','box':box,
            'operation_id':operation,'engine_commit':engine,'intent_sha256':begun['intent_sha256'],
            'guest_sha256':router_generations.digest(guest),'granted_at':now,'expires_at':now + 300}
        finish_args = result / ('initial-enrollment-finish-' + attempt + '.json')
        transport.write(finish_args, {'router_initial_box':box,'router_initial_operation':operation,
            'router_initial_result_dir':str(result),'router_initial_finish_grant':finish,
            'router_initial_guest_receipt':guest})
        with (result / ('initial-enrollment-finish-' + attempt + '.log')).open('x') as log:
            transport.command(['ansible-playbook','-vv','-i',
                REPO / 'ansible/execution-inventory/hosts',
                REPO / 'ansible/playbooks/74-router-initial-enrollment-finish.yml',
                '--limit',box + '-dom0','-e','@' + str(finish_args)],timeout=300,log=log)
        enrolled = transport.load(result / 'initial-enrollment-result.json')
        installation = router_records.initial_installation.validate(enrolled.get('installation'),box)
        if (enrolled.get('kind') != 'klokast.router-initial-enrollment-result.v1' or
                enrolled.get('box') != box or enrolled.get('operation_id') != operation or
                enrolled.get('status') != 'enrolled-first-contact' or
                enrolled.get('guest_sha256') != finish['guest_sha256'] or
                enrolled.get('machine_id') != guest['machine_id'] or
                enrolled.get('state_sha256') != guest['state_sha256'] or
                installation['stage'] != 'enrolled' or
                installation['enrollment_sha256'] != finish['guest_sha256']):
            raise UpdateError('first enrollment lacks its exact retained identity record')
        return {'kind':'klokast.router-initial-enrollment-result.v1','box':box,
                'operation':operation,'status':'enrolled-first-contact',
                'machine_id':guest['machine_id'],'evidence_directory':str(result)}


def finalize_initial(box, operation):
    """Stop the enrolled first router and retire temporary SSH offline."""
    if not router_updates.match(router_updates.BOX, box) or not re.fullmatch('[0-9a-f]{24}',operation):
        raise UpdateError('initial finalization requires an exact box and retained operation')
    transport.require_controller()
    if transport.command(['git','-C',REPO,'status','--porcelain','--untracked-files=all']).strip():
        raise UpdateError('initial finalization requires a clean activated engine checkout')
    engine = transport.command(['git','-C',REPO,'rev-parse','HEAD']).strip()
    if transport.approved_engine() != engine:
        raise UpdateError('initial finalization requires the exact activated engine')
    work, result = CACHE / ('initial-' + operation), STATE / operation
    source = transport.load(work / 'request.json')
    preparation_job = transport.load(work / 'candidate-job.json')
    prepared = transport.load(result / 'preparation-result.json')
    enrolled = transport.load(result / 'initial-enrollment-result.json')
    enrollment_guest = transport.load(result / 'initial-enrollment-guest.json')
    release = transport.load(STATE / source['template_operation'] / 'release.json')
    profile = transport.load(PROFILE)
    import router_candidate_preparation
    import router_initial_finalization as finalization
    router_candidate_preparation.validate_result(prepared,source,preparation_job)
    router_updates.validate_release(release,profile,engine)
    current = router_records.initial_installation.validate(enrolled['installation'],box)
    if (source.get('box') != box or source.get('operation_id') != operation or
            source.get('engine_commit') != engine or
            current['stage'] != 'enrolled' or current['operation_id'] != operation or
            current['engine_commit'] != engine or
            current['release_sha256'] != release['receipt_sha256'] or
            current['enrollment_sha256'] != router_generations.digest(enrollment_guest) or
            current['machine_id'] != enrollment_guest.get('machine_id')):
        raise UpdateError('initial finalization lacks the exact enrolled installation')
    frozen = CACHE / source['source_operation']
    if (frozen.parent != CACHE or
            transport.load(frozen / 'inputs.json') != release['inputs']):
        raise UpdateError('initial finalization frozen source differs from its selected release')
    final = work / 'finalization'
    job = finalization.job_for(box,operation,source,preparation_job,prepared,release,enrollment_guest)
    base = {'kind':'klokast.router-initial-finalization.v1','box':box,
        'operation_id':operation,'engine_commit':engine,
        'source_operation':source['source_operation'],
        'inputs_sha256':source['inputs_sha256'],
        'source_request_sha256':router_generations.digest(source),
        'release_sha256':release['receipt_sha256'],
        'enrollment_sha256':current['enrollment_sha256'],
        'job_sha256':router_generations.digest(job)}
    os.environ['ANSIBLE_CONFIG'] = str(REPO / 'ansible/ansible.cfg')
    with transport.installation_lock():
        compiled = json.loads(transport.command([REPO / 'ansible/bin/platform-resources','show']))
        if compiled.get('registry_sha256') != source['registry_sha256']:
            raise UpdateError('initial finalization compiler inputs changed since preparation')
        if final.exists() or final.is_symlink():
            if not final.is_dir() or final.is_symlink() or final.stat().st_mode & 0o077:
                raise UpdateError('initial finalization controller input directory is unsafe')
            value = transport.load(final / 'request.json')
            parts = transport.load(final / 'parts.json')
            if ({key:item for key,item in value.items() if key != 'bootstrap'} != base or
                    transport.load(final / 'job.json') != job):
                raise UpdateError('initial finalization retry differs from the recorded job')
        else:
            final.mkdir(mode=0o700)
            transport.write(final / 'job.json',job)
            guest = REPO / 'ansible/roles/router-initial-preparation/files/router-initial-finalize-guest'
            modules = ('router_candidate','router_finalize','router_personalize','router_overlay_ipv6',
                       'router_initial_contact','router_state')
            job_files = {'usr/local/lib/klokast/' + name + '.py':
                         REPO / 'ansible/lib' / (name + '.py') for name in modules}
            job_files['router-initial-finalization-job.json'] = final / 'job.json'
            boot = vm_template_inputs.bootstrap(frozen,final / 'boot',guest,
                expected_profile=router_updates.PROFILE,job_files=job_files)
            base['bootstrap'] = boot
            value = base
            (final / 'transfer').mkdir(mode=0o700)
            parts = []
            for name in ('kernel','initramfs'):
                parts.extend({'artifact':name,**part} for part in router_template_inputs.split_payload(
                    final / 'boot' / name, final / 'transfer' / name,boot[name]))
            transport.write(final / 'parts.json',parts)
            transport.write(final / 'request.json',value)
        finalization.request(value,job,source,release,current,box,operation,engine,job)
        attempt = secrets.token_hex(6)
        stage_args = result / ('initial-finalization-stage-' + attempt + '.json')
        transport.write(stage_args,{'router_final_box':box,'router_final_operation':operation,
            'router_final_input_dir':str(final),'router_final_result_dir':str(result),
            'router_final_request':value,'router_final_job':job,'router_final_parts':parts})
        with (result / ('initial-finalization-stage-' + attempt + '.log')).open('x') as log:
            transport.command(['ansible-playbook','-vv','-i',
                REPO / 'ansible/execution-inventory/hosts',
                REPO / 'ansible/playbooks/74-router-initial-finalization-stage.yml',
                '--limit',box + '-dom0','-e','@' + str(stage_args)],timeout=7200,log=log)
        if (transport.approved_engine() != engine or
                json.loads(transport.command([REPO / 'ansible/bin/platform-resources','show'])) != compiled):
            raise UpdateError('initial finalization authority changed during staging; router remains running')
        now = int(dt.datetime.now(dt.timezone.utc).timestamp())
        stop_grant = {'kind':'klokast.router-initial-stop-grant.v1','engine_commit':engine,
            'request_sha256':router_generations.digest(value),
            'installation_sha256':current['record_sha256'],
            'granted_at':now,'expires_at':now + 900}
        finalization.grant(stop_grant,(stop_grant['request_sha256'],current['record_sha256']),
                           'stop',engine,now)
        stop_args = result / ('initial-finalization-stop-' + attempt + '.json')
        transport.write(stop_args,{'router_final_box':box,'router_final_operation':operation,
            'router_final_result_dir':str(result),'router_final_stop_grant':stop_grant})
        with (result / ('initial-finalization-stop-' + attempt + '.log')).open('x') as log:
            transport.command(['ansible-playbook','-vv','-i',
                REPO / 'ansible/execution-inventory/hosts',
                REPO / 'ansible/playbooks/74-router-initial-finalization-stop.yml',
                '--limit',box + '-dom0','-e','@' + str(stop_args)],timeout=300,log=log)
        stopped = transport.load(result / 'initial-stop-result.json')
        if (stopped.get('kind') != 'klokast.router-initial-stop-result.v1' or
                stopped.get('box') != box or stopped.get('operation_id') != operation or
                stopped.get('status') != 'stopped-for-offline-finalization' or
                stopped.get('disk') != current['disk']):
            raise UpdateError('initial finalization has no exact stopped router result')
        now = int(dt.datetime.now(dt.timezone.utc).timestamp())
        run_grant = {'kind':'klokast.router-initial-finalize-grant.v1','engine_commit':engine,
            'request_sha256':stop_grant['request_sha256'],
            'installation_sha256':current['record_sha256'],
            'granted_at':now,'expires_at':now + 900}
        run_args = result / ('initial-finalization-run-' + attempt + '.json')
        transport.write(run_args,{'router_final_box':box,'router_final_operation':operation,
            'router_final_result_dir':str(result),'router_final_run_grant':run_grant})
        with (result / ('initial-finalization-run-' + attempt + '.log')).open('x') as log:
            transport.command(['ansible-playbook','-vv','-i',
                REPO / 'ansible/execution-inventory/hosts',
                REPO / 'ansible/playbooks/74-router-initial-finalization-run.yml',
                '--limit',box + '-dom0','-e','@' + str(run_args)],timeout=1200,log=log)
        complete = transport.load(result / 'initial-finalization-complete.json')
        native_result = transport.load(result / 'initial-finalization-result.json')
        if (complete.get('kind') != 'klokast.router-initial-finalization-complete.v1' or
                complete.get('box') != box or complete.get('operation_id') != operation or
                complete.get('status') != 'offline-finalized' or
                complete.get('disk') != current['disk'] or
                complete.get('result_sha256') != router_generations.digest(native_result) or
                native_result.get('success') is not True or
                native_result.get('machine_id') != current['machine_id'] or
                native_result.get('finalized',{}).get('packages') != release['runtime_packages']):
            raise UpdateError('initial finalization lacks exact offline completion evidence')
        return {'kind':'klokast.router-initial-finalization-result.v1','box':box,
            'operation':operation,'status':'offline-finalized',
            'evidence_directory':str(result),'router_started':False}


def boot_final_initial(box, operation):
    """Start the finalized first router; verification and acceptance follow."""
    if not router_updates.match(router_updates.BOX,box) or not re.fullmatch('[0-9a-f]{24}',operation):
        raise UpdateError('final router boot requires an exact box and retained operation')
    transport.require_controller()
    if transport.command(['git','-C',REPO,'status','--porcelain','--untracked-files=all']).strip():
        raise UpdateError('final router boot requires a clean activated engine checkout')
    engine = transport.command(['git','-C',REPO,'rev-parse','HEAD']).strip()
    if transport.approved_engine() != engine:
        raise UpdateError('final router boot requires the exact activated engine')
    work,result = CACHE / ('initial-' + operation),STATE / operation
    source = transport.load(work / 'request.json')
    preparation_job = transport.load(work / 'candidate-job.json')
    prepared = transport.load(result / 'preparation-result.json')
    enrolled = transport.load(result / 'initial-enrollment-result.json')
    enrollment_guest = transport.load(result / 'initial-enrollment-guest.json')
    release = transport.load(STATE / source['template_operation'] / 'release.json')
    final = work / 'finalization'
    value,job = transport.load(final / 'request.json'),transport.load(final / 'job.json')
    complete = transport.load(result / 'initial-finalization-complete.json')
    native_result = transport.load(result / 'initial-finalization-result.json')
    import router_initial_finalization as finalization
    current = router_records.initial_installation.validate(enrolled['installation'],box)
    if (current['stage'] != 'enrolled' or current['operation_id'] != operation or
            current['engine_commit'] != engine or current['machine_id'] != enrollment_guest.get('machine_id') or
            current['enrollment_sha256'] != router_generations.digest(enrollment_guest) or
            source.get('registry_sha256') is None):
        raise UpdateError('final router boot lacks the exact enrolled installation')
    finalization.request(value,job,source,release,current,box,operation,engine,
        finalization.job_for(box,operation,source,preparation_job,prepared,release,enrollment_guest))
    if (complete.get('kind') != 'klokast.router-initial-finalization-complete.v1' or
            complete.get('box') != box or complete.get('operation_id') != operation or
            complete.get('status') != 'offline-finalized' or
            complete.get('disk') != current['disk'] or
            complete.get('result_sha256') != router_generations.digest(native_result) or
            native_result.get('success') is not True or
            native_result.get('machine_id') != current['machine_id'] or
            native_result.get('finalized',{}).get('packages') != release['runtime_packages']):
        raise UpdateError('final router boot lacks exact offline cleanup evidence')
    os.environ['ANSIBLE_CONFIG'] = str(REPO / 'ansible/ansible.cfg')
    with transport.installation_lock():
        compiled = json.loads(transport.command([REPO / 'ansible/bin/platform-resources','show']))
        if compiled.get('registry_sha256') != source['registry_sha256']:
            raise UpdateError('final router boot compiler inputs changed since preparation')
        now = int(dt.datetime.now(dt.timezone.utc).timestamp())
        grant = {'kind':'klokast.router-initial-boot-final-grant.v1',
                 'engine_commit':engine,'request_sha256':router_generations.digest(complete),
                 'installation_sha256':current['record_sha256'],
                 'granted_at':now,'expires_at':now+300}
        finalization.grant(grant,(grant['request_sha256'],current['record_sha256']),
                           'boot-final',engine,now)
        attempt = secrets.token_hex(6)
        args = result / ('initial-final-boot-' + attempt + '.json')
        transport.write(args,{'router_final_box':box,'router_final_operation':operation,
            'router_final_result_dir':str(result),'router_final_boot_grant':grant})
        with (result / ('initial-final-boot-' + attempt + '.log')).open('x') as log:
            transport.command(['ansible-playbook','-vv','-i',
                REPO / 'ansible/execution-inventory/hosts',
                REPO / 'ansible/playbooks/74-router-initial-final-boot.yml',
                '--limit',box + '-dom0','-e','@' + str(args)],timeout=420,log=log)
        booted = transport.load(result / 'initial-final-boot-result.json')
        if (booted.get('kind') != 'klokast.router-initial-final-boot-result.v1' or
                booted.get('box') != box or booted.get('operation_id') != operation or
                booted.get('status') != 'running-unverified' or
                booted.get('complete_sha256') != grant['request_sha256'] or
                booted.get('disk') != current['disk']):
            raise UpdateError('final router boot lacks exact native runtime evidence')
        return {'kind':'klokast.router-initial-final-boot-result.v1','box':box,
                'operation':operation,'status':'running-unverified',
                'evidence_directory':str(result)}


def verify_initial(box, operation):
    """Check the unaccepted final router against its frozen runtime identity."""
    if not router_updates.match(router_updates.BOX,box) or not re.fullmatch('[0-9a-f]{24}',operation):
        raise UpdateError('initial runtime verification requires an exact box and operation')
    transport.require_controller()
    if transport.command(['git','-C',REPO,'status','--porcelain','--untracked-files=all']).strip():
        raise UpdateError('initial runtime verification requires a clean activated engine checkout')
    engine = transport.command(['git','-C',REPO,'rev-parse','HEAD']).strip()
    if transport.approved_engine() != engine:
        raise UpdateError('initial runtime verification requires the exact activated engine')
    work,result = CACHE / ('initial-' + operation),STATE / operation
    source = transport.load(work / 'request.json')
    preparation_job = transport.load(work / 'candidate-job.json')
    prepared = transport.load(result / 'preparation-result.json')
    enrolled = transport.load(result / 'initial-enrollment-result.json')
    enrollment_guest = transport.load(result / 'initial-enrollment-guest.json')
    release = transport.load(STATE / source['template_operation'] / 'release.json')
    profile = transport.load(PROFILE)
    final = work / 'finalization'
    value,job = transport.load(final / 'request.json'),transport.load(final / 'job.json')
    cleanup = transport.load(result / 'initial-finalization-complete.json')
    offline = transport.load(result / 'initial-finalization-result.json')
    booted = transport.load(result / 'initial-final-boot-result.json')
    import router_candidate_preparation
    import router_initial_acceptance as acceptance
    import router_initial_finalization as finalization
    current = router_records.initial_installation.validate(enrolled['installation'],box)
    router_updates.validate_release(release,profile,engine)
    router_candidate_preparation.validate_result(prepared,source,preparation_job)
    if (current['stage'] != 'enrolled' or current['operation_id'] != operation or
            current['engine_commit'] != engine or
            current['preparation_sha256'] != router_generations.digest(prepared) or
            current['machine_id'] != enrollment_guest.get('machine_id') or
            current['enrollment_sha256'] != router_generations.digest(enrollment_guest) or
            source.get('box') != box or source.get('engine_commit') != engine):
        raise UpdateError('initial runtime verification lacks exact final boot evidence')
    finalization.request(value,job,source,release,current,box,operation,engine,
        finalization.job_for(box,operation,source,preparation_job,prepared,release,enrollment_guest))
    if (
            cleanup.get('kind') != 'klokast.router-initial-finalization-complete.v1' or
            cleanup.get('box') != box or cleanup.get('operation_id') != operation or
            cleanup.get('status') != 'offline-finalized' or cleanup.get('disk') != current['disk'] or
            cleanup.get('result_sha256') != router_generations.digest(offline) or
            offline.get('success') is not True or offline.get('machine_id') != current['machine_id'] or
            offline.get('finalized',{}).get('packages') != release['runtime_packages'] or
            booted.get('kind') != 'klokast.router-initial-final-boot-result.v1' or
            booted.get('box') != box or booted.get('operation_id') != operation or
            booted.get('status') != 'running-unverified' or
            booted.get('complete_sha256') != router_generations.digest(cleanup) or
            booted.get('disk') != current['disk']):
        raise UpdateError('initial runtime verification lacks exact final boot evidence')
    expected = acceptance.expected_for(box,operation,engine,current,prepared,release,offline)
    os.environ['ANSIBLE_CONFIG'] = str(REPO / 'ansible/ansible.cfg')
    with transport.installation_lock():
        compiled = json.loads(transport.command([REPO / 'ansible/bin/platform-resources','show']))
        if compiled.get('registry_sha256') != source['registry_sha256']:
            raise UpdateError('initial runtime compiler inputs changed since preparation')
        attempt = secrets.token_hex(6)
        arguments = result / ('initial-runtime-verify-' + attempt + '.json')
        transport.write(arguments,{'router_initial_box':box,'router_initial_operation':operation,
            'router_initial_result_dir':str(result),'router_initial_expected':expected})
        with (result / ('initial-runtime-verify-' + attempt + '.log')).open('x') as log:
            transport.command(['ansible-playbook','-vv','-i',
                REPO / 'ansible/execution-inventory/hosts',
                REPO / 'ansible/playbooks/74-router-initial-final-verify.yml',
                '--limit',box + '-router','-e','@' + str(arguments)],timeout=900,log=log)
        verified = transport.load(result / 'initial-runtime-verification.json')
        if (verified != {'kind':'klokast.router-initial-runtime-verification.v1',
                'box':box,'operation_id':operation,'expected_sha256':expected['record_sha256'],
                'release_sha256':release['receipt_sha256'],'machine_id':current['machine_id'],
                'status':'verified','services':True,'packages':True,
                'identity':True,'management':True,'dom0':True} or
                json.loads(transport.command([REPO / 'ansible/bin/platform-resources','show'])) != compiled):
            raise UpdateError('initial runtime verification changed or returned incomplete evidence')
        return {'kind':'klokast.router-initial-runtime-verification.v1','box':box,
                'operation':operation,'status':'verified',
                'evidence_directory':str(result)}


def accept_initial(box, operation):
    """Publish one fully verified first router and install its Xen autostart."""
    if not router_updates.match(router_updates.BOX,box) or not re.fullmatch('[0-9a-f]{24}',operation):
        raise UpdateError('initial acceptance requires an exact box and retained operation')
    transport.require_controller()
    if transport.command(['git','-C',REPO,'status','--porcelain','--untracked-files=all']).strip():
        raise UpdateError('initial acceptance requires a clean activated engine checkout')
    engine = transport.command(['git','-C',REPO,'rev-parse','HEAD']).strip()
    if transport.approved_engine() != engine:
        raise UpdateError('initial acceptance requires the exact activated engine')
    work,result = CACHE / ('initial-' + operation),STATE / operation
    source = transport.load(work / 'request.json')
    preparation_job = transport.load(work / 'candidate-job.json')
    prepared = transport.load(result / 'preparation-result.json')
    enrolled = transport.load(result / 'initial-enrollment-result.json')
    enrollment_guest = transport.load(result / 'initial-enrollment-guest.json')
    release = transport.load(STATE / source['template_operation'] / 'release.json')
    profile = transport.load(PROFILE)
    offline = transport.load(result / 'initial-finalization-result.json')
    complete = transport.load(result / 'initial-finalization-complete.json')
    booted = transport.load(result / 'initial-final-boot-result.json')
    verification = transport.load(result / 'initial-runtime-verification.json')
    import router_initial_acceptance as acceptance
    import router_candidate_preparation
    router_updates.validate_release(release,profile,engine)
    router_candidate_preparation.validate_result(prepared,source,preparation_job)
    current = router_records.initial_installation.validate(enrolled['installation'],box)
    if (current['stage'] != 'enrolled' or current['operation_id'] != operation or
            current['engine_commit'] != engine or current['machine_id'] != enrollment_guest.get('machine_id') or
            current['enrollment_sha256'] != router_generations.digest(enrollment_guest) or
            source.get('box') != box or source.get('engine_commit') != engine or
            source.get('registry_sha256') is None or
            complete.get('result_sha256') != router_generations.digest(offline) or
            complete.get('disk') != current['disk'] or
            offline.get('success') is not True or offline.get('machine_id') != current['machine_id'] or
            booted.get('status') != 'running-unverified' or booted.get('disk') != current['disk'] or
            booted.get('complete_sha256') != router_generations.digest(complete)):
        raise UpdateError('initial acceptance lacks exact enrolled, cleanup, and final boot evidence')
    expected = acceptance.expected_for(box,operation,engine,current,prepared,release,offline)
    acceptance.verification(verification,expected,box,operation)
    os.environ['ANSIBLE_CONFIG'] = str(REPO / 'ansible/ansible.cfg')
    with transport.installation_lock():
        compiled = json.loads(transport.command([REPO / 'ansible/bin/platform-resources','show']))
        if compiled.get('registry_sha256') != source['registry_sha256']:
            raise UpdateError('initial acceptance compiler inputs changed since preparation')
        attempt = secrets.token_hex(6)
        stage_args = result / ('initial-accept-stage-' + attempt + '.json')
        transport.write(stage_args,{'router_initial_box':box,
            'router_initial_operation':operation,'router_initial_expected':expected,
            'router_initial_verification':verification})
        with (result / ('initial-accept-stage-' + attempt + '.log')).open('x') as log:
            transport.command(['ansible-playbook','-vv','-i',
                REPO / 'ansible/execution-inventory/hosts',
                REPO / 'ansible/playbooks/74-router-initial-accept-stage.yml',
                '--limit',box + '-dom0','-e','@' + str(stage_args)],timeout=600,log=log)
        if (transport.approved_engine() != engine or
                json.loads(transport.command([REPO / 'ansible/bin/platform-resources','show'])) != compiled):
            raise UpdateError('initial acceptance authority changed during staging')
        now = int(dt.datetime.now(dt.timezone.utc).timestamp())
        grant = {'kind':'klokast.router-initial-accept-grant.v1',
            'box':box,'operation_id':operation,'engine_commit':engine,
            'verification_sha256':router_generations.digest(verification),
            'installation_sha256':current['record_sha256'],
            'granted_at':now,'expires_at':now+300}
        acceptance.grant(grant,verification,current,engine,box,operation,now)
        run_args = result / ('initial-accept-run-' + attempt + '.json')
        transport.write(run_args,{'router_initial_box':box,
            'router_initial_operation':operation,'router_initial_result_dir':str(result),
            'router_initial_accept_grant':grant})
        with (result / ('initial-accept-run-' + attempt + '.log')).open('x') as log:
            transport.command(['ansible-playbook','-vv','-i',
                REPO / 'ansible/execution-inventory/hosts',
                REPO / 'ansible/playbooks/74-router-initial-accept-run.yml',
                '--limit',box + '-dom0','-e','@' + str(run_args)],timeout=600,log=log)
        native_result = transport.load(result / 'initial-acceptance-result.json')
        generation = router_generations.generation(transport.load(result / 'initial-generation.json'),box)
        installation = router_records.initial_installation.validate(
            transport.load(result / 'initial-verified-installation.json'),box)
        accepted = router_records.assignment(transport.load(result / 'initial-accepted.json'),box)
        router_records.initial_installation.matches_generation(installation,generation,box)
        if (native_result != {'kind':'klokast.router-initial-acceptance-result.v1',
                'box':box,'operation_id':operation,'status':'accepted',
                'generation_sha256':generation['record_sha256'],
                'assignment_sha256':accepted['record_sha256']} or
                accepted['current_sha256'] != generation['record_sha256'] or
                accepted['previous_sha256'] is not None or
                accepted['policy_sha256'] != router_records.INITIAL_AUTHORITY_SHA256 or
                generation['engine_commit'] != engine or
                generation['evidence_sha256'] != router_generations.digest(verification) or
                generation['packages'] != release['runtime_packages'] or
                generation['tailscale'] != prepared['prepared']['tailscale'] or
                generation['configuration_files'] != prepared['prepared']['configuration_files'] or
                generation['disk'] != current['disk'] or
                json.loads(transport.command([REPO / 'ansible/bin/platform-resources','show'])) != compiled):
            raise UpdateError('first accepted router differs from its verified release and identity')
        return {'kind':'klokast.router-initial-acceptance-result.v1',
            'box':box,'operation':operation,'status':'accepted',
            'generation_sha256':generation['record_sha256'],
            'evidence_directory':str(result)}


def adopt_legacy(box):
    """Issue one supervised baseline from fresh evidence on the active controller."""
    if not router_updates.match(router_updates.BOX, box):
        raise UpdateError('router baseline adoption requires an exact box ID')
    transport.require_controller()
    if transport.command(['git', '-C', REPO, 'status', '--porcelain', '--untracked-files=all']).strip():
        raise UpdateError('router baseline adoption requires a clean public implementation checkout')
    engine = transport.command(['git', '-C', REPO, 'rev-parse', 'HEAD']).strip()
    if transport.approved_engine() != engine:
        raise UpdateError('router baseline adoption requires the activated signed engine commit')
    os.environ['ANSIBLE_CONFIG'] = str(REPO / 'ansible/ansible.cfg')
    with transport.installation_lock():
        setup = STATE / secrets.token_hex(12)
        setup.mkdir(mode=0o700)
        with (setup / 'recovery-install.log').open('x') as log:
            transport.command(['ansible-playbook', '-vv', '-i', REPO / 'ansible/execution-inventory/hosts',
                REPO / 'ansible/playbooks/74-router-recovery-setup.yml', '--limit', box + '-dom0'],
                timeout=600, log=log)
        inspected = inspect(box)
        if not inspected['adoption_ready']:
            raise UpdateError('legacy router baseline is blocked: ' + ', '.join(inspected['adoption_findings']))
        directory = Path(inspected['evidence_directory'])
        record = router_legacy_generation.assemble(box=box, operation=inspected['operation'],
            engine_commit=engine, guest=transport.load(directory / (box + '-router.json')),
            dom0=transport.load(directory / (box + '-dom0.json')))
        now = int(dt.datetime.now(dt.timezone.utc).timestamp())
        grant = {'kind':'klokast.router-baseline-grant.v1', 'box':box,
            'operation_id':record['generation_id'], 'engine_commit':engine,
            'generation_sha256':record['record_sha256'], 'inspection_sha256':record['evidence_sha256'],
            'granted_at':now, 'expires_at':now + 300}
        arguments = directory / 'adoption-arguments.json'
        transport.write(arguments, {'router_baseline_box':box, 'router_baseline_operation':inspected['operation'],
                                    'router_baseline_record':record, 'router_baseline_grant':grant})
        with (directory / 'adoption.log').open('x') as log:
            transport.command(['ansible-playbook', '-vv', '-i', REPO / 'ansible/execution-inventory/hosts',
                REPO / 'ansible/playbooks/74-router-baseline-adopt.yml', '--limit', box + '-dom0',
                '-e', '@' + str(arguments)], timeout=300, log=log)
        return {'kind':'klokast.router-baseline-adoption-result.v1', 'box':box,
                'generation_sha256':record['record_sha256'], 'operation':record['generation_id'],
                'evidence_directory':str(directory), 'status':'adopted'}


def inspect(box):
    if not router_updates.match(router_updates.BOX, box):
        raise UpdateError('router inspection requires a valid box ID')
    transport.require_controller()
    os.environ['ANSIBLE_CONFIG'] = str(REPO / 'ansible/ansible.cfg')
    if not STATE.is_dir() or STATE.is_symlink():
        raise UpdateError('install platform-update-discovery before router inspection')
    operation = secrets.token_hex(12)
    directory = STATE / operation
    directory.mkdir(mode=0o700)
    args = directory / 'arguments.json'
    compiled = json.loads(transport.command([REPO / 'ansible/bin/platform-resources', 'show']))
    expected = router_updates.expected_includes(compiled, box)
    compiler = runpy.run_path(str(REPO / 'ansible/bin/platform-resources'))
    box_variables = compiler['box_access_router_vars'](compiled, box)
    transport.write(args, {**box_variables, 'router_update_box': box, 'router_update_result_dir': str(directory),
                           'router_update_expected_includes': expected})
    with (directory / 'inspection.log').open('x') as log:
        transport.command(['ansible-playbook', '-vv', '-i', REPO / 'ansible/execution-inventory/hosts',
                           REPO / 'ansible/playbooks/74-router-update-inspect.yml', '-e', '@' + str(args)],
                          timeout=600, log=log)
    records = {}
    for target in ('dom0', 'router'):
        result = transport.load(directory / (box + '-' + target + '.json'))
        if result.get('box') != box or result.get('target') != target:
            raise UpdateError('router inspection did not return both exact target identities')
        records[target] = result
    if records['router'].get('overlay_ipv6_enabled') is True:
        import router_overlay_ipv6
        source = signed_overlay_source(box)
        topology = compiler['load_topology']()
        ops = topology['control_zones']['ops']
        selected = router_overlay_ipv6.files(source, box,
            wan=topology['realms']['wan']['router_interface'],
            ops=ops['router_interface'], ops_ipv4=ops['vm_ipv4_address'])
        router = records['router']
        if ('signed_overlay_source_sha256' in router or
                not isinstance(router.get('expected_configuration'), dict) or
                not isinstance(router.get('expected_includes'), dict) or
                not isinstance(router['expected_includes'].get('files'), dict)):
            raise UpdateError('router inspection has an unexpected signed-overlay record')
        router['signed_overlay_source_sha256'] = source['source_sha256']
        for path, content in selected.items():
            target = ('expected_includes' if path.startswith('etc/dnsmasq.d/')
                      else 'expected_configuration')
            expected_files = router[target]['files'] if target == 'expected_includes' else router[target]
            full_path = '/' + path
            if full_path in expected_files:
                raise UpdateError('signed router IPv6 file conflicts with the compiled configuration')
            expected_files[full_path] = hashlib.sha256(content.encode()).hexdigest()
        transport.write(directory / (box + '-router.json'), router)
    findings = router_updates.legacy_baseline_findings(records['router'], records['dom0'], box)
    return {'kind': 'klokast.router-inspection-result.v1', 'box': box,
            'operation': operation, 'evidence_directory': str(directory),
            'status': 'inspected', 'adoption_ready': not findings,
            'adoption_findings': findings, 'adoption_authorized': False}


def schedule_source():
    value = json.loads(transport.command(['/usr/bin/doas', '/usr/local/sbin/ksa-apply',
        'vm-update-policy', 'schedule-source']), object_pairs_hook=transport.unique_object)
    if (not isinstance(value, dict) or value.get('kind') != 'klokast.vm-update-schedule.v1' or
            type(value.get('activated')) is not bool or not isinstance(value.get('policy'), dict)):
        raise UpdateError('router input selection has no verified Instance update schedule')
    return value


def resolve_initial():
    """Read bootstrap version policy without requiring standing replacement authority."""
    transport.require_controller()
    engine = transport.command(['git', '-C', REPO, 'rev-parse', 'HEAD']).strip()
    if transport.approved_engine() != engine:
        raise UpdateError('router bootstrap input selection requires the activated engine')
    schedule = schedule_source()
    profile = transport.load(PROFILE)
    router_updates.validate_profile(profile)
    now = dt.datetime.now(dt.timezone.utc)
    releases, checksum = upstream.fetch_json(profile['release_metadata'])
    branch = router_updates.select_branch('initial-install', releases, now, schedule['policy'])
    result = resolve(branch)
    if schedule_source() != schedule or transport.approved_engine() != engine:
        raise UpdateError('router bootstrap source or version policy changed during resolution')
    selection = router_updates.seal({'kind': 'klokast.router-bootstrap-input-selection.v1',
        'engine_commit': engine, 'observed_at': timestamp(now), 'branch': branch,
        'branch_delay_days': schedule['policy']['branch-delay-days'],
        'schedule_sha256': router_updates.digest(schedule), 'metadata_sha256': checksum,
        'inputs_sha256': result['inputs_sha256'], 'replacement_authorized': False})
    router_updates.validate_initial_selection(
        selection, result, schedule, engine, releases, checksum, dt.datetime.now(dt.timezone.utc))
    transport.write(Path(result['inputs_directory']) / 'selection.json', selection)
    return {**result, 'selection_sha256': selection['receipt_sha256']}


def resolve(branch):
    transport.require_controller()
    if not CACHE.is_dir() or CACHE.is_symlink():
        raise UpdateError('install platform-update-discovery before router resolution')
    if transport.command(['git', '-C', REPO, 'status', '--porcelain', '--untracked-files=no']).strip():
        raise UpdateError('router input resolution requires a clean public implementation checkout')
    engine = transport.command(['git', '-C', REPO, 'rev-parse', 'HEAD']).strip()
    profile = transport.load(PROFILE)
    router_updates.validate_profile(profile)
    directory = CACHE / secrets.token_hex(12)
    value = vm_template_inputs.freeze(directory, profile, branch, engine,
                                     expected_profile=router_updates.PROFILE,
                                     apk_network_timeout=3,
                                     component_resolver=lambda path: router_tailscale.freeze(path, REPO))
    router_updates.validate_inputs(value, profile, engine)
    return {'kind': 'klokast.router-resolved-inputs.v1', 'observed_at': timestamp(dt.datetime.now(dt.timezone.utc)),
            'inputs_directory': str(directory), 'inputs_sha256': value['inputs_sha256'],
            'effective_inputs_sha256': router_updates.effective_inputs(value),
            'branch': branch, 'packages': {p['name']: p['version'] for p in value['packages']},
            'tailscale': {'version': value['tailscale']['version'],
                          'sha256': value['tailscale']['sha256']},
            'replacement_authorized': False}


def initial_template_selection(source, profile, engine):
    """Require the current bootstrap policy to select these exact frozen inputs."""
    manifest = transport.load(source / 'inputs.json')
    router_updates.validate_inputs(manifest, profile, engine)
    if transport.approved_engine() != engine:
        raise UpdateError('router initial template requires the activated engine')
    schedule = schedule_source()
    releases, checksum = upstream.fetch_json(profile['release_metadata'])
    selection = transport.load(source / 'selection.json')
    router_updates.validate_initial_selection(selection, manifest, schedule, engine,
                                              releases, checksum, dt.datetime.now(dt.timezone.utc))
    if schedule_source() != schedule or transport.approved_engine() != engine:
        raise UpdateError('router initial template policy or engine changed during validation')
    return selection['receipt_sha256']


def build_template(box, source, *, compatibility_inventory=False, initial_selection=False):
    if not router_updates.match(router_updates.BOX, box):
        raise UpdateError('router template requires an exact box ID')
    transport.require_controller()
    source = Path(source)
    if source.parent != CACHE or not router_updates.match(re.compile('[0-9a-f]{24}'), source.name):
        raise UpdateError('router template inputs must select one frozen controller cache directory')
    if transport.command(['git', '-C', REPO, 'status', '--porcelain', '--untracked-files=no']).strip():
        raise UpdateError('router template requires a clean public implementation checkout')
    engine = transport.command(['git', '-C', REPO, 'rev-parse', 'HEAD']).strip()
    os.environ['ANSIBLE_CONFIG'] = str(REPO / 'ansible/ansible.cfg')
    profile = transport.load(PROFILE)
    with transport.installation_lock():
        selection_sha256 = None
        if initial_selection:
            if compatibility_inventory:
                raise UpdateError('diagnostic inventory cannot authorize an initial router template')
            selection_sha256 = initial_template_selection(source, profile, engine)
        operation = secrets.token_hex(12)
        work = CACHE / ('build-' + operation)
        result = STATE / operation
        work.mkdir(mode=0o700)
        result.mkdir(mode=0o700)
        manifest, capsule, boot = router_template_inputs.stage(source, work, profile, engine,
            REPO / 'ansible/roles/router-alpine-rootfs/files/router-template-guest')
        (work / 'transfer').mkdir(mode=0o700)
        parts = []
        for artifact, source_path, identity in (
                ('capsule', work / 'capsule.tar', capsule),
                ('kernel', work / 'boot' / 'kernel', boot['kernel']),
                ('initramfs', work / 'boot' / 'initramfs', boot['initramfs'])):
            parts.extend({'artifact': artifact, **part} for part in
                router_template_inputs.split_payload(source_path, work / 'transfer' / artifact, identity))
        transport.write(work / 'request.json', {'kind': 'klokast.router-template-request.v1',
            'box': box, 'role': 'router', 'operation_id': operation,
            'inputs_sha256': manifest['inputs_sha256'], 'capsule': capsule, 'bootstrap': boot})
        args = result / 'arguments.json'
        transport.write(args, {'router_template_box': box, 'router_template_operation': operation,
                              'router_template_input_dir': str(work), 'router_template_result_dir': str(result),
                              'router_template_transfer_parts': parts})
        inventory = [REPO / 'ansible/execution-inventory/hosts']
        if compatibility_inventory:
            rendered = result / 'compatibility-inventory.yml'
            transport.command([REPO / 'ansible/bin/render-node-inventory', '--node', box,
                               '--output', rendered])
            inventory = [REPO / 'ansible/inventory/hosts.yml', rendered]
        inventory_args = [argument for path in inventory for argument in ('-i', path)]
        with (result / 'build.log').open('x') as log:
            transport.command(['ansible-playbook', '-vv', *inventory_args,
                               REPO / 'ansible/playbooks/74-router-template.yml', '--limit', box + '-dom0',
                               '-e', '@' + str(args)], timeout=14400, log=log)
        candidate = transport.load(result / 'candidate.json')
        if initial_selection and initial_template_selection(source, profile, engine) != selection_sha256:
            raise UpdateError('router initial template selection changed during its build')
        approved = transport.approved_engine()
        receipt = None
        if approved == engine and not compatibility_inventory:
            receipt = router_template_inputs.release(candidate, manifest, profile, engine,
                                                     box, operation, approved_engine=approved)
            transport.write(result / 'profile.json', profile)
            transport.write(result / 'release.json', receipt)
        return {'kind': 'klokast.router-template-result.v1', 'box': box, 'operation': operation,
                'release_sha256': receipt['receipt_sha256'] if receipt else None,
                'selection_sha256': selection_sha256,
                'evidence_directory': str(result), 'engine_approved': approved == engine and not compatibility_inventory,
                'status': 'generic-template-qualified', 'replacement_authorized': False}


def test_state_copy(box, source):
    if not router_updates.match(router_updates.BOX, box):
        raise UpdateError('router copy qualification requires an exact box ID')
    transport.require_controller()
    source = Path(source)
    if source.parent != CACHE or not router_updates.match(re.compile('[0-9a-f]{24}'), source.name):
        raise UpdateError('router copy qualification requires one frozen controller cache directory')
    if transport.command(['git', '-C', REPO, 'status', '--porcelain', '--untracked-files=no']).strip():
        raise UpdateError('router copy qualification requires a clean public implementation checkout')
    engine = transport.command(['git', '-C', REPO, 'rev-parse', 'HEAD']).strip()
    profile = transport.load(PROFILE)
    manifest = transport.load(source / 'inputs.json')
    # A synthetic test can reuse earlier authenticated package inputs. Its
    # result separately records the exact engine that supplies the test code.
    router_updates.validate_inputs(manifest, profile, manifest['engine_commit'])
    os.environ['ANSIBLE_CONFIG'] = str(REPO / 'ansible/ansible.cfg')
    with transport.installation_lock():
        operation = secrets.token_hex(12)
        work, result = CACHE / ('copy-test-' + operation), STATE / operation
        work.mkdir(mode=0o700)
        result.mkdir(mode=0o700)
        files = REPO / 'ansible/roles/router-state-copy/files'
        boot = vm_template_inputs.bootstrap(source, work / 'boot', files / 'router-copy-test-guest',
            expected_profile=router_updates.PROFILE,
            job_files={'usr/local/lib/klokast/router_state.py': REPO / 'ansible/lib/router_state.py',
                       'usr/local/libexec/router-state-copy-guest': files / 'router-state-copy-guest'})
        transport.write(work / 'request.json', {'kind': 'klokast.router-copy-test-request.v2',
            'box': box, 'role': 'router', 'operation_id': operation, 'engine_commit': engine,
            'inputs_sha256': manifest['inputs_sha256'], 'bootstrap': boot})
        args = result / 'arguments.json'
        transport.write(args, {'router_copy_test_box': box, 'router_copy_test_operation': operation,
                              'router_copy_test_input_dir': str(work), 'router_copy_test_result_dir': str(result)})
        with (result / 'copy-test.log').open('x') as log:
            transport.command(['ansible-playbook', '-vv', '-i', REPO / 'ansible/execution-inventory/hosts',
                               REPO / 'ansible/playbooks/74-router-state-copy-test.yml', '--limit', box + '-dom0',
                               '-e', '@' + str(args)], timeout=2200, log=log)
        evidence = transport.load(result / 'result.json')
        if (evidence.get('kind') != 'klokast.router-copy-qualification.v2' or evidence.get('box') != box or
                evidence.get('role') != 'router' or evidence.get('operation_id') != operation or
                evidence.get('engine_commit') != engine or evidence.get('inputs_sha256') != manifest['inputs_sha256'] or
                evidence.get('success') is not True or evidence.get('synthetic_only') is not True or
                evidence.get('phases') != ['seed', 'forward', 'mutate', 'unclean', 'reverse', 'verify'] or
                evidence.get('service_compatibility_verified') is not False or evidence.get('replacement_authorized') is not False):
            raise UpdateError('router copy qualification returned incomplete or different evidence')
        return {**evidence, 'evidence_directory': str(result)}


def signed_overlay_source(box):
    """Read only the active controller's bounded signed repair selection."""
    import router_overlay_ipv6
    raw = transport.command([REPO / 'ansible/bin/platform-apply',
                             'overlay-source-status', '--box', box])
    try:
        selection = json.loads(raw)
        router_overlay_ipv6.validate_source(selection, box)
    except (ValueError, TypeError) as error:
        raise UpdateError('signed router IPv6 source is invalid') from error
    return selection


def render_candidate(box, source, overlay_source=None):
    if not router_updates.match(router_updates.BOX, box):
        raise UpdateError('router candidate rendering requires an exact box')
    transport.require_controller()
    source = Path(source)
    if source.parent != CACHE or not re.fullmatch('[0-9a-f]{24}', source.name):
        raise UpdateError('router candidate rendering requires one frozen input directory')
    if transport.command(['git', '-C', REPO, 'status', '--porcelain', '--untracked-files=no']).strip():
        raise UpdateError('router candidate rendering requires a clean implementation checkout')
    engine = transport.command(['git', '-C', REPO, 'rev-parse', 'HEAD']).strip()
    profile, manifest = transport.load(PROFILE), transport.load(source / 'inputs.json')
    router_updates.validate_inputs(manifest, profile, manifest['engine_commit'])
    import router_overlay_ipv6
    overlay = None
    overlay_files = {}
    if overlay_source is not None:
        router_overlay_ipv6.validate_source(overlay_source, box)
        topology = runpy.run_path(str(REPO / 'ansible/bin/platform-resources'))['load_topology']()
        wan = topology['realms']['wan']['router_interface']
        ops = topology['control_zones']['ops']
        overlay = {'source':overlay_source, 'wan':wan,
                   'ops':ops['router_interface'], 'ops_ipv4':ops['vm_ipv4_address']}
        overlay_files = router_overlay_ipv6.files(overlay_source, box, wan=wan,
            ops=overlay['ops'], ops_ipv4=overlay['ops_ipv4'])
    os.environ['ANSIBLE_CONFIG'] = str(REPO / 'ansible/ansible.cfg')
    with transport.installation_lock():
        compiled = json.loads(transport.command([REPO / 'ansible/bin/platform-resources', 'show']))
        includes = router_updates.rendered_includes(compiled, box)
        compiler = runpy.run_path(str(REPO / 'ansible/bin/platform-resources'))
        box_variables = compiler['box_access_router_vars'](compiled, box)
        operation = secrets.token_hex(12)
        result = STATE / operation
        result.mkdir(mode=0o700)
        args = result / 'arguments.json'
        transport.write(args, {**box_variables, 'router_candidate_box': box,
            'router_candidate_result_dir': str(result), 'router_candidate_manifest': manifest,
            'router_candidate_packages': {p['name']: p['version'] for p in manifest['packages']},
            'router_candidate_includes': {k.lstrip('/'): v for k, v in includes.items()},
            'router_candidate_overlay': overlay,
            'router_candidate_overlay_files': overlay_files})
        with (result / 'render.log').open('x') as log:
            transport.command(['ansible-playbook', '-vv', '-i', REPO / 'ansible/execution-inventory/hosts',
                REPO / 'ansible/playbooks/74-router-candidate-render.yml', '--limit', box + '-router',
                '-e', '@' + str(args)], timeout=300, log=log)
        import router_personalize
        rendered = transport.load(result / 'personalization.json')
        router_personalize.validate(rendered)
        if (rendered['box'] != box or rendered['inputs_sha256'] != manifest['inputs_sha256'] or
                rendered['packages'] != {p['name']: p['version'] for p in manifest['packages']} or
                rendered.get('overlay_ipv6') != overlay or
                any(rendered['files'].get(k) != v for k, v in overlay_files.items()) or
                any(rendered['files'].get(k.lstrip('/')) != v for k, v in includes.items())):
            raise UpdateError('router personalization differs from the exact selected inputs')
        # The Instance/compiler inputs may not change while rendering is in flight.
        if json.loads(transport.command([REPO / 'ansible/bin/platform-resources', 'show'])) != compiled:
            raise UpdateError('router compiler inputs changed during candidate rendering')
        evidence = {'kind': 'klokast.router-render-result.v1', 'box': box, 'role': 'router',
            'operation_id': operation, 'engine_commit': engine, 'inputs_sha256': manifest['inputs_sha256'],
            'registry_sha256': compiled['registry_sha256'], 'configuration_sha256': router_personalize.digest(rendered),
            'files': {k: hashlib.sha256(v.encode()).hexdigest() for k, v in rendered['files'].items()},
            'replacement_authorized': False}
        transport.write(result / 'render.json', evidence)
        return {**evidence, 'evidence_directory': str(result)}


def test_compatibility(box, source, template_operation):
    if (not router_updates.match(router_updates.BOX, box) or
            not re.fullmatch('[0-9a-f]{24}', template_operation)):
        raise UpdateError('router compatibility requires an exact box and template operation')
    transport.require_controller()
    source = Path(source)
    if source.parent != CACHE or not re.fullmatch('[0-9a-f]{24}', source.name):
        raise UpdateError('router compatibility requires one frozen controller cache directory')
    if transport.command(['git', '-C', REPO, 'status', '--porcelain', '--untracked-files=no']).strip():
        raise UpdateError('router compatibility requires a clean implementation checkout')
    engine = transport.command(['git', '-C', REPO, 'rev-parse', 'HEAD']).strip()
    profile, manifest = transport.load(PROFILE), transport.load(source / 'inputs.json')
    router_updates.validate_inputs(manifest, profile, manifest['engine_commit'])
    candidate_path = STATE / template_operation / 'candidate.json'
    candidate = transport.load(candidate_path)
    # Verify the complete template result without treating this diagnostic
    # software pair as an approved release or a production assignment.
    release = router_template_inputs.release(candidate, manifest, profile, manifest['engine_commit'],
                                            box, template_operation, approved_engine=manifest['engine_commit'])
    with transport.installation_lock():
        inspected = inspect(box)
        router, dom0, accepted = qualify_compatibility_source(box, inspected, engine)
        source_disk = accepted['generation']['disk'] if accepted is not None else {
            'path':'/dev/vg0/lv_router', 'bytes':2147483648}
        disks = [row for row in dom0['logical_volumes']['report'][0]['lv']
                 if row['lv_path'] == source_disk['path']]
        if len(disks) != 1 or int(disks[0]['lv_size']) != 2147483648 or disks[0]['origin']:
            raise UpdateError('router compatibility requires the recorded two GiB source LV')
        if accepted is not None and disks[0]['lv_uuid'] != source_disk['uuid']:
            raise UpdateError('router compatibility source LV differs from the accepted generation')
        operation = secrets.token_hex(12)
        work, result = CACHE / ('compatibility-' + operation), STATE / operation
        work.mkdir(mode=0o700); result.mkdir(mode=0o700)
        guest = {'kind': 'klokast.router-compatibility-request.v2', 'operation_id': operation,
                 'inputs_sha256': manifest['inputs_sha256'], 'box': box,
                 'source_packages': router['packages'], 'source_kernel_release': router['kernel_release'],
                 'source_files': {k.lstrip('/'): v['sha256'] for k, v in {
                     **router['configuration_files'], **router['include_files']}.items()},
                 'fixture': router_template_inputs.personalization_fixture(REPO, manifest), 'manifest': manifest,
                 'runtime_packages': release['runtime_packages'], 'kernel_release': candidate['kernel_release']}
        transport.write(work / 'guest.json', guest)
        files = REPO / 'ansible/roles/router-state-copy/files'
        modules = ('router_service_probe', 'router_state', 'router_personalize', 'router_overlay_ipv6', 'router_fixture',
                   'router_compatibility', 'router_finalize', 'router_candidate')
        job_files = {'usr/local/lib/klokast/' + name + '.py': REPO / 'ansible/lib' / (name + '.py') for name in modules}
        job_files.update({'router-compatibility-request.json': work / 'guest.json',
                          'usr/local/libexec/router-state-copy-guest': files / 'router-state-copy-guest'})
        boot = vm_template_inputs.bootstrap(source, work / 'boot', files / 'router-compatibility-guest',
            expected_profile=router_updates.PROFILE, job_files=job_files)
        transport.write(work / 'request.json', {'kind': 'klokast.router-compatibility-host.v2',
            'box': box, 'role': 'router', 'operation_id': operation, 'engine_commit': engine,
            'inputs_sha256': manifest['inputs_sha256'], 'bootstrap': boot,
            'template': {'operation': template_operation, 'sha256': vm_template_inputs.sha256(candidate_path)},
            'guest': guest, 'source': {**{k: dom0[k] for k in ('configuration_sha256', 'xen_runtime', 'boot_artifacts')},
                'disk': {'path': disks[0]['lv_path'], 'uuid': disks[0]['lv_uuid'], 'bytes': int(disks[0]['lv_size'])},
                'accepted': accepted}})
        args = result / 'arguments.json'
        transport.write(args, {'router_compatibility_box': box, 'router_compatibility_operation': operation,
            'router_compatibility_input_dir': str(work), 'router_compatibility_result_dir': str(result)})
        with (result / 'compatibility.log').open('x') as log:
            transport.command(['ansible-playbook', '-vv', '-i', REPO / 'ansible/execution-inventory/hosts',
                REPO / 'ansible/playbooks/74-router-compatibility.yml', '--limit', box + '-dom0',
                '-e', '@' + str(args)], timeout=3400, log=log)
        evidence = transport.load(result / 'result.json')
        if (evidence.get('kind') != 'klokast.router-compatibility-result.v2' or evidence.get('box') != box or
                evidence.get('role') != 'router' or evidence.get('operation_id') != operation or
                evidence.get('engine_commit') != engine or evidence.get('inputs_sha256') != manifest['inputs_sha256'] or
                evidence.get('success') is not True or evidence.get('production_identity') is not False or
                evidence.get('phases') != ['prepare', 'seed', 'forward', 'new', 'reverse', 'old'] or
                evidence.get('candidate_modes') != ['initial-install', 'replacement'] or
                evidence.get('source_packages') != router['packages'] or
                evidence.get('runtime_packages') != release['runtime_packages'] or
                evidence.get('enrollment_tested') is not False or evidence.get('replacement_authorized') is not False):
            raise UpdateError('router compatibility returned incomplete or different evidence')
        allocation = transport.load(result / 'candidate-disk.json')
        if (allocation.get('kind') != 'klokast.router-candidate-disk.v1' or
                allocation.get('operation_id') != operation or allocation.get('stage') != 'retired' or
                allocation.get('path') != '/dev/vg0/routergen_' + operation or
                allocation.get('tag') != 'routergen_' + operation or
                allocation.get('template_sha256') != candidate['artifacts']['os']['sha256'] or
                not isinstance(allocation.get('uuid'), str) or not re.fullmatch('[A-Za-z0-9-]{1,64}', allocation['uuid']) or
                evidence.get('candidate_disk') != {'path': allocation['path'], 'uuid': allocation['uuid'], 'bytes': 2147483648}):
            raise UpdateError('router candidate LV qualification lacks its exact completed retirement record')
        persist_diagnostic_lvm(box, result)
        require_accepted_source_unchanged(box, inspected, engine, accepted)
        return {**evidence, 'evidence_directory': str(result)}


def persist_diagnostic_lvm(box, result):
    """Persist only reviewed LVM metadata after an exact disposable LV retired."""
    with (Path(result) / 'lbu.log').open('x') as log:
        transport.command(['ansible-playbook', '-i', REPO / 'ansible/execution-inventory/hosts',
            REPO / 'ansible/playbooks/74-router-diagnostic-lbu-commit.yml', '--limit', box + '-dom0',
            '-e', 'router_diagnostic_lbu_box=' + box], timeout=180, log=log)


def test_dom0_guards(box):
    transport.require_controller()
    if transport.command(['git', '-C', REPO, 'status', '--porcelain', '--untracked-files=no']).strip():
        raise UpdateError('router native guard qualification requires a clean public checkout')
    engine = transport.command(['git', '-C', REPO, 'rev-parse', 'HEAD']).strip()
    with transport.installation_lock():
        inspection = inspect(box)
        _, source, accepted = qualify_inspected_legacy(box, inspection, engine)
        operation = secrets.token_hex(12)
        directory = STATE / operation
        directory.mkdir(mode=0o700)
        transport.write(directory / 'request.json', {'kind':'klokast.router-native-guards-request.v1',
            'box':box, 'operation_id':operation, 'engine_commit':engine, 'source':source})
        args = directory / 'arguments.json'
        transport.write(args, {'router_guard_box':box,'router_guard_operation':operation,'router_guard_directory':str(directory)})
        with (directory / 'qualification.log').open('x') as log:
            transport.command(['ansible-playbook','-vv','-i',REPO / 'ansible/execution-inventory/hosts',
                REPO / 'ansible/playbooks/74-router-native-guards-test.yml','--limit',box+'-dom0','-e','@'+str(args)],
                timeout=240,log=log)
        value = transport.load(directory / 'result.json')
        if (value.get('kind') != 'klokast.router-native-guards-result.v1' or value.get('box') != box or
                value.get('operation_id') != operation or value.get('engine_commit') != engine or
                any(value.get(k) is not True for k in ('success','disk_identity_verified','boot_artifacts_verified',
                    'xen_runtime_verified','block_backend_verified','attached_disk_refused')) or
                value.get('router_changed') is not False or value.get('replacement_authorized') is not False):
            raise UpdateError('native router guard qualification returned incomplete or different evidence')
        require_accepted_source_unchanged(box, inspection, engine, accepted)
        return {**value,'evidence_directory':str(directory)}


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    sub = parser.add_subparsers(dest='command', required=True)
    sub.add_parser('inspect', help='collect private baseline evidence without changing router state').add_argument('--box', required=True)
    sub.add_parser('check-legacy', help='check an adopted legacy router for its first approved template').add_argument('--box', required=True)
    sub.add_parser('check-template', help='check one accepted template router against its exact release').add_argument('--box', required=True)
    replacement_preflight = sub.add_parser('preflight-replacement', help='revalidate one saved router update decision and frozen source without allocation')
    replacement_preflight.add_argument('--box', required=True)
    replacement_preflight.add_argument('--check-operation', required=True)
    sub.add_parser('adopt-legacy', help='inspect and adopt one legacy router under activated authority').add_argument('--box', required=True)
    sub.add_parser('resolve', help='freeze a signed complete package closure in the controller cache').add_argument('--branch', required=True)
    sub.add_parser('resolve-initial', help='select and freeze initial-install inputs from verified Instance version policy')
    sub.add_parser('provisioning-status', help='read protected router state before provisioning').add_argument('--box', required=True)
    provision = sub.add_parser('provision-initial-phase', help='run retained router provisioning phase under the parent installation lock')
    provision.add_argument('--box', required=True)
    provision.add_argument('--phase', choices=('prepare','accept'), required=True)
    sub.add_parser('test-dom0-guards', help='verify native disk and Xen guards without stopping a router').add_argument('--box', required=True)
    builder = sub.add_parser('build-template', help='build and boot a networkless generic router template; never replace a router')
    builder.add_argument('--box', required=True)
    builder.add_argument('--inputs-directory', required=True)
    builder.add_argument('--compatibility-inventory', action='store_true',
                         help='diagnostic build with the retained inventory; never publish an approved release')
    builder.add_argument('--initial-selection', action='store_true',
                         help='require fresh verified first-install policy selection for these frozen inputs')
    copier = sub.add_parser('test-state-copy', help='qualify state copying on new synthetic disks in networkless Xen guests')
    copier.add_argument('--box', required=True)
    copier.add_argument('--inputs-directory', required=True)
    compatibility = sub.add_parser('test-compatibility', help='test native old/new/old services on private networkless copies')
    compatibility.add_argument('--box', required=True)
    compatibility.add_argument('--inputs-directory', required=True)
    compatibility.add_argument('--template-operation', required=True)
    candidate_test = sub.add_parser('test-candidate-preparation', help='qualify and retire one new networkless candidate LV')
    candidate_test.add_argument('--box', required=True)
    candidate_test.add_argument('--inputs-directory', required=True)
    candidate_test.add_argument('--template-operation', required=True)
    candidate_test.add_argument('--mode', choices=('initial-install', 'replacement'), default='replacement')
    candidate_test.add_argument('--signed-overlay', action='store_true',
                                help='qualify the bounded signed IPv6 repair in a networkless candidate')
    initial = sub.add_parser('prepare-initial', help='prepare and retain the first router disk without booting or enrolling it')
    initial.add_argument('--box', required=True)
    initial.add_argument('--inputs-directory', required=True)
    initial.add_argument('--template-operation', required=True)
    initial.add_argument('--operation-id', help='resume this exact recorded preparation operation')
    replacement = sub.add_parser('prepare-replacement',
        help='prepare one retained replacement disk after live and signed-source checks; no cutover')
    replacement.add_argument('--box', required=True)
    replacement.add_argument('--check-operation', required=True)
    replacement.add_argument('--template-operation', required=True)
    replacement.add_argument('--operation-id', help='resume this exact recorded preparation operation')
    proposed = sub.add_parser('stage-replacement-generation',
        help='stage versioned boot artifacts and a proposed generation; no router boot or cutover')
    proposed.add_argument('--box',required=True)
    proposed.add_argument('--operation-id',required=True)
    cutover_stage = sub.add_parser('stage-replacement-cutover',
        help='bind retired native DHCP evidence to retained A/B records without a cutover grant')
    cutover_stage.add_argument('--box',required=True)
    cutover_stage.add_argument('--operation-id',required=True)
    cutover_stage.add_argument('--compatibility-operation',required=True)
    cutover_run = sub.add_parser('run-replacement-cutover',
        help='start one bounded dom0 A/B supervisor and drive enrollment and acceptance')
    cutover_run.add_argument('--box',required=True)
    cutover_run.add_argument('--operation-id',required=True)
    replacement_enrollment = sub.add_parser('signal-replacement-enrollment',
        help='publish the one B enrollment result during a waiting A/B transaction')
    replacement_enrollment.add_argument('--box',required=True)
    replacement_enrollment.add_argument('--operation-id',required=True)
    replacement_acceptance = sub.add_parser('signal-replacement-acceptance',
        help='verify final B services and publish exact acceptance during a waiting A/B transaction')
    replacement_acceptance.add_argument('--box',required=True)
    replacement_acceptance.add_argument('--operation-id',required=True)
    first_boot = sub.add_parser('start-initial', help='boot only the exact prepared first router guest')
    first_boot.add_argument('--box', required=True)
    first_boot.add_argument('--operation-id', required=True)
    enrollment = sub.add_parser('enroll-initial', help='enroll only the pinned first router with one scoped VM key')
    enrollment.add_argument('--box', required=True)
    enrollment.add_argument('--operation-id', required=True)
    finalizer = sub.add_parser('finalize-initial', help='stop the enrolled first router and retire temporary access offline')
    finalizer.add_argument('--box', required=True)
    finalizer.add_argument('--operation-id', required=True)
    final_boot = sub.add_parser('boot-final-initial', help='start the finalized first router without accepting it')
    final_boot.add_argument('--box', required=True)
    final_boot.add_argument('--operation-id', required=True)
    verifier = sub.add_parser('verify-initial', help='verify final first router services, packages, and identity')
    verifier.add_argument('--box', required=True)
    verifier.add_argument('--operation-id', required=True)
    accepter = sub.add_parser('accept-initial', help='publish the verified first router and managed Xen autostart')
    accepter.add_argument('--box', required=True)
    accepter.add_argument('--operation-id', required=True)
    renderer = sub.add_parser('render-candidate', help='render private candidate files from current inventory and compiler inputs')
    renderer.add_argument('--box', required=True)
    renderer.add_argument('--inputs-directory', required=True)
    renderer.add_argument('--signed-overlay', action='store_true',
                          help='use the active controller signed ops-only IPv6 repair source')
    args = parser.parse_args()
    os.umask(0o077)
    try:
        if args.command == 'inspect':
            value = inspect(args.box)
        elif args.command == 'check-legacy':
            value = check_legacy(args.box)
        elif args.command == 'check-template':
            value = check_template(args.box)
        elif args.command == 'preflight-replacement':
            value = preflight_replacement(args.box,args.check_operation)
        elif args.command == 'adopt-legacy':
            value = adopt_legacy(args.box)
        elif args.command == 'resolve':
            value = resolve(args.branch)
        elif args.command == 'resolve-initial':
            value = resolve_initial()
        elif args.command == 'provisioning-status':
            value = provisioning_status(args.box)
        elif args.command == 'provision-initial-phase':
            value = provision_initial_phase(args.box,args.phase)
        elif args.command == 'test-dom0-guards':
            value = test_dom0_guards(args.box)
        elif args.command == 'build-template':
            value = build_template(args.box, args.inputs_directory,
                                   compatibility_inventory=args.compatibility_inventory,
                                   initial_selection=args.initial_selection)
        elif args.command == 'render-candidate':
            value = render_candidate(args.box, args.inputs_directory,
                signed_overlay_source(args.box) if args.signed_overlay else None)
        elif args.command == 'test-compatibility':
            value = test_compatibility(args.box, args.inputs_directory, args.template_operation)
        elif args.command == 'test-candidate-preparation':
            value = test_candidate_preparation(args.box, args.inputs_directory, args.template_operation,
                                               args.mode, args.signed_overlay)
        elif args.command == 'prepare-initial':
            value = prepare_initial(args.box, args.inputs_directory, args.template_operation, args.operation_id)
        elif args.command == 'prepare-replacement':
            value = prepare_replacement(args.box,args.check_operation,args.template_operation,args.operation_id)
        elif args.command == 'stage-replacement-generation':
            value = stage_replacement_generation(args.box,args.operation_id)
        elif args.command == 'stage-replacement-cutover':
            value = stage_replacement_cutover(args.box,args.operation_id,
                                              args.compatibility_operation)
        elif args.command == 'run-replacement-cutover':
            value = run_replacement_cutover(args.box,args.operation_id)
        elif args.command == 'signal-replacement-enrollment':
            value = signal_replacement_enrollment(args.box,args.operation_id)
        elif args.command == 'signal-replacement-acceptance':
            value = signal_replacement_acceptance(args.box,args.operation_id)
        elif args.command == 'start-initial':
            value = start_initial(args.box, args.operation_id)
        elif args.command == 'enroll-initial':
            value = enroll_initial(args.box, args.operation_id)
        elif args.command == 'finalize-initial':
            value = finalize_initial(args.box,args.operation_id)
        elif args.command == 'boot-final-initial':
            value = boot_final_initial(args.box,args.operation_id)
        elif args.command == 'verify-initial':
            value = verify_initial(args.box,args.operation_id)
        elif args.command == 'accept-initial':
            value = accept_initial(args.box,args.operation_id)
        else:
            value = test_state_copy(args.box, args.inputs_directory)
        print(canonical(value))
        return 0
    except (UpdateError, OSError, ValueError, TypeError, KeyError, RuntimeError) as error:
        print('platform-router-update: ' + str(error), file=sys.stderr)
        return 2


if __name__ == '__main__':
    raise SystemExit(main())
