#!/usr/bin/env python3
"""Bounded root maintenance operations for development deployments."""
import argparse
import datetime as dt
import json
import os
from pathlib import Path
import stat
import sys
sys.path.insert(0, str(Path('/usr/local/lib/klokast') if Path('/usr/local/lib/klokast/platform_source.py').is_file()
                       else Path(__file__).resolve().parents[1] / 'lib'))
import platform_source as source
import platform_maintenance as maintenance


def audit(operation, result):
    path = Path('/var/log/klokast/operations.jsonl')
    fd = os.open(path, os.O_WRONLY | os.O_CREAT | os.O_APPEND | os.O_NOFOLLOW, 0o600)
    try:
        info = os.fstat(fd)
        if not stat.S_ISREG(info.st_mode) or info.st_uid != 0 or info.st_mode & 0o077:
            raise source.SourceError('operation audit file is unsafe')
        record = {'time': dt.datetime.now(dt.timezone.utc).isoformat(), 'caller': os.environ.get('DOAS_USER', 'root'),
                  'operation': operation, 'implementation': source.implementation(), 'result': result}
        os.write(fd, (json.dumps(record, sort_keys=True) + '\n').encode())
        os.fsync(fd)
    finally:
        os.close(fd)


def main(argv=None):
    parser = argparse.ArgumentParser(description=__doc__)
    sub = parser.add_subparsers(dest='operation', required=True)
    overlay = sub.add_parser('overlay-source')
    overlay.add_argument('--box', required=True)
    network = sub.add_parser('network')
    network.add_argument('--recovery-operation')
    args = parser.parse_args(argv)
    try:
        if os.geteuid() != 0: raise source.SourceError('invoke installed platform-maintenance through doas on the controller')
        source.require_controller()
        custody_checked = True
        if args.operation == 'overlay-source':
            import platform_overlay
            result = platform_overlay.read(args.box)
        else:
            with maintenance.operation_lock():
                import platform_network
                result = platform_network.reconcile(args.recovery_operation)
            audit(args.operation, result)
        print(json.dumps(result, sort_keys=True))
        return 0
    except (source.SourceError, OSError, ValueError, KeyError) as error:
        if locals().get('custody_checked') and args.operation != 'overlay-source' and getattr(args, 'action', '') not in ('status', 'schedule'):
            try: audit(args.operation + '.' + getattr(args, 'action', 'execute'), {'result': 'failed', 'error': str(error)})
            except (source.SourceError, OSError): pass
        print('platform-maintenance: ' + str(error), file=sys.stderr)
        return 1


if __name__ == '__main__': raise SystemExit(main())
