#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
ANSIBLE_DIR="$(cd -- "$SCRIPT_DIR/.." && pwd)"
REPO_DIR="$(cd -- "$SCRIPT_DIR/../.." && pwd)"
ANSIBLE_CONFIG_PATH="$ANSIBLE_DIR/ansible.cfg"
RENDER_NODE_INVENTORY="$SCRIPT_DIR/render-node-inventory"

NODE=""
INVENTORY="$ANSIBLE_DIR/inventory/hosts.yml"
FROM_PHASE="10"
TO_PHASE="22"
DRY_RUN=0
TARGET_DISK_DEVICE="/dev/nvme0n1"
MAGICDNS_SUFFIX="$("$SCRIPT_DIR/magicdns-suffix")"
OOB_HOST="oob"
OOB_USER="root"
PLATFORM_PRIVATE_ROOT="${KLOKAST_PRIVATE_ROOT:-$HOME/private/klokast}"
DOM0_CONSOLE_VARS="$PLATFORM_PRIVATE_ROOT/dom0-console.yml"
MANUAL_ISO_DETACH=0
EXTRA_ARGS=()

usage() {
  cat <<'EOF'
Usage:
  ansible/bin/bootstrap-dom0 --node NODE [options] [-- extra ansible-playbook args]

Runs the blank-SSD bootstrap flow from the Debian live ISO to a verified
diskless Alpine dom0 reachable over Tailscale SSH.

Options:
  --node NODE              Node short name, for example k001
  --inventory PATH         Base Ansible inventory. Default: ansible/inventory/hosts.yml
  --from PHASE             First phase to run. Default: 10
  --to PHASE               Last phase to run. Default: 22
  --target-disk-device DEV Destructive install target. Default: /dev/nvme0n1
  --magicdns-suffix SUFFIX Tailscale MagicDNS suffix. Default: auto-discovered
  --oob-host HOST          NanoKVM SSH host for ISO unload. Default: oob
  --oob-user USER          NanoKVM SSH user for ISO unload. Default: root
  --private-state-root DIR Private Platform state root. Default: ~/private/klokast
  --manual-iso-detach      Prompt for manual NanoKVM ISO detach before phase 14
  --dry-run-plan           Print the selected phases and gates, then exit
  -h, --help               Show this help

Phases:
  10  bootstrap access check
  11  destructive SSD disk layout
  12  diskless Alpine build on SSD
  13  staged diskless install verification
  14  reboot from Debian live ISO into SSD diskless Alpine
  20  base dom0 convergence through the bootstrap Tailscale identity
  21  Tailscale handoff from bootstrap identity to dom0 identity
  22  steady-state dom0 verification

Examples:
  ansible/bin/bootstrap-dom0 --node k001
  ansible/bin/bootstrap-dom0 --node k001 --from 20
  ansible/bin/bootstrap-dom0 --node k001 --from 21 --to 22 -- -vvv
EOF
}

die() {
  printf 'error: %s\n' "$*" >&2
  exit 1
}

info() {
  printf '%s\n' "$*"
}

quote_command() {
  local arg
  for arg in "$@"; do
    printf '%q ' "$arg"
  done
  printf '\n'
}

json_string() {
  python3 -c 'import json, sys; print(json.dumps(sys.argv[1]))' "$1"
}

validate_node_name() {
  python3 - "$NODE" <<'PY'
import re
import sys

node = sys.argv[1]
suffixes = ("bootstrap", "dom0", "router", "bak", "dmz", "iot", "usr", "ops", "agent", "agt")
if not re.fullmatch(r"[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?", node):
    print(
        "error: --node must be a lowercase DNS label: letters, digits, "
        "hyphens, and no leading/trailing hyphen",
        file=sys.stderr,
    )
    sys.exit(1)
for suffix in suffixes:
    if node == suffix or node.endswith(f"-{suffix}"):
        print(
            f"error: --node must be the box name only, not a role hostname ending in -{suffix}",
            file=sys.stderr,
        )
        sys.exit(1)
PY
}

while [ "$#" -gt 0 ]; do
  case "$1" in
    --node)
      [ "$#" -ge 2 ] || die "--node requires a value"
      NODE="$2"
      shift 2
      ;;
    --inventory)
      [ "$#" -ge 2 ] || die "--inventory requires a value"
      INVENTORY="$2"
      shift 2
      ;;
    --from)
      [ "$#" -ge 2 ] || die "--from requires a value"
      FROM_PHASE="$2"
      shift 2
      ;;
    --to)
      [ "$#" -ge 2 ] || die "--to requires a value"
      TO_PHASE="$2"
      shift 2
      ;;
    --target-disk-device)
      [ "$#" -ge 2 ] || die "--target-disk-device requires a value"
      TARGET_DISK_DEVICE="$2"
      shift 2
      ;;
    --magicdns-suffix)
      [ "$#" -ge 2 ] || die "--magicdns-suffix requires a value"
      MAGICDNS_SUFFIX="$2"
      shift 2
      ;;
    --oob-host)
      [ "$#" -ge 2 ] || die "--oob-host requires a value"
      OOB_HOST="$2"
      shift 2
      ;;
    --oob-user)
      [ "$#" -ge 2 ] || die "--oob-user requires a value"
      OOB_USER="$2"
      shift 2
      ;;
    --private-state-root)
      [ "$#" -ge 2 ] || die "--private-state-root requires a value"
      PLATFORM_PRIVATE_ROOT="$2"
      DOM0_CONSOLE_VARS="$PLATFORM_PRIVATE_ROOT/dom0-console.yml"
      shift 2
      ;;
    --manual-iso-detach)
      MANUAL_ISO_DETACH=1
      shift
      ;;
    --dry-run-plan)
      DRY_RUN=1
      shift
      ;;
    -h|--help)
      usage
      exit 0
      ;;
    --)
      shift
      EXTRA_ARGS=("$@")
      break
      ;;
    *)
      die "unknown argument: $1"
      ;;
  esac
done

[ -n "$NODE" ] || die "--node is required"
validate_node_name

case "$INVENTORY" in
  /*) ;;
  *) INVENTORY="$PWD/$INVENTORY" ;;
esac

PHASES=(10 11 12 13 14 20 21 22)
PLAYBOOKS=(
  "playbooks/10-bootstrap-access.yml"
  "playbooks/11-bootstrap-disk-layout.yml"
  "playbooks/12-bootstrap-diskless-build.yml"
  "playbooks/13-bootstrap-diskless-verify.yml"
  "playbooks/14-bootstrap-reboot-into-diskless.yml"
  "playbooks/20-dom0-base-bootstrap.yml"
  "playbooks/21-dom0-tailscale-handoff.yml"
  "playbooks/22-dom0-base-verify.yml"
)
DESCRIPTIONS=(
  "bootstrap access check"
  "destructive SSD disk layout"
  "diskless Alpine build on SSD"
  "staged diskless install verification"
  "reboot from Debian live ISO into SSD diskless Alpine"
  "base dom0 convergence through the bootstrap Tailscale identity"
  "Tailscale handoff from bootstrap identity to dom0 identity"
  "steady-state dom0 verification"
)

phase_index() {
  local wanted="$1"
  local i
  for i in "${!PHASES[@]}"; do
    if [ "${PHASES[$i]}" = "$wanted" ]; then
      printf '%s\n' "$i"
      return 0
    fi
  done
  return 1
}

FROM_INDEX="$(phase_index "$FROM_PHASE")" || die "unknown --from phase: $FROM_PHASE"
TO_INDEX="$(phase_index "$TO_PHASE")" || die "unknown --to phase: $TO_PHASE"
[ "$FROM_INDEX" -le "$TO_INDEX" ] || die "--from must be less than or equal to --to"

BOOTSTRAP_HOST="${NODE}-bootstrap"
DOM0_HOST="${NODE}-dom0"
RUN_DIR="$REPO_DIR/.run/bootstrap-dom0-${NODE}"
LOG_DIR="$RUN_DIR/logs"
STATE_FILE="$RUN_DIR/state"
GENERATED_INVENTORY="$RUN_DIR/inventory.yml"
TARGET_DISK="$TARGET_DISK_DEVICE"

preflight() {
  command -v ansible-playbook >/dev/null 2>&1 || die "ansible-playbook not found in PATH"
  command -v ansible-inventory >/dev/null 2>&1 || die "ansible-inventory not found in PATH"
  command -v python3 >/dev/null 2>&1 || die "python3 not found in PATH"
  [ -f "$INVENTORY" ] || die "inventory not found: $INVENTORY"
  [ -f "$ANSIBLE_CONFIG_PATH" ] || die "ansible config not found: $ANSIBLE_CONFIG_PATH"
  [ -x "$RENDER_NODE_INVENTORY" ] || die "inventory renderer not executable: $RENDER_NODE_INVENTORY"
  [ -f "$ANSIBLE_DIR/playbooks/10-bootstrap-access.yml" ] || die "cannot locate playbooks under $ANSIBLE_DIR"

  "$RENDER_NODE_INVENTORY" \
    --node "$NODE" \
    --output "$GENERATED_INVENTORY" \
    --target-disk-device "$TARGET_DISK_DEVICE" \
    --magicdns-suffix "$MAGICDNS_SUFFIX"

  env ANSIBLE_CONFIG="$ANSIBLE_CONFIG_PATH" ansible-inventory \
    -i "$INVENTORY" \
    -i "$GENERATED_INVENTORY" \
    --host "$BOOTSTRAP_HOST" >/dev/null
  env ANSIBLE_CONFIG="$ANSIBLE_CONFIG_PATH" ansible-inventory \
    -i "$INVENTORY" \
    -i "$GENERATED_INVENTORY" \
    --host "$DOM0_HOST" >/dev/null
}

write_state() {
  local key="$1"
  local phase="$2"
  mkdir -p "$RUN_DIR"
  {
    printf 'node=%s\n' "$NODE"
    printf '%s=%s\n' "$key" "$phase"
    printf 'updated_at=%s\n' "$(date -u +%Y-%m-%dT%H:%M:%SZ)"
  } >"$STATE_FILE"
}

phase_limit() {
  case "$1" in
    10|11|12|13|14) printf '%s\n' "$BOOTSTRAP_HOST" ;;
    20|21|22) printf '%s\n' "$DOM0_HOST" ;;
    *) die "no limit configured for phase $1" ;;
  esac
}

phase_extra_vars() {
  local phase="$1"
  if [ "$phase" = "14" ]; then
    if [ "$MANUAL_ISO_DETACH" -eq 1 ]; then
      printf '{"nanokvm_virtual_media_enabled":false}'
    else
      printf '{"nanokvm_virtual_media_enabled":true,"nanokvm_virtual_media_host":%s,"nanokvm_virtual_media_user":%s,"nanokvm_virtual_media_magicdns_suffix":%s}' \
        "$(json_string "$OOB_HOST")" \
        "$(json_string "$OOB_USER")" \
        "$(json_string "$MAGICDNS_SUFFIX")"
    fi
  fi
}

phase_uses_dom0_console_vars() {
  case "$1" in
    20) return 0 ;;
    *) return 1 ;;
  esac
}

selected_phases_use_dom0_console_vars() {
  local i
  for ((i = FROM_INDEX; i <= TO_INDEX; i++)); do
    if phase_uses_dom0_console_vars "${PHASES[$i]}"; then
      return 0
    fi
  done
  return 1
}

confirm_disk_wipe() {
  local answer

  info ""
  info "Destructive gate before phase 11"
  info "This will wipe and repartition ${TARGET_DISK} for node ${NODE}."
  info "Expected bootstrap host: ${BOOTSTRAP_HOST}"
  info ""

  while true; do
    printf 'Type "wipe" to continue, or "exit" to stop: '
    read -r answer

    case "$answer" in
      wipe)
        return 0
        ;;
      exit)
        die "operator stopped before disk wipe"
        ;;
      *)
        info 'Type "wipe" to continue, or "exit" to stop.'
        ;;
    esac
  done
}

confirm_iso_detached() {
  local answer

  info ""
  info "Physical gate before phase 14"
  info "Detach the NanoKVM Debian bootstrap ISO now."
  info "The next phase reboots the mini PC and expects it to boot from the SSD."
  info ""
  printf 'Press Enter after the ISO is detached, or type "abort": '
  read -r answer
  [ "$answer" != "abort" ] || die "operator aborted before reboot"
}

check_no_stale_dom0_identity() {
  command -v tailscale >/dev/null 2>&1 || die "tailscale CLI not found; cannot check for stale dom0 identities"

  python3 - "$NODE" <<'PY'
import json
import subprocess
import sys

node = sys.argv[1]
dom0 = f"{node}-dom0"

try:
    status = subprocess.check_output(["tailscale", "status", "--json"], text=True)
    data = json.loads(status)
except Exception as exc:
    print(f"error: could not query tailscale status: {exc}", file=sys.stderr)
    sys.exit(2)

matches = []
peers = list((data.get("Peer") or {}).values())
self_node = data.get("Self")
if self_node:
    peers.append(self_node)

for peer in peers:
    hostname = peer.get("HostName") or ""
    dns_name = (peer.get("DNSName") or "").rstrip(".")
    tags = ",".join(peer.get("Tags") or [])
    online = peer.get("Online")
    ips = ",".join(peer.get("TailscaleIPs") or [])
    if hostname == dom0 or dns_name.startswith(f"{dom0}.") or dns_name.startswith(f"{dom0}-"):
        matches.append((hostname, dns_name, online, tags, ips))

if matches:
    print("Found existing Tailscale dom0 identity before phase 21:", file=sys.stderr)
    for hostname, dns_name, online, tags, ips in matches:
        print(f"  {hostname} {dns_name} online={online} tags={tags} ips={ips}", file=sys.stderr)
    print("", file=sys.stderr)
    print("Remove stale dom0 machines from the Tailscale admin console, then resume:", file=sys.stderr)
    print(f"  ansible/bin/bootstrap-dom0 --node {node} --from 21", file=sys.stderr)
    sys.exit(1)
PY
}

run_phase() {
  local phase="$1"
  local playbook="$2"
  local description="$3"
  local log_file
  local status
  local limit
  local extra_vars
  local -a cmd

  limit="$(phase_limit "$phase")"
  extra_vars="$(phase_extra_vars "$phase")"
  log_file="$LOG_DIR/${phase}-$(basename "$playbook" .yml).log"
  mkdir -p "$LOG_DIR"
  cmd=(
    env
    "ANSIBLE_CONFIG=$ANSIBLE_CONFIG_PATH"
    ansible-playbook
    -i "$INVENTORY"
    -i "$GENERATED_INVENTORY"
    "$ANSIBLE_DIR/$playbook"
    -vv
    --limit "$limit"
  )
  if [ -n "$extra_vars" ]; then
    cmd+=(-e "$extra_vars")
  fi
  if phase_uses_dom0_console_vars "$phase"; then
    [ -f "$DOM0_CONSOLE_VARS" ] || die "missing private dom0 console vars: $DOM0_CONSOLE_VARS"
    cmd+=(-e "@$DOM0_CONSOLE_VARS")
  fi
  cmd+=("${EXTRA_ARGS[@]}")

  info ""
  info "==> Phase ${phase}: ${description}"
  printf 'Command: '
  quote_command "${cmd[@]}"
  info "Log: $log_file"
  write_state "last_started" "$phase"

  set +e
  "${cmd[@]}" 2>&1 | tee "$log_file"
  status="${PIPESTATUS[0]}"
  set -e

  if [ "$status" -ne 0 ]; then
    info ""
    info "Phase ${phase} failed with exit code ${status}."
    info "Log: $log_file"
    info "Resume after fixing the issue:"
    info "  ansible/bin/bootstrap-dom0 --node ${NODE} --from ${phase}"
    exit "$status"
  fi

  write_state "last_completed" "$phase"
}

print_plan() {
  local i
  local phase
  info "Node: $NODE"
  info "Base inventory: $INVENTORY"
  info "Generated inventory: $GENERATED_INVENTORY"
  info "Run directory: $RUN_DIR"
  info "Selected phases:"
  for ((i = FROM_INDEX; i <= TO_INDEX; i++)); do
    phase="${PHASES[$i]}"
    printf '  %s  %s  limit=%s\n' "$phase" "${DESCRIPTIONS[$i]}" "$(phase_limit "$phase")"
    if [ "$phase" = "11" ]; then
      printf '      gate: type "wipe" to continue or "exit" to stop\n'
    elif [ "$phase" = "14" ]; then
      if [ "$MANUAL_ISO_DETACH" -eq 1 ]; then
        printf '      gate: confirm NanoKVM ISO is detached manually\n'
      else
        printf '      NanoKVM: unload ISO over SSH via %s@%s\n' "$OOB_USER" "$OOB_HOST"
      fi
    elif [ "$phase" = "21" ]; then
      printf '      gate: check no stale %s Tailscale identity exists\n' "$DOM0_HOST"
    fi
  done
}

preflight
if selected_phases_use_dom0_console_vars && [ "$DRY_RUN" -eq 0 ]; then
  [ -f "$DOM0_CONSOLE_VARS" ] || die "missing private dom0 console vars: $DOM0_CONSOLE_VARS"
fi
print_plan

if [ "$DRY_RUN" -eq 1 ]; then
  exit 0
fi

for ((i = FROM_INDEX; i <= TO_INDEX; i++)); do
  case "${PHASES[$i]}" in
    11) confirm_disk_wipe ;;
    14)
      if [ "$MANUAL_ISO_DETACH" -eq 1 ]; then
        confirm_iso_detached
      fi
      ;;
    21) check_no_stale_dom0_identity ;;
  esac

  run_phase "${PHASES[$i]}" "${PLAYBOOKS[$i]}" "${DESCRIPTIONS[$i]}"
done

info ""
info "bootstrap-dom0 completed."
info "Final verification phase: ${PHASES[$TO_INDEX]}"
info "Run logs: $LOG_DIR"
