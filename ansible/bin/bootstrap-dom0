#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
NODE=""
FROM_PHASE="10"
TO_PHASE="22"
FORWARD_ARGS=()
EXTRA_ARGS=()

usage() {
  cat <<'EOF'
Usage:
  ansible/bin/bootstrap-dom0 --node NODE [options] [-- extra ansible-playbook args]

Runs the blank-SSD bootstrap flow from the Debian live ISO to a verified
Alpine dom0 through provision-box. Only phases 10 through 22 are available.
The runner uses the Platform installation lock and provision-box logs.

Options:
  --node NODE              Node short name, for example boxa
  --inventory PATH         Base Ansible inventory. Default: ansible/execution-inventory/hosts
  --from PHASE             First phase to run. Default: 10
  --to PHASE               Last phase to run. Default: 22
  --target-disk-device DEV Destructive install target. Default: /dev/nvme0n1
  --magicdns-suffix SUFFIX Tailscale MagicDNS suffix. Default: auto-discovered
  --oob-host HOST          NanoKVM SSH host for ISO unload. Default: oob
  --oob-user USER          NanoKVM SSH user for ISO unload. Default: root
  --private-state-root DIR Private Platform state root. Default: ~/private/klokast
  --manual-iso-detach      Prompt for manual NanoKVM ISO detach before phase 14
  --dry-run-plan           Print the selected phases and gates, then exit
  -h, --help               Show this help

Disk wiping always requires typed confirmation through this entrypoint.
See doc/platform-deploy.md for controller prerequisites and resume behavior.
EOF
}

die() {
  printf 'error: %s\n' "$*" >&2
  exit 1
}

while [ "$#" -gt 0 ]; do
  case "$1" in
    --node)
      [ "$#" -ge 2 ] || die "--node requires a value"
      NODE="$2"
      shift 2
      ;;
    --from|--to)
      [ "$#" -ge 2 ] || die "$1 requires a value"
      if [ "$1" = "--from" ]; then
        FROM_PHASE="$2"
      else
        TO_PHASE="$2"
      fi
      shift 2
      ;;
    --inventory|--target-disk-device|--magicdns-suffix|--oob-host|--oob-user|--private-state-root)
      [ "$#" -ge 2 ] || die "$1 requires a value"
      FORWARD_ARGS+=("$1" "$2")
      shift 2
      ;;
    --manual-iso-detach|--dry-run-plan)
      FORWARD_ARGS+=("$1")
      shift
      ;;
    -h|--help)
      usage
      exit 0
      ;;
    --)
      shift
      EXTRA_ARGS=("$@")
      break
      ;;
    *)
      die "unknown argument: $1"
      ;;
  esac
done

[ -n "$NODE" ] || die "--node is required"
# Enforce this entrypoint's boundary; the runner validates phase existence,
# ordering, and the node name, and owns all execution behavior.
for phase in "$FROM_PHASE" "$TO_PHASE"; do
  case "$phase" in
    1[0-9]|2[0-2]) ;;
    *) die "bootstrap-dom0 phases must be between 10 and 22: $phase" ;;
  esac
done

exec "$SCRIPT_DIR/provision-box" \
  --box "$NODE" --from "$FROM_PHASE" --to "$TO_PHASE" \
  "${FORWARD_ARGS[@]}" -- "${EXTRA_ARGS[@]}"
