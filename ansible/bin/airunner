#!/usr/bin/env python3
"""Manage declared native runners from the active controller."""
import argparse
import json
import os
from pathlib import Path
import re
import socket
import subprocess
import sys
import tempfile
import time

REPO = Path(__file__).resolve().parents[2]
sys.path.insert(0, str(REPO / 'ansible/lib'))
import platform_resource_compiler as compiler
import platform_resource_model as model
import platform_resource_runtime as runtime
import platform_source as source
from platform_updates import no_application_release
import vm_local_images
import infrastructure_images

REGISTRY = Path('/home/smith/private/klokast/platform-resources.yml')


def command(argv, *, capture=True, timeout=7200):
    result = subprocess.run([str(v) for v in argv], cwd=REPO, text=True,
                            stdout=subprocess.PIPE if capture else None, timeout=timeout, check=False)
    if result.returncode:
        raise RuntimeError('command failed: ' + str(argv[0]) + ' (exit ' + str(result.returncode) + ')')
    return result.stdout


def desired():
    source.require_controller()
    value = json.loads(command(['/usr/local/sbin/platform-registry', 'read', '--registry', REGISTRY, '--json']))
    if value.get('kind') != 'klokast.registry-read.v1' or value.get('source') != 'instance':
        raise RuntimeError('runner operations require current validated Instance desired state')
    return value


def plan(action, box, view):
    registry = view['registry']
    if box not in registry['boxes']:
        raise RuntimeError('runner target is not a declared box: ' + box)
    declared = box + '-air' in registry.get('airunners', [])
    if action in ('provision', 'verify', 'migrate', 'retire-legacy') and not declared:
        raise RuntimeError('declare ' + box + '-air in Instance airunners before this operation')
    if action == 'retire' and declared:
        raise RuntimeError('remove ' + box + '-air from Instance airunners before retirement')
    if action == 'retire-legacy' and box + '-ops-airunner' in registry.get('airunners', []):
        raise RuntimeError('remove the legacy container from Instance airunners before retirement')
    return {'action': action, 'box': box, 'hostname': box + '-air', 'declared': declared,
            'profile': 'air-alpine-v1', 'memory_mib': 4096, 'vcpus': 2, 'root_gib': 50,
            'address': model.load_topology(repo_root=REPO)['air']['ipv4_address'],
            'mutating': action != 'verify', 'existing_disk': 'preserve',
            'controller': 'active', 'lock': str(runtime.VM_UPDATE_INSTALL_LOCK)}


def ansible(playbook, box, variables, *, hosts=None):
    with tempfile.TemporaryDirectory(prefix='klokast-airunner-') as directory:
        path = Path(directory) / 'variables.json'
        path.write_text(json.dumps(variables)); path.chmod(0o600)
        inventory = ['-i', REPO / 'ansible/execution-inventory/hosts']
        if hosts and 'localhost' in hosts.split(','):
            # Explicit --limit does not create Ansible's implicit localhost.
            # Host variables also override the inventory-wide SSH transport.
            local_inventory = Path(directory) / 'localhost.ini'
            local_inventory.write_text('[all]\nlocalhost ansible_connection=local ansible_python_interpreter=/usr/bin/python3\n')
            local_inventory.chmod(0o600)
            inventory += ['-i', local_inventory]
        command(['ansible-playbook', '-vv', *inventory,
                 REPO / 'ansible/playbooks' / playbook, '--limit', hosts or box,
                 '-e', '@' + str(path)], capture=False)


def network(box, view, *, bootstrap=False):
    compiled = compiler.compile_registry(REGISTRY, [], registry_input=view, repo_root=REPO,
                                         air_bootstrap_boxes=[box] if bootstrap else [])
    ansible('69-air-network.yml', box, {'platform_resources_desired_json': json.dumps(compiled),
                                      'platform_resources_registry_sha256': compiled['registry_sha256'],
                                      'platform_resources_compiler_version': compiled['compiler_version'],
                                      'airunner_controller_hostname': socket.gethostname().split('.')[0]},
            hosts=box + '-router,' + box + '-ops')


def prepare_image(box, profile):
    return infrastructure_images.prepare_image(box, profile, repo=REPO)


def guest_config(box, role, uid=1004, gid=1004):
    topology = model.load_topology(repo_root=REPO)
    zone = topology['zones']['usr'] if role == 'air' else topology['control_zones']['ops']
    address = topology['air']['ipv4_address'] if role == 'air' else zone['vm_ipv4_address']
    return {'kind': 'klokast.infrastructure-config.v1', 'box': box, 'role': role,
            'bridge': zone['bridge'],
            'address': address + '/' + str(zone['router_ipv4_prefix']), 'gateway': zone['router_ipv4_address'],
            'bootstrap_source': topology['zones']['bak']['dom0_ipv4_address'] if role == 'air' else zone['dom0_ipv4_address'],
            'public_key': (Path.home() / '.ssh/github-klokast-codex.pub').read_text().strip(),
            'agent_uid': uid, 'agent_gid': gid}


def provision(box, view, uid, gid, *, archive_failed=False):
    operation = prepare_image(box, 'air-alpine-v1')
    variables = {'infrastructure_box': box, 'infrastructure_role': 'air', 'infrastructure_image': operation,
                 'infrastructure_archive_failed': archive_failed,
                 'infrastructure_config': guest_config(box, 'air', uid, gid)}
    network(box, view, bootstrap=True)
    # A failed enrollment keeps the bootstrap rule so provision can resume.
    # A successful play closes the listener before removing the router rule.
    ansible('69-air-provision.yml', box, variables)
    network(box, view)
    verify(box, uid, gid)


def verify(box, uid, gid):
    ansible('69-air-verify.yml', box, {'infrastructure_agent_uid': uid, 'infrastructure_agent_gid': gid}, hosts=box + '-air')


def migrate(args):
    ansible('69-air-migrate.yml', args.box, {
        'airunner_box': args.box, 'airunner_phase': args.phase,
        'airunner_synthetic': args.synthetic, 'airunner_interrupt': args.simulate_interruption,
        'infrastructure_agent_uid': args.agent_uid, 'infrastructure_agent_gid': args.agent_gid,
    }, hosts='localhost')


def retire(args, view):
    if args.action == 'retire-legacy': verify(args.box, args.agent_uid, args.agent_gid)
    ansible('69-air-retire.yml', args.box, {
        'airunner_box': args.box, 'airunner_retire_action': args.action,
        'airunner_test_only': args.test_only,
        'airunner_phase': 'retire-test-check' if args.action == 'retire' else 'retire-legacy',
        'infrastructure_agent_uid': args.agent_uid, 'infrastructure_agent_gid': args.agent_gid,
    }, hosts='localhost,' + args.box + '-dom0,' + args.box + '-ops')
    if args.action == 'retire': network(args.box, view)


def detach_cutover(args):
    # The controller child owns the existing operation lock for the whole job.
    # It survives the SSH disconnect and the stop of the source container.
    directory = Path('/var/lib/klokast/operations-journal/cases/airunner-vm')
    directory.mkdir(mode=0o700, parents=True, exist_ok=True)
    fd, name = tempfile.mkstemp(prefix=time.strftime('%Y%m%dT%H%M%SZ-', time.gmtime()),
                                suffix='-cutover.log', dir=directory)
    with os.fdopen(fd, 'w') as log:
        process = subprocess.Popen([
            sys.executable, str(Path(__file__).resolve()), 'migrate', '--box', args.box,
            '--phase', 'cutover', '--controller-job',
            '--agent-uid', str(args.agent_uid), '--agent-gid', str(args.agent_gid),
        ], cwd=REPO, stdin=subprocess.DEVNULL, stdout=log, stderr=subprocess.STDOUT,
           start_new_session=True, close_fds=True)
    print(json.dumps({'state': 'controller-job-started', 'pid': process.pid, 'log': name,
                      'reconnect': 'tailscale ssh agent@' + args.box + '-air',
                      'recovery': 'Read the controller job log before restarting the old runner.'}))


def main(argv=None):
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument('action', choices=('provision', 'verify', 'migrate', 'retire-legacy', 'retire'))
    parser.add_argument('--box', required=True)
    parser.add_argument('--dry-run-plan', action='store_true')
    parser.add_argument('--agent-uid', type=int, default=1004)
    parser.add_argument('--agent-gid', type=int, default=1004)
    parser.add_argument('--phase', choices=('precopy', 'cutover', 'verify', 'status'), default='precopy')
    parser.add_argument('--synthetic', action='store_true')
    parser.add_argument('--simulate-interruption', action='store_true')
    parser.add_argument('--test-only', action='store_true', help='erase only a verified synthetic pilot during retirement')
    parser.add_argument('--archive-failed', action='store_true', help='retain a failed runner disk that has not reached normal boot before retrying provisioning')
    parser.add_argument('--controller-job', action='store_true', help=argparse.SUPPRESS)
    args = parser.parse_args(argv)
    if not re.fullmatch('[a-z0-9][a-z0-9-]{0,30}', args.box):
        parser.error('--box must select one box DNS label')
    if any(not 1001 <= v <= 60000 for v in (args.agent_uid, args.agent_gid)):
        parser.error('runner UID and GID must be between 1001 and 60000')
    if args.simulate_interruption and not args.synthetic:
        parser.error('--simulate-interruption requires --synthetic')
    if args.test_only and args.action != 'retire':
        parser.error('--test-only is valid only with retire')
    if args.archive_failed and args.action != 'provision':
        parser.error('--archive-failed is valid only with provision')
    if args.controller_job and (args.action != 'migrate' or args.phase != 'cutover' or args.synthetic):
        parser.error('the detached controller job is only for working cutover')
    try:
        os.environ['ANSIBLE_CONFIG'] = str(REPO / 'ansible/ansible.cfg')
        view = desired()
        selected = plan(args.action, args.box, view)
        if args.archive_failed:
            selected['existing_disk'] = 'archive-only-recorded-unfinalized-failure'
        if args.action == 'migrate':
            selected.update(phase=args.phase, synthetic=args.synthetic,
                            detached=args.phase == 'cutover' and not args.synthetic)
        if args.action == 'retire':
            selected['disk_action'] = 'erase-verified-synthetic-pilot' if args.test_only else 'retain-offline'
        if args.dry_run_plan:
            print(json.dumps(selected, indent=2)); return 0
        if args.action == 'verify':
            verify(args.box, args.agent_uid, args.agent_gid)
        else:
            runtime.require_active_controller()
            if args.action == 'migrate' and args.phase == 'cutover' and not args.synthetic and not args.controller_job:
                detach_cutover(args)
                return 0
            with runtime.vm_update_installation_lock():
                if args.action == 'provision':
                    provision(args.box, view, args.agent_uid, args.agent_gid, archive_failed=args.archive_failed)
                elif args.action == 'migrate':
                    migrate(args)
                else:
                    retire(args, view)
        return 0
    except (RuntimeError, source.SourceError, OSError, ValueError, KeyError, subprocess.SubprocessError) as error:
        print('airunner: ' + str(error), file=sys.stderr)
        return 1


if __name__ == '__main__':
    raise SystemExit(main())
