#!/usr/bin/env python3
"""VM inspection, local image preparation and checked artifact cleanup."""
import argparse
import json
import os
import sys
from pathlib import Path
REPO = Path(__file__).resolve().parents[2]
sys.path.insert(0, str(REPO / "ansible/lib"))
from platform_updates import (UpdateError, canonical, health, timestamp)
import vm_no_application
import platform_proxy
import infrastructure_images
import platform_update_images as images
import platform_update_inspection as inspection
from platform_update_runtime import STATE, optional, require_controller, now

def display(report, as_json):
    if as_json:
        print(json.dumps(report, sort_keys=True, indent=2))
        return
    print("VM update report: " + report.get("generated_at", "missing"))
    for item in report.get("hosts", []):
        print(f"{item['host']}: {item['update_status']}; profile={item['profile']}; updates={len(item['updates'])}; security={len(item['security_fixes'])}; replacement=blocked")
        if 'storage_assessment' in item:
            storage = item['storage_assessment']
            for volume in storage['volumes']:
                match = volume['catalog_match']
                label = match['app'] + '/' + match['dataset'] if match else 'unclassified'
                print(f"  volume {volume['name']}: catalog={label}; path={'supported' if volume['path_supported'] else 'blocked'}; retention=unapproved")
        host_inventory = item.get('host_assessment', {}).get('inventory') or {}
        for service in host_inventory.get('native_services', {}).get('services', []):
            if service['runlevels'] or service['markers']:
                levels = ','.join(service['runlevels']) or 'none'
                markers = ','.join(service['markers']) or 'unmarked'
                print(f"  service {service['name']}: runlevels={levels}; OpenRC markers={markers}; health=unverified")
        for finding in item["findings"]:
            print("  " + finding["code"] + ": " + finding["message"])
        if item.get("metadata_error"):
            print("  metadata error: " + item["metadata_error"])
    for finding in report.get("findings", []):
        print(f"{finding['severity']}: {finding['code']}: {finding['message']}")


def main(argv=None):
    os.environ.update(platform_proxy.environment())
    parser = argparse.ArgumentParser(description=__doc__)
    sub = parser.add_subparsers(dest="command", required=True)
    mirrors_parser = sub.add_parser('mirrors', help='read or explicitly refresh this box controller Alpine mirrors')
    mirrors_parser.add_argument('--box', required=True)
    mirrors_parser.add_argument('--refresh', action='store_true')
    mirrors_parser.add_argument('--country', default='', help='optional Instance country hint for explicit selection')
    scan_parser = sub.add_parser("scan", help="collect VM facts and authenticated upstream metadata")
    scan_parser.add_argument("--existing-map", action="store_true")
    for name in ("status", "verify", "retention"):
        sub.add_parser(name)
    for name in ("scan", "status", "verify", "retention"):
        sub.choices[name].add_argument("--json", action="store_true")
    for name in ("inspect-target", "audit-accepted"):
        target = sub.add_parser(name, help="inspect one VM without adopting or replacing it")
        target.add_argument("--box", required=True)
        target.add_argument("--role", choices=vm_no_application.ROLES, required=True)
        target.add_argument("--json", action="store_true")
    prepare_parser = sub.add_parser("prepare", help="build latest stable Alpine, test, and retire unused older images; never deploy")
    prepare_parser.add_argument("--box", required=True)
    prepare_parser.add_argument('--profile', choices=('shared-alpine-v1', 'air-alpine-v1', 'ops-alpine-v1', 'vpn-egress-alpine-v1'), default='shared-alpine-v1')
    prepare_parser.add_argument("--inputs-only", action="store_true")
    prepare_parser.add_argument("--test-app", choices=("static-site-web",))
    cleanup_parser = sub.add_parser('cleanup', help='retire eligible images and caches without downloading or building')
    cleanup_parser.add_argument('--box', required=True)
    cleanup_parser.add_argument('--profile', choices=infrastructure_images.PROFILES, required=True)
    cleanup_parser.add_argument('--keep-image', required=True)
    cleanup_parser.add_argument('--preserve-qualified', action='store_true',
                                help='keep unused qualified local candidates for later selection')
    cleanup_parser.add_argument('--dry-run-plan', action='store_true')
    receipt_parser = sub.add_parser('image-receipt', help='exchange bounded public qualification records; never image bytes')
    receipt_parser.add_argument('--box', required=True)
    receipt_mode = receipt_parser.add_mutually_exclusive_group(required=True)
    receipt_mode.add_argument('--operation-id')
    receipt_mode.add_argument('--import', dest='receive', action='store_true', help='read a public receipt from stdin')
    provision_parser=sub.add_parser('provision',help='create or verify a DMZ or IoT VM through the common image configuration')
    provision_parser.add_argument('--box',required=True)
    provision_parser.add_argument('--role',choices=('dmz','iot'),required=True)
    provision_parser.add_argument('--dry-run-plan',action='store_true')
    update_parser = sub.add_parser('update', help='replace or resume one declared shared or VPN VM from a qualified local image')
    update_parser.add_argument('--box', required=True)
    update_parser.add_argument('--role', choices=('bak','dmz','iot','vpn-egress'), required=True)
    mode = update_parser.add_mutually_exclusive_group()
    mode.add_argument('--image')
    mode.add_argument('--resume')
    mode.add_argument('--rebuild', action='store_true', help='prepare current VPN, DMZ or IoT inputs and reconstruct even with an unchanged image')
    mode.add_argument('--retire-older', action='store_true', help='retire checked VPN, DMZ or IoT generations older than the previous accepted root')
    update_parser.add_argument('--discard-root-data', action='store_true', help='first DMZ or IoT transition: omit root-resident development data; preserve separate data disks')
    update_parser.add_argument('--dry-run-plan', action='store_true')
    update_parser.add_argument('--abandon-unbooted', action='store_true', help='with --resume, recover the old VM and retain an unbooted failed attempt')
    args = parser.parse_args(argv)
    os.umask(0o077)
    try:
        if args.command == 'mirrors':
            import alpine_mirrors
            import platform_source
            platform_source.require_local_image(args.box)
            print(canonical(alpine_mirrors.select(args.box, args.refresh, args.country)))
            return 0
        if args.command == 'provision':
            import dmz_provisioning
            print(canonical(dmz_provisioning.provision(args.box,repo=REPO,role=args.role,dry_run=args.dry_run_plan)))
            return 0
        if args.command == 'update':
            import vm_service_updates
            if args.abandon_unbooted and not args.resume: raise UpdateError('--abandon-unbooted requires --resume OPERATION_ID')
            print(canonical(vm_service_updates.execute(args.box, args.role, image=args.image, resume=args.resume, dry_run=args.dry_run_plan, abandon=args.abandon_unbooted, rebuild=args.rebuild, retire=args.retire_older, discard_root_data=args.discard_root_data)))
            return 0
        if args.command == 'cleanup':
            result = images.cleanup_images(args.box, args.profile, args.keep_image, args.dry_run_plan, args.preserve_qualified)
            print(canonical(result))
            return 1 if result['status'] == 'deferred' else 0
        if args.command == 'image-receipt':
            print(canonical(images.image_receipt(args.box, args.operation_id, args.receive)))
            return 0
        if args.command == "prepare":
            result = images.prepare(args.box, args.inputs_only, args.test_app, args.profile)
            print(canonical(result))
            return 1 if result['cleanup']['status'] == 'deferred' else 0
        if args.command == "inspect-target":
            result, record = inspection.inspect_target(args.box, args.role)
            print(canonical(result) if args.json else str(record))
            return 0 if result['qualified'] else 1
        if args.command == "audit-accepted":
            result = inspection.audit_accepted(args.box, args.role)
            print(canonical(result))
            return 1 if result['summary']['unresolved'] or result['findings'] else 0
        require_controller()
        if args.command == "verify":
            result = inspection.verify_accepted()
            print(canonical(result))
            return 0 if result['verified'] else 1
        if args.command == "retention":
            result = inspection.retention_report()
            print(canonical(result))
            return 1 if any(v['severity'] == 'critical' for v in result['findings']) else 0
        if args.command == "scan":
            report = inspection.scan(not args.existing_map)
        else:
            report = optional(STATE / "current.json")
            if report is None:
                raise UpdateError("no discovery report; run platform-update scan first")
            assignments, assignment_findings = inspection.assignment_summary()
            current_findings = health(report, optional(STATE / "verification.json"), now(),
                selected_hosts={box + '-' + role for box, role in inspection.selected_targets()},
                report_max_age_hours=30)
            inventory = [{'host': host.get('host'), 'profile': host.get('profile'),
                          'branch': host.get('branch'),
                          'runtime': host.get('target', {}).get('runtime'),
                          'update_status': host.get('update_status')}
                         for host in report.get('hosts', [])]
            report = {'kind': 'klokast.vm-update-status.v1', 'generated_at': timestamp(now()),
                      'hosts': [], 'inventory': inventory, 'policy': {'state': 'retired'},
                      'assignments': assignments,
                      'findings': current_findings + assignment_findings}
        display(report, args.json)
        return 1 if any(v["severity"] == "critical" for v in report["findings"] +
                       [f for h in report.get("hosts", []) for f in h["findings"]]) else 0
    except (UpdateError, RuntimeError, OSError, ValueError, TypeError, KeyError) as error:
        print("platform-update: " + str(error), file=sys.stderr)
        return 2


if __name__ == "__main__":
    raise SystemExit(main())
