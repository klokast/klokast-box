#!/usr/bin/env python3
"""Controller-local VM discovery, signed policy controls, and candidate builds."""

import argparse
import datetime as dt
import fcntl
import functools
import hashlib
import json
import os
from pathlib import Path
import re
import secrets
import signal
import socket
import subprocess
import sys
import tempfile

REPO = Path(__file__).resolve().parents[2]
APPROVED_REPO = Path("/home/smith/src/klokast/klokast-box")
sys.path.insert(0, str(REPO / "ansible/lib"))
from platform_updates import (REPORT_KIND, UpdateError, assess_host, canonical, digest,
                              no_application_release,
                              findings, fresh, health, parse_apk_database, timestamp,
                              unique_object, VERIFY_AGE)
from platform_update_metadata import adjacent_stable_branch, collect_branch, compare_versions, supported_stable_branch
import vm_template_inputs
import vm_app_compatibility
import vm_storage_inventory
import vm_retention
import vm_no_application
import vm_artifact_transfer
import vm_config_audit

STATE = Path("/var/lib/klokast/updates/discovery")
CACHE = Path("/var/cache/klokast/updates")
PROFILE = REPO / "ansible/update-profiles/shared-alpine-v1.json"
RETENTION_CATALOGS = (REPO / 'apps/music/vm-retention.json',)
GUARD = Path("/usr/local/sbin/klokast-controller-guard")
HOST = re.compile(r"[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?")
AUTO_TARGETS = (('k001', 'dmz'), ('k002', 'dmz'), ('k002', 'iot'))


def now():
    return dt.datetime.now(dt.timezone.utc)


def load(path):
    if not path.is_file() or path.is_symlink() or path.stat().st_size > 64 * 1024 * 1024:
        raise UpdateError("evidence file is absent, unsafe, or too large: " + str(path))
    return json.loads(path.read_text(), object_pairs_hook=unique_object)


def optional(path):
    return load(path) if path.exists() else None


def write(path, value):
    # State paths are fixed and live outside both Git repositories.
    with tempfile.NamedTemporaryFile(mode="w", dir=path.parent, prefix=".update-", delete=False) as stream:
        temporary = Path(stream.name)
        stream.write(canonical(value) + "\n")
        stream.flush()
        os.fsync(stream.fileno())
    try:
        temporary.replace(path)
        descriptor = os.open(path.parent, os.O_RDONLY | os.O_DIRECTORY)
        try:
            os.fsync(descriptor)
        finally:
            os.close(descriptor)
    finally:
        temporary.unlink(missing_ok=True)


def command(argv, *, timeout=120, log=None):
    try:
        # Each bounded child has its own group. A timeout also stops its SSH
        # and Ansible children instead of leaving an abandoned scan running.
        with subprocess.Popen([str(v) for v in argv], stdin=subprocess.DEVNULL,
                              stdout=log or subprocess.PIPE, stderr=log or subprocess.PIPE,
                              text=True, start_new_session=True) as process:
            try:
                stdout, _stderr = process.communicate(timeout=timeout)
            except subprocess.TimeoutExpired:
                os.killpg(process.pid, signal.SIGTERM)
                try:
                    process.wait(timeout=5)
                except subprocess.TimeoutExpired:
                    os.killpg(process.pid, signal.SIGKILL)
                raise UpdateError("bounded inspection command timed out")
            if process.returncode:
                raise UpdateError("inspection command failed; inspect the controller scan log")
            return stdout or ""
    except OSError as error:
        raise UpdateError("required controller tool is unavailable") from error


def require_controller():
    status = json.loads(command([GUARD, "--status", "--json", "--require-active"]), object_pairs_hook=unique_object)
    if status.get("active") is not True or status.get("configured") is not True or status.get("role") != "active":
        raise UpdateError("VM update inspection requires the explicitly active controller")
    local = socket.gethostname().split(".")[0]
    if status.get("hostname") != local or not local.endswith("-ops") or local.startswith(("vultr-", "hetzner-")):
        raise UpdateError("run this command on the active box controller as smith")
    if os.geteuid() == 0 or __import__("pwd").getpwuid(os.geteuid()).pw_name != "smith":
        raise UpdateError("run platform-update as smith on the active controller")
    return status


def targets_from_map(mapping):
    """Inventory every configured or observed Xen VM; never start a stopped VM."""
    targets = {}
    for box, data in sorted(mapping["boxes"].items()):
        if not HOST.fullmatch(box):
            raise UpdateError("mapper contains an invalid box name")
        for role in ("router", "bak", "dmz", "iot", "ops"):
            machine = data.get("machines", {}).get(role)
            if machine is not None or role != "ops":
                targets[box + "-" + role] = {"box": box, "role": role}
        for host, entry in data.get("app_vms", {}).items():
            targets[host] = {"box": box, "role": "dedicated", "app": entry.get("app")}
        xen = data.get("dom0", {}).get("xen", {})
        for entry in xen.get("domains", []):
            guest = entry.get("name", "")
            if guest == "Domain-0":
                continue
            host = box + "-" + guest
            targets.setdefault(host, {"box": box, "role": "unknown"})
        for name in xen.get("config_files", []):
            guest = Path(name).stem
            targets.setdefault(box + "-" + guest, {"box": box, "role": "unknown"})
        for host, target in targets.items():
            if target["box"] != box:
                continue
            guest = host[len(box) + 1:]
            target["runtime"] = "unknown"
            if xen.get("available") is True:
                target["runtime"] = "running" if any(v.get("name") == guest for v in xen.get("domains", [])) else "stopped"
    if not targets or any(not HOST.fullmatch(host) for host in targets):
        raise UpdateError("mapper VM inventory is empty or contains invalid names")
    return targets


def collect_facts(targets, directory, log, suffix):
    if not isinstance(suffix, str) or not re.fullmatch(r"[a-z0-9.-]+\.ts\.net", suffix):
        raise UpdateError("the verified Platform map has no valid Tailnet DNS suffix")
    hosts = {}
    for host, target in targets.items():
        if target["runtime"] != "running":
            continue
        hosts[host] = {"ansible_host": host + "." + suffix, "ansible_user": "smith" if target["role"] == "ops" else "neo",
                       "vm_update_shared_storage": target['role'] in ('bak', 'dmz', 'iot'),
                       "ansible_become_method": "doas", "ansible_become_flags": "-n",
                       "ansible_python_interpreter": "/usr/bin/python3",
                       "ansible_ssh_common_args": "-o StrictHostKeyChecking=accept-new -o ConnectTimeout=8 -o ConnectionAttempts=1 -o ServerAliveInterval=5 -o ServerAliveCountMax=2",
                       "ansible_timeout": 15}
        if host == socket.gethostname().split(".")[0]:
            hosts[host]["ansible_connection"] = "local"
    if not hosts:
        return
    inventory = directory / "inventory.json"
    write(inventory, {"all": {"hosts": hosts}})
    arguments = directory / "arguments.json"
    write(arguments, {"vm_update_fact_dir": str(directory)})
    command(["ansible-playbook", "-vv", "-i", inventory,
             REPO / "ansible/playbooks/74-platform-update-scan.yml", "-e", "@" + str(arguments)], timeout=600, log=log)


def scan(refresh=True):
    require_controller()
    if not STATE.is_dir() or not CACHE.is_dir():
        raise UpdateError("install the platform-update-discovery Ansible role before scanning")
    with (STATE / "scan.lock").open("a") as lock:
        try:
            fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
        except BlockingIOError as error:
            raise UpdateError("another discovery operation holds the installation lock") from error
        started = now()
        report = {"kind": REPORT_KIND, "generated_at": timestamp(started), "hosts": [], "findings": [],
                  "source_controller": socket.gethostname(), "profile_sha256": digest(load(PROFILE)),
                  "implementation_commit": command(["git", "-C", REPO, "rev-parse", "HEAD"]).strip(),
                  "complete": False}
        # Invalidate the prior report before any remote or metadata work starts.
        write(STATE / "current.json", {**report, "findings": [findings("discovery.incomplete", "Discovery has started but has not completed.", "critical")]})
        with (STATE / "scan.log").open("w") as log:
            try:
                # The mapper can emit a partial report after an Ansible source
                # failure. Check the authoritative reader independently first.
                command(["/usr/local/sbin/platform-inventory", "--list"])
                if refresh:
                    command([APPROVED_REPO / "ansible/bin/platform-map", "refresh", "--remote-scope", "dom0"], timeout=600, log=log)
                mapping = load(APPROVED_REPO / ".run/platform-map/current.json")
                if not fresh(mapping.get("generated_at"), now(), VERIFY_AGE):
                    raise UpdateError("the Platform map is stale; refresh it on the active controller")
                targets = targets_from_map(mapping)
                if any(v["runtime"] == "unknown" for v in targets.values()):
                    report["findings"].append(findings("inventory.runtime-unknown", "Xen inventory is incomplete; configured or running VMs may be missing.", "critical"))
                profile = load(PROFILE)
                retention_catalogs = [load(path) for path in RETENTION_CATALOGS]
                facts = {}
                with tempfile.TemporaryDirectory(prefix="facts-", dir=STATE) as work:
                    directory = Path(work)
                    try:
                        collect_facts(targets, directory, log, mapping.get("tailnet", {}).get("magicdns_suffix"))
                    except UpdateError:
                        report["findings"].append(findings("inventory.partial", "VM collection failed for one or more targets.", "critical"))
                    for host, target in targets.items():
                        fact = optional(directory / (host + ".json"))
                        if fact:
                            fact.update(target)
                            # Controller time bounds the collection. Guest clock drift
                            # stays visible without granting freshness to old files.
                            fact["guest_observed_at"] = fact["observed_at"]
                            fact["observed_at"] = timestamp(now())
                            release = fact.get("os", {}).get("version_id", "").split(".")
                            fact["branch"] = "v" + ".".join(release[:2]) if len(release) >= 2 else ""
                            try:
                                fact["packages"] = parse_apk_database(fact.pop("apk_database", ""))
                            except UpdateError:
                                fact["packages"] = {}
                        facts[host] = fact
                metadata = {}
                branches = sorted({v["branch"] for v in facts.values() if v and v.get("os", {}).get("id") == "alpine" and re.fullmatch(r"v[0-9]+\.[0-9]+", v.get("branch", ""))})
                for branch in branches:
                    print("platform-update: verify official repository metadata for " + branch, file=sys.stderr)
                    metadata[branch] = collect_branch(branch, CACHE, profile, now())
                compare = functools.lru_cache(maxsize=16384)(compare_versions)
                for host, target in sorted(targets.items()):
                    result = assess_host(host, facts[host], metadata, profile["packages"], compare, now())
                    if result['profile'] == 'shared-alpine-v1':
                        result['storage_assessment'] = vm_storage_inventory.assess(facts[host], retention_catalogs, host)
                        result['findings'].extend(result['storage_assessment']['findings'])
                        result['host_assessment'] = vm_storage_inventory.assess_host_data(facts[host], host)
                        result['findings'].extend(result['host_assessment']['findings'])
                    result["target"] = target
                    if target["runtime"] == "stopped":
                        result["findings"] = [v for v in result["findings"] if v["code"] != "inventory.unknown"]
                        result["findings"].append(findings("replacement.stopped", "VM is stopped; replacement is deferred until an approved start.", scope=host))
                    report["hosts"].append(result)
                # Keep raw official evidence separate from the concise report.
                write(STATE / "metadata.json", metadata)
                report["metadata_sha256"] = digest(metadata)
                report["complete"] = True
            except (UpdateError, KeyError, ValueError, TypeError) as error:
                report["findings"].append(findings("discovery.failed", str(error), "critical"))
            report["generated_at"] = timestamp(now())
            write(STATE / "current.json", report)
    return report


def prepare(box, branch, inputs_only=False, test_app=None):
    """Build candidate evidence; this command cannot select a production release."""
    require_controller()
    if not HOST.fullmatch(box) or len(box) > 31:
        raise UpdateError("template construction requires a valid box identifier")
    vm_template_inputs.branch_number(branch)
    if not STATE.is_dir() or not CACHE.is_dir():
        raise UpdateError("install discovery directories before preparing templates")
    if command(["git", "-C", REPO, "status", "--porcelain", "--untracked-files=normal"]).strip():
        raise UpdateError("template construction requires clean committed engine source")
    commit = command(["git", "-C", REPO, "rev-parse", "HEAD"]).strip()
    if commit != command(["git", "-C", REPO, "rev-parse", "@{upstream}"]).strip():
        raise UpdateError("template source must match its public upstream commit")
    # Use the installed source reader for private inventory. Candidate source
    # does not replace or change the approved engine checkout.
    command(["/usr/local/sbin/platform-inventory", "--list"])
    with (STATE / "build.lock").open("a") as lock:
        try:
            fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
        except BlockingIOError as error:
            raise UpdateError("another template build holds the controller build lock") from error
        operation = secrets.token_hex(12)
        work = CACHE / ("build-" + operation)
        work.mkdir(mode=0o700)
        result = STATE / "builds" / operation
        result.mkdir(parents=True, mode=0o700)
        print("platform-update: freeze template inputs for " + branch + "; operation " + operation, file=sys.stderr)
        profile = load(PROFILE)
        app_test = None
        if test_app:
            print('platform-update: stage the unchanged catalog image for ' + test_app, file=sys.stderr)
            app_test = vm_app_compatibility.prepare(REPO, work / 'app-test')
        inputs = vm_template_inputs.freeze(work / "inputs", profile, branch, commit)
        job = REPO / "ansible/roles/vm-template-builder/files/vm-template-build-guest"
        retained = REPO / "ansible/roles/vm-retained-data/files"
        vm_template_inputs.personalization_fixture(REPO, work / 'personalization-config.json')
        capsule = vm_template_inputs.capsule(work / "inputs", work / "capsule.tar", job, job.with_name("vm-template-smoke-guest"),
                                            retained / "retained_data.py", retained / "retained_data_test.py",
                                            REPO / 'ansible/lib/vm_app_compatibility.py',
                                            REPO / 'apps/static-site/ansible/roles/static-site-runtime/files/vm_compatibility.py',
                                            REPO / 'ansible/roles/vm-personalize/files/vm_personalize.py',
                                            REPO / 'ansible/roles/vm-personalize/files/vm_personalize_test.py',
                                            work / 'personalization-config.json')
        print("platform-update: assemble the scriptless builder boot environment", file=sys.stderr)
        boot = vm_template_inputs.bootstrap(work / "inputs", work / "boot", job)
        request = {"kind": "klokast.vm-template-build-request.v1", "box": box,
                   "operation_id": operation, "inputs_sha256": inputs["inputs_sha256"],
                   "capsule": capsule, "bootstrap": boot}
        if app_test:
            request['app_test'] = app_test
        write(work / "request.json", request)
        write(result / "inputs.json", inputs)
        write(result / "request.json", request)
        if inputs_only:
            return {"operation_id": operation, "inputs_sha256": inputs["inputs_sha256"],
                    "state": "inputs-prepared", "accepted": False, "result_directory": str(result)}
        print("platform-update: build the candidate in a networkless Xen guest on " + box, file=sys.stderr)
        arguments = work / "arguments.json"
        write(arguments, {"template_box": box, "template_operation_id": operation,
                          "template_input_dir": str(work), "template_result_dir": str(result),
                          "template_app_test": bool(app_test)})
        with (result / "build.log").open("w") as log:
            try:
                command(["ansible-playbook", "-vv", "-i", APPROVED_REPO / "ansible/execution-inventory/hosts",
                         REPO / "ansible/playbooks/74-platform-update-template.yml", "--limit", box + "-dom0",
                         "-e", "@" + str(arguments)], timeout=3600, log=log)
            except UpdateError as error:
                raise UpdateError("candidate construction failed; inspect " + str(result / "build.log")) from error
        candidate = load(result / "candidate.json")
        lifecycle = load(result / "lifecycle.json")
        test_lifecycle = load(result / "test-lifecycle.json")
        base_tests = {k: True for k in ("boot", "kernel_modules", "tailscale_offline", "rootless_podman", "nftables_kernel", "retained_data_copy", "retained_data_stage", "retained_identity", "retained_partition", "personalization", "backup_restore")}
        boot_test = candidate.get("boot_test", {})
        normal = boot_test.get('openrc_test', {})
        personalized = boot_test.get('personalized_test', {})
        personalization = boot_test.get('personalization_stage', {})
        maintenance = boot_test.get('maintenance_restore', {})
        restored = maintenance.get('restore', {})
        normal_tests = dict.fromkeys(('openrc_boot', 'cgroup_v2', 'kernel_modules',
                                      'tailscale_offline', 'default_rootless_podman'), True)
        personalized_tests = dict.fromkeys(('personalized_boot', 'configuration', 'retained_mount',
            'runtime_identity', 'tailscale_retained_state', 'firewall', 'default_rootless_podman', 'packages_unchanged'), True)
        if (candidate.get("kind") != "klokast.vm-template-candidate.v1" or candidate.get("accepted") is not False or
                candidate.get("success") is not True or candidate.get("box") != box or
                candidate.get("validation") != "base-boot-tested" or candidate.get("operation_id") != operation or
                candidate.get("inputs_sha256") != inputs["inputs_sha256"] or
                candidate.get("packages") != {v["name"]: v["version"] for v in inputs["packages"]} or
                boot_test.get("kind") != "klokast.vm-template-test-result.v1" or boot_test.get("success") is not True or
                boot_test.get("operation_id") != operation or boot_test.get("inputs_sha256") != inputs["inputs_sha256"] or
                boot_test.get("tests") != base_tests or boot_test.get("kernel_release") != candidate.get("kernel_release") or
                boot_test.get("tested_root_sha256") != candidate.get("artifacts", {}).get("root", {}).get("sha256") or
                normal.get('kind') != 'klokast.vm-template-openrc-test.v1' or normal.get('success') is not True or
                normal.get('operation_id') != operation or normal.get('inputs_sha256') != inputs['inputs_sha256'] or
                normal.get('kernel_release') != candidate.get('kernel_release') or normal.get('tests') != normal_tests or
                personalized.get('kind') != 'klokast.vm-template-personalized-test.v1' or personalized.get('success') is not True or
                personalized.get('operation_id') != operation or personalized.get('inputs_sha256') != inputs['inputs_sha256'] or
                personalized.get('kernel_release') != candidate.get('kernel_release') or personalized.get('tests') != personalized_tests or
                personalized.get('production_data_used') is not False or
                personalization.get('kind') != 'klokast.vm-template-personalize-stage.v1' or personalization.get('success') is not True or
                personalization.get('operation_id') != operation or personalization.get('inputs_sha256') != inputs['inputs_sha256'] or
                personalization.get('source_root_sha256') != candidate.get('artifacts', {}).get('root', {}).get('sha256') or
                personalization.get('production_data_used') is not False or
                maintenance.get('kind') != 'klokast.vm-backup-restore-guest.v1' or maintenance.get('success') is not True or
                maintenance.get('operation_id') != operation or maintenance.get('inputs_sha256') != inputs['inputs_sha256'] or
                not isinstance(maintenance.get('request_sha256'), str) or not re.fullmatch('[0-9a-f]{64}', maintenance['request_sha256']) or
                restored.get('kind') != 'klokast.vm-backup-restore-result.v1' or
                restored.get('request_sha256') != maintenance['request_sha256'] or
                any(restored.get(k) is not True for k in ('complete_disk_restored', 'root_filesystem_checked', 'backup_unchanged')) or
                any(restored.get(k) is not False for k in ('source_freshness_verified', 'application_consistency_verified', 'adoption_accepted')) or
                restored.get('receipt_sha256') != digest({k: v for k, v in restored.items() if k != 'receipt_sha256'}) or
                any(not isinstance(personalized.get(k), str) or not re.fullmatch('[0-9a-f]{64}', personalized[k]) or
                    personalized[k] != personalization.get(k) for k in ('request_sha256', 'receipt_sha256')) or
                lifecycle.get("stage") != "cleaned" or lifecycle.get("domain") != "vm-build-" + operation or
                test_lifecycle.get('openrc_domain') != 'vm-openrc-' + operation or
                test_lifecycle.get('personalize_domain') != 'vm-personalize-' + operation or
                test_lifecycle.get('profile_domain') != 'vm-profile-' + operation or
                test_lifecycle.get('restore_domain') != 'vm-restore-' + operation or
                test_lifecycle.get("stage") != "cleaned" or test_lifecycle.get("domain") != "vm-test-" + operation):
            raise UpdateError("candidate or cleanup evidence differs from the frozen build request")
        if app_test:
            vm_app_compatibility.verify_result(boot_test.get('application_test'), app_test['selection'])
        elif 'application_test' in boot_test:
            raise UpdateError('unexpected application evidence without an approved test selection')
        release_evidence = None
        if not app_test:
            release_evidence = no_application_release(inputs, candidate, normal, personalized, maintenance)
            write(result / 'release-evidence.json', release_evidence)
        return {"operation_id": operation, "inputs_sha256": inputs["inputs_sha256"], "state": "candidate-built",
                "accepted": False, "result_directory": str(result), "artifacts": candidate["artifacts"],
                "validation": candidate["validation"], "base_tests": boot_test["tests"],
                'openrc_tests': normal['tests'], 'personalized_tests': personalized['tests'],
                'maintenance_restore_verified': True,
                "application_test": boot_test.get("application_test"),
                "release_evidence_sha256": release_evidence['release_sha256'] if release_evidence else None}


def automatic_selection(discovery, metadata, policy_source, engine_commit, observed_at):
    """Select the one shared-template branch from signed policy and fresh scan.

    This only selects inputs for the existing builder. It does not adopt a
    guest, create an assignment, or start a replacement.
    """
    source_fields = {'kind', 'policy', 'policy_sha256', 'activation_sha256',
                     'engine_commit', 'private_commit', 'authority_state_sha256',
                     'paused', 'replacement_executor_available'}
    if (not isinstance(policy_source, dict) or set(policy_source) != source_fields or
            policy_source['kind'] != 'klokast.vm-update-policy-source.v1' or
            policy_source['engine_commit'] != engine_commit or policy_source['paused'] is not False):
        raise UpdateError('automatic preparation requires the current unpaused signed VM update policy')
    policy = policy_source['policy']
    if (not isinstance(policy, dict) or policy.get('enabled') is not True or
            policy.get('branch-policy') != 'tested-stable' or not isinstance(policy.get('targets'), dict) or
            not isinstance(policy.get('exclusions'), list)):
        raise UpdateError('automatic preparation policy is incomplete or unsupported')
    excluded = set()
    for row in policy['exclusions']:
        if (not isinstance(row, dict) or set(row) != {'box', 'role', 'reason'} or
                not isinstance(row['box'], str) or not isinstance(row['role'], str) or
                not isinstance(row['reason'], str) or not row['reason'].strip()):
            raise UpdateError('automatic preparation policy has an invalid exclusion')
        excluded.add((row['box'], row['role']))
    declared = set()
    for box, roles in policy['targets'].items():
        if (not isinstance(box, str) or not isinstance(roles, list) or
                any(role not in vm_no_application.ROLES for role in roles)):
            raise UpdateError('automatic preparation policy has an invalid target')
        declared.update((box, role) for role in roles)
    selected = tuple(target for target in AUTO_TARGETS if target in declared and target not in excluded)
    if selected != AUTO_TARGETS or declared - set(AUTO_TARGETS) - excluded:
        raise UpdateError('automatic preparation is limited to k001-dmz, k002-dmz, and k002-iot')
    if (not isinstance(discovery, dict) or discovery.get('complete') is not True or
            not fresh(discovery.get('generated_at'), observed_at, VERIFY_AGE) or
            not isinstance(discovery.get('hosts'), list) or not isinstance(metadata, dict)):
        raise UpdateError('automatic preparation requires fresh complete discovery and release metadata')
    hosts = {item.get('host'): item for item in discovery['hosts'] if isinstance(item, dict)}
    if len(hosts) != len(discovery['hosts']):
        raise UpdateError('automatic preparation requires unique complete VM inventory')
    branches = []
    release_metadata = {}
    for box, role in selected:
        host = box + '-' + role
        item = hosts.get(host)
        target = item.get('target', {}) if isinstance(item, dict) else {}
        branch = item.get('branch') if isinstance(item, dict) else None
        evidence = metadata.get(branch) if isinstance(branch, str) else None
        if (not isinstance(item, dict) or item.get('profile') != 'shared-alpine-v1' or
                target.get('box') != box or target.get('role') != role or target.get('runtime') != 'running' or
                not isinstance(evidence, dict) or evidence.get('signature_verified') is not True or
                not fresh(evidence.get('observed_at'), observed_at, VERIFY_AGE) or
                not isinstance(evidence.get('releases'), dict)):
            raise UpdateError('automatic preparation has incomplete target or signed metadata evidence: ' + host)
        vm_template_inputs.branch_number(branch)
        branches.append(branch)
        release_metadata[branch] = evidence['releases']
    oldest = min(branches, key=vm_template_inputs.branch_number)
    candidate = adjacent_stable_branch(oldest, release_metadata[oldest], observed_at)
    if candidate is None:
        if len(set(branches)) != 1 or supported_stable_branch(oldest, release_metadata[oldest], observed_at) is None:
            raise UpdateError('no supported Alpine branch is available for the selected guests')
        candidate = oldest
    if any(branch not in {oldest, candidate} for branch in branches):
        raise UpdateError('selected shared VMs are more than one adjacent branch apart')
    advanced = [branch == candidate for branch in branches]
    if advanced != sorted(advanced, reverse=True):
        raise UpdateError('selected shared VMs advanced outside rollout order')
    return {'kind': 'klokast.vm-update-auto-selection.v1', 'branch': candidate,
            'build_box': selected[0][0], 'targets': [box + '-' + role for box, role in selected],
            'policy_sha256': policy_source['policy_sha256'],
            'activation_sha256': policy_source['activation_sha256'],
            'engine_commit': engine_commit}


def read_policy_source():
    try:
        return json.loads(command(['/usr/bin/doas', '/usr/local/sbin/ksa-apply',
                                   'vm-update-policy', 'source-status'], timeout=900),
                          object_pairs_hook=unique_object)
    except UpdateError as error:
        raise UpdateError('automatic preparation requires the active signed VM update policy') from error
    except (ValueError, TypeError) as error:
        raise UpdateError('current VM update policy source returned invalid JSON') from error


def policy_summary():
    """Read current signed execution state without using an expired scan."""
    try:
        value = json.loads(command(['/usr/bin/doas', '/usr/local/sbin/ksa-apply',
                                    'vm-update-policy', 'source-status'], timeout=30),
                           object_pairs_hook=unique_object)
    except (UpdateError, ValueError, TypeError):
        return ({'state': 'unavailable'},
                [findings('policy.unavailable', 'Current signed VM update policy is unavailable.', 'critical')])
    fields = {'kind', 'policy', 'policy_sha256', 'activation_sha256',
              'engine_commit', 'private_commit', 'authority_state_sha256',
              'paused', 'replacement_executor_available'}
    if (not isinstance(value, dict) or set(value) != fields or
            value['kind'] != 'klokast.vm-update-policy-source.v1' or
            type(value['paused']) is not bool or
            type(value['replacement_executor_available']) is not bool or
            not isinstance(value['policy'], dict) or value['policy'].get('enabled') is not True or
            any(not isinstance(value[key], str) or not re.fullmatch(r'[0-9a-f]{64}', value[key])
                for key in ('policy_sha256', 'activation_sha256', 'authority_state_sha256')) or
            not isinstance(value['engine_commit'], str) or
            not re.fullmatch(r'[0-9a-f]{40}', value['engine_commit'])):
        return ({'state': 'invalid'},
                [findings('policy.invalid', 'Signed VM update policy reader returned an invalid contract.', 'critical')])
    summary = {'state': 'paused' if value['paused'] else 'active',
               'policy_sha256': value['policy_sha256'],
               'activation_sha256': value['activation_sha256'],
               'engine_commit': value['engine_commit'],
               'replacement_executor_available': value['replacement_executor_available']}
    problems = []
    if value['paused']:
        problems.append(findings('policy.paused', 'VM update execution is paused.', 'critical'))
    if not value['replacement_executor_available']:
        problems.append(findings('executor.unavailable', 'The approved VM replacement executor is unavailable.',
                                 'critical'))
    return summary, problems


def installed_apk_keys():
    hashes = {}
    for path in sorted(Path('/etc/apk/keys').glob('*.pub')):
        if path.is_symlink() or not path.is_file() or path.stat().st_size > 16384:
            raise UpdateError('installed APK signing key is unsafe')
        hashes[path.name] = hashlib.sha256(path.read_bytes()).hexdigest()
    if not hashes:
        raise UpdateError('installed APK signing keys are missing')
    return hashes


def reuse_auto_candidate(selection, *, frozen=False):
    """Reuse exact bytes; a started rollout cannot silently change its template."""
    pointer = optional(STATE / 'automatic.json')
    if pointer is None:
        if frozen:
            raise UpdateError('rollout has started but its frozen template pointer is absent')
        return None
    if (not isinstance(pointer, dict) or set(pointer) !=
            {'kind', 'selection', 'operation_id', 'inputs_sha256', 'release_sha256'} or
            pointer['kind'] != 'klokast.vm-update-auto-build.v1' or
            not isinstance(pointer['selection'], dict) or
            not isinstance(pointer['operation_id'], str) or
            not vm_artifact_transfer.OPERATION.fullmatch(pointer['operation_id'])):
        raise UpdateError('automatic template pointer has an unknown contract')
    if pointer['selection'] != selection:
        if frozen:
            raise UpdateError('rollout has started but its frozen template selection differs')
        return None
    directory = STATE / 'builds' / pointer['operation_id']
    inputs = load(directory / 'inputs.json')
    candidate = load(directory / 'candidate.json')
    release = load(directory / 'release-evidence.json')
    profile = load(PROFILE)
    if (not all(isinstance(value, dict) for value in (inputs, candidate, release, profile)) or
            not isinstance(inputs.get('indexes'), dict) or
            len(inputs['indexes']) != len(profile.get('repositories', [])) or
            not isinstance(inputs.get('keys'), dict) or
            inputs.get('inputs_sha256') != pointer['inputs_sha256'] or
            inputs['inputs_sha256'] != digest({k: v for k, v in inputs.items() if k != 'inputs_sha256'}) or
            inputs.get('engine_commit') != selection['engine_commit'] or
            inputs.get('branch') != selection['branch'] or
            inputs.get('profile_sha256') != digest(profile) or
            inputs.get('world') != sorted(profile['packages']) or
            candidate.get('inputs_sha256') != inputs['inputs_sha256'] or
            release.get('release_sha256') != pointer['release_sha256']):
        raise UpdateError('automatic template inputs or release differ from the completed build')
    vm_artifact_transfer.validate(candidate, pointer['operation_id'], selection['build_box'])
    boot_test = candidate.get('boot_test', {})
    expected_release = no_application_release(
        inputs, candidate, boot_test.get('openrc_test', {}),
        boot_test.get('personalized_test', {}), boot_test.get('maintenance_restore', {}))
    if release != expected_release:
        raise UpdateError('automatic template release differs from its complete base tests')
    for name, entry in inputs.get('keys', {}).items():
        if (not isinstance(name, str) or not re.fullmatch(r'[A-Za-z0-9_.-]+\.pub', name) or
                not isinstance(entry, str) or not re.fullmatch(r'[0-9a-f]{64}', entry)):
            raise UpdateError('automatic template has invalid APK signing key evidence')
    current_keys = installed_apk_keys()
    if current_keys != inputs.get('keys'):
        if frozen:
            raise UpdateError('rollout signing keys changed; the frozen template is blocked')
        return None
    if not frozen:
        metadata = collect_branch(selection['branch'], CACHE, profile, now())
        if (not isinstance(metadata, dict) or metadata.get('signature_verified') is not True or
                not fresh(metadata.get('observed_at'), now(), VERIFY_AGE)):
            raise UpdateError('unchanged-template check needs current signed target-branch metadata')
        index_hashes = metadata.get('inputs_sha256')
        if (not isinstance(index_hashes, dict) or
                any(not isinstance(index_hashes.get(repository + ':index'), str)
                    for repository in profile['repositories'])):
            raise UpdateError('unchanged-template check lacks signed repository indexes')
        if sorted(inputs.get('indexes', {}).values()) != sorted(
                index_hashes[repository + ':index'] for repository in profile['repositories']):
            return None
    targets = sorted({host.rsplit('-', 1)[0] for host in selection['targets']})
    transfers = []
    for box in targets:
        vm_artifact_transfer.verify_published(
            candidate, pointer['operation_id'], selection['build_box'], box,
            directory / 'candidate.json')
        if box != selection['build_box']:
            receipt = load(directory / ('transfer-' + box + '.json'))
            if (receipt.get('kind') != 'klokast.vm-template-transfer.v1' or
                    receipt.get('operation_id') != pointer['operation_id'] or
                    receipt.get('source_box') != selection['build_box'] or
                    receipt.get('target_box') != box or
                    receipt.get('artifacts') != candidate['artifacts'] or
                    receipt.get('accepted') is not False):
                raise UpdateError('automatic template transfer receipt differs')
            transfers.append(receipt)
    return {'state': 'unchanged', 'operation_id': pointer['operation_id'],
            'inputs_sha256': inputs['inputs_sha256'], 'accepted': False,
            'result_directory': str(directory), 'artifacts': candidate['artifacts'],
            'release_evidence_sha256': release['release_sha256'],
            'automatic_selection': selection, 'transfers': transfers}


def prepare_auto():
    """Serialize automatic selection, construction, and verified transfer."""
    require_controller()
    if not STATE.is_dir():
        raise UpdateError('install discovery state before automatic preparation')
    with (STATE / 'auto.lock').open('a') as lock:
        try:
            fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
        except BlockingIOError as error:
            raise UpdateError('another automatic preparation holds the controller lock') from error
        return prepare_auto_locked()


def import_protected_release(operation_id, release_sha256):
    """Ask the root authority boundary to freeze the exact automatic build."""
    if (not isinstance(operation_id, str) or not re.fullmatch(r'[0-9a-f]{24}', operation_id) or
            not isinstance(release_sha256, str) or not re.fullmatch(r'[0-9a-f]{64}', release_sha256)):
        raise UpdateError('automatic release has an invalid identity')
    result = subprocess.run(['/usr/bin/doas', '/usr/local/sbin/ksa-apply',
                             'vm-update-release', 'import', '--operation-id', operation_id],
                            stdin=subprocess.DEVNULL, capture_output=True, text=True, timeout=900)
    if result.returncode:
        raise UpdateError('protected release import failed: ' + result.stderr[-2048:].strip())
    try:
        receipt = json.loads(result.stdout, object_pairs_hook=unique_object)
    except (ValueError, TypeError) as error:
        raise UpdateError('protected release import returned invalid JSON') from error
    if (not isinstance(receipt, dict) or set(receipt) !=
            {'kind', 'record_sha256', 'release_sha256', 'build_operation_id', 'result'} or
            receipt['kind'] != 'klokast.vm-protected-release.v1' or
            receipt['build_operation_id'] != operation_id or
            receipt['release_sha256'] != release_sha256 or
            receipt['result'] not in {'imported', 'unchanged'} or
            not isinstance(receipt['record_sha256'], str) or
            not re.fullmatch(r'[0-9a-f]{64}', receipt['record_sha256'])):
        raise UpdateError('protected release import did not bind the selected build')
    return receipt


def prepare_auto_locked():
    """Build once and stage identical checked bytes on selected boxes."""
    if command(['git', '-C', REPO, 'status', '--porcelain', '--untracked-files=normal']).strip():
        raise UpdateError('automatic preparation requires clean committed engine source')
    commit = command(['git', '-C', REPO, 'rev-parse', 'HEAD']).strip()
    source = read_policy_source()
    discovery, metadata = optional(STATE / 'current.json'), optional(STATE / 'metadata.json')
    selection = automatic_selection(discovery, metadata, source, commit, now())
    hosts = {item['host']: item for item in discovery['hosts']}
    frozen = len({hosts[host]['branch'] for host in selection['targets']}) > 1
    unchanged = reuse_auto_candidate(selection, frozen=frozen)
    if unchanged is not None:
        if (read_policy_source() != source or optional(STATE / 'current.json') != discovery or
                optional(STATE / 'metadata.json') != metadata or
                command(['git', '-C', REPO, 'rev-parse', 'HEAD']).strip() != commit or
                command(['git', '-C', REPO, 'status', '--porcelain', '--untracked-files=normal']).strip()):
            raise UpdateError('authority, discovery, or engine changed during unchanged-template check')
        protected = import_protected_release(unchanged['operation_id'], unchanged['release_evidence_sha256'])
        return {**unchanged, 'protected_release': protected}
    result = prepare(selection['build_box'], selection['branch'])
    if (read_policy_source() != source or optional(STATE / 'current.json') != discovery or
            optional(STATE / 'metadata.json') != metadata or
            command(['git', '-C', REPO, 'rev-parse', 'HEAD']).strip() != commit or
            command(['git', '-C', REPO, 'status', '--porcelain', '--untracked-files=normal']).strip()):
        raise UpdateError('policy, discovery, metadata, or engine changed during automatic preparation')
    if result['state'] != 'candidate-built' or result['accepted'] is not False:
        raise UpdateError('automatic preparation did not produce an unaccepted template')
    directory = Path(result['result_directory'])
    candidate = load(directory / 'candidate.json')
    release = load(directory / 'release-evidence.json')
    if (release.get('kind') != 'klokast.vm-release.v2' or
            release.get('release_sha256') != result['release_evidence_sha256'] or
            release.get('artifacts') != candidate.get('artifacts') or
            release.get('engine_commit') != commit or
            release.get('branch') != selection['branch'] or
            release.get('application_tests') != {'status': 'not-run', 'executed': False}):
        raise UpdateError('automatic template release differs from the checked build')
    transfers = []
    for target_box in sorted({host.rsplit('-', 1)[0] for host in selection['targets']}
                             - {selection['build_box']}):
        arguments = canonical({'transfer_target_box': target_box})
        with (directory / ('transfer-' + target_box + '.log')).open('w') as log:
            command(['ansible-playbook', '-vv', '-i',
                     APPROVED_REPO / 'ansible/execution-inventory/hosts',
                     REPO / 'ansible/playbooks/74-platform-update-template-transfer.yml',
                     '--limit', target_box + '-dom0', '-e', arguments],
                    timeout=180, log=log)
        receipt = vm_artifact_transfer.transfer(
            candidate, result['operation_id'], selection['build_box'], target_box,
            directory / 'candidate.json', CACHE)
        write(directory / ('transfer-' + target_box + '.json'), receipt)
        transfers.append(receipt)
    if (read_policy_source() != source or optional(STATE / 'current.json') != discovery or
            optional(STATE / 'metadata.json') != metadata or
            command(['git', '-C', REPO, 'rev-parse', 'HEAD']).strip() != commit or
            command(['git', '-C', REPO, 'status', '--porcelain', '--untracked-files=normal']).strip()):
        raise UpdateError('standing policy, discovery, metadata, or engine changed during template transfer')
    write(STATE / 'automatic.json', {
        'kind': 'klokast.vm-update-auto-build.v1', 'selection': selection,
        'operation_id': result['operation_id'], 'inputs_sha256': result['inputs_sha256'],
        'release_sha256': release['release_sha256']})
    protected = import_protected_release(result['operation_id'], release['release_sha256'])
    return {**result, 'automatic_selection': selection, 'transfers': transfers,
            'protected_release': protected}


def display(report, as_json):
    if as_json:
        print(json.dumps(report, sort_keys=True, indent=2))
        return
    print("VM update report: " + report.get("generated_at", "missing"))
    for item in report.get("hosts", []):
        print(f"{item['host']}: {item['update_status']}; profile={item['profile']}; updates={len(item['updates'])}; security={len(item['security_fixes'])}; replacement=blocked")
        if 'storage_assessment' in item:
            storage = item['storage_assessment']
            for volume in storage['volumes']:
                match = volume['catalog_match']
                label = match['app'] + '/' + match['dataset'] if match else 'unclassified'
                print(f"  volume {volume['name']}: catalog={label}; path={'supported' if volume['path_supported'] else 'blocked'}; retention=unapproved")
        host_inventory = item.get('host_assessment', {}).get('inventory') or {}
        for service in host_inventory.get('native_services', {}).get('services', []):
            if service['runlevels'] or service['markers']:
                levels = ','.join(service['runlevels']) or 'none'
                markers = ','.join(service['markers']) or 'unmarked'
                print(f"  service {service['name']}: runlevels={levels}; OpenRC markers={markers}; health=unverified")
        for finding in item["findings"]:
            print("  " + finding["code"] + ": " + finding["message"])
        if item.get("metadata_error"):
            print("  metadata error: " + item["metadata_error"])
    for finding in report.get("findings", []):
        print(f"{finding['severity']}: {finding['code']}: {finding['message']}")


def retention_report():
    require_controller()
    if command(['git', '-C', REPO, 'status', '--porcelain', '--untracked-files=all']).strip():
        raise UpdateError('retention reporting requires a clean public engine checkout')
    commit = command(['git', '-C', REPO, 'rev-parse', 'HEAD']).strip()
    helper = ['/usr/bin/doas', '/usr/local/sbin/ksa-apply', 'vm-retention-status']

    def read_source():
        try:
            return json.loads(command(helper, timeout=900), object_pairs_hook=unique_object)
        except UpdateError as error:
            raise UpdateError('retention source verification failed; inspect ksa-apply vm-retention-status on the active controller; the installed reader must match the approved engine') from error

    source = read_source()
    report = vm_retention.report(source, optional(STATE / 'current.json'),
                                 [load(path) for path in RETENTION_CATALOGS], commit, now())
    if (read_source() != source
            or command(['git', '-C', REPO, 'rev-parse', 'HEAD']).strip() != commit
            or command(['git', '-C', REPO, 'status', '--porcelain', '--untracked-files=all']).strip()):
        raise UpdateError('retention authority or public source changed during reporting')
    return report


def unmanaged_source_status(box, role):
    """Use the installed root-only dom0 reader from the active controller."""
    if not HOST.fullmatch(box) or role not in vm_no_application.ROLES:
        raise UpdateError('unmanaged source inspection requires one selected shared VM')
    script = 'doas /usr/local/sbin/vm-update-transaction source-status --role ' + role + '\n'
    try:
        response = subprocess.run(['tailscale', 'ssh', 'neo@' + box + '-dom0', 'sh', '-s'],
                                  input=script, text=True, capture_output=True, timeout=210)
    except (OSError, subprocess.TimeoutExpired) as error:
        raise UpdateError('unmanaged Xen source inspection failed') from error
    if response.returncode or not 0 < len(response.stdout) <= 16384:
        raise UpdateError('installed dom0 source reader is unavailable or returned unsafe output')
    try:
        return json.loads(response.stdout, object_pairs_hook=unique_object)
    except (ValueError, TypeError) as error:
        raise UpdateError('installed dom0 source reader returned invalid JSON') from error


def dom0_assignment_status(box, role):
    """Read the protected dom0 selection through its installed validator."""
    if (box, role) not in AUTO_TARGETS:
        raise UpdateError('assignment inspection is limited to selected shared VMs')
    script = 'doas /usr/local/sbin/vm-update-transaction assignment-status --role ' + role + '\n'
    try:
        response = subprocess.run(['tailscale', 'ssh', 'neo@' + box + '-dom0', 'sh', '-s'],
                                  input=script, text=True, capture_output=True, timeout=20)
    except (OSError, subprocess.TimeoutExpired) as error:
        raise UpdateError('protected dom0 assignment reader is unavailable') from error
    if response.returncode or not 0 < len(response.stdout) <= 65536:
        raise UpdateError('protected dom0 assignment reader is unavailable or returned unsafe output')
    try:
        result = json.loads(response.stdout, object_pairs_hook=unique_object)
    except (ValueError, TypeError) as error:
        raise UpdateError('protected dom0 assignment reader returned invalid JSON') from error
    basic = {'kind', 'role', 'managed'}
    common = {'operation_id', 'request_sha256', 'stage', 'selection',
              'release_sha256', 'engine_commit', 'profile'}
    selected = {'vm_uuid', 'boot_configuration', 'disks', 'artifacts', 'autostart',
                'runtime', 'configuration_sha256', 'configuration_drift',
                'autostart_drift'}
    if (not isinstance(result, dict) or result.get('kind') != 'klokast.vm-boot-assignment.v1' or
            result.get('role') != role or type(result.get('managed')) is not bool):
        raise UpdateError('protected dom0 assignment has an invalid contract')
    if result['managed'] is False:
        if set(result) != basic:
            raise UpdateError('unmanaged dom0 assignment contains unexpected fields')
        return result
    stage, choice = result.get('stage'), result.get('selection')
    if not isinstance(stage, str):
        raise UpdateError('protected dom0 assignment has an invalid stage')
    expected_choice = ('accepted' if stage in {'accepted', 'complete'} else
                       'recorded-previous' if stage in {'adopted', 'recovered'} else 'pending')
    if (stage not in {'adopted', 'armed', 'stopping', 'stopped', 'starting', 'booted', 'tested',
                      'recovering', 'accepted', 'complete', 'recovered', 'recovery-failed'} or
            choice != expected_choice or
            set(result) != basic | common | (selected if choice != 'pending' else set()) or
            not isinstance(result.get('operation_id'), str) or
            not re.fullmatch(r'[0-9a-f]{24}', result['operation_id']) or
            not isinstance(result.get('request_sha256'), str) or
            not re.fullmatch(r'[0-9a-f]{64}', result['request_sha256']) or
            not isinstance(result.get('engine_commit'), str) or
            not re.fullmatch(r'[0-9a-f]{40}', result['engine_commit']) or
            (result.get('release_sha256') is not None and
             (not isinstance(result['release_sha256'], str) or
              not re.fullmatch(r'[0-9a-f]{64}', result['release_sha256']))) or
            (result.get('profile') is None) != (result.get('release_sha256') is None) or
            (result.get('profile') is not None and result.get('profile') != 'shared-alpine-v1')):
        raise UpdateError('protected dom0 assignment has an invalid contract')
    if choice != 'pending':
        if (type(result['autostart']) is not bool or
                (not isinstance(result['runtime'], str) or
                 result['runtime'] not in {'running', 'stopped'}) or
                type(result['configuration_drift']) is not bool or
                type(result['autostart_drift']) is not bool or
                not isinstance(result['configuration_sha256'], str) or
                not re.fullmatch(r'[0-9a-f]{64}', result['configuration_sha256']) or
                not isinstance(result['disks'], dict) or
                not isinstance(result['artifacts'], dict) or
                not isinstance(result['boot_configuration'], dict)):
            raise UpdateError('protected dom0 assignment has incomplete selected disk evidence')
    return result


def assignment_summary():
    """Report only selected targets; absent and drifting assignments stay critical."""
    entries, problems = [], []
    for box, role in AUTO_TARGETS:
        host = box + '-' + role
        try:
            entry = dom0_assignment_status(box, role)
        except UpdateError as error:
            entries.append({'host': host, 'status': 'reader-unavailable'})
            problems.append(findings('assignment.reader-unavailable', str(error), 'critical', host))
            continue
        entries.append({'host': host, 'status': 'managed' if entry['managed'] else 'unmanaged',
                        'assignment': entry})
        if not entry['managed']:
            problems.append(findings('assignment.unmanaged', 'Selected VM has no accepted disk assignment.',
                                     'critical', host))
        elif entry['stage'] != 'complete' or entry['release_sha256'] is None:
            problems.append(findings('assignment.incomplete', 'Selected VM has no completed accepted release.',
                                     'critical', host))
        elif (entry['configuration_drift'] or entry['autostart_drift'] or
              entry['runtime'] != 'running'):
            problems.append(findings('assignment.drift', 'Selected VM differs from its accepted boot assignment.',
                                     'critical', host))
    return entries, problems


def adoption_prepare(box, role):
    """Account for one target before requesting destructive or signed approval."""
    controller_status = require_controller()
    if command(['git', '-C', REPO, 'status', '--porcelain', '--untracked-files=all']).strip():
        raise UpdateError('adoption qualification requires a clean public engine checkout')
    commit = command(['git', '-C', REPO, 'rev-parse', 'HEAD']).strip()
    discovery = optional(STATE / 'current.json')
    sources, intent, source_error = None, None, None
    def read_sources():
        values = []
        for name in ('vm-retention-status', 'registry-source-status'):
            values.append(json.loads(command(['/usr/bin/doas', '/usr/local/sbin/ksa-apply', name], timeout=900),
                                     object_pairs_hook=unique_object))
        return values
    try:
        sources = read_sources()
        intent = vm_no_application.source_intent(*sources, [load(p) for p in RETENTION_CATALOGS], box, role)
    except UpdateError:
        # Keep a reviewable refusal report when the installed source reader is
        # unavailable. Do not fall back to private files or observed workload.
        source_error = 'Installed source readers could not establish current no-application intent; check their controller diagnostics.'
    result = vm_no_application.report(discovery, box, role, commit, now(), intent=intent, source_error=source_error)
    observed_configuration = None
    observed_firewall = None
    legacy_comparison = None
    shadow_comparison = None
    source_status = None
    management_receipt = None
    if (intent and intent['eligible'] and result['items'] and
            discovery.get('implementation_commit') == commit):
        host = box + '-' + role
        inventory = json.loads(command(['ansible-inventory', '-i',
                                        REPO / 'ansible/execution-inventory/hosts',
                                        '--host', host]), object_pairs_hook=unique_object)
        expected = vm_config_audit.render(REPO, host, inventory)
        observed_configuration = vm_config_audit.guest_hashes(host)
        comparison = vm_config_audit.report(host, commit, result['report_sha256'],
                                            expected, observed_configuration,
                                            intent['engine_commit'] == commit)
        result = vm_no_application.with_config_comparison(result, comparison)
        firewall_row = next(row for row in comparison['rows'] if row['path'] == '/etc/nftables.nft')
        if not firewall_row['match']:
            observed_firewall = vm_config_audit.guest_firewall_bytes(host)
            if vm_config_audit.sha(observed_firewall) != firewall_row['observed_sha256']:
                raise UpdateError('selected guest firewall changed during the fixed-file comparison')
            legacy_comparison = vm_config_audit.legacy_firewall_report(
                REPO, host, inventory, observed_firewall, result['report_sha256'],
                commit, intent['engine_commit'] == commit)
            result = vm_no_application.with_legacy_firewall(result, comparison, legacy_comparison)
        shadow_row = next((row for row in result['items']
                           if row['area'] == 'package-difference' and row['key'] == '/etc/shadow'), None)
        if (shadow_row and shadow_row['rule'] ==
                'exact old package and locked service accounts; compare admin password hash with checked machine input'):
            fact = next(row['facts'] for row in discovery['hosts'] if row['host'] == host)
            shadow_comparison = vm_config_audit.shadow_input_report(
                REPO, host, inventory, fact['legacy_shadow_file']['neo_hash_sha256'],
                result['report_sha256'], commit, intent['engine_commit'] == commit)
            result = vm_no_application.with_shadow_input(result, shadow_comparison, discovery)
        if intent['engine_commit'] == commit and result['kind'] == 'klokast.vm-no-application-qualification.v4':
            try:
                source_status = unmanaged_source_status(box, role)
                result = vm_no_application.with_source_status(result, source_status, discovery, now())
            except UpdateError:
                source_status = None
                result = dict(result)
                result.pop('report_sha256')
                result['findings'] = [finding for finding in result['findings']
                                      if finding['code'] != 'qualification.unresolved']
                result['findings'].append(findings('qualification.source-unavailable',
                                                    'Installed dom0 source reader or matching guest mount evidence is unavailable.',
                                                    'critical', host))
                result = vm_no_application.finish(result)
        if result['kind'] == 'klokast.vm-no-application-qualification.v5' and result['source_match']:
            try:
                result = vm_no_application.with_identity_status(result, discovery)
            except UpdateError:
                result = dict(result)
                result.pop('report_sha256')
                result['findings'] = [finding for finding in result['findings']
                                      if finding['code'] != 'qualification.unresolved']
                result['findings'].append(findings('qualification.identity-unavailable',
                                                    'The four private machine files lack stable typed-retention evidence.',
                                                    'critical', host))
                result = vm_no_application.finish(result)
    if (sources is not None and read_sources() != sources or
            optional(STATE / 'current.json') != discovery or
            command(['git', '-C', REPO, 'rev-parse', 'HEAD']).strip() != commit or
            command(['git', '-C', REPO, 'status', '--porcelain', '--untracked-files=all']).strip()):
        raise UpdateError('qualification source, discovery, authority, or implementation changed during preparation')
    if observed_configuration is not None and vm_config_audit.guest_hashes(host) != observed_configuration:
        raise UpdateError('selected guest configuration changed during qualification')
    if observed_firewall is not None and vm_config_audit.guest_firewall_bytes(host) != observed_firewall:
        raise UpdateError('selected guest firewall changed during historical source comparison')
    if source_status is not None:
        current_source = unmanaged_source_status(box, role)
        if {k: v for k, v in current_source.items() if k != 'observed_at'} != {
                k: v for k, v in source_status.items() if k != 'observed_at'}:
            raise UpdateError('unmanaged Xen source changed during qualification')
    if result['kind'] == 'klokast.vm-no-application-qualification.v6' and result['summary']['unresolved'] == 0:
        management_receipt = {'kind': 'klokast.vm-independent-management.v1',
                              'host': host, 'dom0': box + '-dom0',
                              'controller': controller_status['hostname'],
                              'guest_transport': 'controller-tailnet-ssh',
                              'dom0_transport': 'controller-tailnet-ssh',
                              'configuration_evidence_sha256': comparison['report_sha256'],
                              'source_evidence_sha256': digest(source_status),
                              'observed_at': timestamp(now()), 'authority': 'comparison-only'}
        management_receipt['report_sha256'] = digest(management_receipt)
        result = vm_no_application.with_management_paths(
            result, management_receipt, comparison, source_status, now())
    if observed_configuration is not None:
        comparison_dir = STATE / 'config-audits'
        comparison_dir.mkdir(mode=0o700, exist_ok=True)
        comparison_record = comparison_dir / (comparison['report_sha256'] + '.json')
        if comparison_record.exists():
            if load(comparison_record) != comparison:
                raise UpdateError('configuration comparison conflicts with existing evidence')
        else:
            write(comparison_record, comparison)
        if legacy_comparison is not None:
            legacy_record = comparison_dir / (legacy_comparison['report_sha256'] + '.json')
            if legacy_record.exists():
                if load(legacy_record) != legacy_comparison:
                    raise UpdateError('historical firewall comparison conflicts with existing evidence')
            else:
                write(legacy_record, legacy_comparison)
        if shadow_comparison is not None:
            shadow_record = comparison_dir / (shadow_comparison['report_sha256'] + '.json')
            if shadow_record.exists():
                if load(shadow_record) != shadow_comparison:
                    raise UpdateError('shadow comparison conflicts with existing evidence')
            else:
                write(shadow_record, shadow_comparison)
    if source_status is not None:
        source_dir = STATE / 'source-audits'
        source_dir.mkdir(mode=0o700, exist_ok=True)
        source_record = source_dir / (digest(source_status) + '.json')
        if source_record.exists():
            if load(source_record) != source_status:
                raise UpdateError('unmanaged Xen source receipt conflicts with existing evidence')
        else:
            write(source_record, source_status)
    if management_receipt is not None:
        management_dir = STATE / 'management-audits'
        management_dir.mkdir(mode=0o700, exist_ok=True)
        management_record = management_dir / (management_receipt['report_sha256'] + '.json')
        if management_record.exists():
            if load(management_record) != management_receipt:
                raise UpdateError('independent management receipt conflicts with existing evidence')
        else:
            write(management_record, management_receipt)
    destination = STATE / 'qualifications'
    destination.mkdir(mode=0o700, exist_ok=True)
    record = destination / (result['report_sha256'] + '.json')
    if record.exists():
        if load(record) != result:
            raise UpdateError('qualification record conflicts with existing evidence')
    else:
        write(record, result)
    return result, record


def main(argv=None):
    parser = argparse.ArgumentParser(description=__doc__)
    sub = parser.add_subparsers(dest="command", required=True)
    scan_parser = sub.add_parser("scan", help="collect all VM facts and official Alpine metadata")
    scan_parser.add_argument("--existing-map", action="store_true", help="use a fresh controller map; still collect new VM facts")
    for name in ("status", "verify"):
        sub.add_parser(name, help="report current evidence and overdue work" if name == "status" else "check discovery coverage; accepted-release verification is not installed")
    for command_parser in (scan_parser, *[sub.choices[n] for n in ("status", "verify")]):
        command_parser.add_argument("--json", action="store_true")
    retention_parser = sub.add_parser('retention', help='compare checked Instance retention with recent storage discovery; no adoption')
    retention_parser.add_argument('--json', action='store_true')
    adopt_parser = sub.add_parser('adopt', help='qualify one no-application target before signed adoption')
    adoption = adopt_parser.add_subparsers(dest='action', required=True)
    adopt_prepare = adoption.add_parser('prepare', help='write exact classification and cleanup evidence; unresolved items block an intent')
    adopt_prepare.add_argument('--box', required=True)
    adopt_prepare.add_argument('--role', choices=vm_no_application.ROLES, required=True)
    adopt_prepare.add_argument('--json', action='store_true')
    adopt_prepare.add_argument('--qualification-only', action='store_true',
                               help='write only the fresh qualification for the root adoption executor')
    adopt_apply = adoption.add_parser('apply', help='execute the exact signed old-generation adoption intent')
    adopt_apply.add_argument('--approval-intent', required=True)
    adopt_apply.add_argument('--approval-signature', required=True)
    adopt_apply.add_argument('--signer-id', required=True)
    adopt_reconcile = adoption.add_parser('reconcile', help='record an already adopted dom0 generation after controller interruption')
    adopt_reconcile.add_argument('--nonce', required=True)
    policy_parser = sub.add_parser("policy", help="prepare, activate, or validate the signed standing policy")
    policy_parser.add_argument("action", choices=("prepare", "activate", "status"))
    evidence_names = ("plan", "authority-state", "controller-toolchain-receipt", "source-recovery-receipt", "instance-source-receipt", "observation", "build-dir")
    for name in (*evidence_names, "approval-intent", "approval-signature", "signer-id"):
        policy_parser.add_argument("--" + name)
    sub.add_parser("pause", help="restrict scheduled VM mutations without expanding authority")
    sub.add_parser("resume", help="revalidate the standing policy before removing the local pause")
    prepare_parser = sub.add_parser("prepare", help="construct an isolated candidate; does not accept or deploy it")
    prepare_mode = prepare_parser.add_mutually_exclusive_group(required=True)
    prepare_mode.add_argument("--box", help="box on which to build an explicitly selected candidate")
    prepare_mode.add_argument("--auto", action="store_true", help="select the adjacent stable branch under the signed policy")
    prepare_parser.add_argument("--branch", help="explicit stable Alpine branch, for example v3.24")
    prepare_parser.add_argument("--inputs-only", action="store_true", help="verify packages and assemble boot files without starting Xen")
    prepare_parser.add_argument('--test-app', choices=('static-site-web',),
                                help='test an unchanged catalog image on synthetic data in the networkless test VM')
    args = parser.parse_args(argv)
    os.umask(0o077)
    try:
        os.environ["ANSIBLE_CONFIG"] = str(REPO / "ansible/ansible.cfg")
        os.environ["ANSIBLE_CACHE_PLUGIN"] = "memory"
        if args.command == 'adopt':
            if args.action == 'reconcile':
                require_controller()
                return subprocess.run(['/usr/bin/doas', '/usr/local/sbin/ksa-apply',
                                       'vm-update-adoption', 'reconcile', '--nonce', args.nonce],
                                      stdin=subprocess.DEVNULL, timeout=900).returncode
            if args.action == 'apply':
                require_controller()
                supplied = load(Path(args.approval_intent))
                if supplied.get('kind') != 'klokast.vm-adoption-intent.v1':
                    raise UpdateError('adopt apply accepts only a signed VM adoption intent')
                return subprocess.run(['/usr/bin/doas', '/usr/local/sbin/ksa-apply', 'execute',
                                       '--approval-intent', args.approval_intent,
                                       '--approval-signature', args.approval_signature,
                                       '--signer-id', args.signer_id],
                                      stdin=subprocess.DEVNULL, timeout=2100).returncode
            result, record = adoption_prepare(args.box, args.role)
            intent = None
            intent_path = None
            if result['kind'] == 'klokast.vm-no-application-qualification.v7' and not args.qualification_only:
                prepared = subprocess.run(['/usr/bin/doas', '/usr/local/sbin/ksa-apply',
                                           'vm-update-adoption', 'prepare', '--qualification', str(record)],
                                          stdin=subprocess.DEVNULL, capture_output=True, text=True, timeout=900)
                if prepared.returncode:
                    raise UpdateError('signed adoption preparation failed: ' + prepared.stderr[-2048:].strip())
                intent = json.loads(prepared.stdout, object_pairs_hook=unique_object)
                if (not isinstance(intent, dict) or intent.get('kind') != 'klokast.vm-adoption-intent.v1' or
                        intent.get('qualification_sha256') != result['report_sha256'] or
                        intent.get('box') != args.box or intent.get('role') != args.role or
                        not isinstance(intent.get('nonce'), str) or
                        not re.fullmatch(r'[A-Za-z0-9_-]{12,128}', intent['nonce'])):
                    raise UpdateError('root adoption preflight did not bind the selected qualification')
                destination = STATE / 'adoption-intents'
                destination.mkdir(mode=0o700, exist_ok=True)
                intent_path = destination / (intent['nonce'] + '.json')
                if intent_path.exists():
                    if load(intent_path) != intent:
                        raise UpdateError('existing adoption intent conflicts with root preflight')
                else:
                    write(intent_path, intent)
            if args.json:
                print(canonical(result if args.qualification_only or intent is None else
                                {'qualification': result, 'adoption_intent': intent,
                                 'intent_path': str(intent_path)}))
            else:
                state = ('classification complete; signed adoption intent prepared'
                         if intent is not None else
                         'classification complete; signed adoption intent unavailable'
                         if result['classification_complete'] else
                         'no-application qualification blocked; adoption intent unavailable')
                print(f"{args.box}-{args.role}: {state}")
                print(f"Classification: {result['summary']['items']} items; {result['summary']['unresolved']} unresolved; {result['summary']['cleanup_items']} cleanup items")
                print('Report: ' + str(record))
                if intent_path:
                    print('Intent: ' + str(intent_path))
                for finding in result['findings']:
                    print(finding['code'] + ': ' + finding['message'])
            return 0 if intent is not None else (1 if not result['qualified'] else 0)
        if args.command == 'retention':
            report = retention_report()
            if args.json:
                print(canonical(report))
            else:
                print('Retention evidence; adoption is not authorized.')
                for item in report['datasets']:
                    print(f"{item['box']}/{item['app']}/{item['dataset']}: {item['status']} (app {item['desired_state']})")
                for finding in report['findings']:
                    print(f"{finding['severity']}: {finding['code']}: {finding['message']}")
            return 1 if any(v['severity'] == 'critical' for v in report['findings']) else 0
        if args.command == "prepare":
            if args.auto:
                if args.branch or args.inputs_only or args.test_app:
                    raise UpdateError('automatic preparation accepts no caller-selected branch or test options')
                result = prepare_auto()
            else:
                if not args.branch:
                    raise UpdateError('explicit preparation requires --branch')
                result = prepare(args.box, args.branch, args.inputs_only, args.test_app)
            print(canonical(result))
            return 0
        if args.command in {"policy", "pause", "resume"}:
            require_controller()
            helper = ["/usr/bin/doas", "/usr/local/sbin/ksa-apply"]
            if args.command in {"pause", "resume"}:
                helper += ["vm-update-policy", args.command]
            elif args.action == "activate":
                if any(getattr(args, name.replace("-", "_")) for name in evidence_names):
                    raise UpdateError("activation accepts only the prepared signed intent")
                helper += ["execute"]
                for name in ("approval-intent", "approval-signature", "signer-id"):
                    value = getattr(args, name.replace("-", "_"))
                    if not value:
                        raise UpdateError("activation requires the intent, signature, and signer ID")
                    helper += ["--" + name, value]
            else:
                if any(getattr(args, name) for name in ("approval_intent", "approval_signature", "signer_id")):
                    raise UpdateError("policy preparation and status do not accept signature inputs")
                helper += ["vm-update-policy", args.action]
                for name in evidence_names:
                    value = getattr(args, name.replace("-", "_"))
                    if args.action == "prepare":
                        if not value:
                            raise UpdateError("policy preparation requires complete fresh Plan v8 evidence")
                        helper += ["--" + name, value]
                    elif value:
                        raise UpdateError("policy status accepts no caller-selected evidence")
            # Keep root boundary errors visible, without routing them into an
            # unprivileged scan log. The root executor supplies bounded output.
            return subprocess.run(helper, stdin=subprocess.DEVNULL, timeout=900).returncode
        if args.command == "scan":
            report = scan(not args.existing_map)
        else:
            require_controller()
            report = optional(STATE / "current.json")
            verification = optional(STATE / "verification.json")
            policy, policy_findings = policy_summary()
            assignments, assignment_findings = assignment_summary()
            if args.command == "verify":
                # Do not claim a successful release check from a recent scan.
                verification = {"kind": "klokast.vm-update-verification.v1", "generated_at": timestamp(now()),
                                "verified": False, "assignments": assignments,
                                "findings": [findings("release.unverified", "Accepted release records and package verification are not installed.", "critical"),
                                             *policy_findings, *assignment_findings]}
                write(STATE / "verification.json", verification)
            current_findings = health(report, verification, now(),
                                      selected_hosts={box + '-' + role for box, role in AUTO_TARGETS})
            if args.command == 'status':
                current_findings.extend(policy_findings)
                current_findings.extend(assignment_findings)
            inventory = []
            if isinstance(report, dict):
                for host in report.get('hosts', []):
                    inventory.append({'host': host.get('host'), 'profile': host.get('profile'),
                                      'branch': host.get('branch'),
                                      'runtime': host.get('target', {}).get('runtime'),
                                      'update_status': host.get('update_status')})
            report = {"kind": "klokast.vm-update-status.v1", "generated_at": timestamp(now()),
                      "hosts": [], "inventory": inventory,
                      "policy": policy, "assignments": assignments,
                      "findings": current_findings}
        display(report, args.json)
        return 1 if any(v["severity"] == "critical" for v in report["findings"] + [f for h in report.get("hosts", []) for f in h["findings"]]) else 0
    except (UpdateError, RuntimeError, OSError, ValueError, TypeError, KeyError) as error:
        print("platform-update: " + str(error), file=sys.stderr)
        return 2


if __name__ == "__main__":
    raise SystemExit(main())
