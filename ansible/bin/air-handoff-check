#!/usr/bin/env python3
"""Authorize a declared runner handoff under existing development authority."""
import argparse
import json
from pathlib import Path
import re
import sys
import uuid

REPO=Path(__file__).resolve().parents[2]
sys.path.insert(0,str(REPO/'ansible/lib'))
import air_maintenance
import platform_resource_runtime as runtime
import platform_source as source


def main():
    parser=argparse.ArgumentParser(description=__doc__)
    parser.add_argument('--from',dest='origin',required=True)
    parser.add_argument('--to',dest='destination',required=True)
    parser.add_argument('--session',required=True)
    args=parser.parse_args()
    try:
        source.require_controller()
        if str(uuid.UUID(args.session))!=args.session:raise RuntimeError('invalid discussion UUID')
        if args.origin==args.destination:raise RuntimeError('handoff needs two different runners')
        for box in (args.origin,args.destination):
            if not re.fullmatch('[a-z][a-z0-9-]{0,30}',box):raise RuntimeError('invalid runner box')
        with runtime.vm_update_installation_lock():
            declared=source.snapshot()['instance']['airunners']
            if any(box+'-air' not in declared for box in (args.origin,args.destination)):
                raise RuntimeError('both handoff runners must be declared in current Instance')
            value=air_maintenance.remote(args.destination,'status')
            if not value['available'] or value['maintenance']:
                raise RuntimeError('destination runner is unavailable or in maintenance')
        print(json.dumps({'authorized':True,'from':args.origin,'to':args.destination,'session':args.session}))
        return 0
    except (RuntimeError,ValueError,OSError,KeyError) as error:
        print('handoff preflight: '+str(error),file=sys.stderr);return 1


if __name__=='__main__':raise SystemExit(main())
