#!/usr/bin/env python3
"""Report Tailnet paths of one box that use a DERP relay but should be direct.

Hosts with public IPv6 (dom0, router, ops) need a direct path from the
controller. Guests behind the router need a direct path from their same-box
ops, which the remote controller uses as its SSH hop. Read-only.
"""
import argparse
import concurrent.futures
import json
import re
import socket
import subprocess
import sys

PUBLIC = ('dom0', 'router', 'ops')
# Keep equal to the groups that set platform_same_box_hop in inventory-policy.
GUESTS = ('air', 'bak', 'dmz', 'iot', 'vpn-egress')
PINGS = '20'
PING_SCRIPT = r'''set -u
for host do
  out=$(tailscale ping -c ''' + PINGS + r''' --timeout 2s "$host" 2>&1)
  rc=$?
  printf '%s\t%s\t%s\n' "$host" "$rc" "$(printf '%s\n' "$out" | tail -n 1)"
done
'''


class PathError(Exception):
    pass


def classify(rc, line):
    """Return the path kind from the last line of `tailscale ping --until-direct`."""
    via = re.search(r' via (\S+) in (\S+)$', line)
    if rc == 0 and via and not via.group(1).startswith(('DERP(', 'peer-relay')):
        return 'direct', via.group(1) + ' ' + via.group(2)
    if 'direct connection not established' in line:
        return 'relayed', 'no direct path after ' + PINGS + ' pings'
    return 'failed', line.strip()[:200] or 'tailscale ping exit status ' + str(rc)


def ping(host):
    try:
        result = subprocess.run(['tailscale', 'ping', '-c', PINGS, '--timeout', '2s', host],
                                capture_output=True, text=True, timeout=120, check=False)
    except (OSError, subprocess.TimeoutExpired) as error:
        return 'failed', str(error)
    lines = (result.stdout + result.stderr).strip().splitlines()
    return classify(result.returncode, lines[-1] if lines else '')


def remote_pings(hop, hosts):
    try:
        result = subprocess.run(['tailscale', 'ssh', 'smith@' + hop, 'sh', '-s', '--', *hosts], input=PING_SCRIPT, capture_output=True,
                                text=True, timeout=60 + 45 * len(hosts), check=False)
    except (OSError, subprocess.TimeoutExpired) as error:
        raise PathError('cannot run the path check on ' + hop + ': ' + str(error)) from error
    if result.returncode != 0:
        raise PathError('the path check on ' + hop + ' failed: ' + result.stderr.strip()[:300])
    found = {}
    for row in result.stdout.splitlines():
        host, rc, line = (row.split('\t', 2) + ['', ''])[:3]
        if host in hosts and rc.isdigit():
            found[host] = classify(int(rc), line)
    return {host: found.get(host, ('failed', 'no result from ' + hop)) for host in hosts}


def machines(box, status):
    found = {}
    for peer in (status.get('Peer') or {}).values():
        name = (peer.get('DNSName') or '').split('.')[0]
        role = name[len(box) + 1:] if name.startswith(box + '-') else ''
        if role in PUBLIC + GUESTS:
            found[name] = {'role': role, 'online': peer.get('Online') is True}
    return found


def check(box):
    local = socket.gethostname().split('.')[0]
    if not local.endswith('-ops'):
        raise PathError('run this check on a controller; this host is ' + local)
    try:
        status = json.loads(subprocess.run(['tailscale', 'status', '--json'], capture_output=True,
                                           text=True, timeout=15, check=True).stdout)
    except (OSError, ValueError, subprocess.SubprocessError) as error:
        raise PathError('cannot read the Tailscale status: ' + str(error)) from error
    hop = box + '-ops'
    found = machines(box, status)
    if not found:
        raise PathError('no Tailnet machine of box ' + box + ' is in the network map')
    results = []
    local_targets, hop_targets = [], []
    for name, machine in sorted(found.items()):
        if not machine['online']:
            results.append({'host': name, 'from': local, 'path': 'offline', 'detail': 'skipped'})
        elif machine['role'] in GUESTS and local != hop:
            hop_targets.append(name)
        else:
            local_targets.append(name)
    with concurrent.futures.ThreadPoolExecutor(max_workers=8) as pool:
        for name, (path, detail) in zip(local_targets, pool.map(ping, local_targets)):
            results.append({'host': name, 'from': local, 'path': path, 'detail': detail})
    if hop_targets:
        if not found.get(hop, {}).get('online'):
            for name in hop_targets:
                results.append({'host': name, 'from': hop, 'path': 'failed',
                                'detail': hop + ' is not online; the controller hop is unavailable'})
        else:
            try:
                remote = remote_pings(hop, hop_targets)
            except PathError as error:
                remote = {name: ('failed', str(error)) for name in hop_targets}
            for name in hop_targets:
                path, detail = remote[name]
                results.append({'host': name, 'from': hop, 'path': path, 'detail': detail})
    return sorted(results, key=lambda item: item['host'])


def main(argv=None):
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument('--box', required=True)
    parser.add_argument('--json', action='store_true')
    args = parser.parse_args(argv)
    if not re.fullmatch(r'[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?', args.box):
        print('platform-tailnet-paths: --box must be a box name such as k001', file=sys.stderr)
        return 2
    try:
        results = check(args.box)
    except PathError as error:
        print('platform-tailnet-paths: ' + str(error), file=sys.stderr)
        return 2
    problems = [item for item in results if item['path'] in ('relayed', 'failed')]
    if args.json:
        print(json.dumps({'box': args.box, 'paths': results, 'problems': len(problems)}, indent=2, sort_keys=True))
    else:
        for item in results:
            print(f"{item['path']:8} {item['from']} -> {item['host']}: {item['detail']}")
        for item in problems:
            print(f"platform-tailnet-paths: {item['from']} -> {item['host']} is {item['path']}; "
                  'expected a direct path; see doc/architecture.md#overlay-management-plane', file=sys.stderr)
    return 1 if problems else 0


if __name__ == '__main__':
    raise SystemExit(main())
