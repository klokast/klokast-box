#!/usr/bin/env python3
import argparse
import hashlib
import re
from pathlib import Path


ROLE_SUFFIXES = (
    "bootstrap",
    "dom0",
    "router",
    "bak",
    "dmz",
    "iot",
    "usr",
    "ops",
    "agent",
    "agt",
)


def parse_args():
    parser = argparse.ArgumentParser(
        description="Render a temporary Ansible inventory for one Klokast box."
    )
    parser.add_argument("--node", required=True, help="Box short name, for example boxa")
    parser.add_argument(
        "--output",
        required=True,
        help="Inventory file to write. Parent directories are created.",
    )
    parser.add_argument(
        "--magicdns-suffix",
        default="example.ts.net",
        help="Tailscale MagicDNS suffix. Default: example.ts.net",
    )
    parser.add_argument(
        "--target-disk-device",
        default="/dev/nvme0n1",
        help="Bootstrap SSD device used for the destructive install gate.",
    )
    parser.add_argument(
        "--dom0-bridge-port",
        action="append",
        default=[],
        metavar="BRIDGE=IFACE[,IFACE]",
        help=(
            "Attach physical dom0 IFACE names to a generated bridge key such "
            "as iot=eth3. May be passed more than once."
        ),
    )
    return parser.parse_args()


def validate_node_name(node):
    if not re.fullmatch(r"[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?", node):
        raise SystemExit(
            "error: --node must be a lowercase DNS label: letters, digits, "
            "hyphens, and no leading/trailing hyphen"
        )

    for suffix in ROLE_SUFFIXES:
        if node == suffix or node.endswith(f"-{suffix}"):
            raise SystemExit(
                f"error: --node must be the box name only, not a role hostname ending in -{suffix}"
            )


def group_prefix(node):
    return re.sub(r"[^A-Za-z0-9_]", "_", node)


IFACE_RE = re.compile(r"[A-Za-z0-9_.:-]{1,32}")


def parse_dom0_bridge_ports(values):
    ports = {}
    for raw in values:
        if "=" not in raw:
            raise SystemExit("error: --dom0-bridge-port must use BRIDGE=IFACE[,IFACE]")
        bridge, raw_ports = raw.split("=", 1)
        if not re.fullmatch(r"[a-z][a-z0-9-]{0,63}", bridge):
            raise SystemExit(f"error: invalid dom0 bridge key: {bridge}")
        parsed_ports = [item.strip() for item in raw_ports.split(",") if item.strip()]
        if not parsed_ports:
            raise SystemExit(f"error: no interfaces supplied for bridge {bridge}")
        for port in parsed_ports:
            if not IFACE_RE.fullmatch(port):
                raise SystemExit(f"error: invalid interface for bridge {bridge}: {port}")
        ports.setdefault(bridge, [])
        for port in parsed_ports:
            if port not in ports[bridge]:
                ports[bridge].append(port)
    return ports


def render_dom0_bridge_ports_yaml(ports):
    if not ports:
        return ""
    lines = ["          dom0_bridge_physical_ports:"]
    for bridge in sorted(ports):
        lines.append(f"            {bridge}:")
        for port in ports[bridge]:
            lines.append(f"              - {port}")
    return "\n".join(lines) + "\n"


def render_inventory(node, suffix, target_disk, dom0_bridge_ports=None):
    prefix = group_prefix(node)
    mac_octet = hashlib.sha1(node.encode("utf-8")).hexdigest()[:2]
    dom0_bridge_ports_yaml = render_dom0_bridge_ports_yaml(dom0_bridge_ports or {})

    return f"""---
# Generated by ansible/bin/render-node-inventory. Do not commit this file.
all:
  vars:
    platform_magicdns_suffix: {suffix}
  children:
    bootstrap:
      children:
        {prefix}_bootstrap: {{}}
    dom0:
      children:
        {prefix}_dom0: {{}}
    vm_dom0:
      children:
        {prefix}_dom0: {{}}
    router:
      children:
        {prefix}_router: {{}}
    backend:
      children:
        {prefix}_backend: {{}}
    dmz:
      children:
        {prefix}_dmz: {{}}
    iot:
      children:
        {prefix}_iot: {{}}
    usr:
      children: {{}}
    ops:
      children:
        {prefix}_ops: {{}}
    control_vms:
      children:
        ops: {{}}
    podman_vms:
      children:
        backend: {{}}
        dmz: {{}}
        iot: {{}}
        usr: {{}}
    {prefix}:
      children:
        {prefix}_bootstrap: {{}}
        {prefix}_dom0: {{}}
        {prefix}_router: {{}}
        {prefix}_backend: {{}}
        {prefix}_dmz: {{}}
        {prefix}_iot: {{}}
        {prefix}_ops: {{}}
    {prefix}_bootstrap:
      hosts:
        {node}-bootstrap:
          node_name: {node}
          node_domain_role: dom0
          node_hostname: {node}-dom0
          ansible_host: "{{{{ bootstrap_tailscale_hostname }}}}.{suffix}"
          ansible_ssh_common_args: >-
            -o StrictHostKeyChecking=accept-new
            -o UserKnownHostsFile={{{{ bootstrap_known_hosts_file }}}}
          ansible_python_interpreter: /usr/bin/python3
          target_disk_device: {target_disk}
    {prefix}_dom0:
      hosts:
        {node}-dom0:
          node_name: {node}
          node_domain_role: dom0
          node_xen_mac_octet: "{mac_octet}"
{dom0_bridge_ports_yaml if dom0_bridge_ports_yaml else ""}
    {prefix}_router:
      hosts:
        {node}-router:
          node_name: {node}
    {prefix}_backend:
      hosts:
        {node}-bak:
          node_name: {node}
    {prefix}_dmz:
      hosts:
        {node}-dmz:
          node_name: {node}
    {prefix}_iot:
      hosts:
        {node}-iot:
          node_name: {node}
    {prefix}_ops:
      hosts:
        {node}-ops:
          node_name: {node}
"""


def main():
    args = parse_args()
    validate_node_name(args.node)
    dom0_bridge_ports = parse_dom0_bridge_ports(args.dom0_bridge_port)
    output = Path(args.output)
    output.parent.mkdir(parents=True, exist_ok=True)
    output.write_text(
        render_inventory(
            args.node,
            args.magicdns_suffix,
            args.target_disk_device,
            dom0_bridge_ports,
        ),
        encoding="utf-8",
    )


if __name__ == "__main__":
    main()
