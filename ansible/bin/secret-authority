#!/usr/bin/env python3
import os
import subprocess
import sys
from pathlib import Path


REPO_ROOT = Path(__file__).resolve().parents[2]
SOURCE_WRAPPER = REPO_ROOT / "klokast-ops" / "secret-authority" / "bin" / "ksa-static-site"
SOURCE_INSTANCE_WRAPPER = REPO_ROOT / "klokast-ops" / "secret-authority" / "bin" / "ksa-instance"
INSTALLED_WRAPPER = os.environ.get("KLOKAST_SECRET_AUTHORITY_WRAPPER", "/usr/local/sbin/ksa-static-site")
INSTALLED_INSTANCE_WRAPPER = os.environ.get(
    "KLOKAST_INSTANCE_SECRET_AUTHORITY_WRAPPER",
    "/usr/local/sbin/ksa-instance",
)


def usage():
    print(
        """Usage:
  ansible/bin/secret-authority intent static-site ACTION [OPTIONS]
  ansible/bin/secret-authority intent instance ACTION [OPTIONS]
  ansible/bin/secret-authority static-site ACTION [OPTIONS]
  ansible/bin/secret-authority instance ACTION [OPTIONS]
  ansible/bin/secret-authority source ACTION [OPTIONS]

Examples:
  ansible/bin/secret-authority intent static-site install --box boxa --domain www.klokast.ai --resources-registry ~/private/klokast/platform-resources.yml
  ansible/bin/secret-authority intent instance register-repository --repo-owner FAMILY --repo-name klokast-instance --engine-commit COMMIT
  ansible/bin/secret-authority static-site install --box boxa --domain www.klokast.ai --resources-registry ~/private/klokast/platform-resources.yml --approval-intent intent.json --approval-signature intent.sig --signer-id human-static-site
""",
        end="",
    )


def main(argv):
    if not argv or argv[0] in {"-h", "--help", "help"}:
        usage()
        return 0
    if argv[0] == "intent":
        if len(argv) > 1 and argv[1] == "instance":
            command = [sys.executable, str(SOURCE_INSTANCE_WRAPPER), "--repo-root", str(REPO_ROOT), *argv]
        else:
            command = [sys.executable, str(SOURCE_WRAPPER), "--repo-root", str(REPO_ROOT), *argv]
        return subprocess.run(command, check=False).returncode
    if argv[0] in {"instance", "source"}:
        command = ["sudo", "-n", INSTALLED_INSTANCE_WRAPPER, "--repo-root", str(REPO_ROOT), *argv]
    else:
        command = ["sudo", "-n", INSTALLED_WRAPPER, "--repo-root", str(REPO_ROOT), *argv]
    return subprocess.run(command, check=False).returncode


if __name__ == "__main__":
    raise SystemExit(main(sys.argv[1:]))
