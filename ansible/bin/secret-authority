#!/usr/bin/env python3
import os
import subprocess
import sys
from pathlib import Path


REPO_ROOT = Path(__file__).resolve().parents[2]
SOURCE_WRAPPER = REPO_ROOT / "klokast-ops" / "secret-authority" / "bin" / "ksa-static-site"
SOURCE_CLOUDFLARE_WRAPPER = REPO_ROOT / "klokast-ops" / "secret-authority" / "bin" / "ksa-cloudflare"
INSTALLED_WRAPPER = os.environ.get("KLOKAST_SECRET_AUTHORITY_WRAPPER", "/usr/local/sbin/ksa-static-site")
INSTALLED_CLOUDFLARE_WRAPPER = os.environ.get(
    "KLOKAST_CLOUDFLARE_SECRET_AUTHORITY_WRAPPER",
    "/usr/local/sbin/ksa-cloudflare",
)


def usage():
    print(
        """Usage:
  ansible/bin/secret-authority intent static-site ACTION [OPTIONS]
  ansible/bin/secret-authority intent cloudflare ACTION [OPTIONS]
  ansible/bin/secret-authority static-site ACTION [OPTIONS]
  ansible/bin/secret-authority cloudflare ACTION [OPTIONS]

Examples:
  ansible/bin/secret-authority intent static-site install --box k001 --domain www.klokast.ai --resources-registry ~/private/klokast/platform-resources.yml
  ansible/bin/secret-authority intent cloudflare static-site-tunnel --box k001 --domain www.klokast.ai --guardian k001-dom0 --cloudflare-account-id ACCOUNT --cloudflare-zone-id ZONE
  ansible/bin/secret-authority static-site install --box k001 --domain www.klokast.ai --resources-registry ~/private/klokast/platform-resources.yml --approval-intent intent.json --approval-signature intent.sig --signer-id human
  ansible/bin/secret-authority cloudflare static-site-tunnel --box k001 --domain www.klokast.ai --guardian k001-dom0 --cloudflare-account-id ACCOUNT --cloudflare-zone-id ZONE --approval-intent intent.json --approval-signature intent.sig --signer-id human
""",
        end="",
    )


def main(argv):
    if not argv or argv[0] in {"-h", "--help", "help"}:
        usage()
        return 0
    if argv[0] == "intent":
        if len(argv) > 1 and argv[1] == "cloudflare":
            command = [sys.executable, str(SOURCE_CLOUDFLARE_WRAPPER), "--repo-root", str(REPO_ROOT), *argv]
        else:
            command = [sys.executable, str(SOURCE_WRAPPER), "--repo-root", str(REPO_ROOT), *argv]
        return subprocess.run(command, check=False).returncode
    if argv[0] == "cloudflare":
        command = ["sudo", "-n", INSTALLED_CLOUDFLARE_WRAPPER, "--repo-root", str(REPO_ROOT), *argv]
    else:
        command = ["sudo", "-n", INSTALLED_WRAPPER, "--repo-root", str(REPO_ROOT), *argv]
    return subprocess.run(command, check=False).returncode


if __name__ == "__main__":
    raise SystemExit(main(sys.argv[1:]))
