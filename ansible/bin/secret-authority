#!/usr/bin/env python3
"""Invoke installed credential brokers on the active development controller."""
import argparse
import subprocess


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument('broker', choices=('static-site', 'instance-key', 'air-git'))
    args, remainder = parser.parse_known_args()
    if args.broker == 'static-site':
        command = ['/usr/bin/doas', '/usr/local/sbin/ksa-static-site', 'static-site', *remainder]
    elif args.broker == 'instance-key':
        command = ['/usr/bin/doas', '/usr/local/sbin/ksa-instance-key', *remainder]
    else:
        command = ['/usr/bin/doas', '/usr/local/sbin/ksa-air-git', *remainder]
    return subprocess.run(command, check=False).returncode


if __name__ == '__main__': raise SystemExit(main())
