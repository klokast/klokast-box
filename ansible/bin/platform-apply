#!/usr/bin/env python3
"""Reconcile authorized Instance state through existing development automation."""
import argparse
import datetime as dt
import json
import os
from pathlib import Path
import stat
import subprocess
import sys
sys.path.insert(0, str(Path('/usr/local/lib/klokast') if Path('/usr/local/lib/klokast/platform_source.py').is_file()
                       else Path(__file__).resolve().parents[1] / 'lib'))
import platform_source as source


def prepare(args, view):
    instance = view['instance']
    if args.box and args.box not in instance['boxes']: raise source.SourceError('target box is not declared in Instance')
    if args.operation not in ('network', 'guests'):
        raise source.SourceError('supported operations are network and guests; use application-owned instructions for app operations')
    if not args.box: raise source.SourceError('network and guests require one --box')
    command = [source.REPO / 'ansible/bin/platform-resources', '--box', args.box,
               '--magicdns-suffix', instance['tailscale']['tailnet-dns-name']]
    if args.operation == 'guests':
        if args.role: command += ['--shared-guest-role', args.role]
        command += ['apply-shared-guests']
    else:
        if args.role: raise source.SourceError('network does not accept --role')
        command += ['apply-box-access']
    return ([command] if args.operation == 'guests' else
            [['/usr/bin/doas', '/usr/local/sbin/platform-maintenance', 'network'], command])


def main(argv=None):
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument('operation', choices=('network', 'guests'))
    parser.add_argument('--box')
    parser.add_argument('--role', choices=('bak', 'dmz', 'iot'))
    parser.add_argument('--dry-run', action='store_true')
    parser.add_argument('--json', action='store_true')
    args = parser.parse_args(argv)
    outcome = 'failed'
    try:
        if os.geteuid() == 0: raise source.SourceError('run platform-apply as smith')
        view = source.snapshot()
        commands = prepare(args, view)
        if args.dry_run:
            result = {'dry_run': True, 'operation': args.operation, 'instance_sha256': view['instance_sha256'],
                      'commands': [[str(v) for v in command] for command in commands]}
        else:
            audit_path = Path('/var/lib/klokast/apply/audit.jsonl')
            audit_fd = os.open(audit_path, os.O_WRONLY | os.O_APPEND | os.O_CREAT | os.O_NOFOLLOW, 0o600)
            try:
                info = os.fstat(audit_fd)
                if not stat.S_ISREG(info.st_mode) or info.st_uid != os.geteuid() or info.st_mode & 0o077:
                    raise source.SourceError("Apply audit file is unsafe")
            finally:
                os.close(audit_fd)
            for command in commands:
                current = source.snapshot()
                if current['instance_sha256'] != view['instance_sha256'] or current['implementation'] != view['implementation']: raise source.SourceError('Instance changed before execution; retry Apply')
                completed = subprocess.run([str(v) for v in command], cwd=source.REPO, check=False)
                if completed.returncode: raise source.SourceError('automation failed: ' + str(command[0]))
            outcome = 'success'
            result = {'operation': args.operation, 'result': outcome, 'instance_sha256': view['instance_sha256']}
        print(json.dumps(result, sort_keys=True) if args.json else 'platform-apply: ' + ('preview ready' if args.dry_run else outcome))
        return 0
    except (source.SourceError, OSError, ValueError, KeyError) as error:
        print('platform-apply: ' + str(error), file=sys.stderr)
        return 1
    finally:
        if not args.dry_run and 'view' in locals() and 'audit_fd' in locals():
            record = {'time': dt.datetime.now(dt.timezone.utc).isoformat(), 'caller': 'smith',
                      'operation': args.operation, 'box': args.box,
                      'instance_sha256': view['instance_sha256'], 'implementation': view['implementation'], 'result': outcome}
            path = Path('/var/lib/klokast/apply/audit.jsonl')
            fd = os.open(path, os.O_WRONLY | os.O_APPEND | os.O_CREAT | os.O_NOFOLLOW, 0o600)
            try:
                info = os.fstat(fd)
                if not stat.S_ISREG(info.st_mode) or info.st_uid != os.geteuid() or info.st_mode & 0o077:
                    raise source.SourceError('Apply audit file is unsafe')
                os.write(fd, (json.dumps(record, sort_keys=True) + '\n').encode())
                os.fsync(fd)
            finally: os.close(fd)


if __name__ == '__main__': raise SystemExit(main())
