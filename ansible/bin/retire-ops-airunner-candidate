#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
ANSIBLE_DIR="$(cd -- "$SCRIPT_DIR/.." && pwd)"
REPO_DIR="$(cd -- "$SCRIPT_DIR/../.." && pwd)"
ANSIBLE_CONFIG_PATH="$ANSIBLE_DIR/ansible.cfg"
RENDER_NODE_INVENTORY="$SCRIPT_DIR/render-node-inventory"

BOX=""
INVENTORY="$ANSIBLE_DIR/inventory/hosts.yml"
TARGET_DISK_DEVICE="/dev/nvme0n1"
MAGICDNS_SUFFIX="$("$SCRIPT_DIR/magicdns-suffix")"
DRY_RUN=0
EXTRA_ARGS=()

usage() {
  cat <<'EOF'
Usage:
  ansible/bin/retire-ops-airunner-candidate --box BOX [options] [-- extra ansible-playbook args]

Retire a candidate airunner only after the corrected canonical airunner passes
runtime verification and the operator confirms Mac-side Mosh access.

Run this command as smith on the active <box>-ops controller.

Options:
  --box BOX               Box short name, for example boxb
  --inventory PATH         Base Ansible inventory. Default: ansible/inventory/hosts.yml
  --target-disk-device DEV Inventory render compatibility. Default: /dev/nvme0n1
  --magicdns-suffix SUFFIX Tailscale MagicDNS suffix. Default: auto-discovered
  --dry-run-plan           Print the selected command and inventory graph, then exit
  -h, --help               Show this help
EOF
}

die() {
  printf 'retire-ops-airunner-candidate: %s\n' "$*" >&2
  exit 1
}

quote_command() {
  local arg
  for arg in "$@"; do
    printf '%q ' "$arg"
  done
  printf '\n'
}

validate_box_name() {
  python3 - "$BOX" <<'PY'
import re
import sys

box = sys.argv[1]
suffixes = ("bootstrap", "dom0", "router", "bak", "dmz", "iot", "usr", "ops", "agent", "agt")
if not re.fullmatch(r"[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?", box):
    print("error: --box must be a lowercase DNS label", file=sys.stderr)
    sys.exit(1)
for suffix in suffixes:
    if box == suffix or box.endswith(f"-{suffix}"):
        print(f"error: --box must be the box name only, not a role hostname ending in -{suffix}", file=sys.stderr)
        sys.exit(1)
PY
}

while [ "$#" -gt 0 ]; do
  case "$1" in
    --box)
      [ "$#" -ge 2 ] || die "--box requires a value"
      BOX="$2"
      shift 2
      ;;
    --inventory)
      [ "$#" -ge 2 ] || die "--inventory requires a value"
      INVENTORY="$2"
      shift 2
      ;;
    --target-disk-device)
      [ "$#" -ge 2 ] || die "--target-disk-device requires a value"
      TARGET_DISK_DEVICE="$2"
      shift 2
      ;;
    --magicdns-suffix)
      [ "$#" -ge 2 ] || die "--magicdns-suffix requires a value"
      MAGICDNS_SUFFIX="$2"
      shift 2
      ;;
    --dry-run-plan)
      DRY_RUN=1
      shift
      ;;
    -h|--help)
      usage
      exit 0
      ;;
    --)
      shift
      EXTRA_ARGS=("$@")
      break
      ;;
    *)
      die "unknown argument: $1"
      ;;
  esac
done

[ -n "$BOX" ] || die "--box is required"
validate_box_name

[ "$(id -un)" = smith ] || die "run as smith on the active controller"
[ "$(hostname -s 2>/dev/null || hostname)" = "$BOX-ops" ] || die "run on $BOX-ops"

case "$INVENTORY" in
  /*) ;;
  *) INVENTORY="$PWD/$INVENTORY" ;;
esac

RUN_DIR="$REPO_DIR/.run/retire-ops-airunner-candidate-${BOX}"
LOG_DIR="$RUN_DIR/logs"
GENERATED_INVENTORY="$RUN_DIR/inventory.yml"
LOG_FILE="$LOG_DIR/68-ops-airunner-candidate-retire.log"
ANSIBLE_LOCAL_TEMP_DIR="$RUN_DIR/ansible-local"
ANSIBLE_FACT_CACHE_DIR="$RUN_DIR/facts"

command -v ansible-playbook >/dev/null 2>&1 || die "ansible-playbook not found in PATH"
command -v ansible-inventory >/dev/null 2>&1 || die "ansible-inventory not found in PATH"
command -v python3 >/dev/null 2>&1 || die "python3 not found in PATH"
[ -f "$INVENTORY" ] || die "inventory not found: $INVENTORY"
[ -f "$ANSIBLE_CONFIG_PATH" ] || die "ansible config not found: $ANSIBLE_CONFIG_PATH"
[ -x "$RENDER_NODE_INVENTORY" ] || die "inventory renderer not executable: $RENDER_NODE_INVENTORY"

mkdir -p "$LOG_DIR" "$ANSIBLE_LOCAL_TEMP_DIR" "$ANSIBLE_FACT_CACHE_DIR"
chmod 0700 "$ANSIBLE_LOCAL_TEMP_DIR" "$ANSIBLE_FACT_CACHE_DIR"
"$RENDER_NODE_INVENTORY" \
  --node "$BOX" \
  --output "$GENERATED_INVENTORY" \
  --target-disk-device "$TARGET_DISK_DEVICE" \
  --magicdns-suffix "$MAGICDNS_SUFFIX"

expected="retire ${BOX}-ops-airunner-candidate after canonical mosh verified"
EXTRA_VARS_JSON="$(
  python3 -c 'import json, sys; print(json.dumps({
    "ansible_connection": "local",
    "ansible_host": "localhost",
    "ansible_python_interpreter": "/usr/bin/python3",
    "ops_airunner_retire_confirm": sys.argv[1],
  }))' "$expected"
)"

PLAYBOOK_CMD=(
  env
  "ANSIBLE_CONFIG=$ANSIBLE_CONFIG_PATH"
  "ANSIBLE_LOCAL_TEMP=$ANSIBLE_LOCAL_TEMP_DIR"
  "ANSIBLE_CACHE_PLUGIN_CONNECTION=$ANSIBLE_FACT_CACHE_DIR"
  ansible-playbook
  -i "$INVENTORY"
  -i "$GENERATED_INVENTORY"
  "$ANSIBLE_DIR/playbooks/68-ops-airunner-candidate-retire.yml"
  -vv
  --limit "$BOX-ops"
  -e "$EXTRA_VARS_JSON"
  "${EXTRA_ARGS[@]}"
)

printf 'Box: %s\n' "$BOX"
printf 'Candidate: %s-ops-airunner-candidate\n' "$BOX"
printf 'Command: '
quote_command "${PLAYBOOK_CMD[@]}"

env ANSIBLE_CONFIG="$ANSIBLE_CONFIG_PATH" ANSIBLE_LOCAL_TEMP="$ANSIBLE_LOCAL_TEMP_DIR" ANSIBLE_CACHE_PLUGIN_CONNECTION="$ANSIBLE_FACT_CACHE_DIR" ansible-inventory \
  -i "$INVENTORY" \
  -i "$GENERATED_INVENTORY" \
  --graph --limit "$BOX-ops" >/dev/null

if [ "$DRY_RUN" -eq 1 ]; then
  exit 0
fi

printf 'Type "%s" to retire the candidate: ' "$expected"
read -r answer
[ "$answer" = "$expected" ] || die "candidate retirement confirmation did not match"

set +e
"${PLAYBOOK_CMD[@]}" 2>&1 | tee "$LOG_FILE"
status="${PIPESTATUS[0]}"
set -e

if [ "$status" -ne 0 ]; then
  printf '\nCandidate retirement failed with exit code %s.\n' "$status" >&2
  printf 'Log: %s\n' "$LOG_FILE" >&2
  exit "$status"
fi

printf '\nCandidate retirement completed.\n'
printf 'Log: %s\n' "$LOG_FILE"
