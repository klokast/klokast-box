#!/usr/bin/env python3
"""Report the independent credentials of this controller as JSON; never print a secret."""
import argparse,json,sys
from pathlib import Path
sys.path.insert(0,str(Path(__file__).resolve().parents[1]/'lib'))
import controller_credentials
parser=argparse.ArgumentParser(description=__doc__)
parser.add_argument('command',choices=['status'])
parser.parse_args()
try:
    report=controller_credentials.status()
except (RuntimeError,OSError,ValueError) as error:
    print('controller-credentials: '+str(error),file=sys.stderr);sys.exit(1)
print(json.dumps(report,sort_keys=True))
sys.exit(0 if report['ready'] else 3)
