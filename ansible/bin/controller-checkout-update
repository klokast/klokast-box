#!/usr/bin/env python3
"""Fast-forward this controller's public checkout, through the declared VPN gateway first."""
import argparse
import json
from pathlib import Path
import subprocess
import sys
sys.path.insert(0, str(Path(__file__).resolve().parents[1] / 'lib'))
import controller_checkout

argparse.ArgumentParser(description=__doc__).parse_args()
try:
    print(json.dumps(controller_checkout.update(), sort_keys=True))
except (RuntimeError, OSError, subprocess.SubprocessError) as error:
    print('controller-checkout-update: ' + str(error), file=sys.stderr)
    sys.exit(1)
