#!/usr/bin/env python3
"""Preview current Instance intent without an approval artifact."""
import argparse
from pathlib import Path
import sys
sys.path.insert(0, str(Path('/usr/local/lib/klokast') if Path('/usr/local/lib/klokast/platform_source.py').is_file()
                       else Path(__file__).resolve().parents[1] / 'lib'))
import platform_source as source


def main(argv=None):
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument('--observation')
    parser.add_argument('--json', action='store_true')
    args = parser.parse_args(argv)
    try:
        source.require_controller()
        command = [source.BINARY, 'plan', '--instance', source.INSTANCE]
        if args.observation: command += ['--observation', args.observation]
        if args.json: command += ['--json']
        print(source.as_controller(command), end='')
        return 0
    except (source.SourceError, OSError, ValueError) as error:
        print('platform-plan: ' + str(error), file=sys.stderr)
        return 1


if __name__ == '__main__': raise SystemExit(main())
