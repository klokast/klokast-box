#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
ANSIBLE_DIR="$(cd -- "$SCRIPT_DIR/.." && pwd)"
REPO_DIR="$(cd -- "$SCRIPT_DIR/../.." && pwd)"
ANSIBLE_CONFIG_PATH="$ANSIBLE_DIR/ansible.cfg"
RENDER_NODE_INVENTORY="$SCRIPT_DIR/render-node-inventory"

BOX=""
INVENTORY="$ANSIBLE_DIR/inventory/hosts.yml"
TARGET_DISK_DEVICE="/dev/nvme0n1"
MAGICDNS_SUFFIX="$("$SCRIPT_DIR/magicdns-suffix")"
DRY_RUN=0
CONNECTION_USER=auto
INSTANCE=canonical
REQUIRE_CANDIDATE_READY=0
EXTRA_ARGS=()

usage() {
  cat <<'EOF'
Usage:
  ansible/bin/converge-ops-airunner --box BOX [options] [-- extra ansible-playbook args]

Converge the AI runner container on an existing in-Platform <box>-ops
controller VM.

Options:
  --box BOX               Box short name, for example k002
  --inventory PATH         Base Ansible inventory. Default: ansible/inventory/hosts.yml
  --target-disk-device DEV Inventory render compatibility. Default: /dev/nvme0n1
  --magicdns-suffix SUFFIX Tailscale MagicDNS suffix. Default: auto-discovered
  --connection-user USER   SSH user for the ops VM. Default: auto
  --instance NAME          Airunner instance: canonical or candidate. Default: canonical
  --require-candidate-ready
                           Before canonical replacement, verify the candidate and
                           require typed confirmation of Mac-side Mosh access
  --dry-run-plan           Print the selected command and inventory graph, then exit
  -h, --help               Show this help
EOF
}

die() {
  printf 'error: %s\n' "$*" >&2
  exit 1
}

quote_command() {
  local arg
  for arg in "$@"; do
    printf '%q ' "$arg"
  done
  printf '\n'
}

validate_box_name() {
  python3 - "$BOX" <<'PY'
import re
import sys

box = sys.argv[1]
suffixes = ("bootstrap", "dom0", "router", "bak", "dmz", "iot", "usr", "ops", "agent", "agt")
if not re.fullmatch(r"[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?", box):
    print("error: --box must be a lowercase DNS label", file=sys.stderr)
    sys.exit(1)
for suffix in suffixes:
    if box == suffix or box.endswith(f"-{suffix}"):
        print(f"error: --box must be the box name only, not a role hostname ending in -{suffix}", file=sys.stderr)
        sys.exit(1)
PY
}

while [ "$#" -gt 0 ]; do
  case "$1" in
    --box)
      [ "$#" -ge 2 ] || die "--box requires a value"
      BOX="$2"
      shift 2
      ;;
    --inventory)
      [ "$#" -ge 2 ] || die "--inventory requires a value"
      INVENTORY="$2"
      shift 2
      ;;
    --target-disk-device)
      [ "$#" -ge 2 ] || die "--target-disk-device requires a value"
      TARGET_DISK_DEVICE="$2"
      shift 2
      ;;
    --magicdns-suffix)
      [ "$#" -ge 2 ] || die "--magicdns-suffix requires a value"
      MAGICDNS_SUFFIX="$2"
      shift 2
      ;;
    --connection-user)
      [ "$#" -ge 2 ] || die "--connection-user requires a value"
      CONNECTION_USER="$2"
      shift 2
      ;;
    --instance)
      [ "$#" -ge 2 ] || die "--instance requires a value"
      INSTANCE="$2"
      shift 2
      ;;
    --require-candidate-ready)
      REQUIRE_CANDIDATE_READY=1
      shift
      ;;
    --dry-run-plan)
      DRY_RUN=1
      shift
      ;;
    -h|--help)
      usage
      exit 0
      ;;
    --)
      shift
      EXTRA_ARGS=("$@")
      break
      ;;
    *)
      die "unknown argument: $1"
      ;;
  esac
done

[ -n "$BOX" ] || die "--box is required"
validate_box_name

case "$INSTANCE" in
  canonical|candidate) ;;
  *) die "--instance must be canonical or candidate" ;;
esac

if [ "$REQUIRE_CANDIDATE_READY" -eq 1 ] && [ "$INSTANCE" != canonical ]; then
  die "--require-candidate-ready is valid only with --instance canonical"
fi

case "$INVENTORY" in
  /*) ;;
  *) INVENTORY="$PWD/$INVENTORY" ;;
esac

RUN_DIR="$REPO_DIR/.run/converge-ops-airunner-${BOX}-${INSTANCE}"
LOG_DIR="$RUN_DIR/logs"
GENERATED_INVENTORY="$RUN_DIR/inventory.yml"
LOG_FILE="$LOG_DIR/68-ops-airunner-${INSTANCE}.log"
KNOWN_HOSTS_FILE="$RUN_DIR/known_hosts"
ANSIBLE_LOCAL_TEMP_DIR="$RUN_DIR/ansible-local"
ANSIBLE_FACT_CACHE_DIR="$RUN_DIR/facts"
SSH_COMMON_ARGS="-o StrictHostKeyChecking=accept-new -o UserKnownHostsFile=$KNOWN_HOSTS_FILE"
LOCAL_HOSTNAME="$(hostname -s 2>/dev/null || hostname)"

command -v ansible-playbook >/dev/null 2>&1 || die "ansible-playbook not found in PATH"
command -v ansible-inventory >/dev/null 2>&1 || die "ansible-inventory not found in PATH"
command -v python3 >/dev/null 2>&1 || die "python3 not found in PATH"
[ -f "$INVENTORY" ] || die "inventory not found: $INVENTORY"
[ -f "$ANSIBLE_CONFIG_PATH" ] || die "ansible config not found: $ANSIBLE_CONFIG_PATH"
[ -x "$RENDER_NODE_INVENTORY" ] || die "inventory renderer not executable: $RENDER_NODE_INVENTORY"

if [ "$LOCAL_HOSTNAME" = "$BOX-ops" ]; then
  EXTRA_VARS_JSON="$(python3 -c 'import json, sys; print(json.dumps({"ansible_connection": "local", "ansible_host": "localhost", "ansible_python_interpreter": "/usr/bin/python3", "ops_airunner_instance": sys.argv[1], "ops_airunner_require_candidate_ready": sys.argv[2] == "1"}))' "$INSTANCE" "$REQUIRE_CANDIDATE_READY")"
else
  if [ "$CONNECTION_USER" = auto ]; then
    CONNECTION_USER=smith
    if command -v tailscale >/dev/null 2>&1; then
      if ! tailscale ssh "smith@$BOX-ops" true >/dev/null 2>&1; then
        CONNECTION_USER=klokast-infra
      fi
    fi
  fi
  EXTRA_VARS_JSON="$(python3 -c 'import json, sys; print(json.dumps({"ansible_ssh_common_args": sys.argv[1], "ops_connection_user": sys.argv[2], "ansible_ssh_transfer_method": "piped", "ops_airunner_instance": sys.argv[3], "ops_airunner_require_candidate_ready": sys.argv[4] == "1"}))' "$SSH_COMMON_ARGS" "$CONNECTION_USER" "$INSTANCE" "$REQUIRE_CANDIDATE_READY")"
fi

mkdir -p "$LOG_DIR"
mkdir -p "$ANSIBLE_LOCAL_TEMP_DIR"
mkdir -p "$ANSIBLE_FACT_CACHE_DIR"
chmod 0700 "$ANSIBLE_LOCAL_TEMP_DIR"
chmod 0700 "$ANSIBLE_FACT_CACHE_DIR"
touch "$KNOWN_HOSTS_FILE"
chmod 0600 "$KNOWN_HOSTS_FILE"
"$RENDER_NODE_INVENTORY" \
  --node "$BOX" \
  --output "$GENERATED_INVENTORY" \
  --target-disk-device "$TARGET_DISK_DEVICE" \
  --magicdns-suffix "$MAGICDNS_SUFFIX"

PLAYBOOK_CMD=(
  env
  "ANSIBLE_CONFIG=$ANSIBLE_CONFIG_PATH"
  "ANSIBLE_LOCAL_TEMP=$ANSIBLE_LOCAL_TEMP_DIR"
  "ANSIBLE_CACHE_PLUGIN_CONNECTION=$ANSIBLE_FACT_CACHE_DIR"
  "ANSIBLE_SSH_ARGS=-o ControlMaster=no -o ControlPersist=no"
  ansible-playbook
  -i "$INVENTORY"
  -i "$GENERATED_INVENTORY"
  "$ANSIBLE_DIR/playbooks/68-ops-airunner.yml"
  -vv
  --limit "$BOX-ops"
  -e "$EXTRA_VARS_JSON"
  "${EXTRA_ARGS[@]}"
)

printf 'Box: %s\n' "$BOX"
printf 'Instance: %s\n' "$INSTANCE"
printf 'Base inventory: %s\n' "$INVENTORY"
printf 'Generated inventory: %s\n' "$GENERATED_INVENTORY"
printf 'Run directory: %s\n' "$RUN_DIR"
if [ "$LOCAL_HOSTNAME" = "$BOX-ops" ]; then
  printf 'Connection: local controller\n'
else
  printf 'Connection: ssh as %s\n' "$CONNECTION_USER"
fi
printf 'Command: '
quote_command "${PLAYBOOK_CMD[@]}"

env ANSIBLE_CONFIG="$ANSIBLE_CONFIG_PATH" ANSIBLE_LOCAL_TEMP="$ANSIBLE_LOCAL_TEMP_DIR" ANSIBLE_CACHE_PLUGIN_CONNECTION="$ANSIBLE_FACT_CACHE_DIR" ansible-inventory \
  -i "$INVENTORY" \
  -i "$GENERATED_INVENTORY" \
  --graph --limit "$BOX-ops" >/dev/null

if [ "$DRY_RUN" -eq 1 ]; then
  exit 0
fi

if [ "$REQUIRE_CANDIDATE_READY" -eq 1 ]; then
  expected="candidate mosh verified ${BOX}-ops-airunner-candidate"
  printf 'Type "%s" to replace the canonical airunner: ' "$expected"
  read -r answer
  [ "$answer" = "$expected" ] || die "candidate Mosh confirmation did not match"
fi

set +e
"${PLAYBOOK_CMD[@]}" 2>&1 | tee "$LOG_FILE"
status="${PIPESTATUS[0]}"
set -e

if [ "$status" -ne 0 ]; then
  printf '\nconverge-ops-airunner failed with exit code %s.\n' "$status" >&2
  printf 'Log: %s\n' "$LOG_FILE" >&2
  exit "$status"
fi

printf '\nconverge-ops-airunner completed.\n'
printf 'Log: %s\n' "$LOG_FILE"
