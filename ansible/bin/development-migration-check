#!/usr/bin/env python3
"""Refuse migration with pending operations; preserve recovery evidence locally."""
import argparse
import datetime as dt
import hashlib
import json
import os
from pathlib import Path
import shutil
import subprocess
import sys


def completed_apply_receipts(records):
    """Distinguish immutable historical outcomes from unfinished operations."""
    for value in records:
        version = value.get('schema_version')
        encoded = json.dumps({k: v for k, v in value.items() if k != 'receipt_sha256'},
                             sort_keys=True, separators=(',', ':'), ensure_ascii=False).encode()
        if (type(version) is not int or not 1 <= version <= 8 or
                value.get('kind') != 'klokast.apply-execution.v' + str(version) or
                value.get('receipt_sha256') != hashlib.sha256(encoded).hexdigest()):
            raise ValueError('legacy apply receipt has an invalid kind or checksum')
        finished = dt.datetime.fromisoformat(value.get('finished_at', '').replace('Z', '+00:00'))
        if finished.utcoffset() != dt.timedelta(0):
            raise ValueError('legacy apply receipt has no UTC completion time')
    scope = ('kind', 'executor', 'action', 'controller_pair', 'active_controller_box',
             'peer_box', 'freebox_gateway_id_sha256', 'delegation_slot')
    for value in records:
        result, recovery = value.get('result'), value.get('recovery_result')
        if ((result in ('success', 'verified') and recovery == 'not_needed') or
                (result == 'failed' and recovery in ('restored', 'not_needed')) or
                (result == 'retired' and recovery == 'archive_verified') or
                (result == 'exercised' and recovery == 'restored')):
            continue
        # A later complete reconciliation of the exact same legacy resource
        # closes an old failed attempt. Never rewrite or delete either receipt.
        if (result == 'failed' and recovery == 'recovery_required' and
                value.get('action') in ('adopt_instance_specification', 'repair_overlay_ipv6_direct') and
                any(later.get('result') == 'success' and later.get('recovery_result') == 'not_needed' and
                    later['finished_at'] > value['finished_at'] and
                    all(later.get(key) == value.get(key) for key in scope) for later in records)):
            continue
        raise ValueError('unresolved legacy apply receipt: ' + value['receipt_sha256'])


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument('--backup', action='store_true')
    args = parser.parse_args()
    if os.geteuid() != 0: parser.error('run through the controller migration playbook')
    root = Path('/var/lib/klokast')
    legacy = []
    for path in (root / 'apply-executions').rglob('*.json'):
        info = path.lstat()
        if path.is_symlink() or not path.is_file() or info.st_uid != 0 or info.st_mode & 0o022:
            parser.error('unsafe legacy execution receipt: ' + str(path))
        legacy.append(json.loads(path.read_text()))
    try:
        completed_apply_receipts(legacy)
    except (ValueError, KeyError, TypeError) as error:
        parser.error(str(error))
    for directory in ('network/operations', 'updates/executor/adoptions', 'updates/discovery/replacements'):
        for path in (root / directory).rglob('*.json'):
            if path.is_symlink(): parser.error('unsafe recovery record: ' + str(path))
            value = json.loads(path.read_text())
            stage = value.get('stage', value.get('status', value.get('result')))
            if stage not in ('complete', 'success', 'succeeded', 'recovered', 'unchanged', 'updated'):
                parser.error('resolve the operation before migration: ' + str(path))
    if args.backup:
        destination = root / 'development-model-migration' / 'recovery'
        destination.mkdir(mode=0o700, parents=True, exist_ok=True)
        legacy = Path('/usr/local/sbin/ksa-apply')
        overlay = root / 'network/overlay'
        if legacy.is_file():
            desired = json.loads(Path('/home/smith/private/klokast/instance/klokast-instance.json').read_text())
            for box in desired['boxes']:
                result = subprocess.run([str(legacy), 'overlay-source-status', '--box', box],
                                        capture_output=True, text=True, timeout=120)
                if result.returncode: continue
                value = json.loads(result.stdout)
                sys.path.insert(0, str(Path(__file__).resolve().parents[1] / 'lib'))
                import router_overlay_ipv6
                router_overlay_ipv6.validate_source(value, box)
                overlay.mkdir(mode=0o700, parents=True, exist_ok=True)
                path = overlay / (box + '.json')
                if path.exists() and json.loads(path.read_text()) != value:
                    parser.error('preserved overlay selection differs; reconcile it first')
                path.write_text(json.dumps(value, sort_keys=True) + '\n')
                path.chmod(0o600)
        for name in ('authority-states', 'active-authority-state', 'apply-executions',
                     'apply-rollback-material', 'instance-recovery-manifests', 'updates/executor'):
            source = root / name
            target = destination / name.replace('/', '-')
            if not source.exists() or target.exists(): continue
            if source.is_symlink(): parser.error('unsafe recovery path: ' + str(source))
            if source.is_dir(): shutil.copytree(source, target, symlinks=True)
            else: shutil.copy2(source, target)
    print(json.dumps({'checked': True, 'paused_before_migration':
                      json.loads((destination / 'updates-executor' / 'pause.json').read_text()).get('paused') is True
                      if args.backup and (destination / 'updates-executor' / 'pause.json').exists() else False}))


if __name__ == '__main__': main()
