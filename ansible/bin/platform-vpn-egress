#!/usr/bin/env python3
"""Manage a declared, same-box shared VPN proxy from the active controller."""
import argparse
import contextlib
import gzip
import hashlib
import json
import os
from pathlib import Path
import socket
import subprocess
import sys
import tempfile
import urllib.request
import yaml

REPO = Path(__file__).resolve().parents[2]
sys.path.insert(0, str(REPO / 'ansible/lib'))
import infrastructure_images
import platform_resource_compiler as compiler
import platform_resource_model as model
import platform_resource_runtime as runtime
import platform_source as source
import platform_vpn_egress as vpn
import routing_profile
import vpn_routing_runtime

import vpn_egress_provisioning as provisioning

def ansible(name, hosts, variables):
    return provisioning.ansible(name, hosts, variables, repo=REPO)

def main(argv=None):
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument('action', choices=('deploy', 'configure', 'verify', 'status', 'refresh', 'with-proxy'))
    parser.add_argument('--box', required=True)
    parser.add_argument('--exercise', action='store_true', help='verify proxy outage and VM reboot recovery')
    argv = list(sys.argv[1:] if argv is None else argv)
    command = []
    if '--' in argv:
        separator = argv.index('--')
        argv, command = argv[:separator], argv[separator + 1:]
    args = parser.parse_args(argv)
    if args.action == 'with-proxy':
        if args.exercise: parser.error('--exercise does not apply to with-proxy')
        import ops_vpn_proxy
        try: return ops_vpn_proxy.execute(args.box, command)
        except KeyboardInterrupt: return 130
        except (RuntimeError, ValueError, OSError, subprocess.SubprocessError) as error:
            print('platform-vpn-egress: ' + str(error), file=sys.stderr); return 1
    if command: parser.error('only with-proxy accepts a command')
    if args.exercise and args.action != 'verify':
        parser.error('--exercise requires verify')
    locks = contextlib.ExitStack()
    try:
        os.environ['ANSIBLE_CONFIG'] = str(REPO / 'ansible/ansible.cfg')
        source.require_controller()
        if args.action not in ("status", "verify"):
            locks.enter_context(runtime.vm_update_installation_lock())
        snapshot = source.snapshot()
        projection = snapshot['rendered']['projection']
        view = dict(source='instance', registry_path=str(source.INSTANCE/'klokast-instance.json'),
                    registry_sha256=projection['registry_sha256'], registry=projection['registry'])
        if view.get('source') != 'instance':
            raise RuntimeError('VPN gateway requires current validated Instance state')
        topology = model.load_topology(repo_root=REPO)
        configs = model.registry_box_configs(view['registry'], topology)
        if args.box not in configs:
            raise RuntimeError('unknown box')
        if 'routing_profile' not in view['registry']['boxes'][args.box]:
            raise RuntimeError('Instance routing profile is absent; migrate the box profile and controller CLI first')
        config = configs[args.box]
        enabled = 'vpn_egress' in config
        selected, assignment = vpn_routing_runtime.select(args.box, config['routing_profile'],
            adopt=args.action in ('configure', 'deploy'), readonly=args.action in ('status', 'verify', 'refresh'), create=args.action == 'deploy') if enabled else (config['routing_profile'], {'state': 'absent'})
        view['installed_routing_profiles'] = vpn_routing_runtime.installed_profiles(view['registry'])
        view['installed_air_bootstrap'] = vpn_routing_runtime.installed_air_bootstrap(view['registry'])
        variables_ = provisioning.variables(args.box, config, topology, selected)
        variables_['vpn_egress_intent_sha256'] = source.snapshot()['instance_sha256']
        if args.action == 'status':
            print(json.dumps({'box': args.box, 'declared': enabled, 'clients': config.get('vpn_egress', {}).get('clients', []),
                              'installed_routing_profile': selected if assignment['state'] != 'absent' else None,
                              'desired_routing_profile': config['routing_profile'],
                              'replacement_needed_for_profile': selected != config['routing_profile']}), flush=True)
            if enabled:
                ansible('69-vpn-egress-status.yml', args.box + '-vpn-egress', variables_)
                ansible('69-vpn-egress-provider.yml', args.box + '-vpn-egress', variables_)
            return 0
        if args.action == 'verify':
            if not enabled:
                raise RuntimeError('declare the gateway before verification')
            if args.exercise:
                runtime.require_active_controller()
                with runtime.vm_update_installation_lock():
                    ansible('69-vpn-egress-resilience.yml', args.box + '-vpn-egress', variables_)
                    ansible('69-vpn-egress-verify.yml', args.box, variables_)
            else:
                ansible('69-vpn-egress-verify.yml', args.box, variables_)
            return 0
        runtime.require_active_controller()
        if args.action == 'refresh':
            if not enabled or assignment['state'] not in ('ready', 'complete', 'adopted', 'recovered'):
                raise RuntimeError('native subscription refresh requires an installed gateway; use deploy or configure first')
            import vm_service_updates
            observed = vm_service_updates.step(args.box, 'vpn-egress', 'status')
            if observed['pending']:
                raise RuntimeError('incomplete service operation; resume with: ' + vm_service_updates.resume_command(args.box, observed['pending'][0]))
            variables_['vpn_egress_provider_action'] = 'refresh'
            ansible('69-vpn-egress-provider.yml', args.box + '-vpn-egress', variables_)
            return 0
        with contextlib.nullcontext():
            if enabled and assignment['state'] in ('absent', 'ready', 'complete', 'adopted', 'recovered'):
                # Establish subscription egress before fetching a reconstruction seed.
                provisioning.network(args.box, view, repo=REPO)
            if not enabled:
                provisioning.network(args.box, view, repo=REPO)
                ansible('69-vpn-egress-disable.yml', args.box + '-dom0', variables_)
            else:
                creation=assignment.get('creation_configuration')
                if args.action=='deploy' and creation and 'vpn_inputs' in creation:
                    work,_=provisioning.recover_creation(creation,image=assignment['creation_image'])
                    print(json.dumps(provisioning.create_frozen(args.box,work,creation)))
                    return 0
                if args.action=='deploy' and assignment['state'] in ('allocated','copied'):
                    raise RuntimeError('historical pending VPN creation needs its verified original implementation and inputs')
                if args.action=='deploy' and assignment['state']=='absent':
                    operation=infrastructure_images.prepare_image(args.box,'vpn-egress-alpine-v1',repo=REPO)
                    values=provisioning.prepare_configuration(args.box,config,topology,selected)
                    values['vpn_egress_intent_sha256']=snapshot['instance_sha256']
                    work,creation=provisioning.freeze_creation(args.box,operation,values,view,
                        provisioning.creation_config(args.box,topology,selected),repo=REPO)
                    print(json.dumps(provisioning.create_frozen(args.box,work,creation)))
                    return 0
                try:
                    variables_.update(provisioning.prepare_configuration(args.box, config, topology, selected))
                except yaml.YAMLError:
                    raise RuntimeError('private subscription YAML is invalid; details were withheld') from None
                if args.action == 'deploy' and (assignment['state'] in ('absent', 'allocated', 'copied') or assignment.get('creation_configuration')):
                    operation = assignment.get('creation_image') or infrastructure_images.prepare_image(args.box, 'vpn-egress-alpine-v1', repo=REPO)
                    variables_.update(infrastructure_role='vpn-egress', infrastructure_image=operation,
                        infrastructure_config=provisioning.creation_config(args.box, topology, selected))
                    if assignment.get('creation_configuration'):
                        variables_['infrastructure_config'] = assignment['creation_configuration']
                    provisioning.network(args.box, view, bootstrap=True, repo=REPO)
                    ansible('69-vpn-egress-provision.yml', args.box, variables_)
                if assignment['state'] == 'absent' and args.action != 'deploy':
                    raise RuntimeError('gateway is absent; use deploy for first creation')
                provisioning.configure(args.box, variables_, repo=REPO)
                provisioning.network(args.box, view, repo=REPO)
                # Require successful requests before changing the clients' default environment.
                ansible('69-vpn-egress-verify.yml', args.box, variables_)
            hosts = provisioning.client_hosts(args.box, config, topology, repo=REPO)
            if hosts:
                ansible('69-vpn-egress-clients.yml', ','.join(hosts), variables_)
        print(json.dumps({'state': 'converged', 'box': args.box, 'declared': enabled}))
        return 0
    except (RuntimeError, ValueError, OSError, source.SourceError, subprocess.SubprocessError) as error:
        # Private artifacts can occur in nested parser/transport exceptions.
        print('platform-vpn-egress: ' + str(error) + '. No direct fallback was enabled.', file=sys.stderr)
        return 1
    finally:
        locks.close()


if __name__ == '__main__':
    sys.exit(main())
