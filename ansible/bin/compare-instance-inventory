#!/usr/bin/env python3
"""Compare effective Ansible inventories without contacting any host."""

import argparse
import hashlib
import json
import os
from pathlib import Path
import subprocess
import sys
import tempfile

REPO = Path(__file__).resolve().parents[2]
sys.path.insert(0, str(REPO / "ansible/lib"))
from platform_inventory import POLICY_GROUPS, canonical, compare_inventories, digest, normalized_inventory, static_inventory


def read_regular(path):
    if path.is_symlink() or not path.is_file() or path.stat().st_size > 16 * 1024 * 1024:
        raise ValueError("inventory input must be a bounded regular file: " + path.name)
    return path.read_bytes()


def compare(projection, output):
    graph = projection["inventory"]
    if digest(graph) != projection["inventory_sha256"]:
        raise ValueError("inventory projection hash differs")
    effective_static = static_inventory(graph)
    boxes = projection["boxes"]
    if len(boxes) != 2 or sorted(set(boxes)) != boxes:
        raise ValueError("inventory comparison requires the exact two-box set")
    expected_hosts = {box + "-" + role for box in boxes for role in ("bootstrap", "dom0", "router", "bak", "dmz", "iot", "ops")}
    if set(graph["_meta"]["hostvars"]) != expected_hosts:
        raise ValueError("inventory projection has incomplete or extra host coverage")
    suffix = graph["all"]["vars"]["platform_magicdns_suffix"]
    legacy = REPO / "ansible/inventory"
    source_files = {str(p.relative_to(REPO)): hashlib.sha256(read_regular(p)).hexdigest()
                    for p in sorted(legacy.rglob("*.yml"))}
    policy = {name: read_regular(legacy / "group_vars" / (name + ".yml")) for name in POLICY_GROUPS}
    policy_hashes = {name: hashlib.sha256(value).hexdigest() for name, value in policy.items()}
    env = {**os.environ, "ANSIBLE_CONFIG": str(REPO / "ansible/ansible.cfg"),
           "ANSIBLE_CACHE_PLUGIN": "memory",
           "ANSIBLE_INVENTORY_UNPARSED_IS_FAILED": "true", "ANSIBLE_INVENTORY_ANY_UNPARSED_IS_FAILED": "true"}

    def invoke(command, label):
        result = subprocess.run([str(v) for v in command], cwd=REPO, env=env, capture_output=True, text=True)
        (output / (label + ".stdout")).write_text(result.stdout)
        (output / (label + ".stderr")).write_text(result.stderr)
        if result.returncode:
            raise ValueError(label + " failed; inspect private inventory comparison logs")
        return result.stdout

    with tempfile.TemporaryDirectory(prefix="inventory-compare-", dir=output) as temporary:
        work = Path(temporary)
        old_args = ["ansible-inventory", "-i", legacy / "hosts.yml"]
        for box in boxes:
            inventory = work / (box + ".yml")
            arguments = [REPO / "ansible/bin/render-node-inventory", "--node", box, "--magicdns-suffix", suffix, "--output", inventory]
            ports = graph["_meta"]["hostvars"][box + "-dom0"].get("dom0_bridge_physical_ports", {})
            for name, values in sorted(ports.items()):
                arguments.extend(["--dom0-bridge-port", name + "=" + ",".join(values)])
            invoke(arguments, "render-legacy-" + box)
            old_args.extend(["-i", inventory])
        effective_dir = work / "effective"
        effective_dir.mkdir(mode=0o700)
        (effective_dir / "group_vars").mkdir(mode=0o700)
        for name, value in policy.items():
            (effective_dir / "group_vars" / (name + ".yml")).write_bytes(value)
        effective_path = effective_dir / "inventory.yml"
        effective_path.write_text(canonical(effective_static) + "\n")
        old = json.loads(invoke([*old_args, "--list"], "old-inventory"))
        effective = json.loads(invoke(["ansible-inventory", "-i", effective_path, "--list"], "effective-inventory"))
        # Exercise the real reader through Ansible's script plugin. Only its
        # protected status replies are fixtures; parsing and rendering are real.
        dynamic_dir = work / "dynamic"
        dynamic_dir.mkdir(mode=0o700)
        (dynamic_dir / "group_vars").mkdir(mode=0o700)
        for name, value in policy.items():
            (dynamic_dir / "group_vars" / (name + ".yml")).write_bytes(value)
        status = {"schema_version": 1, "kind": "klokast.inventory-source-status.v1",
                  "source": "instance_specification_v1", "authority_state_sha256": "a" * 64, "engine_commit": "b" * 40,
                  "rendered": {"valid": True, "kind": "klokast.inventory.v1", "projection": projection}}
        controller = {"schema_version": 1, "kind": "klokast.controller-identity-status.v1", "source": "instance_specification_v1",
                      "authority_state_sha256": "a" * 64, "engine_commit": "b" * 40,
                      "controllers": {role: {"box": box, "hostname": box + "-ops"} for role, box in zip(("active", "standby"), boxes)}}
        (dynamic_dir / "status.json").write_text(canonical(status) + "\n")
        (dynamic_dir / "controller.json").write_text(canonical(controller) + "\n")
        dynamic_path = dynamic_dir / "hosts"
        dynamic_path.write_text("""#!/usr/bin/env python3
import importlib.util,json,os,sys
from importlib.machinery import SourceFileLoader
from pathlib import Path
""" + "repo = Path(" + repr(str(REPO)) + ")\nos.environ['KLOKAST_MAGICDNS_SUFFIX'] = " + repr(suffix) + "\n" + """
loader=SourceFileLoader('checked_reader',str(repo/'ansible/bin/platform-inventory'))
spec=importlib.util.spec_from_loader(loader.name,loader)
reader=importlib.util.module_from_spec(spec);loader.exec_module(reader)
reader.REPO=repo
invoke=reader.invoke
def fixture(command):
    if str(command[0])=='/usr/bin/doas':
        assert len(command)==3 and Path(command[1])==reader.HELPER
        names={'inventory-source-status':'status.json','controller-identity-status':'controller.json'}
        return json.loads(Path(__file__).with_name(names[command[2]]).read_text())
    return invoke(command)
reader.invoke=fixture
raise SystemExit(reader.main())
""")
        dynamic_path.chmod(0o700)
        dynamic = json.loads(invoke(["ansible-inventory", "-i", dynamic_path, "--list"], "dynamic-inventory"))
        result = compare_inventories(old, effective, projection)
        if compare_inventories(old, dynamic, projection) != result:
            raise ValueError("normal dynamic inventory differs from the static comparison")
        with_boxes = json.loads(invoke(["ansible-inventory", "-i", dynamic_path, *old_args[3:], "--list"], "dynamic-with-box-files"))
        if compare_inventories(old, with_boxes, projection) != result:
            raise ValueError("adopted reader differs when normal box files are added")
        status.pop("rendered")
        status["source"] = "legacy_engine_inventory"
        (dynamic_dir / "status.json").write_text(canonical(status) + "\n")
        retained = json.loads(invoke(["ansible-inventory", "-i", dynamic_path, *old_args[3:], "--list"], "legacy-reader-with-box-files"))
        selected = set(graph["_meta"]["hostvars"])
        if set(retained["_meta"]["hostvars"]) != set(old["_meta"]["hostvars"]) or normalized_inventory(retained, selected) != normalized_inventory(old, selected):
            raise ValueError("legacy reader lost host variables or role membership before adoption")
    current_sources = {str(p.relative_to(REPO)): hashlib.sha256(read_regular(p)).hexdigest()
                       for p in sorted(legacy.rglob("*.yml"))}
    if current_sources != source_files:
        raise ValueError("legacy inventory or upstream policy changed during comparison")
    result.update(policy_sha256=digest(policy_hashes), policy_files_sha256=policy_hashes,
                  legacy_files_sha256=digest(source_files), temporary_files_removed=True)
    return result


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--projection", required=True)
    parser.add_argument("--output-directory", required=True)
    args = parser.parse_args()
    os.umask(0o077)
    try:
        projection_path = Path(args.projection)
        original = read_regular(projection_path)
        output = Path(args.output_directory)
        output.mkdir(mode=0o700)
        result = compare(json.loads(original), output)
        if read_regular(projection_path) != original:
            raise ValueError("inventory projection changed during comparison")
        (output / "result.json").write_text(canonical(result) + "\n")
        print(canonical(result))
    except (KeyError, ValueError, TypeError, OSError) as error:
        print("compare-instance-inventory: " + str(error), file=sys.stderr)
        return 1
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
