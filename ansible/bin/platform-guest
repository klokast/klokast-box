#!/usr/bin/env python3
import argparse
import json
import os
import shutil
import subprocess
import sys
from datetime import datetime, timezone
from pathlib import Path

import yaml


REPO_ROOT = Path(__file__).resolve().parents[2]
PLATFORM_RESOURCES = REPO_ROOT / "ansible" / "bin" / "platform-resources"
PLATFORM_MAP = REPO_ROOT / "ansible" / "bin" / "platform-map"
MAGICDNS_SUFFIX = REPO_ROOT / "ansible" / "bin" / "magicdns-suffix"
DEFAULT_REGISTRY = Path(
    os.environ.get(
        "KLOKAST_PLATFORM_RESOURCES_REGISTRY",
        "~/private/klokast/platform-resources.yml",
    )
).expanduser()
ROLES = ("bak", "dmz", "iot")
STATES = ("running", "stopped")


def die(message):
    print(f"platform-guest: {message}", file=sys.stderr)
    raise SystemExit(1)


def run(argv, *, dry_run=False, capture=False):
    print("+ " + " ".join(str(part) for part in argv))
    if dry_run:
        return subprocess.CompletedProcess(argv, 0, "", "")
    result = subprocess.run(
        [str(part) for part in argv],
        cwd=REPO_ROOT,
        text=True,
        stdout=subprocess.PIPE if capture else None,
        stderr=subprocess.PIPE if capture else None,
        check=False,
    )
    if result.returncode != 0:
        detail = (result.stderr or result.stdout or "").strip()
        die(
            f"command failed ({result.returncode}): {' '.join(str(part) for part in argv)}"
            + (f": {detail}" if detail else "")
        )
    return result


def require_active_controller():
    guard = Path(
        os.environ.get(
            "KLOKAST_CONTROLLER_GUARD", "/usr/local/sbin/klokast-controller-guard"
        )
    )
    if not guard.exists() or not os.access(guard, os.X_OK):
        return
    result = subprocess.run(
        [guard, "--require-active"],
        text=True,
        stdout=subprocess.PIPE,
        stderr=subprocess.PIPE,
        check=False,
    )
    if result.returncode != 0:
        die(f"controller is not active: {(result.stderr or result.stdout).strip()}")


def load_registry(path):
    if not path.is_file():
        die(f"platform resources registry does not exist: {path}")
    with path.open(encoding="utf-8") as handle:
        data = yaml.safe_load(handle) or {}
    if not isinstance(data, dict):
        die(f"registry root must be a mapping: {path}")
    if data.get("schema_version") != 1:
        die(f"registry must use schema_version: 1: {path}")
    if not isinstance(data.get("apps"), dict):
        die("registry apps must be a mapping")
    return data


def write_candidate(path, data):
    candidate = path.with_name(f".{path.name}.{os.getpid()}.candidate")
    with candidate.open("w", encoding="utf-8") as handle:
        yaml.safe_dump(data, handle, sort_keys=False)
    os.chmod(candidate, path.stat().st_mode & 0o777)
    return candidate


def save_registry(path, data, *, dry_run=False):
    candidate = write_candidate(path, data)
    try:
        run([PLATFORM_RESOURCES, "--registry", candidate, "lint"], capture=True)
        if dry_run:
            print(f"platform-guest: dry-run would update {path}")
            return
        stamp = datetime.now(timezone.utc).strftime("%Y%m%dT%H%M%SZ")
        backup = path.with_name(f"{path.name}.{stamp}.bak")
        shutil.copy2(path, backup)
        os.replace(candidate, path)
        candidate = None
        print(f"platform-guest: registry backup: {backup}")
    finally:
        if candidate is not None:
            candidate.unlink(missing_ok=True)


def compiled_plan(registry):
    result = run([PLATFORM_RESOURCES, "--registry", registry, "show"], capture=True)
    try:
        return json.loads(result.stdout)
    except json.JSONDecodeError as exc:
        die(f"compiled registry output is invalid JSON: {exc}")


def box_states(plan, box):
    config = (plan.get("box_configs") or {}).get(box)
    if not isinstance(config, dict):
        die(f"registry has no boxes.{box} configuration")
    return config.get("shared_guests") or {}


def print_status(registry, box, role=None):
    states = box_states(compiled_plan(registry), box)
    roles = [role] if role else list(ROLES)
    for selected_role in roles:
        state = (states.get(selected_role) or {}).get("runtime_state", "running")
        print(f"box={box}\trole={selected_role}\truntime_state={state}")


def approved_commit():
    return subprocess.check_output(
        ["git", "rev-parse", "HEAD"], cwd=REPO_ROOT, text=True
    ).strip()


def magicdns_suffix():
    return subprocess.check_output([MAGICDNS_SUFFIX], cwd=REPO_ROOT, text=True).strip()


def converge(args, operation):
    if operation == "apply":
        require_active_controller()
    command = "apply-shared-guests" if operation == "apply" else "verify-shared-guests"
    argv = [
        PLATFORM_RESOURCES,
        "--registry",
        args.registry,
        "--magicdns-suffix",
        magicdns_suffix(),
        "--box",
        args.box,
    ]
    if getattr(args, "role", None):
        argv.extend(["--shared-guest-role", args.role])
    if operation == "apply":
        argv.extend(["--approved-commit", approved_commit()])
    argv.append(command)
    run(argv, dry_run=args.dry_run)


def set_runtime_state(args, state):
    require_active_controller()
    registry = load_registry(args.registry)
    boxes = registry.setdefault("boxes", {})
    if not isinstance(boxes, dict):
        die("registry boxes must be a mapping")
    box = boxes.setdefault(args.box, {})
    if not isinstance(box, dict):
        die(f"boxes.{args.box} must be a mapping")
    shared = box.setdefault("shared_guests", {})
    if not isinstance(shared, dict):
        die(f"boxes.{args.box}.shared_guests must be a mapping")
    guest = shared.setdefault(args.role, {})
    if not isinstance(guest, dict):
        die(f"boxes.{args.box}.shared_guests.{args.role} must be a mapping")
    guest["runtime_state"] = state
    save_registry(args.registry, registry, dry_run=args.dry_run)
    if not args.dry_run:
        converge(args, "apply")


def build_parser():
    parser = argparse.ArgumentParser(
        description="Manage shared Klokast Xen guest lifecycle on the active controller."
    )
    parser.add_argument("--registry", type=Path, default=DEFAULT_REGISTRY)
    parser.add_argument("--dry-run", action="store_true")
    sub = parser.add_subparsers(dest="command", required=True)

    listing = sub.add_parser("list")
    listing.add_argument("--box", required=True)

    status = sub.add_parser("status")
    status.add_argument("--box", required=True)
    status.add_argument("--role", choices=ROLES, required=True)
    status.add_argument("--refresh", action="store_true")

    for name in ("apply", "verify"):
        item = sub.add_parser(name)
        item.add_argument("--box", required=True)
        item.add_argument("--role", choices=ROLES)

    for name in ("start", "stop"):
        item = sub.add_parser(name)
        item.add_argument("--box", required=True)
        item.add_argument("--role", choices=ROLES, required=True)
    return parser


def main(argv=None):
    args = build_parser().parse_args(argv)
    args.registry = args.registry.expanduser()
    if args.command == "list":
        print_status(args.registry, args.box)
    elif args.command == "status":
        if args.refresh:
            run(
                [
                    PLATFORM_MAP,
                    "refresh",
                    "--boxes",
                    args.box,
                    "--resources-registry",
                    args.registry,
                    "--remote-scope",
                    "dom0",
                ],
                dry_run=args.dry_run,
            )
        print_status(args.registry, args.box, args.role)
    elif args.command == "apply":
        converge(args, "apply")
    elif args.command == "verify":
        converge(args, "verify")
    elif args.command == "start":
        set_runtime_state(args, "running")
    elif args.command == "stop":
        set_runtime_state(args, "stopped")
    else:
        die(f"unsupported command: {args.command}")


if __name__ == "__main__":
    main()
