#!/usr/bin/env python3
"""Render Ansible inventory from current validated Instance desired state."""
import argparse
import json
from pathlib import Path
import sys
sys.path.insert(0, str(Path('/usr/local/lib/klokast') if Path('/usr/local/lib/klokast/platform_source.py').is_file()
                       else Path(__file__).resolve().parents[1] / 'lib'))
import platform_source as source


def main(argv=None):
    parser = argparse.ArgumentParser(description=__doc__)
    group = parser.add_mutually_exclusive_group(required=True)
    group.add_argument('--list', action='store_true')
    group.add_argument('--host')
    args = parser.parse_args(argv)
    try:
        source.require_controller()
        value = json.loads(source.as_controller([source.BINARY, 'inventory', '--instance', source.INSTANCE, '--json']), object_pairs_hook=source.unique)
        if value.get('valid') is not True or value.get('kind') != 'klokast.inventory.v1':
            raise source.SourceError('Instance inventory is invalid')
        graph = value['projection']['inventory']
        print(json.dumps(graph if args.list else graph['_meta']['hostvars'].get(args.host, {}), sort_keys=True))
        return 0
    except (source.SourceError, OSError, ValueError, KeyError) as error:
        print('platform-inventory: ' + str(error), file=sys.stderr)
        return 1


if __name__ == '__main__':
    raise SystemExit(main())
