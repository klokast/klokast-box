#!/usr/bin/env python3
"""Read the checked execution inventory on the active controller."""

import argparse
import json
from pathlib import Path
import subprocess
import sys

HELPER = Path("/usr/local/sbin/ksa-apply")
REPO = Path("/home/smith/src/klokast/klokast-box")
MAXIMUM = 16 * 1024 * 1024


class InventoryError(Exception):
    pass


def unique_object(pairs):
    value = {}
    for key, item in pairs:
        if key in value: raise InventoryError("inventory response contains duplicate fields")
        value[key] = item
    return value


def invoke(command):
    try:
        result = subprocess.run([str(v) for v in command], text=True, capture_output=True, check=False)
    except OSError as error:
        raise InventoryError("inventory source helper is unavailable; install the matching controller toolchain") from error
    if result.returncode or not 0 < len(result.stdout) <= MAXIMUM:
        raise InventoryError("inventory source verification failed; inspect the controller evidence")
    try:
        value = json.loads(result.stdout, object_pairs_hook=unique_object)
    except ValueError as error:
        raise InventoryError("inventory response is invalid JSON") from error
    if not isinstance(value, dict): raise InventoryError("inventory response is not an object")
    return value


def read_inventory():
    status = invoke(["/usr/bin/doas", HELPER, "inventory-source-status"])
    fields = {"schema_version", "kind", "source", "authority_state_sha256", "engine_commit"}
    if status.get("schema_version") != 1 or status.get("kind") != "klokast.inventory-source-status.v1" or status.get("source") not in {"legacy_engine_inventory", "instance_specification_v1"}:
        raise InventoryError("inventory source response has an unknown contract")
    adopted = status["source"] == "instance_specification_v1"
    if adopted: fields.add("rendered")
    if set(status) != fields: raise InventoryError("inventory source response has unknown fields")
    if adopted:
        rendered = status["rendered"]
        if not isinstance(rendered, dict) or rendered.get("valid") is not True or rendered.get("kind") != "klokast.inventory.v1":
            raise InventoryError("inventory source has no valid sealed projection")
        graph = rendered["projection"]["inventory"]
    else:
        graph = invoke(["ansible-inventory", "-i", REPO / "ansible/inventory/hosts.yml", "--list"])
        if invoke(["/usr/bin/doas", HELPER, "inventory-source-status"]) != status:
            raise InventoryError("inventory source changed during legacy resolution")
    if not isinstance(graph.get("_meta", {}).get("hostvars"), dict):
        raise InventoryError("inventory response lacks host variables")
    return graph


def main(argv=None):
    parser = argparse.ArgumentParser(description=__doc__)
    group = parser.add_mutually_exclusive_group(required=True)
    group.add_argument("--list", action="store_true")
    group.add_argument("--host")
    args = parser.parse_args(argv)
    try:
        graph = read_inventory()
        print(json.dumps(graph if args.list else graph["_meta"]["hostvars"].get(args.host, {}), sort_keys=True, ensure_ascii=False))
    except (InventoryError, OSError, KeyError, TypeError) as error:
        print("platform-inventory: " + str(error), file=sys.stderr)
        return 1
    return 0


if __name__ == "__main__": raise SystemExit(main())
