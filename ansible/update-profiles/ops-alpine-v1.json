    "ops"
  ],
  "packages": [
    "alpine-base",
    "ansible",
    "bash",
    "ca-certificates",
    "curl",
    "doas",
    "e2fsprogs",
    "e2fsprogs-extra",
    "fuse-overlayfs",
    "git",
    "iproute2",
    "iptables",
    "jq",
    "linux-virt",
