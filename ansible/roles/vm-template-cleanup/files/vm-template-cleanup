#!/usr/bin/python3
"""Verify saved template bytes or remove unused development artifacts.

Deletion preserves completed recovery records and their references. Verification reads only
the requested candidate and does not inspect or change production guests. Cleanup keeps
the exact controller-qualified current candidate, other profiles, and all
observed Xen/configuration/loop references. It retains build receipts and
records each removal before deleting bytes. Unknown files remain untouched.
"""
import argparse
import fcntl
import hashlib
import json
import os
from pathlib import Path
import re
import socket
import shutil
import stat
import subprocess

BASE = Path('/mnt/dom0_data/klokast-vm-templates')
UPDATES = Path('/mnt/dom0_data/klokast-vm-updates')
TRIALS = Path('/mnt/dom0_data/klokast-vm-recovery-tests')
OP = re.compile('[0-9a-f]{24}')
BOX = re.compile('[a-z0-9](?:[a-z0-9-]{0,29}[a-z0-9])?')
HASH = re.compile('[0-9a-f]{64}')


class Refused(RuntimeError):
    pass


class Damaged(Refused):
    pass


def canonical(value):
    return json.dumps(value, sort_keys=True, separators=(',', ':'), ensure_ascii=False).encode()


def digest(value):
    return hashlib.sha256(canonical(value)).hexdigest()


def safe(path, directory=False, maximum=2 * 1024**3):
    info = path.lstat()
    valid = stat.S_ISDIR(info.st_mode) if directory else stat.S_ISREG(info.st_mode)
    if (not valid or info.st_uid != os.geteuid() or info.st_mode & 0o022 or
            (not directory and (info.st_nlink != 1 or info.st_size > maximum))):
        raise Refused('unsafe artifact path: ' + path.name)
    return info


def read(path):
    safe(path, maximum=2 * 1024 * 1024)
    def unique(pairs):
        value = {}
        for key, item in pairs:
            if key in value:
                raise Refused('duplicate artifact record field')
            value[key] = item
        return value
    value = json.loads(path.read_bytes(), object_pairs_hook=unique)
    if not isinstance(value, dict):
        raise Refused('artifact record must be a JSON object')
    return value


def store(path, value):
    safe(path.parent, True)
    descriptor = os.open(path, os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_NOFOLLOW, 0o600)
    with os.fdopen(descriptor, 'wb') as stream:
        stream.write(canonical(value) + b'\n'); stream.flush(); os.fsync(stream.fileno())
    syncdir(path.parent)


def syncdir(path):
    descriptor = os.open(path, os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW)
    try:
        os.fsync(descriptor)
    finally:
        os.close(descriptor)


def command(argv):
    result = subprocess.run(argv, stdin=subprocess.DEVNULL, capture_output=True, timeout=30)
    if result.returncode or len(result.stdout) > 8 * 1024 * 1024:
        raise Refused('artifact reference inspection failed')
    return result.stdout.decode()


def trial_cleanup():
    if not TRIALS.exists():
        return
    safe(TRIALS, True)
    for trial in TRIALS.iterdir():
        safe(trial, True)
        if not (trial / 'state').exists():
            continue
        cleanup = trial / 'cleanup.json'
        if not cleanup.exists():
            # The test creates empty state before resource preflight. A failed
            # preflight has no transaction to recover, but prove this locally.
            if not OP.fullmatch(trial.name) or (trial / 'resources.json').exists():
                raise Refused('a recovery test has incomplete cleanup evidence')
            for name in ('operations', 'active'):
                path = trial / 'state' / name; safe(path, True)
                if any(path.iterdir()):
                    raise Refused('a recovery test has unfinished operation records')
            volumes = json.loads(command(['/sbin/lvs', '--reportformat', 'json', '-o', 'lv_name']))
            if any(v['lv_name'].strip().startswith('vmupdtest_' + trial.name + '_')
                   for report in volumes['report'] for v in report['lv']):
                raise Refused('an incomplete recovery test still has disks')
            continue
        record = read(cleanup)
        if any(record.get(key) is not True for key in
               ('disks_removed', 'guest_absent', 'production_uuids_unchanged')):
            raise Refused('a recovery test has incomplete cleanup evidence')


def recovery_references():
    """Read retained transactions without changing their boot or recovery state."""
    texts, requests = [], {}
    for name in ('active', 'operations'):
        path = UPDATES / name
        if path.exists() or path.is_symlink():
            safe(path, True)
    for work in (UPDATES / 'operations').glob('*'):
        safe(work, True)
        if not OP.fullmatch(work.name):
            raise Refused('unknown VM transaction directory; preserve templates')
        request, journal = read(work / 'request.json'), read(work / 'journal.json')
        if (request.get('operation_id') != work.name or request.get('kind') not in
                {'klokast.vm-adoption.v1', 'klokast.vm-switch.v1', 'klokast.vm-switch.v2', 'klokast.vm-switch.v3'} or
                journal.get('request_sha256') != digest(request) or
                journal.get('stage') not in ('adopted', 'complete', 'recovered') or
                journal.get('old_shutdown_pending') is True):
            raise Refused('pending or invalid VM transaction; preserve templates')
        requests[work.name] = request
        for directory, dirs, files in os.walk(work, followlinks=False):
            for name in dirs: safe(Path(directory) / name, True)
            for name in files:
                path = Path(directory) / name
                if path.suffix == '.json': texts.append(json.dumps(read(path)))
                elif path.suffix == '.cfg':
                    safe(path, maximum=1024 * 1024); texts.append(path.read_text())
    for path in (UPDATES / 'active').glob('*'):
        value = read(path)
        request = requests.get(value.get('operation_id'))
        if (request is None or value.get('request_sha256') != digest(request) or
                path.name != request.get('role', '') + '.json'):
            raise Refused('active VM assignment differs from its retained transaction')
    return texts


def controller_image_references(record):
    """Retain images bound to current, pending, and previous controller roots."""
    result = []
    for _ in range(64):
        image = record.get('image')
        if image is not None:
            if not OP.fullmatch(image): raise Refused('controller image reference is invalid')
            result.append(str(BASE / 'candidates' / image))
        elif record.get('origin') != 'legacy-adoption':
            raise Refused('controller generation has no image or legacy adoption record')
        previous = record.get('previous')
        if previous is None: return result
        if not isinstance(previous, dict): raise Refused('previous controller generation is invalid')
        record = previous
    raise Refused('controller history exceeds the inspection bound; preserve all images')


def controller_qualification_references():
    result = []
    directory = BASE.parent / 'klokast-infrastructure/qualification'
    if not directory.exists(): return result
    safe(directory, True)
    for work in directory.iterdir():
        safe(work, True)
        request = read(work / 'request.json')
        if (not OP.fullmatch(work.name) or request.get('operation_id') != work.name or
                not OP.fullmatch(request.get('image', ''))):
            raise Refused('controller qualification record is invalid; preserve images')
        evidence = work / 'result.json'
        if evidence.exists():
            value = read(evidence)
            if (value.get('kind') == 'klokast.ops-replacement-qualification.v1' and
                    value.get('image') == request['image'] and value.get('box') == request.get('box') and
                    value.get('complete') is True and value.get('test_disks_removed') is True):
                continue
        result.append(str(BASE / 'candidates' / request['image']))
    return result


def references():
    texts = recovery_references()
    texts.extend(controller_qualification_references())
    trial_cleanup()
    live = command(['/usr/sbin/xl', 'list', '-l'])
    guests = json.loads(live)
    if not isinstance(guests, list) or not any(v.get('domid') == 0 for v in guests):
        raise Refused('Xen reference inventory is incomplete')
    if any(v.get('config', {}).get('c_info', {}).get('name', '').startswith(
            ('vm-build-', 'vm-test-', 'vm-openrc-', 'vm-personalize-', 'vm-profile-', 'vm-restore-',
             'vm-backup-fixture-', 'vm-maintenance-backup-', 'vm-recovery-test-', 'finalize-')) for v in guests):
        raise Refused('a disposable operation is still running')
    texts.append(live)
    for path in (BASE.parent / 'klokast-infrastructure').glob('*/assignment.json'):
        record = read(path)
        if record.get('role') == 'ops' and (record.get('origin') == 'legacy-adoption' or record.get('image')):
            if record.get('kind') != 'klokast.infrastructure-assignment.v1' or record.get('stage') != 'ready':
                raise Refused('controller assignment is incomplete; preserve all images')
            texts.extend(controller_image_references(record))
            continue
        if (record.get('kind') != 'klokast.infrastructure-assignment.v1' or
                record.get('stage') not in ('allocated', 'copied', 'ready', 'retired-test-only', 'retired-failed') or
                not OP.fullmatch(record.get('operation_id', ''))):
            raise Refused('infrastructure assignment is incomplete; retain its source image')
        if record['stage'] in ('retired-test-only', 'retired-failed'):
            disk = Path('/dev/vg0/lv_air') if record['stage'] == 'retired-test-only' else Path(record.get('archived_lv', ''))
            if (record.get('role') != 'air' or
                    (record['stage'] == 'retired-failed' and not re.fullmatch('/dev/vg0/lv_air_failed_[0-9a-f]{32}', str(disk))) or
                    disk.exists() or disk.is_symlink() or (path.parent / 'air.cfg').exists() or
                    (path.parent / 'air.cfg').is_symlink()):
                raise Refused('retired infrastructure still has resources; preserve its image')
        elif record['stage'] != 'ready':
            texts.append(str(BASE / 'candidates' / record['operation_id']))
    for path in (BASE.parent / 'klokast-infrastructure').glob('*/replacement.json'):
        record = read(path)
        if record.get('kind') != 'klokast.ops-replacement.v1' or not OP.fullmatch(record.get('operation_id', '')):
            raise Refused('controller replacement record is invalid; preserve all images')
        texts.extend(controller_image_references(record))
    for path in Path('/etc/xen').glob('*.cfg'):
        safe(path, maximum=1024 * 1024)
        texts.append(path.read_text())
    for path in Path('/sys/block').glob('loop*/loop/backing_file'):
        texts.append('/' + path.read_text().strip().lstrip('/'))
    pattern = re.escape(str(BASE)) + r'/(?:candidates|staging)/([0-9a-f]{24})(?:/|\b)'
    return {match for text in texts for match in re.findall(pattern, text)}


def checked_file(path, expected):
    if (not isinstance(expected, dict) or set(expected) != {'sha256', 'bytes'} or
            not isinstance(expected['sha256'], str) or not HASH.fullmatch(expected['sha256']) or
            type(expected['bytes']) is not int or not 0 < expected['bytes'] <= 8 * 1024**3):
        raise Refused('artifact checksum or size is invalid')
    info = safe(path, maximum=8 * 1024**3)
    if info.st_size != expected['bytes']:
        raise Damaged('artifact size differs from its recorded build')
    value = hashlib.sha256()
    with path.open('rb') as stream:
        for chunk in iter(lambda: stream.read(1024 * 1024), b''):
            value.update(chunk)
    after = path.lstat()
    if ((info.st_dev, info.st_ino, info.st_size, info.st_mtime_ns) !=
            (after.st_dev, after.st_ino, after.st_size, after.st_mtime_ns)):
        raise Refused('artifact changed during inspection')
    if value.hexdigest() != expected['sha256']:
        raise Damaged('artifact changed since its recorded build')
    return dict(expected, path=str(path.relative_to(BASE)), allocated_bytes=info.st_blocks * 512)


def verify(box, current):
    """Read one exact candidate under the caller's build lock; never delete it."""
    if not isinstance(current, str) or not OP.fullmatch(current):
        raise Refused('the exact saved candidate is required')
    result = {'box': box, 'current': current, 'verified': False}
    directory = BASE / 'candidates' / current
    try:
        safe(BASE / 'candidates', True)
        safe(directory, True)
        if any(v.name not in {'candidate.json', 'root', 'kernel', 'initramfs'} for v in directory.iterdir()):
            raise Refused('saved candidate contains unknown files')
        candidate = read(directory / 'candidate.json')
        if (candidate.get('kind') != 'klokast.vm-template-candidate.v1' or
                candidate.get('box') != box or candidate.get('operation_id') != current or
                candidate.get('accepted') is not False or candidate.get('success') is not True or
                candidate.get('validation') != 'base-boot-tested' or
                set(candidate.get('artifacts', {})) != {'root', 'kernel', 'initramfs'}):
            raise Refused('saved candidate metadata is invalid')
        for name, expected in candidate['artifacts'].items():
            checked_file(directory / name, expected)
    except FileNotFoundError:
        return {**result, 'reason': 'missing'}
    except Damaged:
        return {**result, 'reason': 'damaged'}
    return {**result, 'verified': True, 'candidate_sha256': digest(candidate),
            'artifacts': candidate['artifacts']}


def input_scope(work, request):
    value = read(work / 'inputs.json')
    if (value.get('kind') != 'klokast.vm-template-inputs.v1' or
            value.get('inputs_sha256') != request['inputs_sha256'] or
            value['inputs_sha256'] != digest({k: v for k, v in value.items() if k != 'inputs_sha256'}) or
            not isinstance(value.get('profile'), str) or
            not re.fullmatch('[a-z0-9][a-z0-9-]{0,63}', value['profile']) or
            not isinstance(value.get('architecture'), str) or
            not re.fullmatch('[a-z0-9_]{1,32}', value['architecture'])):
        raise Refused('candidate profile or architecture lacks matching input evidence')
    return (value['profile'], value['architecture'])


def require_qualification(candidate):
    release = read(candidate['work'] / 'release-evidence.json')
    if ('app_test' in candidate['request'] or release.get('kind') != 'klokast.vm-release.v2' or
            release.get('inputs_sha256') != candidate['request']['inputs_sha256'] or
            release.get('profile') != candidate['scope'][0] or
            release.get('architecture') != candidate['scope'][1] or
            release.get('artifacts') != candidate['record']['artifacts'] or
            not isinstance(release.get('component_sha256'), dict) or
            release.get('component_sha256', {}).get('candidate') != digest(candidate['record']) or
            release.get('release_sha256') != digest({k: v for k, v in release.items() if k != 'release_sha256'})):
        raise Refused('candidate has no matching controller qualification')


def plan(box, current, referenced):
    if not isinstance(current, str) or not OP.fullmatch(current):
        raise Refused('the exact qualified current candidate is required')
    candidates, unknown = [], []
    for directory in sorted((BASE / 'candidates').iterdir()):
        operation = directory.name
        try:
            if not OP.fullmatch(operation):
                raise Refused('unknown candidate directory name')
            safe(directory, True)
            if {v.name for v in directory.iterdir()} != {'candidate.json', 'root', 'kernel', 'initramfs'}:
                raise Refused('candidate contains missing or unknown files')
            record = read(directory / 'candidate.json')
            work = BASE / 'staging' / operation
            if not work.exists():
                # Successful builds remove input staging after fetching these
                # public receipts to the controller. The setup play stages
                # that evidence again; the candidate manifest must match it.
                work = BASE / 'cleanup-evidence' / operation
            safe(work, True)
            request = read(work / 'request.json')
            lifecycle, test = read(work / 'lifecycle.json'), read(work / 'test-lifecycle.json')
            origin = record.get('box')
            if (record.get('kind') != 'klokast.vm-template-candidate.v1' or record.get('accepted') is not False or
                    record.get('success') is not True or record.get('validation') != 'base-boot-tested' or
                    not isinstance(origin, str) or not BOX.fullmatch(origin) or record.get('operation_id') != operation or
                    request.get('kind') != 'klokast.vm-template-build-request.v1' or request.get('box') != origin or
                    request.get('operation_id') != operation or record.get('inputs_sha256') != request.get('inputs_sha256') or
                    record != read(work / 'candidate.json') or
                    lifecycle.get('stage') != 'cleaned' or lifecycle.get('domain') != 'vm-build-' + operation or
                    test.get('stage') != 'cleaned' or test.get('domain') != 'vm-test-' + operation or
                    set(record.get('artifacts', {})) != {'root', 'kernel', 'initramfs'}):
                raise Refused('candidate has incomplete build or cleanup evidence')
            for key, prefix in (('openrc_domain', 'vm-openrc-'), ('personalize_domain', 'vm-personalize-'),
                                ('profile_domain', 'vm-profile-'), ('restore_domain', 'vm-restore-')):
                if key in test and test[key] != prefix + operation:
                    raise Refused('candidate cleanup names another operation')
            candidate = {'operation_id': operation, 'record': record, 'request': request,
                         'work': work, 'scope': input_scope(work, request)}
            # Legacy copies retain their original box identity. They can be
            # retired here, but cannot become a local replacement image.
            if origin != box:
                require_qualification(candidate)
            candidates.append(candidate)
        except (Refused, OSError, ValueError, KeyError, TypeError) as error:
            unknown.append({'operation_id': operation, 'reason': str(error)[:240]})
    known = {v['operation_id'] for v in candidates}
    if current not in known:
        raise Refused('current candidate has no complete checked evidence')
    selected = next(v for v in candidates if v['operation_id'] == current)
    if selected['record']['box'] != box:
        raise Refused('current replacement must have been built on this box')
    require_qualification(selected)
    # Do not retire an older good image unless the complete replacement exists.
    for name, expected in selected['record']['artifacts'].items():
        checked_file(BASE / 'candidates' / current / name, expected)
    kept = {current} | set(referenced) | {v['operation_id'] for v in candidates
                                        if v['scope'] != selected['scope']}
    removals = []
    for candidate in candidates:
        operation, record, request = candidate['operation_id'], candidate['record'], candidate['request']
        if operation in referenced or candidate['scope'] != selected['scope']:
            continue
        files = []
        try:
            if operation not in kept:
                files.extend(checked_file(BASE / 'candidates' / operation / name, record['artifacts'][name])
                             for name in ('root', 'kernel', 'initramfs'))
            # Build inputs are disposable. Keep all compact evidence.
            inputs = {'capsule.tar': request['capsule'], 'bootstrap-kernel': request['bootstrap']['kernel'],
                      'bootstrap-initramfs': request['bootstrap']['initramfs']}
            if 'app_test' in request:
                inputs['app-test.tar'] = request['app_test']['capsule']
            for name, expected in inputs.items():
                path = BASE / 'staging' / operation / name
                if path.exists() or path.is_symlink():
                    files.append(checked_file(path, expected))
            if files:
                removals.append({'operation_id': operation, 'candidate_sha256': digest(record),
                                 'retire_candidate': operation not in kept, 'files': files})
        except (Refused, OSError, ValueError, KeyError, TypeError) as error:
            unknown.append({'operation_id': operation, 'reason': str(error)[:240]})
    result = {'kind': 'klokast.vm-template-cleanup-plan.v1', 'box': box, 'current': current,
              'profile': selected['scope'][0], 'architecture': selected['scope'][1],
              'kept_candidates': sorted(kept & known), 'references': sorted(referenced),
              'unknown_unchanged': unknown, 'removals': removals,
              'allocated_bytes': sum(v['allocated_bytes'] for op in removals for v in op['files'])}
    result['plan_sha256'] = digest(result)
    return result


def apply(proposal, expected):
    if proposal['plan_sha256'] != expected:
        raise Refused('cleanup plan changed; inspect the new plan before retrying')
    directory = BASE / 'cleanup' / expected
    directory.mkdir(mode=0o700)
    store(directory / 'plan.json', proposal)
    for item in proposal['removals']:
        operation = item['operation_id']
        candidate = BASE / 'candidates' / operation
        record = read(candidate / 'candidate.json')
        if digest(record) != item['candidate_sha256']:
            raise Refused('candidate metadata changed before removal')
        # Retain source evidence before the first unlink. An interrupted
        # cleanup cannot silently lose its exact manifest or selected file set.
        store(directory / (operation + '-candidate.json'), record)
        for entry in item['files']:
            path = BASE / entry['path']
            if checked_file(path, {k: entry[k] for k in ('sha256', 'bytes')}) != entry:
                raise Refused('artifact metadata changed before removal')
            path.unlink(); syncdir(path.parent)
        if item['retire_candidate']:
            if {p.name for p in candidate.iterdir()} != {'candidate.json'}:
                raise Refused('candidate acquired unknown files; metadata retained in place')
            (candidate / 'candidate.json').unlink(); candidate.rmdir(); syncdir(candidate.parent)
        store(directory / (operation + '-complete.json'), {'removed': True, 'operation_id': operation})
    result = {'complete': not proposal['unknown_unchanged'], 'plan_sha256': expected,
              'current': proposal['current'], 'kept_candidates': proposal['kept_candidates'],
              'unknown_unchanged': proposal['unknown_unchanged'],
              'retired_candidates': [v['operation_id'] for v in proposal['removals'] if v['retire_candidate']],
              'allocated_bytes_removed': proposal['allocated_bytes']}
    store(directory / 'complete.json', result)
    return result


def preflight(box):
    # Reuse the conservative reader: pending transactions, invalid protected
    # records, and existing disposable guests stop new builds before downloads.
    references()
    info = {key.strip(): value.strip() for key, value in
            (line.split(':', 1) for line in command(['/usr/sbin/xl', 'info']).splitlines() if ':' in line)}
    free_memory = int(info.get('free_memory', '0'))
    free_bytes = shutil.disk_usage(BASE).free
    if free_memory < 5120:
        raise Refused('image construction requires 5120 MiB free Xen memory')
    if free_bytes < 18 * 1024**3:
        raise Refused('image construction requires 18 GiB free artifact storage')
    return {'box': box, 'ready': True, 'free_memory_mib': free_memory, 'free_artifact_bytes': free_bytes}


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument('action', choices=('plan', 'apply', 'verify', 'preflight'))
    parser.add_argument('--box', required=True)
    parser.add_argument('--current', required=True)
    parser.add_argument('--plan-sha256')
    args = parser.parse_args()
    if (os.geteuid() != 0 or not re.fullmatch('[a-z0-9][a-z0-9-]{0,30}', args.box) or
            socket.gethostname().split('.')[0] != args.box + '-dom0' or
            'control_d' not in Path('/proc/xen/capabilities').read_text()):
        raise Refused('run setup cleanup as root on the selected dom0')
    if (args.action == 'apply') != bool(args.plan_sha256) or (args.plan_sha256 and not HASH.fullmatch(args.plan_sha256)):
        raise Refused('apply requires the exact inspected plan checksum')
    os.umask(0o077)
    command(['/bin/mountpoint', '-q', '/mnt/dom0_data'])
    paths = (BASE,)
    if args.action != 'verify':
        paths += (BASE / 'candidates', BASE / 'staging')
    for path in paths:
        safe(path, True)
        if path.stat().st_dev != Path('/mnt/dom0_data').stat().st_dev:
            raise Refused('cleanup paths must stay on persistent dom0 storage')
    descriptor = os.open(BASE / 'build.lock', os.O_RDWR | os.O_CREAT | os.O_NOFOLLOW, 0o600)
    try:
        safe(BASE / 'build.lock')
        fcntl.flock(descriptor, fcntl.LOCK_EX | fcntl.LOCK_NB)
        if args.action == 'preflight':
            print(canonical(preflight(args.box)).decode())
        elif args.action == 'verify':
            print(canonical(verify(args.box, args.current)).decode())
        else:
            referenced = references()
            proposal = plan(args.box, args.current, referenced)
            if args.action == 'plan':
                print(canonical(proposal).decode())
            else:
                (BASE / 'cleanup').mkdir(mode=0o700, exist_ok=True); safe(BASE / 'cleanup', True)
                print(canonical(apply(proposal, args.plan_sha256)).decode())
    finally:
        os.close(descriptor)


if __name__ == '__main__':
    try:
        main()
    except (Refused, OSError, ValueError, KeyError, TypeError, subprocess.TimeoutExpired) as error:
        print('vm-template-cleanup: ' + str(error), file=__import__('sys').stderr)
        raise SystemExit(1)
