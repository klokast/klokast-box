#!/usr/bin/env python3
"""Record exact absence after a diagnostic candidate LV create failed."""
import argparse
import json
import os
from pathlib import Path
import re
import socket
import stat
import sys

BASE = Path('/mnt/dom0_data/klokast-router-candidate-tests')


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument('--box', required=True)
    parser.add_argument('--operation-id', required=True)
    args = parser.parse_args()
    if (os.geteuid() != 0 or not re.fullmatch('[a-z0-9][a-z0-9-]{0,30}', args.box) or
            not re.fullmatch('[0-9a-f]{24}', args.operation_id) or
            socket.gethostname().split('.')[0] != args.box + '-dom0' or
            Path('/sys/hypervisor/uuid').read_text().strip() != '00000000-0000-0000-0000-000000000000'):
        raise RuntimeError('candidate test reconciliation requires root on the exact dom0')
    work = BASE / args.operation_id
    for directory in (BASE, work):
        info = directory.lstat()
        if not stat.S_ISDIR(info.st_mode) or info.st_uid != 0 or info.st_mode & 0o022:
            raise RuntimeError('candidate test directory is not private root-owned storage')
    sys.path.insert(0, str(work))
    import router_candidate_disk as disk
    from xen_build_runtime import safe_directory
    safe_directory(BASE); safe_directory(work)
    value = disk.record(work, args.operation_id)
    if value['stage'] not in ('planned','aborted') or disk.observed(args.operation_id) is not None:
        raise RuntimeError('candidate test does not have an absent unallocated LV')
    disk.retire(work, args.operation_id, box=args.box)
    if disk.record(work, args.operation_id)['stage'] != 'aborted':
        raise RuntimeError('candidate test absence was not recorded')
    print(json.dumps({'kind':'klokast.router-candidate-test-abort.v1',
                      'box':args.box, 'operation_id':args.operation_id, 'stage':'aborted'}))


if __name__ == '__main__':
    try:
        main()
    except Exception as error:
        print('Router candidate test reconciliation refused: ' + str(error), file=sys.stderr)
        raise SystemExit(1)
