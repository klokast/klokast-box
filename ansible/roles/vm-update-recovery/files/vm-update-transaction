#!/usr/bin/env python3
"""Recover one controller-staged VM disk switch, without guest access.

The controller must stage a protected request before arm. This helper does not
select templates, create authority, mount filesystems, or allocate disks.
Recovery follows the recorded contract version. Retained-disk transactions
keep the candidate selected after a possible start. Historical transactions
retain their original recovery rules.
"""
import argparse
import sys
import os
import time
from pathlib import Path
sys.path.insert(0, str(Path(__file__).resolve().parent))
import vm_update_engine as engine
from vm_update_native import Refused

def main(argv=None):
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument('action', choices=('recover',
                                           'status', 'watch', 'boot-recover', 'fence-autostart', 'check-storage', 'router-owner',
                                           'assignment-status', 'source-status', 'replacement-source-status', 'reconcile-assignment', 'converged'))
    parser.add_argument('--operation-id')
    parser.add_argument('--role')
    parser.add_argument('--configuration')
    parser.add_argument('--request-sha256')
    parser.add_argument('--intent-sha256')
    parser.add_argument('--runtime-state', choices=('running', 'stopped'))
    args = parser.parse_args(argv)
    if args.role and args.action not in {'assignment-status', 'source-status', 'replacement-source-status', 'reconcile-assignment', 'converged'}:
        raise engine.Refused('a role selector is only valid for assignment commands')
    if args.action != 'reconcile-assignment' and any((args.request_sha256, args.intent_sha256, args.runtime_state)):
        raise engine.Refused('runtime intent is only valid for assignment reconciliation')
    if args.configuration and args.action != 'converged':
        raise engine.Refused('configuration is only valid for convergence publication')
    os.umask(0o077)
    if args.action == 'fence-autostart':
        if os.geteuid() != 0 or 'control_d' not in Path('/proc/xen/capabilities').read_text():
            raise engine.Refused('autostart fencing requires dom0 root')
        engine.fence_autostart()
        return 0
    engine.require_dom0()
    if args.action == 'converged':
        if args.operation_id or args.role != 'ops' or not args.configuration:
            raise engine.Refused('convergence requires the current controller and its configuration')
        print(engine.canonical(engine.record_convergence(args.role, args.configuration)))
        return 0
    if args.action == 'router-owner':
        if args.operation_id or args.role:
            raise engine.Refused('router owner inspection accepts no selectors')
        print(engine.canonical(engine.router_owner()))
        return 0
    if args.action == 'reconcile-assignment':
        if args.operation_id or not args.role:
            raise engine.Refused('runtime reconciliation requires the current role assignment')
        print(engine.canonical(engine.reconcile_assignment(args.role, args.request_sha256, args.runtime_state, args.intent_sha256)))
        return 0
    if args.action == 'assignment-status':
        if args.operation_id or not args.role:
            raise engine.Refused('assignment status accepts only the selected shared VM role')
        print(engine.canonical(engine.assignment_status(args.role)))
        return 0
    if args.action in {'source-status', 'replacement-source-status'}:
        if args.operation_id or not args.role:
            raise engine.Refused('source status accepts only the selected shared VM role')
        print(engine.canonical(engine.source_status(args.role) if args.action == 'source-status' else engine.replacement_source_status(args.role)))
        return 0
    if args.action == 'check-storage':
        if args.operation_id:
            raise engine.Refused('storage verification accepts no selected operation')
        print(engine.canonical({'persistent_storage': True}))
        return 0
    if args.action == 'boot-recover':
        if args.operation_id:
            raise engine.Refused('boot recovery accepts no selected operation')
        # Boot fails closed if any journal cannot be validated. No guest
        # autostart is allowed to race an ambiguous interrupted transaction.
        # Never replay historical accepted records: only the role's current
        # pointer can choose its boot assignment.
        for pointer in sorted((engine.BASE / 'active').iterdir()):
            if pointer.name not in {role + '.json' for role in engine.ROLES}:
                raise engine.Refused('unexpected active transaction pointer')
            value = engine.read(pointer)
            if set(value) != {'operation_id', 'request_sha256'}:
                raise engine.Refused('active transaction pointer is invalid')
            request = engine.read(engine.BASE / 'operations' / value['operation_id'] / 'request.json') if engine.OP.fullmatch(value['operation_id']) else {}
            if pointer.name != request.get('role', '') + '.json':
                raise engine.Refused('active transaction pointer names a different guest')
            engine.invoke(value['operation_id'], 'boot-recover')
        return 0
    if not args.operation_id:
        raise engine.Refused('operation ID is required')
    if args.action == 'watch':
        request = engine.Transaction(engine.secure(engine.BASE / 'operations' / args.operation_id, True))
        deadline = time.monotonic() + request.replacement_seconds
        while True:
            state = engine.invoke(args.operation_id, 'status')
            if not state or state['stage'] in engine.TERMINAL:
                return 0
            if time.time() >= state['deadline'] or time.monotonic() >= deadline or engine.controller_lost(state, time.time()):
                print(engine.canonical(engine.invoke(args.operation_id, 'recover')))
                return 0
            time.sleep(min(5, max(0.1, state['deadline'] - time.time())))
    print(engine.canonical(engine.invoke(args.operation_id, args.action)))
    return 0



if __name__ == '__main__':
    try:
        raise SystemExit(main())
    except (Refused, OSError, ValueError, KeyError, TypeError, UnicodeError) as error:
        print('vm-update-transaction: ' + str(error), file=sys.stderr)
        raise SystemExit(1)
