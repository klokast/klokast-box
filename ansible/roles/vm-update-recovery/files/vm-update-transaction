#!/usr/bin/env python3
"""Recover one controller-staged shared-VM disk switch, without guest access.

The controller must stage a protected request before arm. This helper does not
select templates, create authority, mount filesystems, or allocate disks. Old
and candidate writable disks must be disjoint. Pre-acceptance recovery starts
the unchanged old disks; acceptance permanently forbids that rollback.
"""
import argparse
import sys
from pathlib import Path
sys.path.insert(0, str(Path(__file__).resolve().parent))
import vm_update_engine as engine
from vm_update_native import Refused

def main(argv=None):
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument('action', choices=('recover',
                                           'status', 'watch', 'boot-recover', 'fence-autostart', 'check-storage',
                                           'assignment-status', 'source-status', 'replacement-source-status', 'reconcile-assignment'))
    parser.add_argument('--operation-id')
    parser.add_argument('--role')
    parser.add_argument('--request-sha256')
    parser.add_argument('--intent-sha256')
    parser.add_argument('--runtime-state', choices=('running', 'stopped'))
    args = parser.parse_args(argv)
    return engine.dispatch(args)


if __name__ == '__main__':
    try:
        raise SystemExit(main())
    except (Refused, OSError, ValueError, KeyError, TypeError, UnicodeError) as error:
        print('vm-update-transaction: ' + str(error), file=sys.stderr)
        raise SystemExit(1)
