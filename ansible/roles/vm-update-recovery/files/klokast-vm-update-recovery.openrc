#!/sbin/openrc-run
description="Recover interrupted shared VM updates before guest autostart"

depend() {
    need localmount xenstored xenconsoled
    before xendomains
}

start() {
    ebegin "Verify and recover shared VM boot assignments"
    if /usr/local/sbin/vm-update-transaction boot-recover; then
        eend 0
        return 0
    fi
    # Ops and an unconverted router keep their independent recovery paths.
    # A router with a common pointer must also be fenced on uncertain recovery.
    eerror "VM recovery failed; managed guest autostart is fenced"
    /usr/local/sbin/vm-update-transaction fence-autostart || return 1
    logger -t klokast-vm-update-recovery "CRITICAL: VM recovery failed; managed service autostart fenced"
    eend 0
}
