#!/usr/bin/env python3
"""Test disk-switch recovery with new LVs and one networkless Xen guest.

This test never installs the production helper or edits /etc/xen. It substitutes
only the test domain name, test assignment directory, and persistence
interface. The native watchdog runs as a separate detached process. Disk checks,
native Xen transitions, and durable journals use the production transaction
implementation. It does not qualify application health.
"""
import argparse
import fcntl
import hashlib
from importlib.machinery import SourceFileLoader
import importlib.util
import json
import os
from pathlib import Path
import re
import shutil
import signal
import socket
import sys
import time
import uuid


def load(path):
    loader = SourceFileLoader('transaction', str(path))
    spec = importlib.util.spec_from_loader(loader.name, loader)
    module = importlib.util.module_from_spec(spec)
    loader.exec_module(module)
    return module


def test_backend(t, work, resources):
    """Keep test substitutions identical in the parent and detached watchdog."""
    t.BASE = work / 'state'; t.XEN = work / 'xen'
    t.HELPER = str(work / 'vm-update-recovery-test')
    native = t.Native()
    name, identities, allocated = resources['domain'], resources['uuids'], resources['disks']

    class TestNative(t.Native):
        interrupt_shutdown = False

        def inventory(self):
            rows = super().inventory()
            for row in rows:
                info = row['config']['c_info']
                if info['name'] == name:
                    if info['uuid'] not in identities.values():
                        raise RuntimeError('test domain UUID changed')
                    info['name'] = 'bak'
                elif info['name'] == 'bak':
                    info['name'] = 'production-bak'
            return rows

        def start(self, path):
            if not path.is_relative_to(work):
                raise RuntimeError('test cannot start a production configuration')
            content = path.read_text()
            for identity in identities.values():
                try:
                    config, disks = t.configuration(content, 'bak', identity)
                    break
                except t.Refused:
                    continue
            else:
                raise RuntimeError('test configuration does not have a recorded UUID')
            if any(p not in allocated for p in disks):
                raise RuntimeError('test configuration references a disk it did not allocate')
            config['name'] = name
            # The test guest has no network, credentials, or autostart entry.
            config['vif'] = []
            config['memory'] = 2048; config['maxmem'] = 2048
            output = work / 'disposable.cfg'
            t.atomic(output, ('\n'.join(k + ' = ' + repr(v) for k, v in config.items()) + '\n').encode())
            t.command(['xl', 'create', output])
            time.sleep(5)

        def stop(self, record, graceful):
            matches = [r for r in native.inventory() if r['domid'] == record['domid']]
            if (len(matches) != 1 or matches[0]['config']['c_info']['name'] != name or
                    matches[0]['config']['c_info']['uuid'] != record['config']['c_info']['uuid']):
                raise RuntimeError('test cannot stop a production domain')
            if graceful and type(self).interrupt_shutdown:
                type(self).interrupt_shutdown = False
                t.command(['xl', 'shutdown', str(record['domid'])])
                raise InterruptedError('test interruption after the native shutdown request')
            return super().stop(record, graceful)

        def persist(self):
            t.syncdir(t.XEN)  # Never writes the production apkovl.

    t.Native = TestNative
    return TestNative()


def worker():
    # No caller-selected path or production installation. Only this protected
    # disposable test's recorded disks and UUIDs are available to the worker.
    work = Path(__file__).resolve().parent
    if (work.parent != Path('/mnt/dom0_data/klokast-vm-recovery-tests') or
            not re.fullmatch(r'[0-9a-f]{24}', work.name) or os.geteuid() != 0):
        raise RuntimeError('watchdog test requires a protected disposable operation')
    t = load(work / 'vm-update-transaction')
    t.secure(work.parent, True); t.secure(work, True)
    resources = t.read(work / 'resources.json')
    if resources['domain'] != 'vm-recovery-test-' + work.name:
        raise RuntimeError('watchdog test domain does not match its directory')
    test_backend(t, work, resources)
    return t.main(sys.argv[1:])


def stop_watchdogs(t):
    """Finish all test workers before disks are removed, including on failure."""
    for directory in sorted((t.BASE / 'operations').iterdir()):
        if not (directory / 'journal.json').exists():
            continue
        identity = t.read(directory / 'journal.json').get('watcher')
        if not identity:
            continue
        backend = t.Native()
        if backend.watcher_alive(identity, directory.name):
            os.kill(identity['pid'], signal.SIGTERM)
        deadline = time.monotonic() + 10
        while backend.watcher_alive(identity, directory.name):
            if time.monotonic() >= deadline:
                raise RuntimeError('test watchdog did not stop; disks retained')
            time.sleep(0.1)
        try:
            os.waitpid(identity['pid'], os.WNOHANG)
        except ChildProcessError:
            pass


def accept_synthetic(t, directory, request):
    # This exercises transaction ordering only. These assertions are never
    # exported as release, network, data-copy, or application-test evidence.
    t.store(directory / 'checks.json', {'request_sha256': t.digest(request), 'checks': {
        k: True for k in ('boot', 'kernel_modules', 'tailscale', 'rootless_podman', 'firewall',
                         'no_application_qualification', 'data', 'application_images_unchanged', 'quarantine')}})
    for action in ('tested', 'accept', 'complete'):
        t.invoke(request['operation_id'], action)


def generation_chain(t, backend, create_request, identities, allocated):
    """Keep the native accepted pointer through success, failure, and retry."""
    first_write = b'generation-one-production-write\n'
    second_write = b'generation-two-production-write\n'
    def data_path(side):
        return next(p for p in allocated if p.endswith('_' + side + '_data'))
    def write(side, content):
        with open(data_path(side), 'r+b', buffering=0) as stream:
            stream.seek(8192); stream.write(content); os.fsync(stream.fileno())
    def unchanged(side, content):
        with open(data_path(side), 'rb') as stream:
            stream.seek(8192)
            if stream.read(len(content)) != content:
                raise RuntimeError('successive release recovery changed an accepted write')
    def selected(side, release, selection):
        assignment = t.assignment_status('bak', backend)
        if (assignment['vm_uuid'] != identities[side] or assignment['release_sha256'] != release or
                assignment['selection'] != selection or assignment['runtime'] != 'running' or
                assignment['configuration_drift'] or assignment['autostart_drift']):
            raise RuntimeError('successive release selected a stale or conflicting assignment')
    started = time.monotonic()
    seed, seed_request = create_request('old', 'new', '0' * 64)
    t.atomic(t.XEN / 'bak.cfg', (seed / 'old.cfg').read_bytes())
    (t.XEN / 'auto/bak.cfg').symlink_to('../bak.cfg')
    backend.start(seed / 'old.cfg')
    source = t.source_status('bak', backend)
    if (source['vm_uuid'] != identities['old'] or
            source['configuration_sha256'] != seed_request['old_config_sha256'] or
            source['disks'] != seed_request['old_disks'] or
            source['artifacts'] != seed_request['old_artifacts'] or
            source['autostart'] is not True or
            source['disk_mappings'] != {path: 'xvd' + letter for path, letter in
                                        zip(seed_request['old_disks'], 'ab')}):
        raise RuntimeError('native unmanaged source receipt differs from disposable Xen state')
    adoption = t.BASE / 'operations' / uuid.uuid4().hex[:24]
    adoption.mkdir()
    adoption_request = {'kind': 'klokast.vm-adoption.v1', 'operation_id': adoption.name,
                        'box': seed_request['box'], 'role': 'bak',
                        'engine_commit': seed_request['engine_commit'],
                        'policy_sha256': seed_request['policy_sha256'],
                        'qualification_sha256': 'e' * 64,
                        'source_evidence_sha256': t.digest(source),
                        'old_uuid': source['vm_uuid'],
                        'old_config_sha256': source['configuration_sha256'],
                        'old_disks': source['disks'], 'old_artifacts': source['artifacts'],
                        'autostart': True}
    t.atomic(adoption / 'old.cfg', (seed / 'old.cfg').read_bytes())
    t.store(adoption / 'request.json', adoption_request)
    t.invoke(adoption.name, 'adopt')
    adopted = t.assignment_status('bak', backend)
    if (adopted['stage'] != 'adopted' or adopted['vm_uuid'] != identities['old'] or
            adopted['disks'] != source['disks'] or adopted['configuration_drift'] or
            adopted['autostart_drift'] or adopted['runtime'] != 'running'):
        raise RuntimeError('native old-only adoption did not preserve the running guest')
    first, first_request = create_request('old', 'new', '1' * 64, continuing=True)
    for action in ('arm', 'stop', 'start'):
        t.invoke(first.name, action)
        if action == 'arm':
            previous = t.read(first / 'journal.json')['previous_assignment']
            if (previous['operation_id'] != adoption.name or
                    previous['release_sha256'] is not None):
                raise RuntimeError('first replacement lost the adopted old generation')
            try:
                t.source_status('bak', backend)
            except t.Refused as error:
                if 'unmanaged guest' not in str(error):
                    raise
            else:
                raise RuntimeError('source reader accepted a managed assignment')
    accept_synthetic(t, first, first_request)
    selected('new', '1' * 64, 'accepted')
    write('new', first_write)

    failed, failed_request = create_request('new', 'third', '2' * 64, continuing=True)
    for action in ('arm', 'stop', 'start'):
        t.invoke(failed.name, action)
    previous = t.read(failed / 'journal.json')['previous_assignment']
    if previous['operation_id'] != first.name or previous['release_sha256'] != '1' * 64:
        raise RuntimeError('next operation lost the accepted release identity')
    write('third', b'unaccepted-candidate-write\n')
    backend.stop(t.Transaction(failed, backend).guest(), False)
    t.command(['/usr/bin/python3', t.HELPER, 'boot-recover'], timeout=1800)
    if t.read(failed / 'journal.json')['stage'] != 'recovered':
        raise RuntimeError('successive release failure did not recover')
    selected('new', '1' * 64, 'recorded-previous')
    unchanged('new', first_write)

    retry, retry_request = create_request('new', 'third', '2' * 64, continuing=True)
    for action in ('arm', 'stop', 'start'):
        t.invoke(retry.name, action)
    previous = t.read(retry / 'journal.json')['previous_assignment']
    if previous['operation_id'] != failed.name or previous['release_sha256'] != '1' * 64:
        raise RuntimeError('retry did not use the recovered accepted generation')
    accept_synthetic(t, retry, retry_request)
    write('third', second_write)
    backend.stop(t.Transaction(retry, backend).guest(), False)
    t.command(['/usr/bin/python3', t.HELPER, 'boot-recover'], timeout=1800)
    backend.start(t.XEN / 'bak.cfg')
    selected('third', '2' * 64, 'accepted')
    unchanged('new', first_write)
    unchanged('third', second_write)

    stale, _ = create_request('old', 'new', '3' * 64)
    try:
        t.invoke(stale.name, 'arm')
    except t.Refused:
        if (stale / 'journal.json').exists():
            raise RuntimeError('stale generation was armed before its refusal')
    else:
        raise RuntimeError('a stale original generation was allowed to replace the accepted one')
    selected('third', '2' * 64, 'accepted')
    unchanged('third', second_write)
    return {'stage': 'generation-chain', 'accepted_releases': 2, 'failed_attempt_recovered': True,
            'old_only_adoption_tested': True,
            'retry_used_recovered_assignment': True, 'stale_generation_refused': True,
            'accepted_writes_preserved': True, 'assignment_verified': True,
            'source_inspection_tested': True,
            'elapsed_seconds': round(time.monotonic() - started, 3)}


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument('--box', required=True)
    parser.add_argument('--operation-id', required=True)
    parser.add_argument('--candidate-id', required=True)
    parser.add_argument('--watchdog-expiry', action='store_true',
                        help='also wait for the native 30-minute replacement deadline')
    parser.add_argument('--controller-loss', action='store_true',
                        help='also recover after the fixed 90-second controller heartbeat expiry')
    parser.add_argument('--generation-chain', action='store_true',
                        help='also test accepted release continuity, failed replacement, and retry')
    args = parser.parse_args()
    if (os.geteuid() != 0 or not re.fullmatch(r'[a-z0-9][a-z0-9-]{0,30}', args.box) or
            socket.gethostname().split('.')[0] != args.box + '-dom0' or
            any(not re.fullmatch(r'[0-9a-f]{24}', v) for v in (args.operation_id, args.candidate_id)) or
            'control_d' not in Path('/proc/xen/capabilities').read_text()):
        raise RuntimeError('recovery test requires the selected dom0 and new operation ID')
    os.umask(0o077)
    work = Path('/mnt/dom0_data/klokast-vm-recovery-tests') / args.operation_id
    t = load(work / 'vm-update-transaction')
    t.secure(work, True)
    if (work / 'state').exists():
        raise RuntimeError('recovery test operations cannot be reused')
    t.BASE = work / 'state'; t.XEN = work / 'xen'
    (t.BASE / 'operations').mkdir(parents=True)
    (t.BASE / 'active').mkdir()
    (t.XEN / 'auto').mkdir(parents=True)
    t.require_dom0()
    candidate = Path('/mnt/dom0_data/klokast-vm-templates/candidates') / args.candidate_id
    t.secure(candidate, True)
    # Use the builder's box-local lock, so disposable jobs cannot race their
    # memory and storage preflight checks on this box.
    lock = os.open(candidate.parent.parent / 'build.lock', os.O_RDWR | os.O_CREAT | os.O_NOFOLLOW, 0o600)
    fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
    manifest = t.read(candidate / 'candidate.json')
    native = t.Native()
    if manifest.get('validation') != 'base-boot-tested' or manifest.get('accepted') is not False:
        raise RuntimeError('test requires a base-boot-tested candidate')
    for name in ('root', 'kernel', 'initramfs'):
        path = candidate / name
        # The root is an opaque raw image. Never mount it on dom0.
        t.secure(path, limit=8 * 1024**3)
        result = hashlib.sha256()
        with path.open('rb') as stream:
            for block in iter(lambda: stream.read(1024 * 1024), b''): result.update(block)
        if {'sha256': result.hexdigest(), 'bytes': path.stat().st_size} != manifest['artifacts'][name]:
            raise RuntimeError('candidate artifact changed before the recovery test')
    vgs = json.loads(t.command(['vgs', '--reportformat', 'json', '--units', 'b', '--nosuffix',
                               '-o', 'vg_name,vg_free']))['report'][0]['vg']
    minimum_gib = 14 if args.generation_chain else 10
    if len(vgs) != 1 or int(float(vgs[0]['vg_free'])) < minimum_gib * 1024**3:
        raise RuntimeError(f'test requires one volume group with at least {minimum_gib} GiB free')
    vg = vgs[0]['vg_name'].strip()
    if not re.fullmatch(r'[A-Za-z0-9_+.-]+', vg):
        raise RuntimeError('invalid volume group name')
    info = {key.strip(): value.strip() for key, value in
            (line.split(':', 1) for line in t.command(['xl', 'info']).splitlines() if ':' in line)}
    if int(info.get('free_memory', '0').strip()) < 3072:
        raise RuntimeError('test requires 3 GiB of unallocated Xen memory')
    name = 'vm-recovery-test-' + args.operation_id
    existing = native.inventory()
    if any(r['config']['c_info']['name'] == name for r in existing):
        raise RuntimeError('test domain name is already in use')
    production = {r['config']['c_info']['name']: r['config']['c_info'].get('uuid') for r in existing}
    allocated, results = {}, []
    sides = ('old', 'new', 'third') if args.generation_chain else ('old', 'new')
    identities = {side: str(uuid.uuid4()) for side in sides}

    backend = test_backend(t, work, {'domain': name, 'uuids': identities, 'disks': allocated})
    def create_request(old_side, new_side, release, *, continuing=False, controller_loss=False):
        operation = uuid.uuid4().hex[:24]
        directory = t.BASE / 'operations' / operation; directory.mkdir()
        request = {'kind': 'klokast.vm-switch.v1', 'operation_id': operation, 'box': args.box,
                   'role': 'bak', 'engine_commit': 'a' * 40, 'policy_sha256': 'b' * 64,
                   'release_sha256': release, 'autostart': True,
                   'old_uuid': identities[old_side], 'new_uuid': identities[new_side]}
        if controller_loss:
            request.update(kind='klokast.vm-switch.v2', controller_timeout_seconds=90)
        for side, selected_side in (('old', old_side), ('new', new_side)):
            paths = ['/dev/' + vg + '/vmupdtest_' + args.operation_id + '_' + selected_side + '_' + disk for disk in ('os', 'data')]
            config = {'name': 'bak', 'type': 'pvh', 'uuid': identities[selected_side], 'memory': 2048,
                      'kernel': str(candidate / 'kernel'), 'ramdisk': str(candidate / 'initramfs'),
                      'extra': 'root=/dev/xvda rootfstype=ext4 rw modules=ext4 console=hvc0',
                      'disk': ['phy:' + p + ',xvd' + letter + ',w' for p, letter in zip(paths, 'ab')],
                      'vif': [], 'on_poweroff': 'destroy', 'on_reboot': 'destroy', 'on_crash': 'destroy'}
            content = ((t.XEN / 'bak.cfg').read_bytes() if continuing and side == 'old' else
                       ('\n'.join(k + ' = ' + repr(v) for k, v in config.items()) + '\n').encode())
            t.atomic(directory / (side + '.cfg'), content)
            request[side + '_config_sha256'] = hashlib.sha256(content).hexdigest()
            request[side + '_disks'] = {p: {k: allocated[p][k] for k in ('uuid', 'bytes')} for p in paths}
            request[side + '_artifacts'] = {str(candidate / n): manifest['artifacts'][n] for n in ('kernel', 'initramfs')}
        t.store(directory / 'request.json', request)
        return directory, request

    def interrupted(signum, frame):
        raise RuntimeError('disposable recovery test interrupted; cleaning its own resources')
    for signum in (signal.SIGINT, signal.SIGTERM):
        signal.signal(signum, interrupted)
    try:
        for side in sides:
            for disk, size in (('os', '4096M'), ('data', '16M')):
                lvname = 'vmupdtest_' + args.operation_id + '_' + side + '_' + disk
                path = '/dev/' + vg + '/' + lvname
                if Path(path).exists(): raise RuntimeError('test volume already exists')
                # Reused free extents can contain an old test's filesystem
                # signature. Only this newly allocated unique LV is wiped.
                t.command(['lvcreate', '--yes', '--wipesignatures', 'y', '-L', size, '-n', lvname, vg])
                allocated[path] = native.lv(path)
                t.store(work / 'resources.json', {'domain': name, 'uuids': identities, 'disks': allocated})
                if disk == 'os':
                    with (candidate / 'root').open('rb') as source, open(path, 'wb', buffering=0) as target:
                        shutil.copyfileobj(source, target, 1024 * 1024); os.fsync(target.fileno())
                else:
                    with open(path, 'wb', buffering=0) as target:
                        target.write((side + '-retained-data\n').encode()); os.fsync(target.fileno())
        scenarios = ['stopped', 'booted', 'accepted',
                     'restart-stopping', 'restart-stopped', 'restart-booted', 'restart-accepted']
        if args.watchdog_expiry:
            scenarios.append('watchdog-expiry')
        if args.controller_loss:
            scenarios.append('controller-loss')
        for scenario in scenarios:
            stage = scenario.removeprefix('restart-')
            directory, request = create_request('old', 'new', 'c' * 64, controller_loss=scenario == 'controller-loss')
            operation = directory.name
            t.atomic(t.XEN / 'bak.cfg', (directory / 'old.cfg').read_bytes())
            backend.start(directory / 'old.cfg')
            started = time.monotonic()
            t.invoke(operation, 'arm')
            if stage == 'stopping':
                t.Native.interrupt_shutdown = True
                try:
                    t.invoke(operation, 'stop')
                except InterruptedError:
                    pass
                else:
                    raise RuntimeError('shutdown interruption was not exercised')
            else:
                t.invoke(operation, 'stop')
            if stage not in {'stopping', 'stopped'}: t.invoke(operation, 'start')
            if stage == 'accepted':
                accept_synthetic(t, directory, request)
            if scenario == 'restart-accepted':
                # Stand in for writes admitted after production acceptance.
                # These bytes must remain on the selected disk after recovery.
                path = next(p for p in allocated if p.endswith('_new_data'))
                with open(path, 'r+b', buffering=0) as target:
                    target.seek(4096); target.write(b'accepted-production-write\n'); os.fsync(target.fileno())
            if scenario in {'watchdog-expiry', 'controller-loss'}:
                state = t.read(directory / 'journal.json')
                minimum_wait = 90 if scenario == 'controller-loss' else 1800
                expires = state['controller_seen_at'] + 90 if scenario == 'controller-loss' else state['deadline']
                t.store(work / 'waiting.json', {'operation_id': operation, 'deadline': expires,
                                               'watcher': state['watcher']})
                # Do not shorten deadlines or ask for recovery. The detached
                # worker must perform the disk switch on its own at expiry.
                while state['stage'] not in t.TERMINAL:
                    if time.time() >= expires + 1800 or time.monotonic() - started >= minimum_wait + 1800:
                        raise RuntimeError('native watchdog did not recover within its full budget')
                    if not backend.watcher_alive(state['watcher'], operation):
                        # A worker can finish between reading state and /proc.
                        state = t.read(directory / 'journal.json')
                        if state['stage'] != 'recovered':
                            raise RuntimeError('native watchdog exited before recovery')
                        break
                    time.sleep(2)
                    state = t.read(directory / 'journal.json')
                if state['stage'] != 'recovered' or time.monotonic() - started < minimum_wait:
                    raise RuntimeError('native watchdog failed or recovered before the deadline')
            elif scenario.startswith('restart-'):
                guest = t.Transaction(directory, backend).guest()
                if guest and stage != 'stopping':
                    backend.stop(guest, False)
                # This exercises the boot entry point in a new interpreter
                # after loss of the guest and all parent transaction objects.
                # It does not emulate the host's physical boot or OpenRC.
                t.command(['/usr/bin/python3', t.HELPER, 'boot-recover'], timeout=1800)
                if stage == 'accepted':
                    # Accepted recovery publishes the chosen definition.
                    # Normal Xen autostart is responsible for starting it.
                    backend.start(t.XEN / 'bak.cfg')
            else:
                t.invoke(operation, 'recover')
            # Re-open only the on-disk journal. No controller input is used.
            recovered = t.Transaction(directory, backend)
            guest = recovered.guest()
            expected = 'new' if stage == 'accepted' else 'old'
            if guest['config']['c_info']['uuid'] != identities[expected]:
                raise RuntimeError('recovery selected the wrong disk generation')
            assignment = t.assignment_status('bak', backend)
            if (assignment['selection'] != ('accepted' if expected == 'new' else 'recorded-previous') or
                    assignment['vm_uuid'] != identities[expected] or
                    assignment['configuration_drift'] or assignment['autostart_drift'] or
                    assignment['runtime'] != 'running'):
                raise RuntimeError('protected assignment differs from recovered Xen state')
            for path in allocated:
                if path.endswith('_data'):
                    side = next(v for v in sides if path.endswith('_' + v + '_data'))
                    with open(path, 'rb') as source:
                        if source.read(len(side) + 15) != (side + '-retained-data\n').encode():
                            raise RuntimeError('retained data changed during recovery')
            if scenario == 'restart-accepted':
                path = next(p for p in allocated if p.endswith('_new_data'))
                with open(path, 'rb') as source:
                    source.seek(4096)
                    if source.read(26) != b'accepted-production-write\n':
                        raise RuntimeError('accepted production write changed during boot recovery')
            if scenario == 'accepted':
                # Exercise approved runtime reconciliation independently of
                # release selection. Boot recovery must preserve stopped intent.
                stopped = t.reconcile_assignment('bak', t.digest(request), 'stopped', 'e' * 64, backend)
                if stopped['runtime'] != 'stopped' or stopped['autostart']:
                    raise RuntimeError('accepted runtime reconciliation did not stop the test guest')
                t.command(['/usr/bin/python3', t.HELPER, 'boot-recover'], timeout=1800)
                if recovered.guest() or (t.XEN / 'auto/bak.cfg').exists():
                    raise RuntimeError('boot recovery reversed approved stopped intent')
                # Rebuild missing generated configuration from the same record.
                (t.XEN / 'bak.cfg').unlink()
                running = t.reconcile_assignment('bak', t.digest(request), 'running', 'f' * 64, backend)
                if (running['vm_uuid'] != identities['new'] or running['configuration_drift'] or
                        running['release_sha256'] != request['release_sha256']):
                    raise RuntimeError('runtime reconciliation changed the accepted release')
                guest = recovered.guest()
            results.append({'stage': scenario, 'recovered_side': expected, 'data_unchanged': True,
                            'assignment_verified': True,
                            'elapsed_seconds': round(time.monotonic() - started, 3)})
            backend.stop(guest, True)
            # Cases are independent first-adoption fixtures, not successive
            # releases. Do not claim the initial old disks follow an accepted
            # candidate from the preceding case. Its terminal evidence remains.
            if t.read(directory / 'journal.json')['stage'] not in {'complete', 'recovered'}:
                raise RuntimeError('cannot reset a disposable case with pending recovery')
            (t.BASE / 'active/bak.json').unlink()
            t.syncdir(t.BASE / 'active')
        if args.generation_chain:
            results.append(generation_chain(t, backend, create_request, identities, allocated))
    finally:
        stop_watchdogs(t)
        matches = [r for r in native.inventory() if r['config']['c_info']['name'] == name]
        for record in matches:
            if record['config']['c_info']['uuid'] not in identities.values():
                raise RuntimeError('test cleanup refuses an unknown domain UUID')
            native.stop(record, False)
        for path, expected in allocated.items():
            if native.lv(path) != expected:
                raise RuntimeError('test cleanup refuses a changed disk identity')
            if any(path == d.get('pdev_path') for r in native.inventory() for d in r['config'].get('disks', [])):
                raise RuntimeError('test disk remains attached; cleanup stopped')
            t.command(['lvremove', '-f', path])
        current = {r['config']['c_info']['name']: r['config']['c_info'].get('uuid') for r in native.inventory()}
        if current != production:
            raise RuntimeError('domain inventory changed during the recovery test')
        t.store(work / 'cleanup.json', {'disks_removed': True, 'guest_absent': True, 'production_uuids_unchanged': True})
    # Publish success only after worker, guest, and LV cleanup all pass.
    result = {'kind': 'klokast.vm-recovery-test.v1', 'operation_id': args.operation_id,
              'success': True, 'tests': results, 'production_replacement': False,
              'watchdog_tested': args.watchdog_expiry, 'process_restart_tested': True,
              'controller_loss_tested': args.controller_loss,
              'generation_chain_tested': args.generation_chain,
              'runtime_reconciliation_tested': True,
              'dom0_reboot_tested': False, 'candidate_id': args.candidate_id,
              'candidate_sha256': t.digest(manifest),
              'transaction_sha256': hashlib.sha256((work / 'vm-update-transaction').read_bytes()).hexdigest(),
              'harness_sha256': hashlib.sha256((work / 'vm-update-recovery-test').read_bytes()).hexdigest()}
    t.store(work / 'result.json', result)
    print(t.canonical(result))
    os.close(lock)


if __name__ == '__main__':
    if len(sys.argv) > 1 and sys.argv[1] in {'watch', 'boot-recover'}:
        raise SystemExit(worker())
    main()
