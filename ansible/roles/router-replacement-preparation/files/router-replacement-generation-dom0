#!/usr/bin/env python3
"""Stage one proposed router generation without booting it."""
import argparse
import json
import os
from pathlib import Path
import sys

sys.dont_write_bytecode = True
sys.path.insert(0,str(Path(__file__).resolve().parent))
import router_replacement_generation as generation
import router_records as records


def main():
    os.umask(0o077)
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument('--box',required=True)
    parser.add_argument('--operation-id',required=True)
    parser.add_argument('--engine',required=True)
    args = parser.parse_args()
    storage = records.Records(args.box)
    work = storage.operation(args.operation_id)
    if Path(__file__).resolve().parent != work:
        raise RuntimeError('replacement generation helper is outside its exact operation directory')
    result = generation.execute(storage,args.operation_id,args.engine)
    records.write(work/'generation-stage-result.json',result)
    print(json.dumps(result,sort_keys=True))


if __name__ == '__main__':
    try:
        main()
    except Exception as error:
        print('Router proposed generation refused: '+str(error),file=sys.stderr)
        raise SystemExit(1)
