#!/usr/bin/env python3
"""Prepare one retained replacement disk without starting either router."""
import argparse
import json
import os
from pathlib import Path
import runpy
import sys

sys.dont_write_bytecode = True
sys.path.insert(0, str(Path(__file__).resolve().parent))
import router_replacement_preparation as replacement
import router_records as records


def main():
    os.umask(0o077)
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument('--box', required=True)
    parser.add_argument('--operation-id', required=True)
    parser.add_argument('--engine', required=True)
    parser.add_argument('--assemble-only', action='store_true')
    args = parser.parse_args()
    replacement.native.Native().guard(args.box, deadline=replacement.time.monotonic() + 30)
    storage = records.Records(args.box)
    work = storage.operation(args.operation_id)
    if Path(__file__).resolve().parent != work:
        raise RuntimeError('replacement preparation helper is outside its exact operation directory')
    if args.assemble_only:
        value = records.read(work / 'request.json')
        if value.get('box') != args.box or value.get('operation_id') != args.operation_id:
            raise RuntimeError('replacement input assembly targets another operation')
        assembler = records.secure(work / 'router-input-assembler.py')
        changed = runpy.run_path(str(assembler))['assemble_boot'](work, value)
        print(json.dumps({'kind':'klokast.router-replacement-input-assembly.v1', 'assembled':changed}))
        return
    result = replacement.execute(storage, args.operation_id, args.engine)
    records.write(work / 'replacement-preparation-result.json', result)
    print(json.dumps(result, sort_keys=True))


if __name__ == '__main__':
    try:
        main()
    except Exception as error:
        print('Router replacement preparation refused: ' + str(error), file=sys.stderr)
        raise SystemExit(1)
