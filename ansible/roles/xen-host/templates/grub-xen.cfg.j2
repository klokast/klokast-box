set timeout=3
set default=0

menuentry "Alpine Linux (Xen, from RAM)" {
    insmod multiboot2
    multiboot2 /boot/xen.gz dom0_mem=1024M,max:1024M loglvl=all guest_loglvl=all
    module2 /boot/vmlinuz-lts modules=loop,squashfs,sd-mod,usb-storage,nvme quiet {{ diskless_modloop_kernel_param | trim }} alpine_dev=LABEL={{ efi_partition_label }}{{ (' ' ~ (diskless_alpine_repo_kernel_param | trim)) if (diskless_alpine_repo_kernel_param | default('') | trim) else '' }}{{ (' ' ~ (diskless_apkovl_kernel_param | trim)) if (diskless_apkovl_kernel_param | default('') | trim) else '' }}
    module2 /boot/initramfs-lts
}

menuentry "Alpine Linux (Rescue, from RAM)" {
    linux /boot/vmlinuz-lts modules=loop,squashfs,sd-mod,usb-storage,nvme quiet {{ diskless_modloop_kernel_param | trim }} alpine_dev=LABEL={{ efi_partition_label }}{{ (' ' ~ (diskless_alpine_repo_kernel_param | trim)) if (diskless_alpine_repo_kernel_param | default('') | trim) else '' }}{{ (' ' ~ (diskless_apkovl_kernel_param | trim)) if (diskless_apkovl_kernel_param | default('') | trim) else '' }}
    initrd /boot/initramfs-lts
}
