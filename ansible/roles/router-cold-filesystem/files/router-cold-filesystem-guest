#!/usr/bin/env python3
"""Inspect one cold router backup in a networkless, read-only Xen guest."""
import hashlib
import json
import os
from pathlib import Path
import re
import stat
import subprocess
import time

JOB = Path('/dev/xvdc')
SOURCE = Path('/dev/xvda')
RESULT = Path('/dev/xvdb')
ROOT = Path('/run/router-cold-root')
FILES = ('etc/alpine-release', 'etc/network/interfaces', 'etc/dnsmasq.conf',
         'etc/nftables.nft', 'var/lib/tailscale/tailscaled.state')


def unique(pairs):
    value = {}
    for key, item in pairs:
        if key in value:
            raise RuntimeError('cold filesystem job contains duplicate fields')
        value[key] = item
    return value


def digest(value):
    return hashlib.sha256(json.dumps(value, sort_keys=True, ensure_ascii=False,
                                     separators=(',', ':')).encode()).hexdigest()


def parameters(content):
    value = {}
    for item in content.split():
        key, sep, part = item.partition('=')
        if sep and key.startswith('klokast_'):
            if key in value:
                raise RuntimeError('cold filesystem boot has duplicate identity fields')
            value[key] = part
    if set(value) != {'klokast_operation', 'klokast_inputs', 'klokast_job'}:
        raise RuntimeError('cold filesystem boot identity is incomplete')
    return value


def guard():
    if (os.geteuid() != 0 or Path('/sys/hypervisor/type').read_text().strip() != 'xen' or
            Path('/sys/hypervisor/uuid').read_text().strip() ==
            '00000000-0000-0000-0000-000000000000' or
            {item.name for item in Path('/sys/class/net').iterdir()} != {'lo'}):
        raise RuntimeError('cold filesystem proof requires a networkless Xen guest')
    if ({item.name for item in Path('/sys/class/block').glob('xvd*')
         if not re.fullmatch(r'xvda[0-9]+', item.name)} != {'xvda', 'xvdb', 'xvdc'} or
            any(path.is_symlink() or not stat.S_ISBLK(path.stat().st_mode)
                for path in (SOURCE, RESULT, JOB)) or
            len({path.stat().st_rdev for path in (SOURCE, RESULT, JOB)}) != 3 or
            Path('/sys/class/block/xvda/ro').read_text().strip() != '1' or
            Path('/sys/class/block/xvdb/ro').read_text().strip() != '0' or
            Path('/sys/class/block/xvdc/ro').read_text().strip() != '1'):
        raise RuntimeError('cold filesystem guest disks are not one read-only source and one result')
    with JOB.open('rb') as stream:
        value = json.loads(stream.read(32768).split(b'\0', 1)[0], object_pairs_hook=unique)
    fields = {'kind', 'box', 'operation_id', 'engine_commit', 'inputs_sha256',
              'metadata_sha256', 'disk_sha256', 'backup_uuid'}
    if (not isinstance(value, dict) or set(value) != fields or
            value['kind'] != 'klokast.router-cold-filesystem-job.v1' or
            not re.fullmatch(r'[a-z0-9][a-z0-9-]{0,30}', value['box']) or
            not re.fullmatch(r'[0-9a-f]{24}', value['operation_id']) or
            not re.fullmatch(r'[0-9a-f]{40}', value['engine_commit']) or
            any(not re.fullmatch(r'[0-9a-f]{64}', value[key]) for key in (
                'inputs_sha256', 'metadata_sha256', 'disk_sha256')) or
            not re.fullmatch(r'[A-Za-z0-9-]{1,64}', value['backup_uuid'])):
        raise RuntimeError('cold filesystem job has an invalid source or identity')
    boot = parameters(Path('/proc/cmdline').read_text())
    if boot != {'klokast_operation': value['operation_id'],
                'klokast_inputs': value['inputs_sha256'], 'klokast_job': digest(value)}:
        raise RuntimeError('cold filesystem boot selects another job')
    return value


def command(argv, deadline):
    remaining = min(120, deadline - time.monotonic())
    if remaining <= 0:
        raise RuntimeError('cold filesystem inspection exceeded its bounded time')
    try:
        value = subprocess.run(argv, capture_output=True, stdin=subprocess.DEVNULL,
                               timeout=remaining)
    except (OSError, subprocess.TimeoutExpired) as error:
        raise RuntimeError('cold filesystem command failed: ' + argv[0]) from error
    if value.returncode:
        raise RuntimeError('cold filesystem command returned an error: ' + argv[0])


def inspect():
    deadline = time.monotonic() + 300
    # -n forbids repair. noload also keeps ext4 from replaying its journal.
    command(['/sbin/e2fsck', '-fn', '/dev/xvda3'], deadline)
    ROOT.mkdir(mode=0o700)
    command(['/bin/mount', '-t', 'ext4', '-o', 'ro,noload,nodev,nosuid,noexec',
             '/dev/xvda3', str(ROOT)], deadline)
    try:
        for relative in FILES:
            path = ROOT / relative
            if (path.is_symlink() or not path.is_file() or
                    not 0 < path.stat().st_size <= 1024 * 1024):
                raise RuntimeError('cold filesystem lacks a required router recovery file')
        mounts = [line.split()[4] for line in Path('/proc/self/mountinfo').read_text().splitlines()]
        if mounts.count(str(ROOT)) != 1:
            raise RuntimeError('cold filesystem root mount is ambiguous')
    finally:
        command(['/bin/umount', str(ROOT)], deadline)
    if str(ROOT) in [line.split()[4] for line in Path('/proc/self/mountinfo').read_text().splitlines()]:
        raise RuntimeError('cold filesystem guest root remains mounted')


def main():
    os.umask(0o077)
    value = guard()
    result = {'kind': 'klokast.router-cold-filesystem-result.v1',
              'operation_id': value['operation_id'], 'inputs_sha256': value['inputs_sha256'],
              'job_sha256': digest(value), 'success': False,
              'readonly': False, 'root_verified': False}
    try:
        inspect()
        result.update(success=True, readonly=True, root_verified=True)
    except Exception as error:
        # The guest filesystem and its filenames cannot enter the public slot.
        result['error'] = 'cold router filesystem check failed (' + type(error).__name__ + ')'
    data = (json.dumps(result, sort_keys=True, separators=(',', ':')) + '\n').encode()
    if len(data) >= 1024 * 1024:
        raise RuntimeError('cold filesystem result exceeds its fixed slot')
    with RESULT.open('r+b', buffering=0) as stream:
        stream.write(data + b'\0')
        os.fsync(stream.fileno())
    return 0 if result['success'] else 1


if __name__ == '__main__':
    raise SystemExit(main())
