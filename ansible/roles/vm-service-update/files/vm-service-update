#!/usr/bin/python3
"""Dispatch bounded service operations through the existing VM transaction."""
import argparse
import fcntl
import json
import os
from pathlib import Path
import socket
import sys
import time

import vm_service_engine as engine
import vm_update_engine as t
import vm_service_retirement
import vm_dmz_creation


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument('--box', required=True); parser.add_argument('--role', choices=sorted(t.ROLES), required=True)
    parser.add_argument('--action', choices=('status', 'prepare', 'advance', 'checks', 'reboot-start', 'reboot-complete', 'abandon', 'retire', 'retire-plan', 'creation-evidence'), required=True)
    parser.add_argument('--inputs-sha256'); parser.add_argument('--operation'); parser.add_argument('--config'); parser.add_argument('--receipt')
    args = parser.parse_args(); os.umask(0o077); t.require_dom0()
    if socket.gethostname().split('.')[0] != args.box + '-dom0': raise RuntimeError('service update belongs to another box')
    if args.action == 'status':
        value = engine.status(args.box,args.role)
        if args.operation:
            if not t.OP.fullmatch(args.operation): raise RuntimeError('invalid service operation ID')
            path = t.BASE/'operations'/args.operation/'service.json'
            value['operation'] = engine.read(path) if path.exists() else None
            if value['operation']:
                value['operation_retired'] = vm_service_retirement.released(engine, path.parent, value['operation'])
        print(json.dumps(value)); return
    if args.action in ('retire', 'retire-plan'):
        if args.role not in ('vpn-egress','dmz','iot') or args.operation:raise RuntimeError('retirement requires only a VPN, DMZ or IoT role selector')
        with (engine.IMAGES.parent/'build.lock').open('a+') as lock:
            fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
            with t.budget(300), t.operation_lock(t.BASE):
                result=vm_service_retirement.retire(engine, args.box, args.action=='retire-plan', role=args.role)
        print(json.dumps(result,sort_keys=True));return
    if not t.OP.fullmatch(args.operation or ''): raise RuntimeError('service update requires its recorded operation ID')
    with (engine.IMAGES.parent / 'build.lock').open('a+') as lock:
        fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
        if args.action == 'creation-evidence':
            if args.role not in ('dmz','iot'):raise RuntimeError('creation evidence requires DMZ or IoT')
            with t.budget(300),t.operation_lock(t.BASE):
                result=vm_dmz_creation.evidence(engine,args.box,args.operation,engine.read(Path(args.config)),role=args.role)
            print(json.dumps(result,sort_keys=True));return
        if args.action == 'prepare':
            if not t.HEX.fullmatch(args.inputs_sha256 or ''): raise RuntimeError('frozen input checksum is required')
            with t.budget(1800), t.operation_lock(t.BASE):
                result = engine.prepare(args.box, args.role, args.operation, Path(args.config), Path(args.receipt), args.inputs_sha256)
        else:
            work = t.BASE / 'operations' / args.operation; state = engine.read(work / 'service.json')
            if state['box'] != args.box or state['role'] != args.role: raise RuntimeError('service operation target differs')
            journal = engine.read(work / 'journal.json') if (work / 'journal.json').exists() else None
            if args.action == 'abandon':
                result = engine.abandon(work,state)
                print(json.dumps(result,sort_keys=True)); return
            if args.action == 'advance':
                if journal is None: t.invoke(args.operation, 'arm')
                elif journal['stage'] == 'armed': t.invoke(args.operation, 'stop')
                elif journal['stage'] == 'stopped':
                    if state['stage'] != 'finalized':
                        with t.budget(max(0, journal['deadline'] - time.time() - 60)), t.operation_lock(t.BASE):
                            engine.finalize(work, state)
                    engine.release_slots(work)
                    t.invoke(args.operation, 'start')
                elif journal['stage'] in ('starting', 'booted'): t.invoke(args.operation, 'start')
                elif journal['stage'] == 'tested': t.invoke(args.operation, 'accept')
                elif journal['stage'] == 'accepted': t.invoke(args.operation, 'complete')
                elif journal['stage'] not in ('booted', 'complete'): raise RuntimeError('service requires recovery inspection')
            elif args.action == 'checks':
                if state['reboot_verification']['status'] != 'complete': raise RuntimeError('service reboot verification is incomplete')
                checks = engine.read(Path(args.config))
                engine.write(work / 'checks.json', {'request_sha256': t.digest(t.read(work / 'request.json')), 'checks': checks})
                t.invoke(args.operation, 'tested')
            else:
                tx = t.Transaction(work)
                if tx.journal['stage'] != 'booted' or tx.guest(('new',)) is None:
                    raise RuntimeError('reboot evidence requires the recorded running new generation')
                evidence = engine.read(Path(args.config)); verification = state['reboot_verification']
                if args.action == 'reboot-start':
                    if verification['status'] == 'required': state['reboot_verification'] = {'status': 'pending', 'before': evidence}
                elif (verification['status'] != 'pending' or evidence['boot_id'] == verification['before']['boot_id'] or
                      evidence['identity'] != verification['before']['identity']): raise RuntimeError('service reboot identity was not preserved')
                else: state['reboot_verification']['status'] = 'complete'
                engine.write(work / 'service.json', state)
            result = dict(engine.read(work / 'service.json'), journal=t.read(work / 'journal.json'))
    print(json.dumps(result, sort_keys=True))


if __name__ == '__main__':
    try: main()
    except (RuntimeError, OSError, ValueError, KeyError) as error:
        print('vm-service-update: ' + str(error), file=sys.stderr); raise SystemExit(1)
