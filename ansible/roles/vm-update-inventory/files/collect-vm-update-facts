#!/usr/bin/env python3
"""Bounded VM inspection. Do not emit credentials, container env, or app data."""

import argparse
from contextlib import ExitStack
import datetime
import hashlib
import json
import os
from pathlib import Path
import platform
import pwd
import re
import stat
import subprocess
import time


class HostInventoryError(ValueError):
    """A fixed diagnostic safe to emit without application contents or paths."""


def safe_path(value):
    return (isinstance(value, str) and value.startswith('/') and len(value) <= 4096 and
            all(p not in ('', '.', '..') for p in value[1:].split('/')) and
            all(32 <= ord(c) != 127 for c in value))


def package_paths(database):
    """Directory/file ownership hints only; this does not verify package bytes."""
    paths, directory = set(), None
    if not database or len(database) > 8 * 1024 * 1024:
        raise HostInventoryError('package ownership is unavailable')
    packages = 0
    for line in database.splitlines():
        if line.startswith('P:'):
            directory = None
            packages += 1
        elif line.startswith('F:'):
            directory = '/' + line[2:]
            if directory != '/' and not safe_path(directory):
                raise HostInventoryError('package directory is invalid')
            paths.add(directory)
        elif line.startswith('R:'):
            name = line[2:]
            if directory is None or '/' in name or not name:
                raise HostInventoryError('package filename is invalid')
            path = directory.rstrip('/') + '/' + name
            if not safe_path(path):
                raise HostInventoryError('package filename is unsafe')
            paths.add(path)
    if not packages or not paths:
        raise HostInventoryError('package ownership is incomplete')
    return paths


def host_accounts(content):
    result, names = [], set()
    if not content or len(content) > 65536:
        raise HostInventoryError('account inventory is unavailable')
    for line in content.splitlines():
        fields = line.split(':')
        if (len(fields) != 7 or not re.fullmatch('[a-zA-Z_][a-zA-Z0-9_.-]{0,63}', fields[0]) or
                fields[0] in names or any(not re.fullmatch('[0-9]{1,10}', v) for v in fields[2:4]) or
                any(int(v) >= 2**32 for v in fields[2:4]) or (fields[5] != '/' and not safe_path(fields[5])) or
                not safe_path(fields[6])):
            raise HostInventoryError('account inventory is invalid')
        names.add(fields[0])
        # Drop the password and GECOS fields on the guest.
        result.append({'name': fields[0], 'uid': int(fields[2]), 'gid': int(fields[3]),
                       'home': fields[5], 'shell': fields[6]})
    return sorted(result, key=lambda v: v['name'])


def host_tree(root, owned, mounts, graph_root, deadline):
    """Inspect metadata without reading app files or traversing other mounts.

    The Podman store has separate inventory. Package ownership is only a hint:
    package integrity and approved generated configuration remain unverified.
    """
    mount_paths = {m['path'] for m in mounts if m['path'] != '/'}
    rows, pending, count = [], [root], 0
    delegated = [{'path': p, 'reason': 'mount'} for p in sorted(mount_paths)]
    if graph_root and graph_root not in mount_paths:
        delegated.append({'path': graph_root, 'reason': 'podman-store'})
    topology = hashlib.sha256()
    while pending:
        if time.monotonic() >= deadline or count >= 100000 or len(rows) >= 8192:
            raise HostInventoryError('host metadata exceeds its time or entry limit')
        current = pending.pop()
        path = '/' + str(current.relative_to(root)) if current != root else '/'
        if path != '/' and not safe_path(path):
            raise HostInventoryError('host metadata contains an unsafe path')
        info = current.lstat()
        row = {'path': path, 'mode': info.st_mode, 'uid': info.st_uid, 'gid': info.st_gid}
        if stat.S_ISLNK(info.st_mode):
            row['link_sha256'] = hashlib.sha256(os.fsencode(os.readlink(current))).hexdigest()
        topology.update(json.dumps(row, sort_keys=True).encode() + b'\n')
        count += 1
        if path in mount_paths or path == graph_root:
            continue
        if path != '/' and path not in owned:
            rows.append(row)
            if stat.S_ISDIR(info.st_mode):
                # Unknown directory contents cannot become disposable merely
                # because the tree is large. Keep the whole root unresolved;
                # its adapter and copy inventory must later account for it.
                delegated.append({'path': path, 'reason': 'unclassified-directory'})
                continue
        if stat.S_ISDIR(info.st_mode):
            # Do not follow directory symlinks. Bound directory enumeration too.
            with os.scandir(current) as children:
                selected = []
                for child in children:
                    selected.append(Path(child.path))
                    if len(selected) + len(pending) + count > 100000:
                        raise HostInventoryError('host directory exceeds its entry limit')
            pending.extend(sorted(selected, reverse=True))
    return {'unowned_paths': sorted(rows, key=lambda v: v['path']), 'delegated_roots': sorted(delegated, key=lambda v: v['path']),
            'entries': count, 'topology_sha256': topology.hexdigest()}


def unowned_tree(root, delegated, mounts, graph_root, deadline, limit=8192):
    """Expand unresolved directory metadata without opening any file contents.

    Directory descriptors and no-follow opens prevent symlink substitution.
    Other filesystems and the separately inventoried Podman store stay excluded.
    A large tree fails independently of the shallow host inventory.
    """
    roots = sorted(v['path'] for v in delegated if v['reason'] == 'unclassified-directory')
    if any(not safe_path(path) for path in roots):
        raise HostInventoryError('unowned directory root is invalid')
    rows, excluded, output_bytes = [], [], 0
    boundaries = {v['path']: 'mount' for v in mounts if v['path'] != '/'}
    if graph_root and graph_root not in boundaries:
        boundaries[graph_root] = 'podman-store'
    root_fd = os.open(root, os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW)
    device = os.fstat(root_fd).st_dev

    def visit(parent, name, path, depth):
        nonlocal output_bytes
        if time.monotonic() >= deadline or len(rows) + len(excluded) >= limit or depth > 64:
            raise HostInventoryError('unowned directory metadata exceeds its time or entry limit')
        if not safe_path(path):
            raise HostInventoryError('unowned directory metadata contains an unsafe path')
        if path in boundaries:
            excluded.append({'path': path, 'reason': boundaries[path]})
            return
        info = os.stat(name, dir_fd=parent, follow_symlinks=False)
        if info.st_dev != device:
            raise HostInventoryError('unowned directory metadata encountered an unrecorded filesystem')
        row = {'path': path, 'mode': info.st_mode, 'uid': info.st_uid, 'gid': info.st_gid,
               'bytes': info.st_size, 'inode': info.st_ino, 'links': info.st_nlink, 'mtime_ns': info.st_mtime_ns}
        if stat.S_ISLNK(info.st_mode):
            row['link_sha256'] = hashlib.sha256(os.fsencode(os.readlink(name, dir_fd=parent))).hexdigest()
        output_bytes += len(json.dumps(row)) + 2
        if output_bytes > 4 * 1024 * 1024:
            raise HostInventoryError('unowned directory metadata exceeds its output limit')
        rows.append(row)
        if stat.S_ISDIR(info.st_mode):
            descriptor = os.open(name, os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW, dir_fd=parent)
            try:
                opened = os.fstat(descriptor)
                if (opened.st_dev, opened.st_ino) != (info.st_dev, info.st_ino):
                    raise HostInventoryError('unowned directory identity changed during collection')
                names = []
                with os.scandir(descriptor) as children:
                    for child in children:
                        names.append(child.name)
                        if len(names) + len(rows) + len(excluded) > limit:
                            raise HostInventoryError('unowned directory metadata exceeds its entry limit')
                for child in sorted(names):
                    visit(descriptor, child, path + '/' + child, depth + 1)
                if os.fstat(descriptor).st_mtime_ns != info.st_mtime_ns:
                    raise HostInventoryError('unowned directory changed during collection')
            finally:
                os.close(descriptor)
        after = os.stat(name, dir_fd=parent, follow_symlinks=False)
        if (info.st_dev, info.st_ino, info.st_mode, info.st_uid, info.st_gid, info.st_size, info.st_mtime_ns, info.st_nlink) != (
                after.st_dev, after.st_ino, after.st_mode, after.st_uid, after.st_gid, after.st_size, after.st_mtime_ns, after.st_nlink):
            raise HostInventoryError('unowned file metadata changed during collection')

    try:
        for path in roots:
            parts = path[1:].split('/')
            with ExitStack() as stack:
                parent = root_fd
                for part in parts[:-1]:
                    descriptor = os.open(part, os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW, dir_fd=parent)
                    stack.callback(os.close, descriptor)
                    if os.fstat(descriptor).st_dev != device:
                        raise HostInventoryError('unowned directory ancestor crossed a filesystem')
                    parent = descriptor
                visit(parent, parts[-1], path, len(parts))
    finally:
        os.close(root_fd)
    return {'roots': roots, 'entries': sorted(rows, key=lambda v: v['path']),
            'excluded': sorted(excluded, key=lambda v: v['path'])}


def collect_unowned(root, delegated, mounts, graph_root, deadline):
    result = {'kind': 'klokast.vm-unowned-tree.v1', 'complete': False, 'stable': False,
              'data_accounted': False}
    try:
        first = unowned_tree(root, delegated, mounts, graph_root, min(deadline, time.monotonic() + 8))
        second = unowned_tree(root, delegated, mounts, graph_root, min(deadline, time.monotonic() + 8))
        result.update(first, complete=True, stable=first == second)
        result['metadata_sha256'] = hashlib.sha256(json.dumps(first, sort_keys=True, separators=(',', ':')).encode()).hexdigest()
    except HostInventoryError as error:
        result['error'] = str(error)
    except (OSError, ValueError, UnicodeError):
        result['error'] = 'Unowned directory metadata is unavailable, changed, or unsafe.'
    return result


def maintenance_files(root, deadline, mounts=()):
    """Return script identities, never cron lines, environment, or file contents."""
    result, count = [], 0
    for relative in ('etc/init.d', 'etc/runlevels', 'etc/crontabs', 'etc/periodic', 'etc/local.d'):
        directory = root / relative
        if any(m['path'] != '/' and ('/' + relative == m['path'] or
                ('/' + relative).startswith(m['path'] + '/') or m['path'].startswith('/' + relative + '/')) for m in mounts):
            raise HostInventoryError('maintenance inventory crosses a separate mount')
        if not directory.exists():
            continue
        if not stat.S_ISDIR(directory.lstat().st_mode):
            raise HostInventoryError('maintenance directory is unsafe')
        pending = [directory]
        while pending:
            current = pending.pop()
            with os.scandir(current) as children:
                for child in children:
                    count += 1
                    if time.monotonic() >= deadline or count > 4096:
                        raise HostInventoryError('maintenance inventory exceeds its time or entry limit')
                    path = Path(child.path)
                    info = child.stat(follow_symlinks=False)
                    name = '/' + str(path.relative_to(root))
                    if not safe_path(name) or len(result) + len(pending) >= 4096:
                        raise HostInventoryError('maintenance inventory is unsafe or too large')
                    if stat.S_ISDIR(info.st_mode):
                        pending.append(path)
                    elif stat.S_ISREG(info.st_mode) and info.st_size <= 1024 * 1024:
                        # Open without following a link substituted during inspection.
                        fd = os.open(path, os.O_RDONLY | os.O_NOFOLLOW | os.O_NONBLOCK)
                        with os.fdopen(fd, 'rb') as stream:
                            opened = os.fstat(stream.fileno())
                            if (not stat.S_ISREG(opened.st_mode) or
                                    (opened.st_dev, opened.st_ino) != (info.st_dev, info.st_ino)):
                                raise HostInventoryError('maintenance file changed during inspection')
                            content = stream.read(1024 * 1024 + 1)
                        if len(content) > 1024 * 1024:
                            raise HostInventoryError('maintenance file exceeds its size limit')
                        result.append({'path': name, 'sha256': hashlib.sha256(content).hexdigest()})
                    elif stat.S_ISLNK(info.st_mode):
                        result.append({'path': name, 'link_sha256': hashlib.sha256(os.fsencode(os.readlink(path))).hexdigest()})
                    else:
                        raise HostInventoryError('maintenance inventory contains an unsupported file')
    return sorted(result, key=lambda v: v['path'])


def native_services(root, maintenance, deadline):
    """Read OpenRC markers without executing services or rebuilding dependencies.

    Markers are observations, not daemon-health checks. In particular, no
    marker does not prove stopped, and a started marker does not prove healthy.
    Anchor directory traversal on descriptors and never follow marker links.
    """
    services, topology, count = {}, hashlib.sha256(), 0
    states = ('started', 'starting', 'stopping', 'inactive', 'wasinactive', 'hotplugged', 'failed')

    def row(name):
        if not re.fullmatch('[a-zA-Z0-9][a-zA-Z0-9_.-]{0,127}', name):
            raise HostInventoryError('native service name is unsupported')
        if name not in services:
            if len(services) >= 1024:
                raise HostInventoryError('native service inventory exceeds its limit')
            services[name] = {'name': name, 'script': None, 'runlevels': [], 'markers': []}
        return services[name]

    for item in maintenance:
        parts = item['path'].split('/')
        if len(parts) == 4 and parts[1:3] == ['etc', 'init.d'] and not parts[3].endswith('.sh'):
            row(parts[3])['script'] = {k: v for k, v in item.items() if k != 'path'}
        elif parts[1:3] == ['etc', 'runlevels']:
            if (len(parts) != 5 or 'link_sha256' not in item or
                    not re.fullmatch('[a-zA-Z0-9][a-zA-Z0-9_.-]{0,127}', parts[3])):
                raise HostInventoryError('native service runlevel is unsupported')
            row(parts[4])['runlevels'].append(parts[3])

    with ExitStack() as stack:
        def directory(parent, name, optional=False):
            try:
                fd = os.open(name, os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW, dir_fd=parent)
            except FileNotFoundError:
                if optional:
                    return None
                raise
            stack.callback(os.close, fd)
            return fd

        def entries(fd):
            nonlocal count
            with os.scandir(fd) as children:
                for entry in children:
                    count += 1
                    if count > 4096 or time.monotonic() >= deadline:
                        raise HostInventoryError('native service inventory exceeds its time or entry limit')
                    yield entry

        def marker(fd, entry, state, prefix):
            # OpenRC writes links to init scripts. A non-link is not an empty
            # service state. Hash the link text without resolving its target.
            if not stat.S_ISLNK(entry.stat(follow_symlinks=False).st_mode):
                raise HostInventoryError('native service marker is unsupported')
            link = os.readlink(entry.name, dir_fd=fd)
            topology.update(json.dumps([prefix, entry.name, link]).encode() + b'\n')
            row(entry.name)['markers'].append(state)

        rootfd = directory(None, root)
        runfd = directory(rootfd, 'run')
        statefd = directory(runfd, 'openrc')
        for state in states:
            fd = directory(statefd, state, optional=state != 'started')
            if fd is not None:
                for entry in sorted(entries(fd), key=lambda e: e.name):
                    marker(fd, entry, state, state)
        scheduled = directory(statefd, 'scheduled', optional=True)
        if scheduled is not None:
            for parent in sorted(entries(scheduled), key=lambda e: e.name):
                row(parent.name)  # Validate and retain scheduling dependencies.
                fd = directory(scheduled, parent.name)
                for entry in sorted(entries(fd), key=lambda e: e.name):
                    marker(fd, entry, 'scheduled', 'scheduled/' + parent.name)
    if not services:
        raise HostInventoryError('native service inventory is empty')
    for item in services.values():
        item['runlevels'] = sorted(set(item['runlevels']))
        item['markers'] = sorted(set(item['markers']))
    return {'kind': 'klokast.vm-native-services.v1', 'health_verified': False,
            'services': sorted(services.values(), key=lambda v: v['name']),
            'markers_sha256': topology.hexdigest()}


def no_application_process_role(row, argv):
    """Identify fixed OS commands without emitting command lines or secrets."""
    if row['executable_deleted']:
        return 'unknown'
    if row['kernel_thread'] and row['uids'] == [0] * 4:
        return 'kernel-thread'
    if row['executable'] == '/bin/busybox' and row['uids'] == [0] * 4:
        if row['pid'] == 1 and argv in ([b'init'], [b'/sbin/init']):
            return 'os-init'
        if (row['parent_pid'] == 1 and len(argv) == 3 and argv[0] == b'/sbin/getty' and
                argv[1] == b'38400' and re.fullmatch(b'tty[1-6]', argv[2])):
            return 'console-getty'
    if (row['executable'] == '/usr/bin/catatonit' and row['parent_pid'] == 1 and
            len(set(row['uids'])) == 1 and row['uids'][0] >= 1000 and
            argv in ([b'/usr/bin/catatonit', b'-P'], [b'catatonit', b'-P'])):
        return 'podman-pause'
    # The observer verifies parent/child relationships separately. These roles
    # still need configuration and store qualification in the outer report.
    if row['executable'] == '/sbin/supervise-daemon' and row['service'] == 'tailscale' and row['uids'] == [0] * 4:
        return 'tailscale-supervisor'
    if row['executable'] == '/usr/sbin/tailscaled' and row['uids'] == [0] * 4:
        return 'tailscale-daemon'
    return 'unknown'


def process_inventory(root, services, deadline):
    """Account for live processes, including daemons with no OpenRC marker.

    Arguments and environment never leave the guest. Only a known service name
    is read from a supervise-daemon command line; all other arguments are dropped.
    """
    proc = root / 'proc'
    known = {v['name'] for v in services['services']}
    boot_id = (proc / 'sys/kernel/random/boot_id').read_text().strip()
    if not re.fullmatch(r'[0-9a-f]{8}(?:-[0-9a-f]{4}){3}-[0-9a-f]{12}', boot_id):
        raise HostInventoryError('process inventory has no valid boot identity')
    rows = []
    children = sorted((p for p in proc.iterdir() if p.name.isdigit()), key=lambda p: int(p.name))
    if not children or len(children) > 4096:
        raise HostInventoryError('process inventory is empty or exceeds its entry limit')

    def bounded(path, limit):
        with path.open('rb') as stream:
            data = stream.read(limit + 1)
        if len(data) > limit:
            raise HostInventoryError('process metadata exceeds its size limit')
        return data

    for directory in children:
        if time.monotonic() >= deadline:
            raise HostInventoryError('process inventory exceeds its time limit')
        before = bounded(directory / 'stat', 8192)
        # comm may contain spaces and parentheses. It is not emitted.
        prefix, separator, suffix = before.rpartition(b') ')
        fields = suffix.split()
        if not separator or len(fields) < 20 or not prefix.startswith(directory.name.encode() + b' ('):
            raise HostInventoryError('process identity fields are invalid')
        status = {}
        for line in bounded(directory / 'status', 16384).decode().splitlines():
            key, separator, value = line.partition(':')
            if key in ('Uid', 'Gid') and separator:
                if key in status:
                    raise HostInventoryError('process ownership is ambiguous')
                status[key] = [int(v) for v in value.split()]
        if set(status) != {'Uid', 'Gid'} or any(len(v) != 4 or any(n < 0 or n >= 2**32 for n in v) for v in status.values()):
            raise HostInventoryError('process ownership is incomplete')
        executable, deleted = None, False
        try:
            executable = os.readlink(directory / 'exe')
            deleted = executable.endswith(' (deleted)')
            if deleted: executable = executable[:-10]
            if not safe_path(executable):
                raise HostInventoryError('process executable path is unsupported')
        except FileNotFoundError:
            # Kernel threads and zombies have no executable. Keep the record;
            # an absent executable does not prove that it is a kernel thread.
            pass
        service = None
        argv = bounded(directory / 'cmdline', 65536).split(b'\0')
        if argv and argv[-1] == b'':
            argv.pop()
        if executable and Path(executable).name == 'supervise-daemon':
            if len(argv) > 1:
                candidate = argv[1].decode(errors='replace')
                if candidate in known: service = candidate
        after = bounded(directory / 'stat', 8192).rpartition(b') ')[2].split()
        if len(after) < 20 or after[1] != fields[1] or after[19] != fields[19]:
            raise HostInventoryError('process identity changed during collection')
        row = {'pid': int(directory.name), 'parent_pid': int(fields[1]), 'start_ticks': int(fields[19]),
                     'uids': status['Uid'], 'gids': status['Gid'], 'executable': executable,
                     'executable_deleted': deleted, 'kernel_thread': bool(int(fields[6]) & 0x00200000),
                     'service': service}
        row['no_application_role'] = no_application_process_role(row, argv)
        rows.append(row)
    if [int(p.name) for p in sorted((p for p in proc.iterdir() if p.name.isdigit()), key=lambda p: int(p.name))] != [v['pid'] for v in rows]:
        raise HostInventoryError('process inventory changed during collection')
    # Only the actual collector and its live SSH session ancestors can be
    # inspection processes. A separate shell or Python process stays unknown.
    by_pid = {row['pid']: row for row in rows}
    current = os.getpid() if root == Path('/') else None
    seen = set()
    while current in by_pid and current not in seen:
        seen.add(current)
        row = by_pid[current]
        if (row['no_application_role'] != 'unknown' or row['executable_deleted'] or
                row['executable'] not in ('/bin/busybox', '/usr/sbin/tailscaled', '/usr/bin/python3.12', '/usr/bin/python3.13', '/usr/bin/python3.14')):
            break
        row['no_application_role'] = 'inspection-process'
        current = row['parent_pid']
    return {'kind': 'klokast.vm-process-inventory.v2', 'health_verified': False,
            'collector_pid': os.getpid() if root == Path('/') else None,
            'boot_id': boot_id, 'processes': rows}


def package_audit_rows(content):
    """Parse native audit paths only, never details or file contents."""
    if not isinstance(content, str) or len(content.encode()) > 1024 * 1024:
        raise HostInventoryError('package audit output exceeds its limit')
    rows, seen = [], set()
    for line in content.splitlines():
        if len(line) < 3 or line[1] != ' ' or line[0] not in 'ADdeMmxUX':
            raise HostInventoryError('package audit output has an unsupported format')
        path = '/' + line[2:].removeprefix('/').removesuffix('/')
        if not safe_path(path) or path in seen or len(rows) >= 8192:
            raise HostInventoryError('package audit paths are unsafe, duplicated, or excessive')
        seen.add(path)
        rows.append({'code': line[0], 'path': path})
    return sorted(rows, key=lambda v: v['path'])


def collect_package_audit(database_sha256, root=Path('/')):
    """Native read-only comparison with the local DB, not signed source proof."""
    result = {'kind': 'klokast.vm-package-audit.v1', 'complete': False, 'stable': False,
              'database_sha256': database_sha256, 'protected_paths': 'none',
              'check_permissions': True, 'differences': [], 'adoption_authorized': False}
    if root != Path('/'):
        return result  # Never inspect the runner when unit tests use a fixture root.
    try:
        command = ['/sbin/apk', 'audit', '--system', '--check-permissions', '--protected-paths', '/dev/null']
        def database_matches():
            value = text('/lib/apk/db/installed')
            return bool(value) and hashlib.sha256(value.encode()).hexdigest() == database_sha256
        if not database_matches():
            return result
        before = capture(command)
        after = capture(command)
        if before['rc'] != 0 or after['rc'] != 0 or not database_matches():
            return result
        rows, repeated = package_audit_rows(before['stdout']), package_audit_rows(after['stdout'])
        result['differences'] = rows
        result['stable'] = rows == repeated
        # Native audit can emit an error row while returning exit status zero.
        result['complete'] = not any(v['code'] == 'e' for v in rows + repeated)
    except (HostInventoryError, OSError, ValueError):
        pass
    return result


RUNTIME_DIRECTORY_PATHS = ('/run/lock', '/var/lib/tailscale')


def runtime_directory_metadata(root):
    """Read only the two changed package directories needed by this profile."""
    rows = []
    try:
        for path in RUNTIME_DIRECTORY_PATHS:
            parent = Path(path[1:]).parent
            while parent != Path('.'):
                if not stat.S_ISDIR((root / parent).lstat().st_mode):
                    return []
                parent = parent.parent
            info = (root / path[1:]).lstat()
            if not stat.S_ISDIR(info.st_mode):
                return []
            rows.append({'path': path, 'mode': info.st_mode, 'uid': info.st_uid,
                         'gid': info.st_gid})
    except OSError:
        return []
    return rows


def collect_runtime_directories(before, after):
    record = {'kind': 'klokast.vm-runtime-directories.v1',
              'complete': len(before) == len(RUNTIME_DIRECTORY_PATHS),
              'stable': bool(before) and before == after, 'entries': before}
    record['evidence_sha256'] = hashlib.sha256(json.dumps(
        record, sort_keys=True, separators=(',', ':')).encode()).hexdigest()
    return record


ROOTFUL_GRAPH = '/var/lib/containers/storage'
ROOTFUL_TABLES = ('DBConfig', 'IDNamespace', 'ContainerConfig', 'ContainerState',
                  'ContainerExecSession', 'ContainerDependency', 'ContainerVolume',
                  'ContainerExitCode', 'PodConfig', 'PodState', 'VolumeConfig', 'VolumeState')


def rootful_metadata(root, mounts, deadline, graph=ROOTFUL_GRAPH):
    if time.monotonic() >= deadline:
        raise HostInventoryError('rootful store metadata exceeded its time limit')
    if graph not in (ROOTFUL_GRAPH, '/home/neo/.local/share/containers/storage'):
        raise HostInventoryError('unsupported standard container store')
    if any(m['path'] != '/' and (m['path'] == graph or
            m['path'].startswith(graph + '/') or graph.startswith(m['path'] + '/')) for m in mounts):
        raise HostInventoryError('rootful store crosses a mounted filesystem')
    # Refuse linked ancestors even for an apparently absent standard store.
    with ExitStack() as stack:
        descriptor = os.open(root, os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW)
        stack.callback(os.close, descriptor)
        for part in graph[1:].split('/'):
            try:
                descriptor = os.open(part, os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW, dir_fd=descriptor)
            except FileNotFoundError:
                return {'roots': [graph], 'entries': [], 'excluded': []}
            stack.callback(os.close, descriptor)
    return unowned_tree(root, [{'path': graph, 'reason': 'unclassified-directory'}],
                        mounts, None, deadline)


def rootful_database_bytes(root, relative, *, graph=ROOTFUL_GRAPH, owner=None):
    if owner is None:
        owner = os.geteuid()
    with ExitStack() as stack:
        descriptor = os.open(root, os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW)
        stack.callback(os.close, descriptor)
        parts = (graph[1:] + '/' + relative).split('/')
        for part in parts[:-1]:
            descriptor = os.open(part, os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW, dir_fd=descriptor)
            stack.callback(os.close, descriptor)
        descriptor = os.open(parts[-1], os.O_RDONLY | os.O_NOFOLLOW | os.O_NONBLOCK, dir_fd=descriptor)
        stack.callback(os.close, descriptor)
        before = os.fstat(descriptor)
        if (not stat.S_ISREG(before.st_mode) or before.st_uid != owner or before.st_nlink != 1 or
                before.st_mode & 0o022 or not 0 < before.st_size <= 8 * 1024 * 1024):
            raise HostInventoryError('rootful Podman database has unsafe metadata or size')
        with os.fdopen(os.dup(descriptor), 'rb') as stream:
            content = stream.read(8 * 1024 * 1024 + 1)
        after = os.fstat(descriptor)
        if (len(content) != before.st_size or
                (before.st_ino, before.st_size, before.st_mtime_ns, before.st_ctime_ns) !=
                (after.st_ino, after.st_size, after.st_mtime_ns, after.st_ctime_ns)):
            raise HostInventoryError('rootful Podman database changed during inspection')
        return content


def rootful_table_counts(content, deadline, graph=ROOTFUL_GRAPH):
    # Never open the live database with SQLite or initialize Podman. Deserialize
    # a bounded in-memory copy; query fixed table counts, never container JSON.
    import sqlite3
    if time.monotonic() >= deadline:
        raise HostInventoryError('rootful registration inspection exceeded its time limit')
    connection = sqlite3.connect(':memory:')
    try:
        connection.deserialize(content)
        connection.enable_load_extension(False)
        connection.set_progress_handler(lambda: int(time.monotonic() >= deadline), 1000)
        connection.execute('PRAGMA trusted_schema=OFF')
        connection.execute('PRAGMA query_only=ON')
        connection.execute('PRAGMA temp_store=MEMORY')
        schema = connection.execute("SELECT name, type, sql FROM sqlite_master WHERE type != 'index'").fetchall()
        if (len(schema) != len(ROOTFUL_TABLES) or {r[0] for r in schema} != set(ROOTFUL_TABLES) or
                any(r[1] != 'table' or not isinstance(r[2], str) or not re.match(r'^CREATE TABLE\s', r[2], re.I) for r in schema)):
            raise HostInventoryError('rootful Podman database has an unsupported schema')
        config = connection.execute('SELECT SchemaVersion, GraphRoot FROM DBConfig').fetchall()
        if config != [(1, graph)]:
            raise HostInventoryError('rootful Podman database version or graph root differs')
        counts = {table: connection.execute('SELECT count(*) FROM "' + table + '"').fetchone()[0]
                  for table in ROOTFUL_TABLES}
        if time.monotonic() >= deadline or any(type(v) is not int or not 0 <= v <= 1000000 for v in counts.values()):
            raise HostInventoryError('rootful Podman registration count exceeds its limit')
        return counts
    except sqlite3.Error as error:
        raise HostInventoryError('rootful Podman database cannot be inspected safely') from error
    finally:
        connection.close()


def collect_rootful_store(root, mounts):
    result = {'kind': 'klokast.vm-rootful-store.v1', 'graph_root': ROOTFUL_GRAPH,
              'complete': False, 'stable': False, 'present': None, 'entries': 0,
              'metadata_sha256': None, 'database': None, 'adoption_authorized': False,
              'custom_store_coverage': False, 'error': None}
    try:
        if not mounts:
            raise HostInventoryError('mount inventory is unavailable')
        deadline = time.monotonic() + 10
        before = rootful_metadata(root, mounts, deadline)
        rows = before['entries']
        result.update(present=bool(rows), entries=len(rows), metadata_sha256=hashlib.sha256(
            json.dumps(before, sort_keys=True, separators=(',', ':')).encode()).hexdigest())
        paths = {v['path'] for v in rows}
        candidates = [p for p in ('db.sql', 'libpod/db.sql') if ROOTFUL_GRAPH + '/' + p in paths]
        if len(candidates) > 1 or any(p.endswith(('/bolt_state.db', '/db.sql-wal', '/db.sql-shm', '/db.sql-journal')) for p in paths):
            raise HostInventoryError('rootful Podman database format or journal state is unsupported')
        if candidates:
            relative = candidates[0]
            content = rootful_database_bytes(root, relative)
            counts = rootful_table_counts(content, min(deadline, time.monotonic() + 2))
            if content != rootful_database_bytes(root, relative):
                raise HostInventoryError('rootful Podman database changed during inspection')
            result['database'] = {'path': relative, 'sha256': hashlib.sha256(content).hexdigest(), 'table_rows': counts}
        after = rootful_metadata(root, mounts, deadline)
        result.update(complete=True, stable=before == after)
    except (HostInventoryError, OSError, ValueError, ImportError, AttributeError) as error:
        result['error'] = (str(error) if isinstance(error, HostInventoryError) else
                           'rootful store metadata or the required SQLite capability is unavailable')
    return result


def collect_no_application_store(root, mounts, owner, graph='/home/neo/.local/share/containers/storage'):
    """Account for empty rootless store files, including unregistered data.

    This fixed probe is separate from general Podman discovery. It starts no
    container process, opens SQLite only in memory, and emits no stored JSON.
    Any file outside the exact empty-store layout remains unresolved.
    """
    result = {'kind': 'klokast.vm-empty-store.v1', 'graph_root': graph, 'complete': False,
              'stable': False, 'empty': False, 'metadata': None, 'database_sha256': None,
              'unresolved_paths': [], 'adoption_authorized': False, 'error': None}
    directories = {'', 'libpod', 'overlay', 'overlay/l', 'overlay/tempdirs',
                   'overlay-containers', 'overlay-images', 'overlay-layers',
                   'overlay-layers/tmp', 'volumes', 'networks', 'tmp', 'mounts', 'secrets'}
    # Zero-length lock files and bounded native format markers carry no app
    # dataset. A nonempty image/layer index requires separate qualification.
    empty_files = {'networks/netavark.lock', 'secrets/secrets.lock',
                   'userns.lock', 'volumes/volumes.lock'}
    native_locks = {'storage.lock', 'overlay-containers/containers.lock',
                    'overlay-images/images.lock', 'overlay-layers/layers.lock'}
    markers = {'defaultNetworkBackend': {b'netavark', b'netavark\n'},
               'overlay/.has-mount-program': {b'true', b'true\n', b'false', b'false\n'},
               'overlay-containers/containers.json': {b'[]', b'[]\n'},
               'overlay-containers/volatile-containers.json': {b'[]', b'[]\n'},
               'overlay-images/images.json': {b'[]', b'[]\n'},
               'overlay-layers/layers.json': {b'[]', b'[]\n'},
               'overlay-layers/volatile-layers.json': {b'[]', b'[]\n'}}
    try:
        if (graph not in (ROOTFUL_GRAPH, '/home/neo/.local/share/containers/storage') or
                not mounts or not isinstance(owner, dict) or set(owner) != {'uid', 'gid'} or
                any(type(v) is not int or v < (0 if graph == ROOTFUL_GRAPH else 1000) for v in owner.values()) or
                (graph == ROOTFUL_GRAPH and owner != {'uid': 0, 'gid': 0})):
            raise HostInventoryError('rootless store requires observed numeric ownership and mounts')
        deadline = time.monotonic() + 10
        before = rootful_metadata(root, mounts, deadline, graph)
        result['metadata'] = before
        if not before['entries']:
            raise HostInventoryError('the configured rootless store is absent')
        contents = {}
        databases = []
        for row in before['entries']:
            relative = row['path'][len(graph):].lstrip('/')
            accepted = False
            metadata_ok = row['uid'] == owner['uid'] and row['gid'] == owner['gid'] and not row['mode'] & 0o022
            if metadata_ok and stat.S_ISDIR(row['mode']):
                accepted = relative in directories
            elif metadata_ok and stat.S_ISREG(row['mode']) and row['links'] == 1:
                if relative in empty_files:
                    accepted = row['bytes'] == 0
                elif relative in ('db.sql', 'libpod/db.sql'):
                    content = rootful_database_bytes(root, relative, graph=graph, owner=owner['uid'])
                    counts = rootful_table_counts(content, min(deadline, time.monotonic() + 2), graph)
                    accepted = all(count == (1 if key == 'DBConfig' else 0) for key, count in counts.items())
                    contents[relative] = content
                    databases.append(relative)
                    result['database_sha256'] = hashlib.sha256(content).hexdigest()
                elif relative in native_locks and relative != 'storage.lock' and row['bytes'] == 0:
                    # A newly created store can have an empty per-index lock.
                    accepted = True
                elif relative in markers or relative in native_locks:
                    content = rootful_database_bytes(root, relative, graph=graph, owner=owner['uid'])
                    contents[relative] = content
                    if relative in native_locks:
                        # containers/storage v1.59.1 lastwrite.go uses a
                        # 64-byte binary time/counter/PID/random identifier.
                        # Older releases used a 64-byte hexadecimal ID.
                        accepted = bool(re.fullmatch(b'[0-9a-f]{64}', content)) or (
                            len(content) == 64 and
                            abs(row['mtime_ns'] - int.from_bytes(content[:8], 'little')) <= 1_000_000_000 and
                            int.from_bytes(content[8:16], 'little') > 0 and
                            0 < int.from_bytes(content[16:20], 'little') < 2**22)
                    else:
                        accepted = content in markers[relative]
            if not accepted:
                result['unresolved_paths'].append(row['path'])
        if len(databases) != 1:
            raise HostInventoryError('the rootless store must have one supported registration database')
        for relative, content in contents.items():
            if rootful_database_bytes(root, relative, graph=graph, owner=owner['uid']) != content:
                raise HostInventoryError('rootless store content changed during inspection')
        after = rootful_metadata(root, mounts, deadline, graph)
        result.update(complete=True, stable=before == after,
                      empty=before == after and not result['unresolved_paths'])
    except (HostInventoryError, OSError, ValueError, ImportError, AttributeError) as error:
        result['error'] = (str(error) if isinstance(error, HostInventoryError) else
                           'rootless store metadata or native SQLite inspection is unavailable')
    result['evidence_sha256'] = hashlib.sha256(json.dumps(result, sort_keys=True, separators=(',', ':')).encode()).hexdigest()
    return result


def collect_boot_files(root, mounts):
    """Inspect the separately mounted legacy boot filesystem on the guest.

    Only fixed OS artifact names are hashed. Unknown files retain metadata and
    block qualification. No filesystem is mounted and no artifact is executed.
    """
    result = {'kind': 'klokast.vm-boot-files.v1', 'complete': False, 'stable': False,
              'mount': None, 'metadata': None, 'artifacts': {}, 'adoption_authorized': False, 'error': None}
    allowed = {'vmlinuz-virt', 'initramfs-virt', 'config-virt', 'System.map-virt'}
    try:
        selected = [m for m in mounts if m['path'] == '/boot']
        if (len(selected) != 1 or selected[0]['root'] != '/' or selected[0]['type'] != 'ext4' or
                any(m['path'].startswith('/boot/') for m in mounts)):
            raise HostInventoryError('boot requires one complete ext4 mount with no nested filesystems')
        result['mount'] = selected[0]
        boot = root / 'boot'
        deadline = time.monotonic() + 15
        with ExitStack() as stack:
            parent = os.open(root, os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW)
            stack.callback(os.close, parent)
            descriptor = os.open('boot', os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW, dir_fd=parent)
            stack.callback(os.close, descriptor)
            def snapshot():
                info = os.fstat(descriptor)
                if (info.st_uid != os.geteuid() or info.st_mode & 0o022 or
                        selected[0]['device'] != f'{os.major(info.st_dev)}:{os.minor(info.st_dev)}' or
                        os.stat('boot', dir_fd=parent, follow_symlinks=False).st_ino != info.st_ino):
                    raise HostInventoryError('boot mount metadata or identity differs')
                with os.scandir(descriptor) as children:
                    names = []
                    for child in children:
                        names.append('/' + child.name)
                        if len(names) > 512:
                            raise HostInventoryError('boot entry count exceeds its limit')
                tree = unowned_tree(boot, [{'path': n, 'reason': 'unclassified-directory'} for n in sorted(names)],
                                    [], None, deadline, limit=512)
                top = {'path': '/boot', 'mode': info.st_mode, 'uid': info.st_uid, 'gid': info.st_gid,
                       'bytes': info.st_size, 'inode': info.st_ino, 'links': info.st_nlink, 'mtime_ns': info.st_mtime_ns}
                return {'roots': ['/boot'], 'entries': [top] + [{**r, 'path': '/boot' + r['path']} for r in tree['entries']],
                        'excluded': []}
            before = snapshot()
            def artifacts():
                values = {}
                for name in sorted(allowed & {r['path'].removeprefix('/boot/') for r in before['entries']}):
                    fd = os.open(name, os.O_RDONLY | os.O_NOFOLLOW | os.O_NONBLOCK, dir_fd=descriptor)
                    try:
                        info = os.fstat(fd)
                        if (not stat.S_ISREG(info.st_mode) or info.st_nlink != 1 or info.st_uid != os.geteuid() or
                                info.st_mode & 0o022 or info.st_dev != os.fstat(descriptor).st_dev or
                                not 0 < info.st_size <= 128 * 1024 * 1024):
                            raise HostInventoryError('boot artifact type, ownership, or size is unsafe')
                        total = 0; checksum = hashlib.sha256()
                        while chunk := os.read(fd, 1024 * 1024):
                            total += len(chunk)
                            if total > info.st_size or time.monotonic() >= deadline:
                                raise HostInventoryError('boot artifact exceeded its size or time limit')
                            checksum.update(chunk)
                        after = os.fstat(fd)
                        if total != info.st_size or (info.st_ino, info.st_size, info.st_mtime_ns, info.st_ctime_ns) != (
                                after.st_ino, after.st_size, after.st_mtime_ns, after.st_ctime_ns):
                            raise HostInventoryError('boot artifact changed while reading')
                        values['/boot/' + name] = checksum.hexdigest()
                    finally:
                        os.close(fd)
                return values
            hashes = artifacts()
            result.update(metadata=before, artifacts=hashes, complete=True,
                          stable=before == snapshot() and hashes == artifacts())
    except (HostInventoryError, OSError, ValueError) as error:
        result['error'] = str(error) if isinstance(error, HostInventoryError) else 'boot filesystem inspection is unavailable or unsafe'
    result['evidence_sha256'] = hashlib.sha256(json.dumps(result, sort_keys=True, separators=(',', ':')).encode()).hexdigest()
    return result


def collect_nginx_default_copy(root, owned, mounts):
    """Check the one unowned default file against its package-owned source."""
    source = '/usr/share/nginx/http-default_server.conf'
    target = '/etc/nginx/http.d/default.conf'
    result = {'kind': 'klokast.vm-nginx-default-copy.v1', 'source': source,
              'target': target, 'complete': False, 'stable': False, 'present': False,
              'source_owned': False, 'source_sha256': None, 'target_sha256': None,
              'matching': False, 'error_log_empty': False,
              'adoption_authorized': False, 'error': None}
    try:
        try:
            (root / target[1:]).lstat()
        except FileNotFoundError:
            result.update(complete=True, stable=True)
            return {**result, 'evidence_sha256': hashlib.sha256(json.dumps(result, sort_keys=True, separators=(',', ':')).encode()).hexdigest()}
        result['present'] = True
        if (source not in owned or target in owned or
                any(m['path'] != '/' and any(p == m['path'] or p.startswith(m['path'] + '/')
                                             for p in (source, target)) for m in mounts)):
            raise HostInventoryError('Nginx default copy lacks package or mount coverage')
        result['source_owned'] = True
        device = root.stat().st_dev
        def open_file(path, inspect):
            with ExitStack() as stack:
                parent = os.open(root, os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW)
                stack.callback(os.close, parent)
                parts = path[1:].split('/')
                for part in parts[:-1]:
                    parent = os.open(part, os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW,
                                     dir_fd=parent)
                    stack.callback(os.close, parent)
                descriptor = os.open(parts[-1], os.O_RDONLY | os.O_NOFOLLOW | os.O_NONBLOCK,
                                     dir_fd=parent)
                stack.callback(os.close, descriptor)
                return inspect(descriptor)
        def read(path):
            def inspect(descriptor):
                before = os.fstat(descriptor)
                if (not stat.S_ISREG(before.st_mode) or before.st_dev != device or
                        before.st_uid != os.geteuid() or before.st_gid != os.getegid() or before.st_nlink != 1 or
                        before.st_mode & 0o022 or not 0 < before.st_size <= 65536):
                    raise HostInventoryError('Nginx default copy has unsafe file metadata')
                content = os.read(descriptor, 65537)
                after = os.fstat(descriptor)
                identity = (before.st_dev, before.st_ino, before.st_mode, before.st_uid,
                            before.st_gid, before.st_nlink, before.st_size, before.st_mtime_ns,
                            before.st_ctime_ns)
                if (len(content) != before.st_size or identity !=
                        (after.st_dev, after.st_ino, after.st_mode, after.st_uid,
                         after.st_gid, after.st_nlink, after.st_size, after.st_mtime_ns,
                         after.st_ctime_ns)):
                    raise HostInventoryError('Nginx default copy changed during inspection')
                return hashlib.sha256(content).hexdigest(), identity
            return open_file(path, inspect)
        first = (read(source), read(target))
        second = (read(source), read(target))
        result.update(complete=True, stable=first == second,
                      source_sha256=first[0][0], target_sha256=first[1][0],
                      matching=first == second and first[0][0] == first[1][0])
        log = '/var/log/nginx/error.log'
        if log not in owned and not any(m['path'] != '/' and
                (log == m['path'] or log.startswith(m['path'] + '/')) for m in mounts):
            def empty_log():
                try:
                    def inspect(descriptor):
                        info = os.fstat(descriptor)
                        return (info.st_dev, info.st_ino, info.st_mode, info.st_uid,
                                info.st_gid, info.st_nlink, info.st_size, info.st_mtime_ns,
                                info.st_ctime_ns)
                    return open_file(log, inspect)
                except FileNotFoundError:
                    return None
            log_first, log_second = empty_log(), empty_log()
            result['error_log_empty'] = (log_first is not None and log_first == log_second and
                                         log_first[0] == device and stat.S_ISREG(log_first[2]) and
                                         log_first[3:7] == (os.geteuid(), os.getegid(), 1, 0) and
                                         not log_first[2] & 0o022)
    except (HostInventoryError, OSError, ValueError) as error:
        result['error'] = str(error) if isinstance(error, HostInventoryError) else 'Nginx default copy cannot be inspected safely'
    result['evidence_sha256'] = hashlib.sha256(json.dumps(result, sort_keys=True, separators=(',', ':')).encode()).hexdigest()
    return result


def collect_legacy_firmware(root, mounts):
    """Measure only the four legacy VIRT firmware files without emitting bytes."""
    names = tuple('/lib/firmware/qat_' + stem + '.bin.zst' for stem in
                  ('402xx', '402xx_mmp', '4xxx', '4xxx_mmp'))
    result = {'kind': 'klokast.vm-legacy-firmware.v1', 'complete': False,
              'stable': False, 'files': [], 'adoption_authorized': False, 'error': None}
    try:
        device = root.stat().st_dev
        if any(m['path'] != '/' and any(p == m['path'] or p.startswith(m['path'] + '/')
                                        for p in names) for m in mounts):
            raise HostInventoryError('legacy firmware crosses a mounted filesystem')
        def measure():
            files = []
            for path in names:
                with ExitStack() as stack:
                    parent = os.open(root, os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW)
                    stack.callback(os.close, parent)
                    parts = path[1:].split('/')
                    try:
                        for part in parts[:-1]:
                            parent = os.open(part, os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW,
                                             dir_fd=parent)
                            stack.callback(os.close, parent)
                        descriptor = os.open(parts[-1], os.O_RDONLY | os.O_NOFOLLOW | os.O_NONBLOCK,
                                             dir_fd=parent)
                    except FileNotFoundError:
                        continue
                    stack.callback(os.close, descriptor)
                    before = os.fstat(descriptor)
                    if (not stat.S_ISREG(before.st_mode) or before.st_dev != device or
                            before.st_uid != os.geteuid() or before.st_gid != os.getegid() or
                            before.st_nlink != 1 or before.st_mode & 0o022 or
                            not 0 < before.st_size <= 16 * 1024 * 1024):
                        raise HostInventoryError('legacy firmware has unsafe metadata')
                    digest = hashlib.sha256()
                    size = 0
                    while size <= 16 * 1024 * 1024:
                        block = os.read(descriptor, 65536)
                        if not block:
                            break
                        size += len(block)
                        digest.update(block)
                    after = os.fstat(descriptor)
                    identity = lambda info: (info.st_dev, info.st_ino, info.st_mode, info.st_uid,
                                             info.st_gid, info.st_nlink, info.st_size,
                                             info.st_mtime_ns, info.st_ctime_ns)
                    if size != before.st_size or identity(before) != identity(after):
                        raise HostInventoryError('legacy firmware changed during inspection')
                    files.append({'path': path, 'mode': before.st_mode, 'uid': before.st_uid,
                                  'gid': before.st_gid, 'links': before.st_nlink,
                                  'bytes': before.st_size, 'sha256': digest.hexdigest()})
            return files
        first, second = measure(), measure()
        result.update(complete=True, stable=first == second, files=first)
    except (HostInventoryError, OSError, ValueError) as error:
        result['error'] = str(error) if isinstance(error, HostInventoryError) else 'legacy firmware cannot be inspected safely'
    result['evidence_sha256'] = hashlib.sha256(json.dumps(result, sort_keys=True, separators=(',', ':')).encode()).hexdigest()
    return result


def collect_inspection_artifact(root, owner):
    """Bind only this running Ansible collector copy to its source bytes."""
    path = os.path.abspath(__file__)
    result = {'kind': 'klokast.vm-inspection-artifact.v1', 'path': path,
              'pid': os.getpid(), 'complete': False, 'stable': False,
              'mode': None, 'uid': None, 'gid': None, 'links': None,
              'bytes': None, 'sha256': None, 'adoption_authorized': False,
              'error': None}
    try:
        if not re.fullmatch(r'/tmp/ansible-tmp-[0-9]+(?:\.[0-9]+)?-[0-9]+-[0-9]+/collect-vm-update-facts', path):
            raise HostInventoryError('collector is outside the fixed Ansible staging path')
        owners = {(0, 0)}
        if isinstance(owner, dict) and type(owner.get('uid')) is int and type(owner.get('gid')) is int:
            owners.add((owner['uid'], owner['gid']))
        def read():
            with ExitStack() as stack:
                parent = os.open(root, os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW)
                stack.callback(os.close, parent)
                parts = path[1:].split('/')
                for part in parts[:-1]:
                    parent = os.open(part, os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW,
                                     dir_fd=parent)
                    stack.callback(os.close, parent)
                descriptor = os.open(parts[-1], os.O_RDONLY | os.O_NOFOLLOW | os.O_NONBLOCK,
                                     dir_fd=parent)
                stack.callback(os.close, descriptor)
                before = os.fstat(descriptor)
                if (not stat.S_ISREG(before.st_mode) or (before.st_uid, before.st_gid) not in owners or
                        before.st_nlink != 1 or before.st_mode & 0o022 or
                        not 0 < before.st_size <= 1024 * 1024):
                    raise HostInventoryError('collector staging file has unsafe metadata')
                content = os.read(descriptor, 1024 * 1024 + 1)
                after = os.fstat(descriptor)
                identity = lambda info: (info.st_dev, info.st_ino, info.st_mode, info.st_uid,
                                         info.st_gid, info.st_nlink, info.st_size,
                                         info.st_mtime_ns, info.st_ctime_ns)
                if len(content) != before.st_size or identity(before) != identity(after):
                    raise HostInventoryError('collector staging file changed during inspection')
                return {'mode': before.st_mode, 'uid': before.st_uid, 'gid': before.st_gid,
                        'links': before.st_nlink, 'bytes': before.st_size,
                        'sha256': hashlib.sha256(content).hexdigest()}
        first, second = read(), read()
        result.update(first, complete=True, stable=first == second)
    except (HostInventoryError, OSError, ValueError) as error:
        result['error'] = str(error) if isinstance(error, HostInventoryError) else 'collector staging file cannot be inspected safely'
    result['evidence_sha256'] = hashlib.sha256(json.dumps(result, sort_keys=True, separators=(',', ':')).encode()).hexdigest()
    return result


def collect_host(storage, root=Path('/')):
    result = {'kind': 'klokast.vm-host-inventory.v1', 'complete': False, 'stable': False,
              'accounts': [], 'maintenance_files': [], 'unowned_paths': [], 'delegated_roots': [],
              'package_integrity_verified': False, 'data_accounted': False}
    try:
        database = text(root / 'lib/apk/db/installed')
        result['package_database_sha256'] = hashlib.sha256(database.encode()).hexdigest()
        owned = package_paths(database)
        mounts = mount_inventory()
        if (not mounts or len(mounts) > 4096 or any(not isinstance(m.get('path'), str) or
                '\\' in m['path'] or (m['path'] != '/' and not safe_path(m['path'])) for m in mounts) or
                len({m['path'] for m in mounts}) != len(mounts)):
            raise HostInventoryError('mount inventory is unavailable')
        runtime = storage.get('podman_storage') or {}
        graph = runtime.get('graph_root') if runtime.get('graph_root_directory') is True else None
        if graph != '/home/neo/.local/share/containers/storage':
            graph = None
        accounts = text(root / 'etc/passwd', 65536)
        result['accounts'] = host_accounts(accounts)
        runtime_before = runtime_directory_metadata(root)
        deadline = time.monotonic() + 30
        before = host_tree(root, owned, mounts, graph, deadline)
        result.update(before)
        result['maintenance_files'] = maintenance_files(root, deadline, mounts)
        result['native_services'] = native_services(root, result['maintenance_files'], deadline)
        result['processes'] = process_inventory(root, result['native_services'], deadline)
        after = host_tree(root, owned, mounts, graph, deadline)
        after_maintenance = maintenance_files(root, deadline, mounts)
        after_services = native_services(root, after_maintenance, deadline)
        after_processes = process_inventory(root, after_services, deadline)
        result['stable'] = (before == after and result['maintenance_files'] == after_maintenance and
                            result['native_services'] == after_services and
                            result['processes'] == after_processes and
                            accounts == text(root / 'etc/passwd', 65536) and
                            database == text(root / 'lib/apk/db/installed') and mounts == mount_inventory())
        result['complete'] = True
        if result['stable']:
            result['unowned_tree'] = collect_unowned(root, before['delegated_roots'], mounts, graph, deadline)
            if mounts != mount_inventory():
                result['unowned_tree']['stable'] = False
        result['package_audit'] = collect_package_audit(result['package_database_sha256'], root)
        result['runtime_directories'] = collect_runtime_directories(
            runtime_before, runtime_directory_metadata(root))
        if result['stable']:
            result['nginx_default_copy'] = collect_nginx_default_copy(root, owned, mounts)
            result['legacy_firmware'] = collect_legacy_firmware(root, mounts)
            if root == Path('/'):
                result['inspection_artifact'] = collect_inspection_artifact(root, storage.get('runtime_owner'))
        if result['stable']:
            result['rootful_store'] = collect_rootful_store(root, mounts)
            if result['rootful_store']['present'] is True:
                result['rootful_empty_store'] = collect_no_application_store(
                    root, mounts, {'uid': 0, 'gid': 0}, ROOTFUL_GRAPH)
            if storage.get('containers') == [] and storage.get('volumes') == []:
                result['no_application_store'] = collect_no_application_store(root, mounts, storage.get('runtime_owner'))
            result['boot_files'] = collect_boot_files(root, mounts)
            if mounts != mount_inventory():
                result['rootful_store']['stable'] = False
                if 'rootful_empty_store' in result:
                    result['rootful_empty_store'].update(stable=False, empty=False)
                    result['rootful_empty_store']['evidence_sha256'] = hashlib.sha256(json.dumps(
                        {k: v for k, v in result['rootful_empty_store'].items() if k != 'evidence_sha256'},
                        sort_keys=True, separators=(',', ':')).encode()).hexdigest()
                if 'no_application_store' in result:
                    result['no_application_store'].update(stable=False, empty=False)
                    result['no_application_store']['evidence_sha256'] = hashlib.sha256(json.dumps(
                        {k: v for k, v in result['no_application_store'].items() if k != 'evidence_sha256'},
                        sort_keys=True, separators=(',', ':')).encode()).hexdigest()
    except HostInventoryError as error:
        result['error'] = str(error)
    except (OSError, ValueError, UnicodeError):
        result['error'] = 'Host metadata is unavailable, unsafe, or exceeds the bounded inventory limits.'
    return result


def capture(argv):
    try:
        result = subprocess.run(argv, stdin=subprocess.DEVNULL, capture_output=True, text=True, timeout=20)
        if len(result.stdout) > 8 * 1024 * 1024:
            return {"rc": 125, "stdout": ""}
        return {"rc": result.returncode, "stdout": result.stdout if result.returncode == 0 else ""}
    except (OSError, subprocess.TimeoutExpired):
        return {"rc": 124, "stdout": ""}


def text(path, maximum=8 * 1024 * 1024):
    try:
        descriptor = os.open(path, os.O_RDONLY | os.O_NONBLOCK)
        with os.fdopen(descriptor, encoding="utf-8") as stream:
            if not stat.S_ISREG(os.fstat(stream.fileno()).st_mode):
                return ""
            value = stream.read(maximum + 1)
        return value if len(value) <= maximum else ""
    except (OSError, UnicodeError):
        return ""


def stable_regular_bytes(path, maximum, uid, gid, mode):
    """Read one exact local configuration file without following links."""
    try:
        before = os.lstat(path)
        if (before.st_mode != (stat.S_IFREG | mode) or before.st_uid != uid or
                before.st_gid != gid or before.st_nlink != 1 or
                not 0 < before.st_size <= maximum):
            return None
        fd = os.open(path, os.O_RDONLY | os.O_NOFOLLOW)
        try:
            opened = os.fstat(fd)
            content = os.read(fd, maximum + 1)
            after = os.fstat(fd)
        finally:
            os.close(fd)
        fields = ('st_dev', 'st_ino', 'st_mode', 'st_uid', 'st_gid',
                  'st_nlink', 'st_size', 'st_mtime_ns', 'st_ctime_ns')
        if (any(getattr(before, field) != getattr(opened, field) or
                getattr(before, field) != getattr(after, field) for field in fields) or
                len(content) != before.st_size):
            return None
        return content
    except OSError:
        return None


def apk_world(path="/etc/apk/world"):
    """Record only bounded APK requests, with stable file identity."""
    try:
        content = stable_regular_bytes(path, 4096, 0, 0, 0o644)
        if content is None or not content.endswith(b'\n'):
            return None
        lines = content.decode('ascii').splitlines()
        if (not lines or len(lines) > 64 or lines != sorted(set(lines)) or
                any(not re.fullmatch(r'[a-z0-9][a-z0-9+_.-]*(?:=[0-9][A-Za-z0-9._-]*)?',
                                         line) for line in lines)):
            return None
        return {'kind': 'klokast.vm-apk-world.v1', 'sha256': hashlib.sha256(content).hexdigest(),
                'requests': lines}
    except UnicodeError:
        return None


def tailscale_resolver(status, path="/etc/resolv.conf"):
    """Compare only Tailscale's fixed resolver format; emit no DNS suffix."""
    if not isinstance(status, dict):
        return None
    suffix = status.get('MagicDNSSuffix')
    if (status.get('BackendState') != 'Running' or not isinstance(suffix, str) or
            not re.fullmatch(r'tail[a-f0-9]{6,16}\.ts\.net', suffix)):
        return None
    content = stable_regular_bytes(path, 1024, 0, 102, 0o644)
    if content is None:
        return None
    expected = ('# resolv.conf(5) file generated by tailscale\n'
                '# For more info, see https://tailscale.com/s/resolvconf-overwrite\n'
                '# DO NOT EDIT THIS FILE BY HAND -- CHANGES WILL BE OVERWRITTEN\n'
                '\n'
                'nameserver 100.100.100.100\n'
                'search ' + suffix + '\n').encode()
    return {'kind': 'klokast.vm-tailscale-resolver.v1',
            'suffix_sha256': hashlib.sha256(suffix.encode()).hexdigest(),
            'expected_sha256': hashlib.sha256(expected).hexdigest(),
            'observed_sha256': hashlib.sha256(content).hexdigest()}


def read_json_command(argv):
    result = capture(argv)
    try:
        return json.loads(result["stdout"]) if result["rc"] == 0 else None
    except ValueError:
        return None


def mount_inventory():
    """Do not export mount options: network mounts can contain credentials."""
    records = []
    try:
        content = text('/proc/self/mountinfo', 1024 * 1024)
        if not content:
            return None
        for line in content.splitlines():
            fields = line.split()
            split = fields.index('-')
            records.append({'device': fields[2], 'root': fields[3], 'path': fields[4],
                            'type': fields[split + 1]})
        return records
    except (ValueError, IndexError):
        return None


def directory_verified(value, mounts):
    """Inspect directory metadata only. Refuse symlinks and nested mounts."""
    if (not isinstance(value, str) or not value.startswith('/') or len(value) > 4096 or
            any(part in ('', '.', '..') for part in value[1:].split('/')) or
            any(ord(c) < 32 or ord(c) == 127 or c == '\\' for c in value) or not mounts):
        return False
    try:
        current = Path('/')
        for part in value[1:].split('/'):
            current /= part
            if not stat.S_ISDIR(current.lstat().st_mode):
                return False
        if any(m['path'] == value or m['path'].startswith(value + '/') for m in mounts):
            return False
        parents = [m for m in mounts if m['path'] == '/' or value.startswith(m['path'] + '/')]
        parent = max(parents, key=lambda m: len(m['path']))
        return parent['type'] == 'ext4' and parent['root'] == '/'
    except (OSError, ValueError, KeyError):
        return False


def podman_snapshot(podman):
    """Drop secrets on the guest, and never accept partial inspect coverage."""
    listed = podman('ps --all --format=json')
    if not isinstance(listed, list) or len(listed) > 4096:
        return None
    ids = [item.get('Id') if isinstance(item, dict) else None for item in listed]
    if any(not isinstance(v, str) or not re.fullmatch('[0-9a-f]{64}', v) for v in ids) or len(set(ids)) != len(ids):
        return None
    inspected = podman('container inspect ' + ' '.join(ids)) if ids else []
    volumes = podman('volume inspect --all')
    if (not isinstance(inspected, list) or len(inspected) != len(ids) or
            any(not isinstance(v, dict) for v in inspected) or
            any(not isinstance(v.get('Id'), str) for v in inspected) or
            sorted(v.get('Id', '') for v in inspected) != sorted(ids) or
            not isinstance(volumes, list) or len(volumes) > 4096 or
            any(not isinstance(v, dict) for v in volumes)):
        return None
    containers = []
    for item in inspected:
        mounts = item.get('Mounts')
        config = item.get('HostConfig')
        if not isinstance(mounts, list) or any(not isinstance(m, dict) for m in mounts) or not isinstance(config, dict):
            return None
        state = item.get('State') if isinstance(item.get('State'), dict) else {}
        runtime_state = state.get('Status')
        if runtime_state not in ('configured', 'created', 'running', 'stopped', 'paused', 'exited', 'removing', 'stopping'):
            runtime_state = None
        containers.append({'id': item['Id'], 'name': item.get('Name'), 'image_id': item.get('Image'),
                           'runtime_state': runtime_state,
                           'infra': item.get('IsInfra'), 'pod': item.get('Pod'),
                           'read_only_root': config.get('ReadonlyRootfs'),
                           'mounts': [{k: m.get(k) for k in ('Type', 'Name', 'Source', 'Destination', 'RW')} for m in mounts]})
    selected_volumes = [{**{k: item.get(k) for k in ('Name', 'Mountpoint', 'Driver')},
                         'options_empty': 'Options' in item and item['Options'] in ({}, None)} for item in volumes]
    if any(not isinstance(v['Name'], str) for v in selected_volumes):
        return None
    return {'containers': sorted(containers, key=lambda v: v['id']),
            'volumes': sorted(selected_volumes, key=lambda v: v['Name'])}


def collect_storage(podman):
    result = {'containers': None, 'volumes': None, 'podman_storage': None, 'podman_inventory_stable': False}
    before = podman_snapshot(podman)
    info = podman('info --format=json')
    mounts = mount_inventory()
    if isinstance(info, dict) and isinstance(info.get('host'), dict) and isinstance(info.get('store'), dict):
        store = info['store']
        security = info['host'].get('security')
        result['podman_storage'] = {'rootless': security.get('rootless') if isinstance(security, dict) else None,
                                    'graph_root': store.get('graphRoot'), 'volume_path': store.get('volumePath'),
                                    'transient': store.get('transientStore'),
                                    'graph_root_directory': directory_verified(store.get('graphRoot'), mounts)}
    if before is not None:
        result.update(before)
        # Physical checks are observations, not permissions to copy these paths.
        result['volumes'] = [{**v, 'directory_verified': directory_verified(v['Mountpoint'], mounts)} for v in before['volumes']]
    after = podman_snapshot(podman)
    result['podman_inventory_stable'] = before is not None and before == after and bool(mounts) and mounts == mount_inventory()
    return result


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument('--host-storage', action='store_true', help='inspect bounded shared-VM host metadata')
    args = parser.parse_args()
    release = {}
    for line in text("/etc/os-release", 16384).splitlines():
        key, sep, value = line.partition("=")
        if sep and key in ("ID", "VERSION_ID"):
            release[key.lower()] = value.strip('"')
    status = read_json_command(["tailscale", "status", "--json"]) or {}
    configs = {}
    for name in ("/etc/apk/repositories", "/etc/apk/world", "/etc/fstab", "/etc/nftables.nft",
                 "/etc/subuid", "/etc/subgid", "/etc/containers/storage.conf", "/etc/containers/registries.conf"):
        value = text(name, 1024 * 1024)
        configs[name] = hashlib.sha256(value.encode()).hexdigest() if value else None
    database = "\n\n".join("\n".join(line for line in block.splitlines() if line[:2] in ("P:", "V:", "o:", "A:"))
                            for block in text("/lib/apk/db/installed").split("\n\n"))
    fact = {
        "kind": "klokast.vm-update-fact.v1",
        "observed_at": datetime.datetime.now(datetime.timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ"),
        "hostname": platform.node(), "os": release, "architecture": platform.machine(),
        "kernel": platform.release(), "apk_database": database,
        "module_releases": sorted(p.name for p in Path("/lib/modules").glob("*") if p.is_dir()),
        "other_packages": capture(["dpkg-query", "-W", "-f=${Package}\t${Version}\n"])["stdout"] if release.get("id") in ("debian", "ubuntu") else "",
        "tailscale": {"running_version": status.get("Version"), "backend_state": status.get("BackendState"),
                      "client_version": capture(["tailscale", "version"])["stdout"].splitlines()[:1]},
        "configuration": {"status": "unknown", "sha256": configs},
        "apk_world": apk_world(),
        "tailscale_resolver": tailscale_resolver(status),
        "template_marker": text("/etc/klokast/vm-release.json", 65536),
        "legacy_template_marker": text("/etc/klokast-podman-template-built", 16384),
        "storage": {"mounts": mount_inventory(), "capacity": capture(["df", "-Pk"])["stdout"]},
        "subuid": text("/etc/subuid", 65536), "subgid": text("/etc/subgid", 65536),
        "containers": None, "volumes": None,
    }
    try:
        account = pwd.getpwnam("neo")
        fact["runtime_owner"] = {"uid": account.pw_uid, "gid": account.pw_gid}
        def podman(arguments):
            # Fixed commands only; no instance or guest strings become shell code.
            return read_json_command(["su", "-s", "/bin/sh", "-c", "podman " + arguments, "neo"])
        fact.update(collect_storage(podman))
    except KeyError:
        fact["runtime_owner"] = None
    if args.host_storage and release.get('id') == 'alpine':
        fact['host_inventory'] = collect_host(fact)
    print(json.dumps(fact, sort_keys=True))


if __name__ == "__main__":
    main()
