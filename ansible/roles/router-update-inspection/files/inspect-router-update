#!/usr/bin/env python3
"""Read-only router baseline evidence. Never emit state bytes or secret hashes."""
import argparse
import ast
import datetime as dt
import hashlib
import json
import os
import grp
import pwd
from pathlib import Path
import re
import stat
import subprocess


def run(argv):
    result = subprocess.run(argv, stdin=subprocess.DEVNULL, capture_output=True, text=True, timeout=30)
    if result.returncode:
        raise RuntimeError('router inspection command failed: ' + argv[0])
    return result.stdout.strip()


def info(path):
    path = Path(path)
    if any(parent.is_symlink() for parent in path.parents):
        return {'present': True, 'regular': False, 'unsafe_parent': True}
    try:
        value = path.lstat()
    except FileNotFoundError:
        return {'present': False}
    return {'present': True, 'regular': stat.S_ISREG(value.st_mode), 'links': value.st_nlink,
            'uid': value.st_uid, 'gid': value.st_gid, 'mode': oct(stat.S_IMODE(value.st_mode)),
            'bytes': value.st_size}


def file_hash(path):
    path = Path(path)
    metadata = info(path)
    if not metadata.get('regular') or not 0 < metadata['bytes'] <= 512 * 1024 * 1024:
        raise RuntimeError('router boot artifact is absent or unsafe')
    value = hashlib.sha256()
    with path.open('rb') as stream:
        for block in iter(lambda: stream.read(1024 * 1024), b''):
            value.update(block)
    return value.hexdigest()


def inspect_guest(box):
    packages = {}
    for block in Path('/lib/apk/db/installed').read_text().split('\n\n'):
        fields = dict(line.split(':', 1) for line in block.splitlines() if line.startswith(('P:', 'V:')))
        if 'P' in fields and 'V' in fields:
            if fields['P'] in packages:
                raise RuntimeError('installed APK database has duplicate packages')
            packages[fields['P']] = fields['V']
    status = json.loads(run(['tailscale', 'status', '--json']))
    if status.get('Self', {}).get('HostName') != box + '-router':
        raise RuntimeError('router inspection reached a different machine')
    prefs = json.loads(run(['tailscale', 'debug', 'prefs']))
    try:
        dnsmasq = pwd.getpwnam('dnsmasq')
        service_accounts = {'dnsmasq_uid': dnsmasq.pw_uid, 'dnsmasq_gid': dnsmasq.pw_gid,
                            'tailscale_gid': grp.getgrnam('tailscale').gr_gid}
    except KeyError as error:
        raise RuntimeError('router inspection requires the dnsmasq account and tailscale group') from error
    state_paths = ['/var/lib/tailscale/tailscaled.state', '/var/lib/dhcpcd/duid', '/var/lib/dhcpcd/secret',
                   '/var/lib/dhcpcd/eth0.lease', '/var/lib/dhcpcd/eth0.lease6', '/var/lib/misc/dnsmasq.leases']
    keys = {}
    for kind in ('rsa', 'ecdsa', 'ed25519'):
        candidates = [Path('/etc/ssh/ssh_host_' + kind + '_key'),
                      Path('/var/lib/tailscale/ssh/ssh_host_' + kind + '_key')]
        selected = next((path for path in candidates if path.exists() or path.is_symlink()), None)
        if selected is not None:
            metadata = info(selected)
            if not metadata.get('regular') or metadata['links'] != 1:
                raise RuntimeError('effective router SSH key is unsafe')
            fingerprint = run(['ssh-keygen', '-lf', str(selected)]).split()
            keys[kind] = {'path': str(selected), 'fingerprint': fingerprint[1], 'metadata': metadata}
    config = Path('/etc/dnsmasq.conf').read_text()
    root_entries = [line.split(':') for line in Path('/etc/shadow').read_text().splitlines()
                    if line.startswith('root:')]
    root_locked = len(root_entries) == 1 and root_entries[0][1].startswith(('!', '*'))
    sshd_processes = False
    for process in Path('/proc').iterdir():
        if not process.name.isdigit():
            continue
        try:
            if (process / 'comm').read_text().strip() in ('sshd', 'sshd-session', 'sshd-auth'):
                sshd_processes = True
        except FileNotFoundError:
            pass  # The process exited between enumeration and inspection.
    lease_paths = re.findall(r'^\s*dhcp-leasefile\s*=\s*(\S+)\s*$', config, re.M)
    overlay = Path('/etc/klokast/overlay-ipv6.nft')
    overlay_enabled = (Path('/etc/sysctl.d/91-klokast-ops-ipv6.conf').exists() or
                       (overlay.exists() and any(line.strip() and not line.lstrip().startswith('#')
                                                 for line in overlay.read_text().splitlines())))
    configuration = {}
    for path in ('/etc/network/interfaces', '/etc/dhcpcd.conf', '/etc/dnsmasq.conf', '/etc/nftables.nft'):
        metadata = info(path)
        configuration[path] = {'metadata': metadata,
                               'sha256': file_hash(path) if metadata.get('regular') else None}
    return {'packages': packages, 'kernel_release': os.uname().release,
            'service_accounts': service_accounts,
            'configuration_files': configuration,
            'machine_id': status.get('Self', {}).get('ID'), 'tags': status.get('Self', {}).get('Tags'),
            'tailscale_running': status.get('BackendState') == 'Running', 'tailscale_ssh': prefs.get('RunSSH'),
            'state_paths': {path: info(path) for path in state_paths}, 'ssh_keys': keys,
            'dnsmasq_lease_paths': lease_paths, 'overlay_ipv6_enabled': overlay_enabled,
            'unsupported_state': {path: Path(path).exists() for path in
                                  ('/var/lib/tailscale/tka', '/var/lib/tailscale/tpm-sealed')},
            'root_password_locked': root_locked, 'sshd_running': sshd_processes,
            'openssh_paths': {path: info(path) for path in
                              ('/usr/sbin/sshd', '/etc/init.d/sshd', '/etc/runlevels/default/sshd')},
            'first_contact_key': info('/root/.ssh/authorized_keys')}


def xen_configuration(text):
    """Read only the closed literal configuration emitted by the router role."""
    values = {}
    required = {'name', 'type', 'memory', 'vcpus', 'kernel', 'ramdisk', 'extra',
                'disk', 'vif', 'on_crash', 'on_reboot'}
    for item in ast.parse(text).body:
        if (not isinstance(item, ast.Assign) or len(item.targets) != 1 or
                not isinstance(item.targets[0], ast.Name) or
                item.targets[0].id not in required | {'uuid'} or item.targets[0].id in values):
            raise RuntimeError('router Xen configuration has an unsupported or duplicate statement')
        values[item.targets[0].id] = ast.literal_eval(item.value)
    if (not required <= values.keys() or values['name'] != 'router' or values['type'] != 'pvh' or
            values['on_crash'] != 'destroy' or values['on_reboot'] != 'restart' or
            any(type(values[k]) is not int or values[k] <= 0 for k in ('memory', 'vcpus')) or
            any(not isinstance(values[k], str) or not values[k] for k in ('kernel', 'ramdisk', 'extra')) or
            not isinstance(values['disk'], list) or len(values['disk']) != 1 or
            not isinstance(values['disk'][0], str) or
            not re.fullmatch(r'phy:/dev/[A-Za-z0-9_-]+/[A-Za-z0-9_-]+,xvda,w', values['disk'][0]) or
            not isinstance(values['vif'], list) or not values['vif'] or any(
                not isinstance(vif, str) or not re.fullmatch(
                    r'bridge=[A-Za-z0-9_-]+,mac=(?:[0-9a-f]{2}:){5}[0-9a-f]{2}', vif)
                for vif in values['vif']) or len(set(values['vif'])) != len(values['vif']) or
            'uuid' in values and not re.fullmatch(
                r'[0-9a-f]{8}(?:-[0-9a-f]{4}){3}-[0-9a-f]{12}', str(values['uuid']))):
        raise RuntimeError('router Xen configuration is incomplete or outside the supported profile')
    return values


def xen_runtime(domains):
    """Keep live identities and assignments; never infer these from router.cfg."""
    if not isinstance(domains, list) or len(domains) != 1:
        raise RuntimeError('router must have exactly one live Xen domain')
    try:
        config = domains[0]['config']
        identity, boot = config['c_info'], config['b_info']
        disks, nics = config['disks'], config['nics']
        if (identity['name'] != 'router' or identity['type'] != 'pvh' or
                not re.fullmatch(r'[0-9a-f]{8}(?:-[0-9a-f]{4}){3}-[0-9a-f]{12}', identity['uuid']) or
                len(disks) != 1 or disks[0]['format'] != 'raw' or disks[0]['readwrite'] != 1 or
                [nic['devid'] for nic in nics] != list(range(len(nics)))):
            raise ValueError('unsupported domain configuration')
        return {'name': identity['name'], 'type': identity['type'], 'uuid': identity['uuid'],
                'memory_kb': boot['target_memkb'], 'vcpus': boot['max_vcpus'],
                'kernel': boot['kernel'], 'ramdisk': boot['ramdisk'], 'extra': boot['cmdline'],
                'disk': ['phy:' + disk['pdev_path'] + ',' + disk['vdev'] + ',w' for disk in disks],
                'vif': ['bridge=' + nic['bridge'] + ',mac=' + nic['mac'] for nic in nics]}
    except (KeyError, IndexError, TypeError, ValueError) as error:
        raise RuntimeError('live router Xen identity or attachment evidence is incomplete') from error


def inspect_dom0(box):
    if os.uname().nodename.split('.')[0] != box + '-dom0':
        raise RuntimeError('router inspection reached a different dom0')
    config = Path('/etc/xen/router.cfg')
    values = xen_configuration(config.read_text())
    runtime = xen_runtime(json.loads(run(['/usr/sbin/xl', 'list', '-l', 'router'])))
    runtime_matches = (all(runtime[key] == values[key] for key in
                           ('name', 'type', 'kernel', 'ramdisk', 'extra', 'disk', 'vif', 'vcpus')) and
                       runtime['memory_kb'] == values['memory'] * 1024 and
                       ('uuid' not in values or values['uuid'] == runtime['uuid']))
    artifacts = {}
    for field in ('kernel', 'ramdisk'):
        path = values.get(field)
        if not isinstance(path, str) or not path.startswith('/mnt/dom0_data/') or '..' in Path(path).parts:
            raise RuntimeError('router boot path is outside persistent storage')
        artifacts[field] = {'path': path, 'sha256': file_hash(path)}
    return {'configuration_sha256': file_hash(config), 'xen': values, 'boot_artifacts': artifacts,
            'xen_runtime': runtime, 'xen_runtime_matches': runtime_matches,
            'logical_volumes': json.loads(run(['/sbin/lvs', '--reportformat', 'json', '--units', 'b',
                                               '--nosuffix', '-o', 'lv_path,lv_uuid,lv_size,origin'])),
            'accepted_record_present': Path('/mnt/dom0_data/klokast-router-updates/accepted.json').exists(),
            'pending_record_present': Path('/mnt/dom0_data/klokast-router-updates/pending.json').exists()}


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument('--box', required=True)
    parser.add_argument('--target', choices=('router', 'dom0'), required=True)
    args = parser.parse_args()
    if os.geteuid() != 0 or not re.fullmatch(r'[a-z0-9][a-z0-9-]{0,30}', args.box):
        raise RuntimeError('inspection requires root and an exact box selector on the managed host')
    result = inspect_guest(args.box) if args.target == 'router' else inspect_dom0(args.box)
    print(json.dumps({'kind': 'klokast.router-inspection.v1', 'box': args.box, 'target': args.target,
                      'observed_at': dt.datetime.now(dt.timezone.utc).strftime('%Y-%m-%dT%H:%M:%SZ'),
                      **result}, sort_keys=True))


if __name__ == '__main__':
    main()
