  for name in dirs+names:
   path=pathlib.Path(parent)/name; info=path.lstat()
   if stat.S_ISSOCK(info.st_mode): continue
   if stat.S_ISREG(info.st_mode) and (info.st_dev,info.st_ino) not in seen:
    size+=info.st_size; seen.add((info.st_dev,info.st_ino))
   entry=[str(path.relative_to(root)),info.st_mode,info.st_uid,info.st_gid,info.st_size,info.st_mtime_ns,
