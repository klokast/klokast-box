def unfence(box, shell):
    if shell not in ('/bin/ash','/bin/bash','/bin/sh','/bin/zsh'):
        raise RuntimeError('recorded runner shell is unsupported')
    remote(box, '''import pathlib,sys
path=pathlib.Path('/etc/passwd'); lines=[]
for line in path.read_text().splitlines():
 fields=line.split(':')
 if fields[0]=='agent': fields[-1]=sys.argv[1]
 lines.append(':'.join(fields))
temporary=path.with_name('.passwd-airunner-new')
temporary.write_text('\\n'.join(lines)+'\\n'); temporary.chmod(0o644); temporary.replace(path)
''', shell)


def copy_home(box, source, destination, *, synthetic=False, verify=False):
    args = ['rsync', '-aHAX', '--numeric-ids', '--partial', '--delete-delay', '--timeout=90',
            '--rsh=ssh -o BatchMode=yes -o ConnectTimeout=10 -o StrictHostKeyChecking=accept-new -o ServerAliveInterval=10 -o ServerAliveCountMax=3',
            '--rsync-path=doas -n rsync']
    if not synthetic:
        for pattern in EXCLUDES: args += ['--exclude=/' + pattern]
    if verify: args += ['--dry-run', '--checksum', '--itemize-changes']
    result = run([*args, str(source) + '/', 'neo@' + box + '-air:' + destination + '/'], timeout=1800)
    if verify and result.stdout.strip():
        raise RuntimeError('final copy differs from source content, metadata or numeric ownership')


def required_bytes(root, excludes=()):
    """Count retained regular data without following runner-owned symlinks."""
    size = 0
    seen = set()
    excluded = {p.rstrip('/') for p in excludes}
    for parent, dirs, files in os.walk(root, followlinks=False):
        dirs[:] = [name for name in dirs if str((Path(parent) / name).relative_to(root)) not in excluded]
        for name in files:
            info = (Path(parent) / name).lstat()
            identity = (info.st_dev, info.st_ino)
            if stat.S_ISREG(info.st_mode) and identity not in seen:
                size += info.st_size
                seen.add(identity)
    return size


def synthetic_source(work, uid, gid):
    root = work / 'synthetic-source'
    if not root.exists():
        # The fixture contains no real authentication, Git keys or working data.
        (root / '.codex').mkdir(parents=True)
        (root / 'src/example').mkdir(parents=True)
        (root / 'src/example/uncommitted.txt').write_text('synthetic uncommitted work\n')
        # SQLite parses only our fixed fixture in the controller. Runner-owned
        # databases are validated inside the destination VM as unprivileged agent.
        import sqlite3
        with sqlite3.connect(root / '.codex/state.sqlite') as connection:
            connection.execute('CREATE TABLE sessions(id TEXT PRIMARY KEY, text TEXT)')
            connection.execute("INSERT INTO sessions VALUES ('pilot','synthetic session')")
        for parent, dirs, files in os.walk(root):
            os.chown(parent, uid, gid)
            for name in files: os.chown(Path(parent) / name, uid, gid)
    return root


def archives(box, *, mount=False):
    source = Path('/home/smith/private/klokast/codex-archives')
    if not source.exists(): return
    if source.is_symlink() or not source.is_dir(): raise RuntimeError('runner archive source is unsafe')
    remote(box, "import pathlib; p=pathlib.Path('/var/lib/klokast/runner-archives'); p.mkdir(parents=True,exist_ok=True); p.chmod(0o700)")
    copy_home(box, source, '/var/lib/klokast/runner-archives', synthetic=True)
    if not mount: return
    copy_home(box, source, '/var/lib/klokast/runner-archives', synthetic=True, verify=True)
    remote(box, '''import pathlib,subprocess
mount=pathlib.Path('/home/agent/.codex-archives')
if mount.is_symlink(): raise SystemExit('archive mount must not be a symlink')
mount.mkdir(exist_ok=True)
entry='/var/lib/klokast/runner-archives /home/agent/.codex-archives none bind,ro 0 0'
fstab=pathlib.Path('/etc/fstab'); lines=fstab.read_text().splitlines()
if entry not in lines: fstab.write_text('\\n'.join(lines+[entry])+'\\n')
if not mount.is_mount(): subprocess.run(['mount','--bind','/var/lib/klokast/runner-archives',str(mount)],check=True)
subprocess.run(['mount','-o','remount,bind,ro',str(mount)],check=True)
''')


