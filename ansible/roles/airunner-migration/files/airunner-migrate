#!/usr/bin/python3
"""Controller-local runner copy with explicit cutover and rollback boundaries."""
import argparse
import hashlib
import json
import os
from pathlib import Path
import shutil
import socket
import stat
import subprocess
import time

STATE = Path('/var/lib/klokast/airunner-migration')
EXCLUDES = ('.codex-archives/', '.cache/',
            '.npm/_cacache/', '.nvm/', '.codex/packages/', '.codex/tmp/', '.codex/.tmp/',
            '.codex/app-server-control/', '.codex/app-server-daemon/')


def run(argv, *, input=None, timeout=900, check=True):
    result = subprocess.run(argv, input=input, capture_output=True, text=True, timeout=timeout)
    if check and result.returncode:
        raise RuntimeError('migration command failed: ' + argv[0] + ' (exit ' + str(result.returncode) + ')')
    return result


def save(path, value):
    temporary = path.with_suffix('.new')
    with temporary.open('w') as stream:
        json.dump(value, stream, sort_keys=True); stream.write('\n')
        stream.flush(); os.fsync(stream.fileno())
    temporary.chmod(0o600); temporary.replace(path)


def remote(box, program, *args, agent=False):
    command = ['ssh', '-o', 'BatchMode=yes', '-o', 'ConnectTimeout=10', '-o', 'StrictHostKeyChecking=accept-new',
               '-o', 'ServerAliveInterval=10', '-o', 'ServerAliveCountMax=3', 'neo@' + box + '-air',
               'doas', '-n', *(['-u', 'agent'] if agent else []), 'python3', '-', *map(str, args)]
    return run(command, input=program, timeout=120).stdout


