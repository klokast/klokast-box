    remote(box, '''import subprocess
subprocess.run(['codex','login','status'],check=True,stdout=subprocess.DEVNULL,stderr=subprocess.DEVNULL)
subprocess.run(['git','-C','/home/agent/src/klokast/klokast-box','ls-remote','origin','HEAD'],check=True,stdout=subprocess.DEVNULL,stderr=subprocess.DEVNULL,timeout=30)
''', agent=True)


def retirement(box, phase, uid):
    work = STATE / box
    path = work / ('pilot.json' if phase == 'retire-test-check' else 'migration.json')
    state = json.loads(path.read_text())
    if state.get('box') != box or state.get('phase') not in ('verified', 'retired'):
        raise RuntimeError('retirement requires a verified migration for this box')
    if phase == 'retire-test-check':
        if state.get('synthetic') is not True:
            raise RuntimeError('test-only retirement requires a synthetic migration')
        try:
            fence(box, uid)
            remote(box, '''import pathlib,sqlite3
home=pathlib.Path('/home/agent')
allowed={'.codex','.cache','.ssh','.ash_history','.bash_history','pilot-migration'}
if any(p.name not in allowed for p in home.iterdir()): raise SystemExit('pilot home contains non-test data')
if any((home/'.ssh').rglob('*')): raise SystemExit('pilot contains SSH credentials')
codex=home/'.codex'
if (codex/'auth.json').exists() or list(codex.glob('*.sqlite')) or list(codex.glob('*.db')) or any((codex/'sessions').rglob('*')):
 raise SystemExit('pilot contains working authentication or sessions')
root=home/'pilot-migration'
expected={'.codex','.codex/state.sqlite','src','src/example','src/example/uncommitted.txt'}
if {str(p.relative_to(root)) for p in root.rglob('*')}!=expected or any(p.is_symlink() for p in root.rglob('*')):
 raise SystemExit('pilot workspace differs from the synthetic fixture')
if (root/'src/example/uncommitted.txt').read_text()!='synthetic uncommitted work\\n': raise SystemExit('pilot workspace changed')
db=sqlite3.connect('file:'+str(root/'.codex/state.sqlite')+'?mode=ro',uri=True)
if db.execute('SELECT id,text FROM sessions').fetchall()!=[('pilot','synthetic session')]: raise SystemExit('pilot sessions changed')
db.close()
''', agent=True)
            proof = json.loads(remote(box, '''import json,pathlib
value=json.loads(pathlib.Path('/etc/klokast-infrastructure.json').read_text())
print(json.dumps({'uuid':pathlib.Path('/sys/hypervisor/uuid').read_text().strip(),'config_sha256':value['config_sha256'],'test_only':True,'fresh':True}))
'''))
            state['retirement_proof'] = proof; save(path, state)
            return proof
        except (RuntimeError, OSError, subprocess.SubprocessError):
            if 'retirement_proof' not in state: raise
            # The dom0 helper accepts replay only when this exact guest is
            # already offline in a recorded retirement transaction.
            return dict(state['retirement_proof'], fresh=False)
    if state.get('synthetic') is not False or socket.gethostname().split('.')[0] != box + '-ops':
        raise RuntimeError('legacy retirement must run on the source controller')
    authenticate(box)
    if run(['pgrep', '-u', str(uid)], check=False).returncode == 0:
        raise RuntimeError('source runner still has writers; keep startup integration')
    container = run(['podman','container','inspect',box+'-ops-airunner'], check=False)
    if container.returncode == 0 and json.loads(container.stdout)[0]['State']['Running']:
        raise RuntimeError('source runner container is still running')
    if container.returncode not in (0,125):
        raise RuntimeError('cannot establish stopped source container state')
    retained = work / 'legacy-service'
    retained.mkdir(mode=0o700, exist_ok=True)
    paths = (Path('/etc/init.d/airunner'), Path('/usr/local/bin/airunner-shell'),
             Path('/etc/sudoers.d/30-agent-airunner'), Path('/etc/containers/containers.conf.d/30-airunner-network.conf'))
    for source in paths:
        if source.exists():
            target = retained / source.name
            if target.exists() and target.read_bytes() != source.read_bytes():
                raise RuntimeError('retained legacy service differs; preserve both definitions')
            shutil.copy2(source, target); target.chmod(0o600)
    run(['rc-update','del','airunner','default'], check=False)
    for source in paths: source.unlink(missing_ok=True)
    network = run(['podman','network','inspect','airunner'], check=False)
    if network.returncode == 0:
        if json.loads(network.stdout)[0].get('containers'):
            raise RuntimeError('legacy runner network still has attached containers')
        run(['podman','network','rm','airunner'])
    elif network.returncode != 125:
        raise RuntimeError('cannot inspect the legacy runner network')
    state.update(phase='retired', retained_home='/home/agent', retained_service=str(retained))
    save(path, state)
    return state


def migrate(box, phase, synthetic, uid, gid, interrupt=False):
    work = STATE / box
    work.mkdir(parents=True, mode=0o700, exist_ok=True)
    path = work / ('pilot.json' if synthetic else 'migration.json')
    state = json.loads(path.read_text()) if path.exists() else {'box': box, 'phase': 'new', 'synthetic': synthetic}
    if state.get('box') != box or state.get('synthetic') is not synthetic:
        raise RuntimeError('migration state differs from selected runner')
    if phase == 'status': return state
    destination = '/home/agent/pilot-migration' if synthetic else '/home/agent'
    if phase == 'verify':
        if state['phase'] not in ('destination-enabled', 'verified'):
            raise RuntimeError('migration verification requires completed cutover data')
        state['validation'] = json.loads(remote(box, VALIDATE, destination, uid, gid, agent=True))
        if not synthetic: authenticate(box)
        unfence(box, state['login_shell'])
        state.update(phase='verified', destination_tree=inspect(box, destination)['tree'])
        save(path, state)
        return state
    if state['phase'] in ('destination-enabled', 'verified', 'retired'):
        raise RuntimeError('destination writes are enabled; preserve both copies and reconcile before another copy')
    if state['phase'] not in ('new', 'precopy', 'copy-failed'):
        raise RuntimeError('migration completion is unknown; inspect both copies and reconcile before retry')
    source = synthetic_source(work, uid, gid) if synthetic else Path('/home/agent')
    if not synthetic:
        if socket.gethostname().split('.')[0] != box + '-ops':
            raise RuntimeError('working migration must run on the legacy runner controller')
        if source.is_symlink() or (source.stat().st_uid, source.stat().st_gid) != (uid, gid):
            raise RuntimeError('legacy runner home numeric ownership differs')
    before = inspect(box, destination)
    size = required_bytes(source, () if synthetic else EXCLUDES)
    retained_bytes = before['bytes']
    if not synthetic:
        size += required_bytes(Path('/home/smith/private/klokast/codex-archives'))
        retained_bytes += inspect(box, '/var/lib/klokast/runner-archives')['bytes']
    if size + 2 * 1024**3 > before['free'] + retained_bytes:
        raise RuntimeError('runner data and a 2 GiB reserve do not fit the destination; source is unchanged')
    if state['phase'] in ('precopy', 'copy-failed') and state.get('destination_tree') and before['tree'] != state['destination_tree']:
        raise RuntimeError('destination changed after pre-copy; preserve both copies for reconciliation')
    if state['phase'] == 'new' and not synthetic:
        remote(box, '''import pathlib
home=pathlib.Path('/home/agent')
if any(p.name not in ('.codex','.cache','.ssh','.ash_history') for p in home.iterdir()): raise SystemExit('destination home already has user data')
if (home/'.codex/auth.json').exists() or any((home/'.codex/sessions').rglob('*')): raise SystemExit('destination already has authentication or sessions')
''')
    if phase == 'cutover' and state['phase'] != 'precopy':
        raise RuntimeError('cutover requires a completed pre-copy')
    previous_shell = fence(box, uid)
    state.setdefault('login_shell', previous_shell)
    if inspect(box, destination)['tree'] != before['tree']:
        raise RuntimeError('destination changed while closing writer access; preserve both copies')
    state.update(phase='copying' if phase == 'precopy' else 'quiescing', started_at=time.time())
    save(path, state)
    stopped = False
    try:
        if phase == 'cutover' and not synthetic:
            stopped = True
            run(['rc-service', 'airunner', 'stop'], timeout=90)
            # The stopped container must have no source writers left.
            if run(['pgrep', '-u', str(uid)], check=False).returncode == 0:
                raise RuntimeError('source runner writers remain after stopping its service')
        copy_home(box, source, destination, synthetic=synthetic)
        if interrupt: raise RuntimeError('injected synthetic copy interruption')
        if phase == 'precopy':
            if not synthetic: archives(box)
            state.update(phase='precopy', destination_tree=inspect(box, destination)['tree'])
        else:
            copy_home(box, source, destination, synthetic=synthetic, verify=True)
            result = json.loads(remote(box, VALIDATE, destination, uid, gid, agent=True))
            if not synthetic:
                archives(box, mount=True)
                remote(box, '''import pathlib
p=pathlib.Path('/home/agent/.local/bin/codex')
if p.is_symlink(): p.unlink()
if not p.exists():
 p.parent.mkdir(parents=True,exist_ok=True); p.symlink_to('/usr/local/bin/codex')
''', agent=True)
            # This boundary precedes any use of migrated authentication or sessions.
            # Failures after this record must never restore an older source automatically.
            state.update(phase='destination-enabled', validation=result); save(path, state)
            if not synthetic:
                authenticate(box)
            unfence(box, state['login_shell'])
            state.update(phase='verified', destination_tree=inspect(box, destination)['tree'])
        save(path, state)
        return state
    except BaseException as error:
        if stopped and state['phase'] not in ('destination-enabled', 'verified'):
            try:
                state['source_restored'] = run(['rc-service', 'airunner', 'start'], timeout=90, check=False).returncode == 0
            except subprocess.SubprocessError:
                state['source_restored'] = False
        state['last_error'] = type(error).__name__ + ': ' + str(error)[:300]
        if state['phase'] not in ('destination-enabled', 'verified'):
            state['phase'] = 'copy-failed'
            try:
                state['destination_tree'] = inspect(box, destination)['tree']
            except (RuntimeError, OSError, subprocess.SubprocessError):
                state['phase'] = 'copy-unconfirmed'
        save(path, state)
        raise


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument('--box', required=True)
    parser.add_argument('--phase', choices=('precopy','cutover','verify','status','retire-legacy','retire-test-check'), default='precopy')
    parser.add_argument('--synthetic', action='store_true')
    parser.add_argument('--agent-uid', type=int, default=1004)
    parser.add_argument('--agent-gid', type=int, default=1004)
    parser.add_argument('--simulate-interruption', action='store_true')
    args = parser.parse_args()
    import re
    if (os.geteuid()!=0 or not re.fullmatch('[a-z0-9][a-z0-9-]{0,30}', args.box) or
            any(not 1001<=v<=60000 for v in (args.agent_uid,args.agent_gid))):
        parser.error('migration requires controller root execution and valid numeric ownership')
    if args.simulate_interruption and not args.synthetic: parser.error('failure injection is synthetic-only')
    run(['/usr/local/sbin/klokast-controller-guard','--require-active'])
    result = (retirement(args.box, args.phase, args.agent_uid) if args.phase.startswith('retire-')
              else migrate(args.box,args.phase,args.synthetic,args.agent_uid,args.agent_gid,args.simulate_interruption))
    print(json.dumps(result,sort_keys=True))


if __name__=='__main__': main()
