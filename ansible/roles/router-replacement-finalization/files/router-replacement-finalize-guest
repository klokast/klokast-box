#!/usr/bin/env python3
"""Retire B's first-contact access in a disposable networkless Xen guest."""
import json
import os
from pathlib import Path
import re
import stat
import subprocess
import sys
import time

sys.path.insert(0,'/usr/local/lib/klokast')
import router_candidate
import router_initial_contact
import router_personalize
import router_state

ROOT = Path('/run/router-replacement-root')
RESULT = Path('/dev/xvdb')
JOB = Path('/dev/xvdc')
MIB = 1024 * 1024


def unique(pairs):
    value = {}
    for key,item in pairs:
        if key in value:
            raise RuntimeError('replacement finalizer job has duplicate fields')
        value[key] = item
    return value


def command(argv,deadline,*,allowed=(0,)):
    remaining = min(120,int(deadline-time.monotonic()))
    if remaining <= 0:
        raise RuntimeError('replacement finalizer exceeded its fixed budget')
    result = subprocess.run([str(item) for item in argv],stdin=subprocess.DEVNULL,
                            capture_output=True,timeout=remaining)
    if result.returncode not in allowed:
        raise RuntimeError('replacement finalizer native command failed: ' + str(argv[0]))


def guard():
    router_personalize.environment()
    args = {}
    for field in Path('/proc/cmdline').read_text().split():
        name,sep,value = field.partition('=')
        if sep and name.startswith('klokast_'):
            if name in args:
                raise RuntimeError('replacement finalizer has repeated boot identity')
            args[name] = value
    if (set(args) != {'klokast_operation','klokast_inputs','klokast_job'} or
            not re.fullmatch('[0-9a-f]{24}',args['klokast_operation']) or
            not re.fullmatch('[0-9a-f]{64}',args['klokast_inputs']) or
            not re.fullmatch('[0-9a-f]{64}',args['klokast_job'])):
        raise RuntimeError('replacement finalizer boot identity is incomplete')
    for path,name,writable in ((Path('/dev/xvda'),'xvda',True),
                               (RESULT,'xvdb',True),(JOB,'xvdc',False)):
        if (path.is_symlink() or not stat.S_ISBLK(path.stat().st_mode) or
                Path('/sys/class/block',name,'ro').read_text().strip() !=
                    ('0' if writable else '1')):
            raise RuntimeError('replacement finalizer has an invalid block device mode')
    if len({path.stat().st_rdev for path in (Path('/dev/xvda'),RESULT,JOB)}) != 3:
        raise RuntimeError('replacement finalizer block devices overlap')
    if {path.name for path in Path('/sys/class/block').glob('xvd*')
            if not re.fullmatch(r'xvda[0-9]+',path.name)} != {'xvda','xvdb','xvdc'}:
        raise RuntimeError('replacement finalizer has an unexpected Xen disk')
    with JOB.open('rb',buffering=0) as stream:
        raw = stream.read(MIB)
    body,sep,padding = raw.partition(b'\0')
    if not sep or not 0 < len(body) < MIB or padding.strip(b'\0'):
        raise RuntimeError('replacement finalizer has no bounded private job')
    value = json.loads(body,object_pairs_hook=unique)
    return validate_job(value,args)


def validate_job(value,args):
    fields = {'kind','box','operation_id','inputs_sha256','job_sha256',
              'preparation_job','manifest','prepared','first_contact',
              'runtime_packages','enrolled_guest'}
    if (not isinstance(value,dict) or set(value) != fields or
            value['kind'] != 'klokast.router-replacement-finalization-job.v1' or
            value['operation_id'] != args['klokast_operation'] or
            value['inputs_sha256'] != args['klokast_inputs'] or
            router_personalize.digest(value) != args['klokast_job'] or
            not isinstance(value['preparation_job'],dict) or
            value['preparation_job'].get('mode') != 'replacement' or
            value['preparation_job'].get('box') != value['box'] or
            value['preparation_job'].get('operation_id') != value['operation_id'] or
            value['preparation_job'].get('inputs_sha256') != value['inputs_sha256'] or
            not isinstance(value['preparation_job'].get('personalization'),dict) or
            value['job_sha256'] != router_personalize.digest(value['preparation_job']) or
            not isinstance(value['manifest'],dict) or
            value['manifest'].get('inputs_sha256') != value['inputs_sha256'] or
            not isinstance(value['manifest'].get('packages'),list) or
            any(not isinstance(part,dict) for part in value['manifest']['packages']) or
            {part.get('name'):part.get('version') for part in value['manifest'].get('packages',[])} !=
                value['preparation_job'].get('personalization',{}).get('packages') or
            not isinstance(value['prepared'],dict) or
            value['prepared'].get('accounts') is None or
            value['prepared'].get('mode') != 'replacement' or
            value['prepared'].get('packages') != value['preparation_job']['personalization']['packages'] or
            value['runtime_packages'] != value['preparation_job'].get('runtime_packages') or
            not isinstance(value['first_contact'],dict) or
            value['first_contact'].get('kind') != 'klokast.router-first-contact.v2' or
            not isinstance(value['enrolled_guest'],dict) or
            value['enrolled_guest'].get('box') != value['box'] or
            value['enrolled_guest'].get('operation_id') != value['operation_id'] or
            value['enrolled_guest'].get('hostname') !=
                value['box'] + '-router-' + value['operation_id'] or
            value['enrolled_guest'].get('tags') != ['tag:vm'] or
            value['enrolled_guest'].get('ssh') is not True or
            value['enrolled_guest'].get('host_key_public_sha256') !=
                value['first_contact'].get('host_key_public_sha256') or
            not re.fullmatch('[A-Za-z0-9_-]{1,128}',str(value['enrolled_guest'].get('machine_id'))) or
            not re.fullmatch('[0-9a-f]{64}',str(value['enrolled_guest'].get('state_sha256')))):
        raise RuntimeError('replacement finalizer job differs from its recorded generation')
    router_candidate.validate(value['preparation_job'])
    router_initial_contact.host_public_keys(value['first_contact'])
    return value


def finalize(value):
    deadline = time.monotonic()+300
    command(['/sbin/e2fsck','-fn','/dev/xvda3'],deadline)
    ROOT.mkdir(mode=0o700)
    command(['/bin/mount','-t','ext4','-o','rw,nodev,nosuid,exec','/dev/xvda3',ROOT],deadline)
    mounted = []
    try:
        for name in ('proc','sys','dev'):
            command(['/bin/mount','--bind','/'+name,ROOT/name],deadline)
            mounted.append(ROOT/name)
        accounts = value['prepared']['accounts']
        state = router_state.evidence(router_state.enrolled_snapshot(ROOT,**accounts))
        state_digest = router_personalize.digest(state)
        tailscale_state = state.get('var/lib/tailscale/tailscaled.state')
        if (not isinstance(tailscale_state,dict) or
                tailscale_state.get('sha256') != value['enrolled_guest']['state_sha256']):
            raise RuntimeError('replacement router identity differs from its enrollment result')
        job = value['preparation_job']
        details = job['first_contact']
        finalized = router_initial_contact.retire(ROOT,
            manifest=value['manifest'],personalization=job['personalization'],
            runtime_packages=value['runtime_packages'],accounts=accounts,
            enrolled_state_sha256=state_digest,first_contact=value['first_contact'],
            backend_address=details['backend_address'],backend_prefix=details['backend_prefix'],
            backend_source_address=details['backend_source_address'])
        command(['/bin/sync'],deadline)
        return finalized,state,state_digest
    finally:
        for path in reversed(mounted):
            command(['/bin/umount',path],deadline)
        command(['/bin/umount',ROOT],deadline)


def main():
    os.umask(0o077)
    value = guard()
    result = {'kind':'klokast.router-replacement-finalization-result.v1',
              'operation_id':value['operation_id'],'inputs_sha256':value['inputs_sha256'],
              'job_sha256':router_personalize.digest(value),'success':False}
    try:
        finalized,state,state_digest = finalize(value)
        result.update(finalized=finalized,state=state,state_sha256=state_digest,
                      machine_id=value['enrolled_guest']['machine_id'],success=True)
    except Exception as error:
        result['error'] = str(error)[:500]
    data = (json.dumps(result,sort_keys=True,separators=(',',':'))+'\n').encode()
    if len(data) >= MIB:
        raise RuntimeError('replacement finalizer result exceeds its fixed slot')
    with RESULT.open('r+b',buffering=0) as stream:
        stream.write(data+b'\0')
        os.fsync(stream.fileno())
    return 0 if result['success'] else 1


if __name__ == '__main__':
    raise SystemExit(main())
