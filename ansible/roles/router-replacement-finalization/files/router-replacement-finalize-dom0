#!/usr/bin/env python3
"""Assemble the immutable networkless B cleanup boot inputs."""
import argparse
import json
import os
from pathlib import Path
import runpy
import sys
import time

sys.dont_write_bytecode = True
sys.path.insert(0,str(Path(__file__).resolve().parent.parent))
sys.path.insert(0,str(Path(__file__).resolve().parent))
import router_native
import router_records as records


def main():
    os.umask(0o077)
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument('--box',required=True)
    parser.add_argument('--operation-id',required=True)
    parser.add_argument('--engine',required=True)
    parser.add_argument('--assemble-only',action='store_true',required=True)
    args = parser.parse_args()
    router_native.Native().guard(args.box,deadline=time.monotonic()+30)
    storage = records.Records(args.box)
    final = storage.operation(args.operation_id) / 'finalization'
    if Path(__file__).resolve().parent != final:
        raise RuntimeError('replacement finalizer is outside its exact operation directory')
    value = records.read(final / 'request.json')
    source = records.read(final.parent / 'request.json')
    release = records.read(final.parent / 'release.json')
    if (not isinstance(value,dict) or set(value) != {
            'kind','box','operation_id','engine_commit','inputs_sha256',
            'preparation_sha256','release_sha256','bootstrap'} or
            value['kind'] != 'klokast.router-replacement-finalizer-assets.v1' or
            value['box'] != args.box or value['operation_id'] != args.operation_id or
            value['engine_commit'] != args.engine or
            value['inputs_sha256'] != source.get('inputs_sha256') or
            value['preparation_sha256'] != records.generations.digest(source) or
            value['release_sha256'] != release.get('receipt_sha256')):
        raise RuntimeError('replacement finalizer boot inputs differ from preparation')
    assembler = records.secure(final / 'router-input-assembler.py')
    changed = runpy.run_path(str(assembler))['assemble_boot'](final,value)
    print(json.dumps({'kind':'klokast.router-replacement-finalizer-assembly.v1',
                      'assembled':changed},sort_keys=True))


if __name__ == '__main__':
    try:
        main()
    except Exception as error:
        print('Router replacement finalizer refused: ' + str(error),file=sys.stderr)
        raise SystemExit(1)
