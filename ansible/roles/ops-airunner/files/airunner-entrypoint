#!/bin/sh
set -eu

agent_uid="${AIRUNNER_AGENT_UID:?AIRUNNER_AGENT_UID is required}"
agent_gid="${AIRUNNER_AGENT_GID:?AIRUNNER_AGENT_GID is required}"
neo_uid="${AIRUNNER_NEO_UID:-1001}"
neo_gid="${AIRUNNER_NEO_GID:-1001}"

ensure_group() {
  name="$1"
  gid="$2"
  if getent group "$name" >/dev/null 2>&1; then
    current_gid="$(getent group "$name" | cut -d: -f3)"
    if [ "$current_gid" != "$gid" ]; then
      groupmod -g "$gid" "$name"
    fi
  elif getent group "$gid" >/dev/null 2>&1; then
    existing_name="$(getent group "$gid" | cut -d: -f1)"
    groupmod -n "$name" "$existing_name"
  else
    groupadd -g "$gid" "$name"
  fi
}

ensure_user() {
  name="$1"
  uid="$2"
  gid="$3"
  home="$4"
  if id "$name" >/dev/null 2>&1; then
    usermod -u "$uid" -g "$gid" -d "$home" -s /bin/bash "$name"
  elif getent passwd "$uid" >/dev/null 2>&1; then
    existing_name="$(getent passwd "$uid" | cut -d: -f1)"
    usermod -l "$name" -g "$gid" -d "$home" -s /bin/bash "$existing_name"
  else
    useradd -u "$uid" -g "$gid" -d "$home" -s /bin/bash -M "$name"
  fi
}

ensure_group agent "$agent_gid"
ensure_user agent "$agent_uid" "$agent_gid" /home/agent
install -d -m 0700 -o agent -g agent /home/agent

ensure_group neo "$neo_gid"
ensure_user neo "$neo_uid" "$neo_gid" /home/neo
install -d -m 0700 -o neo -g neo /home/neo
usermod -aG sudo neo
printf 'neo ALL=(ALL) NOPASSWD:ALL\n' >/etc/sudoers.d/90-neo
chmod 0440 /etc/sudoers.d/90-neo

install -d -m 0755 /run/tailscale
install -d -m 0700 /var/lib/tailscale

/usr/sbin/tailscaled \
  --state=/var/lib/tailscale/tailscaled.state \
  --socket=/run/tailscale/tailscaled.sock \
  --tun=tailscale0 &
tailscaled_pid="$!"

trap 'kill "$tailscaled_pid" 2>/dev/null || true; wait "$tailscaled_pid" 2>/dev/null || true' INT TERM

while [ ! -S /run/tailscale/tailscaled.sock ]; do
  if ! kill -0 "$tailscaled_pid" 2>/dev/null; then
    wait "$tailscaled_pid"
  fi
  sleep 1
done

wait "$tailscaled_pid"
