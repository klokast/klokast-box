"""Dom0-side lifecycle for the sealed, ephemeral Klokast CLI builder."""

import argparse
import hashlib
import json
import os
import re
import shutil
import subprocess
import sys
import time
from pathlib import Path


TEMPLATE_VERSION = 1
ALPINE_BRANCH = "3.23"
VG_NAME = "vg0"
TEMPLATE_LV_NAME = "lv_builder_klokast_cli_template"
TEMPLATE_LV = Path(f"/dev/{VG_NAME}/{TEMPLATE_LV_NAME}")
TEMPLATE_SIZE = "16G"
SNAPSHOT_COW_SIZE = "8G"
BUILDER_MEMORY_MIB = 2048
BUILDER_VCPUS = 2
BUILDER_TIMEOUT_SECONDS = 900
DATA_ROOT = Path("/mnt/dom0_data/klokast-builder")
