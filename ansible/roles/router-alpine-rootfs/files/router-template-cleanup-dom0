#!/usr/bin/env python3
"""Reclaim one failed or qualified router template operation's large files.

Small lifecycle and console evidence stays in place. No production LV, accepted
release, candidate, or other operation path is a cleanup target.
"""
import argparse
import fcntl
import hashlib
import json
import os
from pathlib import Path
import re
import socket
import stat
import subprocess
import tempfile
import time

BASE = Path('/mnt/dom0_data/klokast-router-templates')
FAILED_DISKS = ('os.slot', 'test.slot', 'kernel.slot', 'initramfs.slot', 'result.slot')
SCRATCH_DISKS = ('test.slot', 'kernel.slot', 'initramfs.slot', 'result.slot')
STAGED_INPUTS = ('capsule.tar', '.capsule.tar.assembling', 'bootstrap-kernel',
                 '.bootstrap-kernel.assembling', 'bootstrap-initramfs',
                 '.bootstrap-initramfs.assembling')
PART_ARTIFACTS = ('capsule', 'kernel', 'initramfs')
MIB = 1024 * 1024
DISK_LIMITS = {'os.slot':2048*MIB, 'test.slot':2048*MIB,
               'kernel.slot':32*MIB, 'initramfs.slot':128*MIB, 'result.slot':MIB}
INPUT_LIMITS = {'capsule.tar':2049*MIB, '.capsule.tar.assembling':2049*MIB,
                'bootstrap-kernel':32*MIB, '.bootstrap-kernel.assembling':32*MIB,
                'bootstrap-initramfs':1024*MIB, '.bootstrap-initramfs.assembling':1024*MIB}
UUID = re.compile(r'[0-9a-f]{8}-(?:[0-9a-f]{4}-){3}[0-9a-f]{12}')


def unique(pairs):
    value = {}
    for key, item in pairs:
        if key in value:
            raise RuntimeError('duplicate router cleanup record field')
        value[key] = item
    return value


def safe_dir(path):
    metadata = path.lstat()
    if (not stat.S_ISDIR(metadata.st_mode) or metadata.st_uid != 0 or
            stat.S_IMODE(metadata.st_mode) != 0o700):
        raise RuntimeError('router template cleanup directory is unsafe')


def safe_file(path):
    metadata = path.lstat()
    if (not stat.S_ISREG(metadata.st_mode) or metadata.st_uid != 0 or
            metadata.st_nlink != 1 or stat.S_IMODE(metadata.st_mode) & 0o022):
        raise RuntimeError('router template cleanup file is unsafe: ' + path.name)
    return metadata


def read(path):
    metadata = safe_file(path)
    if not 0 < metadata.st_size <= 1024 * 1024:
        raise RuntimeError('router template cleanup record is missing or too large')
    return json.loads(path.read_text(), object_pairs_hook=unique)


def domains(boot_paths=()):
    result = subprocess.run(['xl', 'list', '-l'], capture_output=True, text=True,
                            stdin=subprocess.DEVNULL, timeout=30)
    if result.returncode:
        raise RuntimeError('Xen domain inventory is unavailable')
    records = json.loads(result.stdout, object_pairs_hook=unique)
    if not isinstance(records, list) or not records:
        raise RuntimeError('Xen domain inventory is incomplete')
    identities = set()
    for record in records:
        info = record.get('config', {}).get('c_info', {})
        name = info.get('name')
        identity = info.get('uuid')
        if (type(record.get('domid')) is not int or not isinstance(name, str) or
                (record['domid'] == 0 and name != 'Domain-0') or
                (record['domid'] != 0 and (not isinstance(identity, str) or not UUID.fullmatch(identity)))):
            raise RuntimeError('Xen domain inventory has an unsupported format')
        boot = record.get('config', {}).get('b_info', {})
        if record['domid'] and (boot.get('kernel') in boot_paths or boot.get('ramdisk') in boot_paths):
            raise RuntimeError('router template boot file belongs to a live domain')
        identities.add((name, identity))
    if not any(name == 'Domain-0' for name, _ in identities):
        raise RuntimeError('Xen domain inventory lacks dom0')
    return identities


def attached(path):
    return sorted('/dev/' + item.parents[1].name
                  for item in Path('/sys/block').glob('loop*/loop/backing_file')
                  if item.read_text().strip().removesuffix(' (deleted)').lstrip('/') == str(path).lstrip('/'))


def capsule_parts(work, request=None):
    directory = work / 'parts'
    record = work / 'parts.json'
    if not directory.exists() and not directory.is_symlink():
        if record.exists() or record.is_symlink():
            raise RuntimeError('router capsule part directory is absent')
        return []
    safe_dir(directory)
    if {path.name for path in directory.iterdir()} != set(PART_ARTIFACTS):
        raise RuntimeError('router build input part directories differ from the fixed set')
    for artifact in PART_ARTIFACTS:
        safe_dir(directory / artifact)
    if not record.exists() and not record.is_symlink():
        if any(any((directory / artifact).iterdir()) for artifact in PART_ARTIFACTS):
            raise RuntimeError('router capsule parts lack an exact manifest')
        return []
    if request is None:
        request = read(work / 'request.json')
    parts = read(record)
    bootstrap = request.get('bootstrap')
    if (not isinstance(parts, list) or not 3 <= len(parts) <= 1553 or
            not isinstance(bootstrap, dict) or set(bootstrap) != {'kernel', 'initramfs'}):
        raise RuntimeError('router capsule part cleanup has no exact request')
    expected = {'capsule': request.get('capsule'), **bootstrap}
    present = []
    cursor = 0
    for artifact in PART_ARTIFACTS:
        reference = expected[artifact]
        group = [item for item in parts if isinstance(item, dict) and item.get('artifact') == artifact]
        if (not isinstance(reference, dict) or set(reference) != {'sha256', 'bytes'} or
                type(reference['bytes']) is not int or not 1 <= len(group) or
                parts[cursor:cursor + len(group)] != group):
            raise RuntimeError('router capsule part cleanup has an invalid artifact order')
        cursor += len(group)
        total = 0
        for index, item in enumerate(group):
            if (set(item) != {'artifact', 'name', 'bytes', 'sha256'} or
                    item['name'] != f'part-{index:04d}' or type(item['bytes']) is not int or
                    not 0 < item['bytes'] <= 2 * 1024 * 1024 or
                    index < len(group) - 1 and item['bytes'] != 2 * 1024 * 1024 or
                    not isinstance(item['sha256'], str) or not re.fullmatch('[0-9a-f]{64}', item['sha256'])):
                raise RuntimeError('router capsule part cleanup found an invalid sequence')
            total += item['bytes']
        part_dir = directory / artifact
        if total != reference['bytes'] or {path.name for path in part_dir.iterdir()} - {
                item['name'] for item in group}:
            raise RuntimeError('router capsule part cleanup differs from its request')
        for item in group:
            path = part_dir / item['name']
            if path.exists() or path.is_symlink():
                metadata = safe_file(path)
                if metadata.st_size != item['bytes'] or attached(path):
                    raise RuntimeError('router capsule part cleanup found changed or attached bytes')
                present.append((path, item['bytes']))
            else:
                present.append((path, item['bytes']))
    if cursor != len(parts):
        raise RuntimeError('router capsule part cleanup contains an unknown artifact')
    return present




def input_files(work, request):
    if (not isinstance(request.get('bootstrap'), dict) or
            set(request['bootstrap']) != {'kernel','initramfs'}):
        raise RuntimeError('router template cleanup input request is incomplete')
    expected = {'capsule.tar':request.get('capsule'),
                **{'bootstrap-'+name:item for name,item in request['bootstrap'].items()}}
    result = []
    for name in STAGED_INPUTS:
        reference = expected[name.removeprefix('.').removesuffix('.assembling')]
        if (not isinstance(reference, dict) or set(reference) != {'bytes','sha256'} or
                type(reference['bytes']) is not int or not 0 < reference['bytes'] <= INPUT_LIMITS[name] or
                not isinstance(reference['sha256'], str) or not re.fullmatch('[0-9a-f]{64}', reference['sha256'])):
            raise RuntimeError('router template cleanup input has an invalid bounded identity')
        result.append((work/name, reference['bytes']))
    return result


def digest(value):
    return hashlib.sha256(json.dumps(value, sort_keys=True, separators=(',', ':')).encode()).hexdigest()


def syncdir(path):
    descriptor = os.open(path, os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW)
    try:
        os.fsync(descriptor)
    finally:
        os.close(descriptor)


def write(path, value):
    descriptor, temporary = tempfile.mkstemp(prefix='.' + path.name + '-', dir=path.parent)
    temporary = Path(temporary)
    try:
        with os.fdopen(descriptor, 'w') as stream:
            json.dump(value, stream, sort_keys=True, separators=(',', ':'))
            stream.write('\n'); stream.flush(); os.fsync(stream.fileno())
        temporary.replace(path); syncdir(path.parent)
    finally:
        temporary.unlink(missing_ok=True)


def file_identity(path, maximum):
    metadata = safe_file(path)
    if not 0 <= metadata.st_size <= maximum or attached(path):
        raise RuntimeError('router template cleanup file changed or has a loop attachment: ' + path.name)
    return {'device':metadata.st_dev, 'inode':metadata.st_ino, 'bytes':metadata.st_size}


def retire(work, operation, kind, authority, selected, fresh, *, previously_reclaimed=()):
    """Only a protected plan and removal intent can explain a missing file."""
    deadline = time.monotonic() + 900
    def checked():
        if time.monotonic() >= deadline:
            raise RuntimeError('router template cleanup time limit reached; reconcile its exact plan')
        fresh()
    scope = {str(path.relative_to(work)):maximum for path, maximum in selected}
    if len(scope) != len(selected):
        raise RuntimeError('router template cleanup repeats selected files')
    prefix = 'cleanup-' + kind
    plan_path = work / (prefix + '-plan.json')
    fixed = {'kind':'klokast.router-template-cleanup-plan.v1', 'operation_id':operation,
             'cleanup_kind':kind, 'authority_sha256':digest(authority), 'scope_sha256':digest(scope)}
    checked()
    if plan_path.exists() or plan_path.is_symlink():
        plan = read(plan_path)
        if (not isinstance(plan, dict) or set(plan) != set(fixed) | {'files'} or
                any(plan.get(key) != value for key, value in fixed.items()) or
                not isinstance(plan['files'], list)):
            raise RuntimeError('router template cleanup plan changed')
        names = []
        for item in plan['files']:
            if (not isinstance(item, dict) or set(item) != {'name', 'identity'} or
                    not isinstance(item['name'], str) or item['name'] not in scope or
                    not isinstance(item['identity'], dict) or
                    set(item['identity']) != {'device', 'inode', 'bytes'} or
                    any(type(number) is not int for number in item['identity'].values()) or
                    item['identity']['device'] < 0 or item['identity']['inode'] <= 0 or
                    not 0 <= item['identity']['bytes'] <= scope[item['name']]):
                raise RuntimeError('router template cleanup has an invalid selected identity')
            names.append(item['name'])
        if len(names) != len(set(names)) or names != [name for name in scope if name in names]:
            raise RuntimeError('router template cleanup repeats or reorders files')
    else:
        files = []
        for name, maximum in scope.items():
            path = work / name
            if path.exists() or path.is_symlink():
                if name in previously_reclaimed:
                    raise RuntimeError('router template file reappeared after recorded cleanup')
                files.append({'name':name, 'identity':file_identity(path, maximum)})
        plan = {**fixed, 'files':files}; write(plan_path, plan)
    names = [item['name'] for item in plan['files']]
    progress_path = work / (prefix + '-progress.json')
    progress = read(progress_path) if progress_path.exists() or progress_path.is_symlink() else {
        'kind':'klokast.router-template-cleanup-progress.v1', 'plan_sha256':digest(plan),
        'removed':[], 'inflight':None}
    if (not isinstance(progress, dict) or set(progress) != {'kind','plan_sha256','removed','inflight'} or
            progress['kind'] != 'klokast.router-template-cleanup-progress.v1' or
            progress['plan_sha256'] != digest(plan) or not isinstance(progress['removed'], list) or
            len(progress['removed']) > len(names) or progress['removed'] != names[:len(progress['removed'])] or
            progress['inflight'] is not None and (len(progress['removed']) == len(names) or
                progress['inflight'] != names[len(progress['removed'])])):
        raise RuntimeError('router template cleanup progress changed')
    if any((work/name).exists() or (work/name).is_symlink() for name in scope if name not in names):
        raise RuntimeError('router template file appeared outside its cleanup plan')
    removed_now = []
    for item in plan['files']:
        name = item['name']; path = work/name; present = path.exists() or path.is_symlink()
        if name in progress['removed']:
            if present:
                raise RuntimeError('router template file reappeared after retirement')
            continue
        if not present and progress['inflight'] != name:
            raise RuntimeError('router template file disappeared without removal intent')
        checked()
        if present:
            if file_identity(path, scope[name]) != item['identity']:
                raise RuntimeError('router template file changed before retirement')
            progress['inflight'] = name; write(progress_path, progress)
            fresh(); path.unlink(); syncdir(path.parent); removed_now.append(name)
        progress['removed'].append(name); progress['inflight'] = None; write(progress_path, progress)
    checked()
    complete = {'kind':'klokast.router-template-cleanup.v2', 'operation_id':operation,
                'cleanup_kind':kind, 'removed':names,
                'bytes_reclaimed':sum(item['identity']['bytes'] for item in plan['files']),
                'plan_sha256':digest(plan), 'progress_sha256':digest(progress), 'status':'selected-files-retired'}
    target = work / (prefix + '-complete.json')
    if target.exists() or target.is_symlink():
        if read(target) != complete:
            raise RuntimeError('router template cleanup completion changed')
    else:
        write(target, complete)
    return {**complete, 'removed_now':removed_now}


def reclaim(work, operation, kind='failed', box=None):
    safe_dir(BASE)
    safe_dir(work)
    if kind == 'staged':
        if not box:
            raise RuntimeError('staged router cleanup requires an exact box')
        request = read(work / 'request.json')
        if (not isinstance(request, dict) or set(request) != {'kind', 'box', 'role', 'operation_id', 'inputs_sha256', 'capsule', 'bootstrap'} or
                request['kind'] != 'klokast.router-template-request.v1' or
                request['box'] != box or request['role'] != 'router' or
                request['operation_id'] != operation):
            raise RuntimeError('staged router cleanup request differs from the exact target')
        if any((work / name).exists() or (work / name).is_symlink()
               for name in ('lifecycle.json', 'candidate.json')) or list(work.glob('*.slot')):
            raise RuntimeError('staged router cleanup found a started build or disk')
        async_dir = work / 'async'
        if async_dir.exists() or async_dir.is_symlink():
            safe_dir(async_dir)
            if any(async_dir.iterdir()):
                raise RuntimeError('staged router cleanup found an active async record')
        def fresh():
            if any(name.endswith('-' + operation) for name, _ in domains({str(path) for path, _ in present})):
                raise RuntimeError('staged router template domain still exists')
            if any(attached(path) for path, _ in present):
                raise RuntimeError('staged router input still has a loop attachment')
        present = capsule_parts(work, request)
        present.extend(input_files(work, request))
        return retire(work, operation, kind, request, present, fresh)
    record = read(work / 'lifecycle.json')
    if (not isinstance(record, dict) or set(record) != {'stage', 'domains', 'uuids', 'operation_id'} or
            record['operation_id'] != operation or record['stage'] not in ('detached', 'storage-reclaimed', 'scratch-reclaimed') or
            not isinstance(record['domains'], dict) or set(record['domains']) not in (
                {'build', 'test', 'openrc'}, {'build', 'test', 'openrc', 'personalize'}) or
            not isinstance(record['uuids'], dict) or set(record['uuids']) != set(record['domains'])):
        raise RuntimeError('router template cleanup requires its exact detached operation record')
    for mode, name in record['domains'].items():
        if name != 'router-' + mode + '-' + operation or not UUID.fullmatch(record['uuids'][mode]):
            raise RuntimeError('router template cleanup has an invalid domain identity')
    if kind == 'failed':
        if record['stage'] not in ('detached', 'storage-reclaimed'):
            raise RuntimeError('failed router cleanup requires a detached operation')
        if (work / 'candidate.json').exists() or (work / 'candidate.json').is_symlink():
            raise RuntimeError('qualified router template cannot be reclaimed as failed build')
        disks, next_stage = FAILED_DISKS, 'storage-reclaimed'
    elif kind == 'scratch':
        if record['stage'] not in ('detached', 'scratch-reclaimed'):
            raise RuntimeError('qualified router cleanup requires a detached operation')
        candidate = read(work / 'candidate.json')
        generic = candidate.get('generic_tests')
        upstream = isinstance(generic, dict) and generic.get('upstream_tailscale') is True
        expected_generic = {'identity_absent': True, 'exact_packages': True,
                            'kernel_modules': True, 'openrc': True,
                            **({'upstream_tailscale': True} if upstream else {})}
        if (candidate.get('kind') != 'klokast.router-template-candidate.v1' or
                candidate.get('role') != 'router' or candidate.get('operation_id') != operation or
                generic != expected_generic or
                candidate.get('replacement_authorized') is not False):
            raise RuntimeError('qualified router cleanup lacks exact candidate evidence')
        required_tests = [('test', {'identity_absent': True, 'exact_packages': True,
                                        'kernel_modules': True, 'service_syntax': True,
                                        **({'upstream_tailscale': True} if upstream else {})}),
                               ('openrc', {'kernel_modules': True, 'openrc': True,
                                           'service_syntax': True})]
        if 'personalize' in record['domains']:
            required_tests.append(('personalize', dict.fromkeys(
                ('personalization', 'exact_packages', 'identity_absent', 'service_syntax'), True)))
        for mode, required in required_tests:
            result = read(work / (mode + '.json'))
            if mode == 'personalize' and 'service_probe' in result:
                required = {**required, 'native_services': True}
            if (result.get('kind') != 'klokast.router-template-test.v1' or result.get('success') is not True or
                    result.get('operation_id') != operation or result.get('tests') != required or
                    result.get('inputs_sha256') != candidate.get('inputs_sha256')):
                raise RuntimeError('qualified router cleanup lacks matching boot evidence')
            if mode == 'personalize' and candidate.get('personalization_test') != result:
                raise RuntimeError('qualified router cleanup has different personalization evidence')
        os_disk = work / 'os.slot'
        safe_file(os_disk)
        if attached(os_disk):
            raise RuntimeError('qualified router OS template remains attached')
        disks, next_stage = SCRATCH_DISKS, 'scratch-reclaimed'
    else:
        raise RuntimeError('router template cleanup kind is unsupported')
    if {path.name for path in work.glob('*.slot')} - set(FAILED_DISKS):
        raise RuntimeError('router template cleanup found an unknown disk')
    present = capsule_parts(work)
    present.extend((work/name, DISK_LIMITS[name]) for name in disks)
    request_path = work / 'request.json'
    request = read(request_path) if request_path.exists() or request_path.is_symlink() else None
    if request is not None:
        if request.get('operation_id') != operation or request.get('role') != 'router' or (
                box is not None and request.get('box') != box):
            raise RuntimeError('router template cleanup input request differs from its operation')
        present.extend(input_files(work, request))
    elif any((work/name).exists() or (work/name).is_symlink() for name in STAGED_INPUTS):
        raise RuntimeError('router template raw inputs have no exact request')
    if kind == 'failed':
        present.extend((work/name, maximum) for name, maximum in (('kernel',32*MIB),('initramfs',128*MIB)))
    def fresh():
        live = domains({str(path) for path, _ in present})
        if any(name in record['domains'].values() or identity in record['uuids'].values()
               for name, identity in live):
            raise RuntimeError('router template domain still exists')
        if any(attached(path) for path, _ in present):
            raise RuntimeError('router template disk still has a loop attachment')
    authority = {key:value for key, value in record.items() if key != 'stage'}
    authority['request'] = request
    if kind == 'scratch':
        authority['candidate'] = candidate
    result = retire(work, operation, kind, authority, present, fresh,
                    previously_reclaimed=[str(path.relative_to(work)) for path, _ in present
                        if path.name in disks or path.parent.parent.name == 'parts']
                        if record['stage'] == next_stage else ())
    if record['stage'] != next_stage:
        write(work / 'lifecycle.json', {**record, 'stage':next_stage})
    return result


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument('--box', required=True)
    parser.add_argument('--operation-id', required=True)
    parser.add_argument('--kind', choices=('failed', 'scratch', 'staged'), default='failed')
    args = parser.parse_args()
    if (os.geteuid() != 0 or not re.fullmatch('[a-z0-9][a-z0-9-]{0,30}', args.box) or
            not re.fullmatch('[0-9a-f]{24}', args.operation_id) or
            socket.gethostname().split('.')[0] != args.box + '-dom0' or
            Path('/sys/hypervisor/uuid').read_text().strip() != '00000000-0000-0000-0000-000000000000'):
        raise RuntimeError('router template cleanup requires root on the exact dom0')
    os.umask(0o077)
    safe_dir(BASE)
    work = BASE / args.operation_id
    with (BASE / 'build.lock').open('a') as lock:
        fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
        print(json.dumps(reclaim(work, args.operation_id, args.kind, args.box), sort_keys=True))


if __name__ == '__main__':
    try:
        main()
    except Exception as error:
        raise SystemExit('router-template-cleanup-dom0: ' + str(error))
