#!/usr/bin/env python3
"""Fence exactly one first-router Tailnet enrollment attempt on dom0."""
import argparse
import json
import os
from pathlib import Path
import sys

sys.dont_write_bytecode = True
sys.path.insert(0, str(Path(__file__).resolve().parent))
import router_initial_enrollment as enrollment
import router_records as records


def main():
    os.umask(0o077)
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument('--box',required=True)
    parser.add_argument('--operation-id',required=True)
    parser.add_argument('--engine',required=True)
    parser.add_argument('--finish',action='store_true')
    args = parser.parse_args()
    storage = records.Records(args.box)
    if Path(__file__).resolve().parent != storage.operation(args.operation_id):
        raise RuntimeError('first enrollment helper is outside its exact operation directory')
    result = (enrollment.finish(storage,args.operation_id,args.engine) if args.finish else
              enrollment.begin(storage,args.operation_id,args.engine))
    print(json.dumps(result,sort_keys=True))


if __name__ == '__main__':
    try:
        main()
    except Exception as error:
        print('Router first enrollment refused: ' + str(error),file=sys.stderr)
        raise SystemExit(1)
