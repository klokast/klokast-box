#!/usr/bin/env python3
"""Accept only the verified first router under a fresh controller grant."""
import argparse
import json
import os
from pathlib import Path
import sys

sys.dont_write_bytecode = True
sys.path.insert(0,str(Path(__file__).resolve().parent.parent))
sys.path.insert(0,str(Path(__file__).resolve().parent))
import router_initial_acceptance as acceptance
import router_records as records


def main():
    os.umask(0o077)
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument('--box',required=True)
    parser.add_argument('--operation-id',required=True)
    parser.add_argument('--engine',required=True)
    args = parser.parse_args()
    storage = records.Records(args.box)
    final = records.secure(storage.operation(args.operation_id) / 'finalization',directory=True)
    if Path(__file__).resolve().parent != final:
        raise RuntimeError('first router acceptance helper is outside its exact operation')
    print(json.dumps(acceptance.execute(storage,args.operation_id,args.engine),sort_keys=True))


if __name__ == '__main__':
    try:
        main()
    except Exception as error:
        print('First router acceptance refused: ' + str(error),file=sys.stderr)
        raise SystemExit(1)
