#!/usr/bin/env python3
"""Stop one enrolled first router, then run an offline networkless cleanup guest."""
import argparse
import json
import os
from pathlib import Path
import runpy
import sys

sys.dont_write_bytecode = True
sys.path.insert(0,str(Path(__file__).resolve().parent.parent))
sys.path.insert(0,str(Path(__file__).resolve().parent))
import router_initial_finalization as finalization
import router_records as records


def main():
    os.umask(0o077)
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument('--box',required=True)
    parser.add_argument('--operation-id',required=True)
    parser.add_argument('--engine',required=True)
    actions = parser.add_mutually_exclusive_group(required=True)
    actions.add_argument('--assemble-only',action='store_true')
    actions.add_argument('--stop',action='store_true')
    actions.add_argument('--finalize',action='store_true')
    actions.add_argument('--start-final',action='store_true')
    args = parser.parse_args()
    storage = records.Records(args.box)
    work = storage.operation(args.operation_id)
    final = records.secure(work / 'finalization',directory=True)
    if Path(__file__).resolve().parent != final:
        raise RuntimeError('initial finalizer is outside its exact operation directory')
    finalization.native.Native().guard(args.box,deadline=finalization.time.monotonic()+30)
    if args.assemble_only:
        value = records.read(final / 'request.json')
        if (value.get('box') != args.box or value.get('operation_id') != args.operation_id or
                value.get('engine_commit') != args.engine):
            raise RuntimeError('initial finalizer input assembly targets another operation')
        assembler = records.secure(final / 'router-input-assembler.py')
        changed = runpy.run_path(str(assembler))['assemble_boot'](final,value)
        result = {'kind':'klokast.router-initial-finalization-assembly.v1','assembled':changed}
    elif args.stop:
        result = finalization.stop(storage,args.operation_id,args.engine)
    elif args.start_final:
        result = finalization.start_final(storage,args.operation_id,args.engine)
    else:
        result = finalization.execute(storage,args.operation_id,args.engine)
        records.write(final / 'complete.json',result)
    print(json.dumps(result,sort_keys=True))


if __name__ == '__main__':
    try:
        main()
    except Exception as error:
        print('Router initial finalization refused: ' + str(error),file=sys.stderr)
        raise SystemExit(1)
