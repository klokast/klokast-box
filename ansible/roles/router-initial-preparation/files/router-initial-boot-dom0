#!/usr/bin/env python3
"""Start one recorded first router; do not enroll or accept it."""
import argparse
import json
import os
from pathlib import Path
import sys

sys.dont_write_bytecode = True
sys.path.insert(0, str(Path(__file__).resolve().parent))
import router_initial_boot as boot
import router_records as records


def main():
    os.umask(0o077)
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument('--box', required=True)
    parser.add_argument('--operation-id', required=True)
    parser.add_argument('--engine', required=True)
    args = parser.parse_args()
    storage = records.Records(args.box)
    if Path(__file__).resolve().parent != storage.operation(args.operation_id):
        raise RuntimeError('initial boot helper is outside its exact operation directory')
    print(json.dumps(boot.execute(storage, args.operation_id, args.engine), sort_keys=True))


if __name__ == '__main__':
    try:
        main()
    except Exception as error:
        print('Router first boot refused: ' + str(error), file=sys.stderr)
        raise SystemExit(1)
