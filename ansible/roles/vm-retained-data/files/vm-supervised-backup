#!/usr/bin/env python3
"""Back up one running, unmanaged shared VM disk for a supervised cutover.

The caller supplies a box, role, operation ID, and source commit. The source
disk and its LVM identity come only from the installed dom0 source reader.
This command never stops a guest or selects a replacement disk.
"""

import argparse
import json
import os
from pathlib import Path
import re
import socket
import subprocess
import sys

import vm_disk_backup as backup

BASE = Path('/mnt/dom0_data/klokast-vm-supervised')
TARGETS = {('k001', 'dmz'), ('k002', 'dmz'), ('k002', 'iot')}


def source_status(role):
    result = subprocess.run(
        ['/usr/local/sbin/vm-update-transaction', 'source-status', '--role', role],
        stdin=subprocess.DEVNULL, capture_output=True, text=True, timeout=180)
    if result.returncode or not 0 < len(result.stdout) <= 16384:
        raise backup.BackupError('dom0 did not return a complete running source receipt')
    return json.loads(result.stdout, object_pairs_hook=backup.unique)


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument('--box', required=True)
    parser.add_argument('--role', required=True)
    parser.add_argument('--operation-id', required=True)
    parser.add_argument('--engine-commit', required=True)
    args = parser.parse_args()
    os.umask(0o077)
    if (os.geteuid() != 0 or (args.box, args.role) not in TARGETS or
            socket.gethostname().split('.')[0] != args.box + '-dom0' or
            not re.fullmatch(r'[0-9a-f]{24}', args.operation_id) or
            not re.fullmatch(r'[0-9a-f]{40}', args.engine_commit)):
        raise backup.BackupError('supervised backup requires dom0 root and one fixed running target')
    root = BASE / args.operation_id
    backup.secure(BASE, True)
    backup.secure(root, True)
    work = root / 'backup'
    backup.secure(work, True)
    source = source_status(args.role)
    if (not isinstance(source, dict) or source.get('kind') != 'klokast.vm-unmanaged-source.v1' or
            source.get('dom0') != args.box + '-dom0' or source.get('role') != args.role or
            source.get('runtime') != 'running' or source.get('autostart') is not True or
            not isinstance(source.get('disks'), dict) or len(source['disks']) != 1):
        raise backup.BackupError('source is not the one running, unmanaged guest disk')
    path, identity = next(iter(source['disks'].items()))
    if path != '/dev/vg0/lv_podman_' + args.role or not isinstance(identity, dict):
        raise backup.BackupError('source disk path differs from the fixed shared-VM layout')
    import time
    if type(source.get('observed_at')) is not int or not 0 <= time.time() - source['observed_at'] <= 60:
        raise backup.BackupError('source receipt is stale or from the future')
    request = {
        'kind': 'klokast.vm-disk-backup.v1', 'operation_id': args.operation_id,
        'box': args.box, 'engine_commit': args.engine_commit,
        'source_evidence_sha256': backup.digest(source),
        'source': {'path': path, 'uuid': identity['uuid'], 'bytes': identity['bytes']},
        'cow_bytes': 16 * 1024**3, 'requested_at': int(time.time()),
    }
    result = backup.make_backup(work, request)
    backup.store(root / 'source.json', source)
    print(backup.canonical(result).decode())


if __name__ == '__main__':
    try:
        main()
    except (backup.BackupError, OSError, ValueError, KeyError, TypeError,
            subprocess.TimeoutExpired) as error:
        print('vm-supervised-backup: ' + str(error), file=sys.stderr)
        raise SystemExit(1)
