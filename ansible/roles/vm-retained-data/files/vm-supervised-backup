#!/usr/bin/env python3
"""Back up one running shared VM source disk for supervised maintenance.

The caller supplies a box, role, operation ID, and source commit. The source
disk and its LVM identity come only from the protected dom0 source reader.
This command never stops a guest or selects a replacement disk.
"""

import argparse
import json
import os
from pathlib import Path
import re
import socket
import subprocess
import sys

import vm_disk_backup as backup
import vm_maintenance_source as sources

BASE = Path('/mnt/dom0_data/klokast-vm-supervised')
TARGETS = {('k001', 'dmz'), ('k002', 'dmz'), ('k002', 'iot')}


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument('--box', required=True)
    parser.add_argument('--role', required=True)
    parser.add_argument('--operation-id', required=True)
    parser.add_argument('--engine-commit', required=True)
    parser.add_argument('--source-layout', choices=('legacy-root', 'retained-data'), default='legacy-root')
    args = parser.parse_args()
    os.umask(0o077)
    if (os.geteuid() != 0 or (args.box, args.role) not in TARGETS or
            socket.gethostname().split('.')[0] != args.box + '-dom0' or
            not re.fullmatch(r'[0-9a-f]{24}', args.operation_id) or
            not re.fullmatch(r'[0-9a-f]{40}', args.engine_commit)):
        raise backup.BackupError('supervised backup requires dom0 root and one fixed running target')
    root = BASE / args.operation_id
    backup.secure(BASE, True)
    backup.secure(root, True)
    work = root / 'backup'
    backup.secure(work, True)
    source = sources.read(args.role, retained=args.source_layout == 'retained-data')
    selected = sources.details(source, args.box, args.role)['source']
    path, identity = selected['path'], selected
    import time
    if type(source.get('observed_at')) is not int or not 0 <= time.time() - source['observed_at'] <= 60:
        raise backup.BackupError('source receipt is stale or from the future')
    request = {
        'kind': 'klokast.vm-disk-backup.v1', 'operation_id': args.operation_id,
        'box': args.box, 'engine_commit': args.engine_commit,
        'source_evidence_sha256': backup.digest(source),
        'source': {'path': path, 'uuid': identity['uuid'], 'bytes': identity['bytes']},
        'cow_bytes': min(16 * 1024**3, identity['bytes']), 'requested_at': int(time.time()),
    }
    backup.store(root / 'source.json', source)
    result = backup.make_backup(work, request)
    sources.same_generation(source, sources.read(args.role, retained=args.source_layout == 'retained-data'))
    print(backup.canonical(result).decode())


if __name__ == '__main__':
    try:
        main()
    except (backup.BackupError, OSError, ValueError, KeyError, TypeError,
            subprocess.TimeoutExpired) as error:
        print('vm-supervised-backup: ' + str(error), file=sys.stderr)
        raise SystemExit(1)
