#!/usr/bin/python3
"""Final-sync machine identity from the stopped old VM to staged storage."""

import argparse
import json
import os
from pathlib import Path
import re
import socket
import subprocess
import sys

import retained_data as data
import vm_disk_backup as backup

BASE = Path('/mnt/dom0_data/klokast-vm-supervised')
TARGETS = {('k001', 'dmz'), ('k002', 'dmz'), ('k002', 'iot')}


def read(path):
    backup.secure(path)
    return json.loads(path.read_text(), object_pairs_hook=backup.unique)


def finalize(args):
    if (os.geteuid() != 0 or (args.box, args.role) not in TARGETS or
            socket.gethostname().split('.')[0] != args.box + '-dom0' or
            any(not re.fullmatch(r'[0-9a-f]{24}', value)
                for value in (args.operation_id, args.candidate_id))):
        raise backup.BackupError('final sync requires dom0 root and one fixed target')
    root = BASE / args.operation_id
    for path in (BASE, root, root / 'stage', root / 'code'):
        backup.secure(path, True)
    prepared = read(root / 'prepared.json')
    staged = read(root / 'stage/request.json')
    stage_result = read(root / 'stage/result.json')
    receipt = stage_result.get('receipt')
    if (prepared.get('operation_id') != args.operation_id or
            prepared.get('box') != args.box or prepared.get('role') != args.role or
            prepared.get('candidate_id') != args.candidate_id or
            staged.get('mode') != 'stage' or staged.get('operation_id') != args.operation_id or
            stage_result.get('success') is not True or not isinstance(receipt, dict) or
            receipt.get('kind') != 'klokast.vm-retained-stage-result.v3' or
            receipt.get('request_sha256') != data.digest(staged['request']) or
            receipt.get('receipt_sha256') != data.digest({k: v for k, v in receipt.items()
                                                            if k != 'receipt_sha256'})):
        raise backup.BackupError('final sync lacks the exact successful identity stage')
    status = subprocess.run(['/usr/local/sbin/vm-update-transaction', 'status',
                             '--operation-id', args.operation_id],
                            stdin=subprocess.DEVNULL, capture_output=True, text=True, timeout=30)
    if status.returncode or len(status.stdout) > 65536:
        raise backup.BackupError('bounded local recovery transaction is unavailable')
    journal = json.loads(status.stdout, object_pairs_hook=backup.unique)
    if journal.get('stage') != 'stopped':
        raise backup.BackupError('final sync requires a stopped old VM under armed local recovery')
    request = dict(staged, mode='finalize', stage_receipt_sha256=receipt['receipt_sha256'])
    data.staged_request(request['request'])
    work = root / 'finalize'
    work.mkdir(mode=0o700)
    backup.secure(work, True)
    if any(work.iterdir()):
        raise backup.BackupError('final sync already started; inspect its exact result')
    backup.store(work / 'request.json', request)
    command = ['/usr/bin/python3', str(root / 'code/vm-supervised-maintenance-dom0'),
               '--box', args.box, '--role', args.role,
               '--operation-id', args.operation_id, '--candidate-id', args.candidate_id,
               '--mode', 'finalize', '--source', prepared['old_source']['path'],
               '--destination', prepared['data']['path']]
    result = subprocess.run(command, stdin=subprocess.DEVNULL, capture_output=True,
                            text=True, timeout=1800)
    if result.returncode:
        raise backup.BackupError('isolated final sync failed; local recovery must restore the old VM')
    return json.loads(result.stdout, object_pairs_hook=backup.unique)


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument('--box', required=True)
    parser.add_argument('--role', required=True)
    parser.add_argument('--operation-id', required=True)
    parser.add_argument('--candidate-id', required=True)
    args = parser.parse_args()
    os.umask(0o077)
    print(backup.canonical(finalize(args)).decode())


if __name__ == '__main__':
    try:
        main()
    except (backup.BackupError, data.CopyError, OSError, ValueError, TypeError,
            KeyError, subprocess.TimeoutExpired) as error:
        print('vm-supervised-finalize-dom0: ' + str(error), file=sys.stderr)
        raise SystemExit(1)
