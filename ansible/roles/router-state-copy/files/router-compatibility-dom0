BASE = Path('/mnt/dom0_data/klokast-router-compatibility')
TEMPLATES = Path('/mnt/dom0_data/klokast-router-templates')
MIB = 1024 * 1024
PHASES = ('prepare', 'seed', 'forward', 'new', 'reverse', 'old')
HOLD_PHASES = ('hold-old', 'hold-new')
SLOTS = {'old': 2048 * MIB, 'new': 2048 * MIB, 'scratch': 2048 * MIB,
         'copy': MIB, 'result': MIB, 'previous': MIB}


def load(path):
    safe_file(path, MIB)
    return json.loads(path.read_text(), object_pairs_hook=duplicate_fields)


def digest(value):
    import hashlib
    return hashlib.sha256(json.dumps(value, sort_keys=True, ensure_ascii=False,
                                    separators=(',', ':')).encode()).hexdigest()


def artifact_identity(expected, maximum):
    if (not isinstance(expected, dict) or set(expected) != {'bytes', 'sha256'} or
            type(expected['bytes']) is not int or not 0 < expected['bytes'] <= maximum or
            not re.fullmatch('[0-9a-f]{64}', str(expected['sha256']))):
        raise RuntimeError('compatibility artifact identity is invalid')


def artifact(path, expected, maximum):
    artifact_identity(expected,maximum)
    safe_file(path, maximum)
    if path.stat().st_size != expected['bytes'] or checksum(path) != expected['sha256']:
        raise RuntimeError('compatibility artifact differs from recorded bytes')


def request(work, box, operation, *, verify_boot=True, historical=False):
    value = load(work / 'request.json')
    fields = {'kind', 'role', 'box', 'operation_id', 'inputs_sha256', 'engine_commit',
              'bootstrap', 'template', 'source', 'guest'}
    if (not isinstance(value, dict) or set(value) != fields or
            value['kind'] not in (('klokast.router-compatibility-host.v1', 'klokast.router-compatibility-host.v2')
                                 if historical else ('klokast.router-compatibility-host.v2',)) or value['role'] != 'router' or
            value['box'] != box or value['operation_id'] != operation or
            not re.fullmatch('[0-9a-f]{64}', str(value['inputs_sha256'])) or
            not re.fullmatch('[0-9a-f]{40}', str(value['engine_commit'])) or
            not isinstance(value['template'], dict) or set(value['template']) != {'operation', 'sha256'} or
            not re.fullmatch('[0-9a-f]{24}', str(value['template']['operation'])) or
            not re.fullmatch('[0-9a-f]{64}', str(value['template']['sha256'])) or
            not isinstance(value['bootstrap'], dict) or set(value['bootstrap']) != {'kernel', 'initramfs'}):
        raise RuntimeError('compatibility request has an invalid target or contract')
    guest = value['guest']
    if (not isinstance(guest, dict) or set(guest) != {'kind', 'operation_id', 'inputs_sha256', 'box',
            'source_packages', 'source_files', 'source_kernel_release', 'fixture', 'manifest',
            'runtime_packages', 'kernel_release'} or
            guest['kind'] != value['kind'].replace('host', 'request') or
            any(guest[key] != value[key] for key in ('operation_id', 'inputs_sha256', 'box')) or
            guest['manifest'].get('inputs_sha256') != value['inputs_sha256'] or
            not all(re.fullmatch('[A-Za-z0-9_.+-]{1,128}', str(guest[k]))
                    for k in ('kernel_release', 'source_kernel_release'))):
        raise RuntimeError('compatibility guest contract is invalid')
    for name, maximum in (('kernel', 32 * MIB), ('initramfs', 1024 * MIB)):
        artifact_identity(value['bootstrap'][name],maximum)
        if verify_boot:
            artifact(work / name, value['bootstrap'][name], maximum)
    return value


def retire_historical_artifacts(work, operation, box, *, absent_only=False):
    """Collect only boot copies after a historical disk cleanup, never a disk.

    The caller holds test.lock. A changed production assignment does not
    invalidate historical diagnostic metadata; absence and protected current
    references are checked under the production record lock instead.
    """
    records = router_candidate_disk.records
    storage = records.Records(box, records.BASE)
    with storage.lock():
        value = request(work, box, operation, verify_boot=False, historical=True)
        record = load(work/'lifecycle.json')
        if (not isinstance(record, dict) or set(record) != {'operation_id','stage','uuids','slots'} or
                record['operation_id'] != operation or record['stage'] != 'cleaned' or
                not isinstance(record['uuids'], dict) or
                set(record['uuids']) not in (set(PHASES), set(PHASES+HOLD_PHASES)) or
                not isinstance(record['slots'], dict) or
                set(record['slots']) not in (set(SLOTS), set(SLOTS)-{'new'})):
            raise RuntimeError('historical artifact cleanup requires a complete cleaned disk ledger')
        for identity in record['uuids'].values():
            if not isinstance(identity, str) or str(uuid.UUID(identity)) != identity:
                raise RuntimeError('historical artifact cleanup has an invalid helper UUID')
        for name, item in record['slots'].items():
            if (not isinstance(item, dict) or set(item) != {'device','inode','bytes'} or
                    any(type(number) is not int for number in item.values()) or
                    item['device'] < 0 or item['inode'] <= 0 or item['bytes'] != SLOTS[name]):
                raise RuntimeError('historical artifact cleanup has an invalid retired slot identity')
        snapshot = load(work/'snapshot.json')
        if (not isinstance(snapshot, dict) or
                set(snapshot) != {'operation_id','path','tag','origin_uuid','uuid','stage'} or
                snapshot['operation_id'] != operation or snapshot['stage'] != 'retired' or
                snapshot['path'] != '/dev/vg0/routercompat_'+operation or
                snapshot['tag'] != 'routercompat_'+operation or
                any(not isinstance(snapshot[key], str) or
                    not re.fullmatch('[A-Za-z0-9-]{1,64}', snapshot[key]) for key in ('uuid','origin_uuid')) or
                snapshot['origin_uuid'] != value['source']['disk']['uuid']):
            raise RuntimeError('historical artifact cleanup requires the exact retired snapshot')
        candidate_path = work/'candidate-disk.json'
        candidate = router_candidate_disk.record(work, operation) if candidate_path.exists() or candidate_path.is_symlink() else None
        if (candidate is not None and candidate['stage'] != 'retired' or
                candidate is None and set(record['slots']) != set(SLOTS) or
                candidate is not None and set(record['slots']) != set(SLOTS)-{'new'}):
            raise RuntimeError('historical artifact cleanup has another retired candidate layout')
        selected_path = router_candidate_disk.selection(operation)[0]
        selected_uuid = candidate['uuid'] if candidate is not None else None
        deadline = time.monotonic()+900
        def fresh():
            if time.monotonic() >= deadline:
                raise RuntimeError('historical artifact cleanup time limit reached; retain its exact plan')
            if (request(work,box,operation,verify_boot=False,historical=True) != value or
                    load(work/'lifecycle.json') != record or load(work/'snapshot.json') != snapshot or
                    (router_candidate_disk.record(work,operation) if candidate_path.exists() or candidate_path.is_symlink() else None) != candidate):
                raise RuntimeError('historical artifact cleanup source records changed')
            if storage.cold_test() is not None:
                raise RuntimeError('historical artifact cleanup is forbidden during a supervised cold test')
            router_candidate_disk.refuse_referenced_disk(box,operation,{'path':selected_path,'uuid':selected_uuid})
            if (snapshot_info(snapshot['path'],identity=snapshot['uuid']) is not None or
                    router_candidate_disk.observed(operation,identity=selected_uuid) is not None):
                raise RuntimeError('historical diagnostic LV reappeared; retain its artifacts')
            if list(work.glob('*.slot')) or any(loop_devices(work/(name+'.slot')) for name in SLOTS):
                raise RuntimeError('historical diagnostic slot or loop remains; retain its artifacts')
            names = {'router-compat-'+phase+'-'+operation for phase in PHASES+HOLD_PHASES}
            for guest in router_native.Native().inventory(deadline=time.monotonic()+30):
                info = guest['config']['c_info']
                if guest['domid'] and (info['uuid'] in record['uuids'].values() or info.get('name') in names):
                    raise RuntimeError('historical diagnostic helper remains; retain its artifacts')
        fresh()
        present = [name for name in boot_artifacts.LIMITS if (work/name).exists() or (work/name).is_symlink()]
        retired = boot_artifacts.retire(work,value,TEMPLATES/value['template']['operation'],
            authorize=fresh,historical=True,absent_only=absent_only)
        fresh()
        result = {'kind':'klokast.router-compatibility-historical-cleanup.v1','box':box,
                  'operation_id':operation,'engine_commit':value['engine_commit'],
                  'request_sha256':digest(value),'lifecycle_sha256':digest(record),
                  'snapshot_sha256':digest(snapshot),'candidate_sha256':digest(candidate),
                  'artifact_cleanup_sha256':digest(retired), 'bytes_reclaimed':retired['bytes_reclaimed'],
                  'status':'historical-artifacts-absent' if absent_only else 'historical-artifacts-retired'}
        target = work/'historical-cleanup-complete.json'
        if target.exists() or target.is_symlink():
            if load(target) != result:
                raise RuntimeError('historical artifact cleanup completion changed')
        else:
            write(target,result)
        return {**result,'removed_now':present}


def source_identity(work, value):
    current = runpy.run_path(str(work / 'inspect-router-update.py'))['inspect_dom0'](value['box'])
    wanted = value['source']
    if (not isinstance(wanted, dict) or set(wanted) != {'configuration_sha256', 'xen_runtime', 'boot_artifacts', 'disk', 'accepted'} or
            current['pending_record_present'] or
            current['accepted_record_present'] is not (wanted['accepted'] is not None) or
            current['xen_runtime_matches'] is not True or
            any(current[key] != wanted[key] for key in ('configuration_sha256', 'xen_runtime', 'boot_artifacts'))):
        raise RuntimeError('router source runtime, boot, configuration, or assignment changed')
    expected_path = '/dev/vg0/lv_router'
    if wanted['accepted'] is not None:
        accepted = wanted['accepted']
        if (not isinstance(accepted, dict) or accepted.get('kind') != 'klokast.router-accepted-source.v1' or
                accepted.get('box') != value['box'] or
                not isinstance(accepted.get('assignment'), dict) or
                not isinstance(accepted.get('generation'), dict) or
                accepted['generation'].get('origin') not in ('legacy', 'template') or
                accepted['assignment'].get('current_sha256') != accepted['generation'].get('record_sha256')):
            raise RuntimeError('accepted router source request is invalid')
        generation = accepted['generation']
        expected_path = ('/dev/vg0/lv_router' if generation['origin'] == 'legacy' else
                         '/dev/vg0/routergen_' + generation['generation_id'])
        if (generation.get('disk') != wanted['disk'] or
                generation.get('packages') != value['guest']['source_packages'] or
                generation.get('kernel_release') != value['guest']['source_kernel_release'] or
                any(generation.get('configuration_files', {}).get(name) != checksum
                    for name, checksum in value['guest']['source_files'].items())):
            raise RuntimeError('compatibility source differs from its accepted generation')
        live = json.loads(run(['/usr/local/sbin/router-update-transaction', 'accepted-source',
                               '--box', value['box']]).stdout)
        if (live.get('kind') != 'klokast.router-command-result.v1' or
                live.get('box') != value['box'] or live.get('action') != 'accepted-source' or
                live.get('engine_commit') != value['engine_commit'] or
                live.get('result') != accepted):
            raise RuntimeError('protected accepted router source changed during compatibility')
    disk = wanted['disk']
    if (not isinstance(disk, dict) or set(disk) != {'path', 'uuid', 'bytes'} or
            disk['path'] != expected_path or disk['bytes'] != SLOTS['old'] or
            not re.fullmatch('[A-Za-z0-9-]{1,64}', str(disk['uuid'])) or
            current['xen']['disk'] != ['phy:' + expected_path + ',xvda,w']):
        raise RuntimeError('router compatibility supports only the exact recorded two GiB source LV')
    rows = current['logical_volumes']['report'][0]['lv']
    matches = [row for row in rows if row['lv_path'] == disk['path']]
    if (len(matches) != 1 or matches[0]['lv_uuid'] != disk['uuid'] or matches[0]['origin'] or
            int(matches[0]['lv_size']) != disk['bytes']):
        raise RuntimeError('router compatibility source LV identity changed')
    return current


def snapshot_info(path, *, identity=None):
    # A successful complete inventory is required before absence is accepted.
    value = json.loads(run(['lvs', '--reportformat', 'json', '--units', 'b', '--nosuffix',
        '-o', 'lv_path,lv_uuid,lv_size,origin_uuid,lv_attr,lv_tags,data_percent']).stdout,
        object_pairs_hook=duplicate_fields)
    if (not isinstance(value,dict) or not isinstance(value.get('report'),list) or not value['report'] or
            any(not isinstance(report,dict) or not isinstance(report.get('lv'),list) for report in value['report'])):
        raise RuntimeError('compatibility snapshot inventory is incomplete')
    fields = {'lv_path','lv_uuid','lv_size','origin_uuid','lv_attr','lv_tags','data_percent'}
    rows = [row for report in value['report'] for row in report['lv']]
    if (any(not isinstance(row,dict) or set(row) != fields or
            any(not isinstance(item,str) for item in row.values()) for row in rows)):
        raise RuntimeError('compatibility snapshot identity is ambiguous')
    rows = [{key:item.strip() for key,item in row.items()} for row in rows]
    if (len({row['lv_path'] for row in rows}) != len(rows) or
            len({row['lv_uuid'] for row in rows}) != len(rows)):
        raise RuntimeError('compatibility snapshot identity is ambiguous')
    if identity is not None and any(row['lv_uuid'] == identity and row['lv_path'] != str(path) for row in rows):
        raise RuntimeError('compatibility snapshot UUID moved to another path; retain it')
    return next((row for row in rows if row['lv_path'] == str(path)),None)


def validate_snapshot(row, record):
    if (row is None or row['lv_uuid'] != record['uuid'] or row['origin_uuid'] != record['origin_uuid'] or
            row['lv_path'] != record['path'] or row['lv_tags'].split(',') != [record['tag']] or
            not row['lv_attr'].startswith('sr') or row['lv_attr'][4] != 'a' or
            int(row['lv_size']) != 1024 * MIB or not 0 <= float(row['data_percent']) < 95):
        raise RuntimeError('compatibility snapshot changed or exceeded its COW reserve; retain it')


def retire_snapshot(work):
    record = load(work / 'snapshot.json')
    if (set(record) != {'operation_id','path','tag','origin_uuid','uuid','stage'} or
            record.get('operation_id') != work.name or record.get('stage') not in ('created', 'retiring', 'retired') or
            record.get('path') != '/dev/vg0/routercompat_' + work.name or
            record.get('tag') != 'routercompat_' + work.name or
            any(not isinstance(record.get(key),str) or not re.fullmatch('[A-Za-z0-9-]{1,64}',record[key])
                for key in ('uuid','origin_uuid'))):
        raise RuntimeError('compatibility snapshot has no exact retirement record')
    row = snapshot_info(record['path'],identity=record['uuid'])
    if row is None:
        if record['stage'] == 'created':
            raise RuntimeError('compatibility snapshot disappeared without its removal intent')
        if record['stage'] == 'retiring':
            write(work / 'snapshot.json', {**record, 'stage':'retired'})
        return
    if record['stage'] == 'retired':
        raise RuntimeError('compatibility snapshot reappeared after retirement; retain it')
    validate_snapshot(row, record)
    router_native.Native().wait_detached([record['path']],deadline=time.monotonic()+30)
    validate_snapshot(snapshot_info(record['path'],identity=record['uuid']),record)
    write(work / 'snapshot.json', {**record,'stage':'retiring'})
    run(['lvremove', '--yes', record['path']])
    if snapshot_info(record['path'],identity=record['uuid']) is not None:
        raise RuntimeError('compatibility snapshot remains after retirement')
    write(work / 'snapshot.json', {**record, 'stage': 'retired'})


def reconcile_snapshot(work, value, expected_uuid):
    """Resolve an interrupted create only with an explicitly inspected UUID."""
    source_identity(work, value)
    record = load(work / 'snapshot.json')
    if (set(record) != ({'operation_id','stage','path','tag','origin_uuid'} |
                       ({'uuid'} if record.get('stage') != 'planned' else set())) or
            record.get('operation_id') != work.name or record.get('stage') not in ('planned', 'created','retiring','retired') or
            record.get('path') != '/dev/vg0/routercompat_' + work.name or
            record.get('tag') != 'routercompat_' + work.name or
            record.get('origin_uuid') != value['source']['disk']['uuid'] or
            not re.fullmatch('[A-Za-z0-9-]{1,64}', expected_uuid) or
            record.get('uuid', expected_uuid) != expected_uuid):
        raise RuntimeError('snapshot reconciliation requires the exact planned operation and inspected UUID')
    if record['stage'] == 'planned':
        record = {**record, 'uuid': expected_uuid, 'stage': 'created'}
        validate_snapshot(snapshot_info(record['path'],identity=expected_uuid), record)
        write(work / 'snapshot.json', record)
    retire_snapshot(work)


def private_copy(work, value):
    source_identity(work, value)
    disk = value['source']['disk']
    tag = 'routercompat_' + value['operation_id']
    path = '/dev/vg0/' + tag
    if snapshot_info(path) is not None:
        raise RuntimeError('compatibility snapshot path already exists')
    record = {'operation_id': value['operation_id'], 'path': path, 'tag': tag,
              'origin_uuid': disk['uuid'], 'stage': 'planned'}
    write(work / 'snapshot.json', record)
    run(['lvcreate', '--snapshot', '--permission', 'r', '--size', '1G',
         '--name', tag, '--addtag', tag, disk['path']], timeout=120)
    row = snapshot_info(path)
    if row is None:
        raise RuntimeError('compatibility snapshot creation has no recorded result')
    record.update(uuid=row['lv_uuid'], stage='created')
    write(work / 'snapshot.json', record)
    validate_snapshot(row, record)
    try:
        if int(run(['blockdev', '--getsize64', path]).stdout.strip()) != SLOTS['old']:
            raise RuntimeError('compatibility snapshot virtual size differs from its source')
        run(['dd', 'if=' + path, 'of=' + str(work / 'old.slot'), 'bs=1M',
             'count=2048', 'conv=notrunc,fsync'], timeout=180)
        validate_snapshot(snapshot_info(path), record)
        if checksum(work / 'old.slot') != checksum(Path(path), SLOTS['old']):
            raise RuntimeError('private legacy disk copy differs from its recorded snapshot')
        source_identity(work, value)
    finally:
        retire_snapshot(work)


def configuration(work, value, phase, identity, loops):
    old, new = ('new', 'old') if phase == 'reverse' else ('old', 'new')
    if phase in ('prepare', 'forward', 'reverse'):
        disks = [f'phy:{loops[old]},xvda,{"w" if phase == "prepare" else "r"}',
                 f'phy:{loops[new]},xvdb,w', f'phy:{loops["scratch"]},xvdc,w', f'phy:{loops["copy"]},xvdd,w']
        kernel, initramfs = 'kernel', 'initramfs'
        extra = ''
    else:
        selected = 'new' if phase in ('new', 'hold-new') else 'old'
        disks = [f'phy:{loops[selected]},xvda,w']
        if phase != 'seed':
            disks.append(f'phy:{loops["previous"]},xvdf,r')
        kernel, initramfs = selected + '-kernel', selected + '-initramfs'
        extra = ' root=/dev/xvda3 rootfstype=ext4 modules=ext4 rw init=/usr/local/libexec/router-compatibility-guest'
    disks.append(f'phy:{loops["result"]},xvde,w')
    extra = ('console=hvc0 panic=1 klokast_operation=' + value['operation_id'] +
             ' klokast_inputs=' + value['inputs_sha256'] + ' klokast_phase=' + phase +
             ' klokast_job=' + digest(value['guest']) + extra)
    name = 'router-compat-' + phase + '-' + value['operation_id']
    return (f'name = {name!r}\nuuid = {identity!r}\ntype = "pvh"\nmemory = 2048\nmaxmem = 2048\nvcpus = 2\n'
            f'kernel = {str(work / kernel)!r}\nramdisk = {str(work / initramfs)!r}\nextra = {extra!r}\n'
            f'disk = {disks!r}\nvif = []\non_poweroff = "destroy"\non_reboot = "destroy"\non_crash = "destroy"\n')


def file_identity(path):
    info = path.lstat()
    return {'device': info.st_dev, 'inode': info.st_ino, 'bytes': info.st_size}


def validate_phase(record, value, phase):
    if (not isinstance(record, dict) or record.get('kind') != 'klokast.router-compatibility-phase.v2' or
            record.get('success') is not True or record.get('phase') != phase or
            record.get('operation_id') != value['operation_id'] or
            record.get('inputs_sha256') != value['inputs_sha256'] or record.get('production_identity') is not False or
            type(record.get('seconds')) not in (float, int) or not 0 <= record['seconds'] <= 420):
        raise RuntimeError('compatibility failed during ' + phase + '; inspect its bounded phase record')
    if phase in ('forward', 'reverse'):
        if (record.get('copy_complete') is not True or
                not isinstance(record.get('copy_receipt_sha256'),str) or
                not re.fullmatch('[0-9a-f]{64}',record['copy_receipt_sha256'])):
            raise RuntimeError('compatibility copy phase has no complete receipt')
    elif phase == 'prepare':
        fixtures = record.get('fixtures', {})
        if record.get('prepared') is not True or set(fixtures) != {'legacy', 'candidate', 'initial'}:
            raise RuntimeError('compatibility preparation has incomplete fixture evidence')
        for name, packages in (('legacy', value['guest']['source_packages']), ('candidate', value['guest']['runtime_packages']),
                               ('initial', value['guest']['fixture']['packages'])):
            if fixtures[name].get('production_state_removed') is not True or fixtures[name].get('packages') != packages:
                raise RuntimeError('compatibility fixture retains production state or has different packages')
        guest = value['guest']
        import hashlib
        for name, mode, packages in (('candidate', 'replacement', guest['runtime_packages']),
                                     ('initial', 'initial-install', guest['fixture']['packages'])):
            prepared = fixtures[name].get('candidate_preparation', {})
            expected = {'kind': 'klokast.router-candidate-files.v1', 'mode': mode,
                        'box': guest['fixture']['box'], 'role': 'router',
                        'operation_id': value['operation_id'], 'inputs_sha256': value['inputs_sha256'],
                        'engine_commit': guest['manifest']['engine_commit'],
                        'packages': packages, 'accounts': fixtures[name].get('accounts'),
                        'tailscale': {key: guest['manifest']['tailscale'][key] for key in (
                            'version', 'sha256', 'tailscale_sha256', 'tailscaled_sha256', 'openrc_sha256')},
                        'configuration_files': {k: hashlib.sha256(v.encode()).hexdigest()
                                                for k, v in guest['fixture']['files'].items()},
                        'identity_absent': True, 'service_syntax': True, 'replacement_authorized': False}
            if prepared != expected or not isinstance(expected['accounts'], dict) or set(expected['accounts']) != {
                    'dnsmasq_uid', 'dnsmasq_gid', 'tailscale_gid'}:
                raise RuntimeError('compatibility candidate lacks exact common preparation evidence')
    else:
        service_phase = 'new' if phase == 'hold-new' else 'old' if phase == 'hold-old' else phase
        common = {'wan_dhcp_identity', 'wan_lease', 'lan_lease', 'lan_dns'}
        expected = common | ({'expiry_lease_created'} if service_phase == 'seed' else {
            'dhcp_identity_continuity', 'copied_timestamps', 'generation_identity_preserved',
            'fresh_wan_negotiation'})
        if service_phase == 'new' and phase != 'hold-new':
            expected |= {'expired_lease_removed', 'old_client_renewed'}
        if (record.get('tests') != dict.fromkeys(expected, True) or
                record.get('enrollment_tested') is not False or
                record.get('packages') != value['guest']['runtime_packages' if service_phase == 'new' else 'source_packages'] or
                not isinstance(record.get('state'), dict) or set(record['state']) != {
                    'files', 'generation_identity', 'lan_leases'}):
            raise RuntimeError('compatibility native phase has incomplete service or state evidence')


def cleanup(work, operation, box):
    record = load(work / 'lifecycle.json')
    names = [name for name in SLOTS if name != 'new']
    if (set(record) != {'operation_id','stage','uuids','slots'} or record.get('operation_id') != operation or
            record.get('stage') not in ('allocating','allocated','detached','cleaned') or
            not isinstance(record.get('uuids'),dict) or set(record['uuids']) != set(PHASES + HOLD_PHASES) or
            not isinstance(record.get('slots'),dict) or set(record['slots']) - set(names)):
        raise RuntimeError('compatibility cleanup needs its exact allocation ledger')
    for phase, identity in record['uuids'].items():
        if str(uuid.UUID(identity)) != identity or domain('router-compat-' + phase + '-' + operation) is not None:
            raise RuntimeError('compatibility domain remains; retain private disks')
    value = request(work,box,operation,verify_boot=False)
    source_identity(work,value)
    # The operation lock excludes the producer. UUID checks also catch a
    # renamed helper; checking its conventional name alone is insufficient.
    for guest in router_native.Native().inventory(deadline=time.monotonic()+30):
        if guest['domid'] and guest['config']['c_info']['uuid'] in record['uuids'].values():
            raise RuntimeError('compatibility helper UUID remains; retain private disks')
    if {path.name for path in work.glob('*.slot')} - {name+'.slot' for name in names}:
        raise RuntimeError('compatibility cleanup found an unrecorded slot')
    if any(loop_devices(work/(name+'.slot')) for name in names):
        raise RuntimeError('compatibility slot still has a loop attachment; retain its cleanup barrier')

    def identity(item, maximum):
        if (not isinstance(item,dict) or set(item) != {'device','inode','bytes'} or
                any(type(item[key]) is not int for key in item) or item['device']<0 or item['inode']<=0 or
                not 0<=item['bytes']<=maximum):
            raise RuntimeError('compatibility slot identity is invalid')
    def observed_file(path, maximum):
        info=path.lstat()
        if (not stat.S_ISREG(info.st_mode) or info.st_uid!=os.geteuid() or info.st_nlink!=1 or info.st_mode&0o077 or
                not 0<=info.st_size<=maximum or loop_devices(path)):
            raise RuntimeError('compatibility disk changed or remains attached; retain it')
        return file_identity(path)
    plan_path=work/'cleanup-plan.json'
    if plan_path.exists() or plan_path.is_symlink():
        plan=load(plan_path)
        if (set(plan) != {'kind','box','operation_id','lifecycle','files'} or
                plan['kind']!='klokast.router-compatibility-cleanup-plan.v1' or
                plan['box']!=box or plan['operation_id']!=operation or
                (plan['lifecycle']!=record and {**plan['lifecycle'],'stage':'cleaned'}!=record) or
                not isinstance(plan['files'],list)):
            raise RuntimeError('compatibility cleanup plan changed')
        selected=[]
        for item in plan['files']:
            if not isinstance(item,dict) or set(item)!={'name','identity'} or item['name'] not in names:
                raise RuntimeError('compatibility cleanup plan has an unknown slot')
            identity(item['identity'],SLOTS[item['name']]); selected.append(item['name'])
        if selected != [name for name in names if name in selected] or len(selected)!=len(set(selected)):
            raise RuntimeError('compatibility cleanup plan repeats or reorders slots')
    else:
        files=[]
        historical_cleaned=record['stage']=='cleaned'
        if historical_cleaned:
            if (load(work/'snapshot.json').get('stage')!='retired' or
                    router_candidate_disk.record(work,operation)['stage']!='retired'):
                raise RuntimeError('historical compatibility cleanup lacks both exact retired allocation records')
        for name in names:
            path=work/(name+'.slot'); intent_path=work/('slot-'+name+'.json')
            declared=record['slots'].get(name)
            intent=load(intent_path) if intent_path.exists() or intent_path.is_symlink() else None
            if intent is not None:
                if (set(intent)!={'kind','operation_id','slot','maximum','stage','identity'} or
                        intent['kind']!='klokast.router-compatibility-slot.v1' or
                        intent['operation_id']!=operation or intent['slot']!=name or intent['maximum']!=SLOTS[name] or
                        intent['stage'] not in ('planned','allocating','allocated') or
                        (intent['stage']=='planned') != (intent['identity'] is None)):
                    raise RuntimeError('compatibility slot allocation intent changed')
                if intent['identity'] is not None:
                    identity(intent['identity'],SLOTS[name])
            if declared is not None:
                identity(declared,SLOTS[name])
            if historical_cleaned and (path.exists() or path.is_symlink()):
                raise RuntimeError('historical compatibility slot reappeared after recorded cleanup')
            if not path.exists() and not path.is_symlink():
                if not historical_cleaned and (declared is not None or intent is not None and intent['stage']!='planned'):
                    raise RuntimeError('compatibility slot disappeared without removal intent')
                continue
            if declared is None and intent is None:
                raise RuntimeError('compatibility slot has no recorded allocation intent')
            actual=observed_file(path,SLOTS[name])
            if (declared is not None and actual!=declared or
                    intent is not None and intent['identity'] is not None and
                    (any(actual[key]!=intent['identity'][key] for key in ('device','inode')) or
                     intent['stage']=='allocated' and actual!=intent['identity'])):
                raise RuntimeError('compatibility slot differs from its recorded allocation')
            files.append({'name':name,'identity':actual})
        plan={'kind':'klokast.router-compatibility-cleanup-plan.v1','box':box,
              'operation_id':operation,'lifecycle':record,'files':files}
        write(plan_path,plan)

    progress_path=work/'cleanup-progress.json'
    progress=load(progress_path) if progress_path.exists() or progress_path.is_symlink() else {
        'kind':'klokast.router-compatibility-cleanup-progress.v1','plan_sha256':digest(plan),
        'phase':'planned','removed':[],'inflight':None,'bytes_reclaimed':0}
    selected=[item['name'] for item in plan['files']]
    if any((work/(name+'.slot')).exists() or (work/(name+'.slot')).is_symlink()
           for name in names if name not in selected):
        raise RuntimeError('compatibility slot appeared outside its cleanup plan')
    if (set(progress)!={'kind','plan_sha256','phase','removed','inflight','bytes_reclaimed'} or
            progress['kind']!='klokast.router-compatibility-cleanup-progress.v1' or
            progress['plan_sha256']!=digest(plan) or
            progress['phase'] not in ('planned','disk-retired','files-retiring','complete') or
            not isinstance(progress['removed'],list) or progress['removed']!=selected[:len(progress['removed'])] or
            len(progress['removed'])>len(selected) or type(progress['bytes_reclaimed']) is not int or
            progress['bytes_reclaimed']<0 or
            progress['inflight'] is not None and (len(progress['removed'])==len(selected) or
                progress['inflight']!=selected[len(progress['removed'])]) or
            progress['phase']=='complete' and (progress['removed']!=selected or progress['inflight'] is not None) or
            progress['phase'] in ('planned','disk-retired') and (progress['removed'] or progress['inflight'] is not None)):
        raise RuntimeError('compatibility cleanup progress changed')
    # Validate every surviving file before any LV or file mutation.
    for item in plan['files']:
        path=work/(item['name']+'.slot'); present=path.exists() or path.is_symlink()
        if item['name'] in progress['removed']:
            if present:
                raise RuntimeError('compatibility slot reappeared after retirement')
        elif not present:
            if progress['inflight']!=item['name']:
                raise RuntimeError('compatibility slot disappeared without removal intent')
        elif observed_file(path,SLOTS[item['name']])!=item['identity']:
            raise RuntimeError('compatibility slot changed after cleanup planning')
    write(progress_path,progress)
    snapshot_path='/dev/vg0/routercompat_'+operation
    snapshot_record=work/'snapshot.json'
    if snapshot_record.exists() or snapshot_record.is_symlink():
        snapshot=load(snapshot_record)
        if snapshot.get('stage')=='planned':
            row=snapshot_info(snapshot_path)
            if row is None:
                if (set(snapshot)!={'operation_id','path','tag','origin_uuid','stage'} or
                        snapshot['operation_id']!=operation or snapshot['path']!=snapshot_path or
                        snapshot['tag']!='routercompat_'+operation or snapshot['origin_uuid']!=value['source']['disk']['uuid']):
                    raise RuntimeError('compatibility absent snapshot has another allocation intent')
                write(snapshot_record,{**snapshot,'stage':'aborted'})
            else:
                reconcile_snapshot(work,value,row['lv_uuid'])
        elif snapshot.get('stage')=='aborted':
            if (set(snapshot)!={'operation_id','path','tag','origin_uuid','stage'} or
                    snapshot['operation_id']!=operation or snapshot['path']!=snapshot_path or
                    snapshot['tag']!='routercompat_'+operation or snapshot['origin_uuid']!=value['source']['disk']['uuid'] or
                    snapshot_info(snapshot_path) is not None):
                raise RuntimeError('compatibility aborted snapshot changed or reappeared')
        else:
            retire_snapshot(work)
    elif snapshot_info(snapshot_path) is not None:
        raise RuntimeError('compatibility snapshot has no allocation record')
    candidate_path=work/'candidate-disk.json'
    if candidate_path.exists() or candidate_path.is_symlink():
        allocation=router_candidate_disk.record(work,operation)
        row=router_candidate_disk.observed(operation,identity=allocation['uuid'])
        reclaimed=router_candidate_disk.retire(work,operation,box=box,
            inspected_uuid=row['lv_uuid'] if row is not None and allocation['stage']=='planned' else None)
    else:
        if router_candidate_disk.observed(operation) is not None:
            raise RuntimeError('compatibility candidate LV has no allocation record')
        router_candidate_disk.refuse_referenced_disk(box,operation,{
            'path':router_candidate_disk.selection(operation)[0],'uuid':None})
        reclaimed=0
    if progress['phase']=='planned':
        progress.update(phase='disk-retired',bytes_reclaimed=reclaimed)
        write(progress_path,progress)
    for item in plan['files']:
        name=item['name']; path=work/(name+'.slot')
        if name in progress['removed']:
            continue
        if not path.exists() and not path.is_symlink() and progress['inflight']!=name:
            raise RuntimeError('compatibility slot disappeared without removal intent')
        if path.exists() or path.is_symlink():
            if observed_file(path,SLOTS[name])!=item['identity']:
                raise RuntimeError('compatibility slot changed before removal')
            progress.update(phase='files-retiring',inflight=name)
            write(progress_path,progress)
            path.unlink()
            descriptor=os.open(work,os.O_RDONLY|os.O_DIRECTORY|os.O_NOFOLLOW)
            try:
                os.fsync(descriptor)
            finally:
                os.close(descriptor)
        progress['removed'].append(name)
        progress.update(phase='files-retiring',inflight=None,
                        bytes_reclaimed=progress['bytes_reclaimed']+item['identity']['bytes'])
        write(progress_path,progress)
    progress['phase']='complete'; write(progress_path,progress)
    source_identity(work,value)
    write(work/'lifecycle.json',{**record,'stage':'cleaned'})
    result={'kind':'klokast.router-compatibility-cleanup.v1','box':box,'operation_id':operation,
            'engine_commit':value['engine_commit'],'source_sha256':digest(value['source']),
            'plan_sha256':digest(plan),'progress_sha256':digest(progress),
            'bytes_reclaimed':progress['bytes_reclaimed'],'status':'unused-disks-retired'}
    result_path=work/'cleanup-complete.json'
    if result_path.exists() or result_path.is_symlink():
        if load(result_path)!=result:
            raise RuntimeError('compatibility cleanup completion changed')
    else:
        write(result_path,result)
    retired=boot_artifacts.retire(work,value,TEMPLATES/value['template']['operation'],
        authorize=lambda: source_identity(work,value))
    complete={'kind':'klokast.router-compatibility-cleanup.v2','box':box,'operation_id':operation,
        'engine_commit':value['engine_commit'],'source_sha256':digest(value['source']),
        'disk_cleanup_sha256':digest(result),'artifact_cleanup_sha256':digest(retired),
        'bytes_reclaimed':result['bytes_reclaimed']+retired['bytes_reclaimed'],'status':'unused-resources-retired'}
    complete_path=work/'cleanup-complete.v2.json'
    if complete_path.exists() or complete_path.is_symlink():
        if load(complete_path)!=complete:
            raise RuntimeError('compatibility complete resource cleanup changed')
    else:
        write(complete_path,complete)
    return complete['bytes_reclaimed']


def allocate_slot(work, name, lifecycle):
    """Record creation and inode before allocation; keep incomplete bytes fenced."""
    if name not in SLOTS or name=='new' or name in lifecycle['slots']:
        raise RuntimeError('compatibility slot allocation is not fresh')
    path=work/(name+'.slot'); target=work/('slot-'+name+'.json')
    if path.exists() or path.is_symlink() or target.exists() or target.is_symlink():
        raise RuntimeError('compatibility slot allocation already exists')
    intent={'kind':'klokast.router-compatibility-slot.v1','operation_id':lifecycle['operation_id'],
            'slot':name,'maximum':SLOTS[name],'stage':'planned','identity':None}
    write(target,intent)
    with path.open('xb') as stream:
        write(target,{**intent,'stage':'allocating','identity':file_identity(path)})
        os.posix_fallocate(stream.fileno(),0,SLOTS[name]); os.fsync(stream.fileno())
    complete=file_identity(path)
    write(target,{**intent,'stage':'allocated','identity':complete})
    lifecycle['slots'][name]=complete
    write(work/'lifecycle.json',lifecycle)


def clone_candidate_then_allocate_result(work, operation, template, candidate, box, lifecycle):
    """Keep the result slot absent until the clone guard has checked the new LV."""
    result = work / 'result.slot'
    if result.exists() or result.is_symlink() or 'result' in lifecycle['slots']:
        raise RuntimeError('compatibility result slot exists before candidate cloning')
    disk = router_candidate_disk.create(work, operation, template / 'os.slot',
                                        candidate['artifacts']['os'], box=box)
    allocate_slot(work,'result',lifecycle)
    return disk


class IsolatedRollback:
    """Exercise the transaction order with real, networkless Xen test disks.

    This adapter has no production enrollment, accepted-pointer, or Xen
    configuration authority. The live router remains outside its guest names,
    UUIDs, disks, and network attachments.
    """
    monotonic = staticmethod(time.monotonic)

    def __init__(self, work, value, disk, identities, phases):
        self.work, self.value, self.disk = work, value, disk
        self.identities, self.phases = identities, phases
        self.running, self.attaching, self.loops, self.events = None, None, {}, []
        self.request = {'kind': 'klokast.router-transaction-request.v1',
            'role': 'router', 'box': value['box'], 'operation_id': value['operation_id'],
            'engine_commit': value['engine_commit'], 'policy_sha256': '0' * 64,
            'accepted_sha256': '1' * 64, 'old_sha256': '2' * 64,
            'candidate_sha256': '3' * 64, 'cutover_seconds': 720,
            'recovery_seconds': 720}
        router_transaction.validate(self.request)

    def guest_name(self, phase):
        return 'router-compat-' + phase + '-' + self.value['operation_id']

    def verify_prepared(self, request):
        if request != self.request or self.running != 'old':
            raise RuntimeError('isolated rollback lacks its exact running A fixture')
        source_identity(self.work, self.value)
        router_candidate_disk.verify(self.work, self.value['operation_id'])
        if domain('router') is None:
            raise RuntimeError('isolated rollback cannot prove the production router remains online')

    def persist(self, pending):
        write(self.work / 'ab-pending.json', pending)
        self.events.append(pending['phase'])

    def arm(self, *, deadline):
        self.verify_prepared(self.request)

    def boot(self, side, previous, *, deadline):
        if self.running is not None or self.loops:
            raise RuntimeError('isolated A/B boot would overlap another test guest')
        phase = 'hold-old' if side == 'old' else 'hold-new'
        if phase not in self.identities or previous.get('success') is not True:
            raise RuntimeError('isolated A/B boot lacks exact prior state evidence')
        self.attaching = side
        with (self.work / 'result.slot').open('r+b') as stream:
            stream.write(b'\0' * MIB); stream.flush(); os.fsync(stream.fileno())
        with (self.work / 'previous.slot').open('r+b') as stream:
            stream.write(json.dumps(previous, sort_keys=True).encode() + b'\0')
            stream.flush(); os.fsync(stream.fileno())
        paths = {'result': self.work / 'result.slot', 'previous': self.work / 'previous.slot'}
        if side == 'old':
            paths['old'] = self.work / 'old.slot'
        for name, path in paths.items():
            self.loops[name] = attach_loop(path, readonly=name == 'previous')
        if side == 'candidate':
            router_candidate_disk.verify(self.work, self.value['operation_id'])
            self.loops['new'] = self.disk['path']
        config = self.work / (phase + '.cfg')
        config.write_text(configuration(self.work, self.value, phase,
                                        self.identities[phase], self.loops))
        name = self.guest_name(phase)
        run(['xl', 'create', '-p', config], timeout=60)
        current = domain(name)
        if current is None:
            raise RuntimeError('isolated A/B guest did not start paused')
        require_identity(current, self.identities[phase])
        # Alpine's xl accepts the numeric domain ID here, not a UUID. Bind the
        # ID to the exact UUID from the complete Xen inventory first.
        run(['xl', 'unpause', str(current['domid'])], timeout=30)
        self.running = side
        self.attaching = None
        until = min(deadline, self.monotonic() + 180)
        while self.monotonic() < until:
            if completion_ready(self.work, self.value, kind='klokast.router-compatibility-phase.v2'):
                record = read_slot(self.work / 'result.slot')
                if record.get('phase') == phase and record.get('operation_id') == self.value['operation_id']:
                    write(self.work / (phase + '.json'), record)
                    validate_phase(record, self.value, phase)
                    current = domain(name)
                    if current is None:
                        raise RuntimeError('isolated A/B guest stopped after service evidence')
                    require_identity(current, self.identities[phase])
                    self.phases[phase] = record
                    return
            current = domain(name)
            if current is None:
                raise RuntimeError('isolated A/B guest stopped before service evidence')
            require_identity(current, self.identities[phase])
            time.sleep(1)
        raise RuntimeError('isolated A/B guest did not report services before its fixed deadline')

    def stop(self, side, *, deadline):
        phase = 'hold-old' if side == 'old' else 'hold-new'
        name = self.guest_name(phase)
        current = domain(name)
        if current is None and self.running != side and self.attaching != side:
            return
        if self.running not in (None, side):
            raise RuntimeError('isolated A/B fencing selected the wrong running guest')
        if current is not None:
            require_identity(current, self.identities[phase])
            run(['xl', 'destroy', str(current['domid'])], timeout=30)
            if domain(name) is not None:
                raise RuntimeError('isolated A/B guest remains after fencing')
        if self.running == side:
            self.running = None
        if self.attaching == side:
            self.attaching = None
        if self.loops:
            router_native.Native().wait_detached(list(self.loops.values()),
                                                 deadline=min(deadline, self.monotonic() + 30))
        for label, device in list(self.loops.items()):
            if label != 'new':
                detach_loop(self.work / (label + '.slot'), device)
            del self.loops[label]
        if side == 'candidate':
            router_candidate_disk.verify(self.work, self.value['operation_id'])
        self.events.append('stopped-' + side)

    def copy(self, source, target, *, deadline):
        if self.running is not None or self.loops or (source, target) not in (
                ('old', 'candidate'), ('candidate', 'old')):
            raise RuntimeError('isolated state copy needs two stopped test guests')
        phase = 'forward' if source == 'old' else 'reverse'
        selected = 'old' if source == 'old' else 'new'
        source_path = self.work / 'old.slot' if selected == 'old' else Path(self.disk['path'])
        unchanged = checksum(source_path, SLOTS[selected])
        with (self.work / 'result.slot').open('r+b') as stream:
            stream.write(b'\0' * MIB); stream.flush(); os.fsync(stream.fileno())
        loops = {}
        try:
            for name in SLOTS:
                if name == 'new':
                    router_candidate_disk.verify(self.work, self.value['operation_id'])
                    loops[name] = self.disk['path']
                elif name != 'previous':
                    loops[name] = attach_loop(self.work / (name + '.slot'),
                        readonly=name == selected)
            config = self.work / (phase + '.cfg')
            config.write_text(configuration(self.work, self.value, phase,
                                            self.identities[phase], loops))
            boot_guest(self.work, self.guest_name(phase), self.identities[phase],
                       config, self.value, kind='klokast.router-compatibility-phase.v2',
                       timeout=min(420, max(1, int(deadline - self.monotonic()))))
            record = read_slot(self.work / 'result.slot')
            write(self.work / ('ab-' + phase + '.json'), record)
            validate_phase(record, self.value, phase)
            self.phases[phase] = record
        finally:
            for name, device in loops.items():
                if name != 'new':
                    detach_loop(self.work / (name + '.slot'), device)
        if checksum(source_path, SLOTS[selected]) != unchanged:
            raise RuntimeError('isolated copy changed its read-only source')
        self.events.append('copied-' + phase)

    def verify_copy(self, source, target, *, deadline):
        phase = 'forward' if source == 'old' and target == 'candidate' else 'reverse'
        validate_phase(self.phases[phase], self.value, phase)

    def start(self, side, *, deadline):
        previous = self.phases['hold-old' if side == 'candidate' else
                               'hold-new' if 'hold-new' in self.phases else 'old']
        self.boot(side, previous, deadline=deadline)
        self.events.append('started-' + side)

    def check_local(self, side, *, deadline):
        phase = 'hold-old' if side == 'old' else 'hold-new'
        if self.running != side or domain(self.guest_name(phase)) is None:
            raise RuntimeError('isolated A/B service guest is no longer running')
        validate_phase(self.phases[phase], self.value, phase)

    def wait_enrollment(self, *, deadline):
        # No controller sideband is sent to this independent dom0 test process.
        self.events.append('controller-signal-absent')
        return False

    def verify_recovery(self, request, *, deadline):
        if request != self.request:
            raise RuntimeError('isolated recovery request changed')
        source_identity(self.work, self.value)

    def committed(self, *, deadline):
        return False

    def disarm(self, side, *, deadline):
        if side != 'old' or self.running != 'old':
            raise RuntimeError('isolated rollback selected a different guest')
        self.events.append('selected-old')

    def finish(self, outcome):
        required = ('stopped-old', 'copied-forward', 'started-candidate',
                    'controller-signal-absent', 'stopped-candidate',
                    'copied-reverse', 'started-old')
        if (outcome != 'rolled-back' or self.running != 'old' or
                any(self.events.count(item) != 1 for item in required) or
                [self.events.index(item) for item in required] != sorted(
                    self.events.index(item) for item in required) or
                domain(self.guest_name('hold-old')) is None or
                domain(self.guest_name('hold-new')) is not None or
                domain('router') is None):
            raise RuntimeError('isolated A/B rollback did not keep its required Xen and copy order')
        source_identity(self.work, self.value)
        router_candidate_disk.verify(self.work, self.value['operation_id'])
        write(self.work / 'ab-result.json', {'kind': 'klokast.router-isolated-ab-rollback.v1',
            'operation_id': self.value['operation_id'], 'outcome': outcome,
            'events': self.events, 'production_identity': False,
            'controller_acceptance': False, 'old_boot_verified': True,
            'candidate_boot_verified': True, 'latest_state_reversed': True,
            'production_router_unchanged': True})

    def fence_all(self, *, deadline):
        for side in ('candidate', 'old'):
            self.stop(side, deadline=deadline)


def isolated_rollback(work, value, disk, identities, phases):
    adapter = IsolatedRollback(work, value, disk, identities, phases)
    try:
        adapter.boot('old', phases['old'], deadline=adapter.monotonic() + 240)
        outcome = router_transaction.Transaction(adapter.request, adapter).cutover()
        if (outcome != 'rolled-back' or adapter.running != 'old' or
                'controller-signal-absent' not in adapter.events or
                'copied-reverse' not in adapter.events or
                domain('router') is None):
            raise RuntimeError('isolated A/B test did not restore the old guest after the absent controller signal')
        return load(work / 'ab-result.json')
    finally:
        adapter.fence_all(deadline=adapter.monotonic() + 120)


def execute(work, value):
    operation = value['operation_id']
    if (work / 'lifecycle.json').exists() or (work / 'snapshot.json').exists():
        raise RuntimeError('compatibility operation already exists')
    if any(domain('router-compat-' + phase + '-' + operation) is not None for phase in PHASES + HOLD_PHASES):
        raise RuntimeError('compatibility domain already exists')
    capacity = os.statvfs(work)
    memory = re.search(r'^free_memory\s*:\s*(\d+)\s*$', run(['xl', 'info']).stdout, re.M)
    if capacity.f_bavail * capacity.f_frsize < sum(SLOTS.values()) + 256 * MIB or not memory or int(memory[1]) < 2304:
        raise RuntimeError('compatibility needs seven GiB storage and 2304 MiB free Xen memory')
    # LVM refuses allocation if the explicit one GiB COW reserve is unavailable.
    source_identity(work, value)
    template = TEMPLATES / value['template']['operation']
    safe_directory(TEMPLATES); safe_directory(template)
    candidate = load(template / 'candidate.json')
    if (checksum(template / 'candidate.json') != value['template']['sha256'] or
            candidate.get('kind') != 'klokast.router-template-candidate.v1' or candidate.get('box') != value['box'] or
            candidate.get('operation_id') != value['template']['operation'] or
            candidate.get('inputs_sha256') != value['inputs_sha256'] or
            candidate['personalization_test']['finalization']['packages'] != value['guest']['runtime_packages'] or
            candidate['kernel_release'] != value['guest']['kernel_release']):
        raise RuntimeError('compatibility template evidence differs from selected test inputs')
    for name, maximum in (('os', SLOTS['new']), ('kernel', 32 * MIB), ('initramfs', 128 * MIB)):
        source = template / ('os.slot' if name == 'os' else name)
        artifact(source, candidate['artifacts'][name], maximum)
    identities = {phase: str(uuid.uuid4()) for phase in PHASES + HOLD_PHASES}
    lifecycle = {'operation_id': operation, 'uuids': identities, 'stage': 'allocating', 'slots': {}}
    write(work / 'lifecycle.json', lifecycle)
    for name, size in SLOTS.items():
        if name in ('new', 'result'):
            continue
        allocate_slot(work,name,lifecycle)
    lifecycle['stage'] = 'allocated'
    write(work / 'lifecycle.json', lifecycle)
    candidate_disk = clone_candidate_then_allocate_result(
        work, operation, template, candidate, value['box'], lifecycle)
    private_copy(work, value)
    expected_boot=boot_artifacts.wanted(value,template)
    for label, original in (('old-kernel', value['source']['boot_artifacts']['kernel']['path']),
                            ('old-initramfs', value['source']['boot_artifacts']['ramdisk']['path']),
                            ('new-kernel', template / 'kernel'), ('new-initramfs', template / 'initramfs')):
        boot_artifacts.stage(work,label,original,expected_boot[label])
    with (template/'os.slot').open('rb') as source, (work/'scratch.slot').open('r+b') as target:
        shutil.copyfileobj(source,target); target.flush(); os.fsync(target.fileno())
    for label, field in (('old-kernel', 'kernel'), ('old-initramfs', 'ramdisk')):
        if checksum(work / label) != value['source']['boot_artifacts'][field]['sha256']:
            raise RuntimeError('legacy boot artifact changed while staging')
    for name in ('scratch',):
        artifact(work / (name + '.slot'), candidate['artifacts']['os'], SLOTS[name])
    loops, records = {}, {}
    try:
        for phase in PHASES:
            source = 'new' if phase == 'reverse' else 'old'
            source_path = Path(candidate_disk['path']) if source == 'new' else work / 'old.slot'
            unchanged = checksum(source_path, SLOTS[source]) if phase in ('forward', 'reverse') else None
            with (work / 'result.slot').open('r+b') as stream:
                stream.write(b'\0' * MIB); stream.flush(); os.fsync(stream.fileno())
            if phase in ('new', 'old'):
                previous = records['seed' if phase == 'new' else 'new']
                with (work / 'previous.slot').open('r+b') as stream:
                    stream.write(json.dumps(previous, sort_keys=True).encode() + b'\0')
                    stream.flush(); os.fsync(stream.fileno())
            selected = list(SLOTS) if phase in ('prepare', 'forward', 'reverse') else [
                'new' if phase == 'new' else 'old', 'result', *(['previous'] if phase != 'seed' else [])]
            for name in selected:
                if name == 'new':
                    router_candidate_disk.verify(work, operation)
                    loops[name] = candidate_disk['path']
                    continue
                loops[name] = attach_loop(work / (name + '.slot'), readonly=name == 'previous' or
                                         (name == source and phase in ('forward', 'reverse')))
            config = work / (phase + '.cfg')
            config.write_text(configuration(work, value, phase, identities[phase], loops))
            boot_guest(work, 'router-compat-' + phase + '-' + operation, identities[phase], config, value,
                       kind='klokast.router-compatibility-phase.v2', timeout=420)
            record = read_slot(work / 'result.slot')
            write(work / (phase + '.json'), record)
            validate_phase(record, value, phase)
            for name, device in list(loops.items()):
                if name == 'new':
                    router_candidate_disk.verify(work, operation)
                else:
                    detach_loop(work / (name + '.slot'), device)
                del loops[name]
            if unchanged is not None and checksum(source_path, SLOTS[source]) != unchanged:
                raise RuntimeError('compatibility copy changed its read-only source')
            records[phase] = record
        rollback = isolated_rollback(work, value, candidate_disk, identities, records)
        source_identity(work, value)
        result = {'kind': 'klokast.router-compatibility-result.v2', 'box': value['box'], 'role': 'router',
                  'operation_id': operation, 'inputs_sha256': value['inputs_sha256'], 'engine_commit': value['engine_commit'],
                  'template_operation': value['template']['operation'], 'source': value['source'],
                  'source_packages': value['guest']['source_packages'], 'runtime_packages': value['guest']['runtime_packages'],
                  'phases': list(records), 'phase_seconds': {k: v['seconds'] for k, v in records.items()},
                  'success': True, 'production_identity': False, 'enrollment_tested': False,
                  'candidate_modes': ['initial-install', 'replacement'], 'candidate_disk': candidate_disk,
                  'replacement_authorized': False, 'ab_rollback': rollback}
        write(work / 'result.json', result)
    finally:
        if any(domain('router-compat-' + phase + '-' + operation) is not None for phase in PHASES + HOLD_PHASES):
            raise RuntimeError('compatibility guest remains; retain private disks and attachments')
        for name, device in loops.items():
            if name == 'new':
                router_candidate_disk.verify(work, operation)
            else:
                detach_loop(work / (name + '.slot'), device)
        write(work / 'lifecycle.json', {**lifecycle, 'stage': 'detached'})
    cleanup(work, operation, value['box'])
    return result


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument('--box', required=True)
    parser.add_argument('--operation-id', required=True)
    parser.add_argument('--cleanup', action='store_true')
    parser.add_argument('--retire-historical-artifacts', action='store_true')
    parser.add_argument('--reconcile-historical-absence', action='store_true')
    parser.add_argument('--retire-snapshot-uuid')
    parser.add_argument('--retire-candidate-uuid')
    args = parser.parse_args()
    if sum(bool(item) for item in (args.cleanup, args.retire_historical_artifacts, args.reconcile_historical_absence,
            args.retire_snapshot_uuid, args.retire_candidate_uuid)) > 1:
        raise RuntimeError('compatibility requires one exact action')
    if (os.geteuid() != 0 or not re.fullmatch('[a-z0-9][a-z0-9-]{0,30}', args.box) or
            not re.fullmatch('[0-9a-f]{24}', args.operation_id) or
            socket.gethostname().split('.')[0] != args.box + '-dom0' or
            Path('/sys/hypervisor/uuid').read_text().strip() != '00000000-0000-0000-0000-000000000000'):
        raise RuntimeError('compatibility requires root on the exact dom0')
    os.umask(0o077)
    run(['mountpoint', '-q', '/mnt/dom0_data'])
    work = BASE / args.operation_id
    safe_directory(BASE); safe_directory(work)
    with (BASE / 'test.lock').open('a') as lock:
        fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
        if args.retire_historical_artifacts or args.reconcile_historical_absence:
            print(json.dumps(retire_historical_artifacts(work,args.operation_id,args.box,
                absent_only=args.reconcile_historical_absence),sort_keys=True))
        elif args.retire_snapshot_uuid:
            reconcile_snapshot(work, request(work, args.box, args.operation_id), args.retire_snapshot_uuid)
            print(json.dumps({'snapshot_retired': True}))
        elif args.retire_candidate_uuid:
            print(json.dumps({'bytes_reclaimed': router_candidate_disk.retire(
                work, args.operation_id, box=args.box, inspected_uuid=args.retire_candidate_uuid)}))
        elif args.cleanup:
            cleanup(work,args.operation_id,args.box)
            print(json.dumps(load(work/'cleanup-complete.v2.json'),sort_keys=True))
        else:
            print(json.dumps(execute(work, request(work, args.box, args.operation_id))))


if __name__ == '__main__':
    try:
        main()
    except Exception as error:
        raise SystemExit('router-compatibility-dom0: ' + str(error))
