#!/bin/sh
set -eu
export PATH=/usr/sbin:/usr/bin:/sbin:/bin
. /etc/exit-appliance.conf
if ! awk '$2 == "/" && $4 ~ /(^|,)ro(,|$)/ { found=1 } END { exit !found }' /proc/mounts; then
    echo 'Exit appliance refused startup: the OS root must be read-only.' >/dev/console
    exit 1
fi
echo 'Exit appliance: read-only OS root verified; maintenance access disabled.' >/dev/console
# A missing identity partition must never cause enrollment on the root disk.
awk '$2 == "/var/lib/tailscale" && $1 == "/dev/xvda2" { found=1 } END { exit !found }' /proc/mounts
umount /var/lib/tailscale
mount -t tmpfs -o size=64m,nosuid,nodev,noexec tmpfs /var
# /var was replaced above. Reattach only this appliance's disposable identity.
mkdir -p /var/lib/tailscale
mount -o nosuid,nodev,noexec /dev/xvda2 /var/lib/tailscale
ln -s /run /var/run
# Load the filter before the kernel forwards any packet.
nft -f /etc/nftables.nft
echo 1 > /proc/sys/net/ipv4/ip_forward
ifup eth0
/usr/sbin/tailscaled --port=41641 --state=/var/lib/tailscale/tailscaled.state >/dev/console 2>&1 &
for attempt in $(seq 1 30); do
    [ -S /var/run/tailscale/tailscaled.sock ] && break
    sleep 1
done
if [ -s /var/lib/tailscale/authkey ]; then
    if ! tailscale up --auth-key=file:/var/lib/tailscale/authkey --hostname="$EXIT_HOSTNAME" \
        --advertise-tags=tag:exit --advertise-exit-node --ssh=false --accept-dns=false \
        --accept-routes=false --netfilter-mode=off --timeout=60s >/dev/null 2>&1; then
        echo 'Exit enrollment failed. Rebuild the appliance after checking network and identity policy.' >/dev/console
        exit 1
    fi
    rm -f /var/lib/tailscale/authkey
else
    tailscale set --ssh=false --accept-dns=false --accept-routes=false --advertise-exit-node >/dev/null 2>&1
fi
echo 'Exit appliance ready: web exit for granted Tailnet members; remote administration disabled.' >/dev/console
