set timeout=3
set default=0

menuentry "Alpine Linux (RAM Mode)" {
    linux /boot/vmlinuz-lts modules=loop,squashfs,sd-mod,usb-storage,nvme quiet {{ diskless_modloop_kernel_param | trim }} alpine_dev=LABEL={{ efi_partition_label }}{{ (' ' ~ (diskless_apkovl_kernel_param | trim)) if (diskless_apkovl_kernel_param | default('') | trim) else '' }}
    initrd /boot/initramfs-lts
}
