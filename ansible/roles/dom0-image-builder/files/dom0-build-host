#!/usr/bin/env python3
"""Run a public diskless bundle build without mounting a guest filesystem."""
import argparse
import fcntl
import json
import os
from pathlib import Path
import re
import socket
import uuid

from xen_build_runtime import (attach_loop, boot_guest, checksum, detach_loop, domain,
                               read_slot, run, safe_directory, safe_file, write)

BASE = Path('/mnt/dom0_data/klokast-dom0-builds')
MIB = 1024**2
SLOTS = {'scratch': 8192 * MIB, 'bundle': 2048 * MIB, 'result': MIB}


def validate(work, box, operation):
    safe_file(work / 'request.json', MIB)
    request = json.loads((work / 'request.json').read_text())
    if (set(request) != {'kind', 'box', 'operation_id', 'inputs_sha256', 'capsule', 'bootstrap'} or
            request['kind'] != 'klokast.dom0-build-request.v1' or
            request['box'] != box or request['operation_id'] != operation or
            not re.fullmatch('[0-9a-f]{64}', request['inputs_sha256'])):
        raise RuntimeError('invalid dom0 build request')
    for name, record, maximum in (
            ('capsule.tar', request['capsule'], 2049 * MIB),
            ('bootstrap-kernel', request['bootstrap']['kernel'], 32 * MIB),
            ('bootstrap-initramfs', request['bootstrap']['initramfs'], 1024 * MIB)):
        safe_file(work / name, maximum)
        if (set(record) != {'bytes', 'sha256'} or type(record['bytes']) is not int or
                (work / name).stat().st_size != record['bytes'] or checksum(work / name) != record['sha256']):
            raise RuntimeError('dom0 build input bytes differ')
    return request


def execute(work, request):
    name = 'dom0-build-' + request['operation_id']
    identity = str(uuid.uuid4())
    if domain(name) is not None:
        raise RuntimeError('dom0 builder domain already exists')
    info = dict(line.split(':', 1) for line in run(['xl', 'info']).stdout.splitlines() if ':' in line)
    free = {k.strip(): v.strip() for k, v in info.items()}
    if int(free.get('free_memory', '0')) < 3072:
        raise RuntimeError('dom0 preparation needs 2048 MiB Xen memory plus 1024 MiB reserve')
    capacity = os.statvfs(work)
    if capacity.f_bavail * capacity.f_frsize < sum(SLOTS.values()) + 1024 * MIB:
        raise RuntimeError('dom0 preparation needs eleven GiB of free persistent storage')
    for slot, size in SLOTS.items():
        with (work / (slot + '.slot')).open('xb') as stream:
            os.posix_fallocate(stream.fileno(), 0, size)
    config = work / 'builder.cfg'
    backing = {'input': work / 'capsule.tar', **{k: work / (k + '.slot') for k in SLOTS}}
    loops = {}
    write(work / 'lifecycle.json', {'domain': name, 'uuid': identity, 'stage': 'allocated'})
    try:
        for slot, path in backing.items():
            loops[slot] = attach_loop(path, readonly=slot == 'input')
        disks = [f'phy:{loops[slot]},xvd{letter},{"r" if slot == "input" else "w"}'
                 for slot, letter in zip(backing, 'abcd')]
        extra = ('console=hvc0 panic=1 klokast_operation=' + request['operation_id'] +
                 ' klokast_inputs=' + request['inputs_sha256'] +
                 ' klokast_capsule=' + request['capsule']['sha256'] +
                 ' klokast_capsule_bytes=' + str(request['capsule']['bytes']))
        config.write_text(f'name = {name!r}\nuuid = {identity!r}\ntype = "pvh"\nmemory = 2048\n'
                          f'vcpus = 2\nkernel = {str(work / "bootstrap-kernel")!r}\n'
                          f'ramdisk = {str(work / "bootstrap-initramfs")!r}\nextra = {extra!r}\n'
                          f'disk = {disks!r}\nvif = []\non_poweroff = "destroy"\n'
                          'on_reboot = "destroy"\non_crash = "destroy"\n')
        boot_guest(work, name, identity, config, request, kind='klokast.dom0-build-result.v1', timeout=3600)
        result = read_slot(work / 'result.slot')
        if (result.get('kind') != 'klokast.dom0-build-result.v1' or result.get('success') is not True or
                result.get('operation_id') != request['operation_id'] or
                result.get('inputs_sha256') != request['inputs_sha256']):
            raise RuntimeError('dom0 build failed; inspect its console and result.slot')
        item = result['bundle']
        if (type(item.get('bytes')) is not int or not 0 < item['bytes'] <= SLOTS['bundle'] or
                checksum(work / 'bundle.slot', item['bytes']) != item.get('sha256')):
            raise RuntimeError('dom0 bundle output differs from its result')
        for slot, device in list(loops.items()):
            detach_loop(backing[slot], device)
            del loops[slot]
        with (work / 'bundle.slot').open('r+b') as stream:
            stream.truncate(item['bytes'])
            os.fsync(stream.fileno())
        (work / 'bundle.slot').rename(work / 'bundle.tar')
        # Building a bundle is not hardware qualification or activation.
        result.update(box=request['box'], state='built', hardware_qualified=False)
        write(work / 'build-result.json', result)
        return result
    finally:
        if domain(name) is not None:
            raise RuntimeError('dom0 builder remains; keep its files for recovery')
        for slot, device in list(loops.items()):
            detach_loop(backing[slot], device)
        for slot in SLOTS:
            # Retain the bounded result, including failed-build diagnostics.
            if slot != 'result':
                (work / (slot + '.slot')).unlink(missing_ok=True)
        config.unlink(missing_ok=True)
        write(work / 'lifecycle.json', {'domain': name, 'uuid': identity, 'stage': 'cleaned'})


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument('--box', required=True)
    parser.add_argument('--operation-id', required=True)
    args = parser.parse_args()
    if (os.geteuid() != 0 or not re.fullmatch('[a-z0-9][a-z0-9-]{0,30}', args.box) or
            not re.fullmatch('[0-9a-f]{24}', args.operation_id) or
            socket.gethostname().split('.')[0] != args.box + '-dom0' or
            'control_d' not in Path('/proc/xen/capabilities').read_text()):
        raise RuntimeError('dom0 preparation must run on the matching dom0 as root')
    os.umask(0o077)
    work = BASE / args.operation_id
    for path in (Path('/mnt/dom0_data'), BASE, work):
        safe_directory(path)
    # Share the native build lock with VM image preparation.
    with open('/mnt/dom0_data/klokast-vm-templates/build.lock', 'a') as lock:
        fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
        print(json.dumps(execute(work, validate(work, args.box, args.operation_id)), sort_keys=True))


if __name__ == '__main__':
    main()
