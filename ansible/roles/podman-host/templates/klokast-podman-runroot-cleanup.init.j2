#!/sbin/openrc-run
description="Klokast rootless Podman boot preparation"

depend() {
    need procfs localmount
    before net
}

clear_runroot() {
    if ! command -v pgrep >/dev/null 2>&1; then
        eend 1 "missing Podman process inspection tool"
        return 1
    fi
    if pgrep -u "$uid" -f 'podman|conmon|crun|netavark|pasta' >/dev/null 2>&1; then
        eend 1 "Podman runtime is active; runroot was not removed"
        return 1
    else
        result=$?
        if [ "$result" -ne 1 ]; then
            eend 1 "Podman process inspection failed"
            return 1
        fi
    fi

    if [ -L /tmp ] || [ "$(stat -c '%u:%g:%a' /tmp 2>/dev/null)" != '0:0:1777' ]; then
        eend 1 "temporary directory has unsafe ownership or mode"
        return 1
    fi
    if [ -L "$runroot" ] || { [ -e "$runroot" ] && [ ! -d "$runroot" ]; }; then
        eend 1 "Podman runroot is not a directory"
        return 1
    fi
    if [ -e "$runroot" ] &&
       [ "$(stat -c '%u:%g:%a' "$runroot" 2>/dev/null)" != "${uid}:${gid}:700" ]; then
        eend 1 "Podman runroot has unexpected ownership or mode"
        return 1
    fi
    mounts="$(awk -v root="$runroot" '$5 == root || index($5, root "/") == 1 { print $5 }' /proc/self/mountinfo)" || {
        eend 1 "Podman runroot mount inspection failed"
        return 1
    }
    if [ -n "$mounts" ]; then
        eend 1 "a filesystem is mounted in the Podman runroot"
        return 1
    fi

    # /tmp/storage-run-UID is Podman's transient runroot. Keep the separate
    # graphroot and any retained data. The old recipe left other runtime files.
    rm -rf -- "${runroot}" || {
        eend 1 "Podman runroot removal failed"
        return 1
    }
    if [ -e "$runroot" ] || [ -L "$runroot" ]; then
        eend 1 "Podman runroot reappeared during removal"
        return 1
    fi
    eend 0
}

start() {
    ebegin "Preparing rootless Podman boot state for {{ podman_host_runner_user }}"

    /sbin/modprobe tun >/dev/null 2>&1 || true
    if [ ! -e /dev/net/tun ]; then
        mkdir -p /dev/net || {
            eend 1 "failed to create /dev/net"
            return 1
        }
        mknod /dev/net/tun c 10 200 >/dev/null 2>&1 || true
    fi
    if [ -e /dev/net/tun ]; then
        chgrp netdev /dev/net/tun || {
            eend 1 "failed to set /dev/net/tun group"
            return 1
        }
        chmod 0666 /dev/net/tun || {
            eend 1 "failed to set /dev/net/tun mode"
            return 1
        }
    else
        eend 1 "missing /dev/net/tun"
        return 1
    fi

    uid="$(id -u {{ podman_host_runner_user | quote }} 2>/dev/null)" || {
        eend 1 "missing Podman runner user"
        return 1
    }
    gid="$(id -g {{ podman_host_runner_user | quote }} 2>/dev/null)" || {
        eend 1 "missing Podman runner group"
        return 1
    }
    runroot="/tmp/storage-run-${uid}"
    clear_runroot
}
