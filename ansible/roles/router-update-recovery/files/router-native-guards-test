#!/usr/bin/env python3
"""Read-only native qualification of router disk and Xen attachment guards."""
import json
import os
from pathlib import Path
import runpy
import sys
import time

sys.dont_write_bytecode = True
sys.path.insert(0, str(Path(__file__).resolve().parent))
import router_native as native
import router_records as records


def main():
    work = Path(__file__).resolve().parent
    request = records.read(work / 'request.json')
    if (set(request) != {'kind', 'box', 'operation_id', 'engine_commit', 'source'} or
            request['kind'] != 'klokast.router-native-guards-request.v1' or request['operation_id'] != work.name or
            work.parent != Path('/mnt/dom0_data/klokast-router-native-tests')):
        raise RuntimeError('router native guard test has no fixed isolated operation')
    host = native.Native()
    deadline = time.monotonic() + 60
    host.guard(request['box'], deadline=deadline)
    inspector = runpy.run_path(str(work / 'inspect-router-update.py'))
    observed = inspector['inspect_dom0'](request['box'])
    expected = request['source']
    for key in ('configuration_sha256', 'xen_runtime', 'boot_artifacts'):
        if observed[key] != expected[key]:
            raise RuntimeError('router native guard source changed after controller inspection')
    if observed['xen_runtime_matches'] is not True:
        raise RuntimeError('router native guard source has a drifted Xen runtime')
    devices = expected['xen_runtime']['disk']
    if devices != ['phy:/dev/vg0/lv_router,xvda,w']:
        raise RuntimeError('first native guard qualification requires the supervised legacy source')
    rows = [v for v in expected['logical_volumes']['report'][0]['lv'] if v['lv_path'].strip() == '/dev/vg0/lv_router']
    if len(rows) != 1:
        raise RuntimeError('router native guard source LV identity is ambiguous')
    disk = {'path':'/dev/vg0/lv_router','uuid':rows[0]['lv_uuid'].strip(),'bytes':int(rows[0]['lv_size'])}
    device = host.disk(disk, deadline=deadline)
    for value in expected['boot_artifacts'].values():
        host.artifact({**value, 'bytes': Path(value['path']).stat().st_size}, deadline=deadline)
    matches = [v for v in host.inventory(deadline=deadline) if v['config']['c_info']['name'] == 'router']
    if len(matches) != 1 or matches[0]['config']['c_info']['uuid'] != expected['xen_runtime']['uuid']:
        raise RuntimeError('router native guard live UUID differs')
    backend = native.backend_records(native.command(['/usr/bin/xenstore-ls','-f','/local/domain/0/backend/vbd'], deadline))
    attached = [(key,v) for key,v in backend.items() if key[0] == matches[0]['domid']]
    if len(attached) != 1:
        raise RuntimeError('router native block backend is ambiguous')
    key, value = attached[0]
    major, minor = [int(v,16) for v in value['physical-device'].split(':')]
    if (host.device(value['params']) != device or os.makedev(major,minor) != device or value['mode'] != 'w' or
            value['dev'] != 'xvda' or value['state'] != '4' or
            not Path('/sys/bus/xen-backend/devices/vbd-' + str(key[0]) + '-' + str(key[1])).exists()):
        raise RuntimeError('router kernel and Xen block backend identities differ')
    try:
        host.detached([disk['path']], deadline=deadline)
    except native.TransactionError as error:
        if str(error) != 'router disk still has a live Xen attachment':
            raise
    else:
        raise RuntimeError('router native detachment guard allowed a running source disk')
    records.write(work / 'result.json', {'kind':'klokast.router-native-guards-result.v1',
        'box':request['box'],'operation_id':request['operation_id'],'engine_commit':request['engine_commit'],
        'success':True,'disk_identity_verified':True,'boot_artifacts_verified':True,
        'xen_runtime_verified':True,'block_backend_verified':True,'attached_disk_refused':True,
        'router_changed':False,'replacement_authorized':False})


if __name__ == '__main__':
    main()
