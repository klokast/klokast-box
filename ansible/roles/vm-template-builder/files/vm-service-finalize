#!/usr/bin/python3
"""Copy service state inside a stopped guest's networkless replacement clone."""
import hashlib
import ipaddress
import json
import os
from pathlib import Path
import pwd
import grp
import re
import stat
import subprocess

OLD = Path('/mnt/old-service')
STATE = ('home', 'root', 'srv', 'opt', 'var/lib')
CONFIG = ('etc/hostname', 'etc/hosts', 'etc/network/interfaces', 'etc/network/if-up.d/10-klokast-dns',
          'etc/nftables.nft', 'etc/klokast', 'etc/containers', 'etc/conf.d/tailscale',
          'etc/subuid', 'etc/subgid', 'etc/machine-id', 'etc/ssh', 'etc/profile.d', 'etc/gitconfig')


def run(argv, timeout=900, accepted=(0,)):
    result = subprocess.run(argv, capture_output=True, text=True, timeout=timeout)
    if result.returncode not in accepted:
        raise RuntimeError('service finalization command failed: ' + argv[0])
    return result.stdout


def digest(path):
    h = hashlib.sha256()
    with path.open('rb') as stream:
        for chunk in iter(lambda: stream.read(1024 * 1024), b''): h.update(chunk)
    return h.hexdigest()


def validate(value):
    if (not isinstance(value, dict) or set(value) - {'bootstrap_dns', 'routing_profile', 'vpn_routing', 'vpn_creation', 'vpn_machine_id_sha256', 'dmz_creation', 'dmz_storage', 'dmz_machine_id_sha256', 'iot_creation', 'iot_storage', 'iot_machine_id_sha256'} != {'kind', 'box', 'role', 'root_partition', 'source_files', 'accounts'} or
            value['kind'] != 'klokast.vm-service-finalize.v1' or
            value['role'] not in ('bak', 'dmz', 'iot', 'vpn-egress') or
            not re.fullmatch('[a-z0-9][a-z0-9-]{0,30}', value['box']) or value['root_partition'] not in ('', '3')):
        raise RuntimeError('unsupported service finalization request')
    if 'vpn_creation' in value and value['role'] != 'vpn-egress':
        raise RuntimeError('clean reconstruction is only supported for VPN')
    for role in ('dmz','iot'):
        if role+'_creation' in value:
            import vm_dmz_personalize
            public=value[role+'_creation'];storage=value.get(role+'_storage',{})
            vm_dmz_personalize.base.validate(public)
            machine=value.get(role+'_machine_id_sha256')
            if (value['role']!=role or public['role']!=role or public['box']!=value['box'] or
                    'vpn_creation' in value or set(storage)!={'uuid','initialize','persistent_before'} or
                    storage['uuid']!=public['data_uuid'] or type(storage['initialize']) is not bool or
                    type(storage['persistent_before']) is not bool or role+'_machine_id_sha256' not in value or
                    (machine is not None and not re.fullmatch('[0-9a-f]{64}',machine))):
                raise RuntimeError('shared guest finalization lacks matching frozen storage and identity inputs')
        elif any(k in value for k in (role+'_storage',role+'_machine_id_sha256')):
            raise RuntimeError('shared guest storage or identity inputs lack their creation configuration')
    required = {'etc/hostname', 'etc/passwd', 'etc/group', 'etc/shadow', 'etc/fstab', 'etc/nftables.nft', 'etc/network/interfaces'}
    files = value['source_files']
    clean = any(k in value for k in ('vpn_creation','dmz_creation','iot_creation'))
    if 'vpn_creation' in value and ('vpn_machine_id_sha256' not in value or (value['vpn_machine_id_sha256'] is not None and not re.fullmatch('[0-9a-f]{64}',value['vpn_machine_id_sha256']))):
        raise RuntimeError('VPN machine ID presence or checksum is not recorded')
    if clean:
        minimum = {'etc/passwd', 'etc/group'}
        if not isinstance(files, dict) or not minimum <= set(files) <= required | {'etc/network/if-up.d/10-klokast-dns', 'etc/klokast/dns-filter.nft', 'etc/vpn-egress/config.yml'}:
            raise RuntimeError('service source ownership inputs are incomplete')
    if (not isinstance(files, dict) or (not clean and set(files) not in (required, required | {'etc/network/if-up.d/10-klokast-dns', 'etc/klokast/dns-filter.nft'}, required | {'etc/network/if-up.d/10-klokast-dns', 'etc/klokast/dns-filter.nft', 'etc/vpn-egress/config.yml'})) or
            any(not isinstance(v, str) or not re.fullmatch('[0-9a-f]{64}', v) for v in files.values())):
        raise RuntimeError('service configuration snapshot is incomplete')
    accounts = value['accounts']
    if (not isinstance(accounts, dict) or set(accounts) != ({'neo', 'vpn-egress'} if value['role'] == 'vpn-egress' else {'neo'}) or
            accounts['neo'] != [1000, 1000] or
            any(not isinstance(v, list) or len(v) != 2 or any(type(i) is not int or not 1 <= i <= 65534 for i in v) for v in accounts.values())):
        raise RuntimeError('service numeric identities differ from the supported accounts')
    if 'bootstrap_dns' in value:
        dns = value['bootstrap_dns']
        if not isinstance(dns, list) or len(dns) != 2 or dns[0] == dns[1] or not all(isinstance(v, str) and ipaddress.IPv4Address(v).is_global for v in dns):
            raise RuntimeError('invalid replacement bootstrap DNS')
    if 'vpn_routing' in value:
        if value['role'] != 'vpn-egress' or set(value['vpn_routing']) != {'rules', 'rule-providers', 'nameserver'} or value['routing_profile']['bootstrap-dns'] != value['bootstrap_dns']:
            raise RuntimeError('invalid frozen VPN routing input')
        if not clean and 'etc/vpn-egress/config.yml' not in files:
            raise RuntimeError('VPN configuration checksum is required before replacement')
    return value


def copy(relative):
    source, target = OLD / relative, Path('/') / relative
    if not source.exists() and not source.is_symlink(): return
    if source.is_symlink() or not source.resolve().is_relative_to(OLD):
        raise RuntimeError('selected service state path is an external link: ' + relative)
    target.parent.mkdir(parents=True, exist_ok=True)
    if target.is_symlink(): target.unlink()
    # rsync copies links as links and never traverses a nested guest mount.
    # Both trees belong to this isolated Xen guest, never dom0.
    if source.is_dir(): target.mkdir(exist_ok=True)
    suffix = '/' if source.is_dir() else ''
    arguments = ['rsync', '-aHAXS', '--numeric-ids', '--one-file-system', '--delete', str(source) + suffix, str(target) + suffix]
    run(arguments)
    changed = run(arguments[:1] + ['--dry-run', '--checksum', '--itemize-changes'] + arguments[1:])
    if changed.strip(): raise RuntimeError('retained service copy did not verify: ' + relative)


def accounts(value):
    shadow = {line.split(':')[0]: line.split(':')[1] for line in (OLD / 'etc/shadow').read_text().splitlines()}
    old_users = {parts[0]:parts for line in (OLD / 'etc/passwd').read_text().splitlines() if len(parts := line.split(':')) == 7}
    rows = [line.split(':') for line in (OLD / 'etc/group').read_text().splitlines()]
    if any(len(row) != 4 or not row[2].isdigit() for row in rows):
        raise RuntimeError('old service group database is malformed')
    old_groups = {int(row[2]): row[0] for row in rows}
    if len(old_groups) != len(rows) or len({row[0] for row in rows}) != len(rows):
        raise RuntimeError('old service group identities are ambiguous')
    if any(gid not in old_groups for uid, gid in value['accounts'].values()):
        raise RuntimeError('old service account primary group is missing')
    required_groups = {gid: old_groups[gid] for uid, gid in value['accounts'].values()}
    if 'vpn-egress' in value['accounts']:
        if old_groups.get(value['accounts']['vpn-egress'][1]) != 'vpn-egress':
            raise RuntimeError('VPN primary group must be vpn-egress; configure the gateway before replacement')
        if old_users['vpn-egress'][5:] != ['/var/lib/vpn-egress', '/sbin/nologin']:
            raise RuntimeError('VPN home and shell differ; configure the gateway before replacement')
        if any('vpn-egress' in row[3].split(',') and int(row[2]) != value['accounts']['vpn-egress'][1] for row in rows):
            raise RuntimeError('VPN account has extra groups; configure the gateway before replacement')
    # Resolve every conflict before changing either account database.
    for gid, group_name in required_groups.items():
        for lookup, key in ((grp.getgrgid, gid), (grp.getgrnam, group_name)):
            try:
                current = lookup(key)
            except KeyError:
                continue
            if current.gr_name != group_name or current.gr_gid != gid:
                raise RuntimeError('new image reuses a retained numeric group identity')
    for name, (uid, gid) in value['accounts'].items():
        for lookup, key in ((pwd.getpwuid, uid), (pwd.getpwnam, name)):
            try:
                current = lookup(key)
            except KeyError:
                continue
            if (current.pw_name, current.pw_uid, current.pw_gid) != (name, uid, gid):
                raise RuntimeError('new image reuses a retained numeric account identity')
    for gid, group_name in required_groups.items():
        try:
            group = grp.getgrgid(gid)
            if group.gr_name != group_name:
                raise RuntimeError('new image reuses a retained numeric group identity')
        except KeyError:
            run(['addgroup', '-g', str(gid), group_name])
    for name, (uid, gid) in value['accounts'].items():
        group_name = old_groups[gid]
        try:
            current = pwd.getpwuid(uid)
            if current.pw_name != name or current.pw_gid != gid:
                raise RuntimeError('new image reuses a retained numeric account identity')
        except KeyError:
            run(['adduser', '-D', '-u', str(uid), '-G', group_name, '-s', '/bin/ash' if name == 'neo' else '/sbin/nologin', name])
        retained = old_users[name]
        if retained[2:4] != [str(uid), str(gid)] or not retained[5].startswith('/'):
            raise RuntimeError('retained account differs from its recorded numeric identity')
        rows = Path('/etc/passwd').read_text().splitlines()
        Path('/etc/passwd').write_text('\n'.join(':'.join(retained) if row.split(':')[0] == name else row for row in rows) + '\n')
        if name == 'neo' and name not in grp.getgrnam('wheel').gr_mem:
            run(['addgroup', name, 'wheel'])
        entries = Path('/etc/shadow').read_text().splitlines()
        Path('/etc/shadow').write_text('\n'.join(':'.join([parts[0], shadow[name], *parts[2:]]) if (parts := line.split(':'))[0] == name else line for line in entries) + '\n')
        Path('/etc/shadow').chmod(0o600)
    Path('/etc/doas.d').mkdir(exist_ok=True)
    Path('/etc/doas.d/doas.conf').write_text('permit nopass :wheel\n')
    Path('/etc/doas.d/doas.conf').chmod(0o600)


def apply_vpn_routing(value, root=Path('/')):
    """Install frozen routing data; preserve copied relay and API credentials."""
    import yaml
    path = root / 'etc/vpn-egress/config.yml'
    config = yaml.safe_load(path.read_text())
    selected = value['vpn_routing']
    # A same-URL legacy cache can seed the URL-specific cache, never a new URL.
    previous = config.get('rule-providers', {})
    for provider in selected['rule-providers'].values():
        for old in previous.values():
            if old.get('url') == provider['url'] and re.fullmatch(r'\./rules/[a-zA-Z0-9_-]+\.yaml', old.get('path', '')):
                source = root / 'var/lib/vpn-egress' / old['path']
                target = root / 'var/lib/vpn-egress' / provider['path']
                if source.is_file() and not source.is_symlink() and not target.exists():
                    import shutil
                    target.parent.mkdir(parents=True, exist_ok=True)
                    shutil.copy2(source, target)
                    os.chown(target, source.stat().st_uid, source.stat().st_gid)
    config['rules'] = selected['rules']
    config['rule-providers'] = selected['rule-providers']
    config['dns']['nameserver'] = selected['nameserver']
    config['dns']['default-nameserver'] = value['bootstrap_dns']
    config['dns']['proxy-server-nameserver'] = value['bootstrap_dns']
    config['dns'].pop('fallback', None)
    path.write_text(yaml.safe_dump(config, sort_keys=False))


def finalize(value):
    profile = 'vpn-egress-alpine-v1' if value['role'] == 'vpn-egress' else 'shared-alpine-v1'
    if json.loads(Path('/etc/klokast-template.json').read_text())['profile'] != profile:
        raise RuntimeError('service clone has the wrong image profile')
    device = '/dev/xvdd' + value['root_partition']
    if Path('/sys/class/block/xvdd/ro').read_text().strip() != '1':
        raise RuntimeError('old service root must be attached read-only')
    run(['e2fsck', '-f', '-n', device], accepted=(0,))
    OLD.mkdir(parents=True, exist_ok=True)
    run(['mount', '-t', 'ext4', '-o', 'ro,noload', device, str(OLD)])
    try:
        if (not any(k in value for k in ('vpn_creation','dmz_creation','iot_creation')) or 'etc/hostname' in value['source_files']) and (OLD / 'etc/hostname').read_text().strip() != value['box'] + '-' + value['role']:
            raise RuntimeError('old service hostname differs from the selected target')
        for name, expected in value['source_files'].items():
            path = OLD / name
            if path.is_symlink() or not path.resolve().is_relative_to(OLD) or digest(path) != expected:
                raise RuntimeError('service configuration changed after preflight: ' + name)
        if value['role'] in ('dmz','iot') and value['role']+'_creation' in value:
            import vm_dmz_personalize
            role=value['role'];config=value[role+'_creation']
            if config['box']!=value['box'] or config['role']!=role:
                raise RuntimeError('shared guest finalization selects another target')
            vm_dmz_personalize.finalize(config,hashlib.sha256(json.dumps(config,sort_keys=True).encode()).hexdigest(),
                initialize=value[role+'_storage']['initialize'],source=OLD,expected_machine=value[role+'_machine_id_sha256'])
            return
        if 'vpn_creation' in value:
            import vm_vpn_reconstruct
            vm_vpn_reconstruct.reconstruct(OLD, value)
            return
        if not {'etc/network/if-up.d/10-klokast-dns', 'etc/klokast/dns-filter.nft'} <= set(value['source_files']):
            raise RuntimeError('service DNS inputs are not recorded; converge DNS before starting a replacement')
        accounts(value)
        run(['resize2fs', '/dev/xvda'])
        for name in (*STATE, *CONFIG): copy(name)
        # Keep inactive application configuration for explicit recovery. It is
        # data, not permission to enable services in the replacement guest.
        origin = hashlib.sha256(json.dumps(value['source_files'], sort_keys=True).encode()).hexdigest()
        retained = Path('/var/lib/klokast-service-origin') / origin
        for relative in ('etc', 'usr/local', 'var/spool'):
            source = OLD / relative
            if not source.exists(): continue
            destination = retained / relative
            destination.mkdir(parents=True, exist_ok=True)
            argv = ['rsync', '-aHAXS', '--numeric-ids', '--one-file-system', '--delete', str(source)+'/', str(destination)+'/']
            run(argv)
            if run(argv[:1]+['--dry-run','--checksum','--itemize-changes']+argv[1:]).strip():
                raise RuntimeError('inactive application configuration copy did not verify')
        fstab = ['/dev/xvda / ext4 defaults 0 1']
        for line in (OLD / 'etc/fstab').read_text().splitlines():
            fields = line.split()
            if not fields or line.lstrip().startswith('#') or fields[1] in ('/', '/boot'): continue
            if (len(fields) != 6 or fields[1:4] != ['/srv/retained', 'ext4', 'defaults'] or
                    not re.fullmatch('UUID=[0-9a-f-]{36}', fields[0]) or len(fstab) != 1):
                raise RuntimeError('service has an unsupported retained mount')
            fstab.append(line)
        Path('/etc/fstab').write_text('\n'.join(fstab) + '\n')
        # Keep only the Platform baseline enabled. Retained stopped applications
        # require explicit application deployment before they can run again.
        for level in ('default',):
            directory = Path('/etc/runlevels') / level
            directory.mkdir(parents=True, exist_ok=True)
            for path in directory.iterdir():
                if not path.is_symlink(): raise RuntimeError('unexpected regular runlevel entry')
                path.unlink()
        for service in ('networking', 'nftables', 'tailscale', 'cgroups'):
            run(['rc-update', 'add', service, 'default'])
        if value['role'] == 'vpn-egress':
            for name in ('etc/vpn-egress', 'usr/local/bin/mihomo', 'etc/init.d/vpn-egress'): copy(name)
            if 'vpn_routing' in value: apply_vpn_routing(value)
            run(['rc-update', 'add', 'vpn-egress', 'default'])
        else:
            copy('etc/init.d/klokast-podman-runroot-cleanup')
            if Path('/etc/init.d/klokast-podman-runroot-cleanup').exists():
                run(['rc-update', 'add', 'klokast-podman-runroot-cleanup', 'default'])
        # Do not restore a legacy OpenSSH service or revive stopped app services.
        if 'bootstrap_dns' in value:
            dns = ''.join('nameserver '+server+'\n' for server in value['bootstrap_dns'])
            hook = '#!/bin/sh\n# bootstrap-dns: '+' '.join(value['bootstrap_dns'])+'\nset -eu\n[ "${IFACE:-}" = eth0 ] || exit 0\n/usr/sbin/nft -f /etc/klokast/dns-filter.nft\n/usr/sbin/resolvconf -u\n/usr/sbin/resolvconf -a eth0.klokast <<\'DNS\'\n'+dns+'DNS\n'
            # A declared VPN client keeps its gateway source; only ordinary bootstrap changes.
            old_hook = Path('/etc/network/if-up.d/10-klokast-dns')
            if value['role'] == 'vpn-egress' or 'chain output' not in Path('/etc/klokast/dns-filter.nft').read_text():
                old_hook.write_text(hook); old_hook.chmod(0o755)
            else:
                text=re.sub(r'^# bootstrap-dns:.*\n', '', old_hook.read_text(), flags=re.M)
                old_hook.write_text(text.replace('#!/bin/sh\n', '#!/bin/sh\n# bootstrap-dns: '+' '.join(value['bootstrap_dns'])+'\n', 1))
        Path('/etc/klokast-service-state.json').write_text(json.dumps({'kind': 'klokast.vm-service-state.v1',
            'box': value['box'], 'role': value['role'], 'copy_verified': True, 'source_files': value['source_files']}, sort_keys=True) + '\n')
        Path('/etc/klokast-service-state.json').chmod(0o600)
    finally:
        run(['umount', str(OLD)])


def main():
    if os.getpid() != 1 or os.geteuid() != 0: raise RuntimeError('service finalization requires guest PID 1')
    for name, fs in (('proc', 'proc'), ('sys', 'sysfs'), ('dev', 'devtmpfs')):
        if not os.path.ismount('/' + name): run(['mount', '-t', fs, fs, '/' + name])
    if (Path('/sys/hypervisor/type').read_text().strip() != 'xen' or
            Path('/sys/hypervisor/uuid').read_text().strip() == '00000000-0000-0000-0000-000000000000' or
            {p.name for p in Path('/sys/class/net').iterdir()} != {'lo'}):
        raise RuntimeError('service finalization requires a networkless Xen guest')
    args = dict(v.split('=', 1) for v in Path('/proc/cmdline').read_text().split() if '=' in v)
    operation, checksum = args.get('klokast_operation', ''), args.get('klokast_inputs', '')
    if not re.fullmatch('[0-9a-f]{24}', operation) or not re.fullmatch('[0-9a-f]{64}', checksum):
        raise RuntimeError('service finalization assignment is absent')
    result = dict(kind='klokast.infrastructure-finalize.v1', operation_id=operation, inputs_sha256=checksum, success=False)
    try:
        run(['/sbin/mdev', '-s'])
        with Path('/dev/xvdb').open('rb') as stream: content = stream.read(65537).split(b'\0', 1)[0]
        if len(content) > 65536 or hashlib.sha256(content).hexdigest() != checksum:
            raise RuntimeError('service finalization input checksum differs')
        run(['mount', '-o', 'remount,rw', '/'])
        finalize(validate(json.loads(content)))
        os.sync(); run(['mount', '-o', 'remount,ro', '/'])
        result['success'] = True
    except Exception as error:
        result['error'] = str(error)[:1000]; os.sync()
    with Path('/dev/xvdc').open('wb', buffering=0) as stream:
        stream.write(json.dumps(result, sort_keys=True).encode() + b'\0'); os.fsync(stream.fileno())
    return 0 if result['success'] else 1


if __name__ == '__main__': raise SystemExit(main())
