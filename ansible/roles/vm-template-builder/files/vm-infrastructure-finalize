#!/usr/bin/python3
"""Finalize one cloned infrastructure root inside its networkless Xen guest."""
import hashlib
import ipaddress
import json
import os
from pathlib import Path
import pwd
import re
import shutil
import stat
import subprocess


def run(argv, *, input=None):
    result = subprocess.run(argv, input=input, capture_output=True, text=True, timeout=180)
    if result.returncode:
        raise RuntimeError('guest finalization command failed: ' + argv[0] + ': ' + result.stderr[-1000:])
    return result.stdout.strip()


def validate(value):
    replacement = value.get('replacement')
    base = {k: v for k, v in value.items() if k != 'replacement'}
    if (set(base) != {'kind', 'box', 'role', 'address', 'gateway', 'bridge', 'bootstrap_source', 'public_key', 'agent_uid', 'agent_gid'} or
            value['kind'] != 'klokast.infrastructure-config.v1' or value['role'] not in ('air', 'ops', 'vpn-egress') or
            not re.fullmatch(r'[a-z0-9][a-z0-9-]{0,30}', value['box'])):
        raise RuntimeError('invalid infrastructure guest configuration')
    if value['bridge'] != {'air': 'br-usr', 'ops': 'br-ops', 'vpn-egress': 'br-dmz'}[value['role']]:
        raise RuntimeError('infrastructure guest bridge differs from its Platform zone')
    address = ipaddress.IPv4Interface(value['address'])
    if ipaddress.IPv4Address(value['gateway']) not in address.network:
        raise RuntimeError('guest gateway is outside its assigned subnet')
    ipaddress.IPv4Address(value['bootstrap_source'])
    if (not re.fullmatch(r'(ssh-ed25519|ssh-rsa|ecdsa-sha2-nistp256) [A-Za-z0-9+/=]+(?: [^\r\n]+)?', value['public_key']) or
            any(type(value[k]) is not int or not 1001 <= value[k] <= 60000 for k in ('agent_uid', 'agent_gid'))):
        raise RuntimeError('invalid bootstrap public key or runner numeric ownership')
    if replacement is not None:
        if (value['role'] != 'ops' or not isinstance(replacement, dict) or
                set(replacement) != {'active_box', 'old_root_partition', 'accounts'} or
                not re.fullmatch('[a-z0-9][a-z0-9-]{0,30}', replacement['active_box']) or
                replacement['active_box'] == value['box'] or replacement['old_root_partition'] not in ('', '3')):
            raise RuntimeError('replacement requires the peer active controller and a recorded root layout')
        accounts = replacement['accounts']
        if (not isinstance(accounts, dict) or set(accounts) != {'smith', 'minion'} or
                any(not isinstance(v, list) or len(v) != 2 or any(type(i) is not int or not 1001 <= i <= 60000 for i in v)
                    for v in accounts.values()) or accounts['smith'][0] == accounts['minion'][0] or
                accounts['smith'][1] == accounts['minion'][1]):
            raise RuntimeError('replacement account numeric identities are invalid')
    return value


def put(name, content, mode=0o644):
    path = Path('/') / name
    path.parent.mkdir(parents=True, exist_ok=True)
    path.write_text(content)
    path.chmod(mode)


def account(name, uid, gid, wheel=False, shell='/bin/ash'):
    try:
        current = pwd.getpwnam(name)
    except KeyError:
        run(['addgroup', '-g', str(gid), name])
        run(['adduser', '-D', '-u', str(uid), '-G', name, '-s', shell, name])
        current = pwd.getpwnam(name)
    if (current.pw_uid, current.pw_gid, current.pw_dir) != (uid, gid, '/home/' + name):
        raise RuntimeError('existing guest account ownership differs: ' + name)
    # BusyBox adduser -D uses "!". OpenSSH on Linux rejects that account even
    # for public keys. "*" disables passwords without disabling key-only SSH.
    # The root account remains locked and is never passed to this function.
    run(['chpasswd', '-e'], input=name + ':*\n')
    if wheel:
        run(['addgroup', name, 'wheel'])


def finalize(value, digest):
    marker = json.loads(Path('/etc/klokast-template.json').read_text())
    if marker['profile'] != value['role'] + '-alpine-v1':
        raise RuntimeError('cloned image profile differs from infrastructure role')
    previous = Path('/etc/klokast-infrastructure.json')
    if previous.exists() and json.loads(previous.read_text()) != {'config_sha256': digest, 'configuration': value}:
        raise RuntimeError('refusing to change an existing guest assignment')
    # Raw ext4 roots grow inside the VM; dom0 never interprets the filesystem.
    run(['resize2fs', '/dev/xvda'])
    name = value['box'] + '-' + value['role']
    account('neo', 1000, 1000, wheel=True)
    if value['role'] == 'air':
        account('agent', value['agent_uid'], value['agent_gid'], shell='/bin/bash')
    elif value['role'] == 'ops':
        accounts = value.get('replacement', {}).get('accounts', {'smith': [1001, 1001]})
        account('smith', *accounts['smith'], wheel=True)
        if 'minion' in accounts: account('minion', *accounts['minion'])
    put('etc/hostname', name + '\n')
    put('etc/hosts', '127.0.0.1 localhost ' + name + '\n::1 localhost\n')
    put('etc/network/interfaces', 'auto lo\niface lo inet loopback\n\nauto eth0\niface eth0 inet static\n'
        '    address ' + value['address'] + '\n    gateway ' + value['gateway'] + '\n')
    put('etc/resolv.conf', 'nameserver 1.1.1.1\nnameserver 1.0.0.1\n')
    put('etc/doas.d/doas.conf', 'permit nopass :wheel\n', 0o600)
    put('home/neo/.ssh/authorized_keys', value['public_key'] + '\n', 0o600)
    Path('/home/neo/.ssh').chmod(0o700)
    for path in (Path('/home/neo/.ssh'), Path('/home/neo/.ssh/authorized_keys')):
        os.chown(path, 1000, 1000)
    put('etc/ssh/sshd_config.d/10-klokast-key-only.conf', 'PasswordAuthentication no\nKbdInteractiveAuthentication no\n'
        'PubkeyAuthentication yes\nPermitRootLogin no\nAllowUsers neo\n')
    # This temporary underlay SSH exception is removed after fresh enrollment.
    put('etc/nftables.nft', '''#!/usr/sbin/nft -f
flush ruleset
table inet klokast_vm_filter {
 chain input {
  type filter hook input priority 100; policy drop;
  ct state invalid drop
  ct state { established, related } accept
  iifname "lo" accept
  iifname "tailscale0" accept
  ip protocol icmp accept
  ip6 nexthdr icmpv6 accept
  udp dport 41641 accept
  ip saddr ''' + value['bootstrap_source'] + ''' tcp dport 22 accept comment "platform-bootstrap-ssh"
 }
 chain forward { type filter hook forward priority 100; policy drop; }
 chain output { type filter hook output priority 100; policy accept; }
}
''')
    for service in ('networking', 'nftables', 'sshd', 'tailscale'):
        run(['rc-update', 'add', service, 'default'])
    put('etc/klokast-infrastructure.json', json.dumps({'config_sha256': digest, 'configuration': value}, sort_keys=True) + '\n', 0o600)


# Same-controller state only. Managed /etc trees, source checkouts, provider
# credentials and obsolete authority publications are deliberately absent.
PRESERVE = (
    'var/lib/tailscale', 'etc/machine-id',
    'etc/ssh/ssh_host_ed25519_key', 'etc/ssh/ssh_host_ed25519_key.pub',
    'etc/ssh/ssh_host_rsa_key', 'etc/ssh/ssh_host_rsa_key.pub',
    'etc/ssh/ssh_host_ecdsa_key', 'etc/ssh/ssh_host_ecdsa_key.pub',
    'home/neo/.ssh/authorized_keys', 'home/smith/.ssh/authorized_keys',
    'home/smith/.ssh/github-klokast-codex', 'home/smith/.ssh/github-klokast-codex.pub',
    'home/smith/.ssh/github-klokast-instance', 'home/smith/.ssh/github-klokast-instance.pub',
    'home/smith/private/klokast/dom0-console.yml',
    'home/smith/private/klokast/platform-resources.yml',
    'home/smith/private/klokast/platform-users.yml',
    'home/smith/private/klokast/controller-ha.yml',
    'home/smith/private/klokast/openclaw-vpn.yml',
    'home/smith/private/klokast/vpn-egress',
    'home/smith/private/klokast/huawei-tailscale-pinhole.json',
    'home/smith/private/klokast/archive', 'home/smith/private/klokast/codex-archives',
    'home/smith/private/klokast/apps', 'home/smith/private/klokast/evidence',
    'home/smith/private/klokast/logs',
    'var/lib/klokast/operations-journal', 'var/lib/klokast/updates',
    'var/lib/klokast/apply-used-nonces', 'var/lib/klokast/apply-executions',
    'var/lib/klokast/freebox-ipv6',
    'var/lib/klokast/airunner-migration', 'var/lib/klokast/legacy-input-recovery',
    'var/lib/klokast/private-source-recoveries', 'var/lib/klokast/instance-recovery-manifests',
    'var/log/klokast',
)
PROVIDER_FILES = ('etc/klokast/tailscale-policy.env', 'etc/klokast/tailscale-devices.env',
                  'etc/klokast/freebox-ipv6.json', 'etc/klokast/secret-authority/github-app.env',
                  'etc/klokast/secret-authority/github-app.pem',
                  'home/smith/.ssh/github-klokast-instance-write')


def copy_state(source, destination, state_path=''):
    """No links or special files may escape an explicitly selected state tree."""
    info = source.lstat()
    if stat.S_ISLNK(info.st_mode):
        # Old image receipts retain a generated link to public configuration.
        # Copy the link itself only at this exact managed location and target.
        public = '/home/smith/src/klokast/klokast-box/ansible/inventory-policy/group_vars'
        if (re.fullmatch(r'var/lib/klokast/updates/discovery/builds/[0-9a-f]{24}/inventory/group_vars', state_path)
                and os.readlink(source) == public):
            destination.parent.mkdir(parents=True, exist_ok=True)
            if destination.is_symlink() and os.readlink(destination) == public:
                return
            if destination.exists() or destination.is_symlink():
                raise RuntimeError('recorded public inventory link destination differs')
            destination.symlink_to(public)
            os.chown(destination, info.st_uid, info.st_gid, follow_symlinks=False)
            return
        raise RuntimeError('state allowlist contains a symlink; reconcile it before replacement')
    if not stat.S_ISREG(info.st_mode) and not stat.S_ISDIR(info.st_mode):
        raise RuntimeError('state allowlist contains a special file; preserve it for manual reconciliation')
    if destination.is_symlink():
        raise RuntimeError('replacement state destination is a symlink')
    destination.parent.mkdir(parents=True, exist_ok=True)
    if source.is_dir():
        destination.mkdir(exist_ok=True)
        for child in sorted(source.iterdir()): copy_state(child, destination / child.name, state_path + '/' + child.name)
    else:
        temporary = destination.with_name('.' + destination.name + '.replacement')
        shutil.copyfile(source, temporary)
        os.chmod(temporary, stat.S_IMODE(info.st_mode))
        os.chown(temporary, info.st_uid, info.st_gid)
        os.replace(temporary, destination)
    os.chmod(destination, stat.S_IMODE(info.st_mode))
    os.chown(destination, info.st_uid, info.st_gid)


def preserve_controller(value):
    old = Path('/mnt/old-controller')
    old.mkdir(parents=True, exist_ok=True)
    run(['e2fsck', '-f', '-n', '/dev/xvdd' + value['replacement']['old_root_partition']])
    run(['mount', '-t', 'ext4', '-o', 'ro,noload',
         '/dev/xvdd' + value['replacement']['old_root_partition'], str(old)])
    try:
        marker = json.loads((old / 'etc/klokast/controller-ha.json').read_text())
        if (marker.get('box') != value['box'] or marker.get('role') != 'standby' or
                marker.get('active_box') != value['replacement']['active_box']):
            raise RuntimeError('old controller is not the recorded standby')
        if any((old / name).exists() or (old / name).is_symlink() for name in PROVIDER_FILES):
            raise RuntimeError('old standby retains provider mutation credentials; revoke and remove them first')
        for name in ('var/lib/tailscale/tailscaled.state', 'etc/ssh/ssh_host_ed25519_key',
                     'home/smith/.ssh/authorized_keys'):
            if not (old / name).is_file():
                raise RuntimeError('required controller identity or recovery access is absent: ' + name)
        accounts = value['replacement']['accounts']
        old_accounts = {p[0]: [int(p[2]), int(p[3])] for line in (old / 'etc/passwd').read_text().splitlines()
                        if (p := line.split(':'))[0] in accounts}
        if old_accounts != accounts:
            raise RuntimeError('old controller account identity differs from the frozen preflight')
        copied = []
        for name in PRESERVE:
            source = old / name
            # Parents must resolve within the old root; do not follow an old
            # filesystem link while interpreting an allowlist entry.
            if source.exists() or source.is_symlink():
                if not source.resolve().is_relative_to(old):
                    raise RuntimeError('controller state path escapes the old root')
                copy_state(source, Path('/') / name, name)
                copied.append(name)
        key = Path('/home/smith/.ssh/github-klokast-instance')
        if not key.exists():
            # Adopt this same controller's already-registered legacy read key.
            for suffix in ('', '.pub'):
                source = old / ('etc/klokast/private-instance/github-readonly' + suffix)
                if not source.is_file() or source.is_symlink():
                    raise RuntimeError('controller has no Instance read key; complete independent setup before replacement')
                copy_state(source, Path(str(key) + suffix))
                os.chown(str(key) + suffix, *accounts['smith'])
            key.chmod(0o600)
        # Restore only neo's password field, never the old account database.
        shadow = (old / 'etc/shadow').read_text().splitlines()
        for name in ('neo', 'smith'):
            password = next((line.split(':')[1] for line in shadow if line.startswith(name + ':')), None)
            if password is not None: run(['chpasswd', '-e'], input=name + ':' + password + '\n')
        for home in ('home/neo/.ssh', 'home/smith/.ssh', 'home/smith/private', 'home/smith/private/klokast'):
            path = Path('/') / home
            path.mkdir(parents=True, exist_ok=True); path.chmod(0o700)
            ownership = [1000, 1000] if home.startswith('home/neo') else accounts['smith']
            os.chown(path, *ownership)
        put('etc/klokast/controller-ha.json', json.dumps({
            'schema_version': 1, 'configured': True, 'box': value['box'],
            'hostname': value['box'] + '-ops', 'role': 'standby',
            'active_box': value['replacement']['active_box']}) + '\n')
        put('etc/klokast/deployment.json', '{"schema_version":1,"lifecycle":"development"}\n')
        return {'complete': True, 'allowlist_sha256': hashlib.sha256(json.dumps(PRESERVE).encode()).hexdigest(),
                'copied_paths': copied}
    finally:
        run(['umount', str(old)])


def main():
    if os.getpid() != 1 or os.geteuid() != 0:
        raise RuntimeError('infrastructure finalization requires PID 1 inside the assigned guest')
    for name, fs in (('proc', 'proc'), ('sys', 'sysfs'), ('dev', 'devtmpfs')):
        if not os.path.ismount('/' + name):
            run(['mount', '-t', fs, fs, '/' + name])
    if (Path('/sys/hypervisor/type').read_text().strip() != 'xen' or
            Path('/sys/hypervisor/uuid').read_text().strip() == '00000000-0000-0000-0000-000000000000' or
            {p.name for p in Path('/sys/class/net').iterdir()} != {'lo'}):
        raise RuntimeError('infrastructure finalization requires a networkless Xen guest')
    args = dict(v.split('=', 1) for v in Path('/proc/cmdline').read_text().split() if '=' in v)
    operation, digest = args.get('klokast_operation', ''), args.get('klokast_inputs', '')
    if not re.fullmatch('[0-9a-f]{24}', operation) or not re.fullmatch('[0-9a-f]{64}', digest):
        raise RuntimeError('missing finalization assignment')
    result = {'kind': 'klokast.infrastructure-finalize.v1', 'operation_id': operation, 'inputs_sha256': digest, 'success': False}
    try:
        with Path('/dev/xvdb').open('rb') as stream:
            content = stream.read(65537).split(b'\0', 1)[0]
        if len(content) > 65536 or hashlib.sha256(content).hexdigest() != digest:
            raise RuntimeError('finalization configuration checksum differs')
        run(['mount', '-o', 'remount,rw', '/'])
        run(['/sbin/mdev', '-s'])
        value = validate(json.loads(content))
        finalize(value, digest)
        if value.get('replacement'):
            result['preservation'] = preserve_controller(value)
        os.sync()
        run(['mount', '-o', 'remount,ro', '/'])
        result['success'] = True
    except Exception as error:
        result['error'] = str(error)[:1000]
        os.sync()
    with Path('/dev/xvdc').open('wb', buffering=0) as stream:
        stream.write(json.dumps(result, sort_keys=True).encode() + b'\0')
        os.fsync(stream.fileno())
    return 0 if result['success'] else 1


if __name__ == '__main__':
    raise SystemExit(main())
