#!/usr/bin/python3
"""Offline base-image tests in custom-init and normal OpenRC disposable boots."""
import json
import os
from pathlib import Path
import re
import shutil
import stat
import subprocess
import sys
import time


def run(argv, timeout=60):
    result = subprocess.run(argv, capture_output=True, text=True, timeout=timeout)
    if result.returncode:
        print(result.stdout[-4096:], result.stderr[-4096:], flush=True)
        raise RuntimeError("base image test failed: " + argv[0])
    return result.stdout.strip()


def environment(openrc=False):
    if (not openrc and os.getpid() != 1) or os.geteuid() != 0:
        raise RuntimeError("template test must be PID 1 in its disposable guest")
    for name, filesystem in (("proc", "proc"), ("sys", "sysfs"), ("dev", "devtmpfs")):
        if not os.path.ismount("/" + name):
            if openrc:
                raise RuntimeError('OpenRC did not mount the required system filesystem: ' + name)
            run(["mount", "-t", filesystem, filesystem, "/" + name])
    if (Path("/sys/hypervisor/type").read_text().strip() != "xen" or
            Path("/sys/hypervisor/uuid").read_text().strip() == "00000000-0000-0000-0000-000000000000" or
            {p.name for p in Path("/sys/class/net").iterdir()} != {"lo"}):
        raise RuntimeError("template test requires an isolated networkless Xen guest")
    args = dict(v.split("=", 1) for v in Path("/proc/cmdline").read_text().split() if "=" in v)
    if (not re.fullmatch(r"[0-9a-f]{24}", args.get("klokast_test", "")) or
            not re.fullmatch(r"[0-9a-f]{64}", args.get("klokast_inputs", ""))):
        raise RuntimeError("template test requires its exact boot assignment")
    if openrc and (os.getpid() == 1 or args.get('klokast_openrc') != '1' or
                   Path('/proc/1/comm').read_text().strip() != 'init'):
        raise RuntimeError('normal boot test requires the real init process and its test assignment')
    for path in (Path("/dev/xvda"), Path("/dev/xvdb"), Path("/dev/xvdc"), Path("/dev/xvdd")):
        if path.is_symlink() or not stat.S_ISBLK(path.stat().st_mode):
            raise RuntimeError("template test requires its four fixed Xen disks")
    return args


def tailscale_test():
    run(["modprobe", "tun"])
    process = subprocess.Popen(["tailscaled", "--state=mem:", "--socket=/run/template-tailscale.sock",
                                "--tun=userspace-networking", "--port=0"],
                               stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    try:
        for _ in range(100):
            if Path("/run/template-tailscale.sock").exists():
                break
            if process.poll() is not None:
                raise RuntimeError("Tailscale could not start offline")
            time.sleep(0.1)
        status = json.loads(run(["tailscale", "--socket=/run/template-tailscale.sock", "status", "--json"]))
        if status.get("BackendState") != "NeedsLogin":
            raise RuntimeError("generic Tailscale state is not unenrolled")
    finally:
        process.terminate()
        try:
            process.wait(timeout=10)
        except subprocess.TimeoutExpired:
            process.kill()
            process.wait(timeout=10)


def device_test(initialize=False):
    if initialize:
        # Custom PID 1 skips OpenRC's mdev coldplug. Use the installed Alpine
        # rules, including its /dev/null fix, before running an unprivileged test.
        run(['/sbin/mdev', '-s'])
    for name, minor in (('null', 3), ('zero', 5)):
        info = Path('/dev/' + name).lstat()
        if (not stat.S_ISCHR(info.st_mode) or info.st_rdev != os.makedev(1, minor) or
                stat.S_IMODE(info.st_mode) != 0o666 or info.st_uid != 0):
            raise RuntimeError('Alpine device setup did not provide a usable /dev/' + name)


def podman_test(defaults=False):
    # The account and runtime state exist only on the disposable copy. No
    # application image is fetched, built, or substituted by this test.
    user, uid = ('openrc-test', 2001) if defaults else ('template-test', 2000)
    home = '/home/' + user
    run(["adduser", "-D", "-u", str(uid), "-h", home, user])
    for name in ("subuid", "subgid"):
        with Path('/etc/' + name).open('a') as stream:
            stream.write(user + ':' + str(300000 if defaults else 200000) + ':65536\n')
    runtime = Path('/run/user/' + str(uid))
    runtime.mkdir(parents=True, mode=0o700)
    os.chown(runtime, uid, uid)
    rootfs = Path(home) / 'rootfs'
    rootfs.mkdir()
    files = {"/bin/busybox"}
    # Use the installed package's library closure for this throwaway rootfs.
    for token in run(["ldd", "/bin/busybox"]).split():
        if token.startswith(("/lib/", "/usr/lib/")):
            files.add(token)
    for source in sorted(files):
        target = rootfs / source.lstrip("/")
        target.parent.mkdir(parents=True, exist_ok=True)
        shutil.copyfile(source, target)
        target.chmod(0o755)
    for parent, directories, files in os.walk(rootfs):
        os.chown(parent, uid, uid)
        for name in files:
            os.chown(Path(parent) / name, uid, uid)
    environment = 'export XDG_RUNTIME_DIR=' + str(runtime) + '; '
    if defaults:
        info = json.loads(run(['su', '-s', '/bin/sh', user, '-c', environment + 'exec podman info --format=json']))
        if (info.get('host', {}).get('security', {}).get('rootless') is not True or
                info['host'].get('cgroupVersion') != 'v2' or info.get('store', {}).get('graphDriverName') != 'overlay'):
            raise RuntimeError('default rootless Podman did not select cgroup v2 and overlay storage')
    options = '' if defaults else '--storage-driver=vfs --cgroup-manager=cgroupfs '
    cgroups = '' if defaults else '--cgroups=disabled '
    command = (environment + 'exec podman ' + options + '--events-backend=file '
               'run --rm ' + cgroups + '--network=none --log-driver=none '
               "--security-opt=no-new-privileges --cap-drop=all "
               '--rootfs ' + str(rootfs) + ' /bin/busybox true')
    run(["su", "-s", "/bin/sh", user, "-c", command], timeout=120)


def install_openrc_test():
    # Only the disposable copy is changed. The generic artifact stays sealed.
    service = Path('/etc/init.d/klokast-template-openrc-test')
    service.write_text('#!/sbin/openrc-run\n'
                       'depend() { need cgroups localmount bootmisc; }\n'
                       'start() { /usr/local/libexec/klokast-template-test --openrc >/dev/console 2>&1; }\n')
    service.chmod(0o700)
    link = Path('/etc/runlevels/default/klokast-template-openrc-test')
    link.parent.mkdir(parents=True, exist_ok=True)
    link.symlink_to(service)


def finish(result):
    data = (json.dumps(result, sort_keys=True, separators=(',', ':')) + '\n').encode()
    if len(data) >= 1024 * 1024:
        raise RuntimeError('template test result exceeds its slot')
    with Path('/dev/xvdb').open('wb', buffering=0) as stream:
        stream.write(data + b'\0'); os.fsync(stream.fileno())
    os.sync()
    subprocess.run(['poweroff', '-f'])
    while True:
        time.sleep(1)


def openrc_test():
    args = environment(openrc=True)
    result = {'kind': 'klokast.vm-template-openrc-test.v1', 'operation_id': args['klokast_test'],
              'inputs_sha256': args['klokast_inputs'], 'success': False, 'tests': {}}
    try:
        marker = json.loads(Path('/etc/klokast-template.json').read_text())
        kernel = os.uname().release
        if marker['inputs_sha256'] != args['klokast_inputs'] or not (Path('/lib/modules') / kernel).is_dir():
            raise RuntimeError('normal boot root, kernel, modules, and assignment disagree')
        result['kernel_release'] = kernel
        for service in ('cgroups', 'localmount', 'bootmisc'):
            run(['/sbin/rc-service', service, 'status'])
        if ' - cgroup2 ' not in Path('/proc/self/mountinfo').read_text():
            raise RuntimeError('OpenRC did not mount cgroup v2')
        result['tests'].update(openrc_boot=True, cgroup_v2=True, kernel_modules=True)
        device_test()
        tailscale_test(); result['tests']['tailscale_offline'] = True
        podman_test(defaults=True); result['tests']['default_rootless_podman'] = True
        result['success'] = True
    except Exception as error:
        result['error'] = type(error).__name__ + ': ' + str(error)[:1000]
        print(result['error'], flush=True)
    finish(result)


def main():
    args = environment()  # No result writes outside the dedicated test guest.
    result = {"kind": "klokast.vm-template-test-result.v1", "operation_id": args["klokast_test"],
              "inputs_sha256": args["klokast_inputs"], "success": False, "tests": {}}
    try:
        run(["mount", "-o", "remount,rw", "/"])
        Path("/run").mkdir(exist_ok=True)
        if not os.path.ismount("/run"):
            run(["mount", "-t", "tmpfs", "-o", "mode=0755,nosuid,nodev", "tmpfs", "/run"])
        if not os.path.ismount("/sys/fs/cgroup"):
            run(["mount", "-t", "cgroup2", "cgroup2", "/sys/fs/cgroup"])
        marker = json.loads(Path("/etc/klokast-template.json").read_text())
        kernel = os.uname().release
        if marker["inputs_sha256"] != args["klokast_inputs"] or not (Path("/lib/modules") / kernel).is_dir():
            raise RuntimeError("booted root, kernel, modules, and input assignment disagree")
        result["kernel_release"] = kernel
        result["tests"].update(boot=True, kernel_modules=True)
        device_test(initialize=True)
        tailscale_test()
        result["tests"]["tailscale_offline"] = True
        podman_test()
        result["tests"]["rootless_podman"] = True
        run(["nft", "add", "table", "inet", "template_test"])
        run(["nft", "delete", "table", "inet", "template_test"])
        result["tests"]["nftables_kernel"] = True
        import retained_data_test
        result['retained_data_test'] = retained_data_test.test(run, args['klokast_test'])
        result['tests']['retained_data_copy'] = True
        result['retained_data_stage_test'] = retained_data_test.stage_test(run, args['klokast_test'])
        result['tests']['retained_data_stage'] = True
        result['retained_identity_test'] = retained_data_test.identity_test(run, args['klokast_test'])
        result['tests']['retained_identity'] = True
        result['retained_partition_test'] = retained_data_test.partition_test(run, args['klokast_test'])
        result['tests']['retained_partition'] = True
        if 'klokast_app_capsule' in args or 'klokast_app_bytes' in args:
            from vm_app_compatibility import unpack
            import static_site_test
            device = Path('/dev/xvde')
            if device.is_symlink() or not stat.S_ISBLK(device.stat().st_mode):
                raise RuntimeError('application test input disk is missing')
            if Path('/sys/class/block/xvde/ro').read_text().strip() != '1':
                raise RuntimeError('application test input must be read-only at the Xen boundary')
            directory = Path('/home/template-test/app-test')
            selection = unpack(device, directory,
                               {'sha256': args.get('klokast_app_capsule'), 'bytes': int(args.get('klokast_app_bytes', '0'))},
                               Path(static_site_test.__file__))
            result['application_test'] = static_site_test.test(run, directory, selection)
        install_openrc_test()
        result["success"] = True
    except Exception as error:
        result["error"] = type(error).__name__ + ": " + str(error)[:1000]
        print(result["error"], flush=True)
    finish(result)


if __name__ == "__main__":
    openrc_test() if sys.argv[1:] == ['--openrc'] else main()
