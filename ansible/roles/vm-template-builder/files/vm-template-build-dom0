#!/usr/bin/env python3
"""Bounded, networkless candidate build. Never mounts a guest filesystem.

This operator-invoked helper has no release activation or VM replacement
interface. All writable resources are new files under one operation directory.
"""
import argparse
import fcntl
import hashlib
import json
import os
from pathlib import Path
import pty
import re
import signal
import socket
import subprocess
import threading
import time
import uuid

from vm_app_compatibility import validate_request as validate_app_request, verify_result as verify_app_result

BASE = Path("/mnt/dom0_data/klokast-vm-templates")
MIB = 1024 * 1024
# The generic base contains packages only, with no application image store.
# Production OS volumes must use their declared capacity during personalization.
SLOTS = {"root": 4096 * MIB, "kernel": 32 * MIB, "initramfs": 128 * MIB, "result": MIB}
MEMORY = 4096
TIMEOUT = 1500


def run(argv, check=True, timeout=60):
    result = subprocess.run([str(v) for v in argv], capture_output=True, text=True,
                            stdin=subprocess.DEVNULL, timeout=timeout)
    if check and result.returncode:
        raise RuntimeError("dom0 builder command failed: " + str(argv[0]))
    return result


def checksum(path, count=None):
    result = hashlib.sha256()
    with path.open("rb") as source:
        remaining = path.stat().st_size if count is None else count
        while remaining:
            chunk = source.read(min(remaining, MIB))
            if not chunk:
                raise RuntimeError("builder output is truncated")
            result.update(chunk)
            remaining -= len(chunk)
    return result.hexdigest()


def safe_file(path, maximum):
    info = path.lstat()
    if (path.is_symlink() or not path.is_file() or info.st_uid != 0 or info.st_nlink != 1 or
            info.st_mode & 0o022 or not 0 < info.st_size <= maximum):
        raise RuntimeError("builder file has unsafe ownership, type, mode, or size: " + path.name)


def safe_directory(path):
    info = path.lstat()
    if path.is_symlink() or not path.is_dir() or info.st_uid != 0 or info.st_mode & 0o022:
        raise RuntimeError("builder directory is not private root-owned storage")


def write(path, value):
    temporary = path.with_suffix(".new")
    with temporary.open("x") as stream:
        json.dump(value, stream, sort_keys=True, separators=(",", ":"))
        stream.write("\n")
        stream.flush()
        os.fsync(stream.fileno())
    temporary.replace(path)
    descriptor = os.open(path.parent, os.O_RDONLY | os.O_DIRECTORY)
    try:
        os.fsync(descriptor)
    finally:
        os.close(descriptor)


def duplicate_fields(pairs):
    result = {}
    for key, value in pairs:
        if key in result:
            raise RuntimeError("duplicate builder JSON field")
        result[key] = value
    return result


def validate_request(work, box, operation):
    safe_file(work / "request.json", MIB)
    request = json.loads((work / "request.json").read_text(), object_pairs_hook=duplicate_fields)
    if ((set(request) - {"app_test"}) != {"kind", "box", "operation_id", "inputs_sha256", "capsule", "bootstrap"} or
            request["kind"] != "klokast.vm-template-build-request.v1" or
            request["box"] != box or request["operation_id"] != operation or
            not isinstance(request["inputs_sha256"], str) or not re.fullmatch(r"[0-9a-f]{64}", request["inputs_sha256"]) or
            not isinstance(request["bootstrap"], dict) or set(request["bootstrap"]) != {"kernel", "initramfs"}):
        raise RuntimeError("builder request has an invalid contract")
    for name, item, maximum in (("capsule.tar", request["capsule"], 2049 * MIB),
                                ("bootstrap-kernel", request["bootstrap"]["kernel"], 32 * MIB),
                                ("bootstrap-initramfs", request["bootstrap"]["initramfs"], 1024 * MIB)):
        if (not isinstance(item, dict) or set(item) != {"sha256", "bytes"} or type(item["bytes"]) is not int or
                not 0 < item["bytes"] <= maximum or not isinstance(item["sha256"], str) or
                not re.fullmatch(r"[0-9a-f]{64}", item["sha256"])):
            raise RuntimeError("builder request input identity is invalid")
        path = work / name
        safe_file(path, maximum)
        if path.stat().st_size != item["bytes"] or checksum(path) != item["sha256"]:
            raise RuntimeError("staged builder input differs from its request")
    if 'app_test' in request:
        validate_app_request(request['app_test'])
        item = request['app_test']['capsule']
        path = work / 'app-test.tar'
        safe_file(path, 257 * MIB)
        if path.stat().st_size != item['bytes'] or checksum(path) != item['sha256']:
            raise RuntimeError('staged application capsule differs from its request')
    return request


def domain(name):
    # List all domains successfully before concluding a builder no longer exists.
    output = run(["xl", "list", "-l"]).stdout
    records = json.loads(output)
    if not isinstance(records, list) or not records:
        raise RuntimeError("Xen returned no complete domain inventory")
    for record in records:
        info = record.get("config", {}).get("c_info", {})
        if (type(record.get("domid")) is not int or not isinstance(info.get("name"), str) or
                (record["domid"] == 0 and info["name"] != "Domain-0") or
                (record["domid"] != 0 and not isinstance(info.get("uuid"), str))):
            raise RuntimeError("Xen returned an unsupported domain inventory format")
    matches = [item for item in records if item.get("config", {}).get("c_info", {}).get("name") == name]
    if len(matches) > 1:
        raise RuntimeError("builder domain identity is ambiguous")
    return matches[0] if matches else None


def require_identity(record, identity):
    if (record.get("config", {}).get("c_info", {}).get("uuid") != identity or
            type(record.get("domid")) is not int or record["domid"] <= 0):
        raise RuntimeError("builder domain UUID changed; refusing to control it")


def configuration(work, name, identity, request, loops):
    # Kernel blkback and loop devices avoid starting a QEMU disk backend.
    disks = [f"phy:{loops['input']},xvda,r"]
    disks += [f"phy:{loops[slot]},xvd{letter},w"
              for slot, letter in zip(SLOTS, "bcde")]
    extra = ("console=hvc0 panic=1 klokast_operation=" + request["operation_id"] +
             " klokast_inputs=" + request["inputs_sha256"] + " klokast_capsule=" + request["capsule"]["sha256"] +
             " klokast_capsule_bytes=" + str(request["capsule"]["bytes"]))
    return (f"name = {name!r}\nuuid = {identity!r}\ntype = 'pvh'\nmemory = {MEMORY}\nmaxmem = {MEMORY}\n"
            f"vcpus = 2\nkernel = {str(work / 'bootstrap-kernel')!r}\n"
            f"ramdisk = {str(work / 'bootstrap-initramfs')!r}\nextra = {extra!r}\n"
            f"disk = {disks!r}\nvif = []\non_poweroff = 'destroy'\non_reboot = 'destroy'\non_crash = 'destroy'\n")


def read_slot(path):
    with path.open("rb") as stream:
        data = stream.read(MIB)
    try:
        return json.loads(data.split(b"\0", 1)[0], object_pairs_hook=duplicate_fields)
    except (ValueError, UnicodeError) as error:
        raise RuntimeError("guest stopped without a complete result; inspect its isolated console log") from error


def read_result(work, request):
    result = read_slot(work / "result.slot")
    if (result.get("kind") != "klokast.vm-template-build-result.v1" or result.get("success") is not True or
            result.get("inputs_sha256") != request["inputs_sha256"] or
            result.get("operation_id") != request["operation_id"] or
            result.get("tests") != {"package_closure": True, "no_machine_identity": True}):
        raise RuntimeError("isolated builder did not return a successful matching result")
    for name in ("kernel", "initramfs"):
        item = result["artifacts"][name]
        if (set(item) != {"sha256", "bytes"} or type(item["bytes"]) is not int or
                not 0 < item["bytes"] <= SLOTS[name] or checksum(work / (name + ".slot"), item["bytes"]) != item["sha256"]):
            raise RuntimeError("guest boot output differs from its result")
    if (not isinstance(result.get("kernel_release"), str) or
            not re.fullmatch(r"[a-zA-Z0-9_.+-]+", result["kernel_release"]) or
            result["kernel_release"] != result.get("modules_release")):
        raise RuntimeError("guest kernel and modules do not match")
    return result


def completion_ready(work, request, slot="result.slot", kind="klokast.vm-template-build-result.v1"):
    # PVH firmware can halt instead of powering off. The guest publishes this
    # bounded result only after unmounting its root output. Use it only as a
    # signal to stop our disposable domain. Verify all output after it stops.
    with (work / slot).open("rb") as stream:
        data = stream.read(MIB).split(b"\0", 1)[0]
    try:
        value = json.loads(data, object_pairs_hook=duplicate_fields)
    except (ValueError, UnicodeError, RuntimeError):
        return False
    return (isinstance(value, dict) and value.get("kind") == kind and
            type(value.get("success")) is bool and value.get("operation_id") == request["operation_id"] and
            value.get("inputs_sha256") == request["inputs_sha256"])


def capture_console(descriptor, path):
    # Keep bounded diagnostics even if an upstream package floods its console.
    # Continue draining after the limit so logging cannot block guest progress.
    with path.open("xb") as stream:
        written = 0
        while True:
            try:
                chunk = os.read(descriptor, 4096)
            except OSError:
                return  # Linux PTYs report EIO when the child closes its end.
            if not chunk:
                return
            kept = chunk[:max(0, MIB - written)]
            stream.write(kept)
            stream.flush()
            written += len(kept)


def loop_devices(path):
    return sorted("/dev/" + item.parents[1].name for item in Path("/sys/block").glob("loop*/loop/backing_file")
                  if item.read_text().strip().lstrip("/") == str(path).lstrip("/"))


def attach_loop(path, readonly=False):
    if loop_devices(path):
        raise RuntimeError("builder file already has a loop attachment")
    run(["losetup", *(["-r"] if readonly else []), "-f", path])
    devices = loop_devices(path)
    if len(devices) != 1 or not re.fullmatch(r"/dev/loop[0-9]+", devices[0]):
        raise RuntimeError("builder loop attachment is ambiguous")
    return devices[0]


def detach_loop(path, device):
    if loop_devices(path) != [device]:
        raise RuntimeError("builder loop identity changed; refusing to detach it")
    run(["losetup", "-d", device])
    if loop_devices(path):
        raise RuntimeError("builder loop device remains; retain its backing file")


def boot_guest(work, name, identity, config, request, *, slot="result.slot",
               kind="klokast.vm-template-build-result.v1", timeout=TIMEOUT):
    console, collector, console_fd = None, None, None
    try:
        run(["xl", "create", "-p", config])
        current = domain(name)
        if current is None:
            raise RuntimeError("paused builder domain was not created")
        require_identity(current, identity)
        console_fd, slave = pty.openpty()
        try:
            console = subprocess.Popen(["xl", "console", str(current["domid"])], stdin=slave, stdout=slave, stderr=slave)
        finally:
            os.close(slave)
        collector = threading.Thread(target=capture_console, args=(console_fd, work / (name + ".log")), daemon=True)
        collector.start()
        run(["xl", "unpause", str(current["domid"])])
        deadline = time.monotonic() + timeout
        while True:
            current = domain(name)
            if current is None:
                return
            require_identity(current, identity)
            if completion_ready(work, request, slot, kind):
                return  # The finally block stops this exact guest before reads.
            if time.monotonic() >= deadline:
                raise RuntimeError("isolated guest exceeded its build or test deadline")
            time.sleep(2)
    finally:
        try:
            current = domain(name)
            if current is not None:
                require_identity(current, identity)
                run(["xl", "destroy", str(current["domid"])])
                if domain(name) is not None:
                    raise RuntimeError("disposable guest remains; retain its disks")
        finally:
            if console is not None:
                console.terminate()
                try:
                    console.wait(timeout=10)
                except subprocess.TimeoutExpired:
                    console.kill()
                    console.wait(timeout=10)
                if collector is not None:
                    collector.join(timeout=10)
            if console_fd is not None:
                os.close(console_fd)


def smoke_test(work, request, build):
    name = "vm-test-" + request["operation_id"]
    identity = str(uuid.uuid4())
    openrc_name = 'vm-openrc-' + request['operation_id']
    openrc_identity = str(uuid.uuid4())
    personalize_name = 'vm-personalize-' + request['operation_id']
    personalize_identity = str(uuid.uuid4())
    profile_name = 'vm-profile-' + request['operation_id']
    profile_identity = str(uuid.uuid4())
    test_names = (name, openrc_name, personalize_name, profile_name)
    if any(domain(n) is not None for n in test_names):
        raise RuntimeError("refusing to reuse an existing template test domain")
    root = work / "test-root.slot"
    personalized_root = work / 'personalized-root.slot'
    result_path = work / "test-result.slot"
    data_paths = [work / 'test-source.slot', work / 'test-retained.slot']
    config = work / "test.cfg"
    loops = {}
    app_path = work / 'app-test.tar' if 'app_test' in request else None
    copied_hash = hashlib.sha256()
    # Copy bytes only. Never interpret or mount the generated filesystem here.
    with (work / "root.slot").open("rb") as source, root.open("xb") as target:
        os.posix_fallocate(target.fileno(), 0, SLOTS["root"])
        while chunk := source.read(MIB):
            copied_hash.update(chunk)
            target.write(chunk)
        target.flush()
        os.fsync(target.fileno())
    with result_path.open("xb") as stream:
        os.posix_fallocate(stream.fileno(), 0, MIB)
    for path in data_paths:
        with path.open('xb') as stream:
            os.posix_fallocate(stream.fileno(), 0, 256 * MIB)
    try:
        for path in (root, result_path, *data_paths):
            loops[path] = attach_loop(path)
        if app_path:
            loops[app_path] = attach_loop(app_path, readonly=True)
        extra = ''
        disks = ['phy:' + loops[p] + ',xvd' + letter + ',w'
                 for p, letter in zip((root, result_path, *data_paths), 'abcd')]
        if app_path:
            app = request['app_test']['capsule']
            extra = f" klokast_app_capsule={app['sha256']} klokast_app_bytes={app['bytes']}"
            disks.append('phy:' + loops[app_path] + ',xvde,r')
        for artifact in ("kernel", "initramfs"):
            with (work / (artifact + ".slot")).open("r+b") as stream:
                stream.truncate(build["artifacts"][artifact]["bytes"])
        config.write_text(
            f"name = {name!r}\nuuid = {identity!r}\ntype = 'pvh'\nmemory = {MEMORY}\nmaxmem = {MEMORY}\nvcpus = 2\n"
            f"kernel = {str(work / 'kernel.slot')!r}\nramdisk = {str(work / 'initramfs.slot')!r}\n"
            "extra = 'console=hvc0 panic=1 root=/dev/xvda rootfstype=ext4 modules=ext4 rw init=/usr/local/libexec/klokast-template-test "
            f"klokast_test={request['operation_id']} klokast_inputs={request['inputs_sha256']}{extra}'\n"
            f"disk = {disks!r}\n"
            "vif = []\non_poweroff = 'destroy'\non_reboot = 'destroy'\non_crash = 'destroy'\n")
        write(work / "test-lifecycle.json", {"domain": name, "uuid": identity, "stage": "allocated"})
        boot_guest(work, name, identity, config, request, slot=result_path.name,
                   kind="klokast.vm-template-test-result.v1", timeout=600 if app_path else 300)
        value = read_slot(result_path)
        expected_tests = {k: True for k in ("boot", "kernel_modules", "tailscale_offline", "rootless_podman", "nftables_kernel", "retained_data_copy", "retained_data_stage", "retained_identity", "retained_partition", "personalization")}
        if (value.get("kind") != "klokast.vm-template-test-result.v1" or value.get("success") is not True or
                value.get("operation_id") != request["operation_id"] or value.get("inputs_sha256") != request["inputs_sha256"] or
                value.get("kernel_release") != build["kernel_release"] or value.get("tests") != expected_tests):
            raise RuntimeError("candidate base boot tests failed; inspect the isolated test console")
        if app_path:
            verify_app_result(value.get('application_test'), request['app_test']['selection'])
        elif 'application_test' in value:
            raise RuntimeError('unexpected application test evidence')
        # A second cold boot uses the real init and OpenRC runlevels. The test
        # service was installed by the first guest, never by a dom0 mount.
        with result_path.open('r+b') as stream:
            stream.write(b'\0' * MIB); stream.flush(); os.fsync(stream.fileno())
        config.write_text(config.read_text().replace(f'name = {name!r}', f'name = {openrc_name!r}')
                          .replace(identity, openrc_identity)
                          .replace('init=/usr/local/libexec/klokast-template-test', 'init=/sbin/init klokast_openrc=1'))
        write(work / 'test-lifecycle.json', {'domain': name, 'uuid': identity,
              'openrc_domain': openrc_name, 'openrc_uuid': openrc_identity, 'stage': 'openrc-allocated'})
        boot_guest(work, openrc_name, openrc_identity, config, request, slot=result_path.name,
                   kind='klokast.vm-template-openrc-test.v1', timeout=300)
        normal = read_slot(result_path)
        expected_normal = dict.fromkeys(('openrc_boot', 'cgroup_v2', 'kernel_modules',
                                         'tailscale_offline', 'default_rootless_podman'), True)
        if (normal.get('kind') != 'klokast.vm-template-openrc-test.v1' or normal.get('success') is not True or
                normal.get('operation_id') != request['operation_id'] or
                normal.get('inputs_sha256') != request['inputs_sha256'] or
                normal.get('kernel_release') != build['kernel_release'] or normal.get('tests') != expected_normal):
            raise RuntimeError('candidate OpenRC boot tests failed; inspect the isolated OpenRC console')
        value['openrc_test'] = normal
        # Dom0 allocates opaque disks. Only the networkless Xen guest mounts
        # the cloned OS; its sealed source is attached read-only.
        with personalized_root.open('xb') as stream:
            os.posix_fallocate(stream.fileno(), 0, SLOTS['root'])
        loops[personalized_root] = attach_loop(personalized_root)
        sealed_root = work / 'root.slot'
        loops[sealed_root] = attach_loop(sealed_root, readonly=True)
        stage_disks = ['phy:' + loops[p] + ',xvd' + letter + ',w'
                       for p, letter in zip((root, result_path, data_paths[0], personalized_root), 'abcd')]
        if app_path:
            stage_disks.append('phy:' + loops[app_path] + ',xvde,r')
        stage_disks.append('phy:' + loops[sealed_root] + ',xvdf,r')
        with result_path.open('r+b') as stream:
            stream.write(b'\0' * MIB); stream.flush(); os.fsync(stream.fileno())
        config.write_text(config.read_text().replace(f'name = {openrc_name!r}', f'name = {personalize_name!r}')
                          .replace(openrc_identity, personalize_identity)
                          .replace(f'disk = {disks!r}', f'disk = {stage_disks!r}')
                          .replace('init=/sbin/init klokast_openrc=1',
                                   'init=/usr/local/libexec/klokast-template-test klokast_personalize_stage=1 '
                                   'klokast_root_sha256=' + copied_hash.hexdigest()))
        lifecycle = {'domain': name, 'uuid': identity, 'openrc_domain': openrc_name, 'openrc_uuid': openrc_identity,
                     'personalize_domain': personalize_name, 'personalize_uuid': personalize_identity,
                     'profile_domain': profile_name, 'profile_uuid': profile_identity}
        write(work / 'test-lifecycle.json', dict(lifecycle, stage='personalize-allocated'))
        boot_guest(work, personalize_name, personalize_identity, config, request, slot=result_path.name,
                   kind='klokast.vm-template-personalize-stage.v1', timeout=300)
        prepared = read_slot(result_path)
        if (prepared.get('kind') != 'klokast.vm-template-personalize-stage.v1' or prepared.get('success') is not True or
                prepared.get('operation_id') != request['operation_id'] or prepared.get('inputs_sha256') != request['inputs_sha256'] or
                prepared.get('production_data_used') is not False or prepared.get('source_root_sha256') != copied_hash.hexdigest() or
                any(not isinstance(prepared.get(k), str) or not re.fullmatch('[0-9a-f]{64}', prepared[k])
                    for k in ('request_sha256', 'receipt_sha256'))):
            raise RuntimeError('personalized test preparation failed; inspect its isolated console')
        with result_path.open('r+b') as stream:
            stream.write(b'\0' * MIB); stream.flush(); os.fsync(stream.fileno())
        profile_disks = ['phy:' + loops[p] + ',xvd' + letter + ',w'
                         for p, letter in zip((personalized_root, result_path, data_paths[0], root), 'abcd')]
        if app_path:
            profile_disks.append('phy:' + loops[app_path] + ',xvde,r')
        profile_disks.append('phy:' + loops[sealed_root] + ',xvdf,r')
        config.write_text(config.read_text().replace(f'name = {personalize_name!r}', f'name = {profile_name!r}')
                          .replace(personalize_identity, profile_identity)
                          .replace(f'disk = {stage_disks!r}', f'disk = {profile_disks!r}')
                          .replace('init=/usr/local/libexec/klokast-template-test klokast_personalize_stage=1',
                                   'init=/sbin/init klokast_openrc=1 klokast_personalized=1'))
        write(work / 'test-lifecycle.json', dict(lifecycle, stage='profile-allocated'))
        boot_guest(work, profile_name, profile_identity, config, request, slot=result_path.name,
                   kind='klokast.vm-template-personalized-test.v1', timeout=300)
        profile = read_slot(result_path)
        profile_tests = dict.fromkeys(('personalized_boot', 'configuration', 'retained_mount',
            'runtime_identity', 'tailscale_retained_state', 'firewall', 'default_rootless_podman', 'packages_unchanged'), True)
        if (profile.get('kind') != 'klokast.vm-template-personalized-test.v1' or profile.get('success') is not True or
                profile.get('operation_id') != request['operation_id'] or profile.get('inputs_sha256') != request['inputs_sha256'] or
                profile.get('kernel_release') != build['kernel_release'] or profile.get('tests') != profile_tests or
                profile.get('production_data_used') is not False or
                any(profile.get(k) != prepared[k] for k in ('request_sha256', 'receipt_sha256'))):
            raise RuntimeError('personalized OpenRC boot tests failed; inspect the isolated profile console')
        value['personalized_test'] = profile
        value['personalization_stage'] = prepared
        value["tested_root_sha256"] = copied_hash.hexdigest()
        return value
    finally:
        # boot_guest must first prove that its exact guest has gone. A failed
        # cleanup leaves the files attached and visible for scoped recovery.
        if any(domain(n) is not None for n in test_names):
            raise RuntimeError("test domain remains; retain all test resources")
        for path, device in loops.items():
            detach_loop(path, device)
        for path in (root, result_path, config, *data_paths, personalized_root):
            path.unlink(missing_ok=True)
        write(work / "test-lifecycle.json", {"domain": name, "uuid": identity,
              'openrc_domain': openrc_name, 'openrc_uuid': openrc_identity,
              'personalize_domain': personalize_name, 'personalize_uuid': personalize_identity,
              'profile_domain': profile_name, 'profile_uuid': profile_identity, "stage": "cleaned"})


def execute(work, request):
    name = "vm-build-" + request["operation_id"]
    identity = str(uuid.uuid4())
    if domain(name) is not None:
        raise RuntimeError("refusing to reuse an existing builder domain")
    info = {key.strip(): value.strip() for key, value in
            (line.split(":", 1) for line in run(["xl", "info"]).stdout.splitlines() if ":" in line)}
    if int(info.get("free_memory", "0")) < MEMORY + 1024:
        raise RuntimeError("builder requires 4096 MiB plus 1024 MiB free Xen memory")
    capacity = os.statvfs(work)
    if capacity.f_bavail * capacity.f_frsize < sum(SLOTS.values()) + 2 * SLOTS["root"] + MIB + 1536 * MIB:
        raise RuntimeError("builder and boot tests require fourteen GiB of free persistent storage")
    for name_slot, size in SLOTS.items():
        with (work / (name_slot + ".slot")).open("xb") as stream:
            # Reserve physical capacity before boot; do not depend on sparse-file
            # growth while package scripts run.
            os.posix_fallocate(stream.fileno(), 0, size)
    config = work / "builder.cfg"
    write(work / "lifecycle.json", {"domain": name, "uuid": identity, "stage": "allocated"})
    loops = {}
    backing = {"input": work / "capsule.tar", **{slot: work / (slot + ".slot") for slot in SLOTS}}
    try:
        for slot, path in backing.items():
            loops[slot] = attach_loop(path, readonly=slot == "input")
        config.write_text(configuration(work, name, identity, request, loops))
        boot_guest(work, name, identity, config, request)
        result = read_result(work, request)
        for slot, device in list(loops.items()):
            detach_loop(backing[slot], device)
            del loops[slot]
        result["boot_test"] = smoke_test(work, request, result)
        result["artifacts"]["root"] = {"bytes": SLOTS["root"], "sha256": checksum(work / "root.slot")}
        if result["artifacts"]["root"]["sha256"] != result["boot_test"]["tested_root_sha256"]:
            raise RuntimeError("published root image differs from the boot-tested bytes")
        result.update(kind="klokast.vm-template-candidate.v1", box=request["box"], accepted=False,
                      validation="base-boot-tested")
        # Publish only after the domain has disappeared and each output has
        # been measured. No image is mounted or parsed by the host.
        candidate = BASE / "candidates" / request["operation_id"]
        candidate.mkdir(mode=0o700)
        for artifact in ("root", "kernel", "initramfs"):
            source = work / (artifact + ".slot")
            with source.open("r+b") as stream:
                stream.truncate(result["artifacts"][artifact]["bytes"])
                os.fsync(stream.fileno())
            source.chmod(0o400)
            source.rename(candidate / artifact)
        write(candidate / "candidate.json", result)
        write(work / "candidate.json", result)
        return result
    finally:
        if any(domain(prefix + request['operation_id']) is not None
               for prefix in ('vm-build-', 'vm-test-', 'vm-openrc-', 'vm-personalize-', 'vm-profile-')):
            raise RuntimeError("disposable guest remains; retain all build resources")
        for slot, device in list(loops.items()):
            detach_loop(backing[slot], device)
            del loops[slot]
        config.unlink(missing_ok=True)
        for name_slot in SLOTS:
            (work / (name_slot + ".slot")).unlink(missing_ok=True)
        write(work / "lifecycle.json", {"domain": name, "uuid": identity, "stage": "cleaned"})


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--box", required=True)
    parser.add_argument("--operation-id", required=True)
    args = parser.parse_args()
    os.umask(0o077)
    if (os.geteuid() != 0 or not re.fullmatch(r"[a-z0-9][a-z0-9-]{0,30}", args.box) or
            socket.gethostname().split(".")[0] != args.box + "-dom0" or
            not re.fullmatch(r"[0-9a-f]{24}", args.operation_id) or
            "control_d" not in Path("/proc/xen/capabilities").read_text()):
        raise RuntimeError("run the builder only on its requested box dom0")
    for path in (Path("/mnt/dom0_data"), BASE, BASE / "staging", BASE / "candidates"):
        safe_directory(path)
    work = BASE / "staging" / args.operation_id
    safe_directory(work)
    # One build per box, in addition to the controller's installation-wide lock.
    with (BASE / "build.lock").open("a") as lock:
        fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
        request = validate_request(work, args.box, args.operation_id)
        for signum in (signal.SIGTERM, signal.SIGINT):
            signal.signal(signum, lambda *_: (_ for _ in ()).throw(RuntimeError("builder interrupted")))
        result = execute(work, request)
        print(json.dumps(result, sort_keys=True))


if __name__ == "__main__":
    try:
        main()
    except Exception as error:
        print("vm-template-build-dom0: " + type(error).__name__ + ": " + str(error), flush=True)
        raise SystemExit(1)
